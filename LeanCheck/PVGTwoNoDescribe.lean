import LeanCheck.PVGTwoRestTwo
import LeanCheck.PVGTwoMany

/-!
# PVGtwo: the description of the finest serving topology fails for some sequences

For the sequence `dz` of Remark 7.14 (`δ_k = 2^(-L_k)`, `A(δ) = {0}`):

* the usual topology serves `A(δ)` and is the finest that does;
* every neighbourhood of `0` in the topology generated by all `γ_{δ,θ}` is unbounded, so that topology is not
  the usual one.

Order of topologies as in Mathlib: `γ₁ ≤ γ₂` means that `γ₁` is finer.
-/

open Filter Topology Set
open scoped Pointwise

namespace PVG
namespace Two
open Q95 Lac

lemma Lz_ge (k : ℕ) : (k : ℤ) - 2 ≤ Lz k := by
  have h0 : 0 ≤ Lz 0 := by
    have hm : (jz 0).natAbs + 1 = mz 0 := rfl
    have hm' : ((jz 0).natAbs : ℤ) + 1 = mz 0 := by exact_mod_cast hm
    have h3 : jz 0 ≤ ((jz 0).natAbs : ℤ) := Int.le_natAbs
    have h5 : (0 : ℤ) ≤ ((jz 0).natAbs : ℤ) := Int.natCast_nonneg _
    unfold Lz
    rw [← hm']
    nlinarith
  have h : ∀ n : ℕ, (n : ℤ) - 2 ≤ Lz n ∧ 0 ≤ Lz n := by
    intro n
    induction n with
    | zero => exact ⟨by push_cast; omega, h0⟩
    | succ n ih =>
      have hg := Lz_gap n
      cases n with
      | zero =>
        have e : Lz (0 + 1) = Lz 1 := rfl
        push_cast at hg ⊢
        omega
      | succ m =>
        push_cast at hg ih ⊢
        omega
  exact (h k).1

lemma dz_tendsto : Tendsto dz atTop (𝓝 0) := by
  have hb : ∀ k, dz k ≤ 4 * (1 / 2 : ℝ) ^ k := by
    intro k
    have h := Lz_ge k
    have h1 : dz k ≤ (2 : ℝ) ^ (2 - (k : ℤ)) := by
      unfold dz
      exact zpow_le_zpow_right₀ one_le_two (by omega)
    refine h1.trans (le_of_eq ?_)
    rw [zpow_sub₀ two_ne_zero, zpow_natCast, one_div, inv_pow]
    norm_num
    ring
  refine squeeze_zero (fun k => ?_) hb ?_
  · unfold dz
    positivity
  · simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one (r := (1 / 2 : ℝ)) (by norm_num) (by norm_num)).const_mul 4

/-- `γ_{δ,θ}` for the sequence `dz`. -/
noncomputable def parZ (θ : ℕ → AddCircle (1 : ℝ)) : TopologicalSpace ℝ :=
  Classical.choose (exists_par dz dz_tendsto θ) ⊓ bohrTop

/-- Points far out that satisfy any finite number of the conditions. -/
lemma far_point (C : Finset ℝ) (F : Finset (ℕ → AddCircle (1 : ℝ))) {η' ε η : ℝ} (hη' : 0 < η') (hε : 0 < ε)
    (hη : 0 < η) (R : ℝ) :
    ∃ x : ℝ, R < |x| ∧ x ∈ bset C η' ∧ (∀ k, dint (dz k * x) ≤ ε) ∧ ∀ θ ∈ F, ‖Phit dz θ x‖ ≤ η := by
  set v : ℕ → (C → AddCircle (1 : ℝ)) × (F → AddCircle (1 : ℝ)) := fun i =>
    (fun b => ((b.1 * (2 : ℝ) ^ (Lz i) : ℝ) : AddCircle (1 : ℝ)), fun θ => Phit dz θ.1 ((2 : ℝ) ^ (Lz i))) with hv
  haveI : Fact (0 < (1 : ℝ)) := ⟨one_pos⟩
  obtain ⟨z, -, φ, hφ, hlim⟩ := (isCompact_univ (X := (C → AddCircle (1 : ℝ)) × (F → AddCircle (1 : ℝ)))).tendsto_subseq
    (x := v) (fun _ => mem_univ _)
  set d := min η' η / 2 with hd
  have hd0 : 0 < d := half_pos (lt_min hη' hη)
  obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.1 hlim.cauchySeq d hd0
  -- the smaller index `j`
  obtain ⟨M, hM⟩ := exists_pow_lt_of_lt_one (x := min ε (1 / 4)) (lt_min hε (by norm_num)) (by norm_num : (1 / 2 : ℝ) < 1)
  obtain ⟨Q, hQ⟩ := pow_unbounded_of_one_lt R (one_lt_two (α := ℝ))
  set n := max N (max M (Q + 2)) with hn
  set j := φ n with hj
  set i := φ (n + 1) with hi
  have hji : j < i := hφ (Nat.lt_succ_self n)
  have hnj : n ≤ j := hφ.id_le n
  have hMj : M ≤ j := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hnj
  have hQj : Q + 2 ≤ j := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hnj
  have hsmall : (2 : ℝ) ^ (-(j : ℤ)) < min ε (1 / 4) := by
    refine lt_of_le_of_lt ?_ hM
    rw [zpow_neg, zpow_natCast, one_div, inv_pow]
    exact inv_anti₀ (by positivity) (pow_le_pow_right₀ one_le_two hMj)
  have hdist := hN (n + 1) (le_trans (le_max_left _ _) (Nat.le_succ n)) n (le_max_left _ _)
  have hdist' : dist (v i) (v j) < d := hdist
  rw [Prod.dist_eq] at hdist'
  have hd1 := lt_of_le_of_lt (le_max_left _ _) hdist'
  have hd2 := lt_of_le_of_lt (le_max_right _ _) hdist'
  set x := (2 : ℝ) ^ (Lz i) - (2 : ℝ) ^ (Lz j) with hx
  have hLij : Lz j + 1 ≤ Lz i := by
    have h := Lz_mono_from j i hji
    have : 1 ≤ j := by omega
    omega
  have hterm : ∀ k, dz k * x = (2 : ℝ) ^ (Lz i - Lz k) - (2 : ℝ) ^ (Lz j - Lz k) := by
    intro k
    rw [hx, mul_sub, dz_pow, dz_pow]
  have hmono : ∀ a b : ℕ, a ≤ b → 0 ≤ Lz b - Lz a := by
    intro a b hab
    rcases lt_or_eq_of_le hab with h | h
    · have := Lz_mono_from a b h
      omega
    · rw [h, sub_self]
  have hint : ∀ a b : ℕ, a ≤ b → ∃ z : ℤ, (2 : ℝ) ^ (Lz b - Lz a) = z := by
    intro a b hab
    obtain ⟨m, hm⟩ := Int.eq_ofNat_of_zero_le (hmono a b hab)
    exact ⟨(2 : ℤ) ^ m, by rw [hm, zpow_natCast]; push_cast; rfl⟩
  have hlow : ∀ a k : ℕ, j ≤ a → a < k → 0 < (2 : ℝ) ^ (Lz a - Lz k) ∧
      (2 : ℝ) ^ (Lz a - Lz k) ≤ (2 : ℝ) ^ (-(j : ℤ)) := by
    intro a k ha hak
    have h := Lz_mono_from a k hak
    exact ⟨by positivity, zpow_le_zpow_right₀ one_le_two (by omega)⟩
  have hq : (2 : ℝ) ^ (-(j : ℤ)) < 1 / 4 := lt_of_lt_of_le hsmall (min_le_right _ _)
  have hround : ∀ t : ℝ, |t| < 1 / 2 → round t = 0 := by
    intro t ht
    rw [round_eq_zero_iff]
    have := abs_lt.1 ht
    exact ⟨this.1.le, this.2⟩
  -- the three ranges of `k`
  have hkey : ∀ k, dint (dz k * x) ≤ (2 : ℝ) ^ (-(j : ℤ)) ∧
      round (dz k * x) = round (dz k * (2 : ℝ) ^ (Lz i)) - round (dz k * (2 : ℝ) ^ (Lz j)) := by
    intro k
    rw [hterm, dz_pow, dz_pow]
    have h2j : (0 : ℝ) ≤ (2 : ℝ) ^ (-(j : ℤ)) := by positivity
    by_cases hkj : k ≤ j
    · obtain ⟨z1, h1⟩ := hint k i (hkj.trans hji.le)
      obtain ⟨z2, h2⟩ := hint k j hkj
      rw [h1, h2, ← Int.cast_sub, round_intCast, round_intCast, round_intCast, dint_int]
      exact ⟨h2j, rfl⟩
    have hjk : j < k := not_le.1 hkj
    obtain ⟨tpos, tle⟩ := hlow j k le_rfl hjk
    by_cases hki : k ≤ i
    · obtain ⟨z1, h1⟩ := hint k i hki
      rw [h1]
      set t := (2 : ℝ) ^ (Lz j - Lz k) with ht
      have htabs : |t| < 1 / 2 := by
        rw [abs_of_pos tpos]
        linarith
      refine ⟨?_, ?_⟩
      · have e : dint ((z1 : ℝ) - t) = dint (-t) := by
          rw [show (z1 : ℝ) - t = -t - ((-z1 : ℤ) : ℝ) by push_cast; ring, dint_sub_int]
        rw [e]
        refine (dint_le_abs _).trans ?_
        rw [abs_neg, abs_of_pos tpos]
        exact tle
      · rw [hround t htabs, round_intCast, sub_zero]
        rw [show (z1 : ℝ) - t = -t + (z1 : ℝ) by ring, round_add_intCast, hround (-t) (by rwa [abs_neg]), zero_add]
    · have hik : i < k := not_le.1 hki
      obtain ⟨spos, sle⟩ := hlow i k hji.le hik
      set s := (2 : ℝ) ^ (Lz i - Lz k) with hs
      set t := (2 : ℝ) ^ (Lz j - Lz k) with ht
      have hst : |s - t| ≤ (2 : ℝ) ^ (-(j : ℤ)) := by
        rw [abs_le]
        constructor <;> linarith
      refine ⟨(dint_le_abs _).trans hst, ?_⟩
      rw [hround s (by rw [abs_of_pos spos]; linarith), hround t (by rw [abs_of_pos tpos]; linarith),
        hround (s - t) (lt_of_le_of_lt hst (by linarith)), sub_zero]
  refine ⟨x, ?_, ?_, fun k => (hkey k).1.trans (hsmall.le.trans (min_le_left _ _)), fun θ hθ => ?_⟩
  · have h1 : (2 : ℝ) ^ (Lz j) ≤ x := by
      have h2 : (2 : ℝ) ^ (Lz j + 1) ≤ (2 : ℝ) ^ (Lz i) := zpow_le_zpow_right₀ one_le_two hLij
      rw [zpow_add_one₀ two_ne_zero] at h2
      rw [hx]
      linarith
    have h3 : (2 : ℝ) ^ Q ≤ (2 : ℝ) ^ (Lz j) := by
      rw [← zpow_natCast]
      have := Lz_ge j
      exact zpow_le_zpow_right₀ one_le_two (by omega)
    exact lt_of_lt_of_le hQ (h3.trans (h1.trans (le_abs_self x)))
  · intro b hb
    have h := (dist_le_pi_dist (v i).1 (v j).1 ⟨b, hb⟩).trans_lt hd1
    rw [dist_eq_norm] at h
    have e : dint (b * x) = ‖(v i).1 ⟨b, hb⟩ - (v j).1 ⟨b, hb⟩‖ := by
      unfold dint
      simp only [hv, hx, mul_sub, AddCircle.coe_sub]
    rw [e]
    exact lt_of_lt_of_le h (le_trans (half_le_self (lt_min hη' hη).le) (min_le_left _ _))
  · have h := (dist_le_pi_dist (v i).2 (v j).2 ⟨θ, hθ⟩).trans_lt hd2
    rw [dist_eq_norm] at h
    have e : Phit dz θ x = (v i).2 ⟨θ, hθ⟩ - (v j).2 ⟨θ, hθ⟩ := by
      simp only [hv]
      unfold Phit
      rw [← finsum_sub_distrib (Phit_support dz dz_tendsto θ _) (Phit_support dz dz_tendsto θ _)]
      refine finsum_congr fun k => ?_
      rw [(hkey k).2, sub_smul]
    rw [e]
    exact (le_of_lt h).trans (le_trans (half_le_self (lt_min hη' hη).le) (min_le_right _ _))

/-- Every neighbourhood of `0` in the topology generated by all `γ_{δ,θ}` is unbounded. -/
theorem unbounded_nhds (W : Set ℝ) (hW : W ∈ @nhds ℝ (⨅ θ : ℕ → AddCircle (1 : ℝ), parZ θ) 0) (R : ℝ) :
    ∃ x ∈ W, R < |x| := by
  classical
  have hn : @nhds ℝ (⨅ θ : ℕ → AddCircle (1 : ℝ), parZ θ) 0 = ⨅ θ, @nhds ℝ (parZ θ) 0 := nhds_iInf
  rw [hn] at hW
  have key : ∃ (C : Finset ℝ) (F : Finset (ℕ → AddCircle (1 : ℝ))) (η' ε η : ℝ), 0 < η' ∧ 0 < ε ∧ 0 < η ∧
      ∀ x, x ∈ bset C η' → (∀ k, dint (dz k * x) ≤ ε) → (∀ θ ∈ F, ‖Phit dz θ x‖ ≤ η) → x ∈ W := by
    refine Filter.iInf_sets_induct
      (p := fun W => ∃ (C : Finset ℝ) (F : Finset (ℕ → AddCircle (1 : ℝ))) (η' ε η : ℝ), 0 < η' ∧ 0 < ε ∧ 0 < η ∧
        ∀ x, x ∈ bset C η' → (∀ k, dint (dz k * x) ≤ ε) → (∀ θ ∈ F, ‖Phit dz θ x‖ ≤ η) → x ∈ W) hW ?_ ?_
    · exact ⟨∅, ∅, 1, 1, 1, one_pos, one_pos, one_pos, fun x _ _ _ => mem_univ x⟩
    · rintro θ s t hs ⟨C, F, η', ε, η, hη', hε, hη, hsub⟩
      have hb := (Classical.choose_spec (exists_par dz dz_tendsto θ)).2
      have hs' : s ∈ @nhds ℝ (Classical.choose (exists_par dz dz_tendsto θ)) 0 ⊓ @nhds ℝ bohrTop 0 := by
        have e : @nhds ℝ (parZ θ) 0 = @nhds ℝ (Classical.choose (exists_par dz dz_tendsto θ)) 0 ⊓
            @nhds ℝ bohrTop 0 := @nhds_inf ℝ (Classical.choose (exists_par dz dz_tendsto θ)) bohrTop 0
        rwa [e] at hs
      obtain ⟨U, hU, B, hB, rfl⟩ := Filter.mem_inf_iff.1 hs'
      obtain ⟨⟨e1, h1⟩, ⟨he1, _, hh1⟩, hsubU⟩ := hb.mem_iff.1 hU
      obtain ⟨C', η'', hη'', hC'⟩ := exists_bset_subset hB
      refine ⟨C ∪ C', insert θ F, min η' η'', min ε e1, min η h1, lt_min hη' hη'', lt_min hε he1, lt_min hη hh1,
        fun x hxC hxk hxF => ⟨⟨?_, ?_⟩, ?_⟩⟩
      · exact hsubU ⟨fun k => (hxk k).trans (min_le_right _ _),
          (hxF θ (Finset.mem_insert_self _ _)).trans (min_le_right _ _)⟩
      · exact hC' fun b hb' => lt_of_lt_of_le (hxC b (Finset.mem_union_right _ hb')) (min_le_right _ _)
      · exact hsub x (fun b hb' => lt_of_lt_of_le (hxC b (Finset.mem_union_left _ hb')) (min_le_left _ _))
          (fun k => (hxk k).trans (min_le_left _ _))
          (fun θ' hθ' => (hxF θ' (Finset.mem_insert_of_mem hθ')).trans (min_le_left _ _))
  obtain ⟨C, F, η', ε, η, hη', hε, hη, hsub⟩ := key
  obtain ⟨x, hxR, hxC, hxk, hxF⟩ := far_point C F hη' hε hη R
  exact ⟨x, hsub x hxC hxk hxF, hxR⟩

/-- The usual topology is the finest one that serves `A(δ) = {0}`, and the topology generated by all `γ_{δ,θ}`
is not finer than it. -/
theorem no_description :
    Serves usualTop {a | InA dz sT a} ∧ (∀ γ : TopologicalSpace ℝ, Serves γ {a | InA dz sT a} → usualTop ≤ γ) ∧
      ¬ (⨅ θ : ℕ → AddCircle (1 : ℝ), parZ θ) ≤ usualTop := by
  have hle : usualTop ≤ bohrTop := continuous_e.le_induced
  refine ⟨?_, fun γ h => ?_, fun h => ?_⟩
  · have hne : usualTop ≠ bohrTop := by
      have hpos : ∀ k, 0 < dz k := fun k => by
        unfold dz
        positivity
      have hM : ∀ k, |dz k| ≤ 4 := by
        intro k
        rw [abs_of_pos (hpos k)]
        have h := Lz_ge k
        have h1 : dz k ≤ (2 : ℝ) ^ (2 : ℤ) := by
          unfold dz
          exact zpow_le_zpow_right₀ one_le_two (by omega)
        exact h1.trans (by norm_num)
      have h2 : usualTop ≤ gamTop dz :=
        le_of_nhds_zero _ _ usualTop_group (gam_group dz) (gam_coarser_euclid dz 4 hM 0)
      intro heq
      refine gam_ne_bohr dz (infinite_range_of_tendsto dz (fun k => (hpos k).ne') dz_tendsto)
        (le_antisymm (gam_le_bohr _) ?_)
      exact heq ▸ h2
    refine ⟨usualTop_group, hle, hne, le_rfl, fun a ha V hV => ?_⟩
    have h0 : a = 0 := A_dz a ha
    refine ⟨{0}, fun y hy => ⟨0, Finset.mem_singleton_self _, ?_⟩⟩
    obtain ⟨t, -, rfl⟩ := hy
    rw [h0]
    simpa using mem_of_mem_nhds hV
  · exact le_of_nhds_zero _ _ usualTop_group h.1 h.2.2.2.1
  · have h1 : Ioo (-1 : ℝ) 1 ∈ @nhds ℝ (⨅ θ : ℕ → AddCircle (1 : ℝ), parZ θ) 0 :=
      nhds_mono h (Ioo_mem_nhds (by norm_num) (by norm_num))
    obtain ⟨x, hx, hR⟩ := unbounded_nhds _ h1 1
    exact absurd (abs_lt.2 ⟨hx.1, hx.2⟩) (not_lt.2 hR.le)

