import Mathlib
import LeanCheck.PGNullFilters

/-!
# PG: the pseudotopological group generated by an ultrafilter (Lean check)

Scope. Theorem 1 of `PG_v6` (abstract form). Let `G` be an abelian group and `u` an ultrafilter on `G`. `GenUlt u U` is the
smallest family of ultrafilters containing the principal ultrafilter at `0` and `u`, closed under negation and under
"finer than a filter sum": `W ≤ U + V` (filter sum `map₂ (· + ·)`) with `U`, `V` in the family implies `W` in the family.
`genNull u` is the family of proper filters all of whose finer ultrafilters are in `GenUlt u`.

* `genNull_nullFamily` : `genNull u` satisfies properties (i)-(iv) of Proposition 2.6 (`NullFamily` of `PGNullFilters`), so it
  defines a pseudotopological group in which `u` converges to `0` (`u_mem_genNull`);
* `genNull_le` : it is the smallest such family (every `NullFamily` containing `u` contains `genNull u`);
* `exists_ultra_le_map₂` : every ultrafilter finer than a filter sum `F + H` is finer than `U + V` for ultrafilters `U ≤ F`,
  `V ≤ H` (the key lemma for closure under sums);
* `mem_of_subgroup_mem` and `genNull_hausdorff` : if for every `z ≠ 0` there is a subgroup `H ∈ u` with `z ∉ H`, the PG is
  Hausdorff; `int_hausdorff` : for `G = ℤ` and `u` containing every `mℤ`, `m ≥ 1`, in particular for idempotent `u`.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set

namespace PG

variable {G : Type*} [AddCommGroup G]

/-- Ultrafilters converging to `0` in the PG generated by `u`. -/
inductive GenUlt (u : Ultrafilter G) : Ultrafilter G → Prop
  | zero : GenUlt u (pure 0)
  | gen : GenUlt u u
  | neg {U : Ultrafilter G} : GenUlt u U → GenUlt u (U.map (fun x => -x))
  | add {U V W : Ultrafilter G} : GenUlt u U → GenUlt u V →
      (W : Filter G) ≤ Filter.map₂ (· + ·) (U : Filter G) (V : Filter G) → GenUlt u W

/-- Null filters of the PG generated by `u`. -/
def genNull (u : Ultrafilter G) : Set (Filter G) :=
  {F | F.NeBot ∧ ∀ U : Ultrafilter G, (U : Filter G) ≤ F → GenUlt u U}

/-- Every ultrafilter finer than a filter sum is finer than a sum of ultrafilters. -/
theorem exists_ultra_le_map₂ (F H : Filter G) (W : Ultrafilter G)
    (hW : (W : Filter G) ≤ Filter.map₂ (· + ·) F H) :
    ∃ U V : Ultrafilter G, (U : Filter G) ≤ F ∧ (V : Filter G) ≤ H ∧
      (W : Filter G) ≤ Filter.map₂ (· + ·) (U : Filter G) (V : Filter G) := by
  classical
  let 𝒢 : Filter (G × G) := (F ×ˢ H) ⊓ Filter.comap (fun p : G × G => p.1 + p.2) (W : Filter G)
  have hne : 𝒢.NeBot := by
    rw [Filter.inf_neBot_iff]
    intro s hs t ht
    obtain ⟨A, hA, B, hB, hAB⟩ := Filter.mem_prod_iff.1 hs
    obtain ⟨C, hC, hCt⟩ := Filter.mem_comap.1 ht
    have hmem : Set.image2 (· + ·) A B ∈ (Filter.map₂ (· + ·) F H) :=
      Filter.image2_mem_map₂ hA hB
    have h1 : Set.image2 (· + ·) A B ∈ (W : Filter G) := hW hmem
    have h2 : Set.image2 (· + ·) A B ∩ C ∈ (W : Filter G) := Filter.inter_mem h1 hC
    obtain ⟨z, ⟨a, ha, b, hb, rfl⟩, hzC⟩ := Filter.nonempty_of_mem h2
    exact ⟨(a, b), hAB ⟨ha, hb⟩, hCt hzC⟩
  let 𝒲 : Ultrafilter (G × G) := Ultrafilter.of 𝒢
  have h𝒲 : (𝒲 : Filter (G × G)) ≤ 𝒢 := Ultrafilter.of_le 𝒢
  have hF : (𝒲 : Filter (G × G)) ≤ F ×ˢ H := h𝒲.trans inf_le_left
  have hSum : (𝒲 : Filter (G × G)) ≤ Filter.comap (fun p : G × G => p.1 + p.2) (W : Filter G) :=
    h𝒲.trans inf_le_right
  have hU : ((𝒲.map Prod.fst : Ultrafilter G) : Filter G) = Filter.map Prod.fst (𝒲 : Filter (G × G)) :=
    Ultrafilter.coe_map _ _
  have hV : ((𝒲.map Prod.snd : Ultrafilter G) : Filter G) = Filter.map Prod.snd (𝒲 : Filter (G × G)) :=
    Ultrafilter.coe_map _ _
  refine ⟨𝒲.map Prod.fst, 𝒲.map Prod.snd, ?_, ?_, ?_⟩
  · rw [hU]; exact (Filter.map_mono hF).trans Filter.tendsto_fst
  · rw [hV]; exact (Filter.map_mono hF).trans Filter.tendsto_snd
  · have h1 : ((𝒲.map (fun p : G × G => p.1 + p.2) : Ultrafilter G) : Filter G) ≤ (W : Filter G) := by
      rw [Ultrafilter.coe_map]; exact Filter.map_le_iff_le_comap.2 hSum
    have h2 : 𝒲.map (fun p : G × G => p.1 + p.2) = W := Ultrafilter.coe_le_coe.1 h1
    have h3 : (𝒲 : Filter (G × G)) ≤
        ((𝒲.map Prod.fst : Ultrafilter G) : Filter G) ×ˢ ((𝒲.map Prod.snd : Ultrafilter G) : Filter G) := by
      rw [hU, hV]
      exact Filter.le_prod.2 ⟨Filter.tendsto_map, Filter.tendsto_map⟩
    rw [← h2, Ultrafilter.coe_map, ← Filter.map_prod_eq_map₂]
    exact Filter.map_mono h3

theorem u_mem_genNull (u : Ultrafilter G) : (u : Filter G) ∈ genNull u := by
  refine ⟨inferInstance, fun U hU => ?_⟩
  rw [Ultrafilter.coe_le_coe.1 hU]
  exact GenUlt.gen

theorem genNull_nullFamily (u : Ultrafilter G) : NullFamily (genNull u) where
  ne := fun F hF => hF.1
  pure_zero := by
    refine ⟨inferInstance, fun U hU => ?_⟩
    have : U = pure 0 := Ultrafilter.coe_le_coe.1 (by rw [Ultrafilter.coe_pure]; exact hU)
    rw [this]
    exact GenUlt.zero
  finer := by
    rintro F ⟨hne, hF⟩ H hle hHne
    exact ⟨hHne, fun U hU => hF U (hU.trans hle)⟩
  add := by
    rintro F ⟨hFn, hF⟩ H ⟨hHn, hH⟩
    refine ⟨hFn.map₂ hHn, fun W hW => ?_⟩
    obtain ⟨U, V, hU, hV, hWUV⟩ := exists_ultra_le_map₂ F H W hW
    exact GenUlt.add (hF U hU) (hH V hV) hWUV
  neg := by
    rintro F ⟨hne, hF⟩
    refine ⟨by have := hne; infer_instance, fun W hW => ?_⟩
    have hneg : ((fun x : G => -x) ∘ fun x : G => -x) = id := by
      funext x; simp
    have hU : ((W.map (fun x : G => -x) : Ultrafilter G) : Filter G) ≤ F := by
      rw [Ultrafilter.coe_map]
      calc Filter.map (fun x : G => -x) (W : Filter G)
          ≤ Filter.map (fun x : G => -x) (Filter.map (fun x : G => -x) F) := Filter.map_mono hW
        _ = F := by rw [Filter.map_map, hneg, Filter.map_id]
    have h1 := GenUlt.neg (hF _ hU)
    have h2 : (W.map (fun x : G => -x)).map (fun x : G => -x) = W := by
      rw [Ultrafilter.map_map, hneg, Ultrafilter.map_id]
    rw [h2] at h1
    exact h1
  ultra := by
    rintro F hne hU
    exact ⟨hne, fun U hUF => (hU U hUF).2 U le_rfl⟩

/-- The generated PG is the smallest one: every null family containing `u` contains `genNull u`. -/
theorem genNull_le (u : Ultrafilter G) {C : Set (Filter G)} (hC : NullFamily C)
    (hu : (u : Filter G) ∈ C) : genNull u ⊆ C := by
  have key : ∀ U : Ultrafilter G, GenUlt u U → (U : Filter G) ∈ C := by
    intro U hU
    induction hU with
    | zero => simpa using hC.pure_zero
    | gen => exact hu
    | neg h ih =>
      rw [Ultrafilter.coe_map]
      exact hC.neg _ ih
    | add h1 h2 hW ih1 ih2 =>
      exact hC.finer _ (hC.add _ ih1 _ ih2) _ hW inferInstance
  rintro F ⟨hne, hF⟩
  exact hC.ultra F hne (fun U hU => key U (hF U hU))

/-- A subgroup belonging to `u` belongs to every ultrafilter converging to `0` in the generated PG. -/
theorem mem_of_subgroup_mem (u : Ultrafilter G) (H : AddSubgroup G)
    (hu : (H : Set G) ∈ (u : Filter G)) :
    ∀ U : Ultrafilter G, GenUlt u U → (H : Set G) ∈ (U : Filter G) := by
  intro U hU
  induction hU with
  | zero => simp
  | gen => exact hu
  | neg h ih =>
    rw [Ultrafilter.coe_map, Filter.mem_map]
    have : ((fun x : G => -x) ⁻¹' (H : Set G)) = H := by
      ext x; simp
    rw [this]
    exact ih
  | add h1 h2 hW ih1 ih2 =>
    apply hW
    refine Filter.mem_of_superset (Filter.image2_mem_map₂ ih1 ih2) ?_
    rintro _ ⟨a, ha, b, hb, rfl⟩
    exact H.add_mem ha hb

/-- Hausdorff criterion for the generated PG. -/
theorem genNull_hausdorff (u : Ultrafilter G)
    (hsub : ∀ z : G, z ≠ 0 → ∃ H : AddSubgroup G, (H : Set G) ∈ (u : Filter G) ∧ z ∉ H) :
    ∀ (F : Filter G) (z : G), F ∈ genNull u →
      Filter.map (fun y => y - z) F ∈ genNull u → z = 0 := by
  intro F z hF hFz
  by_contra hz
  obtain ⟨H, hHu, hzH⟩ := hsub z hz
  have hFne := hF.1
  let U : Ultrafilter G := Ultrafilter.of F
  have hUF : (U : Filter G) ≤ F := Ultrafilter.of_le F
  have h1 := mem_of_subgroup_mem u H hHu U (hF.2 U hUF)
  have hV : ((U.map (fun y => y - z) : Ultrafilter G) : Filter G) ≤ Filter.map (fun y => y - z) F := by
    rw [Ultrafilter.coe_map]
    exact Filter.map_mono hUF
  have h2 := mem_of_subgroup_mem u H hHu (U.map (fun y => y - z)) (hFz.2 _ hV)
  rw [Ultrafilter.coe_map, Filter.mem_map] at h2
  obtain ⟨y, hy1, hy2⟩ := Filter.nonempty_of_mem (Filter.inter_mem h1 h2)
  apply hzH
  have : z = y - (y - z) := by abel
  rw [this]
  exact H.sub_mem hy1 hy2

/-- `G = ℤ`: Hausdorff as soon as `u` contains every `mℤ`, `m ≥ 1` (in particular for an idempotent `u`). -/
theorem int_hausdorff (u : Ultrafilter ℤ)
    (hu : ∀ m : ℕ, 1 ≤ m → ((AddSubgroup.zmultiples (m : ℤ) : AddSubgroup ℤ) : Set ℤ) ∈ (u : Filter ℤ)) :
    ∀ (F : Filter ℤ) (z : ℤ), F ∈ genNull u →
      Filter.map (fun y => y - z) F ∈ genNull u → z = 0 := by
  refine genNull_hausdorff u ?_
  intro z hz
  refine ⟨AddSubgroup.zmultiples ((z.natAbs + 1 : ℕ) : ℤ), hu _ (by omega), ?_⟩
  intro hmem
  obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 hmem
  rw [smul_eq_mul] at hk
  have hnat : z.natAbs = k.natAbs * (z.natAbs + 1) := by
    have := congrArg Int.natAbs hk
    rw [Int.natAbs_mul, Int.natAbs_natCast] at this
    exact this.symm
  rcases Nat.eq_zero_or_pos k.natAbs with h0 | hpos
  · apply hz
    rw [h0] at hnat
    omega
  · have := Nat.le_mul_of_pos_left (z.natAbs + 1) hpos
    omega

end PG
