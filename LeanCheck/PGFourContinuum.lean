import Mathlib
import LeanCheck.PGThreeSelective

/-!
# PGfour: fewer than continuum many generators give no convergent sequences for the vicinity filter

`genFam (ultraGen S)` is the family of filters converging to `0` in the PG generated by the set `S` of ultrafilters.

* `vicinity_no_sequence` : let `S` have fewer than continuum many members, let `ξ(S)` be Hausdorff, and let `e : G →+ K`
  be a homomorphism into a compact Hausdorff group for which disjoint subsets of an infinite set `B0` (not containing `0`)
  have images with disjoint closures. Then an infinite `B ⊆ B0` has its complement in every filter converging to `0`.
* `bound_sharp` : on `ℕ →₀ ZMod 2` there is a set of at most continuum many ultrafilters with `ξ(S)` Hausdorff such
  that no infinite set of unit vectors has its complement in every filter converging to `0`.

The proof uses an almost disjoint family of size continuum. The existence of a set `B0` as above in every infinite set (an `I₀` set in the Bohr
compactification) is quoted, not proved here.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set Topology Cardinal

namespace PG.Continuum

open PG.Sel

variable {G : Type*} [AddCommGroup G]

/-- The signed sum of the ultrafilters listed in `l`. -/
def sumList (S : Set (Ultrafilter G)) : List (S × Bool) → Filter G
  | [] => pure 0
  | p :: l => Filter.map₂ (· + ·)
      (if p.2 then (p.1.1 : Filter G) else Filter.map (fun x : G => -x) (p.1.1 : Filter G)) (sumList S l)

theorem map₂_zero_left (F : Filter G) : Filter.map₂ (· + ·) (pure (0 : G)) F = F := by
  rw [Filter.map₂_pure_left]
  have : (fun b : G => (0 : G) + b) = id := by
    funext b
    simp
  rw [this, Filter.map_id]

theorem sumList_append (S : Set (Ultrafilter G)) (l1 l2 : List (S × Bool)) :
    sumList S (l1 ++ l2) = Filter.map₂ (· + ·) (sumList S l1) (sumList S l2) := by
  induction l1 with
  | nil => rw [List.nil_append, sumList, map₂_zero_left]
  | cons p l ih =>
    rw [List.cons_append, sumList, sumList, ih]
    exact (Filter.map₂_assoc fun a b c => add_assoc a b c).symm

theorem exists_list (S : Set (Ultrafilter G)) {σ : Filter G} (h : SumClosure (ultraGen S) σ) :
    ∃ l : List (S × Bool), sumList S l = σ := by
  have one : ∀ (u : S) (b : Bool), sumList S [(u, b)]
      = (if b then (u.1 : Filter G) else Filter.map (fun x : G => -x) (u.1 : Filter G)) := by
    intro u b
    rw [sumList, sumList, Filter.map₂_pure_right]
    have : (fun a : G => a + 0) = id := by
      funext a
      simp
    rw [this, Filter.map_id]
  induction h with
  | zero => exact ⟨[], rfl⟩
  | gen hF =>
    obtain ⟨u, hu, rfl⟩ := hF
    exact ⟨[(⟨u, hu⟩, true)], by rw [one]; rfl⟩
  | neg hF =>
    obtain ⟨u, hu, rfl⟩ := hF
    exact ⟨[(⟨u, hu⟩, false)], by rw [one]; rfl⟩
  | add _ _ ih1 ih2 =>
    obtain ⟨l1, h1⟩ := ih1
    obtain ⟨l2, h2⟩ := ih2
    exact ⟨l1 ++ l2, by rw [sumList_append, h1, h2]⟩

/-- There are fewer than continuum many finite signed sums. -/
theorem mk_sums_lt {G : Type u} [AddCommGroup G] (S : Set (Ultrafilter G)) (hS : Cardinal.mk S < continuum) :
    Cardinal.mk {σ : Filter G // SumClosure (ultraGen S) σ} < continuum := by
  have hsurj : Cardinal.mk {σ : Filter G // SumClosure (ultraGen S) σ} ≤ Cardinal.mk (List (S × Bool)) := by
    choose f hf using fun σ : {σ : Filter G // SumClosure (ultraGen S) σ} => exists_list S σ.2
    refine Cardinal.mk_le_of_injective (f := f) fun a b h => Subtype.ext ?_
    rw [← hf a, ← hf b, h]
  have hprod : Cardinal.mk (S × Bool) < continuum := by
    rw [Cardinal.mk_prod, Cardinal.lift_uzero]
    refine Cardinal.mul_lt_of_lt aleph0_le_continuum hS ?_
    rw [Cardinal.mk_bool, Cardinal.lift_ofNat]
    exact (Cardinal.natCast_lt_aleph0 (n := 2)).trans aleph0_lt_continuum
  exact hsurj.trans_lt (lt_of_le_of_lt (Cardinal.mk_list_le_max _) (max_lt aleph0_lt_continuum hprod))

variable {K : Type*} [AddCommGroup K] [TopologicalSpace K] [IsTopologicalAddGroup K] [CompactSpace K]

/-- Every finite signed sum has a limit in the compact group. -/
theorem exists_limit (e : G →+ K) (S : Set (Ultrafilter G)) {σ : Filter G} (h : SumClosure (ultraGen S) σ) :
    ∃ t : K, Tendsto e σ (𝓝 t) := by
  have ult : ∀ u : Ultrafilter G, ∃ t : K, Tendsto e (u : Filter G) (𝓝 t) := by
    intro u
    obtain ⟨t, _, ht⟩ := isCompact_univ.ultrafilter_le_nhds (u.map e) (by simp)
    exact ⟨t, ht⟩
  induction h with
  | zero => exact ⟨e 0, tendsto_pure_nhds e 0⟩
  | gen hF =>
    obtain ⟨u, _, rfl⟩ := hF
    exact ult u
  | neg hF =>
    obtain ⟨u, _, rfl⟩ := hF
    obtain ⟨t, ht⟩ := ult u
    refine ⟨-t, ?_⟩
    rw [tendsto_map'_iff]
    have : (e ∘ fun x : G => -x) = fun x => -(e x) := by
      funext x
      simp
    rw [this]
    exact ht.neg
  | add _ _ ih1 ih2 =>
    obtain ⟨t, ht⟩ := ih1
    obtain ⟨s, hs⟩ := ih2
    refine ⟨t + s, ?_⟩
    rw [← Filter.map_prod_eq_map₂, tendsto_map'_iff]
    have : (e ∘ fun p : G × G => p.1 + p.2) = fun p => e p.1 + e p.2 := by
      funext p
      simp
    change Tendsto (e ∘ fun p : G × G => p.1 + p.2) _ _
    rw [this]
    exact (ht.comp tendsto_fst).add (hs.comp tendsto_snd)

/-- Fewer than continuum many generators: an infinite subset of `B0` is missed by a vicinity set. -/
theorem vicinity_no_sequence (e : G →+ K) (S : Set (Ultrafilter G)) (hS : Cardinal.mk S < continuum)
    (hH : ∀ b : G, b ≠ 0 → (pure b : Filter G) ∉ genFam (ultraGen S))
    (B0 : Set G) (hB0 : B0.Infinite) (h0 : (0 : G) ∉ B0)
    (hI : ∀ C1 ⊆ B0, ∀ C2 ⊆ B0, Disjoint C1 C2 → Disjoint (closure (e '' C1)) (closure (e '' C2))) :
    ∃ B ⊆ B0, B.Infinite ∧ ∀ N ∈ genFam (ultraGen S), Bᶜ ∈ N := by
  classical
  -- an almost disjoint family of size continuum
  let f : ℕ → G := fun n => (hB0.natEmbedding _ n : G)
  have hf : Function.Injective f := fun a b h => (hB0.natEmbedding _).injective (Subtype.ext h)
  let g : List Bool → G := fun l => f (Encodable.encode l)
  have hg : Function.Injective g := fun a b h => Encodable.encode_injective (hf h)
  let pre : (ℕ → Bool) → ℕ → List Bool := fun s n => List.ofFn fun i : Fin n => s i
  have hlen : ∀ s n, (pre s n).length = n := fun s n => List.length_ofFn
  let Bs : (ℕ → Bool) → Set G := fun s => range fun n => g (pre s n)
  have hBsub : ∀ s, Bs s ⊆ B0 := by
    rintro s _ ⟨n, rfl⟩
    exact (hB0.natEmbedding _ (Encodable.encode (pre s n))).2
  have hBinf : ∀ s, (Bs s).Infinite := by
    intro s
    refine infinite_range_of_injective fun a b h => ?_
    have := congrArg List.length (hg h)
    rwa [hlen, hlen] at this
  have hAD : ∀ s t, s ≠ t → (Bs s ∩ Bs t).Finite := by
    intro s t hst
    obtain ⟨k, hk⟩ := Function.ne_iff.1 hst
    refine ((finite_Iic k).image fun n => g (pre s n)).subset ?_
    rintro x ⟨⟨n, rfl⟩, m, hm⟩
    refine ⟨n, ?_, rfl⟩
    have heq : pre t m = pre s n := hg hm
    have hmn : m = n := by
      have := congrArg List.length heq
      rwa [hlen, hlen] at this
    subst hmn
    rw [mem_Iic]
    by_contra hlt
    have hkm : k < m := not_le.1 hlt
    have := congrFun (List.ofFn_inj.1 heq) ⟨k, hkm⟩
    exact hk this.symm
  -- every sum omits each nonzero point
  have hpt : ∀ σ : Filter G, SumClosure (ultraGen S) σ → ∀ b ∈ B0, ({b}ᶜ : Set G) ∈ σ := by
    intro σ hσ b hb
    by_contra hno
    refine hH b (fun h => h0 (h ▸ hb)) ⟨inferInstance, fun U hU => ⟨σ, hσ, hU.trans ?_⟩⟩
    rw [Filter.pure_le_iff]
    intro D hD
    by_contra hbD
    exact hno (Filter.mem_of_superset hD fun x hx hxb => hbD (mem_singleton_iff.1 hxb ▸ hx))
  -- a sum can fail to contain the complement of at most one member of the family
  have claim : ∀ σ : Filter G, SumClosure (ultraGen S) σ → ∀ s t, (Bs s)ᶜ ∉ σ → (Bs t)ᶜ ∉ σ → s = t := by
    intro σ hσ s t hs ht
    by_contra hst
    set E := Bs s ∩ Bs t with hE
    have hEfin : E.Finite := hAD s t hst
    have hEc : Eᶜ ∈ σ := by
      have : Eᶜ = ⋂ b ∈ E, ({b}ᶜ : Set G) := by
        ext x
        simp only [mem_compl_iff, mem_iInter, mem_singleton_iff]
        exact ⟨fun h i hi he => h (he ▸ hi), fun h hx => h x hx rfl⟩
      rw [this]
      exact (biInter_mem hEfin).2 fun b hb => hpt σ hσ b (hBsub s hb.1)
    obtain ⟨l, hl⟩ := exists_limit e S hσ
    have key : ∀ r, (Bs r)ᶜ ∉ σ → l ∈ closure (e '' (Bs r \ E)) := by
      intro r hr
      rw [mem_closure_iff_nhds]
      intro W hW
      by_contra hemp
      apply hr
      refine Filter.mem_of_superset (inter_mem (hl hW) hEc) fun x hx hxr => hemp ?_
      exact ⟨e x, hx.1, x, ⟨hxr, hx.2⟩, rfl⟩
    have hd : Disjoint (Bs s \ E) (Bs t \ E) := by
      rw [disjoint_left]
      intro x hx hy
      exact hx.2 ⟨hx.1, hy.1⟩
    exact disjoint_left.1 (hI _ (sdiff_subset.trans (hBsub s)) _ (sdiff_subset.trans (hBsub t)) hd)
      (key s hs) (key t ht)
  have main : ∃ s, ∀ σ : Filter G, SumClosure (ultraGen S) σ → (Bs s)ᶜ ∈ σ := by
    by_contra hno
    push Not at hno
    choose σ hσ hbad using hno
    have hinj : Function.Injective fun s : ℕ → Bool =>
        (⟨σ s, hσ s⟩ : {σ : Filter G // SumClosure (ultraGen S) σ}) := by
      intro s t h
      have h' : σ s = σ t := congrArg Subtype.val h
      exact claim (σ s) (hσ s) s t (hbad s) (by rw [h']; exact hbad t)
    have h1 := Cardinal.lift_mk_le_lift_mk_of_injective hinj
    have h2 := mk_sums_lt S hS
    have h3 : Cardinal.mk (ℕ → Bool) = continuum := by
      rw [Cardinal.mk_arrow]
      simp
    rw [h3, Cardinal.lift_continuum, Cardinal.lift_uzero] at h1
    exact absurd (h1.trans_lt h2) (lt_irrefl _)
  obtain ⟨s, hs⟩ := main
  refine ⟨Bs s, hBsub s, hBinf s, fun N hN => ?_⟩
  by_contra hno
  have : (N ⊓ 𝓟 (Bs s)).NeBot := by
    rw [neBot_iff]
    intro h
    exact hno (inf_principal_eq_bot.1 h)
  have hU := Ultrafilter.of_le (N ⊓ 𝓟 (Bs s))
  obtain ⟨τ, hτ, hUτ⟩ := hN.2 (Ultrafilter.of (N ⊓ 𝓟 (Bs s))) (hU.trans inf_le_left)
  have h1 : (Bs s)ᶜ ∈ (Ultrafilter.of (N ⊓ 𝓟 (Bs s)) : Filter G) := hUτ (hs τ hτ)
  have h2 : Bs s ∈ (Ultrafilter.of (N ⊓ 𝓟 (Bs s)) : Filter G) :=
    hU (mem_inf_of_right (mem_principal_self _))
  have h3 := inter_mem h1 h2
  rw [compl_inter_self] at h3
  exact Filter.empty_notMem _ h3

/-! ### The bound is sharp -/

/-- The unit vector. -/
noncomputable def unit (n : ℕ) : ℕ →₀ ZMod 2 := Finsupp.single n 1

theorem bound_sharp : ∃ S : Set (Ultrafilter (ℕ →₀ ZMod 2)), Cardinal.mk S ≤ continuum ∧
    (∀ b : ℕ →₀ ZMod 2, b ≠ 0 → (pure b : Filter (ℕ →₀ ZMod 2)) ∉ genFam (ultraGen S)) ∧
    ∀ A : Set ℕ, A.Infinite → ∃ N ∈ genFam (ultraGen S), (unit '' A)ᶜ ∉ N := by
  classical
  have hne : ∀ A : {A : Set ℕ // A.Infinite}, (cofinite ⊓ 𝓟 A.1 : Filter ℕ).NeBot := by
    intro A
    rw [neBot_iff]
    intro h
    rw [inf_principal_eq_bot, mem_cofinite, compl_compl] at h
    exact A.2 h
  let w : {A : Set ℕ // A.Infinite} → Ultrafilter ℕ := fun A => by
    haveI := hne A
    exact Ultrafilter.of (cofinite ⊓ 𝓟 A.1)
  have hw : ∀ A, (w A : Filter ℕ) ≤ cofinite ⊓ 𝓟 A.1 := fun A => by
    haveI := hne A
    exact Ultrafilter.of_le _
  set S : Set (Ultrafilter (ℕ →₀ ZMod 2)) := range fun A => (w A).map unit with hSdef
  refine ⟨S, ?_, ?_, ?_⟩
  · refine Cardinal.mk_range_le.trans ((Cardinal.mk_subtype_le _).trans ?_)
    rw [Cardinal.mk_set]
    simp
  · intro b hb hmem
    obtain ⟨σ, hσ, hle⟩ := hmem.2 (pure b) (by rw [Ultrafilter.coe_pure])
    rw [Ultrafilter.coe_pure, Filter.pure_le_iff] at hle
    obtain ⟨ι, _, u, c, hu, _, hrep⟩ := rep_of_sumClosure S hσ
    have hA : ∀ i, unit '' ((b.support : Set ℕ)ᶜ) ∈ u i := by
      intro i
      obtain ⟨A, hAi⟩ := hu i
      rw [← hAi]
      have h1 : ((b.support : Set ℕ)ᶜ) ∈ (w A : Filter ℕ) :=
        (hw A) (mem_inf_of_left (b.support.finite_toSet.compl_mem_cofinite))
      exact Ultrafilter.mem_map.2 (Filter.mem_of_superset h1 fun n hn => ⟨n, hn, rfl⟩)
    obtain ⟨a, ha, hsum⟩ := hle _ (hrep (fun _ => unit '' ((b.support : Set ℕ)ᶜ)) hA)
    apply hb
    ext k
    by_contra hk
    have hks : k ∈ b.support := Finsupp.mem_support_iff.2 hk
    apply hk
    rw [← hsum, Finsupp.finsetSum_apply]
    refine (Finset.sum_eq_zero fun i _ => ?_).trans (Finsupp.zero_apply).symm
    obtain ⟨n, hn, hni⟩ := ha i
    have hne' : k ≠ n := fun h => hn (h ▸ hks)
    rw [Finsupp.coe_smul, Pi.smul_apply, ← hni, unit, Finsupp.single_eq_of_ne hne', smul_zero]
  · intro A hA
    have hmem : (w ⟨A, hA⟩).map unit ∈ S := ⟨⟨A, hA⟩, rfl⟩
    have hgen : (((w ⟨A, hA⟩).map unit : Ultrafilter _) : Filter (ℕ →₀ ZMod 2)) ∈ genFam (ultraGen S) :=
      ⟨inferInstance, fun U hU => ⟨_, SumClosure.gen ⟨_, hmem, rfl⟩, hU⟩⟩
    refine ⟨_, hgen, fun h => ?_⟩
    have h1 : A ∈ (w ⟨A, hA⟩ : Filter ℕ) := (hw ⟨A, hA⟩) (mem_inf_of_right (mem_principal_self _))
    have h2 : unit '' A ∈ (((w ⟨A, hA⟩).map unit : Ultrafilter _) : Filter (ℕ →₀ ZMod 2)) :=
      Ultrafilter.mem_map.2 (Filter.mem_of_superset h1 fun n hn => ⟨n, hn, rfl⟩)
    have h3 := inter_mem h h2
    rw [compl_inter_self] at h3
    exact Filter.empty_notMem _ h3

end PG.Continuum
