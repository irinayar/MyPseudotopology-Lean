import Mathlib
import LeanCheck.PGFourDirected

/-!
# PGfour: an exact criterion for a coreflection when the ideal is generated by subgroups

`ξ` is the PG of the topology of `G` and an ideal `J` with (I1)-(I5), and every member of `J` lies in a subgroup that
belongs to `J`. `K` consists of the group topologies all of whose convergent filters converge for `ξ`.

* `coarsest_iff` : `K` has a coarsest member iff some subgroup `H0` in `J` is open, for the given topology, in every
  subgroup `H ≥ H0` that belongs to `J`;
* `RatEx.no_coarsest` : on `ℚ` with the `p`-adic topology and the ideal of the sets contained in a cyclic subgroup,
  `K` has no coarsest member.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set Topology Pointwise

noncomputable section

namespace PG.SubIdeal

open PG.NoCoreAll (InK)

section General

variable {G : Type*} [AddCommGroup G] [t : TopologicalSpace G] [IsTopologicalAddGroup G]

/-- The group topology in which `H` is open and carries the given topology. -/
@[instance_reducible] def basis (H : AddSubgroup G) : AddGroupFilterBasis G :=
  addGroupFilterBasisOfComm {V | ∃ W ∈ @nhds G t 0, V = W ∩ H} ⟨_, univ, univ_mem, rfl⟩
    (by
      rintro _ _ ⟨W1, h1, rfl⟩ ⟨W2, h2, rfl⟩
      refine ⟨(W1 ∩ W2) ∩ H, ⟨_, inter_mem h1 h2, rfl⟩, fun z hz => ⟨⟨hz.1.1, hz.2⟩, hz.1.2, hz.2⟩⟩)
    (by
      rintro _ ⟨W, hW, rfl⟩
      exact ⟨mem_of_mem_nhds hW, H.zero_mem⟩)
    (by
      rintro _ ⟨W, hW, rfl⟩
      obtain ⟨V, hVo, hV0, hVV⟩ := exists_open_nhds_zero_add_subset hW
      refine ⟨V ∩ H, ⟨V, hVo.mem_nhds hV0, rfl⟩, ?_⟩
      rintro _ ⟨a, ha, b, hb, rfl⟩
      exact ⟨hVV (add_mem_add ha.1 hb.1), H.add_mem ha.2 hb.2⟩)
    (by
      rintro _ ⟨W, hW, rfl⟩
      have h : (fun x : G => -x) ⁻¹' W ∈ @nhds G t 0 :=
        (continuous_neg.tendsto' (0 : G) 0 neg_zero) hW
      exact ⟨((fun x : G => -x) ⁻¹' W) ∩ H, ⟨_, h, rfl⟩, fun x hx => ⟨hx.1, H.neg_mem hx.2⟩⟩)

@[instance_reducible] def opening (H : AddSubgroup G) : TopologicalSpace G := (basis H).topology

theorem opening_group (H : AddSubgroup G) : @IsTopologicalAddGroup G (opening H) _ :=
  (basis H).isTopologicalAddGroup

theorem opening_nhds (H : AddSubgroup G) (x : G) (s : Set G) :
    s ∈ @nhds G (opening H) x ↔ ∃ W ∈ @nhds G t 0, (fun z => x + z) '' (W ∩ H) ⊆ s := by
  have h := (basis H).nhds_hasBasis x
  rw [show @nhds G (opening H) x = @nhds G (basis H).topology x from rfl, h.mem_iff]
  constructor
  · rintro ⟨_, ⟨W, hW, rfl⟩, hs⟩
    exact ⟨W, hW, hs⟩
  · rintro ⟨W, hW, hs⟩
    exact ⟨W ∩ H, ⟨W, hW, rfl⟩, hs⟩

theorem mem_nhds_translate (x : G) (s : Set G) : (fun z => x + z) '' s ∈ @nhds G t x ↔ s ∈ @nhds G t 0 := by
  rw [← map_add_left_nhds_zero x, mem_map, preimage_image_eq _ (add_right_injective x)]

/-- The topology opened at a member of the ideal belongs to `K`. -/
theorem opening_inK {J : Set (Set G)} (hJ : AdmIdeal J) (H : AddSubgroup G) (hH : (H : Set G) ∈ J) :
    InK t J (opening H) := by
  refine ⟨opening_group H, fun x => ⟨?_, ?_, {x} + (H : Set G), hJ.add _ (hJ.single x) _ hH, ?_⟩⟩
  · exact @nhds_neBot G (opening H) x
  · intro s hs
    rw [opening_nhds]
    have h1 : (fun z => x + z) ⁻¹' s ∈ @nhds G t 0 := by
      rw [← map_add_left_nhds_zero x] at hs
      exact hs
    refine ⟨_, h1, ?_⟩
    rintro _ ⟨z, hz, rfl⟩
    exact hz.1
  · rw [opening_nhds]
    refine ⟨univ, univ_mem, ?_⟩
    rintro _ ⟨z, hz, rfl⟩
    exact add_mem_add (mem_singleton x) hz.2

/-- The exact criterion. -/
theorem coarsest_iff {J : Set (Set G)} (hJ : AdmIdeal J)
    (hsub : ∀ A ∈ J, ∃ H : AddSubgroup G, (H : Set G) ∈ J ∧ A ⊆ H) :
    (∃ σ : TopologicalSpace G, InK t J σ ∧
        ∀ τ : TopologicalSpace G, InK t J τ → τ ≤ σ) ↔
      ∃ H0 : AddSubgroup G, (H0 : Set G) ∈ J ∧
        ∀ H : AddSubgroup G, (H : Set G) ∈ J → H0 ≤ H → ∃ W ∈ @nhds G t 0, W ∩ H ⊆ H0 := by
  constructor
  · rintro ⟨σ, hσ, hmin⟩
    obtain ⟨_, _, U, hU, hUn⟩ := hσ.2 0
    obtain ⟨H0, hH0, hUH0⟩ := hsub U hU
    refine ⟨H0, hH0, fun H hH hle => ?_⟩
    have h1 : opening (t := t) H ≤ σ := hmin _ (opening_inK (t := t) hJ H hH)
    have h2 : U ∈ @nhds G (opening (t := t) H) 0 := nhds_mono h1 hUn
    obtain ⟨W, hW, hsubW⟩ := (opening_nhds (t := t) H 0 U).1 h2
    exact ⟨W, hW, fun z hz => hUH0 (hsubW ⟨z, hz, zero_add z⟩)⟩
  · rintro ⟨H0, hH0, hopen⟩
    refine ⟨opening (t := t) H0, opening_inK (t := t) hJ H0 hH0, fun τ hτ => ?_⟩
    have hτg := hτ.1
    obtain ⟨_, hτβ, U, hU, hUn⟩ := hτ.2 0
    obtain ⟨H1, hH1, hUH1⟩ := hsub U hU
    have hsup : ((H1 ⊔ H0 : AddSubgroup G) : Set G) ∈ J := by
      refine hJ.sub _ (hJ.add _ hH1 _ hH0) _ fun z hz => ?_
      obtain ⟨a, ha, b, hb, hab⟩ := AddSubgroup.mem_sup.1 hz
      exact ⟨a, ha, b, hb, hab⟩
    obtain ⟨W1, hW1, hW1s⟩ := hopen (H1 ⊔ H0) hsup le_sup_right
    have htr : ∀ x : G, ∀ s : Set G, s ∈ @nhds G τ x ↔ (fun z => x + z) ⁻¹' s ∈ @nhds G τ 0 := by
      intro x s
      letI := τ
      haveI := hτg
      rw [← map_add_left_nhds_zero x, mem_map]
    refine le_of_nhds_le_nhds fun x => ?_
    intro s hs
    obtain ⟨W, hW, hsubW⟩ := (opening_nhds (t := t) H0 x s).1 hs
    refine (htr x s).2 ?_
    refine mem_of_superset (inter_mem hUn (inter_mem (hτβ hW1) (hτβ hW))) ?_
    rintro z ⟨hzU, hz1, hzW⟩
    have hzH : z ∈ (H1 ⊔ H0 : AddSubgroup G) := AddSubgroup.mem_sup_left (hUH1 hzU)
    exact hsubW ⟨z, ⟨hzW, hW1s ⟨hz1, hzH⟩⟩, rfl⟩

end General

/-! ### The example on `ℚ` -/

namespace RatEx

variable (p : ℕ) [Fact p.Prime]

/-- The `p`-adic topology of `ℚ`. -/
@[instance_reducible] def adic : TopologicalSpace ℚ :=
  TopologicalSpace.induced (Rat.castHom ℚ_[p]) inferInstance

theorem adic_group : @IsTopologicalAddGroup ℚ (adic p) _ :=
  isTopologicalAddGroup_induced (Rat.castHom ℚ_[p])

theorem adic_t2 : @T2Space ℚ (adic p) := by
  letI := adic p
  exact (Topology.IsEmbedding.mk (Topology.IsInducing.mk rfl) (Rat.castHom ℚ_[p]).injective).t2Space

/-- The sets contained in a cyclic subgroup. -/
def J : Set (Set ℚ) := {B | ∃ c : ℚ, B ⊆ AddSubgroup.zmultiples c}

theorem common (a b : ℚ) : ∃ c : ℚ, a ∈ AddSubgroup.zmultiples c ∧ b ∈ AddSubgroup.zmultiples c := by
  refine ⟨1 / (a.den * b.den), ?_, ?_⟩
  · refine AddSubgroup.mem_zmultiples_iff.2 ⟨a.num * b.den, ?_⟩
    have ha : (a.den : ℚ) ≠ 0 := by exact_mod_cast a.den_nz
    have hb : (b.den : ℚ) ≠ 0 := by exact_mod_cast b.den_nz
    rw [zsmul_eq_mul]
    conv_rhs => rw [← Rat.num_div_den a]
    push_cast
    field_simp
  · refine AddSubgroup.mem_zmultiples_iff.2 ⟨b.num * a.den, ?_⟩
    have ha : (a.den : ℚ) ≠ 0 := by exact_mod_cast a.den_nz
    have hb : (b.den : ℚ) ≠ 0 := by exact_mod_cast b.den_nz
    rw [zsmul_eq_mul]
    conv_rhs => rw [← Rat.num_div_den b]
    push_cast
    field_simp

theorem admissible : AdmIdeal J := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rintro S ⟨c, h⟩ B hB
    exact ⟨c, hB.trans h⟩
  · rintro S ⟨a, h⟩ B ⟨b, h'⟩
    obtain ⟨c, ha, hb⟩ := common a b
    refine ⟨c, union_subset (h.trans ?_) (h'.trans ?_)⟩
    · exact AddSubgroup.zmultiples_le_of_mem ha
    · exact AddSubgroup.zmultiples_le_of_mem hb
  · intro x
    exact ⟨x, singleton_subset_iff.2 (AddSubgroup.mem_zmultiples x)⟩
  · rintro ⟨c, h⟩
    rcases eq_or_ne c 0 with hc | hc
    · have := h (mem_univ (1 : ℚ))
      rw [hc, AddSubgroup.zmultiples_zero_eq_bot] at this
      exact one_ne_zero (AddSubgroup.mem_bot.1 this)
    · obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 (h (mem_univ (c / 2)))
      rw [zsmul_eq_mul] at hk
      have h2 : ((2 * k : ℤ) : ℚ) = ((1 : ℤ) : ℚ) := by
        have : (k : ℚ) = 1 / 2 := by
          apply mul_right_cancel₀ hc
          rw [hk]
          ring
        push_cast
        rw [this]
        norm_num
      have := Int.cast_injective h2
      omega
  · rintro S ⟨a, h⟩ B ⟨b, h'⟩
    obtain ⟨c, ha, hb⟩ := common a b
    refine ⟨c, ?_⟩
    rintro _ ⟨x, hx, y, hy, rfl⟩
    exact (AddSubgroup.zmultiples c).add_mem (AddSubgroup.zmultiples_le_of_mem ha (h hx))
      (AddSubgroup.zmultiples_le_of_mem hb (h' hy))
  · rintro S ⟨c, h⟩
    refine ⟨c, ?_⟩
    rintro _ ⟨x, hx, rfl⟩
    exact (AddSubgroup.zmultiples c).neg_mem (h hx)

theorem cyclic_mem (c : ℚ) : ((AddSubgroup.zmultiples c : AddSubgroup ℚ) : Set ℚ) ∈ J := ⟨c, subset_rfl⟩

theorem generated (A : Set ℚ) (hA : A ∈ J) :
    ∃ H : AddSubgroup ℚ, (H : Set ℚ) ∈ J ∧ A ⊆ H := by
  obtain ⟨c, hc⟩ := hA
  exact ⟨_, cyclic_mem c, hc⟩

/-- No coarsest group topology. -/
theorem no_coarsest : ¬ ∃ σ : TopologicalSpace ℚ, InK (adic p) J σ ∧
    ∀ τ : TopologicalSpace ℚ, InK (adic p) J τ → τ ≤ σ := by
  letI := adic p
  haveI := adic_group p
  intro h
  obtain ⟨H0, ⟨c0, hc0⟩, hopen⟩ := (coarsest_iff (G := ℚ) admissible generated).1 h
  -- a non-zero generator above `H0`
  obtain ⟨c, hc, hle⟩ : ∃ c : ℚ, c ≠ 0 ∧ H0 ≤ AddSubgroup.zmultiples c := by
    rcases eq_or_ne c0 0 with h0 | h0
    · refine ⟨1, one_ne_zero, fun z hz => ?_⟩
      have := hc0 hz
      rw [h0, AddSubgroup.zmultiples_zero_eq_bot] at this
      rw [AddSubgroup.mem_bot.1 this]
      exact zero_mem _
    · exact ⟨c0, h0, hc0⟩
  obtain ⟨l, hl, hlp⟩ := Nat.exists_infinite_primes (p + 1)
  have hl0 : (l : ℚ) ≠ 0 := by exact_mod_cast hlp.ne_zero
  have hH0H : H0 ≤ AddSubgroup.zmultiples (c / l) := by
    refine hle.trans (AddSubgroup.zmultiples_le_of_mem (AddSubgroup.mem_zmultiples_iff.2 ⟨l, ?_⟩))
    rw [zsmul_eq_mul]
    push_cast
    field_simp
  obtain ⟨W, hW, hWs⟩ := hopen _ (cyclic_mem (c / l)) hH0H
  -- the points `p ^ k * (c / l)` tend to `0`
  have ht : Tendsto (fun k : ℕ => (p : ℚ) ^ k * (c / l)) atTop (𝓝 (0 : ℚ)) := by
    rw [show 𝓝 (0 : ℚ) = Filter.comap (Rat.castHom ℚ_[p]) (𝓝 (Rat.castHom ℚ_[p] 0)) from nhds_induced _ _,
      tendsto_comap_iff, map_zero]
    have h1 : Tendsto (fun k : ℕ => (p : ℚ_[p]) ^ k) atTop (𝓝 0) :=
      tendsto_pow_atTop_nhds_zero_of_norm_lt_one Padic.norm_p_lt_one
    have h2 := h1.mul_const (Rat.castHom ℚ_[p] (c / l))
    rw [zero_mul] at h2
    refine h2.congr fun k => ?_
    show (p : ℚ_[p]) ^ k * Rat.castHom ℚ_[p] (c / l) = Rat.castHom ℚ_[p] ((p : ℚ) ^ k * (c / l))
    rw [map_mul, map_pow, map_natCast]
  obtain ⟨k, hk⟩ := (ht.eventually_mem hW).exists
  have hmem : (p : ℚ) ^ k * (c / l) ∈ AddSubgroup.zmultiples (c / l) := by
    refine AddSubgroup.mem_zmultiples_iff.2 ⟨(p : ℤ) ^ k, ?_⟩
    rw [zsmul_eq_mul]
    push_cast
    ring
  have h0 := hle (hWs ⟨hk, hmem⟩)
  obtain ⟨m, hm⟩ := AddSubgroup.mem_zmultiples_iff.1 h0
  rw [zsmul_eq_mul] at hm
  have h3 : ((m * l : ℤ) : ℚ) = (((p : ℤ) ^ k : ℤ) : ℚ) := by
    have : (m : ℚ) = (p : ℚ) ^ k / l := by
      apply mul_right_cancel₀ hc
      rw [hm]
      ring
    push_cast
    rw [this]
    field_simp
  have h4 : (l : ℤ) ∣ (p : ℤ) ^ k := ⟨m, by rw [← Int.cast_injective h3, mul_comm]⟩
  have h5 : l ∣ p ^ k := by exact_mod_cast h4
  have h6 := (Nat.prime_dvd_prime_iff_eq hlp (Fact.out : p.Prime)).1 (hlp.dvd_of_dvd_pow h5)
  omega

end RatEx

end PG.SubIdeal
