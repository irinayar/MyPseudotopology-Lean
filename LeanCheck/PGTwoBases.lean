import Mathlib
import LeanCheck.PGJoin
import LeanCheck.PGDigit

/-!
# PG: two bases, the ideal generated by `I_p ∪ I_q` (Lean check)

Scope. Section 8 (two bases) of `PG_v9`. `Dsum p q k l = D_{p,k} + D_{q,l}`.

* `joinI_Ip_iff` : a set belongs to `joinI (Ip p) (Ip q)` iff it lies in some `D_{p,k} + D_{q,l}`;
* `univ_notin_join_of_finite` : properness of the join follows from a counting hypothesis: for all `k`, `l` there are `X` and a
  finite set `s` with fewer than `2X+1` elements containing all elements of `D_{p,k} + D_{q,l}` of absolute value at most `X`;
* `Ipq_admissible` : under that hypothesis `joinI (Ip p) (Ip q)` satisfies (I1)-(I5) (given properness of `Ip p`, `Ip q`);
* `exists_nondegenerate_sub` : any finite family of integers (a multiset of values) has a subfamily with the same sum and
  no nonempty subfamily with sum `0` (removal of vanishing subsums).

Not formalized: the counting hypothesis itself, which follows from the height inequality for non-degenerate sums of `S`-units
(quoted in `PG_v9`), and the counting of tuples.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Set

namespace PG

/-- `D_{p,k} + D_{q,l}`. -/
def Dsum (p q k l : ℕ) : Set ℤ := Set.image2 (· + ·) (D p k) (D q l)

theorem joinI_Ip_iff (p q : ℕ) (A : Set ℤ) :
    A ∈ joinI (Ip p) (Ip q) ↔ ∃ k l : ℕ, A ⊆ Dsum p q k l := by
  constructor
  · rintro ⟨B, ⟨k, hk⟩, C, ⟨l, hl⟩, h⟩
    exact ⟨k, l, h.trans (Set.image2_subset hk hl)⟩
  · rintro ⟨k, l, h⟩
    exact ⟨D p k, ⟨k, subset_rfl⟩, D q l, ⟨l, subset_rfl⟩, h⟩

theorem univ_notin_join_of_finite (p q : ℕ)
    (hcount : ∀ k l : ℕ, ∃ (X : ℕ) (s : Finset ℤ), s.card < 2 * X + 1 ∧
      ∀ n ∈ Dsum p q k l, |n| ≤ (X : ℤ) → n ∈ s) :
    (Set.univ : Set ℤ) ∉ joinI (Ip p) (Ip q) := by
  intro h
  obtain ⟨k, l, hkl⟩ := (joinI_Ip_iff p q _).1 h
  obtain ⟨X, s, hs, hmem⟩ := hcount k l
  have hsub : Finset.Icc (-(X : ℤ)) (X : ℤ) ⊆ s := by
    intro n hn
    exact hmem n (hkl (Set.mem_univ n)) (abs_le.2 (Finset.mem_Icc.1 hn))
  have h1 := Finset.card_le_card hsub
  rw [Int.card_Icc] at h1
  omega

theorem Ipq_admissible (p q : ℕ) (hP : (Set.univ : Set ℤ) ∉ Ip p) (hQ : (Set.univ : Set ℤ) ∉ Ip q)
    (hcount : ∀ k l : ℕ, ∃ (X : ℕ) (s : Finset ℤ), s.card < 2 * X + 1 ∧
      ∀ n ∈ Dsum p q k l, |n| ≤ (X : ℤ) → n ∈ s) :
    AdmIdeal (joinI (Ip p) (Ip q)) :=
  joinI_admissible (Ip_admissible p hP) (Ip_admissible q hQ) (univ_notin_join_of_finite p q hcount)

/-- Removal of vanishing subsums. -/
theorem exists_nondegenerate_sub {α : Type*} [DecidableEq α] (f : α → ℤ) :
    ∀ (n : ℕ) (m : Multiset α), Multiset.card m = n →
      ∃ R ≤ m, (R.map f).sum = (m.map f).sum ∧
        ∀ R' ≤ R, R' ≠ 0 → (R'.map f).sum ≠ 0 := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro m hm
    by_cases h : ∃ R' ≤ m, R' ≠ 0 ∧ (R'.map f).sum = 0
    · obtain ⟨R', hR', hne, hsum⟩ := h
      have hpos : 0 < Multiset.card R' := Multiset.card_pos.2 hne
      have hcard : Multiset.card (m - R') < n := by
        rw [Multiset.card_sub hR']
        have : Multiset.card R' ≤ Multiset.card m := Multiset.card_le_card hR'
        omega
      obtain ⟨R, hR, hsum', hnd⟩ := ih _ hcard (m - R') rfl
      refine ⟨R, hR.trans tsub_le_self, ?_, hnd⟩
      have e : m = R' + (m - R') := (add_tsub_cancel_of_le hR').symm
      rw [hsum', e, Multiset.map_add, Multiset.sum_add, hsum, zero_add]
      simp
    · exact ⟨m, le_rfl, rfl, fun R' hR' hne hsum => h ⟨R', hR', hne, hsum⟩⟩

end PG
