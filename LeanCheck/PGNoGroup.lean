import Mathlib
import LeanCheck.PGGroupTop

/-!
# PG: the closed-cover form of the reduction for "the modification is not a group topology" (Lean check)

Scope. Section 8 of `PG_v11` (the modification of `ξ_{p,q}` is not a group topology), in an abstract form that also
covers Theorem 7.8 for `ξ_p`. Let `I` be an admissible ideal on an abelian Hausdorff topological group `G`, generated by
a sequence of sets `A n ∈ I` (every `B ∈ I` lies in some `A n`).

* `no_groupTop_of_cover` : let `C ⊆ G` with `0 ∉ C` such that `C ∩ A n` is closed for every `n`, and let `B₀ ∈ I` be
  such that for every sequence `W j` of neighbourhoods of `0` there are `n` and `f j ∈ W j ∩ B₀` (`j < n`) with
  `f 0 + ... + f (n-1) ∈ C`. Then no group topology has `IsOpenXi I` as its family of open sets.

The proof shows that `G ∖ C` is `ξ`-open (a set is open iff `cl(B ∖ U) ∩ U = ∅` for `B ∈ I`), that every
`S ∈ V_ξ(0)` contains `W ∩ B₀` for a neighbourhood `W` of `0`, and applies `no_groupTop_of_sums`.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set Topology

namespace PG

section nogroup

variable {G : Type*} [AddCommGroup G] [β : TopologicalSpace G] [IsTopologicalAddGroup G] [T2Space G]

/-- `S ∈ V_ξ(0)` contains `W ∩ B` for a neighbourhood `W` of `0`, for every `B ∈ I`. -/
theorem exists_nhds_inter_subset_of_Vxi {I : Set (Set G)} (hI : AdmIdeal I) {S : Set G}
    (hS : S ∈ Vxi I 0) {B : Set G} (hB : B ∈ I) : ∃ W ∈ 𝓝 (0 : G), W ∩ B ⊆ S := by
  have h0 := (mem_Vxi_zero_iff hI S).1 hS B hB
  rw [mem_closure_iff_nhds] at h0
  push Not at h0
  obtain ⟨W, hW, hempty⟩ := h0
  refine ⟨W, hW, ?_⟩
  intro y hy
  by_contra hyS
  have : y ∈ W ∩ (B \ S) := ⟨hy.1, hy.2, hyS⟩
  rw [hempty] at this
  exact this

/-- `G ∖ C` is `ξ`-open if `C ∩ A n` is closed for a generating sequence `A n` of the ideal. -/
theorem isOpenXi_compl_of_cover {I : Set (Set G)} (hI : AdmIdeal I) (A : ℕ → Set G)
    (hcov : ∀ B ∈ I, ∃ n, B ⊆ A n) {C : Set G} (hcl : ∀ n, IsClosed (C ∩ A n)) :
    IsOpenXi I Cᶜ := by
  rw [isOpenXi_iff hI]
  intro B hB
  obtain ⟨n, hn⟩ := hcov B hB
  rw [Set.eq_empty_iff_forall_notMem]
  rintro x ⟨hxc, hxU⟩
  have hsub : B \ Cᶜ ⊆ C ∩ A n := by
    intro y hy
    refine ⟨?_, hn hy.1⟩
    by_contra hyC
    exact hy.2 hyC
  have hx : x ∈ C ∩ A n := (hcl n).closure_subset_iff.2 hsub hxc
  exact hxU hx.1

theorem no_groupTop_of_cover {I : Set (Set G)} (hI : AdmIdeal I) (A : ℕ → Set G)
    (hcov : ∀ B ∈ I, ∃ n, B ⊆ A n) {C : Set G} (h0 : (0 : G) ∉ C)
    (hcl : ∀ n, IsClosed (C ∩ A n)) {B₀ : Set G} (hB₀ : B₀ ∈ I)
    (hsum : ∀ W : ℕ → Set G, (∀ j, W j ∈ 𝓝 (0 : G)) →
      ∃ (n : ℕ) (f : ℕ → G), (∀ j < n, f j ∈ W j ∩ B₀) ∧ ∑ j ∈ Finset.range n, f j ∈ C) :
    ¬ ∃ τ : TopologicalSpace G, (@IsTopologicalAddGroup G τ (inferInstance : AddGroup G)) ∧
      ∀ U : Set G, @IsOpen G τ U ↔ @IsOpenXi G β I U := by
  refine no_groupTop_of_sums hI (O := Cᶜ) (isOpenXi_compl_of_cover hI A hcov hcl) h0 ?_
  intro S hS _
  choose W hW hWS using fun j => exists_nhds_inter_subset_of_Vxi hI (hS j) hB₀
  obtain ⟨n, f, hf, hC⟩ := hsum W hW
  exact ⟨n, f, fun j hj => hWS j ⟨(hf j hj).1, (hf j hj).2⟩, fun h => h hC⟩

end nogroup

end PG
