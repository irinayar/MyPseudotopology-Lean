import Mathlib
import LeanCheck.PGThreeHeight
import LeanCheck.PGThreeIdem
import LeanCheck.PGDigit

/-!
# PGthree, Section 9: words of bounded length, translates, bounded numbers of powers (Lean check)

* `coarsest_iff` : for any null family in which the symmetric halvable null filters containing `0` are the principal
  filters of the finite subgroups of null points, there is a coarsest one exactly when only finitely many null points
  have finite order (the criterion in terms of the torsion subgroup);
* `word_no_idempotent`, `words_nbhd`, `words_coarsest_iff`, `words_finite_family`, `words_finite_coarsest` : ultrafilters on sums of boundedly many elements of an
  independent set (`Word E n` is the set of the combinations whose coefficients have absolute values adding up to at
  most `n`);
* `translates_pure_iff`, `translates_word`, `translates_coarsest_iff`, `exists_countable_no_coarsest` : translates of
  one ultrafilter, and a countable family on the countable Boolean group with no coarsest such filter, without
  set-theoretic hypotheses;
* `powers_trivial`, `powers_not_pretopological` : ultrafilters on sums of boundedly many signed powers of `p`;
* `digits_trivial`, `freeAbelian_trivial` : the bounded digit statements without the assumption that the generators are
  free.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set Topology

namespace PG

namespace Words

open Sel PG.Idem _root_.PG.Height

attribute [local instance] Ultrafilter.add Ultrafilter.addSemigroup

variable {G : Type} [AddCommGroup G]

/-! ### The criterion in terms of the torsion subgroup -/

/-- The points whose principal filter belongs to a null family form a subgroup. -/
def nullPts (C : Set (Filter G)) (hC : NullFamily C) : AddSubgroup G where
  carrier := {g | (pure g : Filter G) ∈ C}
  zero_mem' := hC.pure_zero
  add_mem' := fun {a b} ha hb => by
    have h1 := hC.add _ ha _ hb
    rwa [Filter.map₂_pure] at h1
  neg_mem' := fun {a} ha => by
    have h1 := hC.neg _ ha
    rwa [Filter.map_pure] at h1

theorem coarsest_iff {C : Set (Filter G)} (hC : NullFamily C)
    (hcl : ∀ N : Filter G, (IsNbhdFilter N ∧ N ∈ C) ↔
      ∃ F : AddSubgroup G, (F : Set G).Finite ∧ (∀ g ∈ F, (pure g : Filter G) ∈ C) ∧ N = 𝓟 (F : Set G)) :
    (∃ N0 : Filter G, (IsNbhdFilter N0 ∧ N0 ∈ C) ∧ ∀ N : Filter G, IsNbhdFilter N → N ∈ C → N ≤ N0) ↔
      {g : G | (pure g : Filter G) ∈ C ∧ IsOfFinAddOrder g}.Finite := by
  constructor
  · rintro ⟨N0, hN0, hmax⟩
    obtain ⟨F0, hF0, _, rfl⟩ := (hcl N0).1 hN0
    refine hF0.subset (fun g hg => ?_)
    have h1 : IsNbhdFilter (𝓟 (AddSubgroup.zmultiples g : Set G)) ∧ 𝓟 (AddSubgroup.zmultiples g : Set G) ∈ C :=
      (hcl _).2 ⟨_, finite_zmultiples.2 hg.2, AddSubgroup.zmultiples_le_of_mem (H := nullPts C hC) hg.1, rfl⟩
    have h2 := hmax _ h1.1 h1.2
    exact Filter.principal_mono.1 h2 (AddSubgroup.mem_zmultiples g)
  · intro hfin
    let T : AddSubgroup G :=
      { carrier := {g : G | (pure g : Filter G) ∈ C ∧ IsOfFinAddOrder g}
        zero_mem' := ⟨(nullPts C hC).zero_mem, IsOfFinAddOrder.zero⟩
        add_mem' := fun {a b} ha hb =>
          ⟨(nullPts C hC).add_mem ha.1 hb.1, (AddCommute.all a b).isOfFinAddOrder_add ha.2 hb.2⟩
        neg_mem' := fun {a} ha => ⟨(nullPts C hC).neg_mem ha.1, ha.2.neg⟩ }
    refine ⟨𝓟 (T : Set G), (hcl _).2 ⟨T, hfin, fun g hg => hg.1, rfl⟩, fun N hN hNC => ?_⟩
    obtain ⟨F, hF, hFH, rfl⟩ := (hcl N).1 ⟨hN, hNC⟩
    refine Filter.principal_mono.2 (fun g hg => ⟨hFH g hg, ?_⟩)
    have h1 : (AddSubgroup.zmultiples g : Set G).Finite := hF.subset (AddSubgroup.zmultiples_le_of_mem hg)
    exact finite_zmultiples.1 h1

/-- In a subgroup generated by finitely many elements only finitely many elements have finite order. -/
theorem finite_torsion_closure (T : Set G) (hT : T.Finite) :
    {g : G | g ∈ AddSubgroup.closure T ∧ IsOfFinAddOrder g}.Finite := by
  have hM : Module.Finite ℤ (Submodule.span ℤ T) := Module.Finite.span_of_finite ℤ hT
  have hN : Finite (Submodule.torsion ℤ (Submodule.span ℤ T)) :=
    Module.finite_of_fg_torsion _ (Submodule.torsion_isTorsion)
  have h1 : (Set.range (fun x : Submodule.torsion ℤ (Submodule.span ℤ T) =>
      ((x.1 : Submodule.span ℤ T) : G))).Finite := Set.finite_range _
  refine h1.subset (fun g hg => ?_)
  obtain ⟨hgT, hgo⟩ := hg
  have hgM : g ∈ Submodule.span ℤ T := by
    rwa [← Submodule.mem_toAddSubgroup, Submodule.span_int_eq_addSubgroupClosure]
  obtain ⟨n, hn, hng⟩ := isOfFinAddOrder_iff_nsmul_eq_zero.1 hgo
  have h2 : (⟨g, hgM⟩ : Submodule.span ℤ T) ∈ Submodule.torsion ℤ (Submodule.span ℤ T) := by
    rw [Submodule.mem_torsion_iff]
    refine ⟨⟨(n : ℤ), mem_nonZeroDivisors_of_ne_zero (by exact_mod_cast hn.ne')⟩, ?_⟩
    refine Subtype.ext ?_
    show (n : ℤ) • g = 0
    rw [natCast_zsmul]
    exact hng
  exact ⟨⟨_, h2⟩, rfl⟩

/-- A null family which is not pretopological: if the only symmetric halvable null filter containing `0` is that of `0`
and some free ultrafilter is null, then the vicinity filter is not null. -/
theorem not_pretopological {C : Set (Filter G)} (hC : NullFamily C)
    (h0 : ∀ N : Filter G, IsNbhdFilter N → N ∈ C → N = pure 0)
    (p : Ultrafilter G) (hpC : (p : Filter G) ∈ C) (hpfree : ∀ a, p ≠ pure a) : vic C ∉ C := by
  intro hvic
  have hV : IsNbhdFilter (vic C) := by
    refine ⟨fun A hA => vic_zero_mem hC hA, fun A hA => vic_neg hC hA, fun A hA => ?_⟩
    have h1 : Filter.map₂ (· + ·) (vic C) (vic C) ≤ vic C := le_vic (hC.add _ hvic _ hvic)
    obtain ⟨B1, hB1, B2, hB2, h2⟩ := Filter.mem_map₂_iff.1 (h1 hA)
    exact ⟨B1 ∩ B2, Filter.inter_mem hB1 hB2, fun x hx y hy => h2 (mem_image2_of_mem hx.1 hy.2)⟩
  have h1 : (p : Filter G) ≤ pure 0 := h0 _ hV hvic ▸ le_vic hpC
  have h2 : ({0} : Set G) ∈ p := h1 (Filter.mem_pure.2 rfl)
  obtain ⟨b, _, h3⟩ := Ultrafilter.eq_pure_of_finite_mem (finite_singleton _) h2
  exact hpfree b h3

/-! ### Words of bounded length -/

/-- Sums of at most `n` elements `±e` with `e ∈ E`. -/
def Word (E : Set G) (n : ℕ) : Set G := {z | ∃ c : E →₀ ℤ, ev E c = z ∧ (∑ x ∈ c.support, |c x|) ≤ (n : ℤ)}

theorem ev_neg (E : Set G) (c : E →₀ ℤ) : ev E (-c) = -ev E c := by
  have h := ev_sub E 0 c
  rwa [zero_sub, ev_zero, zero_sub] at h

theorem word_bounded (E : Set G) : Bounded (Word E) := by
  classical
  refine ⟨⟨0, ev_zero E, by simp⟩, fun k x hx => ?_, fun j k x hx y hy => ?_⟩
  · obtain ⟨c, hc, hn⟩ := hx
    refine ⟨-c, by rw [ev_neg, hc], ?_⟩
    rw [Finsupp.support_neg]
    simpa using hn
  · obtain ⟨c, hc, hn⟩ := hx
    obtain ⟨d, hd, hm⟩ := hy
    refine ⟨c + d, by rw [ev_add, hc, hd], ?_⟩
    set U : Finset E := c.support ∪ d.support with hU
    have hsum : ∀ f : E →₀ ℤ, f.support ⊆ U → ∑ x ∈ f.support, |f x| = ∑ x ∈ U, |f x| := by
      intro f hf
      refine Finset.sum_subset hf (fun x _ hx => ?_)
      rw [Finsupp.notMem_support_iff.1 hx, abs_zero]
    have h1 : ∑ x ∈ (c + d).support, |(c + d) x| ≤ ∑ x ∈ U, |c x| + ∑ x ∈ U, |d x| := by
      rw [hsum (c + d) Finsupp.support_add, ← Finset.sum_add_distrib]
      refine Finset.sum_le_sum (fun x _ => ?_)
      rw [Finsupp.add_apply]
      exact abs_add_le _ _
    rw [← hsum c Finset.subset_union_left, ← hsum d Finset.subset_union_right] at h1
    push_cast
    exact h1.trans (add_le_add hn hm)

/-- No free ultrafilter on words of bounded length is idempotent. -/
theorem word_no_idempotent (E : Set G) (hE : Indep E) (n : ℕ) (p : Ultrafilter G) (hBp : Word E n ∈ p)
    (hpfree : ∀ a, p ≠ pure a) : p + p ≠ p := by
  classical
  intro hpp
  set B : Set G := Word E n with hB
  have hr : ∀ z : G, ∃ c : E →₀ ℤ, z ∈ B → ev E c = z ∧ (∑ x ∈ c.support, |c x|) ≤ (n : ℤ) := by
    intro z
    by_cases hz : z ∈ B
    · obtain ⟨c, hc⟩ := hz
      exact ⟨c, fun _ => hc⟩
    · exact ⟨0, fun h => absurd h hz⟩
  choose r hr using hr
  have hbound : ∀ z ∈ B, ∀ x : E, |r z x| ≤ (n : ℤ) := by
    intro z hz x
    by_cases hx : x ∈ (r z).support
    · exact (Finset.single_le_sum (f := fun x => |r z x|) (fun _ _ => abs_nonneg _) hx).trans (hr z hz).2
    · rw [Finsupp.notMem_support_iff.1 hx]; simp
  have hcomp : ∀ (c d : E →₀ ℤ), ev E c = ev E d → ∀ x : E, c x • (x : G) = d x • (x : G) := by
    intro c d hcd x
    have h1 := hE (c - d) (by rw [ev_sub, hcd, sub_self]) x
    rwa [Finsupp.sub_apply, sub_smul, sub_eq_zero] at h1
  have hadd : ∀ x ∈ B, ∀ z ∈ B, x + z ∈ B → ∀ e : E,
      r (x + z) e • (e : G) = r x e • (e : G) + r z e • (e : G) := by
    intro x hx z hz hxz e
    have h1 := hcomp (r (x + z)) (r x + r z) (by
      rw [ev_add, (hr x hx).1, (hr z hz).1, (hr _ hxz).1]) e
    rwa [Finsupp.add_apply, add_smul] at h1
  have htwice : ∀ A ∈ p, ∀ᶠ x in (p : Filter G), ∀ᶠ z in (p : Filter G), x + z ∈ A := by
    intro A hA
    have h1 : A ∈ p + p := by rw [hpp]; exact hA
    rw [Idem.mem_add] at h1
    exact h1
  have hzero : ∀ e : E, {z | z ∈ B ∧ r z e • (e : G) = 0} ∈ p := by
    intro e
    have h1 : ∃ k ∈ Finset.Icc (-(n : ℤ)) n, {z | z ∈ B ∧ r z e • (e : G) = k • (e : G)} ∈ p := by
      by_contra hc
      have h2 : (⋂ k ∈ Finset.Icc (-(n : ℤ)) n, {z | z ∈ B ∧ r z e • (e : G) = k • (e : G)}ᶜ) ∈ (p : Filter G) := by
        refine (Filter.biInter_finset_mem _).2 (fun k hk => ?_)
        rcases p.mem_or_compl_mem {z | z ∈ B ∧ r z e • (e : G) = k • (e : G)} with h3 | h3
        · exact absurd ⟨k, hk, h3⟩ hc
        · exact h3
      obtain ⟨z, hz1, hz2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (p : Filter G)) h2 hBp)
      exact mem_iInter₂.1 hz1 (r z e) (Finset.mem_Icc.2 (abs_le.1 (hbound z hz2 e))) ⟨hz2, rfl⟩
    obtain ⟨k, _, hk⟩ := h1
    have h2 := htwice _ hk
    obtain ⟨x, hx1, hx2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (p : Filter G)) h2 hk)
    obtain ⟨z, ⟨hz1, hz2⟩⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (p : Filter G)) hx1 hk)
    have hz1' : x + z ∈ B ∧ r (x + z) e • (e : G) = k • (e : G) := hz1
    have h3 := hadd x hx2.1 z hz2.1 hz1'.1 e
    rw [hz1'.2, hx2.2, hz2.2] at h3
    have h4 : k • (e : G) = 0 := by
      have h5 : k • (e : G) + 0 = k • (e : G) + k • (e : G) := by rw [add_zero]; exact h3
      exact (add_left_cancel h5).symm
    rw [h4] at hk
    exact hk
  let supp : G → Finset E := fun z => (r z).support.filter (fun e => r z e • (e : G) ≠ 0)
  have hsupp : ∀ z (e : E), e ∈ supp z ↔ r z e • (e : G) ≠ 0 := by
    intro z e
    show e ∈ (r z).support.filter (fun e => r z e • (e : G) ≠ 0) ↔ _
    rw [Finset.mem_filter]
    refine ⟨fun h => h.2, fun h => ⟨Finsupp.mem_support_iff.2 (fun h0 => h ?_), h⟩⟩
    rw [h0, zero_smul]
  have hcard : ∀ z ∈ B, (supp z).card ≤ n := by
    intro z hz
    have h1 : ((supp z).card : ℤ) ≤ ∑ x ∈ (r z).support, |r z x| := by
      have h2 : ((supp z).card : ℤ) = ∑ _x ∈ supp z, (1 : ℤ) := by simp
      rw [h2]
      refine (Finset.sum_le_sum (fun x hx => ?_)).trans
        (Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _) (fun _ _ _ => abs_nonneg _))
      exact Int.one_le_abs (Finsupp.mem_support_iff.1 (Finset.mem_filter.1 hx).1)
    exact_mod_cast h1.trans (hr z hz).2
  have hk : ∃ k ≤ n, {z | z ∈ B ∧ (supp z).card = k} ∈ p := by
    by_contra hc
    have h2 : (⋂ k ∈ Finset.range (n + 1), {z | z ∈ B ∧ (supp z).card = k}ᶜ) ∈ (p : Filter G) := by
      refine (Filter.biInter_finset_mem _).2 (fun k hk => ?_)
      rcases p.mem_or_compl_mem {z | z ∈ B ∧ (supp z).card = k} with h3 | h3
      · exact absurd ⟨k, Nat.le_of_lt_succ (Finset.mem_range.1 hk), h3⟩ hc
      · exact h3
    obtain ⟨z, hz1, hz2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (p : Filter G)) h2 hBp)
    exact mem_iInter₂.1 hz1 _ (Finset.mem_range.2 (Nat.lt_succ_of_le (hcard z hz2))) ⟨hz2, rfl⟩
  obtain ⟨k, _, hkp⟩ := hk
  have h2 := htwice _ hkp
  obtain ⟨x, hx1, hx2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (p : Filter G)) h2 hkp)
  have hfresh : (⋂ e ∈ supp x, {z | z ∈ B ∧ r z e • (e : G) = 0}) ∈ (p : Filter G) :=
    (Filter.biInter_finset_mem _).2 (fun e _ => hzero e)
  obtain ⟨z, ⟨hz1, hz2⟩, hz3⟩ := Ultrafilter.nonempty_of_mem
    (Filter.inter_mem (f := (p : Filter G)) (Filter.inter_mem (f := (p : Filter G)) hx1 hkp) hfresh)
  have hz1' : x + z ∈ B ∧ (supp (x + z)).card = k := hz1
  have hzx : ∀ e ∈ supp x, r z e • (e : G) = 0 := fun e he => (mem_iInter₂.1 hz3 e he).2
  have hdisj : Disjoint (supp x) (supp z) := by
    rw [Finset.disjoint_left]
    intro e hex hez
    exact (hsupp z e).1 hez (hzx e hex)
  have hunion : supp (x + z) = supp x ∪ supp z := by
    ext e
    rw [Finset.mem_union, hsupp, hsupp, hsupp, hadd x hx2.1 z hz2.1 hz1'.1 e]
    by_cases hex : r x e • (e : G) = 0
    · rw [hex, zero_add]
      exact ⟨Or.inr, fun h => h.resolve_left (fun h' => h' rfl)⟩
    · rw [hzx e ((hsupp x e).2 hex), add_zero]
      exact ⟨Or.inl, fun _ => hex⟩
  have h3 : k = k + k := by
    have h4 := congrArg Finset.card hunion
    rw [Finset.card_union_of_disjoint hdisj, hz1'.2, hx2.2, hz2.2] at h4
    exact h4
  have hk0 : k = 0 := by omega
  have h5 : ({0} : Set G) ∈ p := by
    refine Filter.mem_of_superset hkp (fun w hw => ?_)
    obtain ⟨hwB, hwk⟩ := hw
    rw [hk0, Finset.card_eq_zero] at hwk
    show w = 0
    rw [← (hr w hwB).1]
    refine Finset.sum_eq_zero (fun e _ => ?_)
    by_contra h6
    have h7 : e ∈ supp w := (hsupp w e).2 h6
    rw [hwk] at h7
    simp at h7
  obtain ⟨b, _, h6⟩ := Ultrafilter.eq_pure_of_finite_mem (finite_singleton _) h5
  exact hpfree b h6

/-- Words of bounded length: no free null idempotent. -/
theorem words_no_free_idempotent (E : Set G) (hE : Indep E) (S : Set (Ultrafilter G))
    (hS : ∀ u ∈ S, ∃ n, Word E n ∈ u) :
    ∀ p : Ultrafilter G, (p : Filter G) ∈ genFam (ultraGen S) → (∀ a, p ≠ pure a) → p + p ≠ p := by
  intro p hp hfree
  obtain ⟨k, hk⟩ := null_contains (word_bounded E) S hS p hp
  exact word_no_idempotent E hE k p hk hfree

/-- Words of bounded length: the symmetric halvable null filters. -/
theorem words_nbhd (E : Set G) (hE : Indep E) (S : Set (Ultrafilter G)) (hS : ∀ u ∈ S, ∃ n, Word E n ∈ u)
    (N : Filter G) : (IsNbhdFilter N ∧ N ∈ genFam (ultraGen S)) ↔
      ∃ F : AddSubgroup G, (F : Set G).Finite ∧ (∀ g ∈ F, (pure g : Filter G) ∈ genFam (ultraGen S)) ∧
        N = 𝓟 (F : Set G) :=
  nbhd_iff_of_no_idempotent (genFam_nullFamily _) (words_no_free_idempotent E hE S hS) N

theorem words_coarsest_iff (E : Set G) (hE : Indep E) (S : Set (Ultrafilter G)) (hS : ∀ u ∈ S, ∃ n, Word E n ∈ u) :
    (∃ N0 : Filter G, (IsNbhdFilter N0 ∧ N0 ∈ genFam (ultraGen S)) ∧
        ∀ N : Filter G, IsNbhdFilter N → N ∈ genFam (ultraGen S) → N ≤ N0) ↔
      {g : G | (pure g : Filter G) ∈ genFam (ultraGen S) ∧ IsOfFinAddOrder g}.Finite :=
  coarsest_iff (genFam_nullFamily _) (words_nbhd E hE S hS)

/-- Words of bounded length: a finite family has only finitely many null points of finite order. -/
theorem words_finite_family (E : Set G) (hE : Indep E) (S : Set (Ultrafilter G)) (hSfin : S.Finite)
    (hS : ∀ u ∈ S, ∃ n, Word E n ∈ u) :
    {g : G | (pure g : Filter G) ∈ genFam (ultraGen S) ∧ IsOfFinAddOrder g}.Finite := by
  classical
  have hn : ∀ u : Ultrafilter G, ∃ n, u ∈ S → Word E n ∈ u := by
    intro u
    by_cases hu : u ∈ S
    · obtain ⟨n, h⟩ := hS u hu
      exact ⟨n, fun _ => h⟩
    · exact ⟨0, fun h => absurd h hu⟩
  choose n hn using hn
  have hr : ∀ (m : ℕ) (z : G), ∃ c : E →₀ ℤ, z ∈ Word E m → ev E c = z ∧ (∑ x ∈ c.support, |c x|) ≤ (m : ℤ) := by
    intro m z
    by_cases hz : z ∈ Word E m
    · obtain ⟨c, hc⟩ := hz
      exact ⟨c, fun _ => hc⟩
    · exact ⟨0, fun h => absurd h hz⟩
  choose r hr using hr
  have hcomp : ∀ (c d : E →₀ ℤ), ev E c = ev E d → ∀ x : E, c x • (x : G) = d x • (x : G) := by
    intro c d hcd x
    have h1 := hE (c - d) (by rw [ev_sub, hcd, sub_self]) x
    rwa [Finsupp.sub_apply, sub_smul, sub_eq_zero] at h1
  let T : Ultrafilter G → Set E := fun u => {e | {z | z ∈ Word E (n u) ∧ r (n u) z e • (e : G) ≠ 0} ∈ u}
  have hTfin : ∀ u : Ultrafilter G, (T u).Finite := by
    intro u
    by_contra hinf
    obtain ⟨F, hF, hFc⟩ := Set.Infinite.exists_subset_card_eq hinf (n u + 1)
    have h1 : (⋂ e ∈ F, {z | z ∈ Word E (n u) ∧ r (n u) z e • (e : G) ≠ 0}) ∈ (u : Filter G) :=
      (Filter.biInter_finset_mem _).2 (fun e he => hF he)
    obtain ⟨z, hz⟩ := Ultrafilter.nonempty_of_mem h1
    have hne : F.Nonempty := Finset.card_pos.1 (by omega)
    obtain ⟨e0, he0⟩ := hne
    have hzW : z ∈ Word E (n u) := (mem_iInter₂.1 hz e0 he0).1
    have hsub : F ⊆ (r (n u) z).support := by
      intro e he
      refine Finsupp.mem_support_iff.2 (fun h0 => (mem_iInter₂.1 hz e he).2 ?_)
      rw [h0, zero_smul]
    have h2 : (F.card : ℤ) ≤ ∑ x ∈ (r (n u) z).support, |r (n u) z x| := by
      have h3 : (F.card : ℤ) = ∑ _x ∈ F, (1 : ℤ) := by simp
      rw [h3]
      refine (Finset.sum_le_sum (fun x hx => ?_)).trans
        (Finset.sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => abs_nonneg _))
      exact Int.one_le_abs (Finsupp.mem_support_iff.1 (hsub hx))
    have h4 := h2.trans (hr (n u) z hzW).2
    rw [hFc] at h4
    omega
  set TT : Set E := ⋃ u ∈ S, T u with hTT
  have hTTfin : TT.Finite := hSfin.biUnion (fun u _ => hTfin u)
  set Gens : Set G := (fun e : E => (e : G)) '' TT with hGens
  have hGfin : Gens.Finite := hTTfin.image _
  refine (finite_torsion_closure Gens hGfin).subset (fun g hg => ⟨?_, hg.2⟩)
  have hp : ((pure g : Ultrafilter G) : Filter G) ∈ genFam (ultraGen S) := by
    rw [Ultrafilter.coe_pure]; exact hg.1
  obtain ⟨σ, hσ, hpσ⟩ := hp.2 (pure g) le_rfl
  obtain ⟨ι, _, w, ε, hw, hε, h⟩ := rep_of_sumClosure S hσ
  have hg_mem : ∀ A : ι → Set G, (∀ i, A i ∈ w i) → ∃ a : ι → G, (∀ i, a i ∈ A i) ∧ ∑ i, ε i • a i = g := by
    intro A hA
    exact hpσ (h A hA)
  let evh : (E →₀ ℤ) →+ G := AddMonoidHom.mk' (ev E) (ev_add E)
  have hlin : ∀ b : ι → G, (∀ i, b i ∈ Word E (n (w i))) →
      ev E (∑ i, ε i • r (n (w i)) (b i)) = ∑ i, ε i • b i := by
    intro b hb
    show evh (∑ i, ε i • r (n (w i)) (b i)) = _
    rw [map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_zsmul]
    show ε i • ev E (r (n (w i)) (b i)) = ε i • b i
    rw [(hr _ _ (hb i)).1]
  obtain ⟨a, ha, hsum⟩ := hg_mem (fun i => Word E (n (w i))) (fun i => hn _ (hw i))
  set c : E →₀ ℤ := ∑ i, ε i • r (n (w i)) (a i) with hc
  have hcg : ev E c = g := by rw [hc, hlin a ha, hsum]
  have hout : ∀ e : E, e ∉ TT → c e • (e : G) = 0 := by
    intro e he
    have hA : ∀ i, {z | z ∈ Word E (n (w i)) ∧ r (n (w i)) z e • (e : G) = 0} ∈ w i := by
      intro i
      have hnot : e ∉ T (w i) := fun hmem => he (mem_iUnion₂.2 ⟨w i, hw i, hmem⟩)
      have h1 : {z | z ∈ Word E (n (w i)) ∧ r (n (w i)) z e • (e : G) ≠ 0}ᶜ ∈ w i :=
        Ultrafilter.compl_mem_iff_notMem.2 hnot
      refine Filter.mem_of_superset (Filter.inter_mem (f := (w i : Filter G)) h1 (hn _ (hw i))) (fun z hz => ?_)
      refine ⟨hz.2, ?_⟩
      by_contra h2
      exact hz.1 ⟨hz.2, h2⟩
    obtain ⟨b, hb, hsum'⟩ := hg_mem _ hA
    set d : E →₀ ℤ := ∑ i, ε i • r (n (w i)) (b i) with hd
    have hdg : ev E d = g := by rw [hd, hlin b (fun i => (hb i).1), hsum']
    have hde : d e • (e : G) = 0 := by
      rw [hd, Finsupp.finsetSum_apply, Finset.sum_smul]
      refine Finset.sum_eq_zero (fun i _ => ?_)
      rw [Finsupp.smul_apply, smul_assoc, (hb i).2, smul_zero]
    rw [hcomp c d (by rw [hcg, hdg]) e, hde]
  rw [← hcg]
  show c.sum (fun x a => a • (x : G)) ∈ AddSubgroup.closure Gens
  refine AddSubgroup.sum_mem _ (fun e _ => ?_)
  show c e • (e : G) ∈ AddSubgroup.closure Gens
  by_cases he : e ∈ TT
  · exact AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure (show (e : G) ∈ Gens from ⟨e, he, rfl⟩)) _
  · rw [hout e he]; exact zero_mem _

theorem words_finite_coarsest (E : Set G) (hE : Indep E) (S : Set (Ultrafilter G)) (hSfin : S.Finite)
    (hS : ∀ u ∈ S, ∃ n, Word E n ∈ u) :
    ∃ N0 : Filter G, (IsNbhdFilter N0 ∧ N0 ∈ genFam (ultraGen S)) ∧
      ∀ N : Filter G, IsNbhdFilter N → N ∈ genFam (ultraGen S) → N ≤ N0 :=
  (words_coarsest_iff E hE S hS).2 (words_finite_family E hE S hSfin hS)

/-! ### Translates -/

/-- If the ultrafilter and its translate by `a` are null, then `a` is a null point. -/
theorem pure_mem_of_translate {C : Set (Filter G)} (hC : NullFamily C) (u : Ultrafilter G) (a : G)
    (h1 : ((u.map (fun x => a + x) : Ultrafilter G) : Filter G) ∈ C) (h2 : (u : Filter G) ∈ C) :
    (pure a : Filter G) ∈ C := by
  have h3 := hC.add _ h1 _ (hC.neg _ h2)
  refine hC.finer _ h3 _ (fun s hs => ?_) pure_neBot
  obtain ⟨P, hP, Q, hQ, hPQ⟩ := Filter.mem_map₂_iff.1 hs
  have hP' : (fun x => a + x) ⁻¹' P ∈ u := hP
  have hQ' : (fun x : G => -x) ⁻¹' Q ∈ u := hQ
  obtain ⟨x, hx1, hx2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (u : Filter G)) hP' hQ')
  have h4 : a + x + -x ∈ s := hPQ (mem_image2_of_mem hx1 hx2)
  rw [add_neg_cancel_right] at h4
  exact Filter.mem_pure.2 h4

theorem ultra_mem_genFam (S : Set (Ultrafilter G)) (u : Ultrafilter G) (hu : u ∈ S) :
    (u : Filter G) ∈ genFam (ultraGen S) :=
  ⟨u.neBot, fun U hU => ⟨u, SumClosure.gen ⟨u, hu, rfl⟩, hU⟩⟩

/-- The family consisting of `u` and its translates by the elements of `A`. -/
def translates (u : Ultrafilter G) (A : Set G) : Set (Ultrafilter G) :=
  insert u ((fun a => u.map (fun x => a + x)) '' A)

/-- The null points of the PG of the translates of an ultrafilter on an independent set. -/
theorem translates_pure_iff (E : Set G) (hE : Indep E) (u : Ultrafilter G) (hfree : ∀ a, u ≠ pure a) (hEu : E ∈ u)
    (A : Set G) (g : G) :
    (pure g : Filter G) ∈ genFam (ultraGen (translates u A)) ↔ g ∈ AddSubgroup.closure A := by
  classical
  have hC : NullFamily (genFam (ultraGen (translates u A))) := genFam_nullFamily _
  constructor
  · intro hg
    have hp : ((pure g : Ultrafilter G) : Filter G) ∈ genFam (ultraGen (translates u A)) := by
      rw [Ultrafilter.coe_pure]; exact hg
    obtain ⟨σ, hσ, hpσ⟩ := hp.2 (pure g) le_rfl
    obtain ⟨ι, _, w, ε, hw, hε, h⟩ := rep_of_sumClosure _ hσ
    have hshift : ∀ i, ∃ a ∈ AddSubgroup.closure A, w i = u.map (fun x => a + x) := by
      intro i
      rcases hw i with h0 | ⟨a, ha, h0⟩
      · refine ⟨0, zero_mem _, ?_⟩
        have : (fun x : G => (0 : G) + x) = id := by funext x; simp
        rw [h0, this, Ultrafilter.map_id]
      · exact ⟨a, AddSubgroup.subset_closure ha, h0.symm⟩
    choose a haA haw using hshift
    set h0 : G := ∑ i, ε i • a i with hh0
    have hh0A : h0 ∈ AddSubgroup.closure A :=
      AddSubgroup.sum_mem _ (fun i _ => AddSubgroup.zsmul_mem _ (haA i) _)
    have hrep : ∀ B : Set G, B ∈ u → ∃ b : ι → G, (∀ i, b i ∈ B) ∧ ∑ i, ε i • b i = g - h0 := by
      intro B hB
      have hmem : ∀ i, (fun x => a i + x) '' B ∈ w i := by
        intro i
        rw [haw i]
        show (fun x => a i + x) ⁻¹' ((fun x => a i + x) '' B) ∈ u
        exact Filter.mem_of_superset hB (subset_preimage_image _ _)
      have h1 : g ∈ {z | ∃ c : ι → G, (∀ i, c i ∈ (fun x => a i + x) '' B) ∧ ∑ i, ε i • c i = z} :=
        hpσ (h _ hmem)
      obtain ⟨c, hc, hsum⟩ := h1
      choose b hb hbc using hc
      refine ⟨b, hb, ?_⟩
      have h2 : ∑ i, ε i • c i = h0 + ∑ i, ε i • b i := by
        rw [hh0, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [← hbc i, smul_add]
      rw [← hsum, h2, add_sub_cancel_left]
    have hdiff : ∀ F : Finset G, E \ (F : Set G) ∈ u := by
      intro F
      have h1 : (F : Set G)ᶜ ∈ u := by
        rcases u.mem_or_compl_mem (F : Set G) with h | h
        · exact absurd h (notMem_of_finite hfree F.finite_toSet)
        · exact h
      exact Filter.inter_mem hEu h1
    have h0' : g - h0 = 0 := by
      obtain ⟨b1, hb1, hsum1⟩ := hrep E hEu
      obtain ⟨c, hc, _, _⟩ := sum_rep E ε hε b1 hb1
      set F : Finset G := c.support.image (fun x : E => (x : G)) with hF
      obtain ⟨b2, hb2, hsum2⟩ := hrep _ (hdiff F)
      obtain ⟨d, hd, _, hdsupp⟩ := sum_rep E ε hε b2 (fun i => (hb2 i).1)
      have h3 : ev E (c - d) = 0 := by rw [ev_sub, hc, hd, hsum1, hsum2, sub_self]
      have h4 : ∀ x ∈ c.support, c x • (x : G) = 0 := by
        intro x hx
        have h5 := hE _ h3 x
        have h6 : d x = 0 := by
          by_contra h7
          obtain ⟨i, hi⟩ := hdsupp x (Finsupp.mem_support_iff.2 h7)
          exact (hb2 i).2 (by rw [← hi]; exact Finset.mem_image_of_mem _ hx)
        rwa [Finsupp.sub_apply, h6, sub_zero] at h5
      rw [← hsum1, ← hc]
      exact Finset.sum_eq_zero h4
    rw [sub_eq_zero.1 h0']
    exact hh0A
  · intro hg
    have hle : AddSubgroup.closure A ≤ nullPts _ hC := by
      refine (AddSubgroup.closure_le _).2 (fun a ha => ?_)
      refine pure_mem_of_translate hC u a (ultra_mem_genFam _ _ ?_) (ultra_mem_genFam _ _ (mem_insert _ _))
      exact mem_insert_of_mem _ ⟨a, ha, rfl⟩
    exact hle hg

theorem mem_word_of_closure (E : Set G) {g : G} (hg : g ∈ AddSubgroup.closure E) : ∃ n, g ∈ Word E n := by
  classical
  have hB := word_bounded E
  induction hg using AddSubgroup.closure_induction with
  | mem x hx =>
    refine ⟨1, Finsupp.single ⟨x, hx⟩ 1, by rw [ev_single, one_smul], ?_⟩
    rw [Finsupp.support_single _ one_ne_zero]
    simp
  | zero => exact ⟨0, hB.zero⟩
  | add x y _ _ ihx ihy =>
    obtain ⟨j, hj⟩ := ihx
    obtain ⟨k, hk⟩ := ihy
    exact ⟨j + k, hB.add _ _ _ hj _ hk⟩
  | neg x _ ih =>
    obtain ⟨j, hj⟩ := ih
    exact ⟨j, hB.neg _ _ hj⟩

/-- Every member of the family of translates lives on words of bounded length. -/
theorem translates_word (E : Set G) (u : Ultrafilter G) (hEu : E ∈ u) (A : Set G)
    (hA : A ⊆ AddSubgroup.closure E) : ∀ v ∈ translates u A, ∃ n, Word E n ∈ v := by
  classical
  have h1 : E ⊆ Word E 1 := by
    intro x hx
    refine ⟨Finsupp.single ⟨x, hx⟩ 1, by rw [ev_single, one_smul], ?_⟩
    rw [Finsupp.support_single _ one_ne_zero]
    simp
  rintro v (hv | ⟨a, ha, hv⟩)
  · exact ⟨1, by rw [hv]; exact Filter.mem_of_superset hEu h1⟩
  · obtain ⟨r, hr⟩ := mem_word_of_closure E (hA ha)
    refine ⟨r + 1, ?_⟩
    rw [← hv]
    show (fun x => a + x) ⁻¹' Word E (r + 1) ∈ u
    exact Filter.mem_of_superset hEu (fun x hx => (word_bounded E).add _ _ _ hr _ (h1 hx))

theorem translates_coarsest_iff (E : Set G) (hE : Indep E) (u : Ultrafilter G) (hfree : ∀ a, u ≠ pure a)
    (hEu : E ∈ u) (A : Set G) (hA : A ⊆ AddSubgroup.closure E) :
    (∃ N0 : Filter G, (IsNbhdFilter N0 ∧ N0 ∈ genFam (ultraGen (translates u A))) ∧
        ∀ N : Filter G, IsNbhdFilter N → N ∈ genFam (ultraGen (translates u A)) → N ≤ N0) ↔
      {g : G | g ∈ AddSubgroup.closure A ∧ IsOfFinAddOrder g}.Finite := by
  rw [words_coarsest_iff E hE _ (translates_word E u hEu A hA)]
  have : {g : G | (pure g : Filter G) ∈ genFam (ultraGen (translates u A)) ∧ IsOfFinAddOrder g}
      = {g : G | g ∈ AddSubgroup.closure A ∧ IsOfFinAddOrder g} := by
    ext g
    simp only [mem_setOf_eq, translates_pure_iff E hE u hfree hEu A g]
  rw [this]

/-- Without set-theoretic hypotheses: countably many free ultrafilters on the countable Boolean group whose PG has no
coarsest group topology of this kind. -/
theorem exists_countable_no_coarsest :
    ∃ S : Set (Ultrafilter (ℕ →₀ ZMod 2)), S.Countable ∧ (∀ v ∈ S, ∀ a, v ≠ pure a) ∧
      ¬ ∃ N0 : Filter (ℕ →₀ ZMod 2), (IsNbhdFilter N0 ∧ N0 ∈ genFam (ultraGen S)) ∧
        ∀ N : Filter (ℕ →₀ ZMod 2), IsNbhdFilter N → N ∈ genFam (ultraGen S) → N ≤ N0 := by
  classical
  set b : ℕ → (ℕ →₀ ZMod 2) := fun n => Finsupp.single n 1 with hb
  set E : Set (ℕ →₀ ZMod 2) := range b with hEdef
  have hbinj : Function.Injective b := Finsupp.single_left_injective one_ne_zero
  have hE : Indep E := by
    intro c hc x
    obtain ⟨n, hn⟩ := x.2
    have h1 : (ev E c) n = (c x) • (1 : ZMod 2) := by
      show (∑ y ∈ c.support, c y • (y : ℕ →₀ ZMod 2)) n = c x • (1 : ZMod 2)
      rw [Finsupp.finsetSum_apply]
      have h2 : ∀ y : E, y ≠ x → (c y • (y : ℕ →₀ ZMod 2)) n = 0 := by
        intro y hy
        obtain ⟨m, hm⟩ := y.2
        have hmn : m ≠ n := by
          intro h
          apply hy
          apply Subtype.ext
          rw [← hm, ← hn, h]
        rw [Finsupp.smul_apply, ← hm]
        show c y • (Finsupp.single m (1 : ZMod 2)) n = 0
        rw [Finsupp.single_eq_of_ne (Ne.symm hmn), smul_zero]
      have h3 : (c x • (x : ℕ →₀ ZMod 2)) n = c x • (1 : ZMod 2) := by
        rw [Finsupp.smul_apply, ← hn]
        show c x • (Finsupp.single n (1 : ZMod 2)) n = c x • (1 : ZMod 2)
        rw [Finsupp.single_eq_same]
      by_cases hx : x ∈ c.support
      · rw [Finset.sum_eq_single_of_mem x hx (fun y _ hy => h2 y hy), h3]
      · rw [Finsupp.notMem_support_iff.1 hx, zero_smul]
        refine Finset.sum_eq_zero (fun y hy => h2 y (fun h => hx (h ▸ hy)))
    rw [hc, Finsupp.zero_apply] at h1
    rw [← hn]
    show c x • Finsupp.single n (1 : ZMod 2) = 0
    rw [Finsupp.smul_single, ← h1, Finsupp.single_zero]
  set u : Ultrafilter (ℕ →₀ ZMod 2) := (Filter.hyperfilter ℕ).map b with hu
  have hfree : ∀ a, u ≠ pure a := by
    intro a ha
    have h1 : ({a} : Set (ℕ →₀ ZMod 2)) ∈ u := by rw [ha]; exact rfl
    have h2 : b ⁻¹' {a} ∈ Filter.hyperfilter ℕ := h1
    have h3 : (b ⁻¹' {a}).Finite := (finite_singleton a).preimage hbinj.injOn
    exact Filter.notMem_hyperfilter_of_finite h3 h2
  have hEu : E ∈ u := by
    show b ⁻¹' E ∈ Filter.hyperfilter ℕ
    exact Filter.mem_of_superset Filter.univ_mem (fun n _ => mem_range_self n)
  have hEc : E.Countable := countable_range b
  refine ⟨translates u E, (hEc.image _).insert _, ?_, ?_⟩
  · rintro v (hv | ⟨a, _, hv⟩) c hc
    · exact hfree c (hv ▸ hc)
    · refine hfree (c - a) ?_
      have h1 : u.map (fun x => a + x) = pure c := by rw [← hc]; exact hv
      have h2 : ({c} : Set (ℕ →₀ ZMod 2)) ∈ u.map (fun x => a + x) := by rw [h1]; exact rfl
      have h3 : ({c - a} : Set (ℕ →₀ ZMod 2)) ∈ u := by
        refine Filter.mem_of_superset (show (fun x => a + x) ⁻¹' {c} ∈ u from h2) (fun x hx => ?_)
        have h4 : a + x = c := hx
        rw [mem_singleton_iff, ← h4, add_sub_cancel_left]
      obtain ⟨d, hd, h5⟩ := Ultrafilter.eq_pure_of_finite_mem (finite_singleton _) h3
      rw [h5, mem_singleton_iff.1 hd]
  · rw [translates_coarsest_iff E hE u hfree hEu E AddSubgroup.subset_closure]
    intro hfin
    have htop : ∀ g : ℕ →₀ ZMod 2, g ∈ AddSubgroup.closure E := by
      intro g
      induction g using Finsupp.induction_linear with
      | zero => exact zero_mem _
      | add f g hf hg => exact add_mem hf hg
      | single n a =>
        have h1 : a = 0 ∨ a = 1 := by
          revert a
          decide
        rcases h1 with h | h
        · rw [h, Finsupp.single_zero]; exact zero_mem _
        · rw [h]; exact AddSubgroup.subset_closure (mem_range_self n)
    have hord : ∀ g : ℕ →₀ ZMod 2, IsOfFinAddOrder g := by
      intro g
      refine isOfFinAddOrder_iff_nsmul_eq_zero.2 ⟨2, two_pos, ?_⟩
      refine Finsupp.ext (fun n => ?_)
      rw [Finsupp.smul_apply, Finsupp.zero_apply]
      have h1 : ∀ a : ZMod 2, (2 : ℕ) • a = 0 := by decide
      exact h1 _
    have : (E : Set (ℕ →₀ ZMod 2)).Infinite := infinite_range_of_injective hbinj
    exact this (hfin.subset (fun g _ => ⟨htop g, hord g⟩))

/-! ### Bounded numbers of powers -/

/-- The least number of terms `±p^n` with sum `z`. -/
noncomputable def len (p : ℕ) (z : ℤ) : ℕ := sInf {m | ∃ l : List (Bool × ℕ), l.length = m ∧ val p l = z}

theorem len_le (p : ℕ) (l : List (Bool × ℕ)) : len p (val p l) ≤ l.length := Nat.sInf_le ⟨l, rfl, rfl⟩

theorem exists_len (p k : ℕ) {z : ℤ} (hz : z ∈ D p k) :
    len p z ≤ k ∧ ∃ l : List (Bool × ℕ), l.length = len p z ∧ val p l = z := by
  obtain ⟨l, hl, h⟩ := hz
  have hne : {m | ∃ l : List (Bool × ℕ), l.length = m ∧ val p l = z}.Nonempty := ⟨l.length, l, rfl, h⟩
  refine ⟨?_, Nat.sInf_mem hne⟩
  rw [← h]
  exact (len_le p l).trans hl

theorem abs_val_le (p : ℕ) (hp : 1 ≤ p) (b : ℕ) (l : List (Bool × ℕ)) (hl : ∀ t ∈ l, t.2 ≤ b) :
    |val p l| ≤ (l.length : ℤ) * (p : ℤ) ^ b := by
  induction l with
  | nil => simp [val_nil]
  | cons t l ih =>
    rw [val_cons, List.length_cons]
    have h1 : |sp p t| ≤ (p : ℤ) ^ b := by
      have h2 : |sp p t| = (p : ℤ) ^ t.2 := by
        unfold sp
        rw [abs_mul, abs_of_nonneg (show (0 : ℤ) ≤ (p : ℤ) ^ t.2 by positivity)]
        split_ifs <;> simp
      rw [h2]
      exact pow_le_pow_right₀ (by exact_mod_cast hp) (hl t (List.mem_cons_self ..))
    have h3 := ih (fun s hs => hl s (List.mem_cons_of_mem _ hs))
    refine (abs_add_le _ _).trans ((add_le_add h1 h3).trans (le_of_eq ?_))
    push_cast
    ring

theorem dvd_val (p c : ℕ) (l : List (Bool × ℕ)) (hl : ∀ t ∈ l, c ≤ t.2) : (p : ℤ) ^ c ∣ val p l := by
  induction l with
  | nil => rw [val_nil]; exact dvd_zero _
  | cons t l ih =>
    rw [val_cons]
    refine dvd_add ?_ (ih (fun s hs => hl s (List.mem_cons_of_mem _ hs)))
    exact Dvd.dvd.mul_left (pow_dvd_pow _ (hl t (List.mem_cons_self ..))) _

theorem val_filter_add (p : ℕ) (q : Bool × ℕ → Bool) (l : List (Bool × ℕ)) :
    val p (l.filter q) + val p (l.filter (fun t => !q t)) = val p l := by
  induction l with
  | nil => simp [val_nil]
  | cons t l ih =>
    by_cases h : q t = true
    · rw [List.filter_cons_of_pos h, List.filter_cons_of_neg (by simp [h]), val_cons, val_cons, add_assoc, ih]
    · rw [List.filter_cons_of_neg h, List.filter_cons_of_pos (by simp [h]), val_cons, val_cons, add_left_comm, ih]

theorem length_filter_add (q : Bool × ℕ → Bool) (l : List (Bool × ℕ)) :
    (l.filter q).length + (l.filter (fun t => !q t)).length = l.length := by
  induction l with
  | nil => rfl
  | cons t l ih =>
    by_cases h : q t = true
    · rw [List.filter_cons_of_pos h, List.filter_cons_of_neg (by simp [h]), List.length_cons, List.length_cons]
      omega
    · rw [List.filter_cons_of_neg h, List.filter_cons_of_pos (by simp [h]), List.length_cons, List.length_cons]
      omega

/-- The numbers of terms add up when one summand is divisible by a high power of `p`. -/
theorem split_terms (p : ℕ) (hp : 2 ≤ p) (k M : ℕ) (x z : ℤ) (lx lw : List (Bool × ℕ))
    (hlx : lx.length ≤ k) (hx : val p lx = x) (hM : ∀ t ∈ lx, t.2 ≤ M) (hlw : lw.length ≤ k)
    (hw : val p lw = x + z) (hz : (p : ℤ) ^ (M + (k + 1) * (2 * k)) ∣ z) :
    ∃ l1 l2 : List (Bool × ℕ), val p l1 = x ∧ val p l2 = z ∧ l1.length + l2.length = lw.length := by
  classical
  set g : ℕ := 2 * k with hg
  have hwin : ∃ i ≤ k, ∀ t ∈ lw, ¬ (M + i * g ≤ t.2 ∧ t.2 < M + (i + 1) * g) := by
    by_contra h
    have h1 : ∀ i : Fin (k + 1), ∃ t ∈ lw, M + i.1 * g ≤ t.2 ∧ t.2 < M + (i.1 + 1) * g := by
      intro i
      by_contra h2
      exact h ⟨i.1, Nat.le_of_lt_succ i.2, fun t ht hc => h2 ⟨t, ht, hc⟩⟩
    choose f hf hf1 using h1
    have hinj : Function.Injective f := by
      intro i j hij
      have mono : ∀ a b : Fin (k + 1), a.1 < b.1 → f a ≠ f b := by
        intro a b hab hfab
        have h3 : (a.1 + 1) * g ≤ b.1 * g := Nat.mul_le_mul_right g hab
        have h4 := (hf1 a).2
        have h5 := (hf1 b).1
        rw [hfab] at h4
        omega
      rcases lt_trichotomy i.1 j.1 with h' | h' | h'
      · exact absurd hij (mono i j h')
      · exact Fin.ext h'
      · exact absurd hij.symm (mono j i h')
    have h6 : (Finset.univ.image f) ⊆ lw.toFinset := by
      intro t ht
      obtain ⟨i, _, rfl⟩ := Finset.mem_image.1 ht
      exact List.mem_toFinset.2 (hf i)
    have h7 := Finset.card_le_card h6
    rw [Finset.card_image_of_injective _ hinj, Finset.card_univ, Fintype.card_fin] at h7
    have h8 := h7.trans (List.toFinset_card_le lw)
    omega
  obtain ⟨i, hik, hfree⟩ := hwin
  set b : ℕ := M + i * g with hb
  set q : Bool × ℕ → Bool := fun t => decide (t.2 < b) with hq
  set l1 := lw.filter q with hl1
  set l2 := lw.filter (fun t => !q t) with hl2
  have hval : val p l1 + val p l2 = x + z := by rw [hl1, hl2, val_filter_add, hw]
  have hlen : l1.length + l2.length = lw.length := length_filter_add q lw
  have hl2big : ∀ t ∈ l2, b + g ≤ t.2 := by
    intro t ht
    obtain ⟨htw, htq⟩ := List.mem_filter.1 ht
    have h1 : ¬ t.2 < b := by simpa [hq] using htq
    have h2 := hfree t htw
    have h3 : M + (i + 1) * g = b + g := by rw [hb]; ring
    omega
  have hdz : (p : ℤ) ^ (b + g) ∣ z := by
    refine dvd_trans (pow_dvd_pow _ ?_) hz
    have h1 : (i + 1) * g ≤ (k + 1) * g := Nat.mul_le_mul_right g (by omega)
    have h2 : b + g = M + (i + 1) * g := by rw [hb]; ring
    omega
  have hd : (p : ℤ) ^ (b + g) ∣ val p l1 - x := by
    have h1 : val p l1 - x = z - val p l2 := by omega
    rw [h1]
    exact dvd_sub hdz (dvd_val p _ _ hl2big)
  have hsmall : |val p l1 - x| < (p : ℤ) ^ (b + g) := by
    have h1 : |val p l1| ≤ (k : ℤ) * (p : ℤ) ^ b := by
      refine (abs_val_le p (by omega) b l1 (fun t ht => ?_)).trans ?_
      · have h2 := (List.mem_filter.1 ht).2
        have h3 : t.2 < b := by simpa [hq] using h2
        exact h3.le
      · have h4 : l1.length ≤ k := by omega
        exact mul_le_mul_of_nonneg_right (by exact_mod_cast h4) (by positivity)
    have h5 : |x| ≤ (k : ℤ) * (p : ℤ) ^ b := by
      rw [← hx]
      refine (abs_val_le p (by omega) b lx (fun t ht => (hM t ht).trans (Nat.le_add_right _ _))).trans ?_
      exact mul_le_mul_of_nonneg_right (by exact_mod_cast hlx) (by positivity)
    have h6 : ((2 * k : ℕ) : ℤ) < (p : ℤ) ^ g := by
      have h7 : 2 * k < p ^ g := lt_of_lt_of_le (Nat.lt_two_pow_self) (Nat.pow_le_pow_left hp g)
      exact_mod_cast h7
    have h8 : |val p l1 - x| ≤ ((2 * k : ℕ) : ℤ) * (p : ℤ) ^ b := by
      refine (abs_sub _ _).trans ((add_le_add h1 h5).trans (le_of_eq ?_))
      push_cast
      ring
    have h9 : (0 : ℤ) < (p : ℤ) ^ b := pow_pos (by exact_mod_cast (show 0 < p by omega)) b
    refine lt_of_le_of_lt h8 (lt_of_lt_of_le (mul_lt_mul_of_pos_right h6 h9) (le_of_eq ?_))
    rw [← pow_add, add_comm]
  have h0 : val p l1 - x = 0 := Int.eq_zero_of_abs_lt_dvd hd hsmall
  exact ⟨l1, l2, by omega, by omega, hlen⟩

/-- No free ultrafilter on sums of boundedly many signed powers of `p` is idempotent. -/
theorem powers_no_idempotent (p : ℕ) (hp : 2 ≤ p) (k : ℕ) (q : Ultrafilter ℤ) (hD : D p k ∈ q)
    (hfree : ∀ a, q ≠ pure a) : q + q ≠ q := by
  classical
  intro hqq
  have htwice : ∀ A ∈ q, ∀ᶠ x in (q : Filter ℤ), ∀ᶠ z in (q : Filter ℤ), x + z ∈ A := by
    intro A hA
    have h1 : A ∈ q + q := by rw [hqq]; exact hA
    rw [Idem.mem_add] at h1
    exact h1
  have hr : ∃ r ≤ k, {z | z ∈ D p k ∧ len p z = r} ∈ q := by
    by_contra hc
    have h2 : (⋂ r ∈ Finset.range (k + 1), {z | z ∈ D p k ∧ len p z = r}ᶜ) ∈ (q : Filter ℤ) := by
      refine (Filter.biInter_finset_mem _).2 (fun r hr => ?_)
      rcases q.mem_or_compl_mem {z | z ∈ D p k ∧ len p z = r} with h | h
      · exact absurd ⟨r, Nat.le_of_lt_succ (Finset.mem_range.1 hr), h⟩ hc
      · exact h
    obtain ⟨z, hz1, hz2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (q : Filter ℤ)) h2 hD)
    exact mem_iInter₂.1 hz1 _ (Finset.mem_range.2 (Nat.lt_succ_of_le (exists_len p k hz2).1)) ⟨hz2, rfl⟩
  obtain ⟨r, hrk, hC⟩ := hr
  have hdiv : ∀ L : ℕ, {z : ℤ | (p : ℤ) ^ L ∣ z} ∈ q := by
    intro L
    set m : ℕ := p ^ L with hm
    have hm0 : 0 < m := Nat.pow_pos (by omega)
    haveI : NeZero m := ⟨hm0.ne'⟩
    have hres : ∃ a : ZMod m, {z : ℤ | (z : ZMod m) = a} ∈ q := by
      by_contra hc
      have h2 : (⋂ a ∈ (Finset.univ : Finset (ZMod m)), {z : ℤ | (z : ZMod m) = a}ᶜ) ∈ (q : Filter ℤ) := by
        refine (Filter.biInter_finset_mem _).2 (fun a _ => ?_)
        rcases q.mem_or_compl_mem {z : ℤ | (z : ZMod m) = a} with h | h
        · exact absurd ⟨a, h⟩ hc
        · exact h
      obtain ⟨z, hz⟩ := Ultrafilter.nonempty_of_mem h2
      exact mem_iInter₂.1 hz (z : ZMod m) (Finset.mem_univ _) rfl
    obtain ⟨a, ha⟩ := hres
    obtain ⟨x, hx1, hx2⟩ := Ultrafilter.nonempty_of_mem
      (Filter.inter_mem (f := (q : Filter ℤ)) (htwice _ ha) ha)
    obtain ⟨z, hz1, hz2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (q : Filter ℤ)) hx1 ha)
    have h3 : ((x + z : ℤ) : ZMod m) = a := hz1
    have h4 : (x : ZMod m) = a := hx2
    have h5 : (z : ZMod m) = a := hz2
    rw [Int.cast_add, h4, h5] at h3
    have h6 : a = 0 := by
      have h7 : a + a = a + 0 := by rw [add_zero]; exact h3
      exact add_left_cancel h7
    refine Filter.mem_of_superset ha (fun y hy => ?_)
    have h8 : (y : ZMod m) = 0 := by rw [← h6]; exact hy
    have h9 : (m : ℤ) ∣ y := (ZMod.intCast_zmod_eq_zero_iff_dvd y m).1 h8
    show (p : ℤ) ^ L ∣ y
    rw [hm] at h9
    exact_mod_cast h9
  obtain ⟨x, hx1, hx2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (q : Filter ℤ)) (htwice _ hC) hC)
  obtain ⟨lx, hlx, hvx⟩ := (exists_len p k hx2.1).2
  set M : ℕ := (lx.map Prod.snd).sum with hM
  have hMb : ∀ t ∈ lx, t.2 ≤ M := fun t ht => List.le_sum_of_mem (List.mem_map_of_mem ht)
  obtain ⟨z, ⟨hz1, hz2⟩, hz3⟩ := Ultrafilter.nonempty_of_mem
    (Filter.inter_mem (f := (q : Filter ℤ)) (Filter.inter_mem (f := (q : Filter ℤ)) hx1 hC)
      (hdiv (M + (k + 1) * (2 * k))))
  have hw : x + z ∈ D p k ∧ len p (x + z) = r := hz1
  obtain ⟨lw, hlw, hvw⟩ := (exists_len p k hw.1).2
  have hxr : len p x = r := hx2.2
  have hzr : len p z = r := hz2.2
  obtain ⟨l1, l2, h1, h2, h3⟩ := split_terms p hp k M x z lx lw (by omega) hvx hMb (by omega) hvw hz3
  have h4 : len p x ≤ l1.length := by rw [← h1]; exact len_le p l1
  have h5 : len p z ≤ l2.length := by rw [← h2]; exact len_le p l2
  have h6 : r = 0 := by omega
  have h7 : ({0} : Set ℤ) ∈ q := by
    refine Filter.mem_of_superset hC (fun y hy => ?_)
    obtain ⟨l, hl, hv⟩ := (exists_len p k hy.1).2
    rw [hy.2, h6] at hl
    rw [List.length_eq_zero_iff] at hl
    show y = 0
    rw [← hv, hl, val_nil]
  obtain ⟨b, _, h8⟩ := Ultrafilter.eq_pure_of_finite_mem (finite_singleton _) h7
  exact hfree b h8

theorem D_bounded (p : ℕ) : Bounded (D p) :=
  ⟨zero_mem_D p 0, fun _ _ h => D_neg h, fun _ _ _ hx _ hy => D_add hx hy⟩

/-- Ultrafilters on sums of boundedly many signed powers of `p`: the coreflection is discrete. -/
theorem powers_trivial (p : ℕ) (hp : 2 ≤ p) (S : Set (Ultrafilter ℤ)) (hS : ∀ u ∈ S, ∃ k, D p k ∈ u)
    (N : Filter ℤ) (hN : IsNbhdFilter N) (hNC : N ∈ genFam (ultraGen S)) : N = pure 0 := by
  have hC : NullFamily (genFam (ultraGen S)) := genFam_nullFamily _
  have hidem : ∀ q : Ultrafilter ℤ, (q : Filter ℤ) ∈ genFam (ultraGen S) → (∀ a, q ≠ pure a) → q + q ≠ q := by
    intro q hq hfree
    obtain ⟨k, hk⟩ := null_contains (D_bounded p) S hS q hq
    exact powers_no_idempotent p hp k q hk hfree
  obtain ⟨F, hF, _, rfl⟩ := (nbhd_iff_of_no_idempotent hC hidem N).1 ⟨hN, hNC⟩
  rw [int_finite_subgroup F hF, AddSubgroup.coe_bot, principal_singleton]

theorem powers_not_pretopological (p : ℕ) (hp : 2 ≤ p) (S : Set (Ultrafilter ℤ)) (hS : ∀ u ∈ S, ∃ k, D p k ∈ u)
    (hfree : ∃ u ∈ S, ∀ a, u ≠ pure a) : vic (genFam (ultraGen S)) ∉ genFam (ultraGen S) := by
  obtain ⟨u, hu, hu0⟩ := hfree
  exact not_pretopological (genFam_nullFamily _) (powers_trivial p hp S hS) u (ultra_mem_genFam S u hu) hu0

/-! ### Bounded digits without the freeness assumption -/

theorem freeAbelian_trivial {ι : Type} (S : Set (Ultrafilter (ι →₀ ℤ))) (hSB : ∀ u ∈ S, ∃ b, box ι b ∈ u)
    (N : Filter (ι →₀ ℤ)) (hN : IsNbhdFilter N) (hNC : N ∈ genFam (ultraGen S)) : N = pure 0 := by
  obtain ⟨F, hF, _, rfl⟩ :=
    (bounded_nbhd (box ι) (box_bounded ι) univ infinite_univ (box_G ι) S hSB N).1 ⟨hN, hNC⟩
  rw [finsupp_finite_subgroup ι F hF, AddSubgroup.coe_bot, principal_singleton]

theorem digits_trivial (y : ℕ → ℤ) (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l)
    (S : Set (Ultrafilter ℤ)) (hSB : ∀ u ∈ S, ∃ b, digits y b ∈ u)
    (N : Filter ℤ) (hN : IsNbhdFilter N) (hNC : N ∈ genFam (ultraGen S)) : N = pure 0 := by
  obtain ⟨F, hF, _, rfl⟩ := (bounded_nbhd (digits y) (digits_bounded y) univ infinite_univ
    (digits_G y hpos hgrow) S hSB N).1 ⟨hN, hNC⟩
  rw [int_finite_subgroup F hF, AddSubgroup.coe_bot, principal_singleton]

