      linarith
    linarith
  have h8 : ‖Ψ x‖ ≤ 192 * δ := by
    have e : Ψ x = (Ψ x - Ψ (xd q d)) + (Ψ (xd q d) - d.sum (fun k z => z • lam k)) +
        (((β * xd q d : ℝ) : AddCircle (1 : ℝ)) + Phit dy θ x) := by
      rw [hchar]; abel
    rw [e]
    refine (norm_add_le _ _).trans ?_
    have a1 := norm_add_le (Ψ x - Ψ (xd q d)) (Ψ (xd q d) - d.sum (fun k z => z • lam k))
    have a2 := norm_add_le (((β * xd q d : ℝ) : AddCircle (1 : ℝ))) (Phit dy θ x)
    linarith
  have h9 : ‖ψ z' - ψ (nx x)‖ ≤ δ := by
    rw [← map_sub]
    refine hMψ _ ?_
    have e : ((z' - nx x : N) : Completion (LeanCheck.RT γ)) =
        -(ι' x - z) + (ι' x - (nx x : Completion (LeanCheck.RT γ))) + 0 := by
      push_cast [hz']
      abel
    rw [e]
    exact hO03 _ (hO0neg _ hxz) _ (hnx1 x hxε) _ hO00
  have h10 : ‖ψ z'‖ ≤ 193 * δ := by
    have e : ψ z' = (ψ z' - ψ (nx x)) + ψ (nx x) := by abel
    have h11 : ‖ψ (nx x)‖ ≤ 192 * δ := h8
    rw [e]
    exact (norm_add_le _ _).trans (by linarith)
  linarith

