import Mathlib
import LeanCheck.PGFourClassify

/-!
# PGfour: finitely many sums of ultrafilters

`LL` is a finite list of generators, each a list of pairs `(c, v)` as in `PGFourClassify`.
The class sums of a generator `l` form the function `w ↦ S w l`.

* `not_group_of_sep_family` : if no element of the group generated by the class sums is the
  relevant multiple of one coordinate, the modification is not a group topology;
* `lattice_mem` : every element `f` of that group gives a null filter, the image of the
  product of the ultrafilters under `m ↦ ∑ w, f w * y (m w)`;
* `classification_family` : the modification of the PG generated by the sums is a group
  topology exactly when `d w` times the `w`-th coordinate lies in the group generated by the
  class sums for every ultrafilter `w` that occurs, and every such `w` is a P-point.

No set-theoretic axiom is used. A Lean proof verifies its formal statement under its
hypotheses; the correspondence with the article requires mathematical review.
-/

open Filter Set Topology

namespace PG

namespace FiniteFam

open Sums PPoint Classify

variable (y : ℕ → ℤ)

/-- The generators. -/
noncomputable def gens (LL : List (List (ℤ × Ultrafilter ℕ))) : Set (Ultrafilter ℤ) :=
  {v | ∃ l ∈ LL, v = sumL y l}

/-- The group generated by the class sums. -/
noncomputable def Lat (LL : List (List (ℤ × Ultrafilter ℕ))) : AddSubgroup (Ultrafilter ℕ → ℤ) :=
  AddSubgroup.closure {f | ∃ l ∈ LL, f = fun w => S w l}

theorem S_eq_zero (w : Ultrafilter ℕ) (l : List (ℤ × Ultrafilter ℕ)) (h : ∀ p ∈ l, p.2 ≠ w) : S w l = 0 := by
  classical
  unfold S
  refine List.sum_eq_zero (fun x hx => ?_)
  obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hx
  exact if_neg (h p hp)

theorem diff_small_family (t : TopologicalSpace ℤ) (ht : @IsTopologicalAddGroup ℤ t _) (w : Ultrafilter ℕ)
    (LL : List (List (ℤ × Ultrafilter ℕ)))
    (hu : ∀ l ∈ LL, (sumL y l : Filter ℤ) ≤ @nhds ℤ t 0) (d : ℤ)
    (hd : d ∈ AddSubgroup.closure {c : ℤ | ∃ l ∈ LL, (c, w) ∈ l}) :
    ∀ N ∈ @nhds ℤ t 0, ∃ G ∈ w, ∀ m ∈ G, ∀ m' ∈ G, d * (y m - y m') ∈ N := by
  letI := t
  haveI := ht
  refine AddSubgroup.closure_induction (p := fun x _ => ∀ N ∈ 𝓝 (0 : ℤ), ∃ G ∈ w, ∀ m ∈ G, ∀ m' ∈ G,
    x * (y m - y m') ∈ N) ?_ ?_ ?_ ?_ hd
  · rintro c ⟨l, hl, hc⟩ N hN
    exact diff_small y t ht w l (hu l hl) c (AddSubgroup.subset_closure hc) N hN
  · intro N hN
    exact ⟨univ, Filter.univ_mem, fun m _ m' _ => by rw [zero_mul]; exact mem_of_mem_nhds hN⟩
  · intro x1 x2 _ _ h1 h2 N hN
    obtain ⟨V, hVo, hV0, hVV⟩ := exists_open_nhds_zero_half hN
    obtain ⟨G1, hG1, k1⟩ := h1 V (hVo.mem_nhds hV0)
    obtain ⟨G2, hG2, k2⟩ := h2 V (hVo.mem_nhds hV0)
    refine ⟨G1 ∩ G2, Filter.inter_mem (f := (w : Filter ℕ)) hG1 hG2, fun m hm m' hm' => ?_⟩
    rw [add_mul]
    exact hVV _ (k1 m hm.1 m' hm'.1) _ (k2 m hm.2 m' hm'.2)
  · intro x _ h N hN
    obtain ⟨G, hG, k⟩ := h _ ((continuous_neg.tendsto' (0 : ℤ) 0 neg_zero) hN)
    refine ⟨G, hG, fun m hm m' hm' => ?_⟩
    rw [neg_mul]
    exact k m hm m' hm'

/-- The non-group case. -/
theorem not_group_of_sep_family (LL : List (List (ℤ × Ultrafilter ℕ)))
    (hv : ∀ l ∈ LL, ∀ p ∈ l, ∀ a, p.2 ≠ pure a) (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l)
    (w : Ultrafilter ℕ) (hw : ∀ a, w ≠ pure a) (d : ℕ) (hd0 : 0 < d)
    (hd : (d : ℤ) ∈ AddSubgroup.closure {c : ℤ | ∃ l ∈ LL, (c, w) ∈ l}) (K : ℕ) (hK : 0 < K)
    (hsep : ∀ (n : ℕ) (f : Ultrafilter ℕ → ℤ), f ∈ Lat LL → (∀ w', w' ≠ w → f w' = 0) →
      f w ≠ -(((n * K + 1 : ℕ) : ℤ) * d)) :
    ¬ ∃ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ ∧
      ∀ O : Set ℤ, IsOpen[t] O ↔ IsOpenMod (genFam (Sel.ultraGen (gens y LL))) O := by
  classical
  obtain ⟨β, hβ, hβinf, hwt⟩ := Sparse.exists_weight y hpos hgrow
  obtain ⟨n0, hn0⟩ := hβinf (2 * d)
  have hgex : ∀ n : ℕ, ∃ g : ℕ, n < g ∧ 2 * ((n * K + 1) * d) ≤ β g := by
    intro n
    obtain ⟨m, hm⟩ := hβinf (2 * ((n * K + 1) * d))
    exact ⟨max m (n + 1), lt_of_lt_of_le (Nat.lt_succ_self n) (le_max_right _ _),
      hm.trans (hβ (le_max_left _ _))⟩
  choose g hgn hgβ using hgex
  -- classes
  set Wf : Finset (Ultrafilter ℕ) := insert w ((LL.flatMap (fun l => l.map Prod.snd)).toFinset) with hWf
  obtain ⟨F, hFm, hFd⟩ := exists_disjoint_members Wf
  have hwW : w ∈ Wf := Finset.mem_insert_self _ _
  have hlW : ∀ l ∈ LL, ∀ p ∈ l, p.2 ∈ Wf := fun l hl p hp =>
    Finset.mem_insert_of_mem (List.mem_toFinset.2 (List.mem_flatMap.2 ⟨l, hl, List.mem_map_of_mem hp⟩))
  set E : Set ℕ := F w with hE
  have hEw : E ∈ w := hFm w hwW
  let N : ℕ → ℕ := fun n => n * K + 1
  let ρ : ℕ → ℕ → ℕ → (ℕ →₀ ℤ) := fun n p q =>
    Finsupp.single n (d : ℤ) + Finsupp.single p (((n * K) * d : ℕ) : ℤ)
      + Finsupp.single q (-(((N n) * d : ℕ) : ℤ))
  let A : Set ℤ := {x | ∃ n p q, n0 ≤ n ∧ g n ≤ p ∧ p < q ∧ n ∈ E ∧ p ∈ E ∧ q ∈ E ∧
    x = Sparse.val y (ρ n p q)}
  have hρapp : ∀ n p q i, n < p → p < q → ρ n p q i =
      (if n = i then (d : ℤ) else 0) + (if p = i then (((n * K) * d : ℕ) : ℤ) else 0)
        + (if q = i then -(((N n) * d : ℕ) : ℤ) else 0) := by
    intro n p q i _ _
    show (Finsupp.single n (d : ℤ) + Finsupp.single p (((n * K) * d : ℕ) : ℤ)
      + Finsupp.single q (-(((N n) * d : ℕ) : ℤ))) i = _
    rw [Finsupp.add_apply, Finsupp.add_apply, Finsupp.single_apply, Finsupp.single_apply,
      Finsupp.single_apply]
  have hNd : ∀ n, ((n * K) * d) ≤ (N n) * d ∧ d ≤ (N n) * d := fun n =>
    ⟨Nat.mul_le_mul_right d (Nat.le_succ _), Nat.le_mul_of_pos_left d (Nat.succ_pos _)⟩
  -- admissibility of `ρ - τ`
  have hbound : ∀ (R M : ℕ), 2 * R + 2 ≤ β M → ∀ n p q, n0 ≤ n → g n ≤ p → p < q →
      ∀ τ : ℕ →₀ ℤ, (∀ i, |τ i| ≤ (R : ℤ)) → (∀ i, τ i ≠ 0 → M < i) →
        ∀ i, |(ρ n p q - τ) i| ≤ (β i : ℤ) := by
    intro R M hM n p q hn hp hpq τ hτ hτM i
    have hnp : n < p := lt_of_lt_of_le (hgn n) hp
    have hpβ : 2 * ((N n) * d) ≤ β p := (hgβ n).trans (hβ hp)
    have hqβ : 2 * ((N n) * d) ≤ β q := hpβ.trans (hβ (le_of_lt hpq))
    have hnβ : 2 * d ≤ β n := hn0.trans (hβ hn)
    have hτi : |τ i| ≤ (R : ℤ) := hτ i
    have hτbig : τ i ≠ 0 → 2 * R + 2 ≤ β i := fun h => hM.trans (hβ (le_of_lt (hτM i h)))
    -- the value of `ρ` at `i` and a bound for it
    have key : ∀ a : ℕ, |(ρ n p q) i| ≤ (a : ℤ) → 2 * a ≤ β i → |(ρ n p q - τ) i| ≤ (β i : ℤ) := by
      intro a h1 h2
      rw [Finsupp.sub_apply]
      have h3 := abs_sub ((ρ n p q) i) (τ i)
      by_cases h4 : τ i = 0
      · rw [h4, sub_zero]
        exact h1.trans (by exact_mod_cast (le_trans (by omega) h2))
      · have h5 := hτbig h4
        have h6 : a + R ≤ β i := by omega
        have h7 : (a : ℤ) + (R : ℤ) ≤ (β i : ℤ) := by exact_mod_cast h6
        omega
    have hv := hρapp n p q i hnp hpq
    by_cases h1 : n = i
    · have h2 : ¬ p = i := by omega
      have h3 : ¬ q = i := by omega
      rw [if_pos h1, if_neg h2, if_neg h3, add_zero, add_zero] at hv
      exact key d (by rw [hv, abs_of_nonneg (Int.natCast_nonneg _)]) (h1 ▸ hnβ)
    · by_cases h2 : p = i
      · have h3 : ¬ q = i := by omega
        rw [if_neg h1, if_pos h2, if_neg h3, zero_add, add_zero] at hv
        refine key ((N n) * d) ?_ (h2 ▸ hpβ)
        rw [hv, abs_of_nonneg (Int.natCast_nonneg _)]
        exact_mod_cast (hNd n).1
      · by_cases h3 : q = i
        · rw [if_neg h1, if_neg h2, if_pos h3, zero_add, zero_add] at hv
          refine key ((N n) * d) ?_ (h3 ▸ hqβ)
          rw [hv, abs_neg, abs_of_nonneg (Int.natCast_nonneg _)]
        · rw [if_neg h1, if_neg h2, if_neg h3, add_zero, add_zero] at hv
          rw [Finsupp.sub_apply, hv, zero_sub, abs_neg]
          by_cases h4 : τ i = 0
          · rw [h4, abs_zero]; exact Int.natCast_nonneg _
          · have h5 := hτbig h4
            have h6 : R ≤ β i := by omega
            exact hτi.trans (by exact_mod_cast h6)
  have hA0 : (0 : ℤ) ∉ A := by
    rintro ⟨n, p, q, hn, hp, hpq, _, _, _, h0⟩
    have hnp : n < p := lt_of_lt_of_le (hgn n) hp
    have h1 : ∀ i, |(ρ n p q - 0) i| ≤ (β i : ℤ) :=
      hbound 0 (g 0) (by
        have h2 := hgβ 0
        have h3 : 1 ≤ (0 * K + 1) * d := by omega
        omega) n p q hn hp hpq 0 (fun i => by simp) (fun i hi => absurd rfl hi)
    rw [sub_zero] at h1
    have h2 : ρ n p q = 0 := Sparse.val_inj hpos hβ hwt _ _ h1 (fun i => by simp)
      (by rw [Sparse.val_zero]; exact h0.symm)
    have h3 := congrArg (fun f : ℕ →₀ ℤ => f q) h2
    simp only [Finsupp.zero_apply] at h3
    rw [hρapp n p q q hnp hpq, if_neg (by omega), if_neg (by omega), if_pos rfl, zero_add, zero_add] at h3
    have h4 : 0 < (N n) * d := Nat.mul_pos (Nat.succ_pos _) hd0
    omega
  -- `A` has no limits
  have hopen : IsOpenMod (genFam (Sel.ultraGen (gens y LL))) Aᶜ := by
    intro z hz G hG hconv
    by_contra hno
    have hne : (G ⊓ 𝓟 A).NeBot := by
      rw [neBot_iff]
      intro h
      exact hno (inf_principal_eq_bot.1 h)
    obtain ⟨P, hP⟩ := Ultrafilter.exists_le (G ⊓ 𝓟 A)
    have hPG : (P : Filter ℤ) ≤ G := hP.trans inf_le_left
    have hPA : A ∈ P := le_principal_iff.1 (hP.trans inf_le_right)
    have hq' : (P.map (fun x => x - z) : Filter ℤ) ≤ Filter.map (fun x => x - z) G := by
      rw [Ultrafilter.coe_map]
      exact Filter.map_mono hPG
    obtain ⟨σ0, hσ0, hle⟩ := hconv.2 (P.map (fun x => x - z)) hq'
    obtain ⟨ι, _, u, ε, hu, hε, hrep⟩ := Sel.rep_of_sumClosure _ hσ0
    have hex : ∀ i, ∃ l ∈ LL, u i = sumL y l := fun i => hu i
    choose li hliL hli using hex
    set Bt : ℤ := (LL.map B).sum with hBtdef
    have hBnn : ∀ x ∈ LL.map B, (0 : ℤ) ≤ x := fun x hx => by
      obtain ⟨l', _, rfl⟩ := List.mem_map.1 hx
      exact B_nonneg l'
    have hBt : ∀ l ∈ LL, B l ≤ Bt := fun l hl => List.single_le_sum hBnn _ (List.mem_map_of_mem hl)
    set R : ℕ := Fintype.card ι * Bt.toNat with hR
    have hBl : (Bt.toNat : ℤ) = Bt := Int.toNat_of_nonneg (List.sum_nonneg hBnn)
    set f : Ultrafilter ℕ → ℤ := fun w' => ∑ i, ε i * S w' (li i) with hfdef
    have hfL : f ∈ Lat LL := by
      have h1 : f = ∑ i, ε i • (fun w' => S w' (li i)) := by
        funext w'
        rw [Finset.sum_apply]
        rfl
      rw [h1]
      exact AddSubgroup.sum_mem _ (fun i _ => AddSubgroup.zsmul_mem _
        (AddSubgroup.subset_closure (show (fun w' => S w' (li i)) ∈
          {g : Ultrafilter ℕ → ℤ | ∃ l ∈ LL, g = fun w => S w l} from ⟨li i, hliL i, rfl⟩)) _)
    -- vectors for the elements of the filter sum
    have hS : ∀ M : ℕ, {x : ℤ | ∃ τ : ℕ →₀ ℤ, (∀ i, |τ i| ≤ (R : ℤ)) ∧ (∀ i, τ i ≠ 0 → M < i) ∧
        (∀ w' ∈ (Wf : Set (Ultrafilter ℕ)), cl (F w') τ = f w') ∧ x - z = Sparse.val y τ} ∈ P := by
      intro M
      have h1 : ∀ i, H y F Wf (li i) M ∈ u i := by
        intro i
        rw [hli i]
        exact H_mem y F Wf (fun a ha b hb => hFd a ha b hb) (li i) (hlW _ (hliL i))
          (fun p hp => hFm _ (hlW _ (hliL i) p hp)) (hv _ (hliL i)) M
      have h3 : {x : ℤ | ∃ τ : ℕ →₀ ℤ, (∀ i, |τ i| ≤ (R : ℤ)) ∧ (∀ i, τ i ≠ 0 → M < i) ∧
          (∀ w' ∈ (Wf : Set (Ultrafilter ℕ)), cl (F w') τ = f w') ∧ x = Sparse.val y τ} ∈ σ0 := by
        refine Filter.mem_of_superset (hrep (fun i => H y F Wf (li i) M) h1) ?_
        rintro x ⟨a, ha, rfl⟩
        choose σ hσv hσb hσM hσc using ha
        refine ⟨∑ i, ε i • σ i, fun j => ?_, fun j hj => ?_, fun w' hw' => ?_, ?_⟩
        · rw [Finsupp.finsetSum_apply]
          refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
          have h4 : ∀ i ∈ Finset.univ, |(ε i • σ i) j| ≤ Bt := by
            intro i _
            rw [Finsupp.smul_apply, smul_eq_mul, abs_mul]
            have h5 : |ε i| = 1 := by
              rcases hε i with h | h <;> rw [h] <;> simp
            rw [h5, one_mul]
            exact (hσb i j).trans (hBt _ (hliL i))
          refine (Finset.sum_le_sum h4).trans ?_
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, hR]
          push_cast
          rw [hBl]
        · by_contra hc
          refine hj ?_
          rw [Finsupp.finsetSum_apply]
          refine Finset.sum_eq_zero (fun i _ => ?_)
          rw [Finsupp.smul_apply]
          have h4 : σ i j = 0 := by
            by_contra h5
            exact hc (hσM i j h5)
          rw [h4, smul_zero]
        · rw [cl_sum]
          show _ = ∑ i, ε i * S w' (li i)
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [cl_smul, hσc i w' hw']
        · rw [Sparse.val_finset_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [val_smul, hσv i, smul_eq_mul]
      exact hle h3
    obtain ⟨M1, hM1β, hM1R⟩ : ∃ M1 : ℕ, 2 * R + 2 ≤ β M1 ∧ R < M1 := by
      obtain ⟨m, hm⟩ := hβinf (2 * R + 2)
      exact ⟨max m (R + 1), hm.trans (hβ (le_max_left _ _)),
        lt_of_lt_of_le (Nat.lt_succ_self R) (le_max_right _ _)⟩
    have hτadm : ∀ τ : ℕ →₀ ℤ, (∀ i, |τ i| ≤ (R : ℤ)) → (∀ i, τ i ≠ 0 → M1 < i) →
        ∀ i, |τ i| ≤ (β i : ℤ) := by
      intro τ hτ hτM i
      by_cases h : τ i = 0
      · rw [h, abs_zero]; exact Int.natCast_nonneg _
      · have h1 : 2 * R + 2 ≤ β i := hM1β.trans (hβ (le_of_lt (hτM i h)))
        have h2 : R ≤ β i := by omega
        exact (hτ i).trans (by exact_mod_cast h2)
    have hpoint : ∀ M : ℕ, M1 ≤ M → ∀ Q : Set ℤ, Q ∈ P → ∃ n p q, n0 ≤ n ∧ g n ≤ p ∧ p < q ∧ n ∈ E ∧
        p ∈ E ∧ q ∈ E ∧ Sparse.val y (ρ n p q) ∈ Q ∧ ∃ τ : ℕ →₀ ℤ, (∀ i, |τ i| ≤ (R : ℤ)) ∧
        (∀ i, τ i ≠ 0 → M < i) ∧ (∀ w' ∈ (Wf : Set (Ultrafilter ℕ)), cl (F w') τ = f w') ∧
        z = Sparse.val y (ρ n p q - τ) ∧ ∀ i, |(ρ n p q - τ) i| ≤ (β i : ℤ) := by
      intro M hM Q hQ
      obtain ⟨x, ⟨hxA, hxS⟩, hxQ⟩ := Ultrafilter.nonempty_of_mem
        (inter_mem (inter_mem (f := (P : Filter ℤ)) hPA (hS M)) hQ)
      obtain ⟨n, p, q, hn, hp, hpq, hnE, hpE, hqE, rfl⟩ := hxA
      obtain ⟨τ, hτ, hτM, hτc, hτz⟩ := hxS
      refine ⟨n, p, q, hn, hp, hpq, hnE, hpE, hqE, hxQ, τ, hτ, hτM, hτc, ?_,
        hbound R M (hM1β.trans (hβ hM)) n p q hn hp hpq τ hτ hτM⟩
      have h1 : Sparse.val y (ρ n p q - τ) = Sparse.val y (ρ n p q) - Sparse.val y τ := by
        have h2 := Sparse.val_add y (ρ n p q - τ) τ
        rw [sub_add_cancel] at h2
        omega
      rw [h1]
      omega
    obtain ⟨n1, p1, q1, _, _, _, _, _, _, _, τ1, _, _, _, hz1, hadm1⟩ := hpoint M1 le_rfl univ univ_mem
    set c := ρ n1 p1 q1 - τ1 with hc
    set M := max M1 (c.support.sup id) with hM
    have hMM1 : M1 ≤ M := le_max_left _ _
    have hcM : ∀ i, c i ≠ 0 → i ≤ M := fun i hi =>
      le_trans (Finset.le_sup (f := id) (Finsupp.mem_support_iff.2 hi)) (le_max_right _ _)
    have hfin : {x : ℤ | ∃ n p q, n < p ∧ p < q ∧ q ≤ M ∧ x = Sparse.val y (ρ n p q)}.Finite := by
      refine (((finite_Iic M).prod ((finite_Iic M).prod (finite_Iic M))).image
        (fun a : ℕ × ℕ × ℕ => Sparse.val y (ρ a.1 a.2.1 a.2.2))).subset ?_
      rintro x ⟨n, p, q, h1, h2, h3, rfl⟩
      exact ⟨(n, p, q), ⟨mem_Iic.2 (le_trans (le_of_lt (lt_trans h1 h2)) h3),
        mem_Iic.2 (le_trans (le_of_lt h2) h3), mem_Iic.2 h3⟩, rfl⟩
    rcases P.mem_or_compl_mem {x : ℤ | ∃ n p q, n < p ∧ p < q ∧ q ≤ M ∧ x = Sparse.val y (ρ n p q)}
      with hsmall | hbig
    · obtain ⟨x0, _, hx0⟩ := Ultrafilter.eq_pure_of_finite_mem hfin hsmall
      have hx0A : x0 ∈ A := by
        have := hPA
        rw [hx0] at this
        exact Ultrafilter.mem_pure.1 this
      have key : ∀ k : ℕ, ∃ τ : ℕ →₀ ℤ, (∀ i, |τ i| ≤ (R : ℤ)) ∧ (∀ i, τ i ≠ 0 → k < i) ∧
          x0 - z = Sparse.val y τ := by
        intro k
        have h1 := hS k
        rw [hx0] at h1
        obtain ⟨τ, hτ, hτM, _, hτz⟩ := Ultrafilter.mem_pure.1 h1
        exact ⟨τ, hτ, hτM, hτz⟩
      obtain ⟨τa, hτa, hτaM, ha⟩ := key M1
      obtain ⟨τb, hτb, hτbM, hb⟩ := key (max M1 (τa.support.sup id))
      have heq : τb = τa := Sparse.val_inj hpos hβ hwt τb τa
        (hτadm τb hτb (fun i hi => lt_of_le_of_lt (le_max_left _ _) (hτbM i hi)))
        (hτadm τa hτa hτaM) (by rw [← hb, ← ha])
      have hτa0 : τa = 0 := by
        ext i
        by_contra hi
        have hi' : τa i ≠ 0 := hi
        have h1 : max M1 (τa.support.sup id) < i := hτbM i (heq ▸ hi')
        have h2 : i ≤ τa.support.sup id := Finset.le_sup (f := id) (Finsupp.mem_support_iff.2 hi')
        have h3 := lt_of_le_of_lt (le_max_right _ _) h1
        omega
      have hxz : x0 = z := by
        rw [hτa0, Sparse.val_zero] at ha
        omega
      exact hz (hxz ▸ hx0A)
    · obtain ⟨n, p, q, hn, hp, hpq, hnE, hpE, hqE, hxQ, τ, hτ, hτM, hτc, hzτ, hadm⟩ := hpoint M hMM1 _ hbig
      have hnp : n < p := lt_of_lt_of_le (hgn n) hp
      have hMq : M < q := by
        by_contra h
        exact hxQ ⟨n, p, q, hnp, hpq, not_lt.1 h, rfl⟩
      have heq : ρ n p q - τ = c := Sparse.val_inj hpos hβ hwt _ _ hadm hadm1 (by rw [← hzτ, ← hz1])
      have hρτ : ∀ i, ρ n p q i = c i + τ i := fun i => by
        have h1 := congrArg (fun f : ℕ →₀ ℤ => f i) heq
        simp only [Finsupp.sub_apply] at h1
        omega
      have hcq : c q = 0 := by
        by_contra h
        have := hcM q h
        omega
      have hτq : τ q = -(((N n) * d : ℕ) : ℤ) := by
        have h1 := hρτ q
        rw [hρapp n p q q hnp hpq, if_neg (by omega), if_neg (by omega), if_pos rfl, zero_add, zero_add,
          hcq, zero_add] at h1
        exact h1.symm
      have hNR : (N n) * d ≤ R := by
        have h1 := hτ q
        rw [hτq, abs_neg, abs_of_nonneg (Int.natCast_nonneg _)] at h1
        exact_mod_cast h1
      have hnM : n ≤ M := by
        have h1 : n ≤ n * K := Nat.le_mul_of_pos_right n hK
        have h2 : N n ≤ (N n) * d := Nat.le_mul_of_pos_right _ hd0
        have h3 : N n = n * K + 1 := rfl
        omega
      -- `τ` is the part of `ρ` above `M`
      have hτsupp : ∀ i, i ≠ p → i ≠ q → τ i = 0 := by
        intro i hip hiq
        by_contra h
        have h1 : M < i := hτM i h
        have h2 : c i = 0 := by
          by_contra h3
          have := hcM i h3
          omega
        have h3 := hρτ i
        rw [hρapp n p q i hnp hpq, if_neg (by omega), if_neg (Ne.symm hip), if_neg (Ne.symm hiq),
          h2] at h3
        exact h (by simpa using h3.symm)
      have hτform : τ = Finsupp.single p (τ p) + Finsupp.single q (τ q) := by
        ext i
        rw [Finsupp.add_apply, Finsupp.single_apply, Finsupp.single_apply]
        by_cases h1 : p = i
        · rw [if_pos h1, if_neg (by omega), add_zero, h1]
        · by_cases h2 : q = i
          · rw [if_neg h1, if_pos h2, zero_add, h2]
          · rw [if_neg h1, if_neg h2, add_zero]
            exact hτsupp i (Ne.symm h1) (Ne.symm h2)
      have hτp : τ p = 0 ∨ τ p = (((n * K) * d : ℕ) : ℤ) := by
        by_cases h : τ p = 0
        · exact Or.inl h
        · refine Or.inr ?_
          have h1 : M < p := hτM p h
          have h2 : c p = 0 := by
            by_contra h3
            have := hcM p h3
            omega
          have h3 := hρτ p
          rw [hρapp n p q p hnp hpq, if_neg (by omega), if_pos rfl, if_neg (by omega), zero_add, add_zero,
            h2, zero_add] at h3
          exact h3.symm
      have hclw : ∀ w' ∈ Wf, cl (F w') τ = if w' = w then τ p + τ q else 0 := by
        intro w' hw'
        rw [congrArg (cl (F w')) hτform, cl_add, cl_single, cl_single]
        by_cases h : w' = w
        · rw [if_pos h, h, if_pos hpE, if_pos hqE]
        · have h1 : p ∉ F w' := fun c1 => Set.disjoint_left.1 (hFd w hwW w' hw' (Ne.symm h)) hpE c1
          have h2 : q ∉ F w' := fun c1 => Set.disjoint_left.1 (hFd w hwW w' hw' (Ne.symm h)) hqE c1
          rw [if_neg h, if_neg h1, if_neg h2, add_zero]
      have hother : ∀ w', w' ≠ w → f w' = 0 := by
        intro w' hne
        by_cases hw' : w' ∈ Wf
        · have h1 := hτc w' hw'
          rw [hclw w' hw', if_neg hne] at h1
          exact h1.symm
        · refine Finset.sum_eq_zero (fun i _ => ?_)
          rw [S_eq_zero w' (li i) (fun p hp c => hw' (c ▸ hlW _ (hliL i) p hp)), mul_zero]
      have hmain : f w = τ p + τ q := by
        have h1 := hτc w hwW
        rw [hclw w hwW, if_pos rfl] at h1
        exact h1.symm
      rcases hτp with h | h
      · refine hsep n f hfL hother ?_
        rw [hmain, h, hτq, zero_add]
        show -(((n * K + 1) * d : ℕ) : ℤ) = -(((n * K + 1 : ℕ) : ℤ) * d)
        push_cast
        ring
      · refine hsep 0 f hfL hother ?_
        rw [hmain, h, hτq]
        show (((n * K) * d : ℕ) : ℤ) + -(((n * K + 1) * d : ℕ) : ℤ) = -(((0 * K + 1 : ℕ) : ℤ) * d)
        push_cast
        ring
  -- no group topology
  rintro ⟨t, ht, hopent⟩
  letI := t
  haveI := ht
  have hOo : IsOpen[t] Aᶜ := (hopent _).2 hopen
  have hOn : Aᶜ ∈ 𝓝 (0 : ℤ) := @IsOpen.mem_nhds ℤ t 0 Aᶜ hOo hA0
  have hut : ∀ l ∈ LL, (sumL y l : Filter ℤ) ≤ 𝓝 0 := by
    intro l hl X hX
    have huC : (sumL y l : Filter ℤ) ∈ genFam (Sel.ultraGen (gens y LL)) :=
      ⟨(sumL y l).neBot, fun U hU => ⟨_, SumClosure.gen ⟨sumL y l, ⟨l, hl, rfl⟩, rfl⟩, hU⟩⟩
    obtain ⟨X', hX'X, hX'o, hX'0⟩ := (@mem_nhds_iff ℤ t 0 X).1 hX
    refine mem_of_superset ?_ hX'X
    exact (hopent X').1 hX'o 0 hX'0 _ (sumL y l).neBot ((conv_zero _ _).2 huC)
  have halve : ∀ X : Set ℤ, X ∈ 𝓝 (0 : ℤ) → ∃ H' ∈ 𝓝 (0 : ℤ), ∀ a ∈ H', ∀ b ∈ H', a + b ∈ X := by
    intro X hX
    obtain ⟨H', hH, h⟩ := (nhds_zero_isNbhdFilter (G := ℤ)).halve X hX
    exact ⟨H', hH, h⟩
  choose half hhalf hadd using halve
  let Wn : ℕ → {X : Set ℤ // X ∈ 𝓝 (0 : ℤ)} := fun n =>
    Nat.rec ⟨Aᶜ, hOn⟩ (fun _ X => ⟨half X.1 X.2, hhalf X.1 X.2⟩) n
  have hWadd : ∀ n, ∀ a ∈ (Wn (n + 1)).1, ∀ b ∈ (Wn (n + 1)).1, a + b ∈ (Wn n).1 :=
    fun n => hadd (Wn n).1 (Wn n).2
  have h0W : ∀ n, (0 : ℤ) ∈ (Wn n).1 := fun n => mem_of_mem_nhds (Wn n).2
  have hWsum : ∀ (n j : ℕ) (z : ℕ → ℤ), (∀ i < n, z i ∈ (Wn (j + i + 1)).1) →
      ∑ i ∈ Finset.range n, z i ∈ (Wn j).1 := by
    intro n
    induction n with
    | zero => intro j z _; simpa using h0W j
    | succ n ih =>
      intro j z hz
      rw [Finset.sum_range_succ', add_comm]
      refine hWadd j _ (hz 0 (Nat.succ_pos _)) _ (ih (j + 1) (fun i => z (i + 1)) (fun i hi => ?_))
      have := hz (i + 1) (Nat.succ_lt_succ hi)
      rwa [show j + 1 + i + 1 = j + (i + 1) + 1 by omega]
  have hsm : ∀ i, ∃ G ∈ w, ∀ m ∈ G, ∀ m' ∈ G, (d : ℤ) * (y m - y m') ∈ (Wn (i + 1)).1 := fun i =>
    diff_small_family y t ht w LL hut (d : ℤ) hd _ (Wn (i + 1)).2
  choose G hGw hGd using hsm
  obtain ⟨n, ⟨hnG, hnE⟩, hnn0⟩ := Ultrafilter.nonempty_of_mem
    (inter_mem (inter_mem (f := (w : Filter ℕ)) (hGw 0) hEw) (above_mem w hw n0))
  have hn0n : n0 ≤ n := le_of_lt hnn0
  have hI : (⋂ i ∈ Finset.range (N n + 1), G i) ∩ E ∈ (w : Filter ℕ) :=
    inter_mem ((Filter.biInter_finset_mem _).2 (fun i _ => hGw i)) hEw
  obtain ⟨p, hpI, hpg⟩ := Ultrafilter.nonempty_of_mem (inter_mem hI (above_mem w hw (g n)))
  obtain ⟨q, hqI, hqp⟩ := Ultrafilter.nonempty_of_mem (inter_mem hI (above_mem w hw p))
  have hpG : ∀ i < N n + 1, p ∈ G i := fun i hi => mem_iInter₂.1 hpI.1 i (Finset.mem_range.2 hi)
  have hqG : ∀ i < N n + 1, q ∈ G i := fun i hi => mem_iInter₂.1 hqI.1 i (Finset.mem_range.2 hi)
  have hmem : Sparse.val y (ρ n p q) ∈ A :=
    ⟨n, p, q, hn0n, le_of_lt hpg, hqp, hnE, hpI.2, hqI.2, rfl⟩
  let z : ℕ → ℤ := fun i => if i = 0 then (d : ℤ) * (y n - y p) else (d : ℤ) * (y p - y q)
  have hz : ∀ i < N n + 1, z i ∈ (Wn (0 + i + 1)).1 := by
    intro i hi
    rw [Nat.zero_add]
    show (if i = 0 then (d : ℤ) * (y n - y p) else (d : ℤ) * (y p - y q)) ∈ (Wn (i + 1)).1
    split_ifs with h
    · rw [h]
      exact hGd 0 n hnG p (hpG 0 (Nat.succ_pos _))
    · exact hGd i p (hpG i hi) q (hqG i hi)
  have hsum := hWsum (N n + 1) 0 z hz
  have hval : ∑ i ∈ Finset.range (N n + 1), z i = Sparse.val y (ρ n p q) := by
    rw [Finset.sum_range_succ']
    have h1 : ∀ i ∈ Finset.range (N n), z (i + 1) = (d : ℤ) * (y p - y q) := fun i _ => if_neg (by omega)
    have h2 : z 0 = (d : ℤ) * (y n - y p) := if_pos rfl
    rw [Finset.sum_congr rfl h1, h2, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    have h3 : Sparse.val y (ρ n p q) = (d : ℤ) * y n + (((n * K) * d : ℕ) : ℤ) * y p
        + (-(((N n) * d : ℕ) : ℤ)) * y q := by
      show Sparse.val y (Finsupp.single n (d : ℤ) + Finsupp.single p (((n * K) * d : ℕ) : ℤ)
        + Finsupp.single q (-(((N n) * d : ℕ) : ℤ))) = _
      rw [Sparse.val_add, Sparse.val_add, val_single, val_single, val_single]
    rw [h3]
    show (((n * K + 1 : ℕ)) : ℤ) * ((d : ℤ) * (y p - y q)) + (d : ℤ) * (y n - y p) = _
    show _ = (d : ℤ) * y n + (((n * K) * d : ℕ) : ℤ) * y p + (-(((n * K + 1) * d : ℕ) : ℤ)) * y q
    push_cast
    ring
  rw [hval] at hsum
  exact hsum hmem


section Group

/-- Values of one generator with one index for each ultrafilter. -/
def val1 (m : Ultrafilter ℕ → ℕ) (l : List (ℤ × Ultrafilter ℕ)) : ℤ :=
  (l.map (fun p => p.1 * y (m p.2))).sum

theorem total_term_family (l : List (ℤ × Ultrafilter ℕ)) :
    ∀ V ∈ sumL y l, ∃ a ∈ V, ∃ G : Ultrafilter ℕ → Set ℕ, (∀ p ∈ l, G p.2 ∈ p.2) ∧
      ∀ m : Ultrafilter ℕ → ℕ, (∀ p ∈ l, m p.2 ∈ G p.2) → ∃ δ : Fin l.length → ℤ,
        (∀ i, ∃ s ∈ V, ∃ t ∈ V, δ i = s - t) ∧ val1 y m l = a + ∑ i, δ i := by
  classical
  induction l with
  | nil =>
    intro V hV
    have h0 : (0 : ℤ) ∈ V := Ultrafilter.mem_pure.1 hV
    exact ⟨0, h0, fun _ => univ, by simp, fun m _ => ⟨fun i => i.elim0, fun i => i.elim0, by simp [val1]⟩⟩
  | cons p l ih =>
    intro V hV
    rw [mem_sumL_cons] at hV
    obtain ⟨a, ha, G, hG, h⟩ := ih _ hV
    have ha' : {n | a + p.1 * y n ∈ V} ∈ p.2 := ha
    obtain ⟨k0, hk0⟩ := Ultrafilter.nonempty_of_mem ha'
    refine ⟨a + p.1 * y k0, hk0,
      fun w => (if ∃ q ∈ l, q.2 = w then G w else univ) ∩ (if w = p.2 then {n | a + p.1 * y n ∈ V} else univ),
      fun q hq => ?_, fun m hm => ?_⟩
    · refine Filter.inter_mem (f := (q.2 : Filter ℕ)) ?_ ?_
      · split_ifs with h1
        · obtain ⟨r, hr, hrq⟩ := h1
          exact hrq ▸ hG r hr
        · exact Filter.univ_mem
      · split_ifs with h1
        · rw [h1]; exact ha'
        · exact Filter.univ_mem
    · have hmG : ∀ q ∈ l, m q.2 ∈ G q.2 := by
        intro q hq
        have h1 := (hm q (List.mem_cons_of_mem _ hq)).1
        rwa [if_pos ⟨q, hq, rfl⟩] at h1
      have hmp : a + p.1 * y (m p.2) ∈ V := by
        have h1 := (hm p List.mem_cons_self).2
        rwa [if_pos rfl] at h1
      obtain ⟨δ, hδ, heq⟩ := h m hmG
      have lift : ∀ i, ∃ s ∈ V, ∃ t ∈ V, δ i = s - t := by
        intro i
        obtain ⟨s, hs, t, ht, hst⟩ := hδ i
        have hs' : {n | s + p.1 * y n ∈ V} ∈ p.2 := hs
        have ht' : {n | t + p.1 * y n ∈ V} ∈ p.2 := ht
        obtain ⟨n, hn1, hn2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (p.2 : Filter ℕ)) hs' ht')
        exact ⟨_, hn1, _, hn2, by rw [hst]; ring⟩
      refine ⟨Fin.cons (p.1 * (y (m p.2) - y k0)) δ, fun i => ?_, ?_⟩
      · refine Fin.cases ?_ (fun j => ?_) i
        · rw [Fin.cons_zero]
          exact ⟨_, hmp, _, hk0, by ring⟩
        · rw [Fin.cons_succ]
          exact lift j
      · have h1 : val1 y m (p :: l) = p.1 * y (m p.2) + val1 y m l := by
          unfold val1
          rw [List.map_cons, List.sum_cons]
        rw [h1, heq]
        show _ = a + p.1 * y k0 + ∑ i : Fin (l.length + 1), _
        rw [Fin.sum_univ_succ]
        simp only [Fin.cons_zero, Fin.cons_succ]
        ring

/-- The product of all nonprincipal and principal ultrafilters on `ℕ`. -/
noncomputable def prodF : Filter (Ultrafilter ℕ → ℕ) := Filter.pi (fun w : Ultrafilter ℕ => (w : Filter ℕ))

instance : (prodF).NeBot := by
  unfold prodF
  infer_instance

theorem mem_prodF (W : Finset (Ultrafilter ℕ)) (G : Ultrafilter ℕ → Set ℕ) (hG : ∀ w ∈ W, G w ∈ w) :
    {m : Ultrafilter ℕ → ℕ | ∀ w ∈ W, m w ∈ G w} ∈ prodF := by
  refine Filter.mem_of_superset (Filter.pi_mem_pi (I := (W : Set (Ultrafilter ℕ))) W.finite_toSet
    (fun w hw => hG w hw)) (fun m hm w hw => ?_)
  exact hm w hw

theorem map_prodF (w : Ultrafilter ℕ) : Filter.map (fun m : Ultrafilter ℕ → ℕ => m w) prodF ≤ (w : Filter ℕ) :=
  Filter.tendsto_eval_pi (fun w : Ultrafilter ℕ => (w : Filter ℕ)) w

/-- The filter of the values of one generator is null. -/
theorem gen_mem {C : Set (Filter ℤ)} (hC : NullFamily C) (l : List (ℤ × Ultrafilter ℕ))
    (hu : (sumL y l : Filter ℤ) ∈ C) : Filter.map (fun m => val1 y m l) prodF ∈ C := by
  set u : Filter ℤ := (sumL y l : Filter ℤ) with hudef
  set Δ : Filter ℤ := Filter.map₂ (· + ·) u (Filter.map (fun x : ℤ => -x) u) with hΔ
  let Fk : ℕ → Filter ℤ := fun k => Nat.rec u (fun _ H' => Filter.map₂ (· + ·) H' Δ) k
  have hΔC : Δ ∈ C := hC.add _ hu _ (hC.neg _ hu)
  have hFkC : ∀ k, Fk k ∈ C := by
    intro k
    induction k with
    | zero => exact hu
    | succ k ih => exact hC.add _ ih _ hΔC
  have hkey : ∀ k, ∀ T ∈ Fk k, ∃ V ∈ u, ∀ a ∈ V, ∀ δ : Fin k → ℤ,
      (∀ i, ∃ s ∈ V, ∃ t ∈ V, δ i = s - t) → a + ∑ i, δ i ∈ T := by
    intro k
    induction k with
    | zero =>
      intro T hT
      exact ⟨T, hT, fun a ha δ _ => by simpa using ha⟩
    | succ k ih =>
      intro T hT
      obtain ⟨s1, hs1, s2, hs2, hsub⟩ := Filter.mem_map₂_iff.1 hT
      obtain ⟨V1, hV1, h1⟩ := ih s1 hs1
      obtain ⟨r1, hr1, r2, hr2, hsub2⟩ := Filter.mem_map₂_iff.1 hs2
      have hr2' : (fun x : ℤ => -x) ⁻¹' r2 ∈ u := Filter.mem_map.1 hr2
      refine ⟨V1 ∩ r1 ∩ (fun x : ℤ => -x) ⁻¹' r2, Filter.inter_mem (Filter.inter_mem hV1 hr1) hr2',
        fun a ha δ hδ => ?_⟩
      rw [Fin.sum_univ_succ, add_comm (δ 0), ← add_assoc]
      refine hsub (mem_image2_of_mem (h1 a ha.1.1 (fun i => δ i.succ) (fun i => ?_)) ?_)
      · obtain ⟨s, hs, t, ht, h⟩ := hδ i.succ
        exact ⟨s, hs.1.1, t, ht.1.1, h⟩
      · obtain ⟨s, hs, t, ht, h⟩ := hδ 0
        rw [h, sub_eq_add_neg]
        exact hsub2 (mem_image2_of_mem hs.1.2 ht.2)
  refine hC.finer _ (hFkC l.length) _ ?_ (Filter.NeBot.map inferInstance _)
  intro T hT
  obtain ⟨V, hV, h⟩ := hkey _ T hT
  obtain ⟨a, ha, G, hG, hG'⟩ := total_term_family y l V hV
  classical
  have h1 : {m : Ultrafilter ℕ → ℕ | ∀ w ∈ (l.map Prod.snd).toFinset, m w ∈ G w} ∈ prodF := by
    refine mem_prodF _ G (fun w hw => ?_)
    obtain ⟨p, hp, rfl⟩ := List.mem_map.1 (List.mem_toFinset.1 hw)
    exact hG p hp
  refine Filter.mem_map.2 (Filter.mem_of_superset h1 (fun m hm => ?_))
  obtain ⟨δ, hδ, heq⟩ := hG' m (fun p hp => hm p.2 (List.mem_toFinset.2 (List.mem_map_of_mem hp)))
  show val1 y m l ∈ T
  rw [heq]
  exact h a ha δ hδ

theorem val1_eq (W : Finset (Ultrafilter ℕ)) (l : List (ℤ × Ultrafilter ℕ)) (hW : ∀ p ∈ l, p.2 ∈ W)
    (m : Ultrafilter ℕ → ℕ) : val1 y m l = ∑ w ∈ W, S w l * y (m w) := by
  classical
  induction l with
  | nil => simp [val1, S]
  | cons p l ih =>
    have h1 : val1 y m (p :: l) = p.1 * y (m p.2) + val1 y m l := by
      unfold val1
      rw [List.map_cons, List.sum_cons]
    have h2 : ∀ w, S w (p :: l) = (if p.2 = w then p.1 else 0) + S w l := by
      intro w
      unfold S
      rw [List.map_cons, List.sum_cons]
    rw [h1, ih (fun q hq => hW q (List.mem_cons_of_mem _ hq))]
    simp only [h2, add_mul, Finset.sum_add_distrib, ite_mul, zero_mul]
    rw [Finset.sum_ite_eq, if_pos (hW p List.mem_cons_self)]

/-- Every element of the group generated by the class sums gives a null filter. -/
theorem lattice_mem {C : Set (Filter ℤ)} (hC : NullFamily C) (LL : List (List (ℤ × Ultrafilter ℕ)))
    (W : Finset (Ultrafilter ℕ)) (hW : ∀ l ∈ LL, ∀ p ∈ l, p.2 ∈ W)
    (hu : ∀ l ∈ LL, (sumL y l : Filter ℤ) ∈ C) (f : Ultrafilter ℕ → ℤ) (hf : f ∈ Lat LL) :
    Filter.map (fun m : Ultrafilter ℕ → ℕ => ∑ w ∈ W, f w * y (m w)) prodF ∈ C := by
  refine AddSubgroup.closure_induction (p := fun f _ =>
    Filter.map (fun m : Ultrafilter ℕ → ℕ => ∑ w ∈ W, f w * y (m w)) prodF ∈ C) ?_ ?_ ?_ ?_ hf
  · rintro g ⟨l, hl, rfl⟩
    have h1 := gen_mem y hC l (hu l hl)
    have h2 : (fun m : Ultrafilter ℕ → ℕ => ∑ w ∈ W, S w l * y (m w)) = fun m => val1 y m l := by
      funext m
      exact (val1_eq y W l (hW l hl) m).symm
    rw [h2]; exact h1
  · have h1 : (fun m : Ultrafilter ℕ → ℕ => ∑ w ∈ W, (0 : Ultrafilter ℕ → ℤ) w * y (m w))
        = fun _ => 0 := by
      funext m
      exact Finset.sum_eq_zero (fun w _ => by simp)
    rw [h1, Filter.map_const]
    exact hC.pure_zero
  · intro g1 g2 _ _ h1 h2
    refine hC.finer _ (hC.add _ h1 _ h2) _ ?_ (Filter.NeBot.map inferInstance _)
    intro T hT
    obtain ⟨s1, hs1, s2, hs2, hsub⟩ := Filter.mem_map₂_iff.1 hT
    refine Filter.mem_map.2 (Filter.mem_of_superset (Filter.inter_mem (Filter.mem_map.1 hs1)
      (Filter.mem_map.1 hs2)) (fun m hm => ?_))
    have h3 := hsub (mem_image2_of_mem hm.1 hm.2)
    show (∑ w ∈ W, (g1 + g2) w * y (m w)) ∈ T
    have h4 : (∑ w ∈ W, (g1 + g2) w * y (m w)) = (∑ w ∈ W, g1 w * y (m w)) + ∑ w ∈ W, g2 w * y (m w) := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun w _ => by rw [Pi.add_apply, add_mul])
    rw [h4]; exact h3
  · intro g _ h
    have h1 := hC.neg _ h
    rw [Filter.map_map] at h1
    have h2 : (fun m : Ultrafilter ℕ → ℕ => ∑ w ∈ W, (-g) w * y (m w))
        = (fun x : ℤ => -x) ∘ fun m => ∑ w ∈ W, g w * y (m w) := by
      funext m
      show _ = -(∑ w ∈ W, g w * y (m w))
      rw [← Finset.sum_neg_distrib]
      exact Finset.sum_congr rfl (fun w _ => by rw [Pi.neg_apply, neg_mul])
    rw [h2]; exact h1

theorem sumL_mem_of_bases {C : Set (Filter ℤ)} (hC : NullFamily C) (d : Ultrafilter ℕ → ℤ)
    (l : List (ℤ × Ultrafilter ℕ))
    (ha : ∀ p ∈ l, ((p.2.map (fun n => d p.2 * y n)) : Filter ℤ) ∈ C) (hdiv : ∀ p ∈ l, d p.2 ∣ p.1) :
    (sumL y l : Filter ℤ) ∈ C := by
  induction l with
  | nil =>
    show ((pure 0 : Ultrafilter ℤ) : Filter ℤ) ∈ C
    rw [Ultrafilter.coe_pure]
    exact hC.pure_zero
  | cons p l ih =>
    have h1 := ih (fun q hq => ha q (List.mem_cons_of_mem _ hq)) (fun q hq => hdiv q (List.mem_cons_of_mem _ hq))
    obtain ⟨k, hk⟩ := hdiv p List.mem_cons_self
    have h2 := zmul_mem hC (ha p List.mem_cons_self) k
    refine hC.finer _ (hC.add _ h1 _ h2) _ ?_ (sumL y (p :: l)).neBot
    intro X hX
    obtain ⟨s1, hs1, s2, hs2, hsub⟩ := Filter.mem_map₂_iff.1 hX
    show X ∈ sumL y (p :: l)
    rw [mem_sumL_cons]
    refine Filter.mem_of_superset (show s1 ∈ (sumL y l : Filter ℤ) from hs1) (fun z hz => ?_)
    have h3 : {n | k * (d p.2 * y n) ∈ s2} ∈ p.2 := by
      have h4 : (fun x => k * x) ⁻¹' s2 ∈ p.2.map (fun n => d p.2 * y n) := Filter.mem_map.1 hs2
      exact h4
    refine Filter.mem_of_superset (show _ ∈ (p.2 : Filter ℕ) from h3) (fun n hn => ?_)
    have h5 := hsub (mem_image2_of_mem hz hn)
    show z + p.1 * y n ∈ X
    have h6 : p.1 * y n = k * (d p.2 * y n) := by
      calc p.1 * y n = (d p.2 * k) * y n := by rw [← hk]
        _ = k * (d p.2 * y n) := by ring
    rw [h6]; exact h5

end Group

open scoped Classical in
/-- **The classification for finitely many sums.** `d w` is a positive integer in the group
generated by the coefficients carried by `w` and dividing all of them. -/
theorem classification_family (LL : List (List (ℤ × Ultrafilter ℕ)))
    (hv : ∀ l ∈ LL, ∀ p ∈ l, ∀ a, p.2 ≠ pure a) (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l)
    (W : Finset (Ultrafilter ℕ)) (hWne : W.Nonempty) (hW : ∀ l ∈ LL, ∀ p ∈ l, p.2 ∈ W)
    (hWocc : ∀ w ∈ W, ∃ l ∈ LL, ∃ c : ℤ, (c, w) ∈ l)
    (d : Ultrafilter ℕ → ℕ) (hd0 : ∀ w ∈ W, 0 < d w)
    (hd : ∀ w ∈ W, (d w : ℤ) ∈ AddSubgroup.closure {c : ℤ | ∃ l ∈ LL, (c, w) ∈ l})
    (hdiv : ∀ l ∈ LL, ∀ p ∈ l, (d p.2 : ℤ) ∣ p.1) :
    (∃ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ ∧
      ∀ O : Set ℤ, IsOpen[t] O ↔ IsOpenMod (genFam (Sel.ultraGen (gens y LL))) O) ↔
    (∀ w ∈ W, IsPPoint w) ∧
      ∀ w ∈ W, (fun w' => if w' = w then (d w : ℤ) else 0) ∈ Lat LL := by
  classical
  have hwfree : ∀ w ∈ W, ∀ a, w ≠ pure a := by
    intro w hw a
    obtain ⟨l, hl, c, hc⟩ := hWocc w hw
    exact hv l hl (c, w) hc a
  obtain ⟨F, hFm, hFd⟩ := exists_disjoint_members W
  -- the merged sequence
  let z : ℕ → ℤ := fun n => if h : ∃ w ∈ W, n ∈ F w then (d h.choose : ℤ) * y n else y n
  have hzF : ∀ w ∈ W, ∀ n ∈ F w, z n = (d w : ℤ) * y n := by
    intro w hw n hn
    have h : ∃ w ∈ W, n ∈ F w := ⟨w, hw, hn⟩
    have h1 : h.choose = w := by
      by_contra hne
      exact Set.disjoint_left.1 (hFd h.choose h.choose_spec.1 w hw hne) h.choose_spec.2 hn
    show (if h : ∃ w ∈ W, n ∈ F w then (d h.choose : ℤ) * y n else y n) = _
    rw [dif_pos h, h1]
  have hzbound : ∀ n, y n ≤ z n ∧ z n ≤ ((∑ w ∈ W, d w : ℕ) + 1 : ℤ) * y n := by
    intro n
    have hy := hpos n
    show y n ≤ (if h : ∃ w ∈ W, n ∈ F w then (d h.choose : ℤ) * y n else y n) ∧
      (if h : ∃ w ∈ W, n ∈ F w then (d h.choose : ℤ) * y n else y n) ≤ _
    split_ifs with h
    · have h1 : (1 : ℤ) ≤ d h.choose := by exact_mod_cast hd0 _ h.choose_spec.1
      have h2 : d h.choose ≤ ∑ w ∈ W, d w := Finset.single_le_sum (f := d) (fun _ _ => Nat.zero_le _) h.choose_spec.1
      have h3 : (d h.choose : ℤ) ≤ ((∑ w ∈ W, d w : ℕ) : ℤ) + 1 := by
        have : (d h.choose : ℤ) ≤ ((∑ w ∈ W, d w : ℕ) : ℤ) := by exact_mod_cast h2
        omega
      exact ⟨le_mul_of_one_le_left (le_of_lt hy) h1, mul_le_mul_of_nonneg_right h3 (le_of_lt hy)⟩
    · refine ⟨le_rfl, le_mul_of_one_le_left (le_of_lt hy) ?_⟩
      have : (0 : ℤ) ≤ ((∑ w ∈ W, d w : ℕ) : ℤ) := Int.natCast_nonneg _
      omega
  have hzpos : ∀ n, 0 < z n := fun n => lt_of_lt_of_le (hpos n) (hzbound n).1
  have hzgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, z i < z l := by
    intro B
    set D : ℕ := (∑ w ∈ W, d w) + 1 with hD
    obtain ⟨L, hL⟩ := hgrow (B * D)
    refine ⟨L, fun k hk => lt_of_le_of_lt ?_ (lt_of_lt_of_le (hL k hk) (hzbound k).1)⟩
    have h1 : ∑ i ∈ Finset.range k, z i ≤ (D : ℤ) * ∑ i ∈ Finset.range k, y i := by
      rw [Finset.mul_sum]
      refine Finset.sum_le_sum (fun i _ => ?_)
      have := (hzbound i).2
      rw [hD]; push_cast at this ⊢; exact this
    have h2 : (0 : ℤ) ≤ 2 * (B : ℤ) := by positivity
    refine (mul_le_mul_of_nonneg_left h1 h2).trans (le_of_eq ?_)
    push_cast
    ring
  have hzmap : ∀ w ∈ W, w.map z = w.map (fun n => (d w : ℤ) * y n) := by
    intro w hw
    refine Ultrafilter.coe_injective ?_
    rw [Ultrafilter.coe_map, Ultrafilter.coe_map]
    refine Filter.map_congr ?_
    exact Filter.mem_of_superset (show F w ∈ (w : Filter ℕ) from hFm w hw) (fun n hn => hzF w hw n hn)
  -- the family of images
  let u : W → Ultrafilter ℤ := fun w => (w.1).map z
  have hgne : ∀ V : Set (Ultrafilter ℤ), ∀ G ∈ Sel.ultraGen V, G.NeBot := by
    rintro V G ⟨v', _, rfl⟩
    exact v'.neBot
  have hmem : ∀ V : Set (Ultrafilter ℤ), ∀ v ∈ V, (v : Filter ℤ) ∈ genFam (Sel.ultraGen V) :=
    fun V v hv' => subset_genFam (hgne V) ⟨v, hv', rfl⟩
  -- group topologies exist for the PG of the images exactly when all are P-points
  have hfam : (∃ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ ∧
      ∀ O : Set ℤ, IsOpen[t] O ↔ IsOpenMod (genFam (Sel.ultraGen (range u))) O) ↔ ∀ w ∈ W, IsPPoint w := by
    constructor
    · rintro ⟨t, ht, hopen⟩ w0 hw0
      by_contra hnp
      have hf : ∃ f : ℕ → ℕ, (∀ m, {x | f x = m} ∉ w0) ∧ ∀ C ∈ w0, ∃ m, {x | x ∈ C ∧ f x = m}.Infinite := by
        by_contra h
        refine hnp ⟨hwfree w0 hw0, fun f hf => ?_⟩
        by_contra h2
        refine h ⟨f, hf, fun C hC => ?_⟩
        by_contra h3
        refine h2 ⟨C, hC, fun m => ?_⟩
        by_contra h4
        exact h3 ⟨m, h4⟩
      obtain ⟨f, hfib, hinf⟩ := hf
      let f' : ℕ → ℕ := fun x => if x ∈ F w0 then 2 * f x else 2 * x + 1
      haveI : Nonempty W := ⟨⟨w0, hw0⟩⟩
      have h1 : ∀ (j : W) (m : ℕ), {x | f' x = m} ∉ j.1 := by
        intro j m hm
        have hsmall : ∀ a : ℕ, ({a} : Set ℕ) ∉ j.1 := fun a =>
          Sel.notMem_of_finite (hwfree j.1 j.2) (finite_singleton a)
        by_cases hj : j.1 = w0
        · have h2 : {x | f' x = m} ∩ F w0 ⊆ {x | f x = m / 2} := by
            intro x hx
            have h3 : f' x = m := hx.1
            have h4 : f' x = 2 * f x := if_pos hx.2
            show f x = m / 2
            omega
          refine hfib (m / 2) (hj ▸ Filter.mem_of_superset (Filter.inter_mem (f := (j.1 : Filter ℕ)) hm ?_) h2)
          rw [hj]; exact hFm w0 hw0
        · have h2 : {x | f' x = m} ∩ F j.1 ⊆ {(m - 1) / 2} := by
            intro x hx
            have h3 : x ∉ F w0 := fun c => Set.disjoint_left.1 (hFd j.1 j.2 w0 hw0 hj) hx.2 c
            have h4 : f' x = 2 * x + 1 := if_neg h3
            have h5 : f' x = m := hx.1
            exact mem_singleton_iff.2 (by omega)
          exact hsmall _ (Filter.mem_of_superset
            (Filter.inter_mem (f := (j.1 : Filter ℕ)) hm (hFm j.1 j.2)) h2)
      have h2 : ∀ C : Set ℕ, (∀ j : W, C ∈ j.1) → ∃ m, {x | x ∈ C ∧ f' x = m}.Infinite := by
        intro C hC
        have h3 : C ∩ F w0 ∈ w0 := Filter.inter_mem (f := (w0 : Filter ℕ)) (hC ⟨w0, hw0⟩) (hFm w0 hw0)
        obtain ⟨m, hm⟩ := hinf _ h3
        refine ⟨2 * m, hm.mono (fun x hx => ⟨hx.1.1, ?_⟩)⟩
        have h4 : f' x = 2 * f x := if_pos hx.1.2
        have h5 : f x = m := hx.2
        omega
      obtain ⟨O, h0, hO, hno⟩ := Families.exists_open_not_nhds z (fun j : W => j.1)
        (fun j => hwfree j.1 j.2) f' h1 h2 hzpos hzgrow
      refine hno t ht (fun j => ?_) (@IsOpen.mem_nhds ℤ t 0 O ((hopen O).2 hO) h0)
      intro A hA
      obtain ⟨B', hBA, hBo, hB0⟩ := (@mem_nhds_iff ℤ t 0 A).1 hA
      refine mem_of_superset ?_ hBA
      exact (hopen B').1 hBo 0 hB0 _ (u j).neBot ((conv_zero _ _).2 (hmem _ _ (mem_range_self j)))
    · intro hP
      have h1 : ∀ j : W, IsPPoint (u j) := by
        intro j
        have h2 : IsPPoint j.1 := hP j.1 j.2
        have hfin : ∀ a : ℤ, {n | z n = a}.Finite := by
          intro a
          obtain ⟨L, hL⟩ := hgrow 1
          refine (finite_Iic (max L a.toNat)).subset (fun n hn => ?_)
          have hna : z n = a := hn
          rw [mem_Iic]
          by_contra hc
          have h3 := hL n (by omega)
          have h4 : (n : ℤ) ≤ ∑ i ∈ Finset.range n, y i := by
            have h5 : ∑ _i ∈ Finset.range n, (1 : ℤ) ≤ ∑ i ∈ Finset.range n, y i :=
              Finset.sum_le_sum (fun i _ => hpos i)
            simpa using h5
          have h6 := (hzbound n).1
          push_cast at h3
          omega
        refine ⟨fun a h => ?_, fun g hg => ?_⟩
        · have h3 : ({a} : Set ℤ) ∈ j.1.map z := by
            rw [show j.1.map z = u j from rfl, h]; exact Ultrafilter.mem_pure.2 rfl
          have h4 : z ⁻¹' {a} ∈ j.1 := h3
          exact Sel.notMem_of_finite h2.1 (hfin a) h4
        · obtain ⟨D, hD, h⟩ := h2.2 (fun n => g (z n)) (fun m h => hg m h)
          have hzD : z '' D ∈ j.1.map z := by
            show z ⁻¹' (z '' D) ∈ j.1
            exact Filter.mem_of_superset hD (subset_preimage_image z D)
          refine ⟨z '' D, hzD, fun m => ?_⟩
          refine ((h m).image z).subset ?_
          rintro _ ⟨⟨n, hn, rfl⟩, hm⟩
          exact ⟨n, ⟨hn, hm⟩, rfl⟩
      obtain ⟨t, ht, hopen, _, _⟩ := ppoint_modification (J := W) (Equiv.intEquivNat.symm) u h1
      exact ⟨t, ht, hopen⟩
  have heq : (∀ w ∈ W, (fun w' => if w' = w then (d w : ℤ) else 0) ∈ Lat LL) →
      genFam (Sel.ultraGen (gens y LL)) = genFam (Sel.ultraGen (range u)) := by
    intro hlat
    refine Set.Subset.antisymm ?_ ?_
    · refine genFam_le (genFam_nullFamily _) ?_
      rintro G ⟨v, ⟨l, hl, rfl⟩, rfl⟩
      refine sumL_mem_of_bases y (genFam_nullFamily _) (fun w => (d w : ℤ)) l (fun p hp => ?_)
        (fun p hp => hdiv l hl p hp)
      rw [← hzmap p.2 (hW l hl p hp)]
      exact hmem _ _ (mem_range_self (⟨p.2, hW l hl p hp⟩ : W))
    · refine genFam_le (genFam_nullFamily _) ?_
      rintro G ⟨v, ⟨j, rfl⟩, rfl⟩
      have h1 := lattice_mem y (genFam_nullFamily (Sel.ultraGen (gens y LL))) LL W hW
        (fun l hl => hmem _ _ ⟨l, hl, rfl⟩) _ (hlat j.1 j.2)
      have h2 : (fun m : Ultrafilter ℕ → ℕ => ∑ w' ∈ W, (if w' = j.1 then (d j.1 : ℤ) else 0) * y (m w'))
          = (fun n => (d j.1 : ℤ) * y n) ∘ fun m => m j.1 := by
        funext m
        simp only [ite_mul, zero_mul]
        rw [Finset.sum_ite_eq', if_pos j.2]
        rfl
      rw [h2, ← Filter.map_map] at h1
      have h3 : Filter.map (fun m : Ultrafilter ℕ → ℕ => m j.1) prodF = (j.1 : Filter ℕ) :=
        Filter.map_eval_pi (fun w : Ultrafilter ℕ => (w : Filter ℕ)) j.1
      rw [h3, ← Ultrafilter.coe_map, ← hzmap j.1 j.2] at h1
      exact h1
  have notgroup : ∀ w ∈ W, (fun w' => if w' = w then (d w : ℤ) else 0) ∉ Lat LL →
      ¬ ∃ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ ∧
        ∀ O : Set ℤ, IsOpen[t] O ↔ IsOpenMod (genFam (Sel.ultraGen (gens y LL))) O := by
    intro w hw hnot
    set e : Ultrafilter ℕ → ℤ := fun w' => if w' = w then (d w : ℤ) else 0 with he
    obtain ⟨K, hK, hKprop⟩ : ∃ K : ℕ, 0 < K ∧ ∀ n : ℕ, ((n * K + 1 : ℕ) : ℤ) • e ∉ Lat LL := by
      by_cases h : ∃ k : ℕ, 0 < k ∧ (k : ℤ) • e ∈ Lat LL
      · obtain ⟨k, hk, hke⟩ := h
        refine ⟨k, hk, fun n hn => hnot ?_⟩
        have h1 : ((n : ℤ) • ((k : ℤ) • e)) ∈ Lat LL := AddSubgroup.zsmul_mem _ hke _
        have h2 := AddSubgroup.sub_mem _ hn h1
        have h3 : ((n * k + 1 : ℕ) : ℤ) • e - (n : ℤ) • ((k : ℤ) • e) = e := by
          rw [smul_smul, ← sub_smul]
          have h4 : ((n * k + 1 : ℕ) : ℤ) - (n : ℤ) * (k : ℤ) = 1 := by push_cast; ring
          rw [h4, one_smul]
        rwa [h3] at h2
      · exact ⟨1, one_pos, fun n hn => h ⟨n * 1 + 1, Nat.succ_pos _, hn⟩⟩
    refine not_group_of_sep_family y LL hv hpos hgrow w (hwfree w hw) (d w) (hd0 w hw) (hd w hw) K hK
      (fun n f hf hother heqf => ?_)
    refine hKprop n ?_
    have h1 : f = -(((n * K + 1 : ℕ) : ℤ) • e) := by
      funext w'
      show f w' = -(((n * K + 1 : ℕ) : ℤ) * (if w' = w then (d w : ℤ) else 0))
      by_cases h : w' = w
      · rw [if_pos h, h, heqf]
      · rw [if_neg h, hother w' h, mul_zero, neg_zero]
    rw [h1] at hf
    exact (AddSubgroup.neg_mem_iff _).1 hf
  constructor
  · intro hgroup
    have hlat : ∀ w ∈ W, (fun w' => if w' = w then (d w : ℤ) else 0) ∈ Lat LL := by
      intro w hw
      by_contra hnot
      exact notgroup w hw hnot hgroup
    refine ⟨?_, hlat⟩
    rw [heq hlat] at hgroup
    exact hfam.1 hgroup
  · rintro ⟨hP, hlat⟩
    rw [heq hlat]
    exact hfam.2 hP

end FiniteFam

end PG
