import LeanCheck.TVGPlusCert
import LeanCheck.TVGSearchDef

/-!
# TVGplus: verified exhaustive searches for the ball `{k : P_p(k - s_p) < 1/m for all listed (p, s_p)}`

Soundness of the search of `TVGSearchDef`.  For a list `(p, s_p)` of primes with shifts `s_p ∈ {0, 1}` write
`ShiftedIn l m k` for `∀ (p, s) ∈ l, P_p(k - s) < 1/m`.

* `tree_complete`: if `k` passes the coordinates `1..n` of `(p, s)` then `k mod p^(n²)` is in `tree p s m n`.
* `candidates_complete`: an integer `k ∈ [1, X]` whose residues modulo `P`, `Q` lie in the lists is generated by
  the Chinese remainder construction (when `X < P Q` and `Pinv` inverts `P` modulo `Q`).
* `search_none`: if every chunk of residues modulo `P = p^(n2²)` has all its candidates failing at some coordinate,
  then no `k ∈ [1, X]` lies in the ball.
* `least_witness_search`: the same with a membership certificate gives the least positive element of the ball.

The instances are checked by `decide +kernel` (no `native_decide`).
-/

namespace LeanCheck
namespace TVGSearch

open MixedPrime

lemma idist_eq (k Q : ℕ) : idist k Q = TVGPlus.idist k Q := by
  unfold idist TVGPlus.idist
  split_ifs with h <;> omega

lemma good_iff {p s m n k : ℕ} (hp : 2 ≤ p) (hs : s ≤ k) :
    good p s m n k = true ↔ m * TVGPlus.idist (k - s) (p ^ (n ^ 2)) < p ^ (n ^ 2) := by
  unfold good
  have e : n * n = n ^ 2 := by ring
  rw [e, decide_eq_true_eq, idist_eq]
  have hm : (k + p ^ (n ^ 2) - s) % p ^ (n ^ 2) = (k - s) % p ^ (n ^ 2) := by
    have : k + p ^ (n ^ 2) - s = (k - s) + p ^ (n ^ 2) := by omega
    rw [this, Nat.add_mod_right]
  unfold TVGPlus.idist
  rw [hm]

lemma notIn_of_not_good {p s m n k : ℕ} (hp : 2 ≤ p) (hn : 1 ≤ n) (hm : 0 < m) (hs : s ≤ k)
    (h : good p s m n k = false) : ¬ Pn (sqScales p) ((k : ℤ) - s) < 1 / (m : ℝ) := by
  have h' : ¬ (m * TVGPlus.idist (k - s) (p ^ (n ^ 2)) < p ^ (n ^ 2)) := by
    intro h2
    have := (good_iff hp hs).2 h2
    rw [this] at h
    exact absurd h (by simp)
  have h2 : p ^ (n ^ 2) ≤ m * TVGPlus.idist (k - s) (p ^ (n ^ 2)) := by omega
  have := TVGPlus.not_inBall_of_fail hp (k - s) n m hn hm h2
  have e : (((k - s : ℕ)) : ℤ) = (k : ℤ) - s := by push_cast [Nat.cast_sub hs]; ring
  rwa [e] at this

lemma failsFrom_spec {p s m start N k : ℕ} (hp : 2 ≤ p) (hstart : 1 ≤ start) (hm : 0 < m) (hs : s ≤ k)
    (h : failsFrom p s m start N k = true) : ¬ Pn (sqScales p) ((k : ℤ) - s) < 1 / (m : ℝ) := by
  unfold failsFrom at h
  simp only [List.any_eq_true, List.mem_range, Bool.not_eq_true'] at h
  obtain ⟨j, -, hj⟩ := h
  exact notIn_of_not_good hp (by omega) hm hs hj

lemma failsAny_spec {ts : List (ℕ × ℕ × ℕ)} {m N k : ℕ} (ht : ∀ t ∈ ts, 2 ≤ t.1 ∧ t.2.1 ≤ 1 ∧ 1 ≤ t.2.2)
    (hm : 0 < m) (hk : 1 ≤ k) (h : failsAny ts m N k = true) :
    ∃ t ∈ ts, ¬ Pn (sqScales t.1) ((k : ℤ) - t.2.1) < 1 / (m : ℝ) := by
  unfold failsAny at h
  simp only [List.any_eq_true] at h
  obtain ⟨t, htm, hf⟩ := h
  have := ht t htm
  exact ⟨t, htm, failsFrom_spec this.1 this.2.2 hm (by omega) hf⟩

lemma goodUpTo_of_inBall {p s m k : ℕ} (hp : 2 ≤ p) (hm : 0 < m) (hs : s ≤ k)
    (hin : Pn (sqScales p) ((k : ℤ) - s) < 1 / (m : ℝ)) : ∀ n, goodUpTo p s m n k = true := by
  intro n
  induction n with
  | zero => rfl
  | succ n ih =>
    simp only [goodUpTo, Bool.and_eq_true, ih, true_and]
    by_contra hcon
    have hf : good p s m (n + 1) k = false := by simpa using hcon
    exact notIn_of_not_good hp (by omega) hm hs hf hin

/-- Passing a coordinate depends only on the residue modulo its modulus. -/
lemma good_mod {p s m n k : ℕ} (hp : 2 ≤ p) (hn : 1 ≤ n) (hs : s ≤ 1) :
    good p s m n (k % p ^ (n * n)) = good p s m n k := by
  unfold good
  have hQ : 2 ≤ p ^ (n * n) := by
    calc 2 ≤ p := hp
      _ = p ^ 1 := (pow_one p).symm
      _ ≤ p ^ (n * n) := Nat.pow_le_pow_right (by omega) (by nlinarith)
  have key : ∀ (Q k s : ℕ), s ≤ Q → idist (k % Q + Q - s) Q = idist (k + Q - s) Q := by
    intro Q k s hsQ
    have h1 : k % Q + Q - s = k % Q + (Q - s) := by omega
    have h2 : k + Q - s = k + (Q - s) := by omega
    unfold idist
    rw [h1, h2, Nat.mod_add_mod]
  rw [key _ _ _ (by omega)]

lemma tree_complete {p s m : ℕ} (hp : 2 ≤ p) (hs : s ≤ 1) :
    ∀ n k, goodUpTo p s m n k = true → k % p ^ (n * n) ∈ tree p s m n := by
  intro n
  induction n with
  | zero => intro k _; simp [tree, Nat.mod_one]
  | succ n ih =>
    intro k hk
    simp only [goodUpTo, Bool.and_eq_true] at hk
    have hr := ih k hk.1
    set x := k % p ^ ((n + 1) * (n + 1)) with hx
    have hdvd : p ^ (n * n) ∣ p ^ ((n + 1) * (n + 1)) :=
      pow_dvd_pow p (by nlinarith)
    have hQpos : 0 < p ^ ((n + 1) * (n + 1)) := pow_pos (by omega) _
    have hxlt : x < p ^ ((n + 1) * (n + 1)) := Nat.mod_lt _ hQpos
    have hxr : x % p ^ (n * n) = k % p ^ (n * n) := Nat.mod_mod_of_dvd _ hdvd
    have hgood : good p s m (n + 1) x = true := by
      rw [hx, good_mod hp (by omega) hs]; exact hk.2
    have hxeq : x % p ^ (n * n) + p ^ (n * n) * (x / p ^ (n * n)) = x := Nat.mod_add_div x _
    have hlt : x / p ^ (n * n) < p ^ ((n + 1) * (n + 1)) / p ^ (n * n) :=
      Nat.div_lt_div_of_lt_of_dvd hdvd hxlt
    unfold tree lift
    refine List.mem_flatMap.2 ⟨x % p ^ (n * n), by rw [hxr]; exact hr, ?_⟩
    refine List.mem_filter.2 ⟨List.mem_map.2 ⟨x / p ^ (n * n), List.mem_range.2 hlt, hxeq⟩, ?_⟩
    exact hgood

/-- Chinese remainder step: `k < P * Q`, `P * Pinv ≡ 1 (mod Q)`. -/
lemma crt_cand {P Q Pinv k : ℕ} (hQ : 2 ≤ Q) (hPinv : (P * Pinv) % Q = 1 % Q) (hk : k < P * Q) :
    k % P + P * ((((k % Q) + Q - (k % P) % Q) * Pinv) % Q) = k := by
  have hPpos : 0 < P := by
    rcases Nat.eq_zero_or_pos P with h | h
    · rw [h] at hk; simp at hk
    · exact h
  have hQpos : 0 < Q := by omega
  set r := k % P with hr
  set t := k / P with ht
  have hkeq : r + P * t = k := Nat.mod_add_div k P
  have htlt : t < Q := by
    rw [ht]; exact (Nat.div_lt_iff_lt_mul hPpos).2 (by rw [mul_comm]; exact hk)
  -- k ≡ ρ (mod Q) ; k = r + P t ; so P t ≡ ρ + Q - r % Q  (mod Q)
  have h1 : (P * t + (r + (Q - r % Q))) % Q = ((k % Q) + (Q - r % Q)) % Q := by
    have e1 : P * t + (r + (Q - r % Q)) = k + (Q - r % Q) := by rw [← hkeq]; ring
    rw [e1, Nat.mod_add_mod]
  have h2 : (r + (Q - r % Q)) % Q = 0 := by
    have : r + (Q - r % Q) = Q * (r / Q + 1) := by
      have h3 := Nat.mod_add_div r Q
      have h4 : r % Q < Q := Nat.mod_lt _ hQpos
      rw [Nat.mul_add, Nat.mul_one]
      generalize Q * (r / Q) = c at *
      generalize r % Q = a at *
      omega
    rw [this]; exact Nat.mul_mod_right _ _
  have h5 : (P * t) % Q = ((k % Q) + (Q - r % Q)) % Q := by
    rw [← h1, Nat.add_mod (P * t), h2, add_zero, Nat.mod_mod]
  -- multiply by Pinv
  have h6 : ((P * t) * Pinv) % Q = (((k % Q) + (Q - r % Q)) * Pinv) % Q := by
    rw [Nat.mul_mod, h5, ← Nat.mul_mod]
  have h7 : ((P * t) * Pinv) % Q = t % Q := by
    have : (P * t) * Pinv = t * (P * Pinv) := by ring
    rw [this, Nat.mul_mod, hPinv, Nat.mod_eq_of_lt (show 1 < Q by omega), mul_one, Nat.mod_mod]
  have h8 : t = (((k % Q) + (Q - r % Q)) * Pinv) % Q := by
    rw [← h6, h7, Nat.mod_eq_of_lt htlt]
  have h9 : (k % Q) + Q - r % Q = (k % Q) + (Q - r % Q) := by
    have : r % Q < Q := Nat.mod_lt _ hQpos
    omega
  rw [h9, ← h8]
  exact hkeq

lemma candidates_complete {P Q Pinv X : ℕ} {T2 T3 : List ℕ} (hQ : 2 ≤ Q) (hPinv : (P * Pinv) % Q = 1 % Q)
    (hX : X < P * Q) {k : ℕ} (hk1 : 1 ≤ k) (hkX : k ≤ X) (h2 : k % P ∈ T2) (h3 : k % Q ∈ T3) :
    k ∈ candidates P Q Pinv X T2 T3 := by
  have hc := crt_cand hQ hPinv (lt_of_le_of_lt hkX hX)
  unfold candidates
  simp only [List.mem_flatMap, List.mem_filterMap]
  refine ⟨k % P, h2, k % Q, h3, ?_⟩
  rw [hc]
  simp [hk1, hkX]

/-- Semantic content of one chunk: for residues `r ∈ [lo, hi)` of the tree of `p`, every candidate fails. -/
def ChunkOK (p q sp sq : ℕ) (rest : List (ℕ × ℕ)) (m n2 n3 Pinv X N lo hi : ℕ) : Prop :=
  ∀ k ∈ candidates (p ^ (n2 * n2)) (q ^ (n3 * n3)) Pinv X
      ((tree p sp m n2).filter (fun r => decide (lo ≤ r ∧ r < hi))) (tree q sq m n3),
    failsAny ((p, sp, n2 + 1) :: (q, sq, n3 + 1) :: rest.map (fun t => (t.1, t.2, 1))) m N k = true

/-- A chunk certificate (computable). -/
def searchChunk' (p q sp sq : ℕ) (rest : List (ℕ × ℕ)) (m n2 n3 Pinv X N lo hi : ℕ) : Bool :=
  (candidates (p ^ (n2 * n2)) (q ^ (n3 * n3)) Pinv X
      ((tree p sp m n2).filter (fun r => decide (lo ≤ r ∧ r < hi))) (tree q sq m n3)).all
    (fun k => failsAny ((p, sp, n2 + 1) :: (q, sq, n3 + 1) :: rest.map (fun t => (t.1, t.2, 1))) m N k)

lemma searchChunk'_spec {p q sp sq : ℕ} {rest : List (ℕ × ℕ)} {m n2 n3 Pinv X N lo hi : ℕ}
    (h : searchChunk' p q sp sq rest m n2 n3 Pinv X N lo hi = true) :
    ChunkOK p q sp sq rest m n2 n3 Pinv X N lo hi := by
  unfold searchChunk' at h
  rw [List.all_eq_true] at h
  exact h

lemma ChunkOK_trans {p q sp sq : ℕ} {rest : List (ℕ × ℕ)} {m n2 n3 Pinv X N a b c : ℕ}
    (h1 : ChunkOK p q sp sq rest m n2 n3 Pinv X N a b) (h2 : ChunkOK p q sp sq rest m n2 n3 Pinv X N b c) :
    ChunkOK p q sp sq rest m n2 n3 Pinv X N a c := by
  intro k hk
  unfold candidates at hk
  simp only [List.mem_flatMap, List.mem_filterMap, List.mem_filter, decide_eq_true_eq] at hk
  obtain ⟨r, ⟨hr, hlo, hhi⟩, ρ, hρ, hk⟩ := hk
  by_cases hrb : r < b
  · apply h1
    unfold candidates
    simp only [List.mem_flatMap, List.mem_filterMap, List.mem_filter, decide_eq_true_eq]
    exact ⟨r, ⟨hr, hlo, hrb⟩, ρ, hρ, hk⟩
  · apply h2
    unfold candidates
    simp only [List.mem_flatMap, List.mem_filterMap, List.mem_filter, decide_eq_true_eq]
    exact ⟨r, ⟨hr, by omega, hhi⟩, ρ, hρ, hk⟩

/-- The setup conditions as a proposition. -/
lemma searchSetup_spec {p q n2 n3 Pinv X : ℕ} (h : searchSetup p q n2 n3 Pinv X = true) :
    X < p ^ (n2 * n2) * q ^ (n3 * n3) ∧ (p ^ (n2 * n2) * Pinv) % q ^ (n3 * n3) = 1 % q ^ (n3 * n3) := by
  unfold searchSetup at h
  simpa using h

/-- Shifted ball: `P_p(k - s) < 1/m` for every listed `(p, s)`. -/
def ShiftedIn (l : List (ℕ × ℕ)) (m k : ℕ) : Prop :=
  ∀ t ∈ l, Pn (sqScales t.1) ((k : ℤ) - t.2) < 1 / (m : ℝ)

/-- **Exhaustive search.**  No `k ∈ [1, X]` lies in the shifted ball of radius `1/m`. -/
theorem search_none {p q sp sq : ℕ} {rest : List (ℕ × ℕ)} {m n2 n3 Pinv X : ℕ} {N : ℕ}
    (hp : 2 ≤ p) (hq : 2 ≤ q) (hsp : sp ≤ 1) (hsq : sq ≤ 1) (hrest : ∀ t ∈ rest, 2 ≤ t.1 ∧ t.2 ≤ 1)
    (hm : 0 < m) (hn2 : 1 ≤ n2) (hn3 : 1 ≤ n3)
    (hsetup : searchSetup p q n2 n3 Pinv X = true)
    (hchunk : ChunkOK p q sp sq rest m n2 n3 Pinv X N 0 (p ^ (n2 * n2))) :
    ∀ k : ℕ, 1 ≤ k → k ≤ X → ¬ ShiftedIn ((p, sp) :: (q, sq) :: rest) m k := by
  obtain ⟨hX, hPinv⟩ := searchSetup_spec hsetup
  intro k hk1 hkX hball
  have hQ2 : 2 ≤ q ^ (n3 * n3) := by
    calc 2 ≤ q := hq
      _ = q ^ 1 := (pow_one q).symm
      _ ≤ q ^ (n3 * n3) := Nat.pow_le_pow_right (by omega) (by nlinarith)
  have hp' : Pn (sqScales p) ((k : ℤ) - sp) < 1 / (m : ℝ) := hball (p, sp) (by simp)
  have hq' : Pn (sqScales q) ((k : ℤ) - sq) < 1 / (m : ℝ) := hball (q, sq) (by simp)
  have hgp := goodUpTo_of_inBall hp hm (show sp ≤ k by omega) hp' n2
  have hgq := goodUpTo_of_inBall hq hm (show sq ≤ k by omega) hq' n3
  have h2 := tree_complete hp hsp n2 k hgp
  have h3 := tree_complete hq hsq n3 k hgq
  have hPpos : 0 < p ^ (n2 * n2) := pow_pos (by omega) _
  have hmem : k ∈ candidates (p ^ (n2 * n2)) (q ^ (n3 * n3)) Pinv X
      ((tree p sp m n2).filter (fun r => decide (0 ≤ r ∧ r < p ^ (n2 * n2)))) (tree q sq m n3) := by
    apply candidates_complete hQ2 hPinv hX hk1 hkX _ h3
    simp only [List.mem_filter, decide_eq_true_eq]
    exact ⟨h2, Nat.zero_le _, Nat.mod_lt _ hPpos⟩
  have hf := hchunk k hmem
  have hts : ∀ t ∈ (p, sp, n2 + 1) :: (q, sq, n3 + 1) :: rest.map (fun t => (t.1, t.2, 1)),
      2 ≤ t.1 ∧ t.2.1 ≤ 1 ∧ 1 ≤ t.2.2 := by
    intro t ht
    simp only [List.mem_cons, List.mem_map] at ht
    rcases ht with rfl | rfl | ⟨u, hu, rfl⟩
    · exact ⟨hp, hsp, by show 1 ≤ n2 + 1; omega⟩
    · exact ⟨hq, hsq, by show 1 ≤ n3 + 1; omega⟩
    · exact ⟨(hrest u hu).1, (hrest u hu).2, le_refl _⟩
  obtain ⟨t, htm, hnot⟩ := failsAny_spec hts hm hk1 hf
  apply hnot
  simp only [List.mem_cons, List.mem_map] at htm
  rcases htm with rfl | rfl | ⟨u, hu, rfl⟩
  · exact hp'
  · exact hq'
  · exact hball u (by simp [hu])

lemma ShiftedIn_mono {l : List (ℕ × ℕ)} {m m' k : ℕ} (hm : 0 < m) (hmm : m ≤ m') (h : ShiftedIn l m' k) :
    ShiftedIn l m k := by
  intro t ht
  refine lt_of_lt_of_le (h t ht) ?_
  have h1 : (0 : ℝ) < m := by exact_mod_cast hm
  have h2 : (m : ℝ) ≤ m' := by exact_mod_cast hmm
  exact one_div_le_one_div_of_le h1 h2

#print axioms search_none

end TVGSearch
end LeanCheck
