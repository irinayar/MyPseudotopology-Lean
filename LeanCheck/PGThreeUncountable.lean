import Mathlib
import LeanCheck.PGThreePPoint

/-!
# PGthree, Section 8: when the modification of a larger family is not a group topology

`y` is a rapidly growing sequence of positive integers, `v j` are pairwise different free
ultrafilters on `ℕ`, and `u j` is the image of `v j` under `n ↦ y (2 n)` or
`n ↦ y (2 n + 1)`, according to the value `ε j`. If no set of naturals belongs to `v j`
exactly for the `j` with `ε j = true`, then the topological modification of the PG
generated by the `u j` is not a group topology.

Two ways to obtain such an `ε`: there are more functions on the index set than sets of
naturals, or one of the `v j` is a limit of the others.
-/

open Filter Set Topology

open scoped Cardinal

namespace PG

namespace Uncountable

variable {J : Type} (y : ℕ → ℤ) (ε : J → Bool) (v : J → Ultrafilter ℕ)

/-- The index of the sequence used at `n` by the `j`-th ultrafilter. -/
def idx (b : Bool) (n : ℕ) : ℕ := 2 * n + (if b then 1 else 0)

/-- The `j`-th generator. -/
noncomputable def gen (j : J) : Ultrafilter ℤ := (v j).map (fun n => y (idx (ε j) n))

/-- The forbidden sums. -/
def Dset : Set ℤ := range (fun n => y (2 * n) + y (2 * n + 1))

noncomputable def val (c : ℕ →₀ ℤ) : ℤ := c.sum (fun k a => a * y k)

theorem val_zero : val y 0 = 0 := by simp [val]

theorem val_add (c d : ℕ →₀ ℤ) : val y (c + d) = val y c + val y d := by
  unfold val
  refine Finsupp.sum_add_index' (fun k => by simp) (fun k a b => by ring)

theorem val_neg (c : ℕ →₀ ℤ) : val y (-c) = -val y c := by
  have h := val_add y c (-c)
  rw [add_neg_cancel, val_zero] at h
  omega

theorem val_single (k : ℕ) (a : ℤ) : val y (Finsupp.single k a) = a * y k := by
  unfold val
  rw [Finsupp.sum_single_index]
  simp

/-- The sums with coefficients bounded by `m`, supported on the indices allowed by the
sets `C j`, `j ∈ T`, beyond `N`. -/
def W (T : Finset J) (C : J → Set ℕ) (N m : ℕ) : Set ℤ :=
  {z | ∃ c : ℕ →₀ ℤ, (∀ k, (c k).natAbs ≤ m) ∧
    (∀ k ∈ c.support, ∃ j ∈ T, ∃ n ∈ C j, N < n ∧ k = idx (ε j) n) ∧ val y c = z}

theorem W_mono {T T' : Finset J} (h : T ⊆ T') (C : J → Set ℕ) (N : ℕ) {m m' : ℕ} (hm : m ≤ m') :
    W y ε T C N m ⊆ W y ε T' C N m' := by
  rintro z ⟨c, h1, h2, h3⟩
  refine ⟨c, fun k => (h1 k).trans hm, fun k hk => ?_, h3⟩
  obtain ⟨j, hj, rest⟩ := h2 k hk
  exact ⟨j, h hj, rest⟩

/-- Every signed filter sum of generators contains such sets. -/
theorem sum_mem (hv : ∀ j, (v j : Filter ℕ) ≤ cofinite) {σ : Filter ℤ}
    (h : SumClosure (Sel.ultraGen (range (gen y ε v))) σ) :
    ∃ (T : Finset J) (m : ℕ), ∀ C : J → Set ℕ, (∀ j ∈ T, C j ∈ v j) → ∀ N, W y ε T C N m ∈ σ := by
  classical
  have hgen : ∀ F ∈ Sel.ultraGen (range (gen y ε v)), ∃ j : J, ∀ C : J → Set ℕ, C j ∈ v j → ∀ N,
      W y ε {j} C N 1 ∈ F ∧ (fun x : ℤ => -x) ⁻¹' W y ε {j} C N 1 ∈ F := by
    rintro F ⟨u, ⟨j, rfl⟩, rfl⟩
    refine ⟨j, fun C hC N => ?_⟩
    have hbig : {n : ℕ | N < n} ∈ (v j : Filter ℕ) := by
      refine hv j ?_
      rw [Nat.cofinite_eq_atTop]
      exact eventually_gt_atTop N
    have key : ∀ s : ℤ, s.natAbs = 1 → ∀ n ∈ C j, N < n → s * y (idx (ε j) n) ∈ W y ε {j} C N 1 := by
      intro s hs n hn hNn
      refine ⟨Finsupp.single (idx (ε j) n) s, fun k => ?_, fun k hk => ?_, val_single y _ _⟩
      · rw [Finsupp.single_apply]
        split
        · omega
        · simp
      · have hk' := Finsupp.support_single_subset hk
        rw [Finset.mem_singleton] at hk'
        exact ⟨j, Finset.mem_singleton_self j, n, hn, hNn, hk'⟩
    constructor
    · show W y ε {j} C N 1 ∈ gen y ε v j
      unfold gen
      rw [Ultrafilter.mem_map]
      refine mem_of_superset (inter_mem hC hbig) (fun n hn => ?_)
      have h1 := key 1 rfl n hn.1 hn.2
      rwa [one_mul] at h1
    · show (fun x : ℤ => -x) ⁻¹' W y ε {j} C N 1 ∈ gen y ε v j
      unfold gen
      rw [Ultrafilter.mem_map]
      refine mem_of_superset (inter_mem hC hbig) (fun n hn => ?_)
      have h1 := key (-1) rfl n hn.1 hn.2
      rwa [neg_one_mul] at h1
  induction h with
  | zero =>
    refine ⟨∅, 0, fun C _ N => ?_⟩
    rw [mem_pure]
    exact ⟨0, fun k => by simp, fun k hk => by simp at hk, val_zero y⟩
  | gen hF =>
    obtain ⟨j, hj⟩ := hgen _ hF
    refine ⟨{j}, 1, fun C hC N => (hj C (hC j (Finset.mem_singleton_self j)) N).1⟩
  | neg hF =>
    obtain ⟨j, hj⟩ := hgen _ hF
    refine ⟨{j}, 1, fun C hC N => ?_⟩
    rw [mem_map]
    have h1 := (hj C (hC j (Finset.mem_singleton_self j)) N).2
    have e : (fun x : ℤ => -x) ⁻¹' W y ε {j} C N 1 = (fun x : ℤ => -x) ⁻¹' W y ε {j} C N 1 := rfl
    exact h1
  | add _ _ ih1 ih2 =>
    obtain ⟨T1, m1, h1⟩ := ih1
    obtain ⟨T2, m2, h2⟩ := ih2
    refine ⟨T1 ∪ T2, m1 + m2, fun C hC N => ?_⟩
    have a1 := h1 C (fun j hj => hC j (Finset.mem_union_left _ hj)) N
    have a2 := h2 C (fun j hj => hC j (Finset.mem_union_right _ hj)) N
    refine mem_of_superset (image2_mem_map₂ a1 a2) ?_
    rintro z ⟨z1, ⟨c1, b1, s1, e1⟩, z2, ⟨c2, b2, s2, e2⟩, rfl⟩
    refine ⟨c1 + c2, fun k => ?_, fun k hk => ?_, by rw [val_add, e1, e2]⟩
    · rw [Finsupp.add_apply]
      exact (Int.natAbs_add_le _ _).trans (add_le_add (b1 k) (b2 k))
    · rcases Finset.mem_union.1 (Finsupp.support_add hk) with h | h
      · obtain ⟨j, hj, rest⟩ := s1 k h
        exact ⟨j, Finset.mem_union_left _ hj, rest⟩
      · obtain ⟨j, hj, rest⟩ := s2 k h
        exact ⟨j, Finset.mem_union_right _ hj, rest⟩

/-- Finitely many different ultrafilters have pairwise disjoint members. -/
theorem exists_disjoint (hinj : Function.Injective v) (T : Finset J) :
    ∃ C : J → Set ℕ, (∀ j ∈ T, C j ∈ v j) ∧ ∀ j ∈ T, ∀ k ∈ T, j ≠ k → Disjoint (C j) (C k) := by
  classical
  have hsep : ∀ j k : J, ∃ S : Set ℕ, j ≠ k → S ∈ v j ∧ Sᶜ ∈ v k := by
    intro j k
    by_cases h : j = k
    · exact ⟨∅, fun h' => absurd h h'⟩
    · have hne : v j ≠ v k := fun e => h (hinj e)
      by_contra hc
      apply hne
      refine (Ultrafilter.coe_le_coe.1 (fun S hS => ?_)).symm
      show S ∈ v k
      by_contra hSk
      exact hc ⟨S, fun _ => ⟨hS, Ultrafilter.compl_mem_iff_notMem.2 hSk⟩⟩
  choose S hS using hsep
  refine ⟨fun j => ⋂ k ∈ T.erase j, (S j k ∩ (S k j)ᶜ), fun j _ => ?_, fun j hj k hk hjk => ?_⟩
  · refine (Filter.biInter_finset_mem _).2 (fun k hk => ?_)
    have hkj : k ≠ j := (Finset.mem_erase.1 hk).1
    exact inter_mem (hS j k hkj.symm).1 (hS k j hkj).2
  · rw [Set.disjoint_left]
    intro n hn1 hn2
    have a1 := mem_iInter₂.1 hn1 k (Finset.mem_erase.2 ⟨hjk.symm, hk⟩)
    have a2 := mem_iInter₂.1 hn2 j (Finset.mem_erase.2 ⟨hjk, hj⟩)
    exact a2.2 a1.1

/-- A vanishing sum with bounded coefficients has no terms far out. -/
theorem no_far_terms (hpos : ∀ i, 0 < y i) (x : ℤ) (M K : ℕ)
    (hK : ∀ k, K ≤ k → (M : ℤ) * ∑ i ∈ Finset.range k, y i + |x| < y k)
    (d : ℕ →₀ ℤ) (hd : ∀ k, (d k).natAbs ≤ M) (h : x + val y d = 0) :
    ∀ k, K ≤ k → d k = 0 := by
  classical
  by_contra hc
  push Not at hc
  obtain ⟨k0, hk0, hne0⟩ := hc
  have hne : d.support.Nonempty := ⟨k0, Finsupp.mem_support_iff.2 hne0⟩
  set k := d.support.max' hne with hk
  have hkmem : k ∈ d.support := d.support.max'_mem hne
  have hKk : K ≤ k := hk0.trans (d.support.le_max' k0 (Finsupp.mem_support_iff.2 hne0))
  have hsplit : val y d = d k * y k + ∑ i ∈ d.support.erase k, d i * y i := by
    unfold val Finsupp.sum
    exact (Finset.add_sum_erase _ _ hkmem).symm
  have hrest : |∑ i ∈ d.support.erase k, d i * y i| ≤ (M : ℤ) * ∑ i ∈ Finset.range k, y i := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    rw [Finset.mul_sum]
    have hsub : d.support.erase k ⊆ Finset.range k := by
      intro i hi
      rw [Finset.mem_range]
      have h1 := Finset.mem_erase.1 hi
      exact lt_of_le_of_ne (d.support.le_max' i h1.2) h1.1
    refine (Finset.sum_le_sum (fun i _ => ?_)).trans
      (Finset.sum_le_sum_of_subset_of_nonneg hsub (fun i _ _ => ?_))
    · rw [abs_mul, abs_of_pos (hpos i)]
      refine mul_le_mul_of_nonneg_right ?_ (hpos i).le
      rw [Int.abs_eq_natAbs]
      exact_mod_cast hd i
    · exact mul_nonneg (Int.natCast_nonneg M) (hpos i).le
  have hbig : y k ≤ |d k * y k| := by
    rw [abs_mul, abs_of_pos (hpos k)]
    have h1 : (1 : ℤ) ≤ |d k| := Int.one_le_abs (Finsupp.mem_support_iff.1 hkmem)
    calc y k = 1 * y k := (one_mul _).symm
      _ ≤ |d k| * y k := mul_le_mul_of_nonneg_right h1 (hpos k).le
  have heq : d k * y k = -(x + ∑ i ∈ d.support.erase k, d i * y i) := by
    rw [hsplit] at h
    omega
  have h2 : |d k * y k| ≤ |x| + |∑ i ∈ d.support.erase k, d i * y i| := by
    rw [heq, abs_neg]
    exact abs_add_le _ _
  have h3 := hK k hKk
  omega

/-- No sum in `W` can carry a point outside `Dset` into `Dset`. -/
theorem exists_avoiding (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l)
    (hinj : Function.Injective v) (x : ℤ) (hx : x ∉ Dset y) (T : Finset J) (m : ℕ) :
    ∃ C : J → Set ℕ, (∀ j ∈ T, C j ∈ v j) ∧ ∃ N, ∀ z ∈ W y ε T C N m, x + z ∉ Dset y := by
  classical
  obtain ⟨C, hC, hdisj⟩ := exists_disjoint v hinj T
  obtain ⟨L, hL⟩ := hgrow (m + 2 + x.natAbs)
  set K := L + 1 with hKdef
  have hK : ∀ k, K ≤ k → ((m + 2 : ℕ) : ℤ) * ∑ i ∈ Finset.range k, y i + |x| < y k := by
    intro k hk
    have h1 := hL k (by omega)
    set s := ∑ i ∈ Finset.range k, y i with hs
    have hs1 : 1 ≤ s := by
      have h0 : y 0 ≤ s :=
        Finset.single_le_sum (fun i _ => (hpos i).le) (Finset.mem_range.2 (by omega : 0 < k))
      have := hpos 0
      omega
    have hx0 : |x| = (x.natAbs : ℤ) := Int.abs_eq_natAbs x
    have h2 : ((m + 2 : ℕ) : ℤ) * s + |x| ≤ ((m + 2 + x.natAbs : ℕ) : ℤ) * s := by
      rw [hx0]
      push_cast
      have h3 : (x.natAbs : ℤ) * 1 ≤ (x.natAbs : ℤ) * s :=
        mul_le_mul_of_nonneg_left hs1 (Int.natCast_nonneg _)
      push_cast at h3
      nlinarith [h3]
    have h4 : ((m + 2 + x.natAbs : ℕ) : ℤ) * s ≤ 2 * ((m + 2 + x.natAbs : ℕ) : ℤ) * s := by
      have h5 : 0 ≤ ((m + 2 + x.natAbs : ℕ) : ℤ) * s :=
        mul_nonneg (Int.natCast_nonneg _) (by omega)
      rw [mul_assoc]
      omega
    exact lt_of_le_of_lt (h2.trans h4) h1
  refine ⟨C, hC, K, ?_⟩
  rintro z ⟨c, hcm, hcs, rfl⟩ ⟨n, hn⟩
  simp only at hn
  have hlow : ∀ k, k ≤ K → c k = 0 := by
    intro k hk
    by_contra h
    obtain ⟨j, _, n', _, hN, he⟩ := hcs k (Finsupp.mem_support_iff.2 h)
    unfold idx at he
    omega
  set P : ℕ →₀ ℤ := Finsupp.single (2 * n) 1 + Finsupp.single (2 * n + 1) 1 with hP
  have hPval : val y P = y (2 * n) + y (2 * n + 1) := by
    rw [hP, val_add, val_single, val_single, one_mul, one_mul]
  have hPapply : ∀ k, P k = (if 2 * n = k then 1 else 0) + (if 2 * n + 1 = k then 1 else 0) := by
    intro k
    rw [hP, Finsupp.add_apply, Finsupp.single_apply, Finsupp.single_apply]
  have hdval : x + val y (c - P) = 0 := by
    rw [sub_eq_add_neg, val_add, val_neg, hPval]
    omega
  have hdm : ∀ k, ((c - P) k).natAbs ≤ m + 2 := by
    intro k
    rw [Finsupp.sub_apply]
    have h1 := hcm k
    have h2 : (P k).natAbs ≤ 2 := by
      rw [hPapply]
      split <;> split <;> simp
    omega
  have hfar := no_far_terms y hpos x (m + 2) K hK (c - P) hdm hdval
  have hceq : ∀ k, K ≤ k → c k = P k := by
    intro k hk
    have h1 := hfar k hk
    rw [Finsupp.sub_apply] at h1
    omega
  by_cases hcase : K ≤ 2 * n
  · have h1 : c (2 * n) = 1 := by
      rw [hceq _ hcase, hPapply, if_pos rfl, if_neg (by omega)]
      simp
    have h2 : c (2 * n + 1) = 1 := by
      rw [hceq _ (by omega), hPapply, if_neg (by omega), if_pos rfl]
      simp
    obtain ⟨j, hj, n1, hn1, _, e1⟩ := hcs (2 * n) (Finsupp.mem_support_iff.2 (by omega))
    obtain ⟨k, hk, n2, hn2, _, e2⟩ := hcs (2 * n + 1) (Finsupp.mem_support_iff.2 (by omega))
    unfold idx at e1 e2
    have hj0 : ε j = false := by
      cases h : ε j
      · rfl
      · rw [h] at e1
        simp at e1
        omega
    have hk1 : ε k = true := by
      cases h : ε k
      · rw [h] at e2
        simp at e2
        omega
      · rfl
    rw [hj0] at e1
    rw [hk1] at e2
    simp at e1 e2
    have e3 : n1 = n := by omega
    have e4 : n2 = n := by omega
    have hjk : j ≠ k := by
      intro h
      rw [h, hk1] at hj0
      exact Bool.noConfusion hj0
    exact Set.disjoint_left.1 (hdisj j hj k hk hjk) (e3 ▸ hn1) (e4 ▸ hn2)
  · have hc0 : c = 0 := by
      ext k
      rw [Finsupp.zero_apply]
      by_cases hk : k ≤ K
      · exact hlow k hk
      · rw [hceq k (by omega), hPapply, if_neg (by omega), if_neg (by omega)]
        simp
    apply hx
    refine ⟨n, ?_⟩
    show y (2 * n) + y (2 * n + 1) = x
    rw [hn, hc0, val_zero, add_zero]

/-- The complement of the forbidden sums is open for the topological modification. -/
theorem isOpenMod_compl (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l)
    (hinj : Function.Injective v) (hv : ∀ j, (v j : Filter ℕ) ≤ cofinite) :
    IsOpenMod (genFam (Sel.ultraGen (range (gen y ε v)))) (Dset y)ᶜ := by
  classical
  intro x hx F hF hconv
  by_contra hno
  have hne : (F ⊓ 𝓟 (Dset y)).NeBot := by
    rw [neBot_iff]
    intro h
    exact hno (inf_principal_eq_bot.1 h)
  obtain ⟨p, hp⟩ := Ultrafilter.exists_le (F ⊓ 𝓟 (Dset y))
  have hpF : (p : Filter ℤ) ≤ F := hp.trans inf_le_left
  have hpD : Dset y ∈ p := le_principal_iff.1 (hp.trans inf_le_right)
  have hq : (p.map (fun z => z - x) : Filter ℤ) ≤ Filter.map (fun z => z - x) F := by
    rw [Ultrafilter.coe_map]
    exact Filter.map_mono hpF
  obtain ⟨σ, hσ, hle⟩ := hconv.2 (p.map (fun z => z - x)) hq
  obtain ⟨T, m, hTm⟩ := sum_mem y ε v hv hσ
  obtain ⟨C, hC, N, hav⟩ := exists_avoiding y ε v hpos hgrow hinj x hx T m
  have h1 : W y ε T C N m ∈ p.map (fun z => z - x) := hle (hTm C hC N)
  rw [Ultrafilter.mem_map] at h1
  obtain ⟨z, hz⟩ := Ultrafilter.nonempty_of_mem (inter_mem (show _ ∈ (p : Filter ℤ) from h1)
    (show Dset y ∈ (p : Filter ℤ) from hpD))
  refine hav (z - x) hz.1 ?_
  have e : x + (z - x) = z := by omega
  rw [e]
  exact hz.2

/-- **The theorem.** No group topology in which all generators converge to `0` has
`(Dset y)ᶜ` as a neighbourhood of `0`. -/
theorem exists_open_not_nhds (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l)
    (hinj : Function.Injective v) (hv : ∀ j, (v j : Filter ℕ) ≤ cofinite)
    (hsep : ¬ ∃ C : Set ℕ, ∀ j, C ∈ v j ↔ ε j = true) :
    ∃ O : Set ℤ, (0 : ℤ) ∈ O ∧ IsOpenMod (genFam (Sel.ultraGen (range (gen y ε v)))) O ∧
      ∀ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ →
        (∀ j, (gen y ε v j : Filter ℤ) ≤ @nhds ℤ t 0) → O ∉ @nhds ℤ t 0 := by
  classical
  refine ⟨(Dset y)ᶜ, ?_, isOpenMod_compl y ε v hpos hgrow hinj hv, fun t ht hconv hO => ?_⟩
  · rintro ⟨n, hn⟩
    have h1 := hpos (2 * n)
    have h2 := hpos (2 * n + 1)
    simp only at hn
    omega
  letI := t
  haveI := ht
  obtain ⟨V, hVo, hV0, hVV⟩ := exists_open_nhds_zero_half hO
  have hVu : ∀ j, V ∈ gen y ε v j := fun j => hconv j (hVo.mem_nhds hV0)
  have hmem : ∀ j, {n | y (idx (ε j) n) ∈ V} ∈ v j := by
    intro j
    have h := hVu j
    unfold gen at h
    exact Ultrafilter.mem_map.1 h
  apply hsep
  refine ⟨{n | y (2 * n + 1) ∈ V}, fun j => ?_⟩
  cases h : ε j
  · constructor
    · intro hB
      have hA : {n | y (2 * n) ∈ V} ∈ v j := by
        have := hmem j
        simpa [idx, h] using this
      obtain ⟨n, hn⟩ := Ultrafilter.nonempty_of_mem (inter_mem (show _ ∈ (v j : Filter ℕ) from hA)
        (show _ ∈ (v j : Filter ℕ) from hB))
      exact absurd ⟨n, rfl⟩ (hVV (y (2 * n)) hn.1 (y (2 * n + 1)) hn.2)
    · intro h'
      exact absurd h' (by simp)
  · refine ⟨fun _ => rfl, fun _ => ?_⟩
    have := hmem j
    simpa [idx, h] using this

/-- Hence the topological modification is not a group topology. -/
theorem not_isGroupTopology (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l)
    (hinj : Function.Injective v) (hv : ∀ j, (v j : Filter ℕ) ≤ cofinite)
    (hsep : ¬ ∃ C : Set ℕ, ∀ j, C ∈ v j ↔ ε j = true) :
    ¬ ∃ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ ∧
      ∀ O : Set ℤ, IsOpen[t] O ↔ IsOpenMod (genFam (Sel.ultraGen (range (gen y ε v)))) O := by
  rintro ⟨t, ht, hopen⟩
  obtain ⟨O, h0, hO, hno⟩ := exists_open_not_nhds y ε v hpos hgrow hinj hv hsep
  refine hno t ht (fun j => ?_) (@IsOpen.mem_nhds ℤ t 0 O ((hopen O).2 hO) h0)
  have hCnull : NullFamily (genFam (Sel.ultraGen (range (gen y ε v)))) := genFam_nullFamily _
  have huC : (gen y ε v j : Filter ℤ) ∈ genFam (Sel.ultraGen (range (gen y ε v))) :=
    ⟨(gen y ε v j).neBot, fun U hU => ⟨_, SumClosure.gen ⟨gen y ε v j, mem_range_self j, rfl⟩, hU⟩⟩
  intro A hA
  obtain ⟨B, hBA, hBo, hB0⟩ := @mem_nhds_iff ℤ t 0 A |>.1 hA
  refine mem_of_superset ?_ hBA
  refine (hopen B).1 hBo 0 hB0 _ (gen y ε v j).neBot ?_
  exact (conv_zero _ _).2 huC

/-- First source of such an `ε`: more functions on the index set than sets of naturals. -/
theorem exists_unseparated_of_card (v : J → Ultrafilter ℕ) (h : #(Set ℕ) < #(J → Bool)) :
    ∃ ε : J → Bool, ¬ ∃ C : Set ℕ, ∀ j, C ∈ v j ↔ ε j = true := by
  classical
  by_contra hc
  have hs : Function.Surjective (fun C : Set ℕ => fun j => decide (C ∈ v j)) := by
    intro ε
    have h1 : ∃ C : Set ℕ, ∀ j, C ∈ v j ↔ ε j = true := by
      by_contra h2
      exact hc ⟨ε, h2⟩
    obtain ⟨C, hC⟩ := h1
    refine ⟨C, funext (fun j => ?_)⟩
    have h3 := hC j
    cases e : ε j
    · rw [e] at h3
      exact decide_eq_false (fun hm => Bool.noConfusion (h3.1 hm))
    · exact decide_eq_true (h3.2 e)
  exact absurd (Cardinal.mk_le_of_surjective hs) (not_le.2 h)

/-- Second source: one of the ultrafilters is a limit of the others. -/
theorem unseparated_of_limit [DecidableEq J] (v : J → Ultrafilter ℕ) (j0 : J)
    (h : ∀ C ∈ v j0, ∃ j, j ≠ j0 ∧ C ∈ v j) :
    ¬ ∃ C : Set ℕ, ∀ j, C ∈ v j ↔ decide (j = j0) = true := by
  rintro ⟨C, hC⟩
  obtain ⟨j, hj, hCj⟩ := h C ((hC j0).2 (decide_eq_true rfl))
  exact hj (of_decide_eq_true ((hC j).1 hCj))

end Uncountable

