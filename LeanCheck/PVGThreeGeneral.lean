import LeanCheck.PVGThreeRigid

/-!
# Rigidity from a finest serving topology for an arbitrary null sequence

The full finest-serving hypothesis implies rigidity for every null sequence.
For null sequences with infinitely many nonzero terms, the comparison with
every serving topology alone suffices: their uniform-character topology is
itself serving. Both formulations allow zero terms and finitely many large
terms. The proofs use the existing finite-cover lemma for arbitrary null
sequences.

Topologies use Mathlib's order: a smaller topology is finer.
-/

open Filter Topology Set
open scoped Pointwise

namespace PVG.Three

open Two Q95 Lac

/-- A null sequence with infinitely many nonzero terms has infinite range. -/
lemma infinite_range_of_null_nonzero (δ : ℕ → ℝ)
    (h0 : Tendsto δ atTop (𝓝 0))
    (hinf : Set.Infinite {k : ℕ | δ k ≠ 0}) : (Set.range δ).Infinite := by
  intro hfin
  have hc : IsClosed (Set.range δ \ {0}) :=
    (hfin.subset Set.sdiff_subset).isClosed
  have he : ∀ᶠ k in atTop, δ k ∉ Set.range δ \ {0} :=
    h0.eventually (hc.isOpen_compl.mem_nhds (by simp))
  obtain ⟨N, hN⟩ := eventually_atTop.1 he
  apply hinf
  refine (Set.finite_Iio N).subset ?_
  intro k hk
  change k < N
  by_contra hkn
  exact hN k (Nat.le_of_not_gt hkn) ⟨Set.mem_range_self k, hk⟩

/-- The uniform-character topology serves the coefficient set for any null
sequence with infinitely many nonzero terms. -/
lemma serves_gam_general (δ : ℕ → ℝ) (h0 : Tendsto δ atTop (𝓝 0))
    (hinf : Set.Infinite {k : ℕ | δ k ≠ 0}) :
    Serves (gamTop δ) {a | InA δ sT a} := by
  obtain ⟨M, hM⟩ := h0.abs.bddAbove_range
  exact ⟨gam_group δ, gam_le_bohr δ,
    gam_ne_bohr δ (infinite_range_of_null_nonzero δ h0 hinf),
    gam_coarser_euclid δ M (fun k => hM (Set.mem_range_self k)) 0,
    fun a ha => tb_gam δ h0 a ha⟩

/-- If the topology generated by the parity topologies is itself serving and
is finer than every serving topology, the null sequence is rigid.

There is no restriction on zero terms or on the sizes of finitely many terms.
In particular this applies to null sequences with infinitely many nonzero terms.
-/
theorem rig_of_finest_general (δ : ℕ → ℝ) (h0 : Tendsto δ atTop (𝓝 0))
    (hfin : Serves (gamOf δ h0) {a | InA δ sT a} ∧
      ∀ γ : TopologicalSpace ℝ, Serves γ {a | InA δ sT a} → gamOf δ h0 ≤ γ) :
    Rig δ := by
  classical
  intro γ hg heu htb W hW
  have hs := hfin.1
  set γ' := γ ⊓ gamOf δ h0 with hγ'
  have e1 : @nhds ℝ γ' 0 = @nhds ℝ γ 0 ⊓ @nhds ℝ (gamOf δ h0) 0 :=
    @nhds_inf ℝ γ (gamOf δ h0) 0
  have hs' : Serves γ' {a | InA δ sT a} := by
    refine ⟨isTopologicalAddGroup_inf hg hs.1, inf_le_right.trans hs.2.1,
      fun h => ?_, ?_, fun a ha => ?_⟩
    · have h2 : bohrTop ≤ gamOf δ h0 := h ▸ inf_le_right
      exact hs.2.2.1 (le_antisymm hs.2.1 h2)
    · rw [e1]
      exact le_inf heu hs.2.2.2.1
    · exact tb_join γ (gamOf δ h0) hg hs.1 _ (htb a ha) (hs.2.2.2.2 a ha)
  have hW' : W ∈ @nhds ℝ (gamOf δ h0) 0 :=
    nhds_mono ((hfin.2 γ' hs').trans inf_le_left) hW
  obtain ⟨C, F, η', ε, η, hη', hε, hη, hsub⟩ := gamOf_base δ h0 W hW'
  obtain ⟨ε0, hε0, G, hG⟩ := finite_cover δ h0 C F hη' hε hη
  refine ⟨ε0, hε0, G, fun x hx => ?_⟩
  obtain ⟨f, hf, h1, h2, h3⟩ := hG x hx
  exact ⟨f, hf, hsub _ h1 h2 h3⟩

/-- For a null sequence with infinitely many nonzero terms, it suffices that
the parity topology is finer than every serving topology. This removes both
pointwise restrictions from the earlier `rig_of_finest`. -/
theorem rig_of_finest_of_infinite_nonzero (δ : ℕ → ℝ)
    (h0 : Tendsto δ atTop (𝓝 0))
    (hinf : Set.Infinite {k : ℕ | δ k ≠ 0})
    (hfin : ∀ γ : TopologicalSpace ℝ,
      Serves γ {a | InA δ sT a} → gamOf δ h0 ≤ γ) : Rig δ := by
  classical
  intro γ hg heu htb W hW
  have hs := serves_gam_general δ h0 hinf
  set γ' := γ ⊓ gamTop δ with hγ'
  have e1 : @nhds ℝ γ' 0 = @nhds ℝ γ 0 ⊓ @nhds ℝ (gamTop δ) 0 :=
    @nhds_inf ℝ γ (gamTop δ) 0
  have hs' : Serves γ' {a | InA δ sT a} := by
    refine ⟨isTopologicalAddGroup_inf hg hs.1, inf_le_right.trans hs.2.1,
      fun h => ?_, ?_, fun a ha => ?_⟩
    · have h2 : bohrTop ≤ gamTop δ := h ▸ inf_le_right
      exact hs.2.2.1 (le_antisymm hs.2.1 h2)
    · rw [e1]
      exact le_inf heu hs.2.2.2.1
    · exact tb_join γ (gamTop δ) hg hs.1 _ (htb a ha) (hs.2.2.2.2 a ha)
  have hW' : W ∈ @nhds ℝ (gamOf δ h0) 0 :=
    nhds_mono ((hfin γ' hs').trans inf_le_left) hW
  obtain ⟨C, F, η', ε, η, hη', hε, hη, hsub⟩ := gamOf_base δ h0 W hW'
  obtain ⟨ε0, hε0, G, hG⟩ := finite_cover δ h0 C F hη' hε hη
  refine ⟨ε0, hε0, G, fun x hx => ?_⟩
  obtain ⟨f, hf, h1, h2, h3⟩ := hG x hx
  exact ⟨f, hf, hsub _ h1 h2 h3⟩

end PVG.Three
