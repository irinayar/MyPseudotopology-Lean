import Mathlib
import LeanCheck.PVGBetaCantor
import LeanCheck.PVGBetaStage
import LeanCheck.PVGBetaMain

/-!
# PVG: choosing the stages (Lean check, with Kronecker's theorem as a hypothesis)

Scope. The recursive choice of the centers and radii in the proof of Theorem `thm:betaexists` of PVG_v22, producing a stage system
(`Stages` of `PVGBetaCantor`).

* `exists_family`: for open intervals `(p j, q j)` there are numbers `z j` in them that are algebraically independent over `ℚ`
  (each new number is chosen outside the countable set of numbers algebraic over the ring generated by the previous ones);
* `exists_next`: from a stage of positive radius one obtains the next stage (new centers inside the parent intervals, algebraically
  independent; the radius is chosen after the finite family of witnesses of `PVGBetaStage`);
* `exists_stages`: with `KroneckerDensity`, a stage system exists.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires mathematical review.
-/

open MeasureTheory Filter Topology Set

namespace PVG
namespace Beta

/-- A new number in an interval, transcendental over the ring generated by finitely many given numbers. -/
lemma exists_new_center (z : ℕ → ℝ) (N : ℕ) {p q : ℝ} (hpq : p < q) :
    ∃ y, p < y ∧ y < q ∧ Transcendental (Algebra.adjoin ℚ (z '' Set.Iio N)) y := by
  classical
  set R : Subalgebra ℚ ℝ := Algebra.adjoin ℚ (z '' Set.Iio N) with hR
  have hfin : (z '' Set.Iio N).Finite := (Set.finite_Iio N).image z
  have hRc : Countable R := by
    have hsub : (R : Set ℝ) = Set.range (MvPolynomial.aeval (fun s : (z '' Set.Iio N) => (s : ℝ)) :
        MvPolynomial (z '' Set.Iio N) ℚ →ₐ[ℚ] ℝ) := by
      rw [hR, ← AlgHom.coe_range, ← Algebra.adjoin_range_eq_range_aeval, Subtype.range_coe]
    haveI : Countable (z '' Set.Iio N) := hfin.countable.to_subtype
    have : (R : Set ℝ).Countable := by rw [hsub]; exact Set.countable_range _
    exact this.to_subtype
  have hcount : {y : ℝ | IsAlgebraic R y}.Countable := Algebraic.countable R ℝ
  by_contra hno
  push Not at hno
  have : Set.Ioo p q ⊆ {y : ℝ | IsAlgebraic R y} := by
    intro y hy
    by_contra hy'
    exact hno y hy.1 hy.2 hy'
  have h2 := hcount.mono this
  have h3 := Cardinal.le_aleph0_iff_set_countable.2 h2
  rw [Cardinal.mk_Ioo_real hpq] at h3
  exact absurd h3 (not_le.2 Cardinal.aleph0_lt_continuum)

lemma exists_family (N : ℕ) (p q : ℕ → ℝ) (hpq : ∀ j, p j < q j) :
    ∃ z : ℕ → ℝ, (∀ j < N, p j < z j ∧ z j < q j) ∧ AlgebraicIndepOn ℚ z (Set.Iio N) := by
  induction N with
  | zero =>
    refine ⟨fun _ => 0, by simp, ?_⟩
    have : Set.Iio 0 = (∅ : Set ℕ) := by ext j; simp
    rw [this]
    show AlgebraicIndependent ℚ (fun j : (∅ : Set ℕ) => (fun _ : ℕ => (0 : ℝ)) j)
    exact algebraicIndependent_empty_type_iff.2 (algebraMap ℚ ℝ).injective
  | succ N ih =>
    obtain ⟨z, hz, hind⟩ := ih
    obtain ⟨y, hy1, hy2, hyt⟩ := exists_new_center z N (hpq N)
    let z' : ℕ → ℝ := fun j => if j = N then y else z j
    have hz'lt : ∀ j < N, z' j = z j := fun j hj => if_neg (by omega)
    have hz'N : z' N = y := if_pos rfl
    refine ⟨z', ?_, ?_⟩
    · intro j hj
      by_cases hjN : j = N
      · subst hjN; rw [hz'N]; exact ⟨hy1, hy2⟩
      · rw [hz'lt j (by omega)]; exact hz j (by omega)
    · have hset : Set.Iio (N + 1) = insert N (Set.Iio N) := by
        ext j; simp only [Set.mem_Iio, Set.mem_insert_iff]; omega
      rw [hset, AlgebraicIndepOn.insert_iff (by simp)]
      constructor
      · have : (fun j : Set.Iio N => z' j) = (fun j : Set.Iio N => z j) :=
          funext (fun j => hz'lt j j.2)
        show AlgebraicIndependent ℚ (fun j : Set.Iio N => z' j)
        rw [this]; exact hind
      · have himg : z' '' Set.Iio N = z '' Set.Iio N := Set.image_congr (fun a ha => hz'lt a ha)
        rw [hz'N, himg]; exact hyt

/-- A stage: the centers `ctr a` and a common radius. -/
structure Stage where
  ctr : ℕ → ℝ
  rad : ℝ

/-- The witness property of a stage at level `n`. -/
def Pprop (n : ℕ) (s : Stage) : Prop :=
  ∀ c : Fin n → ℝ, (∀ i, |c i| ≤ n) → ∃ (k : ℤ) (E : Finset ℕ), E.card ≤ n ∧
    ∀ a, a < 2 ^ n → a ∉ E → ∀ l ∈ Icc (s.ctr a - s.rad) (s.ctr a + s.rad), ∀ i : Fin n,
      ‖((c i * ((k : ℝ) + 1 / 2) * l : ℝ) : AddCircle (1 : ℝ))‖ < 1 / n

def Good (n : ℕ) (s : Stage) : Prop := 0 < s.rad ∧ s.rad ≤ (1 / 2 : ℝ) ^ n ∧ (1 ≤ n → Pprop n s)

def Link (n : ℕ) (s s' : Stage) : Prop :=
  (∀ a, a < 2 ^ (n + 1) → |s'.ctr a - s.ctr (a / 2)| + s'.rad < s.rad) ∧
  (∀ c, c < 2 ^ n → 2 * s'.rad < |s'.ctr (2 * c) - s'.ctr (2 * c + 1)|)

lemma exists_pos_below (N : ℕ) (f : ℕ → ℝ) (hf : ∀ a < N, 0 < f a) : ∃ ε > 0, ∀ a < N, ε < f a := by
  induction N with
  | zero => exact ⟨1, one_pos, by simp⟩
  | succ N ih =>
    obtain ⟨ε, hε, h⟩ := ih (fun a ha => hf a (by omega))
    have hN := hf N (by omega)
    refine ⟨min ε (f N / 2), lt_min hε (by positivity), fun a ha => ?_⟩
    by_cases haN : a < N
    · exact lt_of_le_of_lt (min_le_left _ _) (h a haN)
    · have : a = N := by omega
      subst this
      exact lt_of_le_of_lt (min_le_right _ _) (half_lt_self hN)

lemma norm_perturb (u δ : ℝ) :
    ‖((u + δ : ℝ) : AddCircle (1 : ℝ))‖ ≤ ‖(u : AddCircle (1 : ℝ))‖ + |δ| := by
  rw [AddCircle.coe_add]
  exact (norm_add_le _ _).trans (add_le_add_right (norm_coe_le_abs δ) _)

set_option maxHeartbeats 800000 in
theorem exists_next (hK : KroneckerDensity) (n : ℕ) (s : Stage) (hs : 0 < s.rad) :
    ∃ s' : Stage, Good (n + 1) s' ∧ Link n s s' := by
  classical
  set N := 2 ^ (n + 1) with hN
  obtain ⟨z, hz, hind⟩ := exists_family N (fun a => s.ctr (a / 2) - s.rad)
    (fun a => s.ctr (a / 2) + s.rad) (fun a => by linarith)
  have hindF : AlgebraicIndependent ℚ (fun j : Fin N => z j) :=
    hind.comp (fun j : Fin N => (⟨j.val, j.2⟩ : Set.Iio N)) (fun a b h => Fin.ext (Subtype.ext_iff.1 h))
  have hzinj : ∀ a b, a < N → b < N → z a = z b → a = b := fun a b ha hb h => by
    have := hindF.injective (a₁ := ⟨a, ha⟩) (a₂ := ⟨b, hb⟩) h
    exact congrArg Fin.val this
  set m : ℝ := ((n + 1 : ℕ) : ℝ) with hm
  have hmpos : 0 < m := by positivity
  obtain ⟨S, k, E, hE, hS⟩ := finite_witnesses hK (n := n + 1) (fun j : Fin N => z j) hindF
    (ε := 1 / (2 * m)) (by positivity)
  set T : ℝ := ∑ c₀ ∈ S, |((k c₀ : ℤ) : ℝ) + 1 / 2| with hT
  have hT0 : 0 ≤ T := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
  obtain ⟨ε1, hε1, h1⟩ := exists_pos_below N (fun a => s.rad - |z a - s.ctr (a / 2)|) (fun a ha => by
    have := hz a ha
    rw [sub_pos]
    exact abs_lt.2 ⟨by linarith [this.1], by linarith [this.2]⟩)
  obtain ⟨ε2, hε2, h2⟩ := exists_pos_below (2 ^ n) (fun c => |z (2 * c) - z (2 * c + 1)| / 2) (fun c hc => by
    have hne : z (2 * c) ≠ z (2 * c + 1) := fun h => by
      have := hzinj _ _ (by omega) (by omega) h; omega
    have := abs_pos.2 (sub_ne_zero.2 hne)
    positivity)
  set D : ℝ := 1 / (2 * m ^ 2 * (T + 1)) with hD
  have hD0 : 0 < D := by positivity
  set r' : ℝ := min (min ε1 ε2) (min ((1 / 2 : ℝ) ^ (n + 1)) D) with hr'
  have hr'pos : 0 < r' := lt_min (lt_min hε1 hε2) (lt_min (by positivity) hD0)
  have hr1 : r' ≤ ε1 := (min_le_left _ _).trans (min_le_left _ _)
  have hr2 : r' ≤ ε2 := (min_le_left _ _).trans (min_le_right _ _)
  have hr3 : r' ≤ (1 / 2 : ℝ) ^ (n + 1) := (min_le_right _ _).trans (min_le_left _ _)
  have hr4 : r' ≤ D := (min_le_right _ _).trans (min_le_right _ _)
  refine ⟨⟨z, r'⟩, ⟨hr'pos, hr3, fun _ => ?_⟩, ?_, ?_⟩
  · intro c hc
    obtain ⟨c₀, hc₀S, hc₀⟩ := hS c hc
    refine ⟨k c₀, (E c₀).map ⟨Fin.val, Fin.val_injective⟩, ?_, ?_⟩
    · rw [Finset.card_map]; exact hE c₀ hc₀S
    · intro a ha haE l hl i
      have hnotE : (⟨a, ha⟩ : Fin N) ∉ E c₀ := fun h => haE (Finset.mem_map.2 ⟨⟨a, ha⟩, h, rfl⟩)
      have hmain := hc₀ i ⟨a, ha⟩ hnotE
      have hδ : |l - z a| ≤ r' := abs_le.2 ⟨by linarith [hl.1], by linarith [hl.2]⟩
      have hk : |((k c₀ : ℤ) : ℝ) + 1 / 2| ≤ T :=
        Finset.single_le_sum (f := fun c₀ => |((k c₀ : ℤ) : ℝ) + 1 / 2|) (fun _ _ => abs_nonneg _) hc₀S
      have hsplit : c i * ((k c₀ : ℝ) + 1 / 2) * l =
          c i * ((k c₀ : ℝ) + 1 / 2) * z a + c i * ((k c₀ : ℝ) + 1 / 2) * (l - z a) := by ring
      have hperturb : |c i * ((k c₀ : ℝ) + 1 / 2) * (l - z a)| ≤ m * T * D := by
        rw [abs_mul, abs_mul]
        have hci : |c i| ≤ m := hc i
        calc |c i| * |(k c₀ : ℝ) + 1 / 2| * |l - z a| ≤ m * T * r' :=
              mul_le_mul (mul_le_mul hci hk (abs_nonneg _) hmpos.le) hδ (abs_nonneg _)
                (mul_nonneg hmpos.le hT0)
          _ ≤ m * T * D := mul_le_mul_of_nonneg_left hr4 (mul_nonneg hmpos.le hT0)
      have hmTD : m * T * D < 1 / (2 * m) := by
        rw [hD]
        have hTT : T / (T + 1) < 1 := by rw [div_lt_one (by linarith)]; linarith
        have : m * T * (1 / (2 * m ^ 2 * (T + 1))) = (T / (T + 1)) * (1 / (2 * m)) := by
          field_simp
        rw [this]
        have : 0 < 1 / (2 * m) := by positivity
        nlinarith
      calc ‖((c i * ((k c₀ : ℝ) + 1 / 2) * l : ℝ) : AddCircle (1 : ℝ))‖
          ≤ ‖((c i * ((k c₀ : ℝ) + 1 / 2) * z a : ℝ) : AddCircle (1 : ℝ))‖ +
            |c i * ((k c₀ : ℝ) + 1 / 2) * (l - z a)| := by rw [hsplit]; exact norm_perturb _ _
        _ < 1 / (2 * m) + 1 / (2 * m) := by linarith
        _ = 1 / (((n + 1 : ℕ) : ℝ)) := by rw [← hm]; field_simp; ring
  · intro a ha
    have := h1 a ha
    show |z a - s.ctr (a / 2)| + r' < s.rad
    linarith
  · intro c hc
    have := h2 c hc
    show 2 * r' < |z (2 * c) - z (2 * c + 1)|
    linarith

/-- The root stage: the interval `[1,2]`. -/
noncomputable def stage0 : Stage := ⟨fun _ => 3 / 2, 1 / 2⟩

lemma good0 : Good 0 stage0 := ⟨by norm_num [stage0], by norm_num [stage0], fun h => by omega⟩

/-- **A stage system exists** (with Kronecker's theorem as a hypothesis). -/
theorem exists_stages (hK : KroneckerDensity) : ∃ (x : ℕ → ℕ → ℝ) (r : ℕ → ℝ), Stages x r := by
  classical
  have hnext : ∀ (n : ℕ) (s : Stage), 0 < s.rad → ∃ s' : Stage, Good (n + 1) s' ∧ Link n s s' :=
    fun n s hs => exists_next hK n s hs
  choose F hF using hnext
  let g : (n : ℕ) → {s : Stage // Good n s} :=
    fun n => Nat.rec (motive := fun n => {s : Stage // Good n s}) ⟨stage0, good0⟩
      (fun n ih => ⟨F n ih.1 ih.2.1, (hF n ih.1 ih.2.1).1⟩) n
  refine ⟨fun n a => (g n).1.ctr a, fun n => (g n).1.rad, ?_⟩
  exact
    { r_pos := fun n => (g n).2.1
      r_le := fun n => (g n).2.2.1
      root := ⟨rfl, rfl⟩
      nest := fun n a ha => (hF n (g n).1 (g n).2.1).2.1 a ha
      sib := fun n c hc => (hF n (g n).1 (g n).2.1).2.2 c hc
      P := fun n hn c hc => (g n).2.2.2 hn c hc }

/-- With Kronecker's theorem as a hypothesis, there is a measure with the stage property. -/
theorem exists_stage_measure (hK : KroneckerDensity) :
    ∃ μ : Measure ℝ, IsProbabilityMeasure μ ∧ NullSingletonClass μ ∧ μ (Icc (1 : ℝ) 2)ᶜ = 0 ∧
      StageProperty μ := by
  obtain ⟨x, r, h⟩ := exists_stages hK
  exact exists_measure_of_stages h

/-- **The existence theorem** (Theorem `thm:betaexists`), with Kronecker's theorem as the only hypothesis. -/
theorem exists_beta (hK : KroneckerDensity) :
    ∃ β : TopologicalSpace ℝ,
      @IsTopologicalAddGroup ℝ β _ ∧ @T2Space ℝ β ∧ eT ≤ β ∧ @ContinuousConstSMul ℝ ℝ β _ ∧
      (∀ V ∈ @nhds ℝ β 0, ∃ k : ℤ, ((k : ℝ) + 1 / 2) ∈ V) ∧
      (∀ b : ℝ, b ≠ 0 → ¬ @Continuous ℝ (AddCircle (1 : ℝ)) β cT (chi b)) ∧
      (∀ x : ℝ, x ∈ @closure ℝ β (Set.range (fun k : ℤ => (k : ℝ)))) := by
  obtain ⟨μ, hprob, hnull, hsupp, hst⟩ := exists_stage_measure hK
  haveI := hprob
  haveI := hnull
  exact exists_beta_of_stage_measure μ hsupp hst

end Beta
end PVG
