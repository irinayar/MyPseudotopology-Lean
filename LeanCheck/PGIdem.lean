import Mathlib
import LeanCheck.PGGenerated

/-!
# PG: levels of the PG generated by an ultrafilter and non-pretopology (Lean check)

Scope. Section 9 of `PG_v6`. `Lev u n F` says that `F` is one of the filter sums `ε_1 u + ... + ε_n u` (`ε_i = ±1`, with
`0 + ...` for `n = 0`). Then:

* `Lev.genUlt` : every ultrafilter finer than such a filter is in the generated family `GenUlt u` (of `PGGenerated`);
* `exists_lev_of_genUlt` : conversely, every ultrafilter of `GenUlt u` is finer than a filter `F` with `Lev u n F` for some `n`
  (so `GenUlt u` is the union of the closed sets of ultrafilters finer than the filters of level `n`; this is Theorem 9.1);
* `Pw C n` : the `n`-fold sumset `C + ... + C`; `Pw_mem` : if `C ∈ u` is symmetric then `Pw C n ∈ F` for all `F` of level `n`;
* `not_pretopological` : if `C ∈ u` is symmetric with `0 ∈ C`, and for every `N` there is `m` such that every set of `u` contains an
  element `y` with `m • y ∉ Pw C N`, then the PG generated by `u` is not pretopological: the filter `Vgen u` (intersection of all
  ultrafilters converging to `0`) does not converge to `0`.

The verification of the hypothesis of `not_pretopological` for the digit sets of a fast-growing FS-set is by hand (in the article).
Not formalized: the existence of idempotent ultrafilters, the p-adic residue chain, comparison with the Protasov-Zelenyuk topology.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set

namespace PG

variable {G : Type*} [AddCommGroup G]

/-- `F` is a filter sum `ε_1 u + ... + ε_n u`. -/
inductive Lev (u : Ultrafilter G) : ℕ → Filter G → Prop
  | zero : Lev u 0 (pure 0)
  | plus {n : ℕ} {F : Filter G} : Lev u n F → Lev u (n + 1) (Filter.map₂ (· + ·) (u : Filter G) F)
  | minus {n : ℕ} {F : Filter G} : Lev u n F →
      Lev u (n + 1) (Filter.map₂ (· + ·) (Filter.map (fun x : G => -x) (u : Filter G)) F)

theorem Lev.neBot {u : Ultrafilter G} {n : ℕ} {F : Filter G} (h : Lev u n F) : F.NeBot := by
  induction h with
  | zero => infer_instance
  | plus h ih => exact (inferInstance : (u : Filter G).NeBot).map₂ ih
  | minus h ih =>
    exact (Filter.NeBot.map (inferInstance : (u : Filter G).NeBot) _).map₂ ih

theorem Lev.genUlt {u : Ultrafilter G} {n : ℕ} {F : Filter G} (h : Lev u n F) :
    ∀ W : Ultrafilter G, (W : Filter G) ≤ F → GenUlt u W := by
  induction h with
  | zero =>
    intro W hW
    have : W = pure 0 := Ultrafilter.coe_le_coe.1 (by rw [Ultrafilter.coe_pure]; exact hW)
    rw [this]
    exact GenUlt.zero
  | plus h ih =>
    intro W hW
    obtain ⟨U, V, hU, hV, hWUV⟩ := exists_ultra_le_map₂ _ _ W hW
    have hUu : U = u := Ultrafilter.coe_le_coe.1 hU
    subst hUu
    exact GenUlt.add GenUlt.gen (ih V hV) hWUV
  | minus h ih =>
    intro W hW
    obtain ⟨U, V, hU, hV, hWUV⟩ := exists_ultra_le_map₂ _ _ W hW
    have hUu : U = u.map (fun x : G => -x) :=
      Ultrafilter.coe_le_coe.1 (by rw [Ultrafilter.coe_map]; exact hU)
    subst hUu
    exact GenUlt.add (GenUlt.neg GenUlt.gen) (ih V hV) hWUV

theorem Lev.add {u : Ultrafilter G} {n m : ℕ} {F H : Filter G} (hF : Lev u n F) (hH : Lev u m H) :
    Lev u (n + m) (Filter.map₂ (· + ·) F H) := by
  induction hF with
  | zero =>
    have : Filter.map₂ (· + ·) (pure (0 : G)) H = H := by
      rw [Filter.map₂_pure_left]; simp
    rw [this, Nat.zero_add]
    exact hH
  | @plus n' F' h ih =>
    have e := Filter.map₂_assoc (m := fun a b : G => a + b) (n := fun a b : G => a + b)
      (m' := fun a b : G => a + b) (n' := fun a b : G => a + b)
      (f := (u : Filter G)) (g := F') (h := H) (fun a b c => add_assoc a b c)
    rw [e]
    have h2 : n' + 1 + m = n' + m + 1 := by omega
    rw [h2]
    exact Lev.plus ih
  | @minus n' F' h ih =>
    have e := Filter.map₂_assoc (m := fun a b : G => a + b) (n := fun a b : G => a + b)
      (m' := fun a b : G => a + b) (n' := fun a b : G => a + b)
      (f := Filter.map (fun x : G => -x) (u : Filter G)) (g := F') (h := H)
      (fun a b c => add_assoc a b c)
    rw [e]
    have h2 : n' + 1 + m = n' + m + 1 := by omega
    rw [h2]
    exact Lev.minus ih

theorem Lev.neg {u : Ultrafilter G} {n : ℕ} {F : Filter G} (h : Lev u n F) :
    Lev u n (Filter.map (fun x : G => -x) F) := by
  have hneg : ((fun x : G => -x) ∘ fun x : G => -x) = id := by
    funext x; simp
  induction h with
  | zero =>
    rw [Filter.map_pure, neg_zero]
    exact Lev.zero
  | @plus n' F' h ih =>
    have e : Filter.map (fun x : G => -x) (Filter.map₂ (· + ·) (u : Filter G) F') =
        Filter.map₂ (· + ·) (Filter.map (fun x : G => -x) (u : Filter G))
          (Filter.map (fun x : G => -x) F') :=
      Filter.map_map₂_distrib (fun a b => neg_add a b)
    rw [e]
    exact Lev.minus ih
  | @minus n' F' h ih =>
    have e : Filter.map (fun x : G => -x)
        (Filter.map₂ (· + ·) (Filter.map (fun x : G => -x) (u : Filter G)) F') =
        Filter.map₂ (· + ·) (Filter.map (fun x : G => -x) (Filter.map (fun x : G => -x) (u : Filter G)))
          (Filter.map (fun x : G => -x) F') :=
      Filter.map_map₂_distrib (fun a b => neg_add a b)
    rw [e, Filter.map_map, hneg, Filter.map_id]
    exact Lev.plus ih

theorem exists_lev_of_genUlt {u : Ultrafilter G} {U : Ultrafilter G} (h : GenUlt u U) :
    ∃ (n : ℕ) (F : Filter G), Lev u n F ∧ (U : Filter G) ≤ F := by
  induction h with
  | zero => exact ⟨0, pure 0, Lev.zero, by rw [Ultrafilter.coe_pure]⟩
  | gen =>
    refine ⟨1, Filter.map₂ (· + ·) (u : Filter G) (pure 0), Lev.plus Lev.zero, ?_⟩
    rw [Filter.map₂_pure_right]
    simp
  | neg h ih =>
    obtain ⟨n, F, hF, hle⟩ := ih
    refine ⟨n, Filter.map (fun x : G => -x) F, hF.neg, ?_⟩
    rw [Ultrafilter.coe_map]
    exact Filter.map_mono hle
  | add h1 h2 hW ih1 ih2 =>
    obtain ⟨n, F, hF, hle⟩ := ih1
    obtain ⟨m, H, hH, hle'⟩ := ih2
    exact ⟨n + m, Filter.map₂ (· + ·) F H, hF.add hH, hW.trans (Filter.map₂_mono hle hle')⟩

/-- `n`-fold sumsets. -/
def Pw (C : Set G) : ℕ → Set G
  | 0 => {0}
  | n + 1 => Set.image2 (· + ·) C (Pw C n)

theorem Pw_mem {u : Ultrafilter G} {C : Set G} (hC : C ∈ (u : Filter G)) (hsym : ∀ x ∈ C, -x ∈ C)
    {n : ℕ} {F : Filter G} (h : Lev u n F) : Pw C n ∈ F := by
  induction h with
  | zero => simp [Pw]
  | plus h ih => exact Filter.image2_mem_map₂ hC ih
  | minus h ih =>
    refine Filter.image2_mem_map₂ ?_ ih
    rw [Filter.mem_map]
    exact Filter.mem_of_superset hC (fun x hx => hsym x hx)

theorem Pw_mono {C : Set G} (h0 : (0 : G) ∈ C) : Monotone (Pw C) := by
  refine monotone_nat_of_le_succ ?_
  intro n
  induction n with
  | zero =>
    intro x hx
    simp only [Pw, Set.mem_singleton_iff] at hx
    subst hx
    exact ⟨0, h0, 0, by simp [Pw], by simp⟩
  | succ n ih =>
    intro x hx
    obtain ⟨a, ha, b, hb, rfl⟩ := hx
    exact ⟨a, ha, b, ih hb, rfl⟩

/-! ### Non-pretopology -/

/-- The all-plus filter sums `u + ... + u`. -/
def plusF (u : Ultrafilter G) : ℕ → Filter G
  | 0 => pure 0
  | n + 1 => Filter.map₂ (· + ·) (u : Filter G) (plusF u n)

theorem lev_plusF (u : Ultrafilter G) : ∀ n, Lev u n (plusF u n)
  | 0 => Lev.zero
  | n + 1 => Lev.plus (lev_plusF u n)

theorem plusF_mem {u : Ultrafilter G} {s : Set G} :
    ∀ n : ℕ, s ∈ plusF u n → ∃ A ∈ (u : Filter G), ∀ y ∈ A, n • y ∈ s
  | 0, h => ⟨Set.univ, Filter.univ_mem, fun y _ => by
      simpa using (Filter.mem_pure.1 h)⟩
  | n + 1, h => by
    obtain ⟨U, hU, V, hV, hUV⟩ := Filter.mem_map₂_iff.1 h
    obtain ⟨A', hA', hA'V⟩ := plusF_mem n hV
    refine ⟨U ∩ A', Filter.inter_mem hU hA', fun y hy => ?_⟩
    have : y + n • y ∈ s := hUV ⟨y, hy.1, n • y, hA'V y hy.2, rfl⟩
    rwa [succ_nsmul']

/-- The intersection of all ultrafilters converging to `0` in the PG generated by `u`. -/
def Vgen (u : Ultrafilter G) : Filter G := ⨆ (W : Ultrafilter G) (_ : GenUlt u W), (W : Filter G)

theorem mem_Vgen {u : Ultrafilter G} {s : Set G} :
    s ∈ Vgen u ↔ ∀ W : Ultrafilter G, GenUlt u W → s ∈ (W : Filter G) := by
  simp [Vgen, Filter.mem_iSup]

theorem not_mem_Vgen_of_lev {u : Ultrafilter G} {D : Set G} {m : ℕ} {F : Filter G}
    (hF : Lev u m F) (hD : D ∉ F) : D ∉ Vgen u := by
  intro h
  rw [Filter.mem_iff_ultrafilter] at hD
  push Not at hD
  obtain ⟨W, hW, hDW⟩ := hD
  exact hDW (mem_Vgen.1 h W (hF.genUlt W hW))

/-- Non-pretopology: see the module header. -/
theorem not_pretopological (u : Ultrafilter G) (C : Set G) (hC : C ∈ (u : Filter G))
    (hsym : ∀ x ∈ C, -x ∈ C) (h0 : (0 : G) ∈ C)
    (hdig : ∀ N : ℕ, ∃ m : ℕ, ∀ S ∈ (u : Filter G), ∃ y ∈ S, m • y ∉ Pw C N) :
    Vgen u ∉ genNull u := by
  intro hV
  have hD : ∀ N, Pw C N ∉ Vgen u := by
    intro N
    obtain ⟨m, hm⟩ := hdig N
    have hnot : Pw C N ∉ plusF u m := by
      intro hmem
      obtain ⟨A, hA, hAs⟩ := plusF_mem m hmem
      obtain ⟨y, hyA, hy⟩ := hm A hA
      exact hy (hAs y hyA)
    exact not_mem_Vgen_of_lev (lev_plusF u m) hnot
  have hmono := Pw_mono h0
  have hdir : Directed (· ≥ ·) (fun n : ℕ => (𝓟 (Pw C n)ᶜ : Filter G)) := by
    intro n m
    refine ⟨max n m, ?_, ?_⟩
    · exact Filter.principal_mono.2 (Set.compl_subset_compl.2 (hmono (le_max_left n m)))
    · exact Filter.principal_mono.2 (Set.compl_subset_compl.2 (hmono (le_max_right n m)))
  let 𝒢 : Filter G := Vgen u ⊓ ⨅ n : ℕ, (𝓟 (Pw C n)ᶜ : Filter G)
  have hne : 𝒢.NeBot := by
    rw [Filter.inf_neBot_iff]
    intro s hs t ht
    rw [Filter.mem_iInf_of_directed hdir] at ht
    obtain ⟨n, ht⟩ := ht
    rw [Filter.mem_principal] at ht
    by_contra hemp
    rw [Set.not_nonempty_iff_eq_empty] at hemp
    apply hD n
    refine Filter.mem_of_superset hs ?_
    intro x hx
    by_contra hxn
    have hxt : x ∈ t := ht hxn
    have : x ∈ s ∩ t := ⟨hx, hxt⟩
    rw [hemp] at this
    exact this
  let U : Ultrafilter G := Ultrafilter.of 𝒢
  have hU : (U : Filter G) ≤ 𝒢 := Ultrafilter.of_le 𝒢
  have hgen : GenUlt u U := hV.2 U (hU.trans inf_le_left)
  obtain ⟨n, F, hF, hUF⟩ := exists_lev_of_genUlt hgen
  have h1 : Pw C n ∈ (U : Filter G) := hUF (Pw_mem hC hsym hF)
  have h2 : (Pw C n)ᶜ ∈ (U : Filter G) :=
    hU (Filter.mem_inf_of_right (Filter.mem_iInf_of_mem n (Filter.mem_principal_self _)))
  have h3 := Filter.inter_mem h1 h2
  rw [Set.inter_compl_self] at h3
  exact (Filter.empty_notMem (U : Filter G)) h3

end PG
