import LeanCheck.PVGThreeRigid
import LeanCheck.PVGTwoStab

/-!
# PVGthree: rigid dyadic sequences

The proof of `PVGTwoDescribe`, for `δ_k = 2^(-L_k)` with any strictly increasing exponents `L_k` such that the
rigidity conclusion `Rig` holds, in place of the sparse sequence. Generated from that file; the sequence and the
rigidity hypothesis are the fields of the class `Dy`.

* `gamAll_le` : (assuming `Stab.KaltonRoberts`) every topology that serves `A(δ)` is coarser than the topology
  generated by all `γ_{δ,θ}`.
-/

open Filter Topology Set UniformSpace
open scoped Pointwise

namespace PVG
namespace Three
open Two Q95 Lac

/-- A dyadic sequence `2^(-L_k)`. -/
noncomputable def dyseq (L : ℕ → ℕ) (k : ℕ) : ℝ := ((2 : ℝ) ^ L k)⁻¹

/-- A rigid dyadic sequence with increasing exponents. -/
class Dy where
  L : ℕ → ℕ
  mono : StrictMono L
  rig : Rig (dyseq L)

variable [D : Dy]

noncomputable abbrev dy : ℕ → ℝ := dyseq Dy.L

lemma dy_ne (k : ℕ) : dy k ≠ 0 := by
  unfold dy dyseq
  positivity

lemma dy_tendsto : Tendsto (dy) atTop (𝓝 0) := by
  have h1 : Tendsto (fun k : ℕ => ((2 : ℝ)⁻¹) ^ k) atTop (𝓝 0) :=
    tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)
  refine squeeze_zero (fun k => by unfold dy dyseq; positivity) (fun k => ?_) h1
  unfold dy dyseq
  rw [inv_pow]
  exact inv_anti₀ (by positivity) (pow_le_pow_right₀ one_le_two (Dy.mono.id_le k))

lemma dy_le_one (k : ℕ) : |dy k| ≤ 1 := by
  unfold dy dyseq
  rw [abs_of_pos (by positivity)]
  exact inv_le_one_of_one_le₀ (one_le_pow₀ one_le_two)

/-- `A(δ)`. -/
def Adel : Set ℝ := {a | InA dy sT a}

noncomputable abbrev parTop (θ : ℕ → AddCircle (1 : ℝ)) : TopologicalSpace ℝ := parOf dy dy_tendsto θ

lemma parTop_spec (θ : ℕ → AddCircle (1 : ℝ)) :
    @IsTopologicalAddGroup ℝ (parTop θ) _ ∧ parTop θ ≤ gamTop dy ∧ euclidNhds 0 ≤ @nhds ℝ (parTop θ) 0 ∧
      (∀ a : ℝ, InA dy sT a → Tb (@nhds ℝ (parTop θ) 0) (dil a Sset)) ∧
      ∀ ε η : ℝ, 0 < ε → ε ≤ 1 / 5 → 0 < η → Nset dy θ ε η ∈ @nhds ℝ (parTop θ) 0 :=
  parOf_spec dy dy_tendsto dy_le_one θ

/-- The topology generated by all `γ_{δ,θ}`. -/
noncomputable abbrev gamAll : TopologicalSpace ℝ := gamOf dy dy_tendsto

lemma serves_dy : Serves (gamTop (dy)) Adel := serves_gam dy dy_tendsto dy_le_one dy_ne

def Uset (ε : ℝ) : Set ℝ := {x | ∀ k, dint (x / 2 ^ Dy.L k) ≤ ε}

lemma dy_mul (k : ℕ) (x : ℝ) : dy k * x = x / 2 ^ Dy.L k := by
  unfold dy dyseq; rw [inv_mul_eq_div]

lemma Uset_mono {a b : ℝ} (h : a ≤ b) : Uset a ⊆ Uset b := fun _ hx k => (hx k).trans h

/-! ## The coordinates of the points of `U(ε)` -/

def gap (k : ℕ) : ℕ := Dy.L (k + 1) - Dy.L k

lemma Lv_gap_eq (k : ℕ) : Dy.L k + gap k = Dy.L (k + 1) := by
  have : Dy.L k < Dy.L (k + 1) := Dy.mono (Nat.lt_succ_self k)
  unfold gap; omega

noncomputable def ee (q : ℕ) : ℕ → ℝ
  | 0 => ((2 : ℝ) ^ q)⁻¹
  | k + 1 => 2 ^ Dy.L k

def pp (a q : ℕ) : ℕ → ℕ
  | 0 => Dy.L 0 + q - a - 1
  | k + 1 => gap k - a - 1

def RR (a q : ℕ) : ℕ → ℕ
  | 0 => 2 ^ (Dy.L 0 + q - a - 1)
  | k + 1 => if a + 1 ≤ gap k then 2 ^ (gap k - a - 1) else 0

lemma RR_spec (a q k : ℕ) : RR a q k = 0 ∨ RR a q k = 2 ^ pp a q k := by
  cases k with
  | zero => exact Or.inr rfl
  | succ k =>
    simp only [RR, pp]
    split_ifs
    · exact Or.inr rfl
    · exact Or.inl rfl

noncomputable def xd (q : ℕ) (d : ℕ →₀ ℤ) : ℝ := d.sum fun k z => (z : ℝ) * ee q k

lemma xd_add (q : ℕ) (d d' : ℕ →₀ ℤ) : xd q (d + d') = xd q d + xd q d' := by
  unfold xd
  rw [Finsupp.sum_add_index']
  · intro k; simp
  · intro k b c; push_cast; ring

lemma xd_range (q : ℕ) (d : ℕ →₀ ℤ) (K : ℕ) (h : d.support ⊆ Finset.range (K + 1)) :
    xd q d = (d 0 : ℝ) * ((2 : ℝ) ^ q)⁻¹ + ∑ k ∈ Finset.range K, (d (k + 1) : ℝ) * 2 ^ Dy.L k := by
  unfold xd
  rw [Finsupp.sum_of_support_subset d h (fun k z => (z : ℝ) * ee q k) (fun i _ => by simp), Finset.sum_range_succ', add_comm]
  rfl

lemma sum_gap_bound (j : ℕ) : ∑ k ∈ Finset.range j, (2 : ℝ) ^ Dy.L (k + 1) / 2 ^ Dy.L j ≤ 2 := by
  have h1 : ∀ k ∈ Finset.range j, (2 : ℝ) ^ Dy.L (k + 1) / 2 ^ Dy.L j ≤ (1 / 2) ^ (j - 1 - k) := by
    intro k hk
    have hkj := Finset.mem_range.1 hk
    have hstep : ∀ a b : ℕ, a ≤ b → Dy.L a + (b - a) ≤ Dy.L b := by
      intro a b hab
      induction b, hab using Nat.le_induction with
      | base => simp
      | succ b hab ih =>
        have := Dy.mono (Nat.lt_succ_self b)
        rw [Nat.succ_eq_add_one] at this
        omega
    have h2 := hstep (k + 1) j hkj
    rw [div_pow, one_pow, div_le_div_iff₀ (by positivity) (by positivity), one_mul, ← pow_add]
    exact pow_le_pow_right₀ one_le_two (by omega)
  refine (Finset.sum_le_sum h1).trans ?_
  rw [Finset.sum_range_reflect (fun i => (1 / 2 : ℝ) ^ i) j]
  exact sum_geometric_two_le j

lemma box_mem (a q : ℕ) (hq : a + 1 ≤ q) (d : ℕ →₀ ℤ) (hd : ∀ k, |d k| ≤ 2 * (RR a q k : ℤ)) :
    xd q d ∈ Uset (3 * ((2 : ℝ) ^ a)⁻¹) := by
  intro j
  obtain ⟨M, hM⟩ : ∃ M : ℕ, d.support ⊆ Finset.range M := d.support.exists_nat_subset_range
  set K := M + j with hK
  have hsup : d.support ⊆ Finset.range (K + 1) := hM.trans (Finset.range_mono (by omega))
  rw [xd_range q d K hsup]
  have hdr : ∀ k, |(d k : ℝ)| ≤ 2 * (RR a q k : ℝ) := by
    intro k; exact_mod_cast hd k
  have hp : (0 : ℝ) < 2 ^ Dy.L j := by positivity
  set c : ℝ := ((2 : ℝ) ^ a)⁻¹ with hc
  have hc0 : 0 < c := by positivity
  -- the integer part
  have hsplit : ∑ k ∈ Finset.range K, (d (k + 1) : ℝ) * 2 ^ Dy.L k =
      ∑ k ∈ Finset.range j, (d (k + 1) : ℝ) * 2 ^ Dy.L k + ∑ k ∈ Finset.Ico j K, (d (k + 1) : ℝ) * 2 ^ Dy.L k :=
    (Finset.sum_range_add_sum_Ico _ (by omega)).symm
  set z : ℤ := ∑ k ∈ Finset.Ico j K, d (k + 1) * 2 ^ (Dy.L k - Dy.L j) with hz
  have hint : (∑ k ∈ Finset.Ico j K, (d (k + 1) : ℝ) * 2 ^ Dy.L k) / 2 ^ Dy.L j = (z : ℝ) := by
    rw [hz, Finset.sum_div]
    push_cast
    refine Finset.sum_congr rfl fun k hk => ?_
    have hjk := (Finset.mem_Ico.1 hk).1
    have hL : Dy.L j ≤ Dy.L k := Dy.mono.monotone hjk
    have e : (2 : ℝ) ^ Dy.L k = 2 ^ (Dy.L k - Dy.L j) * 2 ^ Dy.L j := by
      rw [← pow_add]; congr 1; omega
    rw [e, ← mul_assoc, mul_div_assoc, div_self hp.ne', mul_one]
  set w : ℝ := ((d 0 : ℝ) * ((2 : ℝ) ^ q)⁻¹ + ∑ k ∈ Finset.range j, (d (k + 1) : ℝ) * 2 ^ Dy.L k) / 2 ^ Dy.L j with hw
  have e1 : ((d 0 : ℝ) * ((2 : ℝ) ^ q)⁻¹ + ∑ k ∈ Finset.range K, (d (k + 1) : ℝ) * 2 ^ Dy.L k) / 2 ^ Dy.L j =
      w - ((-z : ℤ) : ℝ) := by
    rw [hsplit, ← add_assoc, add_div, hint, hw]; push_cast; ring
  rw [e1, dint_sub_int]
  refine (dint_le_abs _).trans ?_
  have ht0 : |(d 0 : ℝ) * ((2 : ℝ) ^ q)⁻¹| / 2 ^ Dy.L j ≤ c := by
    have h1 : (2 * (RR a q 0 : ℝ)) * ((2 : ℝ) ^ q)⁻¹ = c * 2 ^ Dy.L 0 := by
      have e : (2 : ℝ) * 2 ^ (Dy.L 0 + q - a - 1) * 2 ^ a = 2 ^ Dy.L 0 * 2 ^ q := by
        rw [← pow_succ', ← pow_add, ← pow_add]; congr 1; omega
      simp only [RR, Nat.cast_pow, Nat.cast_ofNat, hc]
      field_simp
      linear_combination e
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < ((2 : ℝ) ^ q)⁻¹), div_le_iff₀ hp]
    refine (mul_le_mul_of_nonneg_right (hdr 0) (by positivity)).trans ?_
    rw [h1]
    exact mul_le_mul_of_nonneg_left (pow_le_pow_right₀ one_le_two (Dy.mono.monotone (Nat.zero_le j))) hc0.le
  have htk : ∀ k ∈ Finset.range j, |(d (k + 1) : ℝ) * 2 ^ Dy.L k| / 2 ^ Dy.L j ≤
      c * ((2 : ℝ) ^ Dy.L (k + 1) / 2 ^ Dy.L j) := by
    intro k _
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ Dy.L k), ← mul_div_assoc]
    refine div_le_div_of_nonneg_right ?_ hp.le
    refine (mul_le_mul_of_nonneg_right (hdr (k + 1)) (by positivity)).trans ?_
    simp only [RR]
    split_ifs with h
    · have e : (2 : ℝ) * 2 ^ (gap k - a - 1) * 2 ^ Dy.L k * 2 ^ a = 2 ^ Dy.L (k + 1) := by
        rw [← pow_succ', ← pow_add, ← pow_add, ← Lv_gap_eq k]; congr 1; omega
      refine le_of_eq ?_
      simp only [Nat.cast_pow, Nat.cast_ofNat, hc]
      field_simp
      linear_combination e
    · simp only [Nat.cast_zero, mul_zero, zero_mul]
      positivity
  have h3 : |w| ≤ c + ∑ k ∈ Finset.range j, c * ((2 : ℝ) ^ Dy.L (k + 1) / 2 ^ Dy.L j) := by
    rw [hw, abs_div, abs_of_pos hp]
    refine (div_le_div_of_nonneg_right (abs_add_le _ _) hp.le).trans ?_
    rw [add_div]
    refine add_le_add ht0 ?_
    refine (div_le_div_of_nonneg_right (Finset.abs_sum_le_sum_abs _ _) hp.le).trans ?_
    rw [Finset.sum_div]
    exact Finset.sum_le_sum htk
  rw [← Finset.mul_sum] at h3
  have h4 := mul_le_mul_of_nonneg_left (sum_gap_bound j) hc0.le
  linarith

noncomputable def mm (x : ℝ) (k : ℕ) : ℤ := round (x / 2 ^ Dy.L k)

lemma mm_eventually (x : ℝ) : ∃ K : ℕ, ∀ k, K ≤ k → mm x k = 0 := by
  obtain ⟨n, hn⟩ := exists_nat_gt (2 * |x|)
  refine ⟨n, fun k hk => ?_⟩
  refine round_near _ 0 ?_
  rw [Int.cast_zero, sub_zero, abs_div, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ Dy.L k),
    div_lt_iff₀ (by positivity)]
  have h1 : k ≤ Dy.L k := Dy.mono.id_le k
  have h2 : (k : ℝ) ≤ 2 ^ Dy.L k := by
    have h3 : k ≤ 2 ^ Dy.L k := (Nat.lt_two_pow_self).le.trans (Nat.pow_le_pow_right two_pos (by omega))
    exact_mod_cast h3
  have h4 : (n : ℝ) ≤ k := by exact_mod_cast hk
  linarith

lemma mm_telescope (x : ℝ) (K : ℕ) (hK : mm x K = 0) (j : ℕ) (hj : j ≤ K) :
    ∑ k ∈ Finset.Ico j K, ((mm x k - 2 ^ gap k * mm x (k + 1) : ℤ) : ℝ) * 2 ^ Dy.L k = (mm x j : ℝ) * 2 ^ Dy.L j := by
  have h : ∀ k, ((mm x k - 2 ^ gap k * mm x (k + 1) : ℤ) : ℝ) * 2 ^ Dy.L k =
      -((mm x (k + 1) : ℝ) * 2 ^ Dy.L (k + 1) - (mm x k : ℝ) * 2 ^ Dy.L k) := by
    intro k
    rw [← Lv_gap_eq k, pow_add]
    push_cast
    ring
  rw [Finset.sum_congr rfl fun k _ => h k, Finset.sum_neg_distrib,
    Finset.sum_Ico_sub (fun k => (mm x k : ℝ) * 2 ^ Dy.L k) hj, hK]
  push_cast
  ring

lemma rep (a q : ℕ) (hq : a + 3 ≤ q) (x : ℝ) (hx : x ∈ Uset (((2 : ℝ) ^ (a + 3))⁻¹)) :
    ∃ d : ℕ →₀ ℤ, ∃ K : ℕ, (∀ k, |d k| ≤ (RR a q k : ℤ)) ∧ |x - xd q d| ≤ ((2 : ℝ) ^ q)⁻¹ / 2 ∧
      (∀ k, K ≤ k → mm x k = 0 ∧ d (k + 1) = 0) ∧
      (∀ j, j ≤ K → mm x j = ∑ k ∈ Finset.Ico j K, d (k + 1) * 2 ^ (Dy.L k - Dy.L j)) := by
  obtain ⟨K, hK⟩ := mm_eventually x
  set h : ℝ := ((2 : ℝ) ^ q)⁻¹ with hh
  have hh0 : 0 < h := by positivity
  set t : ℝ := x - (mm x 0 : ℝ) * 2 ^ Dy.L 0 with ht
  set f : ℕ → ℤ := fun n => match n with
    | 0 => round (t / h)
    | k + 1 => mm x k - 2 ^ gap k * mm x (k + 1) with hf
  have hfz : ∀ n, f n ≠ 0 → n ∈ Finset.range (K + 1) := by
    intro n hn
    cases n with
    | zero => exact Finset.mem_range.2 (Nat.succ_pos K)
    | succ k =>
      refine Finset.mem_range.2 (Nat.succ_lt_succ ?_)
      by_contra hc
      refine hn ?_
      show mm x k - 2 ^ gap k * mm x (k + 1) = 0
      rw [hK k (not_lt.1 hc), hK (k + 1) (by omega), mul_zero, sub_zero]
  set d : ℕ →₀ ℤ := Finsupp.onFinset (Finset.range (K + 1)) f hfz with hd
  have hdv : ∀ n, d n = f n := fun n => rfl
  set c : ℝ := ((2 : ℝ) ^ (a + 3))⁻¹ with hc
  have hrs : ∀ k, |x / 2 ^ Dy.L k - (mm x k : ℝ)| ≤ c := by
    intro k
    have h1 := hx k
    rw [Two.dint_eq] at h1
    exact h1
  have htc : |t| ≤ c * 2 ^ Dy.L 0 := by
    have h1 := hrs 0
    have e : x / 2 ^ Dy.L 0 - (mm x 0 : ℝ) = t / 2 ^ Dy.L 0 := by
      rw [ht]; field_simp
    rw [e, abs_div, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ Dy.L 0), div_le_iff₀ (by positivity)] at h1
    exact h1
  have hxd : xd q d = (d 0 : ℝ) * h + ∑ k ∈ Finset.range K, (d (k + 1) : ℝ) * 2 ^ Dy.L k :=
    xd_range q d K Finsupp.support_onFinset_subset
  have hsum : ∑ k ∈ Finset.range K, (d (k + 1) : ℝ) * 2 ^ Dy.L k = (mm x 0 : ℝ) * 2 ^ Dy.L 0 := by
    have h1 := mm_telescope x K (hK K le_rfl) 0 (Nat.zero_le _)
    rw [← Finset.range_eq_Ico] at h1
    exact h1
  refine ⟨d, K, ?_, ?_, ?_, ?_⟩
  · intro n
    cases n with
    | zero =>
      show |round (t / h)| ≤ ((2 ^ (Dy.L 0 + q - a - 1) : ℕ) : ℤ)
      have h1 : |t / h| ≤ 2 ^ (Dy.L 0 + q - a - 3) := by
        rw [abs_div, abs_of_pos hh0, div_le_iff₀ hh0]
        refine htc.trans (le_of_eq ?_)
        have e : (2 : ℝ) ^ Dy.L 0 * 2 ^ q = 2 ^ (Dy.L 0 + q - a - 3) * 2 ^ (a + 3) := by
          rw [← pow_add, ← pow_add]; congr 1; omega
        rw [hc, hh]
        field_simp
        linear_combination e
      have h3 : (|round (t / h)| : ℝ) ≤ 2 ^ (Dy.L 0 + q - a - 3) + 1 / 2 := by
        have h4 := abs_sub_round (t / h)
        have h5 := abs_sub_abs_le_abs_sub ((round (t / h) : ℝ)) (t / h)
        rw [abs_sub_comm] at h5
        linarith
      have h6 : (2 : ℝ) ^ (Dy.L 0 + q - a - 1) = 4 * 2 ^ (Dy.L 0 + q - a - 3) := by
        have e : (4 : ℝ) = 2 ^ 2 := by norm_num
        rw [e, ← pow_add]; congr 1; omega
      have h7 : (1 : ℝ) ≤ 2 ^ (Dy.L 0 + q - a - 3) := one_le_pow₀ one_le_two
      have h8 : (|round (t / h)| : ℝ) ≤ 2 ^ (Dy.L 0 + q - a - 1) := by rw [h6]; linarith
      exact_mod_cast h8
    | succ k =>
      show |mm x k - 2 ^ gap k * mm x (k + 1)| ≤ ((RR a q (k + 1) : ℕ) : ℤ)
      have h1 : |((mm x k - 2 ^ gap k * mm x (k + 1) : ℤ) : ℝ)| ≤ (2 ^ gap k + 1) * c := by
        have e : ((mm x k - 2 ^ gap k * mm x (k + 1) : ℤ) : ℝ) =
            2 ^ gap k * (x / 2 ^ Dy.L (k + 1) - (mm x (k + 1) : ℝ)) - (x / 2 ^ Dy.L k - (mm x k : ℝ)) := by
          have e2 : (2 : ℝ) ^ gap k * (x / 2 ^ Dy.L (k + 1)) = x / 2 ^ Dy.L k := by
            rw [← Lv_gap_eq k, pow_add]; field_simp
          rw [mul_sub, e2]
          push_cast
          ring
        rw [e]
        refine (abs_sub _ _).trans ?_
        rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ gap k), add_mul, one_mul]
        exact add_le_add (mul_le_mul_of_nonneg_left (hrs (k + 1)) (by positivity)) (hrs k)
      simp only [RR]
      split_ifs with hg
      · have h2 : ((2 : ℝ) ^ gap k + 1) * c ≤ 2 ^ (gap k - a - 1) := by
          have e : (2 : ℝ) ^ (gap k - a - 1) * 2 ^ (a + 3) = 4 * 2 ^ gap k := by
            have e2 : (4 : ℝ) = 2 ^ 2 := by norm_num
            rw [e2, ← pow_add, ← pow_add]; congr 1; omega
          have h3 : (1 : ℝ) ≤ 2 ^ gap k := one_le_pow₀ one_le_two
          rw [hc, ← div_eq_mul_inv, div_le_iff₀ (by positivity), e]
          linarith
        have := h1.trans h2
        exact_mod_cast this
      · have h2 : ((2 : ℝ) ^ gap k + 1) * c < 1 := by
          have h3 : (2 : ℝ) ^ gap k ≤ 2 ^ a := pow_le_pow_right₀ one_le_two (by omega)
          have h4 : (1 : ℝ) ≤ 2 ^ a := one_le_pow₀ one_le_two
          have e : (2 : ℝ) ^ (a + 3) = 8 * 2 ^ a := by rw [pow_add]; ring
          rw [hc, ← div_eq_mul_inv, div_lt_one (by positivity), e]
          linarith
        have h5 := lt_of_le_of_lt h1 h2
        have h6 : |mm x k - 2 ^ gap k * mm x (k + 1)| < 1 := by exact_mod_cast h5
        have := Int.abs_lt_one_iff.1 h6
        rw [this]; simp
  · rw [hxd, hsum]
    have e : x - ((d 0 : ℝ) * h + (mm x 0 : ℝ) * 2 ^ Dy.L 0) = t - (round (t / h) : ℝ) * h := by
      have e0 : d 0 = round (t / h) := rfl
      rw [e0, ht]; ring
    rw [e]
    have h1 := abs_sub_round (t / h)
    have e2 : t - (round (t / h) : ℝ) * h = (t / h - round (t / h)) * h := by
      rw [sub_mul, div_mul_cancel₀ _ hh0.ne']
    rw [e2, abs_mul, abs_of_pos hh0]
    have := mul_le_mul_of_nonneg_right h1 hh0.le
    linarith
  · intro k hk
    refine ⟨hK k hk, ?_⟩
    show mm x k - 2 ^ gap k * mm x (k + 1) = 0
    rw [hK k hk, hK (k + 1) (by omega), mul_zero, sub_zero]
  · intro j hj
    have h1 := mm_telescope x K (hK K le_rfl) j hj
    have h2 : ((∑ k ∈ Finset.Ico j K, d (k + 1) * 2 ^ (Dy.L k - Dy.L j) : ℤ) : ℝ) * 2 ^ Dy.L j =
        (mm x j : ℝ) * 2 ^ Dy.L j := by
      rw [← h1, Int.cast_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun k hk => ?_
      have hL : Dy.L j ≤ Dy.L k := Dy.mono.monotone (Finset.mem_Ico.1 hk).1
      have e : (2 : ℝ) ^ Dy.L k = 2 ^ (Dy.L k - Dy.L j) * 2 ^ Dy.L j := by
        rw [← pow_add]; congr 1; omega
      have e0 : d (k + 1) = mm x k - 2 ^ gap k * mm x (k + 1) := rfl
      rw [e0, e]
      push_cast
      ring
    have h3 := mul_right_cancel₀ (by positivity : (2 : ℝ) ^ Dy.L j ≠ 0) h2
    exact_mod_cast h3.symm

/-- `θ` with prescribed values `φ_k = Σ_{j ≤ k} 2^(L_k - L_j) θ_j`. -/
noncomputable def thetaOf (φ : ℕ → AddCircle (1 : ℝ)) : ℕ → AddCircle (1 : ℝ)
  | 0 => φ 0
  | k + 1 => φ (k + 1) - (2 ^ gap k : ℤ) • φ k

lemma thetaOf_sum (φ : ℕ → AddCircle (1 : ℝ)) (k : ℕ) :
    ∑ j ∈ Finset.range (k + 1), (2 ^ (Dy.L k - Dy.L j) : ℤ) • thetaOf φ j = φ k := by
  induction k with
  | zero => simp [thetaOf]
  | succ k ih =>
    rw [Finset.sum_range_succ, Nat.sub_self, pow_zero, one_smul]
    have h : ∀ j ∈ Finset.range (k + 1), (2 ^ (Dy.L (k + 1) - Dy.L j) : ℤ) • thetaOf φ j =
        (2 ^ gap k : ℤ) • ((2 ^ (Dy.L k - Dy.L j) : ℤ) • thetaOf φ j) := by
      intro j hj
      have hjk : Dy.L j ≤ Dy.L k := Dy.mono.monotone (Nat.lt_succ_iff.1 (Finset.mem_range.1 hj))
      have e : Dy.L (k + 1) - Dy.L j = gap k + (Dy.L k - Dy.L j) := by
        have := Lv_gap_eq k
        omega
      rw [e, pow_add, mul_smul]
    rw [Finset.sum_congr rfl h, ← Finset.smul_sum, ih]
    simp only [thetaOf]
    abel

/-- A continuous character of a subgroup is small near `0`. -/
lemma small_char {G : Type} [AddCommGroup G] [TopologicalSpace G] (N : AddSubgroup G) (ψ : N →+ LeanCheck.Circ)
    (hψ : Continuous ψ) (δ : ℝ) (hδ : 0 < δ) : ∃ M ∈ 𝓝 (0 : G), ∀ n : N, (n : G) ∈ M → ‖ψ n‖ ≤ δ := by
  have h2 : {w : LeanCheck.Circ | ‖w‖ ≤ δ} ∈ 𝓝 (0 : LeanCheck.Circ) := by
    refine Filter.mem_of_superset (Metric.ball_mem_nhds (0 : LeanCheck.Circ) hδ) fun w hw => ?_
    rw [Metric.mem_ball, dist_zero_right] at hw
    exact hw.le
  have h : {n : N | ‖ψ n‖ ≤ δ} ∈ 𝓝 (0 : N) := by
    have h1 := hψ.tendsto (0 : N)
    rw [map_zero] at h1
    exact h1 h2
  rw [nhds_subtype] at h
  obtain ⟨M, hM, hsub⟩ := mem_comap.1 h
  exact ⟨M, hM, fun n hn => hsub hn⟩

/-! ## Limits in the completion -/

theorem gamAll_le (hKR : Stab.KaltonRoberts) (γ0 : TopologicalSpace ℝ) (hs0 : Serves γ0 Adel) : gamAll ≤ γ0 := by
  classical
  haveI : Fact (0 < (1 : ℝ)) := ⟨one_pos⟩
  have hs : Serves (γ0 ⊓ gamTop dy) Adel := serves_inf _ _ _ hs0 serves_dy
  refine le_trans ?_ (inf_le_left : γ0 ⊓ gamTop dy ≤ γ0)
  set γ := γ0 ⊓ gamTop dy with hγ
  obtain ⟨hg, hfine, -, heu, htb⟩ := hs
  have hallg : @IsTopologicalAddGroup ℝ gamAll _ := isTopologicalAddGroup_iInf fun θ => (parTop_spec θ).1
  refine le_of_nhds_zero _ _ hallg hg fun W hW => ?_
  by_contra hnot
  have hne : (@nhds ℝ gamAll 0 ⊓ 𝓟 Wᶜ).NeBot := by
    refine neBot_iff.2 fun h => hnot ?_
    rw [inf_principal_eq_bot, compl_compl] at h
    exact h
  set Uf := Ultrafilter.of (@nhds ℝ gamAll 0 ⊓ 𝓟 Wᶜ) with hUf
  have hUle : (Uf : Filter ℝ) ≤ @nhds ℝ gamAll 0 := (Ultrafilter.of_le _).trans inf_le_left
  have hUW : Wᶜ ∈ Uf := (Ultrafilter.of_le (@nhds ℝ gamAll 0 ⊓ 𝓟 Wᶜ)) (mem_inf_of_right (mem_principal_self _))
  have hnle : ∀ θ, @nhds ℝ gamAll 0 ≤ @nhds ℝ (parTop θ) 0 := fun θ => nhds_mono (iInf_le _ θ)
  have haU : ∀ ε : ℝ, 0 < ε → Uset ε ∈ Uf := by
    intro ε hε
    refine hUle (hnle 0 (nhds_mono (parTop_spec 0).2.1 ?_))
    refine (mem_nhds_gam dy _).2 ⟨univ, univ_mem, ε, hε, fun x _ hx k => ?_⟩
    rw [← dy_mul]; exact hx k
  have haB : ∀ c : ℝ, ∀ η : ℝ, 0 < η → ∀ᶠ x in (Uf : Filter ℝ), dint (c * x) < η := by
    intro c η hη
    refine hUle (hnle 0 (nhds_mono ((parTop_spec 0).2.1.trans (gam_le_bohr _)) ?_))
    exact dint_mem_nhds_bohr c hη
  have haP : ∀ θ : ℕ → AddCircle (1 : ℝ), ∀ η : ℝ, 0 < η → ∀ᶠ x in (Uf : Filter ℝ), ‖Phit dy θ x‖ ≤ η := by
    intro θ η hη
    have h := (parTop_spec θ).2.2.2.2 (1 / 5) η (by norm_num) le_rfl hη
    exact (hUle (hnle θ h) : _ ∈ Uf) |> fun h' => Filter.mem_of_superset h' fun x hx => hx.2
  -- the completion
  letI : TopologicalSpace (LeanCheck.RT γ) := γ
  haveI : IsTopologicalAddGroup (LeanCheck.RT γ) := hg
  let ι : LeanCheck.RT γ →+ Completion (LeanCheck.RT γ) := Completion.toCompl
  let ι' : ℝ → Completion (LeanCheck.RT γ) := fun x => ι x
  have hι0 : ι' 0 = 0 := map_zero ι
  have hιadd : ∀ x y : ℝ, ι' (x + y) = ι' x + ι' y := fun x y => map_add ι x y
  have hιneg : ∀ x : ℝ, ι' (-x) = -ι' x := fun x => map_neg ι x
  have hιsub : ∀ x y : ℝ, ι' (x - y) = ι' x - ι' y := fun x y => map_sub ι x y
  have hcomap : Filter.comap ι' (𝓝 0) = @nhds ℝ γ 0 := by
    have h := (Completion.isUniformInducing_coe (LeanCheck.RT γ)).isInducing.nhds_eq_comap (0 : LeanCheck.RT γ)
    rw [← hι0]
    exact h.symm
  have hpre : ∀ O : Set (Completion (LeanCheck.RT γ)), O ∈ 𝓝 0 → ι' ⁻¹' O ∈ @nhds ℝ γ 0 := by
    intro O hO
    rw [← hcomap]
    exact preimage_mem_comap hO
  have hrig : ∀ W ∈ @nhds ℝ γ 0, ∃ ε : ℝ, 0 < ε ∧ ∃ F : Finset ℝ, ∀ x ∈ Uset ε, ∃ f ∈ F, x - f ∈ W := by
    intro W hW
    obtain ⟨ε, hε, F, hF⟩ := Dy.rig γ hg heu (fun a ha => htb a ha) W hW
    refine ⟨ε, hε, F, fun x hx => hF x fun k => ?_⟩
    rw [show dyseq Dy.L k * x = x / 2 ^ Dy.L k from dy_mul k x]
    exact hx k
  set N : AddSubgroup (Completion (LeanCheck.RT γ)) :=
    { carrier := ⋂ ε : ℝ, ⋂ _ : 0 < ε, closure (ι' '' Uset ε)
      zero_mem' := by
        refine mem_iInter₂.2 fun ε hε => subset_closure ⟨0, fun k => ?_, hι0⟩
        rw [zero_div, dint_zero]; exact hε.le
      add_mem' := by
        intro a b ha hb
        refine mem_iInter₂.2 fun ε hε => ?_
        have ha' := mem_iInter₂.1 ha (ε / 2) (half_pos hε)
        have hb' := mem_iInter₂.1 hb (ε / 2) (half_pos hε)
        refine map_mem_closure₂ continuous_add ha' hb' ?_
        rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
        refine ⟨x + y, fun k => ?_, hιadd x y⟩
        rw [add_div]
        have := dint_add_le' (x / 2 ^ Dy.L k) (y / 2 ^ Dy.L k)
        linarith [hx k, hy k]
      neg_mem' := by
        intro a ha
        refine mem_iInter₂.2 fun ε hε => ?_
        have ha' := mem_iInter₂.1 ha ε hε
        refine map_mem_closure continuous_neg ha' ?_
        rintro _ ⟨x, hx, rfl⟩
        refine ⟨-x, fun k => ?_, hιneg x⟩
        rw [neg_div, dint_neg']
        exact hx k } with hN
  have hNmem : ∀ z, z ∈ N ↔ ∀ ε : ℝ, 0 < ε → z ∈ closure (ι' '' Uset ε) := fun z => mem_iInter₂
  have hNclosed : IsClosed (N : Set (Completion (LeanCheck.RT γ))) :=
    isClosed_iInter fun _ => isClosed_iInter fun _ => isClosed_closure
  have hfin : ∀ O : Set (Completion (LeanCheck.RT γ)), O ∈ 𝓝 0 →
      ∃ ε : ℝ, 0 < ε ∧ ∃ F : Finset ℝ, ∀ x ∈ Uset ε, ∃ f ∈ F, ι' x - ι' f ∈ O := by
    intro O hO
    obtain ⟨ε, hε, F, hF⟩ := hrig _ (hpre O hO)
    refine ⟨ε, hε, F, fun x hx => ?_⟩
    obtain ⟨f, hf, h⟩ := hF x hx
    refine ⟨f, hf, ?_⟩
    rw [← hιsub]; exact h
  have hNcompact : IsCompact (N : Set (Completion (LeanCheck.RT γ))) := by
    refine isCompact_iff_totallyBounded_isComplete.2 ⟨?_, hNclosed.isComplete⟩
    intro V hV
    rw [uniformity_eq_comap_nhds_zero] at hV
    obtain ⟨O, hO, hOV⟩ := mem_comap.1 hV
    have hOn : -O ∈ 𝓝 (0 : Completion (LeanCheck.RT γ)) := by
      have := continuous_neg.tendsto (0 : Completion (LeanCheck.RT γ))
      rw [neg_zero] at this
      exact this hO
    obtain ⟨C, hC, hCc, hCO⟩ := exists_mem_nhds_isClosed_subset (Filter.inter_mem hO hOn)
    obtain ⟨ε, hε, F, hF⟩ := hfin C hC
    refine ⟨ι' '' F, F.finite_toSet.image _, fun z hz => ?_⟩
    have h1 : closure (ι' '' Uset ε) ⊆ ⋃ f ∈ F, (fun w => w - ι' f) ⁻¹' C := by
      refine closure_minimal ?_ (Set.Finite.isClosed_biUnion F.finite_toSet fun f _ =>
        hCc.preimage (continuous_id.sub continuous_const))
      rintro _ ⟨x, hx, rfl⟩
      obtain ⟨f, hf, h⟩ := hF x hx
      exact mem_iUnion₂.2 ⟨f, hf, h⟩
    obtain ⟨f, hf, h⟩ := mem_iUnion₂.1 (h1 ((hNmem z).1 hz ε hε))
    refine mem_iUnion₂.2 ⟨ι' f, ⟨f, hf, rfl⟩, hOV ?_⟩
    show ι' f - z ∈ O
    have h2 := (hCO h).2
    rw [Set.mem_neg, neg_sub] at h2
    exact h2
  have hlimit : ∀ Vf : Ultrafilter ℝ, (∀ ε : ℝ, 0 < ε → Uset ε ∈ Vf) →
      ∃ z ∈ N, Tendsto ι' (Vf : Filter ℝ) (𝓝 z) := by
    intro Vf hV
    have hc : Cauchy (Filter.map ι' (Vf : Filter ℝ)) := by
      refine ⟨inferInstance, ?_⟩
      rw [uniformity_eq_comap_nhds_zero]
      intro S hS
      obtain ⟨O, hO, hOS⟩ := mem_comap.1 hS
      obtain ⟨O', hO', hsub⟩ : ∃ O' ∈ 𝓝 (0 : Completion (LeanCheck.RT γ)), ∀ x ∈ O', ∀ y ∈ O', x - y ∈ O := by
        have h : Tendsto (fun p : Completion (LeanCheck.RT γ) × Completion (LeanCheck.RT γ) => p.1 - p.2)
            (𝓝 (0, 0)) (𝓝 0) := by
          exact (continuous_fst.sub continuous_snd).tendsto'
            ((0, 0) : Completion (LeanCheck.RT γ) × Completion (LeanCheck.RT γ)) 0 (sub_zero 0)
        have h2 := h hO
        rw [mem_map, nhds_prod_eq] at h2
        obtain ⟨A, hA, B, hB, hAB⟩ := mem_prod_iff.1 h2
        exact ⟨A ∩ B, Filter.inter_mem hA hB, fun x hx y hy => hAB (mk_mem_prod hx.1 hy.2)⟩
      obtain ⟨ε, hε, F, hF⟩ := hfin O' hO'
      have h1 : ∀ᶠ x in (Vf : Filter ℝ), ∃ f ∈ F, ι' x - ι' f ∈ O' :=
        Filter.mem_of_superset (hV ε hε) hF
      have h2 : ∃ f ∈ F, ∀ᶠ x in (Vf : Filter ℝ), ι' x - ι' f ∈ O' := by
        have h3 : (⋃ f ∈ (F : Set ℝ), {x | ι' x - ι' f ∈ O'}) ∈ Vf := by
          refine Filter.mem_of_superset h1 fun x hx => ?_
          obtain ⟨f, hf, h⟩ := hx
          exact mem_iUnion₂.2 ⟨f, hf, h⟩
        exact (Ultrafilter.finite_biUnion_mem_iff F.finite_toSet).1 h3
      obtain ⟨f, _, hf⟩ := h2
      refine mem_prod_iff.2 ⟨_, image_mem_map hf, _, image_mem_map hf, ?_⟩
      rintro ⟨u, v⟩ ⟨⟨x, hx, rfl⟩, ⟨y, hy, rfl⟩⟩
      refine hOS ?_
      show ι' y - ι' x ∈ O
      have := hsub _ hy _ hx
      rwa [sub_sub_sub_cancel_right] at this
    obtain ⟨z, hz⟩ := CompleteSpace.complete hc
    refine ⟨z, (hNmem z).2 fun ε hε => ?_, hz⟩
    exact mem_closure_of_tendsto hz (Filter.mem_of_superset (hV ε hε) fun x hx => mem_image_of_mem _ hx)
  obtain ⟨z, hzN, hz⟩ := hlimit Uf haU
  have hz0 : z ≠ 0 := by
    intro h
    rw [h] at hz
    have h1 : (Uf : Filter ℝ) ≤ @nhds ℝ γ 0 := by
      rw [← hcomap]
      exact tendsto_iff_comap.1 hz
    have h2 : W ∈ Uf := h1 hW
    exact (Ultrafilter.compl_mem_iff_notMem.1 hUW) h2
  -- a character of the compact group
  haveI : CompactSpace N := isCompact_iff_compactSpace.1 hNcompact
  obtain ⟨ψ, hψc, hψz⟩ := LeanCheck.exists_circ_char (K := N) ⟨z, hzN⟩ (fun h => hz0 (congrArg Subtype.val h))
  set z' : N := ⟨z, hzN⟩ with hz'
  have hψpos : 0 < ‖ψ z'‖ := norm_pos_iff.2 hψz
  set δ : ℝ := min (‖ψ z'‖ / 400) (1 / 3000) with hδ
  have hδ0 : 0 < δ := lt_min (by positivity) (by norm_num)
  have hδ1 : δ ≤ ‖ψ z'‖ / 400 := min_le_left _ _
  have hδ2 : δ ≤ 1 / 3000 := min_le_right _ _
  obtain ⟨M, hM, hMψ⟩ := small_char N ψ hψc δ hδ0
  obtain ⟨O0, hO0open, hO00, hO0neg, hO03⟩ : ∃ O0 : Set (Completion (LeanCheck.RT γ)), IsOpen O0 ∧ 0 ∈ O0 ∧
      (∀ w ∈ O0, -w ∈ O0) ∧ ∀ u ∈ O0, ∀ v ∈ O0, ∀ w ∈ O0, u + v + w ∈ M := by
    obtain ⟨V, hV, hV4⟩ := exists_nhds_zero_quarter hM
    obtain ⟨V', hV'sub, hV'open, h0V'⟩ := _root_.mem_nhds_iff.1 hV
    refine ⟨V' ∩ -V', hV'open.inter hV'open.neg, ⟨h0V', by simpa using h0V'⟩, fun w hw => ?_, ?_⟩
    · exact ⟨hw.2, by simpa using hw.1⟩
    · intro u hu v hv w hw
      have := hV4 (hV'sub hu.1) (hV'sub hv.1) (hV'sub hw.1) (hV'sub h0V')
      rwa [add_zero] at this
  have hO0n : O0 ∈ 𝓝 (0 : Completion (LeanCheck.RT γ)) := hO0open.mem_nhds hO00
  obtain ⟨ε0, hε0, hnear⟩ : ∃ ε0 : ℝ, 0 < ε0 ∧ ∀ x ∈ Uset ε0, ∃ n : N, ι' x - (n : Completion (LeanCheck.RT γ)) ∈ O0 := by
    by_contra hcon
    push Not at hcon
    set bad : Set ℝ := {x | ∀ n : N, ι' x - (n : Completion (LeanCheck.RT γ)) ∉ O0} with hbad
    have hne2 : (⨅ e : {e : ℝ // 0 < e}, 𝓟 (Uset e.1 ∩ bad)).NeBot := by
      haveI : Nonempty {e : ℝ // 0 < e} := ⟨⟨1, one_pos⟩⟩
      refine iInf_neBot_of_directed' ?_ fun e => principal_neBot_iff.2 ?_
      · intro e1 e2
        refine ⟨⟨min e1.1 e2.1, lt_min e1.2 e2.2⟩, ?_, ?_⟩
        · exact principal_mono.2 (inter_subset_inter_left _ (Uset_mono (min_le_left _ _)))
        · exact principal_mono.2 (inter_subset_inter_left _ (Uset_mono (min_le_right _ _)))
      · obtain ⟨x, hx, hxn⟩ := hcon e.1 e.2
        exact ⟨x, hx, hxn⟩
    set Vf := Ultrafilter.of (⨅ e : {e : ℝ // 0 < e}, 𝓟 (Uset e.1 ∩ bad)) with hVf
    have hVmem : ∀ e : ℝ, 0 < e → Uset e ∩ bad ∈ Vf := fun e he =>
      (Ultrafilter.of_le _) (mem_iInf_of_mem (⟨e, he⟩ : {e : ℝ // 0 < e}) (mem_principal_self _))
    obtain ⟨w, hwN, hw⟩ := hlimit Vf fun e he => Filter.mem_of_superset (hVmem e he) inter_subset_left
    have h1 : ∀ᶠ x in (Vf : Filter ℝ), ι' x - w ∈ O0 := by
      have h2 : Tendsto (fun x => ι' x - w) (Vf : Filter ℝ) (𝓝 (w - w)) := hw.sub tendsto_const_nhds
      rw [sub_self] at h2
      exact h2 hO0n
    obtain ⟨x, hx1, hx2⟩ := (h1.and (hVmem 1 one_pos)).exists
    exact hx2.2 ⟨w, hwN⟩ hx1
  obtain ⟨η, hη, hηO⟩ := ball_of_euclid (heu (hpre O0 hO0n))
  -- the nearly additive function
  set nx : ℝ → N := fun x => if ι' x ∈ O0 then 0 else
    if h : ∃ n : N, ι' x - (n : Completion (LeanCheck.RT γ)) ∈ O0 then h.choose else 0 with hnx
  have hnx1 : ∀ x ∈ Uset ε0, ι' x - (nx x : Completion (LeanCheck.RT γ)) ∈ O0 := by
    intro x hx
    simp only [hnx]
    split_ifs with h1 h2
    · simpa using h1
    · exact h2.choose_spec
    · exact absurd (hnear x hx) h2
  set Ψ : ℝ → AddCircle (1 : ℝ) := fun x => ψ (nx x) with hΨ
  have hΨ0 : ∀ x : ℝ, ι' x ∈ O0 → Ψ x = 0 := by
    intro x hx
    have : nx x = 0 := by simp only [hnx, if_pos hx]
    simp only [hΨ, this]
    exact map_zero ψ
  have hΨadd : ∀ x ∈ Uset ε0, ∀ y ∈ Uset ε0, x + y ∈ Uset ε0 → ‖Ψ (x + y) - Ψ x - Ψ y‖ ≤ δ := by
    intro x hx y hy hxy
    have h1 := hnx1 x hx
    have h2 := hnx1 y hy
    have h3 := hnx1 _ hxy
    have h4 := hMψ (nx (x + y) - nx x - nx y) (by
      have e : ((nx (x + y) - nx x - nx y : N) : Completion (LeanCheck.RT γ)) =
          -(ι' (x + y) - (nx (x + y) : Completion (LeanCheck.RT γ))) +
            (ι' x - (nx x : Completion (LeanCheck.RT γ))) + (ι' y - (nx y : Completion (LeanCheck.RT γ))) := by
        rw [hιadd]
        push_cast
        abel
      rw [e]
      exact hO03 _ (hO0neg _ h3) _ h1 _ h2)
    rw [map_sub, map_sub] at h4
    exact h4
  -- the box
  obtain ⟨a, ha⟩ : ∃ a : ℕ, ((2 : ℝ) ^ a)⁻¹ ≤ min (ε0 / 3) (1 / 20) := by
    obtain ⟨a, ha⟩ := exists_pow_lt_of_lt_one (x := min (ε0 / 3) (1 / 20)) (lt_min (by positivity) (by norm_num))
      (by norm_num : (1 / 2 : ℝ) < 1)
    rw [one_div, inv_pow] at ha
    exact ⟨a, ha.le⟩
  set c : ℝ := ((2 : ℝ) ^ a)⁻¹ with hc
  have hc0 : 0 < c := by positivity
  have hcε : 3 * c ≤ ε0 := by have := ha.trans (min_le_left _ _); linarith
  have hc20 : c ≤ 1 / 20 := ha.trans (min_le_right _ _)
  set κ : ℝ := min ((2 : ℝ) ^ Dy.L 0 * c / 2) (η / 4) with hκ
  have hκ0 : 0 < κ := lt_min (by positivity) (by positivity)
  obtain ⟨q, hq, hqh⟩ : ∃ q : ℕ, a + 3 ≤ q ∧
      ((2 : ℝ) ^ q)⁻¹ ≤ min (min (η / 4) (4 * κ * δ)) (min κ c) := by
    have hpos : 0 < min (min (η / 4) (4 * κ * δ)) (min κ c) :=
      lt_min (lt_min (by positivity) (by positivity)) (lt_min hκ0 hc0)
    obtain ⟨q0, hq0⟩ := exists_pow_lt_of_lt_one hpos (by norm_num : (1 / 2 : ℝ) < 1)
    rw [one_div, inv_pow] at hq0
    refine ⟨max q0 (a + 3), le_max_right _ _, le_trans ?_ hq0.le⟩
    exact inv_anti₀ (by positivity) (pow_le_pow_right₀ one_le_two (le_max_left _ _))
  set h : ℝ := ((2 : ℝ) ^ q)⁻¹ with hh
  have hh0 : 0 < h := by positivity
  have hhη : h ≤ η / 4 := hqh.trans ((min_le_left _ _).trans (min_le_left _ _))
  have hhκδ : h ≤ 4 * κ * δ := hqh.trans ((min_le_left _ _).trans (min_le_right _ _))
  have hhκ : h ≤ κ := hqh.trans ((min_le_right _ _).trans (min_le_left _ _))
  have hhc : h ≤ c := hqh.trans ((min_le_right _ _).trans (min_le_right _ _))
  have hbox : ∀ d : ℕ →₀ ℤ, (∀ k, |d k| ≤ 2 * (RR a q k : ℤ)) → xd q d ∈ Uset ε0 := fun d hd =>
    Uset_mono hcε (box_mem a q (by omega) d hd)
  obtain ⟨lam, hlam⟩ := Stab.inf_box hKR (RR a q) (pp a q) (RR_spec a q) (fun d => Ψ (xd q d)) δ hδ0.le
    (by linarith) (by
      intro d d' hd hd' hdd
      have e : xd q (d + d') = xd q d + xd q d' := xd_add q d d'
      have h3 : xd q (d + d') ∈ Uset ε0 := hbox _ (fun k => by rw [Finsupp.add_apply]; exact hdd k)
      show ‖Ψ (xd q (d + d')) - Ψ (xd q d) - Ψ (xd q d')‖ ≤ δ
      rw [e] at h3 ⊢
      exact hΨadd _ (hbox d hd) _ (hbox d' hd') h3)
  -- the first coefficient is a character of bounded size
  obtain ⟨l0, hl0⟩ := QuotientAddGroup.mk_surjective (lam 0)
  have hl0' : (l0 : AddCircle (1 : ℝ)) = lam 0 := hl0
  set M0 : ℕ := min (RR a q 0) ⌊η / (2 * h)⌋₊ with hM0
  have hR0h : (RR a q 0 : ℝ) * h = (2 : ℝ) ^ Dy.L 0 * c / 2 := by
    have e : (2 : ℝ) ^ (Dy.L 0 + q - a - 1) * 2 * 2 ^ a = 2 ^ Dy.L 0 * 2 ^ q := by
      rw [← pow_succ, ← pow_add, ← pow_add]; congr 1; omega
    simp only [RR, Nat.cast_pow, Nat.cast_ofNat, hh, hc]
    field_simp
    linear_combination e
  have hM0h : κ ≤ (M0 : ℝ) * h := by
    have h1 : κ ≤ (RR a q 0 : ℝ) * h := by rw [hR0h]; exact min_le_left _ _
    have h2 : κ ≤ (⌊η / (2 * h)⌋₊ : ℝ) * h := by
      have h3 := Nat.lt_floor_add_one (η / (2 * h))
      have h4 : η / (2 * h) * h = η / 2 := by field_simp
      have h5 := mul_lt_mul_of_pos_right h3 hh0
      rw [h4, add_mul, one_mul] at h5
      have h6 : κ ≤ η / 4 := min_le_right _ _
      linarith
    rw [hM0, Nat.cast_min]
    rcases le_total (RR a q 0 : ℝ) (⌊η / (2 * h)⌋₊ : ℝ) with h7 | h7
    · rwa [min_eq_left h7]
    · rwa [min_eq_right h7]
  have hM0pos : 0 < M0 := by
    have h1 : (0 : ℝ) < (M0 : ℝ) * h := lt_of_lt_of_le hκ0 hM0h
    have h2 : (0 : ℝ) < (M0 : ℝ) := pos_of_mul_pos_left h1 hh0.le
    exact_mod_cast h2
  have hmult : ∀ j : ℕ, 1 ≤ j → j ≤ M0 → dint (j * l0) ≤ 1 / 4 := by
    intro j _ hj
    set d : ℕ →₀ ℤ := Finsupp.single 0 (j : ℤ) with hd
    have hdb : ∀ k, |d k| ≤ (RR a q k : ℤ) := by
      intro k
      rw [hd, Finsupp.single_apply]
      split_ifs with hk
      · subst hk
        rw [abs_of_nonneg (by positivity)]
        exact_mod_cast hj.trans (min_le_left _ _)
      · simp
    have h1 := hlam d hdb
    have hx : xd q d = (j : ℝ) * h := by
      unfold xd
      rw [hd, Finsupp.sum_single_index (by simp)]
      simp [ee, hh]
    have hsum : d.sum (fun k z => z • lam k) = (j : ℤ) • lam 0 := by
      rw [hd]
      exact Finsupp.sum_single_index (zero_smul ℤ (lam 0))
    have hΨj : Ψ ((j : ℝ) * h) = 0 := by
      refine hΨ0 _ (hηO _ ?_)
      rw [abs_of_nonneg (by positivity)]
      have h2 : (j : ℝ) ≤ η / (2 * h) :=
        le_trans (by exact_mod_cast hj.trans (min_le_right _ _)) (Nat.floor_le (by positivity))
      have h3 := mul_le_mul_of_nonneg_right h2 hh0.le
      have h4 : η / (2 * h) * h = η / 2 := by field_simp
      linarith
    change ‖Ψ (xd q d) - d.sum (fun k z => z • lam k)‖ ≤ 188 * δ at h1
    rw [hx, hΨj, hsum, zero_sub, norm_neg, ← hl0', ← AddCircle.coe_zsmul] at h1
    have e : ((j : ℤ)) • l0 = (j : ℝ) * l0 := by rw [zsmul_eq_mul]; push_cast; ring
    rw [e] at h1
    have h5 : dint ((j : ℝ) * l0) ≤ 188 * δ := h1
    linarith
  have hl0small : dint l0 ≤ 1 / (4 * M0) := dint_le_of_multiples M0 hM0pos l0 hmult
  set β : ℝ := (l0 - round l0) / h with hβ
  have hβb : |β| ≤ 1 / (4 * κ) := by
    rw [hβ, abs_div, abs_of_pos hh0, ← Two.dint_eq, div_le_iff₀ hh0]
    refine hl0small.trans ?_
    have hM0r : (0 : ℝ) < M0 := by exact_mod_cast hM0pos
    rw [div_le_iff₀ (by positivity)]
    have e : 1 / (4 * κ) * h * (4 * (M0 : ℝ)) = (M0 : ℝ) * h / κ := by field_simp
    rw [e, le_div_iff₀ hκ0, one_mul]
    exact hM0h
  have hμ : ∀ k, ∃ μ : ℝ, (μ : AddCircle (1 : ℝ)) = lam (k + 1) := fun k => QuotientAddGroup.mk_surjective (lam (k + 1))
  choose μ hμ using hμ
  set φ : ℕ → AddCircle (1 : ℝ) := fun k => ((μ k - β * 2 ^ Dy.L k : ℝ) : AddCircle (1 : ℝ)) with hφ
  set θ := thetaOf φ with hθ
  -- a point where everything is small
  have hev : ∀ᶠ x in (Uf : Filter ℝ), x ∈ Uset (min (((2 : ℝ) ^ (a + 3))⁻¹) ε0) ∧ dint (β * x) < δ ∧
      ‖Phit dy θ x‖ ≤ δ ∧ ι' x - z ∈ O0 := by
    refine Filter.Eventually.and (haU _ (lt_min (by positivity) hε0)) ((haB β δ hδ0).and ((haP θ δ hδ0).and ?_))
    have h2 : Tendsto (fun x => ι' x - z) (Uf : Filter ℝ) (𝓝 (z - z)) := hz.sub tendsto_const_nhds
    rw [sub_self] at h2
    exact h2 hO0n
  obtain ⟨x, hxU, hxβ, hxΦ, hxz⟩ := hev.exists
  have hxε : x ∈ Uset ε0 := Uset_mono (min_le_right _ _) hxU
  obtain ⟨d, K, hdb, hds, hzero, hmm⟩ := rep a q hq x (Uset_mono (min_le_left _ _) hxU)
  set s : ℝ := x - xd q d with hs'
  have hsb : |s| ≤ h / 2 := hds
  have hsU : s ∈ Uset ε0 := by
    intro k
    refine (dint_le_abs _).trans ?_
    rw [abs_div, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ Dy.L k)]
    refine (div_le_self (abs_nonneg _) (one_le_pow₀ one_le_two)).trans ?_
    linarith
  have hΨs : Ψ s = 0 := hΨ0 _ (hηO _ (by linarith))
  have hxdU : xd q d ∈ Uset ε0 := hbox d fun k => (hdb k).trans (by omega)
  have e0 : xd q d + s = x := by rw [hs']; ring
  have h1 : ‖Ψ x - Ψ (xd q d)‖ ≤ δ := by
    have h2 := hΨadd _ hxdU _ hsU (by rw [e0]; exact hxε)
    rw [e0, hΨs, sub_zero] at h2
    exact h2
  have h2 : ‖Ψ (xd q d) - d.sum (fun k z => z • lam k)‖ ≤ 188 * δ := hlam d hdb
  -- the character is `β x + Φ_θ(x)`
  have hsup : d.support ⊆ Finset.range (K + 1) := by
    intro n hn
    refine Finset.mem_range.2 ?_
    by_contra hcn
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    exact (Finsupp.mem_support_iff.1 hn) (hzero m (by omega)).2
  have hchar : d.sum (fun k z => z • lam k) = ((β * xd q d : ℝ) : AddCircle (1 : ℝ)) + Phit dy θ x := by
    have hsum1 : d.sum (fun k z => z • lam k) = d 0 • lam 0 + ∑ k ∈ Finset.range K, d (k + 1) • lam (k + 1) := by
      rw [Finsupp.sum_of_support_subset d hsup (fun k z => z • lam k) (fun i _ => zero_smul _ _), Finset.sum_range_succ', add_comm]
    have hPhi : Phit dy θ x = ∑ k ∈ Finset.range K, d (k + 1) • φ k := by
      have hround : ∀ j, round (dy j * x) = mm x j := fun j => by rw [dy_mul]; rfl
      have e1 : Phit dy θ x = ∑ j ∈ Finset.range K, mm x j • θ j := by
        unfold Phit
        rw [finsum_eq_sum_of_support_subset _ (s := Finset.range K)]
        · exact Finset.sum_congr rfl fun j _ => by rw [hround]
        · intro j hj
          refine Finset.mem_coe.2 (Finset.mem_range.2 ?_)
          by_contra hcn
          refine hj ?_
          show round (dy j * x) • θ j = 0
          rw [hround, (hzero j (not_lt.1 hcn)).1, zero_smul]
      rw [e1]
      have e2 : ∀ j ∈ Finset.range K, mm x j • θ j =
          ∑ k ∈ Finset.Ico j K, d (k + 1) • ((2 ^ (Dy.L k - Dy.L j) : ℤ) • θ j) := by
        intro j hj
        rw [hmm j (Finset.mem_range.1 hj).le, Finset.sum_smul]
        exact Finset.sum_congr rfl fun k _ => by rw [mul_smul]
      rw [Finset.sum_congr rfl e2, Finset.range_eq_Ico, Finset.sum_Ico_Ico_comm]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [← Finset.smul_sum, ← Finset.range_eq_Ico]
      congr 1
      exact thetaOf_sum φ k
    have hβx : ((β * xd q d : ℝ) : AddCircle (1 : ℝ)) =
        d 0 • lam 0 + ∑ k ∈ Finset.range K, d (k + 1) • ((β * 2 ^ Dy.L k : ℝ) : AddCircle (1 : ℝ)) := by
      rw [xd_range q d K hsup, mul_add, AddCircle.coe_add, Finset.mul_sum]
      congr 1
      · rw [← hl0', ← AddCircle.coe_zsmul]
        have e3 : β * ((d 0 : ℝ) * ((2 : ℝ) ^ q)⁻¹) = (d 0) • l0 - ((d 0 * round l0 : ℤ) : ℝ) := by
          rw [← hh, hβ, zsmul_eq_mul]
          push_cast
          field_simp
        rw [e3, AddCircle.coe_sub]
        have e4 : (((d 0 * round l0 : ℤ) : ℝ) : AddCircle (1 : ℝ)) = 0 := by
          rw [AddCircle.coe_eq_zero_iff]
          exact ⟨d 0 * round l0, by simp⟩
        rw [e4, sub_zero]
      · have e5 := map_sum (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℝ)))
          (fun k => β * ((d (k + 1) : ℝ) * 2 ^ Dy.L k)) (Finset.range K)
        refine e5.trans (Finset.sum_congr rfl fun k _ => ?_)
        show ((β * ((d (k + 1) : ℝ) * 2 ^ Dy.L k) : ℝ) : AddCircle (1 : ℝ)) = _
        rw [← AddCircle.coe_zsmul]
        congr 1
        rw [zsmul_eq_mul]; ring
    rw [hsum1, hPhi, hβx, add_assoc, ← Finset.sum_add_distrib]
    congr 1
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [← smul_add]
    congr 1
    rw [hφ, ← hμ k, ← AddCircle.coe_add]
    congr 1
    ring
  -- conclusion
  have h3 : ‖((β * xd q d : ℝ) : AddCircle (1 : ℝ))‖ ≤ 2 * δ := by
    have e : β * xd q d = β * x - β * s := by rw [hs']; ring
    rw [e, AddCircle.coe_sub]
    refine (norm_sub_le _ _).trans ?_
    have h4 : ‖((β * x : ℝ) : AddCircle (1 : ℝ))‖ ≤ δ := le_of_lt hxβ
    have h5 : ‖((β * s : ℝ) : AddCircle (1 : ℝ))‖ ≤ δ := by
      rw [Stab.norm_coe]
      refine (round_le _ 0).trans ?_
      rw [Int.cast_zero, sub_zero, abs_mul]
      have h6 : |β| * |s| ≤ 1 / (4 * κ) * (h / 2) := mul_le_mul hβb hsb (abs_nonneg _) (by positivity)
      have h7 : 1 / (4 * κ) * (h / 2) ≤ δ := by
        rw [div_mul_eq_mul_div, one_mul, div_le_iff₀ (by positivity)]
        have : 0 < 4 * κ * δ := by positivity
