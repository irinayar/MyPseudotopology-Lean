import Mathlib
import LeanCheck.PGThreePPoint

/-!
# PGthree, Section 8: families of ultrafilters and the filter of their common members

`w j` is a family of free ultrafilters of any size and the *common members* are the sets
belonging to all of them.

* `exists_fun_of_not_pfilter` : if countably many common members have no common
  almost-subset among the common members, there is a function none of whose fibres belongs
  to any `w j` and which is finite-to-one on no common member;
* `exists_open_not_nhds` : in that case, for a rapidly growing sequence `y` of positive
  integers, the PG generated by the images of the `w j` under `y` has a set that is open for
  the topological modification, contains `0`, and is a neighbourhood of `0` in no group
  topology in which all these images converge to `0`;
* `dominating` : from free ultrafilters `v j` and a family of functions `g j` that
  dominates every function, one obtains such a family `w j`, each an injective image of
  `v j`;
* `exists_open_not_nhds_of_dominating` : the two combined;
* `common_pfilter` : if the `w j` are P-points and every family of functions indexed by `J`
  is dominated by one function, the common members form a P-filter;
* `pfilter_modification` : then openness for the topological modification of the PG
  generated by all ultrafilters containing every common member is openness for a group
  topology, and this topology is the finest group topology of the PG of the `u j`.

No set-theoretic axiom is used. A Lean proof verifies its formal statement under its
hypotheses; the correspondence with the article requires mathematical review.
-/

open Filter Set Topology

open scoped Cardinal

namespace PG

namespace Families

open PPoint

section Common

variable {J : Type*}

/-- Failure of the P-filter property gives a function with null fibres that is finite-to-one
on no common member. -/
theorem exists_fun_of_not_pfilter (w : J → Ultrafilter ℕ) (hw : ∀ j a, w j ≠ pure a)
    (B : ℕ → Set ℕ) (hB : ∀ m j, B m ∈ w j)
    (hno : ¬ ∃ C : Set ℕ, (∀ j, C ∈ w j) ∧ ∀ m, (C \ B m).Finite) :
    ∃ f : ℕ → ℕ, (∀ j m, {x | f x = m} ∉ w j) ∧
      ∀ C : Set ℕ, (∀ j, C ∈ w j) → ∃ m, {x | x ∈ C ∧ f x = m}.Infinite := by
  classical
  let f : ℕ → ℕ := fun x => if h : ∃ m, x ∉ B m then Nat.find h + 1 else x
  have hsing : ∀ j (a : ℕ), ({a} : Set ℕ) ∉ w j := fun j a =>
    Sel.notMem_of_finite (hw j) (finite_singleton a)
  refine ⟨f, fun j m hm => ?_, fun C hC => ?_⟩
  · have h1 : {x | f x = m} ⊆ {m} ∪ (B (m - 1))ᶜ := by
      intro x hx
      by_cases h : ∃ k, x ∉ B k
      · have h2 : f x = Nat.find h + 1 := dif_pos h
        have h3 : f x = m := hx
        have h4 : Nat.find h = m - 1 := by omega
        exact Or.inr (h4 ▸ Nat.find_spec h)
      · have h2 : f x = x := dif_neg h
        have h3 : f x = m := hx
        exact Or.inl (mem_singleton_iff.2 (by omega))
    rcases Ultrafilter.union_mem_iff.1 (Filter.mem_of_superset hm h1) with h | h
    · exact hsing j m h
    · obtain ⟨x, hx, hx'⟩ := Ultrafilter.nonempty_of_mem
        (Filter.inter_mem (f := (w j : Filter ℕ)) h (hB (m - 1) j))
      exact hx hx'
  · by_contra hfin
    refine hno ⟨C, hC, fun m => ?_⟩
    have h1 : (⋃ k ∈ Iic (m + 1), {x | x ∈ C ∧ f x = k}).Finite :=
      (finite_Iic (m + 1)).biUnion (fun k _ => by
        by_contra h
        exact hfin ⟨k, h⟩)
    refine h1.subset (fun x hx => ?_)
    have h2 : ∃ n, x ∉ B n := ⟨m, hx.2⟩
    have h3 : f x = Nat.find h2 + 1 := dif_pos h2
    have h4 : Nat.find h2 ≤ m := Nat.find_min' h2 hx.2
    exact mem_biUnion (x := f x) (mem_Iic.2 (by omega)) ⟨hx.1, rfl⟩

end Common

section Integers

variable {J : Type*} [Nonempty J] (y : ℕ → ℤ)

/-- If a function with null fibres is finite-to-one on no common member, the topological
modification has an open set containing `0` that is a neighbourhood of `0` in no group
topology in which all the images converge to `0`. -/
theorem exists_open_not_nhds (w : J → Ultrafilter ℕ) (hw : ∀ j a, w j ≠ pure a)
    (f : ℕ → ℕ) (hfib : ∀ j m, {x | f x = m} ∉ w j)
    (hinf : ∀ C : Set ℕ, (∀ j, C ∈ w j) → ∃ m, {x | x ∈ C ∧ f x = m}.Infinite)
    (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l) :
    ∃ O : Set ℤ, (0 : ℤ) ∈ O ∧
      IsOpenMod (genFam (Sel.ultraGen (range fun j => (w j).map y))) O ∧
      ∀ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ →
        (∀ j, ((w j).map y : Filter ℤ) ≤ @nhds ℤ t 0) → O ∉ @nhds ℤ t 0 := by
  classical
  obtain ⟨β, hβ, hβinf, hwt⟩ := Sparse.exists_weight y hpos hgrow
  have hbigf : ∀ j N, {n | N < f n} ∈ w j := by
    intro j N
    have h1 : ∀ m, {x | f x = m}ᶜ ∈ w j := fun m => by
      rcases (w j).mem_or_compl_mem {x | f x = m} with h | h
      · exact absurd h (hfib j m)
      · exact h
    have h2 : (⋂ m ∈ Finset.range (N + 1), {x | f x = m}ᶜ) ∈ (w j : Filter ℕ) :=
      (Filter.biInter_finset_mem _).2 (fun m _ => h1 m)
    refine Filter.mem_of_superset h2 (fun n hn => ?_)
    by_contra hc
    have h3 : ¬ N < f n := hc
    exact mem_iInter₂.1 hn (f n) (Finset.mem_range.2 (by omega)) rfl
  have hbig : ∀ j N, {n : ℕ | N < n} ∈ w j := by
    intro j N
    rcases (w j).mem_or_compl_mem {n : ℕ | N < n} with h | h
    · exact h
    · refine absurd h (Sel.notMem_of_finite (hw j) ((finite_Iic N).subset (fun n hn => ?_)))
      have : ¬ N < n := hn
      exact mem_Iic.2 (by omega)
  have hbigβ : ∀ j k, {n : ℕ | k ≤ β n} ∈ w j := by
    intro j k
    obtain ⟨m, hm⟩ := hβinf k
    exact Filter.mem_of_superset (hbig j m) (fun n hn => hm.trans (hβ (le_of_lt hn)))
  -- the open set
  let Good : (ℕ →₀ ℤ) → Prop := fun c => ∀ a ∈ c.support,
    (∀ b ∈ c.support, f a < f b ∨ (f a = f b ∧ a ≤ b)) →
      ∑ b ∈ c.support.filter (fun b => f b ≤ a), |c b| ≤ (f a : ℤ) + 1
  set O : Set ℤ := {z | ∃ c : ℕ →₀ ℤ, (∀ l, |c l| ≤ (β l : ℤ)) ∧ Good c ∧ Sparse.val y c = z} with hO
  have h0O : (0 : ℤ) ∈ O := ⟨0, fun l => by simp, fun a ha => by simp at ha, Sparse.val_zero y⟩
  refine ⟨O, h0O, ?_, fun t ht hut hOn => ?_⟩
  · intro x hx F hne hconv
    obtain ⟨c, hc, hgood, hcx⟩ := hx
    rw [Filter.mem_iff_ultrafilter]
    intro U hU
    set V : Ultrafilter ℤ := U.map (fun z => z - x) with hV
    have hVle : (V : Filter ℤ) ≤ Filter.map (fun z => z - x) F := by
      rw [hV, Ultrafilter.coe_map]; exact Filter.map_mono hU
    obtain ⟨σ, hσ, hVσ⟩ := hconv.2 V hVle
    obtain ⟨ι, _, v, ε, hv, hε, hrep⟩ := Sel.rep_of_sumClosure _ hσ
    set k := Fintype.card ι with hk
    set Mx := c.support.sup (fun l => max l (f l)) with hMx
    set B : Set ℕ := {n | Mx < f n} ∩ {n | Mx < n} ∩ {n | k ≤ β n} ∩ {n | k < f n} with hB
    have hBw : ∀ j, B ∈ w j := fun j =>
      Filter.inter_mem (Filter.inter_mem (Filter.inter_mem (hbigf j Mx) (hbig j Mx)) (hbigβ j k)) (hbigf j k)
    have hs : {z : ℤ | x + z ∈ O} ∈ σ := by
      have hA : ∀ i, y '' B ∈ v i := by
        intro i
        obtain ⟨j, h1⟩ := hv i
        rw [← h1]
        show y ⁻¹' (y '' B) ∈ w j
        exact Filter.mem_of_superset (hBw j) (subset_preimage_image y B)
      refine Filter.mem_of_superset (hrep (fun _ => y '' B) hA) ?_
      rintro z ⟨a, ha, rfl⟩
      choose n hn hna using ha
      set d : ℕ →₀ ℤ := ∑ i, Finsupp.single (n i) (ε i) with hd
      have hdval : Sparse.val y d = ∑ i, ε i • a i := by
        rw [hd, Sparse.val_finset_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        unfold Sparse.val
        rw [Finsupp.sum_single_index (zero_mul _), ← hna i, smul_eq_mul]
      have hdsupp : ∀ l ∈ d.support, l ∈ B := by
        intro l hl
        by_contra hlB
        apply Finsupp.mem_support_iff.1 hl
        rw [hd, Finsupp.finsetSum_apply]
        refine Finset.sum_eq_zero (fun i _ => ?_)
        exact Finsupp.single_eq_of_ne (fun h => hlB (h ▸ hn i))
      have hdsum : ∑ l ∈ d.support, |d l| ≤ (k : ℤ) := by
        have h1 : ∀ l ∈ d.support, |d l| ≤ ∑ i, |Finsupp.single (n i) (ε i) l| := by
          intro l _
          rw [hd, Finsupp.finsetSum_apply]
          exact Finset.abs_sum_le_sum_abs _ _
        refine (Finset.sum_le_sum h1).trans ?_
        rw [Finset.sum_comm]
        have h2 : ∀ i ∈ Finset.univ, ∑ l ∈ d.support, |Finsupp.single (n i) (ε i) l| ≤ 1 := by
          intro i _
          have h3 : ∀ l, |Finsupp.single (n i) (ε i) l| = if n i = l then 1 else 0 := by
            intro l
            rw [Finsupp.single_apply]
            split_ifs
            · rcases hε i with h | h <;> rw [h] <;> simp
            · simp
          simp only [h3]
          rw [Finset.sum_ite_eq]
          split_ifs <;> simp
        refine (Finset.sum_le_sum h2).trans ?_
        simp [hk]
      have hdk : ∀ l, |d l| ≤ (k : ℤ) := by
        intro l
        by_cases hl : l ∈ d.support
        · exact (Finset.single_le_sum (f := fun l => |d l|) (fun _ _ => abs_nonneg _) hl).trans hdsum
        · rw [Finsupp.notMem_support_iff.1 hl]; simp
      have hcM : ∀ l ∈ c.support, l ≤ Mx ∧ f l ≤ Mx := by
        intro l hl
        have h1 : max l (f l) ≤ Mx := Finset.le_sup (f := fun l => max l (f l)) hl
        exact ⟨(le_max_left _ _).trans h1, (le_max_right _ _).trans h1⟩
      have hdisj : Disjoint c.support d.support := by
        rw [Finset.disjoint_left]
        intro l hlc hld
        have h1 : Mx < l := (hdsupp l hld).1.1.2
        have h2 := (hcM l hlc).1
        omega
      have hsupp : (c + d).support = c.support ∪ d.support := Finsupp.support_add_eq hdisj
      have hcd_c : ∀ l ∈ c.support, (c + d) l = c l := by
        intro l hl
        rw [Finsupp.add_apply, Finsupp.notMem_support_iff.1 (Finset.disjoint_left.1 hdisj hl), add_zero]
      have hcd_d : ∀ l ∈ d.support, (c + d) l = d l := by
        intro l hl
        rw [Finsupp.add_apply, Finsupp.notMem_support_iff.1 (Finset.disjoint_right.1 hdisj hl), zero_add]
      refine ⟨c + d, fun l => ?_, ?_, ?_⟩
      · by_cases hl : l ∈ d.support
        · rw [hcd_d l hl]
          have h1 : k ≤ β l := (hdsupp l hl).1.2
          exact (hdk l).trans (by exact_mod_cast h1)
        · rw [Finsupp.add_apply, Finsupp.notMem_support_iff.1 hl, add_zero]
          exact hc l
      · intro a haS hfirst
        by_cases hce : c.support.Nonempty
        · -- the first index belongs to `c`
          have hac : a ∈ c.support := by
            rw [hsupp, Finset.mem_union] at haS
            rcases haS with h | h
            · exact h
            · obtain ⟨b0, hb0⟩ := hce
              have h1 := hfirst b0 (by rw [hsupp]; exact Finset.mem_union_left _ hb0)
              have h2 : Mx < f a := (hdsupp a h).1.1.1
              have h3 := (hcM b0 hb0).2
              omega
          have hfirstc : ∀ b ∈ c.support, f a < f b ∨ (f a = f b ∧ a ≤ b) :=
            fun b hb => hfirst b (by rw [hsupp]; exact Finset.mem_union_left _ hb)
          have hfilter : (c + d).support.filter (fun b => f b ≤ a) = c.support.filter (fun b => f b ≤ a) := by
            ext b
            rw [Finset.mem_filter, Finset.mem_filter, hsupp, Finset.mem_union]
            refine ⟨fun ⟨h, hb⟩ => ⟨h.resolve_right (fun hbd => ?_), hb⟩, fun ⟨h, hb⟩ => ⟨Or.inl h, hb⟩⟩
            have h2 : Mx < f b := (hdsupp b hbd).1.1.1
            have h3 := (hcM a hac).1
            omega
          rw [hfilter]
          refine le_trans (le_of_eq (Finset.sum_congr rfl (fun b hb => ?_))) (hgood a hac hfirstc)
          rw [hcd_c b (Finset.mem_filter.1 hb).1]
        · have hc0 : c = 0 := by
            rw [Finset.not_nonempty_iff_eq_empty] at hce
            exact Finsupp.support_eq_empty.1 hce
          rw [hc0, zero_add] at haS ⊢
          have h1 : k < f a := (hdsupp a haS).2
          have h2 : ∑ b ∈ d.support.filter (fun b => f b ≤ a), |d b| ≤ ∑ b ∈ d.support, |d b| :=
            Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _) (fun _ _ _ => abs_nonneg _)
          have h3 : (k : ℤ) < (f a : ℤ) := by exact_mod_cast h1
          omega
      · rw [Sparse.val_add, hcx, hdval]
    have h1 : {z : ℤ | x + z ∈ O} ∈ V := hVσ hs
    have h2 : (fun z => z - x) ⁻¹' {z : ℤ | x + z ∈ O} ∈ U := h1
    refine Filter.mem_of_superset h2 (fun z hz => ?_)
    have h3 : x + (z - x) ∈ O := hz
    rwa [add_sub_cancel] at h3
  · letI := t
    haveI := ht
    have halve : ∀ N : Set ℤ, N ∈ 𝓝 (0 : ℤ) → ∃ H ∈ 𝓝 (0 : ℤ), ∀ a ∈ H, ∀ b ∈ H, a + b ∈ N := by
      intro N hN
      obtain ⟨H, hH, h⟩ := (nhds_zero_isNbhdFilter (G := ℤ)).halve N hN
      exact ⟨H, hH, h⟩
    choose half hhalf hadd using halve
    let W : ℕ → {N : Set ℤ // N ∈ 𝓝 (0 : ℤ)} := fun n =>
      Nat.rec ⟨O, hOn⟩ (fun _ N => ⟨half N.1 N.2, hhalf N.1 N.2⟩) n
    have hWadd : ∀ n, ∀ a ∈ (W (n + 1)).1, ∀ b ∈ (W (n + 1)).1, a + b ∈ (W n).1 :=
      fun n => hadd (W n).1 (W n).2
    have h0W : ∀ n, (0 : ℤ) ∈ (W n).1 := fun n => mem_of_mem_nhds (W n).2
    have hWsum : ∀ (n m : ℕ) (z : ℕ → ℤ), (∀ i < n, z i ∈ (W (m + i + 1)).1) →
        ∑ i ∈ Finset.range n, z i ∈ (W m).1 := by
      intro n
      induction n with
      | zero => intro m z _; simpa using h0W m
      | succ n ih =>
        intro m z hz
        rw [Finset.sum_range_succ', add_comm]
        refine hWadd m _ (hz 0 (Nat.succ_pos _)) _ (ih (m + 1) (fun i => z (i + 1)) (fun i hi => ?_))
        have := hz (i + 1) (Nat.succ_lt_succ hi)
        rwa [show m + 1 + i + 1 = m + (i + 1) + 1 by omega]
    let A : ℕ → Set ℕ := fun i => {n | y n ∈ (W (i + 1)).1} ∩ {n | 1 ≤ β n}
    have hA : ∀ i j, A i ∈ w j := by
      intro i j
      have h1 : (W (i + 1)).1 ∈ (w j).map y := hut j (W (i + 1)).2
      exact Filter.inter_mem h1 (hbigβ j 1)
    obtain ⟨m0, hm0⟩ := hinf (A 0) (hA 0)
    obtain ⟨j0⟩ := ‹Nonempty J›
    have hpick : ∀ i N, ∃ n, n ∈ A i ∧ m0 < f n ∧ N < n := by
      intro i N
      obtain ⟨n, ⟨hn1, hn2⟩, hn3⟩ := Ultrafilter.nonempty_of_mem
        (Filter.inter_mem (f := (w j0 : Filter ℕ)) (Filter.inter_mem (hA i j0) (hbigf j0 m0)) (hbig j0 N))
      exact ⟨n, hn1, hn2, hn3⟩
    choose pick hpickA hpickf hpickgt using hpick
    let q : ℕ → ℕ := fun i => Nat.rec (pick 1 0) (fun i prev => pick (i + 2) prev) i
    have hqA : ∀ i, q i ∈ A (i + 1) := by
      intro i
      cases i with
      | zero => exact hpickA 1 0
      | succ i => exact hpickA (i + 2) (q i)
    have hqf : ∀ i, m0 < f (q i) := by
      intro i
      cases i with
      | zero => exact hpickf 1 0
      | succ i => exact hpickf (i + 2) (q i)
    have hqmono : StrictMono q := strictMono_nat_of_lt_succ (fun i => hpickgt (i + 2) (q i))
    set I := (Finset.range (m0 + 1)).image q with hI
    set Mq := I.sup (fun n => max n (f n)) with hMq
    obtain ⟨a, ⟨haA, haf⟩, hagt⟩ := hm0.exists_gt (max Mq (max m0 (q m0)))
    have haI : a ∉ I := by
      intro h
      have h1 : max a (f a) ≤ Mq := Finset.le_sup (f := fun n => max n (f n)) h
      omega
    set S := insert a I with hS
    have hIcard : I.card = m0 + 1 := by
      rw [hI, Finset.card_image_of_injective _ hqmono.injective, Finset.card_range]
    have hScard : S.card = m0 + 2 := by
      rw [hS, Finset.card_insert_of_notMem haI, hIcard]
    have hIf : ∀ n ∈ I, m0 < f n ∧ f n ≤ a ∧ 1 ≤ β n := by
      intro n hn
      obtain ⟨i, _, rfl⟩ := Finset.mem_image.1 hn
      have h1 : max (q i) (f (q i)) ≤ Mq := Finset.le_sup (f := fun n => max n (f n)) hn
      exact ⟨hqf i, by omega, (hqA i).2⟩
    have haβ : 1 ≤ β a := haA.2
    set c : ℕ →₀ ℤ := Sparse.ind S with hc
    have hcapp : ∀ l, c l = if l ∈ S then 1 else 0 := fun l => Sparse.ind_apply S l
    have hcsupp : c.support = S := by
      ext l
      rw [Finsupp.mem_support_iff, hcapp]
      split_ifs with h <;> simp [h]
    have hcbound : ∀ l, |c l| ≤ (β l : ℤ) := by
      intro l
      rw [hcapp]
      split_ifs with h
      · have h1 : 1 ≤ β l := by
          rcases Finset.mem_insert.1 h with h' | h'
          · rw [h']; exact haβ
          · exact (hIf l h').2.2
        rw [abs_one]; exact_mod_cast h1
      · simp
    have hmem : Sparse.val y c ∈ O := by
      have hz : Sparse.val y c = ∑ i ∈ Finset.range (m0 + 2), (fun i => Nat.casesOn i (y a) (fun i => y (q i))) i := by
        rw [hc, Sparse.val_ind, hS, Finset.sum_insert haI, Finset.sum_range_succ', add_comm (∑ _ ∈ _, _),
          hI, Finset.sum_image (fun _ _ _ _ h => hqmono.injective h)]
        rfl
      rw [hz]
      refine hWsum (m0 + 2) 0 _ (fun i hi => ?_)
      rw [Nat.zero_add]
      cases i with
      | zero => exact haA.1
      | succ i => exact (hqA i).1
    obtain ⟨c', hc', hgood', hval⟩ := hmem
    have hcc : c' = c := Sparse.val_inj hpos hβ hwt c' c hc' hcbound hval
    rw [hcc] at hgood'
    have haS : a ∈ c.support := by rw [hcsupp]; exact Finset.mem_insert_self _ _
    have hfirst : ∀ b ∈ c.support, f a < f b ∨ (f a = f b ∧ a ≤ b) := by
      intro b hb
      rw [hcsupp] at hb
      rcases Finset.mem_insert.1 hb with h | h
      · exact Or.inr ⟨by rw [h], by rw [h]⟩
      · exact Or.inl (haf ▸ (hIf b h).1)
    have h1 := hgood' a haS hfirst
    have hfilter : c.support.filter (fun b => f b ≤ a) = S := by
      rw [hcsupp, Finset.filter_eq_self]
      intro b hb
      rcases Finset.mem_insert.1 hb with h | h
      · rw [h, haf]; omega
      · exact (hIf b h).2.1
    rw [hfilter, haf] at h1
    have h2 : ∑ b ∈ S, |c b| = ((m0 + 2 : ℕ) : ℤ) := by
      have h3 : ∀ b ∈ S, |c b| = 1 := fun b hb => by rw [hcapp, if_pos hb, abs_one]
      rw [Finset.sum_congr rfl h3, Finset.sum_const, hScard]
      simp
    rw [h2] at h1
    omega

/-- From a dominating family of functions: injective images of the `v j` whose common
members do not form a P-filter. -/
theorem dominating (v : J → Ultrafilter ℕ) (hv : ∀ j a, v j ≠ pure a) (g : J → ℕ → ℕ)
    (hdom : ∀ h : ℕ → ℕ, ∃ j, ∀ᶠ n in atTop, h n < g j n) :
    (∀ j, Function.Injective (fun n => Nat.pair n (g j n))) ∧
    (∀ j a, (v j).map (fun n => Nat.pair n (g j n)) ≠ pure a) ∧
    (∀ j m, {x : ℕ | (Nat.unpair x).1 = m} ∉ (v j).map (fun n => Nat.pair n (g j n))) ∧
    ∀ C : Set ℕ, (∀ j, C ∈ (v j).map (fun n => Nat.pair n (g j n))) →
      ∃ m, {x : ℕ | x ∈ C ∧ (Nat.unpair x).1 = m}.Infinite := by
  classical
  have hinj : ∀ j, Function.Injective (fun n => Nat.pair n (g j n)) := fun j a b hab =>
    (Nat.pair_eq_pair.1 hab).1
  refine ⟨hinj, fun j a h => ?_, fun j m h => ?_, fun C hC => ?_⟩
  · have h1 : ({a} : Set ℕ) ∈ (v j).map (fun n => Nat.pair n (g j n)) := by
      rw [h]; exact Ultrafilter.mem_pure.2 rfl
    rw [Ultrafilter.mem_map] at h1
    exact Sel.notMem_of_finite (hv j) ((finite_singleton a).preimage (hinj j).injOn) h1
  · rw [Ultrafilter.mem_map] at h
    refine Sel.notMem_of_finite (hv j) ((finite_singleton m).subset (fun n hn => ?_)) h
    have h2 : (Nat.unpair (Nat.pair n (g j n))).1 = m := hn
    rw [Nat.unpair_pair] at h2
    exact mem_singleton_iff.2 h2
  · by_contra hno
    have hfin : ∀ m, {x : ℕ | x ∈ C ∧ (Nat.unpair x).1 = m}.Finite := fun m => by
      by_contra h
      exact hno ⟨m, h⟩
    let h : ℕ → ℕ := fun m => (hfin m).toFinset.sup (fun x => (Nat.unpair x).2)
    obtain ⟨j, hj⟩ := hdom h
    obtain ⟨N, hN⟩ := eventually_atTop.1 hj
    have h1 := hC j
    rw [Ultrafilter.mem_map] at h1
    refine Sel.notMem_of_finite (hv j) ((finite_Iio N).subset (fun n hn => ?_)) h1
    by_contra hnN
    have h2 : h n < g j n := hN n (not_lt.1 hnN)
    have h3 : Nat.pair n (g j n) ∈ (hfin n).toFinset := by
      refine (hfin n).mem_toFinset.2 ⟨hn, ?_⟩
      rw [Nat.unpair_pair]
    have h4 : (Nat.unpair (Nat.pair n (g j n))).2 ≤ h n :=
      Finset.le_sup (f := fun x => (Nat.unpair x).2) h3
    rw [Nat.unpair_pair] at h4
    have h5 : g j n ≤ h n := h4
    omega

/-- With a dominating family indexed by `J`, there are injective images of the `v j` whose
images under `y` generate a PG whose modification is not given by a group topology. -/
theorem exists_open_not_nhds_of_dominating (v : J → Ultrafilter ℕ) (hv : ∀ j a, v j ≠ pure a)
    (g : J → ℕ → ℕ) (hdom : ∀ h : ℕ → ℕ, ∃ j, ∀ᶠ n in atTop, h n < g j n)
    (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l) :
    ∃ O : Set ℤ, (0 : ℤ) ∈ O ∧
      IsOpenMod (genFam (Sel.ultraGen
        (range fun j => ((v j).map (fun n => Nat.pair n (g j n))).map y))) O ∧
      ∀ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ →
        (∀ j, (((v j).map (fun n => Nat.pair n (g j n))).map y : Filter ℤ) ≤ @nhds ℤ t 0) →
          O ∉ @nhds ℤ t 0 := by
  obtain ⟨_, hfree, hfib, hinf⟩ := dominating v hv g hdom
  exact exists_open_not_nhds y _ hfree (fun x => (Nat.unpair x).1) hfib hinf hpos hgrow

end Integers

section Group

variable {G : Type*} [AddCommGroup G] {J : Type*}

/-- For P-points, if every family of functions indexed by `J` is dominated by one function,
the common members form a P-filter. -/
theorem common_pfilter (e : ℕ ≃ G) (u : J → Ultrafilter G) (hu : ∀ j, IsPPoint (u j))
    (hb : ∀ g : J → ℕ → ℕ, ∃ f : ℕ → ℕ, ∀ j, ∀ᶠ n in atTop, g j n ≤ f n)
    (B : ℕ → Set G) (hB : ∀ m j, B m ∈ u j) :
    ∃ A : Set G, (∀ j, A ∈ u j) ∧ ∀ m, (A \ B m).Finite := by
  classical
  let B' : ℕ → Set G := fun m => ⋂ k ∈ Finset.range (m + 1), B k
  have hB' : ∀ m j, B' m ∈ u j := fun m j =>
    (Filter.biInter_finset_mem _).2 (fun k _ => hB k j)
  have hmono : ∀ a b, a ≤ b → B' b ⊆ B' a := fun a b hab x hx => by
    refine mem_iInter₂.2 (fun k hk => mem_iInter₂.1 hx k (Finset.mem_range.2 ?_))
    have := Finset.mem_range.1 hk
    omega
  have hC : ∀ j, ∃ C ∈ u j, ∀ m, (C \ B' m).Finite := fun j =>
    (hu j).pseudoInter B' (fun m => hB' m j)
  choose C hCmem hCfin using hC
  have hfin : ∀ j m, (e ⁻¹' (C j \ B' m)).Finite := fun j m =>
    (hCfin j m).preimage e.injective.injOn
  let g : J → ℕ → ℕ := fun j m => (hfin j m).toFinset.sup id + 1
  have hg : ∀ j m x, x ∈ C j → g j m ≤ e.symm x → x ∈ B' m := by
    intro j m x hx hle
    by_contra h
    have h1 : e.symm x ∈ (hfin j m).toFinset := by
      refine (hfin j m).mem_toFinset.2 ?_
      show e (e.symm x) ∈ C j \ B' m
      rw [e.apply_symm_apply]
      exact ⟨hx, h⟩
    have h2 : e.symm x ≤ (hfin j m).toFinset.sup id := Finset.le_sup (f := id) h1
    have h3 : (hfin j m).toFinset.sup id + 1 ≤ e.symm x := hle
    omega
  obtain ⟨f, hf⟩ := hb g
  let F : ℕ → ℕ := fun n => n + f n
  let A : Set G := {x | ∀ n, F n ≤ e.symm x → x ∈ B' n}
  refine ⟨A, fun j => ?_, fun m => ?_⟩
  · obtain ⟨N, hN⟩ := eventually_atTop.1 (hf j)
    set M := (Finset.range N).sup (fun n => g j n) with hM
    have h1 : {x : G | e.symm x < M}.Finite :=
      ((finite_Iio M).image e).subset (fun x hx => ⟨e.symm x, hx, e.apply_symm_apply x⟩)
    have h2 : {x : G | e.symm x < M}ᶜ ∈ u j := by
      rcases (u j).mem_or_compl_mem {x : G | e.symm x < M} with h | h
      · exact absurd h (Sel.notMem_of_finite (hu j).1 h1)
      · exact h
    refine Filter.mem_of_superset (Filter.inter_mem (hCmem j) h2) (fun x hx n hn => ?_)
    refine hg j n x hx.1 ?_
    have h3 : M ≤ e.symm x := not_lt.1 hx.2
    by_cases hnN : N ≤ n
    · have h4 := hN n hnN
      have h5 : n + f n ≤ e.symm x := hn
      omega
    · have h4 : g j n ≤ M :=
        Finset.le_sup (f := fun n => g j n) (Finset.mem_range.2 (not_le.1 hnN))
      omega
  · have h1 : {x : G | e.symm x < F m}.Finite :=
      ((finite_Iio (F m)).image e).subset (fun x hx => ⟨e.symm x, hx, e.apply_symm_apply x⟩)
    refine h1.subset (fun x hx => ?_)
    show e.symm x < F m
    by_contra h
    have h2 : x ∈ B' m := hx.1 m (not_lt.1 h)
    exact hx.2 (mem_iInter₂.1 h2 m (Finset.mem_range.2 (Nat.lt_succ_self m)))

/-- The main step for a P-filter of common members. -/
theorem exists_Uset_subset_common (e : ℕ ≃ G) (u : J → Ultrafilter G)
    (hfree : ∀ j a, u j ≠ pure a)
    (hP : ∀ B : ℕ → Set G, (∀ m j, B m ∈ u j) → ∃ A : Set G, (∀ j, A ∈ u j) ∧ ∀ m, (A \ B m).Finite)
    (hc : ¬ ∃ J0 : (ℕ → Bool) → J, Function.Injective J0)
    (O : Set G) (h0 : (0 : G) ∈ O)
    (hop : ∀ x ∈ O, ∀ k : ℕ, ∃ S : Set G, (∀ j, S ∈ u j) ∧
      ∀ T : Finset ℕ, T.card ≤ k → ∀ a : ℕ → G, (∀ i ∈ T, a i ∈ S ∨ -a i ∈ S) → x + ∑ i ∈ T, a i ∈ O) :
    ∃ A : ℕ → Set G, (∀ i j, A i ∈ u j) ∧ Uset A ⊆ O := by
  classical
  let X : ℕ → Finset G := fun n =>
    (Fintype.piFinset (fun _ : Fin (n + 1) => Finset.Icc (-((n : ℤ) + 2)) ((n : ℤ) + 2))).image
      (fun c => ∑ i : Fin (n + 1), c i • e i)
  have hX : ∀ (n : ℕ) (c : ℕ → ℤ), (∀ y, |c y| ≤ (n : ℤ) + 2) →
      ∑ y ∈ Finset.range (n + 1), c y • e y ∈ X n := by
    intro n c hc
    refine Finset.mem_image.2 ⟨fun i : Fin (n + 1) => c i, ?_, ?_⟩
    · rw [Fintype.mem_piFinset]
      intro i
      rw [Finset.mem_Icc]
      exact abs_le.1 (hc _)
    · exact Fin.sum_univ_eq_sum_range (fun y => c y • e y) (n + 1)
  have hSg : ∀ n, ∃ S : Set G, (∀ j, S ∈ u j) ∧ ∀ x ∈ X n, x ∈ O →
      ∀ T : Finset ℕ, T.card ≤ n + 2 → ∀ a : ℕ → G, (∀ i ∈ T, a i ∈ S ∨ -a i ∈ S) → x + ∑ i ∈ T, a i ∈ O := by
    intro n
    have h1 : ∀ x : G, ∃ S : Set G, (∀ j, S ∈ u j) ∧ (x ∈ O →
        ∀ T : Finset ℕ, T.card ≤ n + 2 → ∀ a : ℕ → G, (∀ i ∈ T, a i ∈ S ∨ -a i ∈ S) → x + ∑ i ∈ T, a i ∈ O) := by
      intro x
      by_cases hx : x ∈ O
      · obtain ⟨S, hS, h⟩ := hop x hx (n + 2)
        exact ⟨S, hS, fun _ => h⟩
      · exact ⟨univ, fun _ => Filter.univ_mem, fun h => absurd h hx⟩
    choose S hS h using h1
    refine ⟨⋂ x ∈ X n, S x, fun j => (Filter.biInter_finset_mem (X n)).2 (fun x _ => hS x j),
      fun x hx hxO T hT a ha => h x hxO T hT a (fun i hi => ?_)⟩
    rcases ha i hi with h' | h'
    · exact Or.inl (mem_iInter₂.1 h' x hx)
    · exact Or.inr (mem_iInter₂.1 h' x hx)
  choose Sg hSgmem hSgprop using hSg
  obtain ⟨A0, hA0mem, hA0fin⟩ := hP Sg (fun m j => hSgmem m j)
  have hexc : ∀ m, (e ⁻¹' (A0 \ Sg m)).Finite := fun m => (hA0fin m).preimage e.injective.injOn
  let f : ℕ → ℕ := fun n => n + (Finset.range (n + 1)).sup (fun m => (hexc m).toFinset.sup id)
  have hfmono : Monotone f := fun a b hab =>
    Nat.add_le_add hab (Finset.sup_mono (Finset.range_mono (Nat.succ_le_succ hab)))
  have hfx : ∀ n, n ≤ f n := fun n => Nat.le_add_right _ _
  have hfin : ∀ n y, e y ∈ A0 → f n < y → e y ∈ Sg n := by
    intro n y hy hlt
    by_contra h
    have h1 : y ∈ (hexc n).toFinset := (hexc n).mem_toFinset.2 ⟨hy, h⟩
    have h2 : y ≤ (hexc n).toFinset.sup id := Finset.le_sup (f := id) h1
    have h3 : (hexc n).toFinset.sup id ≤ (Finset.range (n + 1)).sup (fun m => (hexc m).toFinset.sup id) :=
      Finset.le_sup (f := fun m => (hexc m).toFinset.sup id) (Finset.mem_range.2 (Nat.lt_succ_self n))
    have h4 : (Finset.range (n + 1)).sup (fun m => (hexc m).toFinset.sup id) ≤ f n := Nat.le_add_left _ _
    omega
  -- intervals
  let t : ℕ → ℕ := fun n => Nat.rec 0 (fun _ s => f s + 1) n
  have ht0 : t 0 = 0 := rfl
  have htsucc : ∀ m, t (m + 1) = f (t m) + 1 := fun m => rfl
  have htmono : StrictMono t := strictMono_nat_of_lt_succ (fun m => by
    rw [htsucc]; exact Nat.lt_succ_of_le (hfx _))
  have hex : ∀ x : ℕ, ∃ m : ℕ, x ≤ t m := fun x => ⟨x, htmono.id_le x⟩
  let h : ℕ → ℕ := fun x => sInf {m : ℕ | x ≤ t m}
  have hle : ∀ x, x ≤ t (h x) := fun x => Nat.sInf_mem (s := {m : ℕ | x ≤ t m}) (hex x)
  have hlt : ∀ x m, m < h x → t m < x := fun x m hm => by
    have h1 : m ∉ {m : ℕ | x ≤ t m} := Nat.notMem_of_lt_sInf hm
    exact Nat.lt_of_not_le h1
  have hfib : ∀ N, {x | h x ≤ N}.Finite := fun N => (finite_Iic (t N)).subset (fun x hx =>
    mem_Iic.2 ((hle x).trans (htmono.monotone hx)))
  -- an infinite set of intervals whose union lies in none of the ultrafilters
  have hgaps : ∃ M : Set ℕ, M.Infinite ∧ 0 ∉ M ∧ ∀ j, {x : G | h (e.symm x) ∈ M} ∉ u j := by
    let M : (ℕ → Bool) → Set ℕ := fun σ =>
      range (fun n => Encodable.encode (List.ofFn (fun i : Fin (n + 1) => σ i)) + 1)
    have hlen : ∀ (σ τ : ℕ → Bool) (n m : ℕ),
        Encodable.encode (List.ofFn (fun i : Fin (n + 1) => σ i)) + 1
          = Encodable.encode (List.ofFn (fun i : Fin (m + 1) => τ i)) + 1 →
        n = m ∧ ∀ i, i ≤ n → σ i = τ i := by
      intro σ τ n m heq
      have h1 := Encodable.encode_injective (Nat.succ_injective heq)
      have h2 : n = m := by
        have := congrArg List.length h1
        simpa using this
      subst h2
      refine ⟨rfl, fun i hi => ?_⟩
      have h3 := congrFun (List.ofFn_injective h1) ⟨i, Nat.lt_succ_of_le hi⟩
      exact h3
    have hMinf : ∀ σ, (M σ).Infinite := fun σ =>
      infinite_range_of_injective (fun a b hab => (hlen σ σ a b hab).1)
    have hMdisj : ∀ σ τ, σ ≠ τ → (M σ ∩ M τ).Finite := by
      intro σ τ hne
      obtain ⟨k, hk⟩ := Function.ne_iff.1 hne
      refine ((finite_Iio k).image (fun n =>
        Encodable.encode (List.ofFn (fun i : Fin (n + 1) => σ i)) + 1)).subset ?_
      rintro x ⟨⟨n, rfl⟩, ⟨m, hm⟩⟩
      refine ⟨n, ?_, rfl⟩
      by_contra hnk
      exact hk ((hlen σ τ n m hm.symm).2 k (not_lt.1 hnk))
    by_contra hno
    have hbad : ∀ σ, ∃ j, {x : G | h (e.symm x) ∈ M σ \ {0}} ∈ u j := by
      intro σ
      by_contra hc
      exact hno ⟨M σ \ {0}, (hMinf σ).diff (finite_singleton 0), fun h => h.2 rfl, fun j hj => hc ⟨j, hj⟩⟩
    choose J0 hJ0 using hbad
    have hinj : Function.Injective J0 := by
      intro σ τ heq
      by_contra hne
      have h1 := hJ0 σ
      have h2 := hJ0 τ
      rw [← heq] at h2
      have h3 : {x : G | h (e.symm x) ∈ M σ ∩ M τ} ∈ u (J0 σ) :=
        Filter.mem_of_superset (Filter.inter_mem h1 h2) (fun x hx => ⟨hx.1.1, hx.2.1⟩)
      have h4 : {x : G | h (e.symm x) ∈ M σ ∩ M τ}.Finite := by
        obtain ⟨N, hN⟩ := (hMdisj σ τ hne).bddAbove
        refine ((hfib N).image e).subset (fun x hx => ⟨e.symm x, hN hx, e.apply_symm_apply x⟩)
      exact Sel.notMem_of_finite (hfree (J0 σ)) h4 h3
    exact hc ⟨J0, hinj⟩
  obtain ⟨M, hMinf, hM0, hMu⟩ := hgaps
  -- block numbers
  let b : ℕ → ℕ := fun y => ((Finset.range (h y)).filter (fun m => m ∈ M)).card
  have hbbig : ∀ c, {y | b y ≤ c}.Finite := by
    intro c
    obtain ⟨F, hF, hFc⟩ := hMinf.exists_subset_card_eq (c + 1)
    obtain ⟨N, hN⟩ := F.bddAbove
    refine (hfib N).subset (fun y hy => ?_)
    have hy' : b y ≤ c := hy
    show h y ≤ N
    by_contra hlt'
    have h1 : F ⊆ (Finset.range (h y)).filter (fun m => m ∈ M) := fun m hm =>
      Finset.mem_filter.2 ⟨Finset.mem_range.2 (lt_of_le_of_lt (hN hm) (not_le.1 hlt')), hF hm⟩
    have h2 : F.card ≤ b y := Finset.card_le_card h1
    omega
  let A : ℕ → Set G := fun i => {x | h (e.symm x) ∉ M ∧ i < b (e.symm x) ∧ x ∈ A0}
  have hAmem : ∀ i j, A i ∈ u j := by
    intro i j
    have h1 : {x : G | h (e.symm x) ∈ M}ᶜ ∈ u j := by
      rcases (u j).mem_or_compl_mem {x : G | h (e.symm x) ∈ M} with h' | h'
      · exact absurd h' (hMu j)
      · exact h'
    have h2 : {x : G | b (e.symm x) ≤ i}ᶜ ∈ u j := by
      have hf : {x : G | b (e.symm x) ≤ i}.Finite :=
        ((hbbig i).image e).subset (fun x hx => ⟨e.symm x, hx, e.apply_symm_apply x⟩)
      rcases (u j).mem_or_compl_mem {x : G | b (e.symm x) ≤ i} with h' | h'
      · exact absurd h' (Sel.notMem_of_finite (hfree j) hf)
      · exact h'
    refine Filter.mem_of_superset (Filter.inter_mem (Filter.inter_mem h1 h2) (hA0mem j)) (fun x hx => ?_)
    have h3 : ¬ b (e.symm x) ≤ i := hx.1.2
    exact ⟨hx.1.1, by omega, hx.2⟩
  refine ⟨A, hAmem, ?_⟩
  -- induction over the occupied slots
  have main : ∀ (a : ℕ → G) (y : ℕ → ℕ) (s : Finset ℕ),
      (∀ i ∈ s, e (y i) ∈ A i ∧ (a i = e (y i) ∨ a i = -e (y i))) → ∑ i ∈ s, a i ∈ O := by
    intro a y s
    induction s using Finset.strongInduction with
    | H s ih =>
      intro hs
      rcases s.eq_empty_or_nonempty with hse | hne
      · rw [hse, Finset.sum_empty]; exact h0
      obtain ⟨i1, hi1, hmax⟩ := Finset.exists_max_image s (fun i => b (y i)) hne
      set r := b (y i1) with hr
      set T := s.filter (fun i => b (y i) = r) with hT
      set R := s.filter (fun i => ¬ b (y i) = r) with hR
      have hAy : ∀ i ∈ s, h (y i) ∉ M ∧ i < b (y i) ∧ e (y i) ∈ A0 := by
        intro i hi
        have h1 := (hs i hi).1
        have h2 : h (e.symm (e (y i))) ∉ M ∧ i < b (e.symm (e (y i))) ∧ e (y i) ∈ A0 := h1
        rwa [e.symm_apply_apply] at h2
      have hrpos : 0 < r := Nat.lt_of_le_of_lt (Nat.zero_le _) (hAy i1 hi1).2.1
      -- the last gap before the last block
      set Q := (Finset.range (h (y i1))).filter (fun m => m ∈ M) with hQ
      have hQcard : Q.card = r := rfl
      have hQne : Q.Nonempty := Finset.card_pos.1 (by omega)
      set γ := Q.max' hQne with hγ
      have hγmem : γ ∈ Q := Q.max'_mem hQne
      have hγM : γ ∈ M := (Finset.mem_filter.1 hγmem).2
      have hγlt : γ < h (y i1) := Finset.mem_range.1 (Finset.mem_filter.1 hγmem).1
      have hγpos : 0 < γ := Nat.pos_of_ne_zero (fun h0' => hM0 (h0' ▸ hγM))
      have hrγ : r ≤ γ := by
        have h1 : Q ⊆ Finset.Icc 1 γ := by
          intro m hm
          have h2 : m ∈ M := (Finset.mem_filter.1 hm).2
          have h3 : m ≠ 0 := fun h0' => hM0 (h0' ▸ h2)
          exact Finset.mem_Icc.2 ⟨Nat.pos_of_ne_zero h3, Q.le_max' m hm⟩
        have h4 := Finset.card_le_card h1
        rw [Nat.card_Icc] at h4
        omega
      set p := t (γ - 1) with hp
      have hγp : γ - 1 ≤ p := htmono.id_le _
      -- earlier blocks lie below `p`
      have hearly : ∀ i ∈ R, y i ≤ p ∧ i < r := by
        intro i hi
        obtain ⟨his, hine⟩ := Finset.mem_filter.1 hi
        have hbi : b (y i) < r := lt_of_le_of_ne (hmax i his) hine
        refine ⟨?_, (hAy i his).2.1.trans hbi⟩
        have hh : h (y i) ≤ γ := by
          by_contra hc
          have h1 : Q ⊆ (Finset.range (h (y i))).filter (fun m => m ∈ M) := fun m hm =>
            Finset.mem_filter.2 ⟨Finset.mem_range.2 (lt_of_le_of_lt (Q.le_max' m hm) (not_le.1 hc)),
              (Finset.mem_filter.1 hm).2⟩
          have h2 : Q.card ≤ b (y i) := Finset.card_le_card h1
          omega
        have hne' : h (y i) ≠ γ := fun heq => (hAy i his).1 (heq ▸ hγM)
        exact (hle (y i)).trans (htmono.monotone (by omega))
      -- the last block lies above `f p`
      have hlast : ∀ i ∈ T, f p < y i := by
        intro i hi
        obtain ⟨his, hbi⟩ := Finset.mem_filter.1 hi
        have hh : γ < h (y i) := by
          by_contra hc
          have h1 : (Finset.range (h (y i))).filter (fun m => m ∈ M) ⊆ Q.erase γ := by
            intro m hm
            obtain ⟨hm1, hm2⟩ := Finset.mem_filter.1 hm
            have hm3 : m < h (y i) := Finset.mem_range.1 hm1
            refine Finset.mem_erase.2 ⟨by omega, Finset.mem_filter.2 ⟨Finset.mem_range.2 (by omega), hm2⟩⟩
          have h2 : b (y i) ≤ (Q.erase γ).card := Finset.card_le_card h1
          rw [Finset.card_erase_of_mem hγmem] at h2
          omega
        have h3 : t γ < y i := hlt (y i) γ hh
        have h4 : t γ = f p + 1 := by
          have := htsucc (γ - 1)
          rwa [show γ - 1 + 1 = γ by omega] at this
        omega
      have hRsub : R ⊂ s := by
        refine Finset.filter_ssubset.2 ⟨i1, hi1, ?_⟩
        exact not_not.2 rfl
      have hxO : ∑ i ∈ R, a i ∈ O := ih R hRsub (fun i hi => hs i (Finset.mem_filter.1 hi).1)
      have hRcard : R.card ≤ r := by
        have h1 : R ⊆ Finset.range r := fun i hi => Finset.mem_range.2 (hearly i hi).2
        simpa using Finset.card_le_card h1
      have hTcard : T.card ≤ r := by
        have h1 : T ⊆ Finset.range r := by
          intro i hi
          obtain ⟨his, hbi⟩ := Finset.mem_filter.1 hi
          exact Finset.mem_range.2 (hbi ▸ (hAy i his).2.1)
        simpa using Finset.card_le_card h1
      have hxX : ∑ i ∈ R, a i ∈ X p := by
        let ε : ℕ → ℤ := fun i => if a i = e (y i) then 1 else -1
        have hε : ∀ i ∈ R, a i = ε i • e (y i) := by
          intro i hi
          show a i = (if a i = e (y i) then (1 : ℤ) else -1) • e (y i)
          split_ifs with h'
          · rw [one_zsmul]; exact h'
          · rw [neg_zsmul, one_zsmul]
            exact (hs i (Finset.mem_filter.1 hi).1).2.resolve_left h'
        let c : ℕ → ℤ := fun z => ∑ i ∈ R.filter (fun i => y i = z), ε i
        have hsum : ∑ i ∈ R, a i = ∑ z ∈ Finset.range (p + 1), c z • e z := by
          have hmaps : ∀ i ∈ R, y i ∈ Finset.range (p + 1) := fun i hi =>
            Finset.mem_range.2 (Nat.lt_succ_of_le (hearly i hi).1)
          rw [← Finset.sum_fiberwise_of_maps_to hmaps]
          refine Finset.sum_congr rfl (fun z _ => ?_)
          show _ = (∑ i ∈ R.filter (fun i => y i = z), ε i) • e z
          rw [Finset.sum_smul]
          refine Finset.sum_congr rfl (fun i hi => ?_)
          obtain ⟨hiR, hiz⟩ := Finset.mem_filter.1 hi
          rw [← hiz]
          exact hε i hiR
        rw [hsum]
        refine hX p c (fun z => ?_)
        have h1 : |c z| ≤ ((R.filter (fun i => y i = z)).card : ℤ) := by
          refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
          have h2 : ∀ i ∈ R.filter (fun i => y i = z), |ε i| ≤ 1 := by
            intro i _
            show |(if a i = e (y i) then (1 : ℤ) else -1)| ≤ 1
            split_ifs <;> simp
          refine (Finset.sum_le_sum h2).trans ?_
          simp
        have h3 : (R.filter (fun i => y i = z)).card ≤ p + 2 :=
          (Finset.card_filter_le _ _).trans (by omega)
        exact h1.trans (by exact_mod_cast h3)
      have hTS : ∀ i ∈ T, a i ∈ Sg p ∨ -a i ∈ Sg p := by
        intro i hi
        obtain ⟨his, hbi⟩ := Finset.mem_filter.1 hi
        have h1 : e (y i) ∈ Sg p := hfin p (y i) (hAy i his).2.2 (hlast i hi)
        rcases (hs i his).2 with h' | h'
        · exact Or.inl (h' ▸ h1)
        · refine Or.inr ?_
          rw [h', neg_neg]; exact h1
      have hstep := hSgprop p _ hxX hxO T (by omega) a hTS
      have hsplit : ∑ i ∈ R, a i + ∑ i ∈ T, a i = ∑ i ∈ s, a i := by
        rw [add_comm]
        exact Finset.sum_filter_add_sum_filter_not s (fun i => b (y i) = r) a
      rwa [hsplit] at hstep
  rintro z ⟨n, a, ha, rfl⟩
  have hy : ∀ i, ∃ z : ℕ, i ∈ (Finset.range n).filter (fun i => a i ≠ 0) →
      e z ∈ A i ∧ (a i = e z ∨ a i = -e z) := by
    intro i
    by_cases hi : i ∈ (Finset.range n).filter (fun i => a i ≠ 0)
    · obtain ⟨hin, hane⟩ := Finset.mem_filter.1 hi
      rcases ha i (Finset.mem_range.1 hin) with h' | h' | h'
      · exact absurd h' hane
      · refine ⟨e.symm (a i), fun _ => ?_⟩
        rw [e.apply_symm_apply]
        exact ⟨h', Or.inl rfl⟩
      · refine ⟨e.symm (-a i), fun _ => ?_⟩
        rw [e.apply_symm_apply]
        exact ⟨h', Or.inr (neg_neg _).symm⟩
    · exact ⟨0, fun h => absurd h hi⟩
  choose y hy using hy
  have h1 := main a y _ hy
  rwa [Finset.sum_filter_ne_zero] at h1

/-- Under the same domination hypothesis there is no injection of the Cantor set into `J`. -/
theorem no_injection_of_bounded
    (hb : ∀ g : J → ℕ → ℕ, ∃ f : ℕ → ℕ, ∀ j, ∀ᶠ n in atTop, g j n ≤ f n) :
    ¬ ∃ J0 : (ℕ → Bool) → J, Function.Injective J0 := by
  classical
  rintro ⟨J0, hJ0⟩
  have hcard : #(ℕ → ℕ) = #(ℕ → Bool) := by
    simp [Cardinal.mk_arrow, Cardinal.power_self_eq]
  obtain ⟨E⟩ := Cardinal.eq.1 hcard
  haveI : Nonempty (ℕ → Bool) := ⟨fun _ => false⟩
  obtain ⟨f, hf⟩ := hb (fun j => E.symm (Function.invFun J0 j))
  have h1 := hf (J0 (E (fun n => f n + 1)))
  rw [Function.leftInverse_invFun hJ0 _, E.symm_apply_apply] at h1
  obtain ⟨n, hn⟩ := h1.exists
  omega

/-- For fewer than `𝔟` P-points, stated by domination: openness for the modification of the
PG generated by all ultrafilters containing every common member is openness for a group
topology, which is the finest group topology of the PG of the `u j`. -/
theorem pfilter_modification [Nonempty J] (e : ℕ ≃ G) (u : J → Ultrafilter G)
    (hu : ∀ j, IsPPoint (u j))
    (hb : ∀ g : J → ℕ → ℕ, ∃ f : ℕ → ℕ, ∀ j, ∀ᶠ n in atTop, g j n ≤ f n) :
    ∃ t : TopologicalSpace G, @IsTopologicalAddGroup G t _ ∧
      (∀ O : Set G, IsOpen[t] O ↔
        IsOpenMod (genFam (Sel.ultraGen {v : Ultrafilter G | (v : Filter G) ≤ ⨆ j, (u j : Filter G)})) O) ∧
      (∀ S : Set G, S ∈ @nhds G t 0 ↔ ∃ A : ℕ → Set G, (∀ i j, A i ∈ u j) ∧ Uset A ⊆ S) ∧
      IsFinest (genFam (Sel.ultraGen (range u))) t := by
  classical
  set Φ : Filter G := ⨆ j, (u j : Filter G) with hΦ
  have hmemΦ : ∀ S : Set G, S ∈ Φ ↔ ∀ j, S ∈ u j := fun S => Filter.mem_iSup
  set K : Set (Ultrafilter G) := {v : Ultrafilter G | (v : Filter G) ≤ Φ} with hK
  have huK : ∀ j, u j ∈ K := fun j => le_iSup (fun j => (u j : Filter G)) j
  set C : Set (Filter G) := genFam (Sel.ultraGen K) with hC
  have hCnull : NullFamily C := genFam_nullFamily _
  set N : Filter G :=
    { sets := {S | ∃ A : ℕ → Set G, (∀ i j, A i ∈ u j) ∧ Uset A ⊆ S}
      univ_sets := ⟨fun _ => univ, fun _ _ => Filter.univ_mem, subset_univ _⟩
      sets_of_superset := by
        rintro S T ⟨A, hA, h⟩ hST
        exact ⟨A, hA, h.trans hST⟩
      inter_sets := by
        rintro S T ⟨A, hA, h⟩ ⟨B, hB, h'⟩
        exact ⟨fun i => A i ∩ B i, fun i j => Filter.inter_mem (hA i j) (hB i j),
          subset_inter ((Uset_mono (fun _ => inter_subset_left)).trans h)
            ((Uset_mono (fun _ => inter_subset_right)).trans h')⟩ } with hNdef
  have hmemN : ∀ S, S ∈ N ↔ ∃ A : ℕ → Set G, (∀ i j, A i ∈ u j) ∧ Uset A ⊆ S := fun S => Iff.rfl
  have hN : IsNbhdFilter N := by
    refine ⟨fun S hS => ?_, fun S hS => ?_, fun S hS => ?_⟩
    · obtain ⟨A, _, h⟩ := (hmemN S).1 hS
      exact h (zero_mem_Uset _)
    · obtain ⟨A, hA, h⟩ := (hmemN S).1 hS
      exact (hmemN _).2 ⟨A, hA, fun x hx => h (neg_mem_Uset _ hx)⟩
    · obtain ⟨A, hA, h⟩ := (hmemN S).1 hS
      refine ⟨Uset (fun i => A (2 * i) ∩ A (2 * i + 1)),
        (hmemN _).2 ⟨_, fun i j => Filter.inter_mem (hA _ j) (hA _ j), subset_rfl⟩,
        fun x hx y hy => h (Uset_halve A hx hy)⟩
  obtain ⟨t, ht, hnhds⟩ := exists_topology hN
  have hΦN : Φ ≤ N := by
    intro S hS
    obtain ⟨A, hA, h⟩ := (hmemN S).1 hS
    have h1 : A 0 ∈ Φ := (hmemΦ _).2 (hA 0)
    refine Filter.mem_of_superset h1 (fun x hx => h ?_)
    refine ⟨1, fun _ => x, fun i hi => ?_, by simp⟩
    rw [Nat.lt_one_iff.1 hi]
    exact Or.inr (Or.inl hx)
  have hgenne : ∀ S : Set (Ultrafilter G), ∀ F ∈ Sel.ultraGen S, F.NeBot := by
    rintro S F ⟨v, _, rfl⟩
    exact v.neBot
  have hgen : ∀ v ∈ K, (v : Filter G) ∈ C := fun v hv =>
    subset_genFam (hgenne K) ⟨v, hv, rfl⟩
  have hΦne : Φ.NeBot := by
    obtain ⟨j⟩ := ‹Nonempty J›
    exact Filter.NeBot.mono (u j).neBot (huK j)
  have hΦC : Φ ∈ C :=
    hCnull.ultra Φ hΦne (fun U hU => hgen U hU)
  have hcoarse : ∀ (D : Set (Filter G)) (t' : TopologicalSpace G), @IsTopologicalAddGroup G t' _ →
      (∀ F ∈ D, F ≤ @nhds G t' 0) → ∀ O : Set G, IsOpen[t'] O → IsOpenMod D O := by
    intro D t' ht' hF' O hO x hx F hne hconv
    letI := t'
    haveI := ht'
    have h1 : F ≤ 𝓝 x := (le_nhds_iff_map_sub F x).2 (hF' _ hconv)
    exact h1 (hO.mem_nhds hx)
  have htC : ∀ F ∈ C, F ≤ @nhds G t 0 := by
    have h1 : Sel.ultraGen K ⊆ @nullTop G t _ := by
      rintro F ⟨v, hv, rfl⟩
      refine ⟨v.neBot, ?_⟩
      rw [hnhds]; exact le_trans hv hΦN
    have h2 : C ⊆ @nullTop G t _ := by
      letI := t
      haveI := ht
      exact genFam_le nullTop_nullFamily h1
    exact fun F hF => (h2 hF).2
  have hopT : ∀ O : Set G, IsOpenMod C O → ∀ x ∈ O, ∀ k : ℕ, ∃ S : Set G, (∀ j, S ∈ u j) ∧
      ∀ T : Finset ℕ, T.card ≤ k → ∀ a : ℕ → G, (∀ i ∈ T, a i ∈ S ∨ -a i ∈ S) → x + ∑ i ∈ T, a i ∈ O := by
    intro O hO x hx k
    set F : Filter G := pure 0 ⊔ (Φ ⊔ Filter.map (fun z : G => -z) Φ) with hF
    have hFne : F.NeBot := Filter.NeBot.mono (inferInstance : (pure (0 : G) : Filter G).NeBot) le_sup_left
    have hFC : F ∈ C := by
      refine hCnull.ultra F hFne (fun U hU => ?_)
      rcases (Ultrafilter.le_sup_iff).1 hU with h | h
      · exact hCnull.finer _ hCnull.pure_zero _ h inferInstance
      · rcases (Ultrafilter.le_sup_iff).1 h with h4 | h4
        · exact hCnull.finer _ hΦC _ h4 inferInstance
        · exact hCnull.finer _ (hCnull.neg _ hΦC) _ h4 inferInstance
    let Fk : ℕ → Filter G := fun n => Nat.rec (pure 0) (fun _ H => Filter.map₂ (· + ·) H F) n
    have hFkC : ∀ n, Fk n ∈ C := by
      intro n
      induction n with
      | zero => exact hCnull.pure_zero
      | succ n ih => exact hCnull.add _ ih _ hFC
    have hkey : ∀ n, ∀ s ∈ Fk n, ∃ S ∈ F, ∀ T : Finset ℕ, T.card ≤ n → ∀ a : ℕ → G, (∀ i ∈ T, a i ∈ S) →
        ∑ i ∈ T, a i ∈ s := by
      intro n
      induction n with
      | zero =>
        intro s hs
        have h0s : (0 : G) ∈ s := Filter.mem_pure.1 hs
        refine ⟨univ, Filter.univ_mem, fun T hT a _ => ?_⟩
        rw [Finset.card_eq_zero.1 (Nat.le_zero.1 hT), Finset.sum_empty]
        exact h0s
      | succ n ih =>
        intro s hs
        obtain ⟨s1, hs1, s2, hs2, hsub⟩ := Filter.mem_map₂_iff.1 hs
        obtain ⟨S1, hS1, h1⟩ := ih s1 hs1
        refine ⟨S1 ∩ s2, Filter.inter_mem hS1 hs2, fun T hT a ha => ?_⟩
        have h0s2 : (0 : G) ∈ s2 := Filter.mem_pure.1 ((le_sup_left : pure (0 : G) ≤ F) hs2)
        rcases T.eq_empty_or_nonempty with hTe | ⟨i0, hi0⟩
        · rw [hTe, Finset.sum_empty]
          have h0s1 : (0 : G) ∈ s1 := by
            have := h1 ∅ (Nat.zero_le _) a (fun i hi => by simp at hi)
            simpa using this
          have := hsub (mem_image2_of_mem h0s1 h0s2)
          simpa using this
        · rw [← Finset.sum_erase_add T a hi0]
          refine hsub (mem_image2_of_mem (h1 _ ?_ a (fun i hi => (ha i (Finset.mem_of_mem_erase hi)).1))
            (ha i0 hi0).2)
          rw [Finset.card_erase_of_mem hi0]
          omega
    have hconv : conv C (Filter.map (fun z : G => x + z) (Fk k)) x := by
      unfold conv
      rw [Filter.map_map]
      have : ((fun y : G => y - x) ∘ fun z : G => x + z) = id := by funext z; simp
      rw [this, Filter.map_id]
      exact hFkC k
    have hFkne : (Fk k).NeBot := hCnull.ne _ (hFkC k)
    have hmem := hO x hx _ (Filter.NeBot.map hFkne _) hconv
    obtain ⟨S, hS, h⟩ := hkey k _ (Filter.mem_map.1 hmem)
    refine ⟨S ∩ (fun z : G => -z) ⁻¹' S, fun j => ?_, fun T hT a ha => h T hT a (fun i hi => ?_)⟩
    · have h1 : S ∈ Φ ⊔ Filter.map (fun z : G => -z) Φ :=
        (le_sup_right : Φ ⊔ Filter.map (fun z : G => -z) Φ ≤ F) hS
      exact Filter.inter_mem ((hmemΦ _).1 h1.1 j) ((hmemΦ _).1 h1.2 j)
    · rcases ha i hi with h' | h'
      · exact h'.1
      · have h2 : - -a i ∈ S := h'.2
        rwa [neg_neg] at h2
  have hP : ∀ B : ℕ → Set G, (∀ m j, B m ∈ u j) → ∃ A : Set G, (∀ j, A ∈ u j) ∧ ∀ m, (A \ B m).Finite :=
    common_pfilter e u hu hb
  have hopen : ∀ O : Set G, IsOpen[t] O ↔ IsOpenMod C O := by
    intro O
    refine ⟨hcoarse C t ht htC O, fun hO => ?_⟩
    letI := t
    haveI := ht
    rw [isOpen_iff_mem_nhds]
    intro x hx
    set O' : Set G := (fun a => x + a) ⁻¹' O with hO'
    have h0 : (0 : G) ∈ O' := by
      show x + 0 ∈ O
      rwa [add_zero]
    have hop' : ∀ z ∈ O', ∀ k : ℕ, ∃ S : Set G, (∀ j, S ∈ u j) ∧
        ∀ T : Finset ℕ, T.card ≤ k → ∀ a : ℕ → G, (∀ i ∈ T, a i ∈ S ∨ -a i ∈ S) → z + ∑ i ∈ T, a i ∈ O' := by
      intro z hz k
      obtain ⟨S, hS, h⟩ := hopT O hO (x + z) hz k
      refine ⟨S, hS, fun T hT a ha => ?_⟩
      show x + (z + ∑ i ∈ T, a i) ∈ O
      rw [← add_assoc]
      exact h T hT a ha
    obtain ⟨A, hA, hAO⟩ := exists_Uset_subset_common e u (fun j => (hu j).1) hP
      (no_injection_of_bounded hb) O' h0 hop'
    have h1 : O' ∈ 𝓝 (0 : G) := by
      rw [hnhds]; exact (hmemN O').2 ⟨A, hA, hAO⟩
    have h2 := (Homeomorph.addLeft x).map_nhds_eq (0 : G)
    have h3 : Filter.map (fun a => x + a) (𝓝 (0 : G)) = 𝓝 x := by simpa using h2
    rw [← h3]
    exact h1
  have htu : ∀ F ∈ genFam (Sel.ultraGen (range u)), F ≤ @nhds G t 0 := by
    have h1 : Sel.ultraGen (range u) ⊆ @nullTop G t _ := by
      rintro F ⟨v, ⟨j, rfl⟩, rfl⟩
      refine ⟨(u j).neBot, ?_⟩
      rw [hnhds]; exact le_trans (huK j) hΦN
    have h2 : genFam (Sel.ultraGen (range u)) ⊆ @nullTop G t _ := by
      letI := t
      haveI := ht
      exact genFam_le nullTop_nullFamily h1
    exact fun F hF => (h2 hF).2
  refine ⟨t, ht, hopen, fun S => ?_, ⟨⟨ht, htu⟩, fun t' ht' => ?_⟩⟩
  · rw [hnhds]; exact hmemN S
  · obtain ⟨ht'g, ht'F⟩ := ht'
    refine @Continuous.mk G G t t' id (fun O hO => ?_)
    refine (hopen O).2 (hcoarse C t' ht'g (fun F hF => ?_) O hO)
    have hΦ' : Φ ≤ @nhds G t' 0 := by
      refine iSup_le (fun j => ?_)
      exact ht'F _ (subset_genFam (hgenne (range u)) ⟨u j, mem_range_self j, rfl⟩)
    have h1 : Sel.ultraGen K ⊆ @nullTop G t' _ := by
      rintro F' ⟨v, hv, rfl⟩
      exact ⟨v.neBot, le_trans hv hΦ'⟩
    have h2 : C ⊆ @nullTop G t' _ := by
      letI := t'
      haveI := ht'g
      exact genFam_le nullTop_nullFamily h1
    exact (h2 hF).2

end Group

end Families

end PG
