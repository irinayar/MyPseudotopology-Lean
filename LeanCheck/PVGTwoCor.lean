import LeanCheck.PVGTwoKR

/-!
# PVGtwo: the base of the finest serving topology and the corollary

`δ` is the sparse sequence, `gamAll` the topology generated by the topologies `γ_{δ,θ}` (`parTop θ`).

* `parTop_hasBasis` : the sets `B ∩ Nset δ θ ε η` form a base at `0` of `γ_{δ,θ}`;
* `gamAll_hasBasis` : the base at `0` of `gamAll` stated in the theorem;
* `allserving` : (assuming Kalton–Roberts) a topology serves `A(δ)` iff it is a group topology with
  `τ_B ⊊ γ` that is contained in `gamAll`.

Order of topologies as in Mathlib: `γ₁ ≤ γ₂` means that `γ₁` is finer.
-/

open Filter Topology Set UniformSpace

namespace PVG
namespace Two
open Q95 Lac

theorem parTop_hasBasis (θ : ℕ → AddCircle (1 : ℝ)) :
    (@nhds ℝ (parTop θ) 0).HasBasis
      (fun p : Set ℝ × ℝ × ℝ => p.1 ∈ @nhds ℝ bohrTop 0 ∧ 0 < p.2.1 ∧ p.2.1 ≤ 1 / 5 ∧ 0 < p.2.2)
      (fun p => p.1 ∩ Nset dlt2 θ p.2.1 p.2.2) := by
  refine ⟨fun W => ⟨fun hW => ?_, ?_⟩⟩
  · rw [nhds_parTop] at hW
    obtain ⟨U, hU, B, hB, rfl⟩ := Filter.mem_inf_iff.1 hW
    obtain ⟨⟨ε, η⟩, ⟨hε, hε5, hη⟩, hsub⟩ := (parTau_spec θ).2.mem_iff.1 hU
    exact ⟨(B, ε, η), ⟨hB, hε, hε5, hη⟩, fun x hx => ⟨hsub hx.2, hx.1⟩⟩
  · rintro ⟨⟨B, ε, η⟩, ⟨hB, hε, hε5, hη⟩, hsub⟩
    exact Filter.mem_of_superset
      (Filter.inter_mem (nhds_mono (inf_le_right : parTop θ ≤ bohrTop) hB)
        ((parTop_spec θ).2.2.2.2 ε η hε hε5 hη)) hsub

/-- The basic neighbourhood of `0` in the theorem. -/
def baseSet (B : Set ℝ) (F : Finset (ℕ → AddCircle (1 : ℝ))) (ε η : ℝ) : Set ℝ :=
  {x | x ∈ B ∧ (∀ k, dint (dlt2 k * x) ≤ ε) ∧ ∀ θ ∈ F, ‖Phit dlt2 θ x‖ ≤ η}

lemma gamAll_nhds : @nhds ℝ gamAll 0 = ⨅ θ : ℕ → AddCircle (1 : ℝ), @nhds ℝ (parTop θ) 0 := by
  unfold gamAll
  exact nhds_iInf

lemma baseSet_mem (B : Set ℝ) (hB : B ∈ @nhds ℝ bohrTop 0) (F : Finset (ℕ → AddCircle (1 : ℝ))) (ε η : ℝ)
    (hε : 0 < ε) (hε5 : ε ≤ 1 / 5) (hη : 0 < η) : baseSet B F ε η ∈ @nhds ℝ gamAll 0 := by
  have hle : ∀ θ, @nhds ℝ gamAll 0 ≤ @nhds ℝ (parTop θ) 0 := fun θ => nhds_mono (iInf_le _ θ)
  have h0 : B ∩ Nset dlt2 0 ε η ∈ @nhds ℝ gamAll 0 :=
    hle 0 ((parTop_hasBasis 0).mem_of_mem (i := (B, ε, η)) ⟨hB, hε, hε5, hη⟩)
  have hF : (⋂ θ ∈ F, Nset dlt2 θ ε η) ∈ @nhds ℝ gamAll 0 :=
    (Filter.biInter_finset_mem F).2 fun θ _ => hle θ ((parTop_spec θ).2.2.2.2 ε η hε hε5 hη)
  refine Filter.mem_of_superset (Filter.inter_mem h0 hF) fun x hx => ?_
  refine ⟨hx.1.1, hx.1.2.1, fun θ hθ => ?_⟩
  have h := Set.mem_iInter₂.1 hx.2 θ hθ
  exact h.2

theorem gamAll_hasBasis :
    (@nhds ℝ gamAll 0).HasBasis
      (fun p : Set ℝ × Finset (ℕ → AddCircle (1 : ℝ)) × ℝ × ℝ =>
        p.1 ∈ @nhds ℝ bohrTop 0 ∧ 0 < p.2.2.1 ∧ p.2.2.1 ≤ 1 / 5 ∧ 0 < p.2.2.2)
      (fun p => baseSet p.1 p.2.1 p.2.2.1 p.2.2.2) := by
  classical
  refine ⟨fun W => ⟨fun hW => ?_, ?_⟩⟩
  swap
  · rintro ⟨⟨B, F, ε, η⟩, ⟨hB, hε, hε5, hη⟩, hsub⟩
    exact Filter.mem_of_superset (baseSet_mem B hB F ε η hε hε5 hη) hsub
  · rw [gamAll_nhds] at hW
    refine Filter.iInf_sets_induct
      (p := fun W => ∃ p : Set ℝ × Finset (ℕ → AddCircle (1 : ℝ)) × ℝ × ℝ,
        (p.1 ∈ @nhds ℝ bohrTop 0 ∧ 0 < p.2.2.1 ∧ p.2.2.1 ≤ 1 / 5 ∧ 0 < p.2.2.2) ∧
          baseSet p.1 p.2.1 p.2.2.1 p.2.2.2 ⊆ W) hW ?_ ?_
    · exact ⟨(univ, ∅, 1 / 5, 1), ⟨univ_mem, by norm_num, le_rfl, one_pos⟩, subset_univ _⟩
    · rintro θ s t hs ⟨⟨B, F, ε, η⟩, ⟨hB, hε, hε5, hη⟩, hsub⟩
      obtain ⟨⟨B', ε', η'⟩, ⟨hB', hε', _, hη'⟩, hsub'⟩ := (parTop_hasBasis θ).mem_iff.1 hs
      refine ⟨(B ∩ B', insert θ F, min ε ε', min η η'),
        ⟨Filter.inter_mem hB hB', lt_min hε hε', (min_le_left _ _).trans hε5, lt_min hη hη'⟩, ?_⟩
      rintro x ⟨hxB, hxk, hxF⟩
      refine ⟨hsub' ⟨hxB.2, ?_⟩, hsub ⟨hxB.1, ?_, ?_⟩⟩
      · exact ⟨fun k => (hxk k).trans (min_le_right _ _),
          (hxF θ (Finset.mem_insert_self _ _)).trans (min_le_right _ _)⟩
      · exact fun k => (hxk k).trans (min_le_left _ _)
      · exact fun θ' hθ' => (hxF θ' (Finset.mem_insert_of_mem hθ')).trans (min_le_left _ _)

/-- The corollary: the topologies that serve `A(δ)`. -/
theorem allserving (h : Stab.KaltonRobertsClassical) (γ : TopologicalSpace ℝ) :
    Serves γ A2 ↔ @IsTopologicalAddGroup ℝ γ _ ∧ γ ≤ bohrTop ∧ γ ≠ bohrTop ∧ gamAll ≤ γ := by
  obtain ⟨hall, hfin⟩ := finest_described_classical h
  refine ⟨fun hs => ⟨hs.1, hs.2.1, hs.2.2.1, hfin γ hs⟩, fun ⟨hg, hb, hne, hle⟩ => ?_⟩
  have hn : @nhds ℝ gamAll 0 ≤ @nhds ℝ γ 0 := nhds_mono hle
  exact ⟨hg, hb, hne, hall.2.2.2.1.trans hn, fun a ha V hV => hall.2.2.2.2 a ha V (hn hV)⟩

end Two
end PVG
