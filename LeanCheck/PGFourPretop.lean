import Mathlib
import LeanCheck.PGXi

/-!
# PGfour: neighbourhoods of the modification and the vicinity filter for an admissible pair

Setting of `PGXi`: `G` an abelian group with a Hausdorff group topology, `I` a family of sets with (I1)-(I5), and
`ξ` the pseudotopological group in which `F → x` iff `F` is proper, contains the neighbourhoods of `x` and has a member
in `I`. `Vxi I 0` is the vicinity filter at `0`, `IsOpenXi I` the topological modification, and `ξ` is pretopological
iff `xi I (Vxi I 0) 0`.

* `sparse_of_not_pretopological` : if `I` is generated by an increasing sequence, the topology has countable tightness
  at `0` and `ξ` is not pretopological, then some vicinity set contains no open set containing `0`;
* `pretopological_iff_open_base` : under the same two hypotheses, `ξ` is pretopological iff every vicinity set
  contains an open set containing `0`.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set Topology

namespace PG

variable {G : Type*} [AddCommGroup G] [TopologicalSpace G] [IsTopologicalAddGroup G] [T2Space G]

/-- In a pretopological `ξ` every vicinity set contains a set that is open for the modification and contains `0`. -/
theorem open_subset_of_pretopological {I : Set (Set G)} (hI : AdmIdeal I) (h : xi I (Vxi I 0) 0)
    {S : Set G} (hS : S ∈ Vxi I 0) : ∃ O : Set G, IsOpenXi I O ∧ (0 : G) ∈ O ∧ O ⊆ S := by
  have h0 : ∀ T ∈ Vxi I 0, (0 : G) ∈ T := fun T hT => mem_Vxi.1 hT _ (xi_pure hI 0)
  have hadd : ∀ T ∈ Vxi I 0, ∃ T' ∈ Vxi I 0, ∀ a ∈ T', ∀ b ∈ T', a + b ∈ T := by
    intro T hT
    have h2 := xi_add hI h h
    rw [add_zero] at h2
    have h3 : T ∈ Filter.map₂ (· + ·) (Vxi I 0) (Vxi I 0) := mem_Vxi.1 hT _ h2
    obtain ⟨a, ha, b, hb, hab⟩ := Filter.mem_map₂_iff.1 h3
    refine ⟨a ∩ b, Filter.inter_mem ha hb, fun x hx y hy => ?_⟩
    exact hab (Set.mem_image2_of_mem hx.1 hy.2)
  refine ⟨{x | ∃ T ∈ Vxi I 0, ∀ t ∈ T, x + t ∈ S}, ?_, ⟨S, hS, fun t ht => by simpa using ht⟩, ?_⟩
  · rintro x ⟨T, hT, hxT⟩ F hF
    obtain ⟨T', hT', hsum⟩ := hadd T hT
    have h1 : Filter.map (fun y => y - x) F ≤ Vxi I 0 := by
      intro s hs
      exact mem_Vxi.1 hs _ ((xi_iff_sub hI F x).1 hF)
    refine Filter.mem_of_superset (h1 hT') ?_
    intro y hy
    refine ⟨T', hT', fun t ht => ?_⟩
    have := hxT _ (hsum _ hy t ht)
    have e : x + (y - x + t) = y + t := by abel
    rwa [e] at this
  · rintro x ⟨T, hT, hxT⟩
    simpa using hxT 0 (h0 T hT)

/-- If `I` is generated by an increasing sequence of its members, the topology has countable tightness at `0` and
`ξ` is not pretopological, then some vicinity set contains no open set that contains `0`. -/
theorem sparse_of_not_pretopological {I : Set (Set G)} (hI : AdmIdeal I) (A : ℕ → Set G)
    (hA : ∀ n, A n ∈ I) (hmono : Monotone A) (hcof : ∀ B ∈ I, ∃ n, B ⊆ A n)
    (htight : ∀ B : Set G, (0 : G) ∈ closure B → ∃ C ⊆ B, C.Countable ∧ (0 : G) ∈ closure C)
    (hnp : ¬ xi I (Vxi I 0) 0) :
    ∃ S ∈ Vxi I 0, ∀ O : Set G, IsOpenXi I O → (0 : G) ∈ O → ¬ O ⊆ S := by
  have crit : ∀ A0 ∈ I, ∃ B ∈ I, (0 : G) ∈ closure (B \ A0) := by
    intro A0 hA0
    by_contra hc
    refine hnp ((pretopological_zero_iff hI).2 ⟨A0, hA0, fun B hB h0 => hc ⟨B, hB, h0⟩⟩)
  obtain ⟨B, hB, hB0⟩ := crit {0} (hI.single 0)
  obtain ⟨C, hCsub, hCc, hC0⟩ := htight _ hB0
  have hCne : C.Nonempty := by
    rcases C.eq_empty_or_nonempty with h | h
    · rw [h, closure_empty] at hC0
      exact absurd hC0 (Set.notMem_empty _)
    · exact h
  obtain ⟨x, hx⟩ := hCc.exists_eq_range hCne
  have hxC : ∀ n, x n ∈ C := fun n => by rw [hx]; exact Set.mem_range_self n
  have hx0 : ∀ n, x n ≠ 0 := fun n => by simpa using (hCsub (hxC n)).2
  -- the sets `A n - x n`
  have hshift : ∀ n, (fun a => a - x n) '' A n ∈ I := by
    intro n
    refine hI.sub _ (hI.add (A n) (hA n) {-x n} (hI.single _)) _ ?_
    rintro _ ⟨a, ha, rfl⟩
    exact ⟨a, ha, -x n, rfl, (sub_eq_add_neg a (x n)).symm⟩
  choose Bn hBn hBn0 using fun n => crit _ (hshift n)
  have hUex : ∀ n, ∃ U ∈ 𝓝 (0 : G), IsClosed U ∧ -x n ∉ U := by
    intro n
    have : ({-x n}ᶜ : Set G) ∈ 𝓝 (0 : G) :=
      isOpen_compl_singleton.mem_nhds (by
        simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
        exact fun h => hx0 n (neg_eq_zero.1 h.symm))
    obtain ⟨U, hU, hUc, hUs⟩ := exists_mem_nhds_isClosed_subset this
    exact ⟨U, hU, hUc, fun h => hUs h rfl⟩
  choose U hU hUc hUx using hUex
  set Y : ℕ → Set G := fun n => (Bn n \ (fun a => a - x n) '' A n) ∩ U n with hY
  set Z : ℕ → Set G := fun n => (fun y => y + x n) '' Y n with hZ
  have hY0 : ∀ n, (0 : G) ∈ closure (Y n) := by
    intro n
    rw [mem_closure_iff_nhds]
    intro t ht
    obtain ⟨y, hy1, hy2⟩ := mem_closure_iff_nhds.1 (hBn0 n) _ (Filter.inter_mem ht (hU n))
    exact ⟨y, hy1.1, hy2, hy1.2⟩
  have hZI : ∀ n, Z n ∈ I := by
    intro n
    refine hI.sub _ (hI.add (Bn n) (hBn n) {x n} (hI.single _)) _ ?_
    rintro _ ⟨y, hy, rfl⟩
    exact ⟨y, hy.1.1, x n, rfl, rfl⟩
  have hZx : ∀ n, x n ∈ closure (Z n) := by
    intro n
    have hm : Set.MapsTo (fun y : G => y + x n) (Y n) (Z n) := fun y hy => ⟨y, hy, rfl⟩
    have h1 := hm.closure (continuous_id.add (continuous_const (y := x n))) (hY0 n)
    have e : (0 : G) + x n = x n := zero_add _
    rw [← e]
    exact h1
  refine ⟨(⋃ n, Z n)ᶜ, ?_, ?_⟩
  · rw [mem_Vxi_zero_iff hI]
    intro B' hB' h0
    obtain ⟨k, hk⟩ := hcof B' hB'
    set K : Set G := ⋃ n ∈ Set.Iio k, (fun y => y + x n) '' U n with hK
    have hKc : IsClosed K :=
      (Set.finite_Iio k).isClosed_biUnion fun n _ => (Homeomorph.addRight (x n)).isClosedMap _ (hUc n)
    have hsub : B' \ (⋃ n, Z n)ᶜ ⊆ K := by
      rintro y ⟨hyB, hyS⟩
      rw [Set.notMem_compl_iff, Set.mem_iUnion] at hyS
      obtain ⟨n, z, hz, rfl⟩ := hyS
      by_cases hn : n < k
      · exact Set.mem_biUnion (x := n) hn ⟨z, hz.2, rfl⟩
      · exfalso
        apply hz.1.2
        exact ⟨z + x n, hmono (not_lt.1 hn) (hk hyB), add_sub_cancel_right z (x n)⟩
    have h1 : (0 : G) ∈ K := closure_minimal hsub hKc h0
    rw [hK, Set.mem_iUnion₂] at h1
    obtain ⟨n, _, u, hu, hu0⟩ := h1
    have : u = -x n := eq_neg_of_add_eq_zero_left hu0
    exact hUx n (this ▸ hu)
  · intro O hO h0O hsub
    have hO' := (isOpenXi_iff hI O).1 hO
    have hstep : ∀ (z : G) (W E : Set G), W ∈ I → E ⊆ W → z ∈ O → z ∈ closure E → ∃ e ∈ E, e ∈ O := by
      intro z W E hW hEW hzO hzE
      by_contra hno
      have : E ⊆ W \ O := fun e he => ⟨hEW he, fun heO => hno ⟨e, he, heO⟩⟩
      have h2 : z ∈ closure (W \ O) ∩ O := ⟨closure_mono this hzE, hzO⟩
      rw [hO' W hW] at h2
      exact h2
    obtain ⟨c, hcC, hcO⟩ := hstep 0 B C hB (fun c hc => (hCsub hc).1) h0O hC0
    rw [hx] at hcC
    obtain ⟨n, rfl⟩ := hcC
    obtain ⟨e, heZ, heO⟩ := hstep (x n) (Z n) (Z n) (hZI n) subset_rfl hcO (hZx n)
    exact hsub heO (Set.mem_iUnion.2 ⟨n, heZ⟩)

/-- Under the two hypotheses, `ξ` is pretopological iff every vicinity set contains an open set containing `0`. -/
theorem pretopological_iff_open_base {I : Set (Set G)} (hI : AdmIdeal I) (A : ℕ → Set G)
    (hA : ∀ n, A n ∈ I) (hmono : Monotone A) (hcof : ∀ B ∈ I, ∃ n, B ⊆ A n)
    (htight : ∀ B : Set G, (0 : G) ∈ closure B → ∃ C ⊆ B, C.Countable ∧ (0 : G) ∈ closure C) :
    xi I (Vxi I 0) 0 ↔ ∀ S ∈ Vxi I 0, ∃ O : Set G, IsOpenXi I O ∧ (0 : G) ∈ O ∧ O ⊆ S := by
  constructor
  · intro h S hS
    exact open_subset_of_pretopological hI h hS
  · intro h
    by_contra hnp
    obtain ⟨S, hS, hbad⟩ := sparse_of_not_pretopological hI A hA hmono hcof htight hnp
    obtain ⟨O, hO, h0, hsub⟩ := h S hS
    exact hbad O hO h0 hsub

end PG
