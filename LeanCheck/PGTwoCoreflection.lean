import Mathlib
import LeanCheck.PGNullFilters
import LeanCheck.PGGenerated
import LeanCheck.PGTwoGeneration
import LeanCheck.PGTwoLattice
import LeanCheck.PGTwoReflection

/-!
# PGtwo: coreflections of a PG into the topological groups (Lean check)

Scope. Section 5 of the second article (`PGtwo.tex`): Proposition 5.9, Lemma 5.10 and Theorem 5.16, abstract form.
Let `C` be a null family on an abelian group `G` (`PGNullFilters`).

* `le_nhds_iff_map_sub` : in a topological group `F ≤ 𝓝 x` if and only if `F - x ≤ 𝓝 0`;
* `KMem C t` : `t` is a group topology in which every convergent filter (proper) converges for the PG
  (membership in the class `𝒦(ξ)`); `kmem_iff` : `KMem C t ↔ 𝓝 0 ∈ C` (Proposition 5.9(a));
* `XiCont C f` : the homomorphism `f` from a topological group into `G` is continuous for the PG; `xiCont_iff` : this holds
  if and only if `f(𝓝 0)` is a null filter;
* `isNbhdFilter_map` : the image of a neighbourhood filter of `0` under a homomorphism is a neighbourhood filter of a
  group topology on the target (also when `f` is not surjective);
* `univ_of_coarsest` : if `𝒦` has a coarsest member `t₀`, every continuous homomorphism from a topological group
  into the PG is continuous for `t₀` (Proposition 5.9(b));
* `kernel_open_of_trivial` : if the only symmetric halvable null filter is the principal filter at `0`, every continuous
  homomorphism from a topological group into the PG has an open kernel (Proposition 5.9(c));
* `finite_member_eq_pure` : on a torsion-free group a halvable filter whose members contain `0` and which has a finite
  member is the principal filter at `0` (Lemma 5.10);
* `CondM` and `eligible_eq_pure` : condition (M) on an ultrafilter `u` of `ℤ` implies that the PG generated by `u` has no
  nonprincipal halvable null filter whose members contain `0` (Theorem 5.16); `kernel_open_of_condM` gives open kernels.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set Topology Pointwise

namespace PG

section Coreflection

variable {G : Type*} [AddCommGroup G]

/-- In a topological group `F ≤ 𝓝 x` if and only if `F - x ≤ 𝓝 0`. -/
theorem le_nhds_iff_map_sub [TopologicalSpace G] [IsTopologicalAddGroup G] (F : Filter G) (x : G) :
    F ≤ 𝓝 x ↔ Filter.map (fun y => y - x) F ≤ 𝓝 0 := by
  constructor
  · intro h
    have h1 := (Homeomorph.subRight x).map_nhds_eq x
    have h2 : Filter.map (fun y => y - x) (𝓝 x) = 𝓝 (0 : G) := by simpa using h1
    calc Filter.map (fun y => y - x) F ≤ Filter.map (fun y => y - x) (𝓝 x) := Filter.map_mono h
      _ = 𝓝 0 := h2
  · intro h
    have h1 := (Homeomorph.addRight x).map_nhds_eq (0 : G)
    have h2 : Filter.map (fun y => y + x) (𝓝 (0 : G)) = 𝓝 x := by simpa using h1
    have h3 : Filter.map (fun y => y + x) (Filter.map (fun y => y - x) F) = F := by
      rw [Filter.map_map]
      have : ((fun y : G => y + x) ∘ fun y => y - x) = id := by funext y; simp
      rw [this, Filter.map_id]
    calc F = Filter.map (fun y => y + x) (Filter.map (fun y => y - x) F) := h3.symm
      _ ≤ Filter.map (fun y => y + x) (𝓝 0) := Filter.map_mono h
      _ = 𝓝 x := h2

/-- A group topology `t` such that every proper convergent filter converges for the PG. -/
def KMem (C : Set (Filter G)) (t : TopologicalSpace G) : Prop :=
  @IsTopologicalAddGroup G t _ ∧
    ∀ (F : Filter G) (x : G), F.NeBot → F ≤ @nhds G t x → conv C F x

/-- Proposition 5.9(a): `t ∈ 𝒦(ξ)` if and only if its neighbourhood filter of `0` is a null filter. -/
theorem kmem_iff {C : Set (Filter G)} (hC : NullFamily C) {t : TopologicalSpace G}
    (ht : @IsTopologicalAddGroup G t _) : KMem C t ↔ @nhds G t 0 ∈ C := by
  letI : TopologicalSpace G := t
  haveI : IsTopologicalAddGroup G := ht
  constructor
  · intro h
    exact (conv_zero C _).1 (h.2 (𝓝 0) 0 inferInstance le_rfl)
  · intro h
    refine ⟨ht, fun F x hne hle => ?_⟩
    have h1 : Filter.map (fun y => y - x) F ≤ 𝓝 0 := (le_nhds_iff_map_sub F x).1 hle
    have hne' : (Filter.map (fun y => y - x) F).NeBot := hne.map _
    exact hC.finer _ h _ h1 hne'

/-- A homomorphism from a topological group into the PG is continuous when it maps convergent filters to convergent
filters. -/
def XiCont (C : Set (Filter G)) {T : Type*} [AddCommGroup T] [TopologicalSpace T] (f : T →+ G) : Prop :=
  ∀ (F : Filter T) (x : T), F.NeBot → F ≤ 𝓝 x → conv C (Filter.map f F) (f x)

theorem xiCont_iff {C : Set (Filter G)} (hC : NullFamily C) {T : Type*} [AddCommGroup T] [TopologicalSpace T]
    [IsTopologicalAddGroup T] (f : T →+ G) : XiCont C f ↔ Filter.map f (𝓝 (0 : T)) ∈ C := by
  constructor
  · intro h
    have := h (𝓝 0) 0 inferInstance le_rfl
    rw [map_zero] at this
    exact (conv_zero C _).1 this
  · intro h F x hne hle
    have h1 : Filter.map (fun y => y - x) F ≤ 𝓝 0 := (le_nhds_iff_map_sub F x).1 hle
    have h2 : Filter.map f (Filter.map (fun y => y - x) F) ≤ Filter.map f (𝓝 0) := Filter.map_mono h1
    have hne' : (Filter.map f (Filter.map (fun y => y - x) F)).NeBot := (hne.map _).map _
    have h3 := hC.finer _ h _ h2 hne'
    have e : Filter.map (fun y => y - f x) (Filter.map f F) = Filter.map f (Filter.map (fun y => y - x) F) := by
      rw [Filter.map_map, Filter.map_map]
      congr 1
      funext y
      simp [map_sub]
    unfold conv
    rw [e]
    exact h3

/-- The image of the neighbourhood filter of `0` under a homomorphism is the neighbourhood filter of `0` of a group
topology on the target. -/
theorem isNbhdFilter_map {T : Type*} [AddCommGroup T] [TopologicalSpace T] [IsTopologicalAddGroup T]
    (f : T →+ G) : IsNbhdFilter (Filter.map f (𝓝 (0 : T))) where
  zero_mem := by
    intro A hA
    have h : (0 : T) ∈ f ⁻¹' A := mem_of_mem_nhds hA
    simpa using h
  neg_mem := by
    intro A hA
    have h1 : (fun x : T => -x) ⁻¹' (f ⁻¹' A) ∈ 𝓝 (0 : T) := (nhds_zero_isNbhdFilter (G := T)).neg_mem (f ⁻¹' A) hA
    have e : f ⁻¹' ((fun x : G => -x) ⁻¹' A) = (fun x : T => -x) ⁻¹' (f ⁻¹' A) := by
      ext x; simp [map_neg]
    show f ⁻¹' ((fun x : G => -x) ⁻¹' A) ∈ 𝓝 (0 : T)
    rw [e]; exact h1
  halve := by
    intro A hA
    obtain ⟨V, hV, hVA⟩ := (nhds_zero_isNbhdFilter (G := T)).halve (f ⁻¹' A) hA
    have hfV : f '' V ∈ Filter.map f (𝓝 (0 : T)) := by
      show f ⁻¹' (f '' V) ∈ 𝓝 (0 : T)
      exact Filter.mem_of_superset hV (fun x hx => ⟨x, hx, rfl⟩)
    refine ⟨f '' V, hfV, ?_⟩
    rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
    have := hVA x hx y hy
    simpa [map_add] using this

/-- Proposition 5.9(b): if `𝒦` has a coarsest member `t₀`, every continuous homomorphism from a topological group into
the PG is continuous for `t₀`. -/
theorem univ_of_coarsest {C : Set (Filter G)} (hC : NullFamily C) {t₀ : TopologicalSpace G}
    (h₀ : KMem C t₀) (hmin : ∀ t : TopologicalSpace G, KMem C t → @Continuous G G t t₀ id)
    {T : Type*} [AddCommGroup T] [TopologicalSpace T] [IsTopologicalAddGroup T] (f : T →+ G)
    (hf : XiCont C f) : @Continuous T G _ t₀ f := by
  have hM : Filter.map f (𝓝 (0 : T)) ∈ C := (xiCont_iff hC f).1 hf
  obtain ⟨γ, hγ, hγ0⟩ := exists_topology (isNbhdFilter_map f)
  have hKγ : KMem C γ := (kmem_iff hC hγ).2 (by rw [hγ0]; exact hM)
  have hid := hmin γ hKγ
  have hle : Filter.map f (𝓝 (0 : T)) ≤ @nhds G t₀ 0 := by
    have h1 : @Tendsto G G id (@nhds G γ 0) (@nhds G t₀ 0) := by
      have := @Continuous.tendsto G G γ t₀ id hid 0
      simpa using this
    rw [hγ0] at h1
    exact h1
  exact @hom_continuous_of_zero T _ G _ t₀ h₀.1 _ _ f hle

/-- Proposition 5.9(c): if the principal filter at `0` is the only halvable null filter whose members contain `0`, then
every continuous homomorphism from a topological group into the PG has an open kernel. -/
theorem kernel_open_of_trivial {C : Set (Filter G)} (hC : NullFamily C)
    (hall : ∀ N : Filter G, IsNbhdFilter N → N ∈ C → N = pure 0)
    {T : Type*} [AddCommGroup T] [TopologicalSpace T] [IsTopologicalAddGroup T] (f : T →+ G)
    (hf : XiCont C f) : ∃ U ∈ 𝓝 (0 : T), ∀ x ∈ U, f x = 0 := by
  have hM : Filter.map f (𝓝 (0 : T)) ∈ C := (xiCont_iff hC f).1 hf
  have h := hall _ (isNbhdFilter_map f) hM
  have h0 : ({0} : Set G) ∈ Filter.map f (𝓝 (0 : T)) := by
    rw [h]; exact rfl
  exact ⟨f ⁻¹' {0}, h0, fun x hx => hx⟩

/-- Lemma 5.10: on a torsion-free group a halvable filter with a finite member is the principal filter at `0`. -/
theorem finite_member_eq_pure (hfree : ∀ (g : G) (n : ℕ), 0 < n → n • g = 0 → g = 0)
    {N : Filter G} (h0 : ∀ A ∈ N, (0 : G) ∈ A)
    (hhalf : ∀ A ∈ N, ∃ B ∈ N, ∀ x ∈ B, ∀ y ∈ B, x + y ∈ A)
    {S : Set G} (hS : S.Finite) (hSN : S ∈ N) : N = pure 0 := by
  classical
  have hex : ∃ k : ℕ, ∃ B : Set G, B ∈ N ∧ B ⊆ S ∧ B.ncard = k := ⟨S.ncard, S, hSN, subset_rfl, rfl⟩
  obtain ⟨B, hBN, hBS, hBk⟩ := Nat.find_spec hex
  have hmin : ∀ B' : Set G, B' ∈ N → B' ⊆ B → B' = B := by
    intro B' hB'N hB'B
    have hfin : B.Finite := hS.subset hBS
    have hle : B.ncard ≤ B'.ncard := by
      have := Nat.find_min' hex (⟨B', hB'N, hB'B.trans hBS, rfl⟩ : ∃ B'' : Set G, B'' ∈ N ∧ B'' ⊆ S ∧ B''.ncard = B'.ncard)
      rw [hBk]; exact this
    exact Set.eq_of_subset_of_ncard_le hB'B hle hfin
  have hfin : B.Finite := hS.subset hBS
  -- closure under addition
  have hadd : ∀ x ∈ B, ∀ y ∈ B, x + y ∈ B := by
    obtain ⟨D, hDN, hD⟩ := hhalf B hBN
    have : B ∩ D = B := hmin (B ∩ D) (Filter.inter_mem hBN hDN) Set.inter_subset_left
    have hBD : B ⊆ D := by
      intro x hx
      have : x ∈ B ∩ D := by rw [‹B ∩ D = B›]; exact hx
      exact this.2
    intro x hx y hy
    exact hD x (hBD hx) y (hBD hy)
  have hsmul : ∀ b ∈ B, ∀ n : ℕ, 0 < n → n • b ∈ B := by
    intro b hb n hn
    induction n with
    | zero => omega
    | succ n ih =>
      rcases Nat.eq_zero_or_pos n with h | h
      · subst h; simpa using hb
      · rw [succ_nsmul]; exact hadd _ (ih h) _ hb
  have hzero : ∀ b ∈ B, b = 0 := by
    intro b hb
    have hmaps : ∀ n : ℕ, (fun k : ℕ => (k + 1) • b) n ∈ B := fun n => hsmul b hb (n + 1) (Nat.succ_pos n)
    obtain ⟨i, j, hij, hEq⟩ := Set.Finite.exists_lt_map_eq_of_forall_mem hmaps hfin
    have hi : (i + 1) • b = (j + 1) • b := hEq
    have h3 : (i + 1) • b + (j - i) • b = (i + 1) • b + 0 := by
      rw [← add_nsmul, add_zero]
      have : i + 1 + (j - i) = j + 1 := by omega
      rw [this]; exact hi.symm
    have h2 : (j - i) • b = 0 := add_left_cancel h3
    exact hfree b (j - i) (by omega) h2
  have hsub : B ⊆ {0} := fun b hb => hzero b hb
  have h0N : ({0} : Set G) ∈ N := Filter.mem_of_superset hBN hsub
  exact le_antisymm (Filter.le_pure_iff.2 h0N) (Filter.pure_le_iff.2 h0)

end Coreflection

section CondM

/-- Signed sums of exactly `n` elements of `B`. -/
def Sn : ℕ → Set ℤ → Set ℤ
  | 0, _ => {0}
  | n + 1, B => (Sn n B + B) ∪ (Sn n B + (-B))

theorem Sn_neg (B : Set ℤ) : ∀ n : ℕ, ∀ x ∈ Sn n B, -x ∈ Sn n B := by
  intro n
  induction n with
  | zero =>
    intro x hx
    have : x = 0 := hx
    subst this; simp [Sn]
  | succ n ih =>
    rintro x (⟨s, hs, b, hb, rfl⟩ | ⟨s, hs, b, hb, rfl⟩)
    · right
      exact ⟨-s, ih s hs, -b, by simpa using hb, by ring⟩
    · left
      exact ⟨-s, ih s hs, -b, by simpa using hb, by ring⟩

theorem Sn_add (B : Set ℤ) : ∀ m n : ℕ, ∀ a ∈ Sn m B, ∀ b ∈ Sn n B, a + b ∈ Sn (m + n) B := by
  intro m n
  induction n with
  | zero =>
    intro a ha b hb
    have : b = 0 := hb
    subst this; simpa using ha
  | succ n ih =>
    intro a ha b hb
    rcases hb with ⟨s, hs, c, hc, rfl⟩ | ⟨s, hs, c, hc, rfl⟩
    · left
      exact ⟨a + s, ih a ha s hs, c, hc, by abel⟩
    · right
      exact ⟨a + s, ih a ha s hs, c, hc, by abel⟩

theorem subset_Sn_one (A : Set ℤ) : A ⊆ Sn 1 A := by
  intro x hx
  left
  exact ⟨0, rfl, x, hx, by simp⟩

/-- A rank for the ultrafilters converging to `0` in the PG generated by `u`. -/
theorem rank_of_genUlt (u : Ultrafilter ℤ) {U : Ultrafilter ℤ} (h : GenUlt u U) :
    ∃ n : ℕ, ∀ A ∈ (u : Filter ℤ), Sn n A ∈ (U : Filter ℤ) := by
  induction h with
  | zero =>
    refine ⟨0, fun A _ => ?_⟩
    show ({0} : Set ℤ) ∈ (pure (0 : ℤ) : Filter ℤ)
    exact rfl
  | gen =>
    exact ⟨1, fun A hA => Filter.mem_of_superset hA (subset_Sn_one A)⟩
  | neg h ih =>
    obtain ⟨n, hn⟩ := ih
    refine ⟨n, fun A hA => ?_⟩
    rw [Ultrafilter.coe_map, Filter.mem_map]
    exact Filter.mem_of_superset (hn A hA) (fun x hx => Sn_neg A n x hx)
  | add h1 h2 hW ih1 ih2 =>
    obtain ⟨n₁, hn₁⟩ := ih1
    obtain ⟨n₂, hn₂⟩ := ih2
    refine ⟨n₁ + n₂, fun A hA => ?_⟩
    apply hW
    refine Filter.mem_of_superset (Filter.image2_mem_map₂ (hn₁ A hA) (hn₂ A hA)) ?_
    rintro _ ⟨a, ha, b, hb, rfl⟩
    exact Sn_add A n₁ n₂ a ha b hb

/-- Condition (M) of Theorem 5.16. -/
def CondM (u : Ultrafilter ℤ) : Prop :=
  ∀ n n'' : ℕ, ∃ A ∈ (u : Filter ℤ), ∃ M : ℕ, ∀ m : ℕ, M < m → ∃ A' ∈ (u : Filter ℤ),
    Disjoint ((fun z : ℤ => (m : ℤ) * z) '' (Sn n A' \ {0})) (Sn n'' A)

/-- Halving gives dilations. -/
theorem halve_mul {N : Filter ℤ} (h0 : ∀ A ∈ N, (0 : ℤ) ∈ A)
    (hhalf : ∀ A ∈ N, ∃ B ∈ N, ∀ x ∈ B, ∀ y ∈ B, x + y ∈ A) :
    ∀ k : ℕ, ∀ A ∈ N, ∃ B ∈ N, ∀ x ∈ B, (k : ℤ) * x ∈ A := by
  intro k
  induction k with
  | zero =>
    intro A hA
    exact ⟨A, hA, fun x _ => by simpa using h0 A hA⟩
  | succ k ih =>
    intro A hA
    obtain ⟨B₁, hB₁, hB₁A⟩ := hhalf A hA
    obtain ⟨B₂, hB₂, hB₂B₁⟩ := ih B₁ hB₁
    refine ⟨B₁ ∩ B₂, Filter.inter_mem hB₁ hB₂, fun x hx => ?_⟩
    have h := hB₁A _ (hB₂B₁ x hx.2) x hx.1
    have e : ((k + 1 : ℕ) : ℤ) * x = (k : ℤ) * x + x := by push_cast; ring
    rw [e]; exact h

theorem mem_bind_iff (f : Ultrafilter ℕ) (m : ℕ → Ultrafilter ℤ) (s : Set ℤ) :
    s ∈ ((Ultrafilter.bind f m : Ultrafilter ℤ) : Filter ℤ) ↔
      {a | s ∈ (m a : Filter ℤ)} ∈ (f : Filter ℕ) := Iff.rfl

/-- Theorem 5.16: condition (M) forces every halvable null filter of the generated PG, whose members contain `0`, to be
the principal filter at `0`. (The symmetry of the filter is not used.) -/
theorem eligible_eq_pure (u : Ultrafilter ℤ) (hM : CondM u) {N : Filter ℤ} (hN : N ∈ genNull u)
    (h0 : ∀ A ∈ N, (0 : ℤ) ∈ A) (hhalf : ∀ A ∈ N, ∃ B ∈ N, ∀ x ∈ B, ∀ y ∈ B, x + y ∈ A) :
    N = pure 0 := by
  by_contra hne
  haveI : N.NeBot := hN.1
  have h0N : ({0} : Set ℤ) ∉ N := by
    intro h
    apply hne
    exact le_antisymm (Filter.le_pure_iff.2 h) (Filter.pure_le_iff.2 h0)
  obtain ⟨W, hWN, hWc⟩ := exists_ultra_compl_mem N h0N
  obtain ⟨n, hn⟩ := rank_of_genUlt u (hN.2 W hWN)
  let Wm : ℕ → Ultrafilter ℤ := fun m => W.map (fun z : ℤ => (m : ℤ) * z)
  have hWm : ∀ m, (Wm m : Filter ℤ) ≤ N := by
    intro m A hA
    obtain ⟨B, hB, hBA⟩ := halve_mul h0 hhalf m A hA
    show (fun z : ℤ => (m : ℤ) * z) ⁻¹' A ∈ (W : Filter ℤ)
    exact Filter.mem_of_superset (hWN hB) hBA
  let Z : Ultrafilter ℤ := Ultrafilter.bind (Filter.hyperfilter ℕ) Wm
  have hZN : (Z : Filter ℤ) ≤ N := by
    intro A hA
    rw [Ultrafilter.mem_coe] at *
    exact (mem_bind_iff _ _ _).2 (Filter.univ_mem' (fun m => hWm m hA))
  obtain ⟨n'', hn''⟩ := rank_of_genUlt u (hN.2 Z hZN)
  obtain ⟨A, hA, M, hMA⟩ := hM n n''
  have hSZ : Sn n'' A ∈ (Z : Filter ℤ) := hn'' A hA
  have hE : {m | Sn n'' A ∈ (Wm m : Filter ℤ)} ∈ (Filter.hyperfilter ℕ : Filter ℕ) :=
    (mem_bind_iff _ _ _).1 hSZ
  have hbig : {m : ℕ | M < m} ∈ (Filter.hyperfilter ℕ : Filter ℕ) := by
    apply Filter.hyperfilter_le_cofinite
    rw [Filter.mem_cofinite]
    have : {m : ℕ | M < m}ᶜ = Set.Iic M := by
      ext m; simp
    rw [this]; exact Set.finite_Iic M
  obtain ⟨m, hmE, hmM⟩ := Filter.nonempty_of_mem (Filter.inter_mem hE hbig)
  obtain ⟨A', hA', hdisj⟩ := hMA m hmM
  have h1 : Sn n A' \ {0} ∈ (W : Filter ℤ) := Filter.inter_mem (hn A' hA') hWc
  have h2 : (fun z : ℤ => (m : ℤ) * z) '' (Sn n A' \ {0}) ∈ (Wm m : Filter ℤ) := by
    show (fun z : ℤ => (m : ℤ) * z) ⁻¹' _ ∈ (W : Filter ℤ)
    exact Filter.mem_of_superset h1 (Set.subset_preimage_image _ _)
  obtain ⟨x, hx1, hx2⟩ := Filter.nonempty_of_mem (Filter.inter_mem h2 hmE)
  exact Set.disjoint_left.1 hdisj hx1 hx2

/-- Theorem 5.16: under condition (M) every continuous homomorphism from a topological group into the PG generated by
`u` has an open kernel. -/
theorem kernel_open_of_condM (u : Ultrafilter ℤ) (hM : CondM u)
    {T : Type*} [AddCommGroup T] [TopologicalSpace T] [IsTopologicalAddGroup T] (f : T →+ ℤ)
    (hf : XiCont (genNull u) f) : ∃ U ∈ 𝓝 (0 : T), ∀ x ∈ U, f x = 0 :=
  kernel_open_of_trivial (genNull_nullFamily u)
    (fun N hN hNC => eligible_eq_pure u hM hNC hN.zero_mem hN.halve) f hf

end CondM

section Lemma57

universe u

variable {G : Type u} [AddCommGroup G]

/-- Lemma 5.7: if the PG `C` has a coreflection `(R, ε)` into the topological groups, then there is a coarsest group
topology `t₀` all of whose convergent filters converge for the PG. -/
theorem coarsest_of_coreflection {C : Set (Filter G)} (hC : NullFamily C)
    {R : Type u} [AddCommGroup R] [TopologicalSpace R] [IsTopologicalAddGroup R]
    (ε : R →+ G) (hε : XiCont C ε)
    (huniv : ∀ (T : Type u) [AddCommGroup T] [TopologicalSpace T] [IsTopologicalAddGroup T]
      (f : T →+ G), XiCont C f → ∃! g : T →+ R, Continuous g ∧ ε.comp g = f) :
    ∃ t₀ : TopologicalSpace G, KMem C t₀ ∧ ∀ t : TopologicalSpace G, KMem C t → @Continuous G G t t₀ id := by
  classical
  letI td : TopologicalSpace G := ⊥
  haveI hdisc : DiscreteTopology G := ⟨rfl⟩
  have hι : XiCont C (AddMonoidHom.id G) := by
    intro F x hne hle
    have h1 : F ≤ pure x := by rwa [nhds_discrete] at hle
    have h2 : F = pure x := (Filter.NeBot.le_pure_iff hne).1 h1
    rw [h2]
    simpa using conv_pure hC x
  obtain ⟨s, ⟨hs_cont, hs_eq⟩, hs_uniq⟩ := huniv G (AddMonoidHom.id G) hι
  -- for every eligible topology the section is the same map
  have hsec : ∀ γ : TopologicalSpace G, KMem C γ → @Continuous G R γ _ s := by
    intro γ hγ
    have hxi : @XiCont G _ C G _ γ (AddMonoidHom.id G) := by
      intro F x hne hle
      simpa using hγ.2 F x hne hle
    obtain ⟨sγ, ⟨hsγ_cont, hsγ_eq⟩, _⟩ := @huniv G _ γ hγ.1 (AddMonoidHom.id G) hxi
    have hk : @Continuous G G td γ id := @continuous_of_discreteTopology G td hdisc G γ id
    have hcomp : @Continuous G R td _ sγ := @Continuous.comp G G R td γ _ _ _ hsγ_cont hk
    have hEq : sγ = s := hs_uniq sγ ⟨hcomp, hsγ_eq⟩
    rw [← hEq]; exact hsγ_cont
  have hσg : @IsTopologicalAddGroup G (TopologicalSpace.induced s inferInstance) _ :=
    isTopologicalAddGroup_induced s
  have hεs : ∀ y : G, ε (s y) = y := fun y => DFunLike.congr_fun hs_eq y
  refine ⟨TopologicalSpace.induced s inferInstance, ⟨hσg, ?_⟩, ?_⟩
  · intro F x hne hle
    rw [nhds_induced] at hle
    have h1 : Filter.map s F ≤ 𝓝 (s x) := Filter.map_le_iff_le_comap.2 hle
    have h2 := hε (Filter.map s F) (s x) (hne.map _) h1
    have e : Filter.map ε (Filter.map s F) = F := by
      rw [Filter.map_map]
      have : (ε ∘ s) = id := funext hεs
      rw [this, Filter.map_id]
    rw [e, hεs] at h2
    exact h2
  · intro γ hγ
    exact continuous_induced_rng.2 (hsec γ hγ)

end Lemma57

end PG
