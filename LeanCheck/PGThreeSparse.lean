import Mathlib
import LeanCheck.PGTwoDigits
import LeanCheck.PGTwoQuotient
import LeanCheck.PGThreeSelective

/-!
# PGthree: rapidly growing finite-sum tails make the second inclusion strict (Lean check)

Scope. Section 5 of the third article (`PGthree.tex`). `y` is a sequence of positive integers with
`y (l) / (y 0 + ⋯ + y (l-1)) → ∞` (stated as: for every `B`, eventually `2 B ∑_{i<l} y i < y l`), and `u` is an
ultrafilter on `ℤ` containing `FSset y m` (the nonempty finite sums of distinct `y i`, `i > m`) for every `m`.
`C = genFam (ultraGen {u})` is the null family of the PG generated by `u`.

* `exists_weight` : a nondecreasing unbounded `β` with `2 β l ∑_{i<l} y i < y l` for all `l`;
* `val_inj` : expansions with `|c l| ≤ β l` are unique;
* `sparse_strict` : the PG is Hausdorff; there is a member `A` of the vicinity filter such that no open set of the
  topological modification contains `0` and lies in `A`, and no member `B` of the vicinity filter has `B + B ⊆ A`;
  the vicinity filter does not converge to `0`.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set

namespace PG

namespace Sparse

variable (y : ℕ → ℤ)

/-- The value of a finitely supported coefficient vector. -/
def val (c : ℕ →₀ ℤ) : ℤ := c.sum (fun l a => a * y l)

theorem val_add (c d : ℕ →₀ ℤ) : val y (c + d) = val y c + val y d := by
  unfold val
  exact Finsupp.sum_add_index' (fun _ => zero_mul _) (fun _ _ _ => add_mul _ _ _)

theorem val_zero : val y 0 = 0 := by simp [val]

theorem val_neg (c : ℕ →₀ ℤ) : val y (-c) = -val y c := by
  have h := val_add y c (-c)
  rw [add_neg_cancel, val_zero] at h
  omega

theorem val_smul (a : ℤ) (c : ℕ →₀ ℤ) : val y (a • c) = a * val y c := by
  unfold val
  rw [Finsupp.sum_smul_index' (fun _ => zero_mul _), Finsupp.mul_sum]
  exact Finset.sum_congr rfl (fun l _ => by simp [mul_assoc])

theorem val_finset_sum {ι : Type*} (s : Finset ι) (c : ι → ℕ →₀ ℤ) :
    val y (∑ i ∈ s, c i) = ∑ i ∈ s, val y (c i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [val_zero]
  | insert i s hi ih => rw [Finset.sum_insert hi, Finset.sum_insert hi, val_add, ih]

/-- The indicator vector of a finite set of indices. -/
noncomputable def ind (s : Finset ℕ) : ℕ →₀ ℤ := ∑ l ∈ s, Finsupp.single l 1

theorem ind_apply (s : Finset ℕ) (l : ℕ) : ind s l = if l ∈ s then 1 else 0 := by
  classical
  unfold ind
  rw [Finsupp.finsetSum_apply]
  simp [Finsupp.single_apply]

theorem val_ind (s : Finset ℕ) : val y (ind s) = ∑ l ∈ s, y l := by
  unfold ind
  rw [val_finset_sum]
  refine Finset.sum_congr rfl (fun l _ => ?_)
  unfold val
  rw [Finsupp.sum_single_index (zero_mul _), one_mul]

/-- A nondecreasing unbounded weight. -/
theorem exists_weight (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l) :
    ∃ β : ℕ → ℕ, Monotone β ∧ (∀ B : ℕ, ∃ m, B ≤ β m) ∧
      ∀ l, 2 * (β l : ℤ) * ∑ i ∈ Finset.range l, y i < y l := by
  classical
  choose L hL using hgrow
  set β : ℕ → ℕ := fun l => ((Finset.range (l + 1)).filter (fun B => L B < l)).sup id with hβ
  refine ⟨β, ?_, ?_, ?_⟩
  · intro a b hab
    refine Finset.sup_mono (fun B hB => ?_)
    rw [Finset.mem_filter, Finset.mem_range] at hB ⊢
    omega
  · intro B
    refine ⟨max (L B) B + 1, Finset.le_sup (f := id) ?_⟩
    rw [Finset.mem_filter, Finset.mem_range]
    omega
  · intro l
    by_cases h : ((Finset.range (l + 1)).filter (fun B => L B < l)).Nonempty
    · obtain ⟨B, hB, hsup⟩ := Finset.exists_mem_eq_sup _ h id
      have e : β l = B := hsup
      rw [e]
      exact hL B l (Finset.mem_filter.1 hB).2
    · rw [Finset.not_nonempty_iff_eq_empty] at h
      have e : β l = 0 := by
        show ((Finset.range (l + 1)).filter (fun B => L B < l)).sup id = 0
        rw [h]
        rfl
      rw [e]
      simpa using hpos l

variable {y}

/-- Above the largest index of its support a nonzero expansion is large. -/
theorem lt_abs_val (hpos : ∀ i, 0 < y i) {β : ℕ → ℕ} (hβ : Monotone β)
    (hw : ∀ l, 2 * (β l : ℤ) * ∑ i ∈ Finset.range l, y i < y l) (e : ℕ →₀ ℤ) (l : ℕ) (hl : e l ≠ 0)
    (hmax : ∀ i ∈ e.support, i ≤ l) (hbound : ∀ i, i < l → |e i| ≤ 2 * (β l : ℤ)) :
    y l - 2 * (β l : ℤ) * ∑ i ∈ Finset.range l, y i ≤ |val y e| := by
  classical
  have hsum : val y e = e l * y l + ∑ i ∈ Finset.range l, e i * y i := by
    have h1 : val y e = ∑ i ∈ Finset.range (l + 1), e i * y i := by
      unfold val Finsupp.sum
      refine Finset.sum_subset (fun i hi => Finset.mem_range.2 (Nat.lt_succ_of_le (hmax i hi))) (fun i _ hi => ?_)
      rw [Finsupp.notMem_support_iff.1 hi]
      exact zero_mul _
    rw [h1, Finset.sum_range_succ, add_comm]
  have h2 : |∑ i ∈ Finset.range l, e i * y i| ≤ 2 * (β l : ℤ) * ∑ i ∈ Finset.range l, y i := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum (fun i hi => ?_)
    rw [abs_mul, abs_of_pos (hpos i)]
    exact mul_le_mul_of_nonneg_right (hbound i (Finset.mem_range.1 hi)) (hpos i).le
  have h3 : y l ≤ |e l * y l| := by
    rw [abs_mul, abs_of_pos (hpos l)]
    have : 1 ≤ |e l| := Int.one_le_abs hl
    calc y l = 1 * y l := (one_mul _).symm
      _ ≤ |e l| * y l := mul_le_mul_of_nonneg_right this (hpos l).le
  have h4 : |e l * y l| ≤ |val y e| + |∑ i ∈ Finset.range l, e i * y i| := by
    have h5 : e l * y l = val y e - ∑ i ∈ Finset.range l, e i * y i := by rw [hsum]; ring
    rw [h5]
    exact abs_sub _ _
  omega

/-- Expansions with `|c l| ≤ β l` are unique. -/
theorem val_inj (hpos : ∀ i, 0 < y i) {β : ℕ → ℕ} (hβ : Monotone β)
    (hw : ∀ l, 2 * (β l : ℤ) * ∑ i ∈ Finset.range l, y i < y l) (c d : ℕ →₀ ℤ)
    (hc : ∀ l, |c l| ≤ (β l : ℤ)) (hd : ∀ l, |d l| ≤ (β l : ℤ)) (h : val y c = val y d) : c = d := by
  classical
  by_contra hne
  have he : c - d ≠ 0 := sub_ne_zero.2 hne
  have hsupp : (c - d).support.Nonempty := Finsupp.support_nonempty_iff.2 he
  set l := (c - d).support.max' hsupp with hl
  have hlmem : l ∈ (c - d).support := Finset.max'_mem _ _
  have h1 := lt_abs_val hpos hβ hw (c - d) l (Finsupp.mem_support_iff.1 hlmem)
    (fun i hi => Finset.le_max' _ i hi) (fun i hi => by
      have hb : (β i : ℤ) ≤ β l := by exact_mod_cast hβ hi.le
      have := abs_sub (c i) (d i)
      rw [Finsupp.sub_apply]
      have := hc i
      have := hd i
      omega)
  have h2 : val y (c - d) = 0 := by
    rw [sub_eq_add_neg, val_add, val_neg, h, add_neg_cancel]
  rw [h2, abs_zero] at h1
  have := hw l
  omega

variable (y)

/-- The set of sums whose coefficients are bounded by the weight of their smallest index. -/
def Aset (β : ℕ → ℕ) : Set ℤ :=
  {z | z = 0 ∨ ∃ c : ℕ →₀ ℤ, z = val y c ∧ ∃ k ∈ c.support, (∀ l ∈ c.support, k ≤ l) ∧ ∀ l, |c l| ≤ (β k : ℤ)}

/-- A signed sum of `n` elements of a far tail has an expansion with coefficients at most `n`, supported above `m`. -/
theorem expansion {ι : Type*} [Fintype ι] (c : ι → ℤ) (hc : ∀ i, c i = 1 ∨ c i = -1) (m : ℕ) (a : ι → ℤ)
    (ha : ∀ i, a i ∈ FSset y m) :
    ∃ d : ℕ →₀ ℤ, val y d = ∑ i, c i • a i ∧ (∀ l, |d l| ≤ (Fintype.card ι : ℤ)) ∧ ∀ l ∈ d.support, m < l := by
  classical
  choose s hs hsm hsa using ha
  refine ⟨∑ i, c i • ind (s i), ?_, ?_, ?_⟩
  · rw [val_finset_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [val_smul, val_ind, ← hsa i, smul_eq_mul]
  · intro l
    rw [Finsupp.finsetSum_apply]
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    have h1 : ∀ i ∈ Finset.univ, |(c i • ind (s i)) l| ≤ 1 := by
      intro i _
      rw [Finsupp.smul_apply, ind_apply, smul_eq_mul]
      rcases hc i with h | h <;> rw [h] <;> split_ifs <;> simp
    refine (Finset.sum_le_sum h1).trans ?_
    simp
  · intro l hl
    by_contra hlm
    apply Finsupp.mem_support_iff.1 hl
    rw [Finsupp.finsetSum_apply]
    refine Finset.sum_eq_zero (fun i _ => ?_)
    have : l ∉ s i := fun h => hlm (hsm i l h)
    rw [Finsupp.smul_apply, ind_apply, if_neg this, smul_zero]

/-- Section 5: the PG generated by `u` is Hausdorff, the second inclusion `N_τ(0) ⊆ V` is strict, and the vicinity
filter is not halvable. -/
theorem sparse_strict (u : Ultrafilter ℤ) (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l)
    (htail : ∀ m : ℕ, FSset y m ∈ (u : Filter ℤ)) :
    (∀ g : ℤ, (pure g : Filter ℤ) ∈ genFam (Sel.ultraGen {u}) → g = 0) ∧
      ∃ A ∈ vic (genFam (Sel.ultraGen ({u} : Set (Ultrafilter ℤ)))),
        (∀ O ⊆ A, (0 : ℤ) ∈ O → ¬ IsOpenMod (genFam (Sel.ultraGen {u})) O) ∧
          (∀ B ∈ vic (genFam (Sel.ultraGen ({u} : Set (Ultrafilter ℤ)))), ¬ ∀ a ∈ B, ∀ b ∈ B, a + b ∈ A) ∧
            vic (genFam (Sel.ultraGen ({u} : Set (Ultrafilter ℤ)))) ∉ genFam (Sel.ultraGen {u}) := by
  classical
  set C := genFam (Sel.ultraGen ({u} : Set (Ultrafilter ℤ))) with hCdef
  have hC : NullFamily C := genFam_nullFamily _
  obtain ⟨β, hβ, hβinf, hw⟩ := exists_weight y hpos hgrow
  -- the representation of a signed sum of copies of `u`
  have hrep : ∀ σ : Filter ℤ, SumClosure (Sel.ultraGen ({u} : Set (Ultrafilter ℤ))) σ →
      ∃ n : ℕ, ∀ m : ℕ, ∀ s : Set ℤ,
        (∀ d : ℕ →₀ ℤ, (∀ l, |d l| ≤ (n : ℤ)) → (∀ l ∈ d.support, m < l) → val y d ∈ s) → s ∈ σ := by
    intro σ hσ
    obtain ⟨ι, _, v, c, hv, hc, h⟩ := Sel.rep_of_sumClosure _ hσ
    refine ⟨Fintype.card ι, fun m s hs => ?_⟩
    have hA : ∀ i, FSset y m ∈ v i := by
      intro i
      have : v i = u := hv i
      rw [this]
      exact htail m
    refine Filter.mem_of_superset (h (fun _ => FSset y m) hA) ?_
    rintro z ⟨a, ha, rfl⟩
    obtain ⟨d, hd, hdb, hds⟩ := expansion y c hc m a ha
    rw [← hd]
    exact hs d hdb hds
  have hAvic : Aset y β ∈ vic C := by
    rw [mem_vic]
    intro F hF
    rw [Filter.mem_iff_ultrafilter]
    intro V hV
    obtain ⟨σ, hσ, hVσ⟩ := hF.2 V hV
    obtain ⟨n, hn⟩ := hrep σ hσ
    obtain ⟨m, hm⟩ := hβinf n
    refine hVσ (hn m _ (fun d hdb hds => ?_))
    rcases d.support.eq_empty_or_nonempty with h0 | hne
    · left
      rw [Finsupp.support_eq_empty.1 h0, val_zero]
    right
    refine ⟨d, rfl, d.support.min' hne, Finset.min'_mem _ _, fun l hl => Finset.min'_le _ l hl, fun l => ?_⟩
    have h1 : m < d.support.min' hne := hds _ (Finset.min'_mem _ _)
    have h2 : n ≤ β (d.support.min' hne) := hm.trans (hβ h1.le)
    exact (hdb l).trans (by exact_mod_cast h2)
  have hhaus : ∀ g : ℤ, (pure g : Filter ℤ) ∈ C → g = 0 := by
    intro g hg
    obtain ⟨σ, hσ, hle⟩ := hg.2 (pure g) (le_of_eq (Ultrafilter.coe_pure g))
    obtain ⟨n, hn⟩ := hrep σ hσ
    obtain ⟨m0, hm0⟩ := hβinf (max n 1)
    set m := max m0 g.natAbs with hm
    have h1 : {z : ℤ | ∃ d : ℕ →₀ ℤ, (∀ l, |d l| ≤ (n : ℤ)) ∧ (∀ l ∈ d.support, m < l) ∧ val y d = z} ∈ σ :=
      hn m _ (fun d hdb hds => ⟨d, hdb, hds, rfl⟩)
    have h2 : g ∈ {z : ℤ | ∃ d : ℕ →₀ ℤ, (∀ l, |d l| ≤ (n : ℤ)) ∧ (∀ l ∈ d.support, m < l) ∧ val y d = z} :=
      hle h1
    obtain ⟨d, hdb, hds, hdg⟩ := h2
    by_contra hg0
    have hd0 : d ≠ 0 := fun h => hg0 (by rw [← hdg, h, val_zero])
    have hne : d.support.Nonempty := Finsupp.support_nonempty_iff.2 hd0
    set l := d.support.max' hne with hl
    have hlm : m < l := hds l (Finset.max'_mem _ _)
    have hnβ : max n 1 ≤ β l := hm0.trans (hβ (by omega))
    have h3 := lt_abs_val hpos hβ hw d l (Finsupp.mem_support_iff.1 (Finset.max'_mem _ _))
      (fun i hi => Finset.le_max' _ i hi) (fun i _ => by
        have h4 := hdb i
        have h5 : (n : ℤ) ≤ β l := by exact_mod_cast (le_max_left n 1).trans hnβ
        omega)
    have h6 : (l : ℤ) ≤ ∑ i ∈ Finset.range l, y i := by
      have h7 : ∑ _i ∈ Finset.range l, (1 : ℤ) ≤ ∑ i ∈ Finset.range l, y i :=
        Finset.sum_le_sum (fun i _ => by have := hpos i; omega)
      simpa using h7
    have h8 : (1 : ℤ) ≤ β l := by exact_mod_cast (le_max_right n 1).trans hnβ
    have h9 : (l : ℤ) ≤ 2 * (β l : ℤ) * ∑ i ∈ Finset.range l, y i := by
      have hsum : (0 : ℤ) ≤ ∑ i ∈ Finset.range l, y i := Finset.sum_nonneg (fun i _ => (hpos i).le)
      calc (l : ℤ) ≤ 1 * ∑ i ∈ Finset.range l, y i := by rw [one_mul]; exact h6
        _ ≤ 2 * (β l : ℤ) * ∑ i ∈ Finset.range l, y i := mul_le_mul_of_nonneg_right (by omega) hsum
    have h10 := hw l
    -- `y l - 2 β l ∑ ≥ 1` is not enough; use `|d i| ≤ n ≤ β l`
    have h11 : y l - (β l : ℤ) * ∑ i ∈ Finset.range l, y i ≤ |val y d| := by
      have h12 : val y d = d l * y l + ∑ i ∈ Finset.range l, d i * y i := by
        have h13 : val y d = ∑ i ∈ Finset.range (l + 1), d i * y i := by
          unfold val Finsupp.sum
          refine Finset.sum_subset (fun i hi => Finset.mem_range.2 (Nat.lt_succ_of_le (Finset.le_max' _ i hi)))
            (fun i _ hi => ?_)
          rw [Finsupp.notMem_support_iff.1 hi]
          exact zero_mul _
        rw [h13, Finset.sum_range_succ, add_comm]
      have h14 : |∑ i ∈ Finset.range l, d i * y i| ≤ (β l : ℤ) * ∑ i ∈ Finset.range l, y i := by
        refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
        rw [Finset.mul_sum]
        refine Finset.sum_le_sum (fun i _ => ?_)
        rw [abs_mul, abs_of_pos (hpos i)]
        have h15 : |d i| ≤ (β l : ℤ) := (hdb i).trans (by exact_mod_cast (le_max_left n 1).trans hnβ)
        exact mul_le_mul_of_nonneg_right h15 (hpos i).le
      have h16 : y l ≤ |d l * y l| := by
        rw [abs_mul, abs_of_pos (hpos l)]
        have : 1 ≤ |d l| := Int.one_le_abs (Finsupp.mem_support_iff.1 (Finset.max'_mem _ _))
        calc y l = 1 * y l := (one_mul _).symm
          _ ≤ |d l| * y l := mul_le_mul_of_nonneg_right this (hpos l).le
      have h17 : |d l * y l| ≤ |val y d| + |∑ i ∈ Finset.range l, d i * y i| := by
        have h18 : d l * y l = val y d - ∑ i ∈ Finset.range l, d i * y i := by rw [h12]; ring
        rw [h18]
        exact abs_sub _ _
      omega
    have h19 : (l : ℤ) ≤ (β l : ℤ) * ∑ i ∈ Finset.range l, y i := by
      have hsum : (0 : ℤ) ≤ ∑ i ∈ Finset.range l, y i := Finset.sum_nonneg (fun i _ => (hpos i).le)
      calc (l : ℤ) ≤ 1 * ∑ i ∈ Finset.range l, y i := by rw [one_mul]; exact h6
        _ ≤ (β l : ℤ) * ∑ i ∈ Finset.range l, y i := mul_le_mul_of_nonneg_right h8 hsum
    have h20 : |g| ≤ (m : ℤ) := by
      rw [Int.abs_eq_natAbs]
      exact_mod_cast le_max_right m0 g.natAbs
    have h21 : (m : ℤ) < l := by exact_mod_cast hlm
    have h22 : |val y d| = |g| := by rw [hdg]
    have h23 : 2 * (β l : ℤ) * ∑ i ∈ Finset.range l, y i
        = (β l : ℤ) * ∑ i ∈ Finset.range l, y i + (β l : ℤ) * ∑ i ∈ Finset.range l, y i := by ring
    omega
  have hne : ∀ F ∈ Sel.ultraGen ({u} : Set (Ultrafilter ℤ)), F.NeBot := by
    rintro F ⟨v, _, rfl⟩
    exact v.neBot
  have huC : (u : Filter ℤ) ∈ C := subset_genFam hne ⟨u, rfl, rfl⟩
  have hKC : ∀ K : ℕ, Filter.map (fun x : ℤ => K • x) (u : Filter ℤ) ∈ C := by
    intro K
    refine genFam_le hC (fun F hF => ?_) (map_nsmul_mem (u : Filter ℤ) K)
    rw [mem_singleton_iff] at hF
    rw [hF]
    exact huC
  -- the key contradiction: `x + K z` is not in `A`
  obtain ⟨m0, hm0⟩ := hβinf 1
  have key : ∀ x : ℤ, x ∈ FSset y m0 → ∀ S : Set ℤ, S ∈ (u : Filter ℤ) →
      ∃ K : ℕ, ∀ T : Set ℤ, Filter.map (fun z : ℤ => K • z) (u : Filter ℤ) ≤ 𝓟 T →
        ∃ w ∈ T, x + w ∉ Aset y β := by
    rintro x ⟨s, hs, hsm, rfl⟩ _ _
    set k := s.min' hs with hk
    refine ⟨β k + 1, fun T hT => ?_⟩
    obtain ⟨m1, hm1⟩ := hβinf (β k + 1)
    set m := max m1 (s.max' hs) with hm
    have hT' : (fun z : ℤ => (β k + 1) • z) ⁻¹' T ∈ (u : Filter ℤ) := by
      have : T ∈ Filter.map (fun z : ℤ => (β k + 1) • z) (u : Filter ℤ) := Filter.le_principal_iff.1 hT
      exact this
    obtain ⟨z, hzT, t, ht, htm, rfl⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (u : Filter ℤ)) hT' (htail m))
    refine ⟨(β k + 1) • ∑ i ∈ t, y i, hzT, ?_⟩
    set d : ℕ →₀ ℤ := ind s + ((β k + 1 : ℕ) : ℤ) • ind t with hd
    have hval : val y d = (∑ i ∈ s, y i) + (β k + 1) • ∑ i ∈ t, y i := by
      rw [hd, val_add, val_smul, val_ind, val_ind, nsmul_eq_mul]
    have hdisj : ∀ l ∈ s, l ∉ t := by
      intro l hl hlt
      have h1 : m < l := htm l hlt
      have h2 : l ≤ s.max' hs := Finset.le_max' _ l hl
      omega
    have hdapply : ∀ l, d l = (if l ∈ s then 1 else 0) + ((β k + 1 : ℕ) : ℤ) * (if l ∈ t then 1 else 0) := by
      intro l
      rw [hd, Finsupp.add_apply, Finsupp.smul_apply, ind_apply, ind_apply, smul_eq_mul]
    have hkm0 : m0 < k := hsm k (Finset.min'_mem _ _)
    have hdb : ∀ l, |d l| ≤ (β l : ℤ) := by
      intro l
      rw [hdapply]
      by_cases hls : l ∈ s
      · rw [if_pos hls, if_neg (hdisj l hls), mul_zero, add_zero, abs_one]
        have h1 : m0 < l := hsm l hls
        have h2 : 1 ≤ β l := hm0.trans (hβ h1.le)
        exact_mod_cast h2
      · by_cases hlt : l ∈ t
        · rw [if_neg hls, if_pos hlt, zero_add, mul_one, Nat.abs_cast]
          have h1 : m < l := htm l hlt
          have h2 : β k + 1 ≤ β l := hm1.trans (hβ (by omega))
          exact_mod_cast h2
        · rw [if_neg hls, if_neg hlt, mul_zero, add_zero, abs_zero]
          positivity
    have hpos' : 0 < val y d := by
      rw [hval]
      have h1 : 0 < ∑ i ∈ s, y i := Finset.sum_pos (fun i _ => hpos i) hs
      have h2 : 0 ≤ (β k + 1) • ∑ i ∈ t, y i :=
        nsmul_nonneg (Finset.sum_nonneg (fun i _ => (hpos i).le)) _
      omega
    rw [← hval]
    rintro (h0 | ⟨c, hc, k', hk', hmin, hcb⟩)
    · omega
    have hcb' : ∀ l, |c l| ≤ (β l : ℤ) := by
      intro l
      by_cases hl : l ∈ c.support
      · exact (hcb l).trans (by exact_mod_cast hβ (hmin l hl))
      · rw [Finsupp.notMem_support_iff.1 hl, abs_zero]
        positivity
    have hcd : d = c := val_inj hpos hβ hw d c hdb hcb' hc
    have hkd : d k ≠ 0 := by
      rw [hdapply, if_pos (Finset.min'_mem _ _), if_neg (hdisj k (Finset.min'_mem _ _)), mul_zero, add_zero]
      exact one_ne_zero
    have hk'k : k' ≤ k := hmin k (by rw [← hcd]; exact Finsupp.mem_support_iff.2 hkd)
    obtain ⟨i, hi⟩ := ht
    have his : i ∉ s := fun h => hdisj i h hi
    have hdi : d i = ((β k + 1 : ℕ) : ℤ) := by
      rw [hdapply, if_neg his, if_pos hi, zero_add, mul_one]
    have h1 := hcb i
    rw [← hcd, hdi, Nat.abs_cast] at h1
    have h2 : β k + 1 ≤ β k' := by exact_mod_cast h1
    have h3 := hβ hk'k
    omega
  refine ⟨hhaus, Aset y β, hAvic, ?_, ?_, ?_⟩
  · intro O hOA h0 hopen
    have h1 : O ∈ (u : Filter ℤ) := hopen 0 h0 (u : Filter ℤ) u.neBot ((conv_zero C _).2 huC)
    obtain ⟨x, hxO, hxF⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (u : Filter ℤ)) h1 (htail m0))
    obtain ⟨K, hK⟩ := key x hxF O h1
    have h2 : Filter.map (fun z : ℤ => K • z) (u : Filter ℤ) ≤ 𝓟 {w | x + w ∈ O} := by
      rw [Filter.le_principal_iff]
      have hconv : conv C (Filter.map (fun w => x + w) (Filter.map (fun z : ℤ => K • z) (u : Filter ℤ))) x := by
        unfold conv
        rw [Filter.map_map]
        have e : ((fun y : ℤ => y - x) ∘ fun w => x + w) = id := by funext w; simp
        rw [e, Filter.map_id]
        exact hKC K
      exact hopen x hxO _ ((u.neBot.map _).map _) hconv
    obtain ⟨w, hw1, hw2⟩ := hK _ h2
    exact hw2 (hOA hw1)
  · intro B hB hsum
    have h1 : B ∈ (u : Filter ℤ) := mem_vic.1 hB _ huC
    obtain ⟨x, hxB, hxF⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (u : Filter ℤ)) h1 (htail m0))
    obtain ⟨K, hK⟩ := key x hxF B h1
    have h2 : Filter.map (fun z : ℤ => K • z) (u : Filter ℤ) ≤ 𝓟 B :=
      Filter.le_principal_iff.2 (mem_vic.1 hB _ (hKC K))
    obtain ⟨w, hwB, hw2⟩ := hK _ h2
    exact hw2 (hsum x hxB w hwB)
  · intro hpre
    have hsum := hC.add _ hpre _ hpre
    have h2 : Aset y β ∈ Filter.map₂ (· + ·) (vic C) (vic C) := mem_vic.1 hAvic _ hsum
    obtain ⟨a, ha, b, hb, hab⟩ := Filter.mem_map₂_iff.1 h2
    have h1 : a ∩ b ∈ (u : Filter ℤ) := mem_vic.1 (Filter.inter_mem ha hb) _ huC
    obtain ⟨x, hxB, hxF⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (u : Filter ℤ)) h1 (htail m0))
    obtain ⟨K, hK⟩ := key x hxF _ h1
    have h3 : Filter.map (fun z : ℤ => K • z) (u : Filter ℤ) ≤ 𝓟 (a ∩ b) :=
      Filter.le_principal_iff.2 (mem_vic.1 (Filter.inter_mem ha hb) _ (hKC K))
    obtain ⟨w, hwB, hw2⟩ := hK _ h3
    exact hw2 (hab ⟨x, hxB.1, w, hwB.2, rfl⟩)

end Sparse

