import Mathlib
import LeanCheck.PGFourSums

/-!
# PGfour: when the sum of integer multiples of ultrafilters has a group modification

`y` is a rapidly growing sequence of positive integers, `l` is a list of pairs `(c, v)` of
a nonzero integer and a nonprincipal ultrafilter on `ℕ`, and `sumL y l` is the sum, in the
sense of ultrafilters, of the images of the `v` under `n ↦ c * y n`.

* `diff_small` : in every group topology in which `sumL y l` converges to `0`, the
  differences `d (y m - y m')` are small, `d` in the subgroup generated by the coefficients
  carried by one ultrafilter;
* `not_group_of_sep` : if no multiple of the vector of class sums equals the relevant
  multiples of one coordinate, the topological modification is not a group topology;
* `genFam_eq_of_one` : if all ultrafilters are equal to `w` and the sum of the coefficients
  is `±d`, then `sumL y l` and the image of `w` under `n ↦ d * y n` generate the same PG;
* `classification` : the modification is a group topology exactly when all ultrafilters are
  one P-point `w` and the absolute value of the sum of the coefficients is the positive
  generator of the subgroup that they generate.

No set-theoretic axiom is used. A Lean proof verifies its formal statement under its
hypotheses; the correspondence with the article requires mathematical review.
-/

open Filter Set Topology

namespace PG

namespace Classify

open Sums PPoint

variable (y : ℕ → ℤ)

/-- The sum of the images of the ultrafilters under `n ↦ c * y n`. -/
noncomputable def sumL : List (ℤ × Ultrafilter ℕ) → Ultrafilter ℤ
  | [] => pure 0
  | p :: l => (sumL l).bind (fun z => p.2.map (fun n => z + p.1 * y n))

theorem mem_sumL_cons (p : ℤ × Ultrafilter ℕ) (l : List (ℤ × Ultrafilter ℕ)) (A : Set ℤ) :
    A ∈ sumL y (p :: l) ↔ {z : ℤ | {n | z + p.1 * y n ∈ A} ∈ p.2} ∈ sumL y l := Iff.rfl

/-- The sum of the coefficients carried by `w`. -/
noncomputable def S (w : Ultrafilter ℕ) (l : List (ℤ × Ultrafilter ℕ)) : ℤ := by
  classical
  exact (l.map (fun p => if p.2 = w then p.1 else 0)).sum

/-- A bound for the coefficients. -/
def B (l : List (ℤ × Ultrafilter ℕ)) : ℤ := (l.map (fun p => |p.1|)).sum

theorem B_nonneg (l : List (ℤ × Ultrafilter ℕ)) : 0 ≤ B l :=
  List.sum_nonneg (fun a ha => by
    obtain ⟨p, _, rfl⟩ := List.mem_map.1 ha
    exact abs_nonneg _)

/-- The sum of the coefficients of `σ` over the set `E`. -/
noncomputable def cl (E : Set ℕ) (σ : ℕ →₀ ℤ) : ℤ := by
  classical
  exact aug (σ.filter (fun n => n ∈ E))

theorem cl_zero (E : Set ℕ) : cl E 0 = 0 := by
  classical
  unfold cl
  rw [Finsupp.filter_zero, aug_zero]

theorem cl_add (E : Set ℕ) (σ τ : ℕ →₀ ℤ) : cl E (σ + τ) = cl E σ + cl E τ := by
  classical
  unfold cl
  rw [Finsupp.filter_add, aug_add]

open scoped Classical in
theorem cl_single (E : Set ℕ) (n : ℕ) (a : ℤ) :
    cl E (Finsupp.single n a) = if n ∈ E then a else 0 := by
  classical
  unfold cl
  have h1 : (Finsupp.single n a).filter (fun m => m ∈ E) = if n ∈ E then Finsupp.single n a else 0 := by
    ext m
    rw [Finsupp.filter_apply]
    by_cases hnm : n = m
    · subst hnm
      split_ifs <;> simp
    · split_ifs <;> simp [Finsupp.single_eq_of_ne (Ne.symm hnm)]
  rw [h1]
  split_ifs
  · exact aug_single n a
  · exact aug_zero

theorem cl_smul (E : Set ℕ) (a : ℤ) (σ : ℕ →₀ ℤ) : cl E (a • σ) = a * cl E σ := by
  classical
  induction σ using Finsupp.induction_linear with
  | zero => simp [cl_zero]
  | add f g hf hg => rw [smul_add, cl_add, cl_add, hf, hg, mul_add]
  | single i b =>
    rw [Finsupp.smul_single, cl_single, cl_single, smul_eq_mul]
    split_ifs <;> simp

theorem cl_sum {ι : Type*} (E : Set ℕ) (s : Finset ι) (σ : ι → ℕ →₀ ℤ) :
    cl E (∑ i ∈ s, σ i) = ∑ i ∈ s, cl E (σ i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [cl_zero]
  | insert i s hi ih => rw [Finset.sum_insert hi, Finset.sum_insert hi, cl_add, ih]

/-- Values of coefficient vectors above `M` with the class sums of `l`. -/
def H (F : Ultrafilter ℕ → Set ℕ) (W : Set (Ultrafilter ℕ)) (l : List (ℤ × Ultrafilter ℕ)) (M : ℕ) : Set ℤ :=
  {z | ∃ σ : ℕ →₀ ℤ, Sparse.val y σ = z ∧ (∀ i, |σ i| ≤ B l) ∧ (∀ i, σ i ≠ 0 → M < i) ∧
    ∀ w ∈ W, cl (F w) σ = S w l}

theorem H_mem (F : Ultrafilter ℕ → Set ℕ) (W : Set (Ultrafilter ℕ))
    (hdis : ∀ w ∈ W, ∀ w' ∈ W, w ≠ w' → Disjoint (F w) (F w')) (l : List (ℤ × Ultrafilter ℕ))
    (hW : ∀ p ∈ l, p.2 ∈ W) (hF : ∀ p ∈ l, F p.2 ∈ p.2) (hv : ∀ p ∈ l, ∀ a, p.2 ≠ pure a) (M : ℕ) :
    H y F W l M ∈ sumL y l := by
  classical
  induction l with
  | nil =>
    show H y F W [] M ∈ (pure 0 : Ultrafilter ℤ)
    refine Ultrafilter.mem_pure.2 ⟨0, Sparse.val_zero y, fun i => ?_, fun i hi => absurd rfl hi, fun w _ => ?_⟩
    · simp [B]
    · rw [cl_zero]; simp [S]
  | cons p l ih =>
    rw [mem_sumL_cons]
    have h1 := ih (fun q hq => hW q (List.mem_cons_of_mem _ hq)) (fun q hq => hF q (List.mem_cons_of_mem _ hq))
      (fun q hq => hv q (List.mem_cons_of_mem _ hq))
    refine Filter.mem_of_superset (show _ ∈ (sumL y l : Filter ℤ) from h1) (fun z hz => ?_)
    obtain ⟨σ, hσv, hσb, hσM, hσc⟩ := hz
    have hp : p ∈ p :: l := List.mem_cons_self
    refine Filter.mem_of_superset (Filter.inter_mem (f := (p.2 : Filter ℕ)) (hF p hp)
      (above_mem p.2 (hv p hp) M)) (fun n hn => ?_)
    have hnF : n ∈ F p.2 := hn.1
    have hnM : M < n := hn.2
    refine ⟨σ + Finsupp.single n p.1, ?_, fun i => ?_, fun i hi => ?_, fun w hw => ?_⟩
    · rw [Sparse.val_add, hσv, val_single]
    · rw [Finsupp.add_apply]
      have h2 : |Finsupp.single n p.1 i| ≤ |p.1| := by
        rw [Finsupp.single_apply]
        split_ifs <;> simp
      have h3 : B (p :: l) = |p.1| + B l := by simp [B]
      have h4 := abs_add_le (σ i) (Finsupp.single n p.1 i)
      have h5 := hσb i
      omega
    · by_cases h : σ i = 0
      · rw [Finsupp.add_apply, h, zero_add, Finsupp.single_apply] at hi
        split_ifs at hi with h'
        · omega
        · exact absurd rfl hi
      · exact hσM i h
    · rw [cl_add, hσc w hw, cl_single]
      have h2 : S w (p :: l) = (if p.2 = w then p.1 else 0) + S w l := by
        unfold S
        rw [List.map_cons, List.sum_cons]
      rw [h2, add_comm]
      congr 1
      by_cases h : p.2 = w
      · rw [if_pos h, if_pos (h ▸ hnF)]
      · rw [if_neg h, if_neg]
        exact fun hc => Set.disjoint_left.1 (hdis p.2 (hW p hp) w hw h) hnF hc

/-- Changing one summand. -/
theorem diff_mem (w : Ultrafilter ℕ) (c : ℤ) (l : List (ℤ × Ultrafilter ℕ)) (hp : (c, w) ∈ l) :
    ∀ V ∈ sumL y l, ∃ G ∈ w, ∀ m ∈ G, ∀ m' ∈ G, ∃ a ∈ V, ∃ b ∈ V, c * (y m - y m') = a - b := by
  induction l with
  | nil => simp at hp
  | cons q l ih =>
    intro V hV
    rw [mem_sumL_cons] at hV
    rcases List.mem_cons.1 hp with h | h
    · subst h
      obtain ⟨z, hz⟩ := Ultrafilter.nonempty_of_mem hV
      refine ⟨_, hz, fun m hm m' hm' => ⟨_, hm, _, hm', ?_⟩⟩
      ring
    · obtain ⟨G, hG, h1⟩ := ih h _ hV
      refine ⟨G, hG, fun m hm m' hm' => ?_⟩
      obtain ⟨a, ha, b, hb, hab⟩ := h1 m hm m' hm'
      have ha' : {n | a + q.1 * y n ∈ V} ∈ q.2 := ha
      have hb' : {n | b + q.1 * y n ∈ V} ∈ q.2 := hb
      obtain ⟨n, hn1, hn2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (q.2 : Filter ℕ)) ha' hb')
      refine ⟨_, hn1, _, hn2, ?_⟩
      rw [hab]; ring

theorem diff_small (t : TopologicalSpace ℤ) (ht : @IsTopologicalAddGroup ℤ t _) (w : Ultrafilter ℕ)
    (l : List (ℤ × Ultrafilter ℕ)) (hu : (sumL y l : Filter ℤ) ≤ @nhds ℤ t 0) (d : ℤ)
    (hd : d ∈ AddSubgroup.closure {c : ℤ | (c, w) ∈ l}) :
    ∀ N ∈ @nhds ℤ t 0, ∃ G ∈ w, ∀ m ∈ G, ∀ m' ∈ G, d * (y m - y m') ∈ N := by
  letI := t
  haveI := ht
  refine AddSubgroup.closure_induction (p := fun x _ => ∀ N ∈ 𝓝 (0 : ℤ), ∃ G ∈ w, ∀ m ∈ G, ∀ m' ∈ G,
    x * (y m - y m') ∈ N) ?_ ?_ ?_ ?_ hd
  · intro c hc N hN
    obtain ⟨V, hV, _, hsum⟩ := few_small t ht 2 N hN
    obtain ⟨G, hG, h⟩ := diff_mem y w c l hc V (hu hV)
    obtain ⟨V', hV', hsym', hsum'⟩ := few_small t ht 2 V hV
    refine ?_
    obtain ⟨G', hG', h'⟩ := diff_mem y w c l hc (V ∩ (fun x => -x) ⁻¹' V) (hu (inter_mem hV
      ((continuous_neg.tendsto' (0 : ℤ) 0 neg_zero) hV)))
    refine ⟨G', hG', fun m hm m' hm' => ?_⟩
    obtain ⟨a, ha, b, hb, hab⟩ := h' m hm m' hm'
    have h1 := hsum (Finset.range 2) (by simp) (fun i => if i = 0 then a else -b) (fun i _ => by
      split_ifs
      · exact ha.1
      · exact hb.2)
    have h2 : ∑ i ∈ Finset.range 2, (if i = 0 then a else -b) = a - b := by
      rw [Finset.sum_range_succ, Finset.sum_range_one]
      simp only [if_true, if_neg (one_ne_zero : (1 : ℕ) ≠ 0)]
      omega
    rw [hab, ← h2]
    exact h1
  · intro N hN
    exact ⟨univ, Filter.univ_mem, fun m _ m' _ => by
      rw [zero_mul]; exact mem_of_mem_nhds hN⟩
  · intro x1 x2 _ _ h1 h2 N hN
    obtain ⟨V, hVo, hV0, hVV⟩ := exists_open_nhds_zero_half hN
    obtain ⟨G1, hG1, k1⟩ := h1 V (hVo.mem_nhds hV0)
    obtain ⟨G2, hG2, k2⟩ := h2 V (hVo.mem_nhds hV0)
    refine ⟨G1 ∩ G2, Filter.inter_mem (f := (w : Filter ℕ)) hG1 hG2, fun m hm m' hm' => ?_⟩
    rw [add_mul]
    exact hVV _ (k1 m hm.1 m' hm'.1) _ (k2 m hm.2 m' hm'.2)
  · intro x _ h N hN
    obtain ⟨G, hG, k⟩ := h _ ((continuous_neg.tendsto' (0 : ℤ) 0 neg_zero) hN)
    refine ⟨G, hG, fun m hm m' hm' => ?_⟩
    rw [neg_mul]
    exact k m hm m' hm'

/-- Finitely many different ultrafilters have pairwise disjoint members. -/
theorem exists_disjoint_members (W : Finset (Ultrafilter ℕ)) :
    ∃ F : Ultrafilter ℕ → Set ℕ, (∀ w ∈ W, F w ∈ w) ∧ ∀ w ∈ W, ∀ w' ∈ W, w ≠ w' → Disjoint (F w) (F w') := by
  classical
  have hsep : ∀ w w' : Ultrafilter ℕ, ∃ A : Set ℕ, w ≠ w' → A ∈ w ∧ Aᶜ ∈ w' := by
    intro w w'
    by_cases h : w = w'
    · exact ⟨univ, fun c => absurd h c⟩
    · have h1 : ¬ ∀ A : Set ℕ, A ∈ w → A ∈ w' := by
        intro hall
        have h2 : w' = w := Ultrafilter.eq_of_le (fun A hA => hall A hA)
        exact h h2.symm
      obtain ⟨A, hA⟩ := not_forall.1 h1
      obtain ⟨hAw, hAw'⟩ := Classical.not_imp.1 hA
      exact ⟨A, fun _ => ⟨hAw, Ultrafilter.compl_mem_iff_notMem.2 hAw'⟩⟩
  choose A hA using hsep
  refine ⟨fun w => ⋂ w' ∈ W.erase w, (A w w' ∩ (A w' w)ᶜ), fun w hw => ?_, fun w hw w' hw' hne => ?_⟩
  · refine (Filter.biInter_finset_mem _).2 (fun w' hw' => ?_)
    have hne : w' ≠ w := (Finset.mem_erase.1 hw').1
    exact Filter.inter_mem (f := (w : Filter ℕ)) (hA w w' hne.symm).1 (hA w' w hne).2
  · refine Set.disjoint_left.2 (fun n h1 h2 => ?_)
    have h3 := mem_iInter₂.1 h1 w' (Finset.mem_erase.2 ⟨hne.symm, hw'⟩)
    have h4 := mem_iInter₂.1 h2 w (Finset.mem_erase.2 ⟨hne, hw⟩)
    exact h4.2 h3.1

/-- The non-group case. -/
theorem not_group_of_sep (l : List (ℤ × Ultrafilter ℕ)) (hv : ∀ p ∈ l, ∀ a, p.2 ≠ pure a)
    (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l)
    (w : Ultrafilter ℕ) (hw : ∀ a, w ≠ pure a) (d : ℕ) (hd0 : 0 < d)
    (hd : (d : ℤ) ∈ AddSubgroup.closure {c : ℤ | (c, w) ∈ l}) (K : ℕ) (hK : 0 < K)
    (hsep : ∀ (n : ℕ) (T : ℤ), (∀ p ∈ l, p.2 ≠ w → T * S p.2 l = 0) →
      T * S w l ≠ -(((n * K + 1 : ℕ) : ℤ) * d)) :
    ¬ ∃ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ ∧
      ∀ O : Set ℤ, IsOpen[t] O ↔ IsOpenMod (genFam (Sel.ultraGen {sumL y l})) O := by
  classical
  obtain ⟨β, hβ, hβinf, hwt⟩ := Sparse.exists_weight y hpos hgrow
  obtain ⟨n0, hn0⟩ := hβinf (2 * d)
  have hgex : ∀ n : ℕ, ∃ g : ℕ, n < g ∧ 2 * ((n * K + 1) * d) ≤ β g := by
    intro n
    obtain ⟨m, hm⟩ := hβinf (2 * ((n * K + 1) * d))
    exact ⟨max m (n + 1), lt_of_lt_of_le (Nat.lt_succ_self n) (le_max_right _ _),
      hm.trans (hβ (le_max_left _ _))⟩
  choose g hgn hgβ using hgex
  -- classes
  set Wf : Finset (Ultrafilter ℕ) := insert w ((l.map Prod.snd).toFinset) with hWf
  obtain ⟨F, hFm, hFd⟩ := exists_disjoint_members Wf
  have hwW : w ∈ Wf := Finset.mem_insert_self _ _
  have hlW : ∀ p ∈ l, p.2 ∈ Wf := fun p hp =>
    Finset.mem_insert_of_mem (List.mem_toFinset.2 (List.mem_map_of_mem hp))
  set E : Set ℕ := F w with hE
  have hEw : E ∈ w := hFm w hwW
  let N : ℕ → ℕ := fun n => n * K + 1
  let ρ : ℕ → ℕ → ℕ → (ℕ →₀ ℤ) := fun n p q =>
    Finsupp.single n (d : ℤ) + Finsupp.single p (((n * K) * d : ℕ) : ℤ)
      + Finsupp.single q (-(((N n) * d : ℕ) : ℤ))
  let A : Set ℤ := {x | ∃ n p q, n0 ≤ n ∧ g n ≤ p ∧ p < q ∧ n ∈ E ∧ p ∈ E ∧ q ∈ E ∧
    x = Sparse.val y (ρ n p q)}
  have hρapp : ∀ n p q i, n < p → p < q → ρ n p q i =
      (if n = i then (d : ℤ) else 0) + (if p = i then (((n * K) * d : ℕ) : ℤ) else 0)
        + (if q = i then -(((N n) * d : ℕ) : ℤ) else 0) := by
    intro n p q i _ _
    show (Finsupp.single n (d : ℤ) + Finsupp.single p (((n * K) * d : ℕ) : ℤ)
      + Finsupp.single q (-(((N n) * d : ℕ) : ℤ))) i = _
    rw [Finsupp.add_apply, Finsupp.add_apply, Finsupp.single_apply, Finsupp.single_apply,
      Finsupp.single_apply]
  have hNd : ∀ n, ((n * K) * d) ≤ (N n) * d ∧ d ≤ (N n) * d := fun n =>
    ⟨Nat.mul_le_mul_right d (Nat.le_succ _), Nat.le_mul_of_pos_left d (Nat.succ_pos _)⟩
  -- admissibility of `ρ - τ`
  have hbound : ∀ (R M : ℕ), 2 * R + 2 ≤ β M → ∀ n p q, n0 ≤ n → g n ≤ p → p < q →
      ∀ τ : ℕ →₀ ℤ, (∀ i, |τ i| ≤ (R : ℤ)) → (∀ i, τ i ≠ 0 → M < i) →
        ∀ i, |(ρ n p q - τ) i| ≤ (β i : ℤ) := by
    intro R M hM n p q hn hp hpq τ hτ hτM i
    have hnp : n < p := lt_of_lt_of_le (hgn n) hp
    have hpβ : 2 * ((N n) * d) ≤ β p := (hgβ n).trans (hβ hp)
    have hqβ : 2 * ((N n) * d) ≤ β q := hpβ.trans (hβ (le_of_lt hpq))
    have hnβ : 2 * d ≤ β n := hn0.trans (hβ hn)
    have hτi : |τ i| ≤ (R : ℤ) := hτ i
    have hτbig : τ i ≠ 0 → 2 * R + 2 ≤ β i := fun h => hM.trans (hβ (le_of_lt (hτM i h)))
    -- the value of `ρ` at `i` and a bound for it
    have key : ∀ a : ℕ, |(ρ n p q) i| ≤ (a : ℤ) → 2 * a ≤ β i → |(ρ n p q - τ) i| ≤ (β i : ℤ) := by
      intro a h1 h2
      rw [Finsupp.sub_apply]
      have h3 := abs_sub ((ρ n p q) i) (τ i)
      by_cases h4 : τ i = 0
      · rw [h4, sub_zero]
        exact h1.trans (by exact_mod_cast (le_trans (by omega) h2))
      · have h5 := hτbig h4
        have h6 : a + R ≤ β i := by omega
        have h7 : (a : ℤ) + (R : ℤ) ≤ (β i : ℤ) := by exact_mod_cast h6
        omega
    have hv := hρapp n p q i hnp hpq
    by_cases h1 : n = i
    · have h2 : ¬ p = i := by omega
      have h3 : ¬ q = i := by omega
      rw [if_pos h1, if_neg h2, if_neg h3, add_zero, add_zero] at hv
      exact key d (by rw [hv, abs_of_nonneg (Int.natCast_nonneg _)]) (h1 ▸ hnβ)
    · by_cases h2 : p = i
      · have h3 : ¬ q = i := by omega
        rw [if_neg h1, if_pos h2, if_neg h3, zero_add, add_zero] at hv
        refine key ((N n) * d) ?_ (h2 ▸ hpβ)
        rw [hv, abs_of_nonneg (Int.natCast_nonneg _)]
        exact_mod_cast (hNd n).1
      · by_cases h3 : q = i
        · rw [if_neg h1, if_neg h2, if_pos h3, zero_add, zero_add] at hv
          refine key ((N n) * d) ?_ (h3 ▸ hqβ)
          rw [hv, abs_neg, abs_of_nonneg (Int.natCast_nonneg _)]
        · rw [if_neg h1, if_neg h2, if_neg h3, add_zero, add_zero] at hv
          rw [Finsupp.sub_apply, hv, zero_sub, abs_neg]
          by_cases h4 : τ i = 0
          · rw [h4, abs_zero]; exact Int.natCast_nonneg _
          · have h5 := hτbig h4
            have h6 : R ≤ β i := by omega
            exact hτi.trans (by exact_mod_cast h6)
  have hA0 : (0 : ℤ) ∉ A := by
    rintro ⟨n, p, q, hn, hp, hpq, _, _, _, h0⟩
    have hnp : n < p := lt_of_lt_of_le (hgn n) hp
    have h1 : ∀ i, |(ρ n p q - 0) i| ≤ (β i : ℤ) :=
      hbound 0 (g 0) (by
        have h2 := hgβ 0
        have h3 : 1 ≤ (0 * K + 1) * d := by omega
        omega) n p q hn hp hpq 0 (fun i => by simp) (fun i hi => absurd rfl hi)
    rw [sub_zero] at h1
    have h2 : ρ n p q = 0 := Sparse.val_inj hpos hβ hwt _ _ h1 (fun i => by simp)
      (by rw [Sparse.val_zero]; exact h0.symm)
    have h3 := congrArg (fun f : ℕ →₀ ℤ => f q) h2
    simp only [Finsupp.zero_apply] at h3
    rw [hρapp n p q q hnp hpq, if_neg (by omega), if_neg (by omega), if_pos rfl, zero_add, zero_add] at h3
    have h4 : 0 < (N n) * d := Nat.mul_pos (Nat.succ_pos _) hd0
    omega
  -- `A` has no limits
  have hopen : IsOpenMod (genFam (Sel.ultraGen {sumL y l})) Aᶜ := by
    intro z hz G hG hconv
    by_contra hno
    have hne : (G ⊓ 𝓟 A).NeBot := by
      rw [neBot_iff]
      intro h
      exact hno (inf_principal_eq_bot.1 h)
    obtain ⟨P, hP⟩ := Ultrafilter.exists_le (G ⊓ 𝓟 A)
    have hPG : (P : Filter ℤ) ≤ G := hP.trans inf_le_left
    have hPA : A ∈ P := le_principal_iff.1 (hP.trans inf_le_right)
    have hq' : (P.map (fun x => x - z) : Filter ℤ) ≤ Filter.map (fun x => x - z) G := by
      rw [Ultrafilter.coe_map]
      exact Filter.map_mono hPG
    obtain ⟨σ0, hσ0, hle⟩ := hconv.2 (P.map (fun x => x - z)) hq'
    obtain ⟨ι, _, u, ε, hu, hε, hrep⟩ := Sel.rep_of_sumClosure _ hσ0
    set R : ℕ := Fintype.card ι * (B l).toNat with hR
    set T : ℤ := ∑ i, ε i with hT
    have hBl : ((B l).toNat : ℤ) = B l := Int.toNat_of_nonneg (B_nonneg l)
    -- vectors for the elements of the filter sum
    have hS : ∀ M : ℕ, {x : ℤ | ∃ τ : ℕ →₀ ℤ, (∀ i, |τ i| ≤ (R : ℤ)) ∧ (∀ i, τ i ≠ 0 → M < i) ∧
        (∀ w' ∈ (Wf : Set (Ultrafilter ℕ)), cl (F w') τ = T * S w' l) ∧ x - z = Sparse.val y τ} ∈ P := by
      intro M
      have h1 : ∀ i, H y F Wf l M ∈ u i := by
        intro i
        have h2 : u i = sumL y l := hu i
        rw [h2]
        exact H_mem y F Wf (fun a ha b hb => hFd a ha b hb) l hlW (fun p hp => hFm _ (hlW p hp)) hv M
      have h3 : {x : ℤ | ∃ τ : ℕ →₀ ℤ, (∀ i, |τ i| ≤ (R : ℤ)) ∧ (∀ i, τ i ≠ 0 → M < i) ∧
          (∀ w' ∈ (Wf : Set (Ultrafilter ℕ)), cl (F w') τ = T * S w' l) ∧ x = Sparse.val y τ} ∈ σ0 := by
        refine Filter.mem_of_superset (hrep (fun _ => H y F Wf l M) h1) ?_
        rintro x ⟨a, ha, rfl⟩
        choose σ hσv hσb hσM hσc using ha
        refine ⟨∑ i, ε i • σ i, fun j => ?_, fun j hj => ?_, fun w' hw' => ?_, ?_⟩
        · rw [Finsupp.finsetSum_apply]
          refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
          have h4 : ∀ i ∈ Finset.univ, |(ε i • σ i) j| ≤ B l := by
            intro i _
            rw [Finsupp.smul_apply, smul_eq_mul, abs_mul]
            have h5 : |ε i| = 1 := by
              rcases hε i with h | h <;> rw [h] <;> simp
            rw [h5, one_mul]
            exact hσb i j
          refine (Finset.sum_le_sum h4).trans ?_
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, hR]
          push_cast
          rw [hBl]
        · by_contra hc
          refine hj ?_
          rw [Finsupp.finsetSum_apply]
          refine Finset.sum_eq_zero (fun i _ => ?_)
          rw [Finsupp.smul_apply]
          have h4 : σ i j = 0 := by
            by_contra h5
            exact hc (hσM i j h5)
          rw [h4, smul_zero]
        · rw [cl_sum, hT, Finset.sum_mul]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [cl_smul, hσc i w' hw']
        · rw [Sparse.val_finset_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [val_smul, hσv i, smul_eq_mul]
      exact hle h3
    obtain ⟨M1, hM1β, hM1R⟩ : ∃ M1 : ℕ, 2 * R + 2 ≤ β M1 ∧ R < M1 := by
      obtain ⟨m, hm⟩ := hβinf (2 * R + 2)
      exact ⟨max m (R + 1), hm.trans (hβ (le_max_left _ _)),
        lt_of_lt_of_le (Nat.lt_succ_self R) (le_max_right _ _)⟩
    have hτadm : ∀ τ : ℕ →₀ ℤ, (∀ i, |τ i| ≤ (R : ℤ)) → (∀ i, τ i ≠ 0 → M1 < i) →
        ∀ i, |τ i| ≤ (β i : ℤ) := by
      intro τ hτ hτM i
      by_cases h : τ i = 0
      · rw [h, abs_zero]; exact Int.natCast_nonneg _
      · have h1 : 2 * R + 2 ≤ β i := hM1β.trans (hβ (le_of_lt (hτM i h)))
        have h2 : R ≤ β i := by omega
        exact (hτ i).trans (by exact_mod_cast h2)
    have hpoint : ∀ M : ℕ, M1 ≤ M → ∀ Q : Set ℤ, Q ∈ P → ∃ n p q, n0 ≤ n ∧ g n ≤ p ∧ p < q ∧ n ∈ E ∧
        p ∈ E ∧ q ∈ E ∧ Sparse.val y (ρ n p q) ∈ Q ∧ ∃ τ : ℕ →₀ ℤ, (∀ i, |τ i| ≤ (R : ℤ)) ∧
        (∀ i, τ i ≠ 0 → M < i) ∧ (∀ w' ∈ (Wf : Set (Ultrafilter ℕ)), cl (F w') τ = T * S w' l) ∧
        z = Sparse.val y (ρ n p q - τ) ∧ ∀ i, |(ρ n p q - τ) i| ≤ (β i : ℤ) := by
      intro M hM Q hQ
      obtain ⟨x, ⟨hxA, hxS⟩, hxQ⟩ := Ultrafilter.nonempty_of_mem
        (inter_mem (inter_mem (f := (P : Filter ℤ)) hPA (hS M)) hQ)
      obtain ⟨n, p, q, hn, hp, hpq, hnE, hpE, hqE, rfl⟩ := hxA
      obtain ⟨τ, hτ, hτM, hτc, hτz⟩ := hxS
      refine ⟨n, p, q, hn, hp, hpq, hnE, hpE, hqE, hxQ, τ, hτ, hτM, hτc, ?_,
        hbound R M (hM1β.trans (hβ hM)) n p q hn hp hpq τ hτ hτM⟩
      have h1 : Sparse.val y (ρ n p q - τ) = Sparse.val y (ρ n p q) - Sparse.val y τ := by
        have h2 := Sparse.val_add y (ρ n p q - τ) τ
        rw [sub_add_cancel] at h2
        omega
      rw [h1]
      omega
    obtain ⟨n1, p1, q1, _, _, _, _, _, _, _, τ1, _, _, _, hz1, hadm1⟩ := hpoint M1 le_rfl univ univ_mem
    set c := ρ n1 p1 q1 - τ1 with hc
    set M := max M1 (c.support.sup id) with hM
    have hMM1 : M1 ≤ M := le_max_left _ _
    have hcM : ∀ i, c i ≠ 0 → i ≤ M := fun i hi =>
      le_trans (Finset.le_sup (f := id) (Finsupp.mem_support_iff.2 hi)) (le_max_right _ _)
    have hfin : {x : ℤ | ∃ n p q, n < p ∧ p < q ∧ q ≤ M ∧ x = Sparse.val y (ρ n p q)}.Finite := by
      refine (((finite_Iic M).prod ((finite_Iic M).prod (finite_Iic M))).image
        (fun a : ℕ × ℕ × ℕ => Sparse.val y (ρ a.1 a.2.1 a.2.2))).subset ?_
      rintro x ⟨n, p, q, h1, h2, h3, rfl⟩
      exact ⟨(n, p, q), ⟨mem_Iic.2 (le_trans (le_of_lt (lt_trans h1 h2)) h3),
        mem_Iic.2 (le_trans (le_of_lt h2) h3), mem_Iic.2 h3⟩, rfl⟩
    rcases P.mem_or_compl_mem {x : ℤ | ∃ n p q, n < p ∧ p < q ∧ q ≤ M ∧ x = Sparse.val y (ρ n p q)}
      with hsmall | hbig
    · obtain ⟨x0, _, hx0⟩ := Ultrafilter.eq_pure_of_finite_mem hfin hsmall
      have hx0A : x0 ∈ A := by
        have := hPA
        rw [hx0] at this
        exact Ultrafilter.mem_pure.1 this
      have key : ∀ k : ℕ, ∃ τ : ℕ →₀ ℤ, (∀ i, |τ i| ≤ (R : ℤ)) ∧ (∀ i, τ i ≠ 0 → k < i) ∧
          x0 - z = Sparse.val y τ := by
        intro k
        have h1 := hS k
        rw [hx0] at h1
        obtain ⟨τ, hτ, hτM, _, hτz⟩ := Ultrafilter.mem_pure.1 h1
        exact ⟨τ, hτ, hτM, hτz⟩
      obtain ⟨τa, hτa, hτaM, ha⟩ := key M1
      obtain ⟨τb, hτb, hτbM, hb⟩ := key (max M1 (τa.support.sup id))
      have heq : τb = τa := Sparse.val_inj hpos hβ hwt τb τa
        (hτadm τb hτb (fun i hi => lt_of_le_of_lt (le_max_left _ _) (hτbM i hi)))
        (hτadm τa hτa hτaM) (by rw [← hb, ← ha])
      have hτa0 : τa = 0 := by
        ext i
        by_contra hi
        have hi' : τa i ≠ 0 := hi
        have h1 : max M1 (τa.support.sup id) < i := hτbM i (heq ▸ hi')
        have h2 : i ≤ τa.support.sup id := Finset.le_sup (f := id) (Finsupp.mem_support_iff.2 hi')
        have h3 := lt_of_le_of_lt (le_max_right _ _) h1
        omega
      have hxz : x0 = z := by
        rw [hτa0, Sparse.val_zero] at ha
        omega
      exact hz (hxz ▸ hx0A)
    · obtain ⟨n, p, q, hn, hp, hpq, hnE, hpE, hqE, hxQ, τ, hτ, hτM, hτc, hzτ, hadm⟩ := hpoint M hMM1 _ hbig
      have hnp : n < p := lt_of_lt_of_le (hgn n) hp
      have hMq : M < q := by
        by_contra h
        exact hxQ ⟨n, p, q, hnp, hpq, not_lt.1 h, rfl⟩
      have heq : ρ n p q - τ = c := Sparse.val_inj hpos hβ hwt _ _ hadm hadm1 (by rw [← hzτ, ← hz1])
      have hρτ : ∀ i, ρ n p q i = c i + τ i := fun i => by
        have h1 := congrArg (fun f : ℕ →₀ ℤ => f i) heq
        simp only [Finsupp.sub_apply] at h1
        omega
      have hcq : c q = 0 := by
        by_contra h
        have := hcM q h
        omega
      have hτq : τ q = -(((N n) * d : ℕ) : ℤ) := by
        have h1 := hρτ q
        rw [hρapp n p q q hnp hpq, if_neg (by omega), if_neg (by omega), if_pos rfl, zero_add, zero_add,
          hcq, zero_add] at h1
        exact h1.symm
      have hNR : (N n) * d ≤ R := by
        have h1 := hτ q
        rw [hτq, abs_neg, abs_of_nonneg (Int.natCast_nonneg _)] at h1
        exact_mod_cast h1
      have hnM : n ≤ M := by
        have h1 : n ≤ n * K := Nat.le_mul_of_pos_right n hK
        have h2 : N n ≤ (N n) * d := Nat.le_mul_of_pos_right _ hd0
        have h3 : N n = n * K + 1 := rfl
        omega
      -- `τ` is the part of `ρ` above `M`
      have hτsupp : ∀ i, i ≠ p → i ≠ q → τ i = 0 := by
        intro i hip hiq
        by_contra h
        have h1 : M < i := hτM i h
        have h2 : c i = 0 := by
          by_contra h3
          have := hcM i h3
          omega
        have h3 := hρτ i
        rw [hρapp n p q i hnp hpq, if_neg (by omega), if_neg (Ne.symm hip), if_neg (Ne.symm hiq),
          h2] at h3
        exact h (by simpa using h3.symm)
      have hτform : τ = Finsupp.single p (τ p) + Finsupp.single q (τ q) := by
        ext i
        rw [Finsupp.add_apply, Finsupp.single_apply, Finsupp.single_apply]
        by_cases h1 : p = i
        · rw [if_pos h1, if_neg (by omega), add_zero, h1]
        · by_cases h2 : q = i
          · rw [if_neg h1, if_pos h2, zero_add, h2]
          · rw [if_neg h1, if_neg h2, add_zero]
            exact hτsupp i (Ne.symm h1) (Ne.symm h2)
      have hτp : τ p = 0 ∨ τ p = (((n * K) * d : ℕ) : ℤ) := by
        by_cases h : τ p = 0
        · exact Or.inl h
        · refine Or.inr ?_
          have h1 : M < p := hτM p h
          have h2 : c p = 0 := by
            by_contra h3
            have := hcM p h3
            omega
          have h3 := hρτ p
          rw [hρapp n p q p hnp hpq, if_neg (by omega), if_pos rfl, if_neg (by omega), zero_add, add_zero,
            h2, zero_add] at h3
          exact h3.symm
      have hclw : ∀ w' ∈ Wf, cl (F w') τ = if w' = w then τ p + τ q else 0 := by
        intro w' hw'
        rw [congrArg (cl (F w')) hτform, cl_add, cl_single, cl_single]
        by_cases h : w' = w
        · rw [if_pos h, h, if_pos hpE, if_pos hqE]
        · have h1 : p ∉ F w' := fun c1 => Set.disjoint_left.1 (hFd w hwW w' hw' (Ne.symm h)) hpE c1
          have h2 : q ∉ F w' := fun c1 => Set.disjoint_left.1 (hFd w hwW w' hw' (Ne.symm h)) hqE c1
          rw [if_neg h, if_neg h1, if_neg h2, add_zero]
      have hother : ∀ pr ∈ l, pr.2 ≠ w → T * S pr.2 l = 0 := by
        intro pr hpr hne'
        have h1 := hτc pr.2 (hlW pr hpr)
        rw [hclw pr.2 (hlW pr hpr), if_neg hne'] at h1
        exact h1.symm
      have hmain : T * S w l = τ p + τ q := by
        have h1 := hτc w hwW
        rw [hclw w hwW, if_pos rfl] at h1
        exact h1.symm
      rcases hτp with h | h
      · refine hsep n T hother ?_
        rw [hmain, h, hτq, zero_add]
        show -(((n * K + 1) * d : ℕ) : ℤ) = -(((n * K + 1 : ℕ) : ℤ) * d)
        push_cast
        ring
      · refine hsep 0 T hother ?_
        rw [hmain, h, hτq]
        show (((n * K) * d : ℕ) : ℤ) + -(((n * K + 1) * d : ℕ) : ℤ) = -(((0 * K + 1 : ℕ) : ℤ) * d)
        push_cast
        ring
  -- no group topology
  rintro ⟨t, ht, hopent⟩
  letI := t
  haveI := ht
  have hOo : IsOpen[t] Aᶜ := (hopent _).2 hopen
  have hOn : Aᶜ ∈ 𝓝 (0 : ℤ) := @IsOpen.mem_nhds ℤ t 0 Aᶜ hOo hA0
  have hut : (sumL y l : Filter ℤ) ≤ 𝓝 0 := by
    have hCnull : NullFamily (genFam (Sel.ultraGen {sumL y l})) := genFam_nullFamily _
    have huC : (sumL y l : Filter ℤ) ∈ genFam (Sel.ultraGen {sumL y l}) :=
      ⟨(sumL y l).neBot, fun U hU => ⟨_, SumClosure.gen ⟨sumL y l, rfl, rfl⟩, hU⟩⟩
    intro X hX
    obtain ⟨X', hX'X, hX'o, hX'0⟩ := (@mem_nhds_iff ℤ t 0 X).1 hX
    refine mem_of_superset ?_ hX'X
    exact (hopent X').1 hX'o 0 hX'0 _ (sumL y l).neBot ((conv_zero _ _).2 huC)
  have halve : ∀ X : Set ℤ, X ∈ 𝓝 (0 : ℤ) → ∃ H' ∈ 𝓝 (0 : ℤ), ∀ a ∈ H', ∀ b ∈ H', a + b ∈ X := by
    intro X hX
    obtain ⟨H', hH, h⟩ := (nhds_zero_isNbhdFilter (G := ℤ)).halve X hX
    exact ⟨H', hH, h⟩
  choose half hhalf hadd using halve
  let Wn : ℕ → {X : Set ℤ // X ∈ 𝓝 (0 : ℤ)} := fun n =>
    Nat.rec ⟨Aᶜ, hOn⟩ (fun _ X => ⟨half X.1 X.2, hhalf X.1 X.2⟩) n
  have hWadd : ∀ n, ∀ a ∈ (Wn (n + 1)).1, ∀ b ∈ (Wn (n + 1)).1, a + b ∈ (Wn n).1 :=
    fun n => hadd (Wn n).1 (Wn n).2
  have h0W : ∀ n, (0 : ℤ) ∈ (Wn n).1 := fun n => mem_of_mem_nhds (Wn n).2
  have hWsum : ∀ (n j : ℕ) (z : ℕ → ℤ), (∀ i < n, z i ∈ (Wn (j + i + 1)).1) →
      ∑ i ∈ Finset.range n, z i ∈ (Wn j).1 := by
    intro n
    induction n with
    | zero => intro j z _; simpa using h0W j
    | succ n ih =>
      intro j z hz
      rw [Finset.sum_range_succ', add_comm]
      refine hWadd j _ (hz 0 (Nat.succ_pos _)) _ (ih (j + 1) (fun i => z (i + 1)) (fun i hi => ?_))
      have := hz (i + 1) (Nat.succ_lt_succ hi)
      rwa [show j + 1 + i + 1 = j + (i + 1) + 1 by omega]
  have hsm : ∀ i, ∃ G ∈ w, ∀ m ∈ G, ∀ m' ∈ G, (d : ℤ) * (y m - y m') ∈ (Wn (i + 1)).1 := fun i =>
    diff_small y t ht w l hut (d : ℤ) hd _ (Wn (i + 1)).2
  choose G hGw hGd using hsm
  obtain ⟨n, ⟨hnG, hnE⟩, hnn0⟩ := Ultrafilter.nonempty_of_mem
    (inter_mem (inter_mem (f := (w : Filter ℕ)) (hGw 0) hEw) (above_mem w hw n0))
  have hn0n : n0 ≤ n := le_of_lt hnn0
  have hI : (⋂ i ∈ Finset.range (N n + 1), G i) ∩ E ∈ (w : Filter ℕ) :=
    inter_mem ((Filter.biInter_finset_mem _).2 (fun i _ => hGw i)) hEw
  obtain ⟨p, hpI, hpg⟩ := Ultrafilter.nonempty_of_mem (inter_mem hI (above_mem w hw (g n)))
  obtain ⟨q, hqI, hqp⟩ := Ultrafilter.nonempty_of_mem (inter_mem hI (above_mem w hw p))
  have hpG : ∀ i < N n + 1, p ∈ G i := fun i hi => mem_iInter₂.1 hpI.1 i (Finset.mem_range.2 hi)
  have hqG : ∀ i < N n + 1, q ∈ G i := fun i hi => mem_iInter₂.1 hqI.1 i (Finset.mem_range.2 hi)
  have hmem : Sparse.val y (ρ n p q) ∈ A :=
    ⟨n, p, q, hn0n, le_of_lt hpg, hqp, hnE, hpI.2, hqI.2, rfl⟩
  let z : ℕ → ℤ := fun i => if i = 0 then (d : ℤ) * (y n - y p) else (d : ℤ) * (y p - y q)
  have hz : ∀ i < N n + 1, z i ∈ (Wn (0 + i + 1)).1 := by
    intro i hi
    rw [Nat.zero_add]
    show (if i = 0 then (d : ℤ) * (y n - y p) else (d : ℤ) * (y p - y q)) ∈ (Wn (i + 1)).1
    split_ifs with h
    · rw [h]
      exact hGd 0 n hnG p (hpG 0 (Nat.succ_pos _))
    · exact hGd i p (hpG i hi) q (hqG i hi)
  have hsum := hWsum (N n + 1) 0 z hz
  have hval : ∑ i ∈ Finset.range (N n + 1), z i = Sparse.val y (ρ n p q) := by
    rw [Finset.sum_range_succ']
    have h1 : ∀ i ∈ Finset.range (N n), z (i + 1) = (d : ℤ) * (y p - y q) := fun i _ => if_neg (by omega)
    have h2 : z 0 = (d : ℤ) * (y n - y p) := if_pos rfl
    rw [Finset.sum_congr rfl h1, h2, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    have h3 : Sparse.val y (ρ n p q) = (d : ℤ) * y n + (((n * K) * d : ℕ) : ℤ) * y p
        + (-(((N n) * d : ℕ) : ℤ)) * y q := by
      show Sparse.val y (Finsupp.single n (d : ℤ) + Finsupp.single p (((n * K) * d : ℕ) : ℤ)
        + Finsupp.single q (-(((N n) * d : ℕ) : ℤ))) = _
      rw [Sparse.val_add, Sparse.val_add, val_single, val_single, val_single]
    rw [h3]
    show (((n * K + 1 : ℕ)) : ℤ) * ((d : ℤ) * (y p - y q)) + (d : ℤ) * (y n - y p) = _
    show _ = (d : ℤ) * y n + (((n * K) * d : ℕ) : ℤ) * y p + (-(((n * K + 1) * d : ℕ) : ℤ)) * y q
    push_cast
    ring
  rw [hval] at hsum
  exact hsum hmem

section One

/-- Multiples of a null filter are null. -/
theorem zmul_mem {C : Set (Filter ℤ)} (hC : NullFamily C) {a : Filter ℤ} (ha : a ∈ C) (k : ℤ) :
    Filter.map (fun x => k * x) a ∈ C := by
  haveI : a.NeBot := hC.ne a ha
  have hnat : ∀ n : ℕ, Filter.map (fun x => (n : ℤ) * x) a ∈ C := by
    intro n
    induction n with
    | zero =>
      have h1 : Filter.map (fun x : ℤ => ((0 : ℕ) : ℤ) * x) a = pure 0 := by
        have h2 : (fun x : ℤ => ((0 : ℕ) : ℤ) * x) = fun _ => 0 := by funext x; simp
        rw [h2, Filter.map_const]
      rw [h1]; exact hC.pure_zero
    | succ n ih =>
      refine hC.finer _ (hC.add _ ih _ ha) _ ?_ (Filter.NeBot.map inferInstance _)
      intro s hs
      obtain ⟨s1, hs1, s2, hs2, hsub⟩ := Filter.mem_map₂_iff.1 hs
      refine Filter.mem_map.2 (Filter.mem_of_superset (Filter.inter_mem hs1 hs2) (fun x hx => ?_))
      have h1 := hsub (mem_image2_of_mem (show (n : ℤ) * x ∈ s1 from hx.1) hx.2)
      show ((n + 1 : ℕ) : ℤ) * x ∈ s
      have h2 : ((n + 1 : ℕ) : ℤ) * x = (n : ℤ) * x + x := by push_cast; ring
      rw [h2]; exact h1
  rcases Int.eq_nat_or_neg k with ⟨n, rfl | rfl⟩
  · exact hnat n
  · have h1 : Filter.map (fun x => -(n : ℤ) * x) a
        = Filter.map (fun x : ℤ => -x) (Filter.map (fun x => (n : ℤ) * x) a) := by
      rw [Filter.map_map]
      congr 1
      funext x
      simp
    rw [h1]
    exact hC.neg _ (hnat n)

theorem sumL_mem_of_base {C : Set (Filter ℤ)} (hC : NullFamily C) (w : Ultrafilter ℕ) (d : ℤ)
    (ha : ((w.map (fun n => d * y n)) : Filter ℤ) ∈ C) (l : List (ℤ × Ultrafilter ℕ))
    (hlw : ∀ p ∈ l, p.2 = w) (hdiv : ∀ p ∈ l, d ∣ p.1) : (sumL y l : Filter ℤ) ∈ C := by
  induction l with
  | nil =>
    show ((pure 0 : Ultrafilter ℤ) : Filter ℤ) ∈ C
    rw [Ultrafilter.coe_pure]
    exact hC.pure_zero
  | cons p l ih =>
    have h1 := ih (fun q hq => hlw q (List.mem_cons_of_mem _ hq)) (fun q hq => hdiv q (List.mem_cons_of_mem _ hq))
    obtain ⟨k, hk⟩ := hdiv p List.mem_cons_self
    have h2 := zmul_mem hC ha k
    refine hC.finer _ (hC.add _ h1 _ h2) _ ?_ (sumL y (p :: l)).neBot
    intro X hX
    obtain ⟨s1, hs1, s2, hs2, hsub⟩ := Filter.mem_map₂_iff.1 hX
    show X ∈ sumL y (p :: l)
    rw [mem_sumL_cons]
    refine Filter.mem_of_superset (show s1 ∈ (sumL y l : Filter ℤ) from hs1) (fun z hz => ?_)
    have h3 : {n | k * (d * y n) ∈ s2} ∈ w := by
      have h4 : (fun x => k * x) ⁻¹' s2 ∈ w.map (fun n => d * y n) := Filter.mem_map.1 hs2
      exact h4
    rw [← hlw p List.mem_cons_self] at h3
    refine Filter.mem_of_superset (show _ ∈ (p.2 : Filter ℕ) from h3) (fun n hn => ?_)
    have h5 := hsub (mem_image2_of_mem hz hn)
    show z + p.1 * y n ∈ X
    have h6 : p.1 * y n = k * (d * y n) := by rw [hk]; ring
    rw [h6]; exact h5

/-- The sum of the coefficients times `y n` is an element of the sum plus differences. -/
theorem total_term (w : Ultrafilter ℕ) (l : List (ℤ × Ultrafilter ℕ)) (hlw : ∀ p ∈ l, p.2 = w) :
    ∀ V ∈ sumL y l, ∃ a ∈ V, ∃ G ∈ w, ∀ n ∈ G, ∃ δ : Fin l.length → ℤ,
      (∀ i, ∃ s ∈ V, ∃ t ∈ V, δ i = s - t) ∧ (l.map Prod.fst).sum * y n = a + ∑ i, δ i := by
  induction l with
  | nil =>
    intro V hV
    have h0 : (0 : ℤ) ∈ V := Ultrafilter.mem_pure.1 hV
    exact ⟨0, h0, univ, Filter.univ_mem, fun n _ => ⟨fun i => i.elim0, fun i => i.elim0, by simp⟩⟩
  | cons p l ih =>
    intro V hV
    rw [mem_sumL_cons] at hV
    have hpw : p.2 = w := hlw p List.mem_cons_self
    obtain ⟨a, ha, G, hG, h⟩ := ih (fun q hq => hlw q (List.mem_cons_of_mem _ hq)) _ hV
    have ha' : {n | a + p.1 * y n ∈ V} ∈ w := hpw ▸ ha
    obtain ⟨k0, hk0⟩ := Ultrafilter.nonempty_of_mem ha'
    refine ⟨a + p.1 * y k0, hk0, G ∩ {n | a + p.1 * y n ∈ V},
      Filter.inter_mem (f := (w : Filter ℕ)) hG ha', fun n hn => ?_⟩
    obtain ⟨δ, hδ, heq⟩ := h n hn.1
    have lift : ∀ i, ∃ s ∈ V, ∃ t ∈ V, δ i = s - t := by
      intro i
      obtain ⟨s, hs, t, ht, hst⟩ := hδ i
      have hs' : {n | s + p.1 * y n ∈ V} ∈ p.2 := hs
      have ht' : {n | t + p.1 * y n ∈ V} ∈ p.2 := ht
      obtain ⟨m, hm1, hm2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (p.2 : Filter ℕ)) hs' ht')
      exact ⟨_, hm1, _, hm2, by rw [hst]; ring⟩
    refine ⟨Fin.cons (p.1 * (y n - y k0)) δ, fun i => ?_, ?_⟩
    · refine Fin.cases ?_ (fun j => ?_) i
      · rw [Fin.cons_zero]
        exact ⟨_, hn.2, _, hk0, by ring⟩
      · rw [Fin.cons_succ]
        exact lift j
    · rw [List.map_cons, List.sum_cons]
      show (p.1 + (l.map Prod.fst).sum) * y n = a + p.1 * y k0 + ∑ i : Fin (l.length + 1), _
      rw [Fin.sum_univ_succ]
      simp only [Fin.cons_zero, Fin.cons_succ]
      rw [add_mul, heq]
      ring

theorem total_mem {C : Set (Filter ℤ)} (hC : NullFamily C) (w : Ultrafilter ℕ)
    (l : List (ℤ × Ultrafilter ℕ)) (hlw : ∀ p ∈ l, p.2 = w) (hu : (sumL y l : Filter ℤ) ∈ C) :
    ((w.map (fun n => (l.map Prod.fst).sum * y n)) : Filter ℤ) ∈ C := by
  set u : Filter ℤ := (sumL y l : Filter ℤ) with hudef
  set Δ : Filter ℤ := Filter.map₂ (· + ·) u (Filter.map (fun x : ℤ => -x) u) with hΔ
  let Fk : ℕ → Filter ℤ := fun k => Nat.rec u (fun _ H' => Filter.map₂ (· + ·) H' Δ) k
  have hΔC : Δ ∈ C := hC.add _ hu _ (hC.neg _ hu)
  have hFkC : ∀ k, Fk k ∈ C := by
    intro k
    induction k with
    | zero => exact hu
    | succ k ih => exact hC.add _ ih _ hΔC
  have hkey : ∀ k, ∀ T ∈ Fk k, ∃ V ∈ u, ∀ a ∈ V, ∀ δ : Fin k → ℤ,
      (∀ i, ∃ s ∈ V, ∃ t ∈ V, δ i = s - t) → a + ∑ i, δ i ∈ T := by
    intro k
    induction k with
    | zero =>
      intro T hT
      exact ⟨T, hT, fun a ha δ _ => by simpa using ha⟩
    | succ k ih =>
      intro T hT
      obtain ⟨s1, hs1, s2, hs2, hsub⟩ := Filter.mem_map₂_iff.1 hT
      obtain ⟨V1, hV1, h1⟩ := ih s1 hs1
      obtain ⟨r1, hr1, r2, hr2, hsub2⟩ := Filter.mem_map₂_iff.1 hs2
      have hr2' : (fun x : ℤ => -x) ⁻¹' r2 ∈ u := Filter.mem_map.1 hr2
      refine ⟨V1 ∩ r1 ∩ (fun x : ℤ => -x) ⁻¹' r2, Filter.inter_mem (Filter.inter_mem hV1 hr1) hr2',
        fun a ha δ hδ => ?_⟩
      rw [Fin.sum_univ_succ, add_comm (δ 0), ← add_assoc]
      refine hsub (mem_image2_of_mem (h1 a ha.1.1 (fun i => δ i.succ) (fun i => ?_)) ?_)
      · obtain ⟨s, hs, t, ht, h⟩ := hδ i.succ
        exact ⟨s, hs.1.1, t, ht.1.1, h⟩
      · obtain ⟨s, hs, t, ht, h⟩ := hδ 0
        rw [h, sub_eq_add_neg]
        exact hsub2 (mem_image2_of_mem hs.1.2 ht.2)
  refine hC.finer _ (hFkC l.length) _ ?_ (Ultrafilter.neBot _)
  intro T hT
  obtain ⟨V, hV, h⟩ := hkey _ T hT
  obtain ⟨a, ha, G, hG, hG'⟩ := total_term y w l hlw V hV
  show T ∈ w.map (fun n => (l.map Prod.fst).sum * y n)
  rw [Ultrafilter.mem_map]
  refine Filter.mem_of_superset (show G ∈ (w : Filter ℕ) from hG) (fun n hn => ?_)
  obtain ⟨δ, hδ, heq⟩ := hG' n hn
  show (l.map Prod.fst).sum * y n ∈ T
  rw [heq]
  exact h a ha δ hδ

/-- One ultrafilter and total coefficient `±d`: the PG is that of the image under `d * y`. -/
theorem genFam_eq_of_one (w : Ultrafilter ℕ) (l : List (ℤ × Ultrafilter ℕ)) (hlw : ∀ p ∈ l, p.2 = w)
    (d : ℤ) (hdiv : ∀ p ∈ l, d ∣ p.1)
    (hsum : (l.map Prod.fst).sum = d ∨ (l.map Prod.fst).sum = -d) :
    genFam (Sel.ultraGen {sumL y l}) = genFam (Sel.ultraGen {w.map (fun n => d * y n)}) := by
  have hne : ∀ v : Ultrafilter ℤ, ∀ G ∈ Sel.ultraGen {v}, G.NeBot := by
    rintro v G ⟨v', _, rfl⟩
    exact v'.neBot
  have hmem : ∀ v : Ultrafilter ℤ, (v : Filter ℤ) ∈ genFam (Sel.ultraGen {v}) := fun v =>
    subset_genFam (hne v) ⟨v, rfl, rfl⟩
  refine Set.Subset.antisymm ?_ ?_
  · refine genFam_le (genFam_nullFamily _) ?_
    rintro G ⟨v, hv, rfl⟩
    rw [Set.mem_singleton_iff.1 hv]
    exact sumL_mem_of_base y (genFam_nullFamily _) w d (hmem _) l hlw hdiv
  · refine genFam_le (genFam_nullFamily _) ?_
    rintro G ⟨v, hv, rfl⟩
    rw [Set.mem_singleton_iff.1 hv]
    have h1 := total_mem y (genFam_nullFamily (Sel.ultraGen {sumL y l})) w l hlw (hmem _)
    rcases hsum with h | h
    · rwa [h] at h1
    · have h2 := (genFam_nullFamily (Sel.ultraGen {sumL y l})).neg _ h1
      rw [Ultrafilter.coe_map, Filter.map_map] at h2
      rw [Ultrafilter.coe_map]
      have h3 : ((fun x : ℤ => -x) ∘ fun n => (l.map Prod.fst).sum * y n) = fun n => d * y n := by
        funext n
        show -((l.map Prod.fst).sum * y n) = d * y n
        rw [h]; ring
      rwa [h3] at h2

end One

/-- **The classification.** -/
theorem classification (l : List (ℤ × Ultrafilter ℕ)) (hl : l ≠ []) (hc : ∀ p ∈ l, p.1 ≠ 0)
    (hv : ∀ p ∈ l, ∀ a, p.2 ≠ pure a) (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l) :
    (∃ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ ∧
      ∀ O : Set ℤ, IsOpen[t] O ↔ IsOpenMod (genFam (Sel.ultraGen {sumL y l})) O) ↔
    ∃ w : Ultrafilter ℕ, (∀ p ∈ l, p.2 = w) ∧ IsPPoint w ∧ ∃ d : ℕ, 0 < d ∧
      (d : ℤ) ∈ AddSubgroup.closure {c : ℤ | (c, w) ∈ l} ∧ (∀ p ∈ l, p.2 = w → (d : ℤ) ∣ p.1) ∧
      ((l.map Prod.fst).sum = d ∨ (l.map Prod.fst).sum = -(d : ℤ)) := by
  classical
  -- the generator of the coefficients carried by an ultrafilter of the list
  have gen : ∀ w : Ultrafilter ℕ, (∃ p ∈ l, p.2 = w) → ∃ d : ℕ, 0 < d ∧
      (d : ℤ) ∈ AddSubgroup.closure {c : ℤ | (c, w) ∈ l} ∧ (∀ p ∈ l, p.2 = w → (d : ℤ) ∣ p.1) := by
    rintro w ⟨p0, hp0, hp0w⟩
    set Hs : AddSubgroup ℤ := AddSubgroup.closure {c : ℤ | (c, w) ∈ l} with hHs
    have hmemH : ∀ p ∈ l, p.2 = w → p.1 ∈ Hs := by
      intro p hp hpw
      refine AddSubgroup.subset_closure ?_
      show (p.1, w) ∈ l
      rw [← hpw]; exact hp
    -- the least positive member of the subgroup
    have hex : ∃ n : ℕ, 0 < n ∧ (n : ℤ) ∈ Hs := by
      refine ⟨p0.1.natAbs, Int.natAbs_pos.2 (hc p0 hp0), ?_⟩
      have h1 := hmemH p0 hp0 hp0w
      rcases Int.natAbs_eq p0.1 with h | h
      · rw [← h]; exact h1
      · have h2 : (p0.1.natAbs : ℤ) = -p0.1 := by omega
        rw [h2]; exact Hs.neg_mem h1
    obtain ⟨d, hd⟩ : ∃ d : ℕ, d = Nat.find hex := ⟨_, rfl⟩
    have hdpos : 0 < d := by rw [hd]; exact (Nat.find_spec hex).1
    have hdH : (d : ℤ) ∈ Hs := by rw [hd]; exact (Nat.find_spec hex).2
    have hdvd : ∀ x ∈ Hs, (d : ℤ) ∣ x := by
      intro x hx
      have hdz : (0 : ℤ) < d := by exact_mod_cast hdpos
      have h1 : x % (d : ℤ) ∈ Hs := by
        have h2 : x % (d : ℤ) = x - (x / (d : ℤ)) • (d : ℤ) := by
          rw [smul_eq_mul, Int.emod_def, mul_comm]
        rw [h2]
        exact Hs.sub_mem hx (Hs.zsmul_mem hdH _)
      have h3 : 0 ≤ x % (d : ℤ) := Int.emod_nonneg _ (by omega)
      have h4 : x % (d : ℤ) < d := Int.emod_lt_of_pos _ hdz
      refine Int.dvd_of_emod_eq_zero ?_
      by_contra h5
      have h6 : (x % (d : ℤ)).toNat < d := by omega
      have h7 : 0 < (x % (d : ℤ)).toNat ∧ (((x % (d : ℤ)).toNat : ℕ) : ℤ) ∈ Hs := by
        refine ⟨by omega, ?_⟩
        rw [Int.toNat_of_nonneg h3]; exact h1
      exact Nat.find_min hex (hd ▸ h6) h7
    exact ⟨d, hdpos, hdH, fun p hp hpw => hdvd _ (hmemH p hp hpw)⟩
  obtain ⟨p0, hp0⟩ := List.exists_mem_of_ne_nil l hl
  have hSone : ∀ w : Ultrafilter ℕ, (∀ p ∈ l, p.2 = w) → S w l = (l.map Prod.fst).sum := by
    intro w hw
    unfold S
    congr 1
    exact List.map_congr_left (fun p hp => if_pos (hw p hp))
  have forward : ∀ w : Ultrafilter ℕ, (∀ p ∈ l, p.2 = w) → ∀ d : ℕ, 0 < d → (∀ p ∈ l, p.2 = w → (d : ℤ) ∣ p.1) →
      ((l.map Prod.fst).sum = d ∨ (l.map Prod.fst).sum = -(d : ℤ)) →
      ((∃ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ ∧
        ∀ O : Set ℤ, IsOpen[t] O ↔ IsOpenMod (genFam (Sel.ultraGen {sumL y l})) O) ↔ IsPPoint w) := by
    intro w hw d hd0 hdiv hsum
    have heq := genFam_eq_of_one y w l hw (d : ℤ) (fun p hp => hdiv p hp (hw p hp)) hsum
    have hwfree : ∀ a, w ≠ pure a := fun a => (hw p0 hp0) ▸ hv p0 hp0 a
    have hd' : (0 : ℤ) < d := by exact_mod_cast hd0
    have hpos' : ∀ i, 0 < (d : ℤ) * y i := fun i => mul_pos hd' (hpos i)
    have hgrow' : ∀ B : ℕ, ∃ L : ℕ, ∀ k, L < k →
        2 * (B : ℤ) * ∑ i ∈ Finset.range k, (d : ℤ) * y i < (d : ℤ) * y k := by
      intro B
      obtain ⟨L, hL⟩ := hgrow B
      refine ⟨L, fun k hk => ?_⟩
      have h1 := mul_lt_mul_of_pos_left (hL k hk) hd'
      rw [← Finset.mul_sum]
      calc 2 * (B : ℤ) * ((d : ℤ) * ∑ i ∈ Finset.range k, y i)
          = (d : ℤ) * (2 * (B : ℤ) * ∑ i ∈ Finset.range k, y i) := by ring
        _ < (d : ℤ) * y k := h1
    rw [heq]
    exact modification_isGroupTopology_iff (fun n => (d : ℤ) * y n) w hwfree hpos' hgrow'
  constructor
  · intro hgroup
    -- all ultrafilters are equal and the total coefficient is `±d`
    have key : ∀ w : Ultrafilter ℕ, (∃ p ∈ l, p.2 = w) → ∀ d : ℕ, 0 < d →
        (d : ℤ) ∈ AddSubgroup.closure {c : ℤ | (c, w) ∈ l} → ∀ K : ℕ, 0 < K →
        (∀ (n : ℕ) (T : ℤ), (∀ p ∈ l, p.2 ≠ w → T * S p.2 l = 0) →
          T * S w l ≠ -(((n * K + 1 : ℕ) : ℤ) * d)) → False := by
      intro w ⟨p, hp, hpw⟩ d hd0 hdm K hK hsep
      exact not_group_of_sep y l hv hpos hgrow w (fun a => hpw ▸ hv p hp a) d hd0 hdm K hK hsep hgroup
    -- an ultrafilter of the list different from `w0`
    have allsame : ∀ p ∈ l, p.2 = p0.2 := by
      by_contra hne
      obtain ⟨p1, hp1⟩ := not_forall.1 hne
      obtain ⟨hp1l, hp1ne⟩ := Classical.not_imp.1 hp1
      -- choose `w` such that some other class sum is nonzero, or its own class sum is zero
      obtain ⟨w, hwl, hw⟩ : ∃ w : Ultrafilter ℕ, (∃ p ∈ l, p.2 = w) ∧
          (S w l = 0 ∨ ∃ p ∈ l, p.2 ≠ w ∧ S p.2 l ≠ 0) := by
        by_cases h0 : S p0.2 l = 0
        · exact ⟨p0.2, ⟨p0, hp0, rfl⟩, Or.inl h0⟩
        · exact ⟨p1.2, ⟨p1, hp1l, rfl⟩, Or.inr ⟨p0, hp0, Ne.symm hp1ne, h0⟩⟩
      obtain ⟨d, hd0, hdm, _⟩ := gen w hwl
      refine key w hwl d hd0 hdm 1 one_pos (fun n T hT heq => ?_)
      have hpos1 : (0 : ℤ) < ((n * 1 + 1 : ℕ) : ℤ) * d := by
        have : 0 < (n * 1 + 1) * d := Nat.mul_pos (Nat.succ_pos _) hd0
        exact_mod_cast this
      rcases hw with h | ⟨p, hp, hpw, hS⟩
      · rw [h, mul_zero] at heq
        omega
      · have h1 := hT p hp hpw
        have h2 : T = 0 := by
          rcases mul_eq_zero.1 h1 with h | h
          · exact h
          · exact absurd h hS
        rw [h2, zero_mul] at heq
        omega
    obtain ⟨d, hd0, hdm, hdiv⟩ := gen p0.2 ⟨p0, hp0, rfl⟩
    have hS : S p0.2 l = (l.map Prod.fst).sum := hSone _ allsame
    have hsum : (l.map Prod.fst).sum = d ∨ (l.map Prod.fst).sum = -(d : ℤ) := by
      by_contra hno
      have hdS : (d : ℤ) ∣ (l.map Prod.fst).sum := by
        refine List.dvd_sum (fun x hx => ?_)
        obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hx
        exact hdiv p hp (allsame p hp)
      obtain ⟨s', hs'⟩ := hdS
      set K : ℕ := max 1 ((l.map Prod.fst).sum.natAbs) with hKdef
      refine key p0.2 ⟨p0, hp0, rfl⟩ d hd0 hdm K (lt_of_lt_of_le one_pos (le_max_left _ _))
        (fun n T _ heq => ?_)
      rw [hS] at heq
      have hd' : (d : ℤ) ≠ 0 := by
        have : (0 : ℤ) < d := by exact_mod_cast hd0
        omega
      have h1 : T * s' = -(((n * K + 1 : ℕ) : ℤ)) := by
        have h2 : (d : ℤ) * (T * s') = (d : ℤ) * (-(((n * K + 1 : ℕ) : ℤ))) := by
          rw [hs'] at heq
          linear_combination heq
        exact mul_left_cancel₀ hd' h2
      by_cases h0 : (l.map Prod.fst).sum = 0
      · have h2 : s' = 0 := by
          rw [h0] at hs'
          rcases mul_eq_zero.1 hs'.symm with h | h
          · exact absurd h hd'
          · exact h
        rw [h2, mul_zero] at h1
        have : (0 : ℤ) < ((n * K + 1 : ℕ) : ℤ) := by exact_mod_cast Nat.succ_pos _
        omega
      · have hKS : (K : ℤ) = |(l.map Prod.fst).sum| := by
          have h2 : 1 ≤ (l.map Prod.fst).sum.natAbs := Int.natAbs_pos.2 h0
          rw [hKdef, max_eq_right h2, Int.natCast_natAbs]
        have hs'K : s' ∣ (K : ℤ) := by
          rw [hKS, dvd_abs, hs']
          exact dvd_mul_left _ _
        have hs'1 : s' ∣ (1 : ℤ) := by
          have h2 : s' ∣ ((n * K + 1 : ℕ) : ℤ) := by
            have h3 : s' ∣ T * s' := dvd_mul_left _ _
            rw [h1] at h3
            exact (dvd_neg.1 h3)
          have h4 : s' ∣ ((n * K : ℕ) : ℤ) := by
            rw [Nat.cast_mul]
            exact dvd_mul_of_dvd_right hs'K _
          have h5 := dvd_sub h2 h4
          have h6 : ((n * K + 1 : ℕ) : ℤ) - ((n * K : ℕ) : ℤ) = 1 := by push_cast; ring
          rwa [h6] at h5
        rcases Int.isUnit_iff.1 (isUnit_of_dvd_one hs'1) with h | h
        · exact hno (Or.inl (by rw [hs', h, mul_one]))
        · exact hno (Or.inr (by rw [hs', h, mul_neg_one]))
    exact ⟨p0.2, allsame, (forward p0.2 allsame d hd0 hdiv hsum).1 hgroup, d, hd0, hdm, hdiv, hsum⟩
  · rintro ⟨w, hw, hP, d, hd0, _, hdiv, hsum⟩
    exact (forward w hw d hd0 hdiv hsum).2 hP

end Classify

end PG
