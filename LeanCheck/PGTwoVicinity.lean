import Mathlib
import LeanCheck.PGNullFilters
import LeanCheck.PGGenerated
import LeanCheck.PGTwoGeneration
import LeanCheck.PGTwoLattice
import LeanCheck.PGTwoReflection

/-!
# PGtwo: vicinity filters of generated PGs and of PGs on finite groups (Lean check)

Scope. Propositions 5.25 and 5.26 and Example 5.27 of the second article (`PGtwo.tex`), abstract form. `vic C` is the
vicinity filter of the null family `C` (`PGTwoReflection`), `repSum V n` the sum of `n` copies of a filter `V`
(`PGTwoGeneration`).

* `mem_vic_genFam` : for a proper filter `V` whose members contain `0` and with `map neg V = V`, the vicinity filter of the PG
  generated by `V` is `⋂ₙ repSum V n`;
* `vic_genFam_eq_iff` : it equals `V` iff `V + V = V` (Proposition 5.25), and then `V` is a neighbourhood filter of a group
  topology (`isNbhdFilter_of_add_eq`);
* `nullSubgroup`, `finite_null_iff`, `vic_finite` : on a finite group the null filters are the filters containing the
  subgroup `H` of points `g` with `pure g` null, and the vicinity filter is the principal filter of `H` (Proposition 5.26);
* `not_vicinity_zmod5` : the principal filter of `{0, 1, -1}` on `ℤ/5ℤ` is not the vicinity filter of any PG (Example 5.27).

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set

namespace PG

variable {G : Type*} [AddCommGroup G]

theorem repSum_one (V : Filter G) : repSum V 1 = V := by
  show Filter.map₂ (· + ·) (pure (0 : G)) V = V
  rw [Filter.map₂_pure_left]
  simp

theorem repSum_add (V : Filter G) (n : ℕ) : ∀ m : ℕ,
    Filter.map₂ (· + ·) (repSum V n) (repSum V m) = repSum V (n + m) := by
  intro m
  induction m with
  | zero =>
    show Filter.map₂ (· + ·) (repSum V n) (pure (0 : G)) = repSum V n
    rw [Filter.map₂_pure_right]
    simp
  | succ m ih =>
    show Filter.map₂ (· + ·) (repSum V n) (Filter.map₂ (· + ·) (repSum V m) V)
      = Filter.map₂ (· + ·) (repSum V (n + m)) V
    rw [← ih]
    exact (Filter.map₂_assoc (fun a b c => add_assoc a b c)).symm

theorem repSum_neBot (V : Filter G) [V.NeBot] : ∀ n : ℕ, (repSum V n).NeBot := by
  intro n
  induction n with
  | zero => exact (inferInstance : (pure (0 : G) : Filter G).NeBot)
  | succ n ih => exact ih.map₂ ‹V.NeBot›

theorem sumClosure_eq_repSum {V : Filter G} (hneg : Filter.map (fun x : G => -x) V = V) {σ : Filter G}
    (h : SumClosure {V} σ) : ∃ n : ℕ, σ = repSum V n := by
  induction h with
  | zero => exact ⟨0, rfl⟩
  | gen hF =>
    have : _ = V := hF
    exact ⟨1, by rw [repSum_one]; exact this⟩
  | neg hF =>
    have : _ = V := hF
    subst this
    exact ⟨1, by rw [repSum_one]; exact hneg⟩
  | add h1 h2 ih1 ih2 =>
    obtain ⟨n₁, rfl⟩ := ih1
    obtain ⟨n₂, rfl⟩ := ih2
    exact ⟨n₁ + n₂, repSum_add V n₁ n₂⟩

/-- Proposition 5.25: the vicinity filter of the PG generated by `V` is the intersection of the repeated sums. -/
theorem mem_vic_genFam {V : Filter G} [V.NeBot] (hneg : Filter.map (fun x : G => -x) V = V) (s : Set G) :
    s ∈ vic (genFam {V}) ↔ ∀ n : ℕ, s ∈ repSum V n := by
  constructor
  · intro hs n
    have hmem : repSum V n ∈ genFam {V} :=
      ⟨repSum_neBot V n, fun U hU => ⟨repSum V n, sumClosure_repSum n, hU⟩⟩
    exact mem_vic.1 hs _ hmem
  · intro h
    rw [mem_vic]
    rintro F ⟨hne, hF⟩
    by_contra hs
    haveI := hne
    obtain ⟨U, hUF, hUs⟩ := exists_ultra_compl_mem F hs
    obtain ⟨σ, hσ, hUσ⟩ := hF U hUF
    obtain ⟨n, rfl⟩ := sumClosure_eq_repSum hneg hσ
    have h1 : s ∈ (U : Filter G) := hUσ (h n)
    exact Ultrafilter.compl_mem_iff_notMem.1 hUs h1

theorem add_le_self {V : Filter G} (h0 : ∀ A ∈ V, (0 : G) ∈ A) : V ≤ Filter.map₂ (· + ·) V V := by
  intro s hs
  obtain ⟨a, ha, b, hb, hab⟩ := Filter.mem_map₂_iff.1 hs
  refine Filter.mem_of_superset ha ?_
  intro x hx
  exact hab ⟨x, hx, 0, h0 b hb, by simp⟩

/-- Proposition 5.25: the vicinity filter of the PG generated by `V` equals `V` iff `V + V = V`. -/
theorem vic_genFam_eq_iff {V : Filter G} [V.NeBot] (h0 : ∀ A ∈ V, (0 : G) ∈ A)
    (hneg : Filter.map (fun x : G => -x) V = V) :
    vic (genFam {V}) = V ↔ Filter.map₂ (· + ·) V V = V := by
  constructor
  · intro h
    apply le_antisymm
    · intro s hs
      have h1 : s ∈ vic (genFam {V}) := by rw [h]; exact hs
      have h2 := (mem_vic_genFam hneg s).1 h1 2
      show s ∈ Filter.map₂ (· + ·) V V
      have e : repSum V 2 = Filter.map₂ (· + ·) V V := by
        show Filter.map₂ (· + ·) (repSum V 1) V = _
        rw [repSum_one]
      rwa [e] at h2
    · exact add_le_self h0
  · intro h
    have hrep : ∀ n : ℕ, repSum V (n + 1) = V := by
      intro n
      induction n with
      | zero => exact repSum_one V
      | succ n ih =>
        show Filter.map₂ (· + ·) (repSum V (n + 1)) V = V
        rw [ih, h]
    ext s
    rw [mem_vic_genFam hneg]
    constructor
    · intro hs
      have := hs 1
      rwa [repSum_one] at this
    · intro hs n
      cases n with
      | zero => exact h0 s hs
      | succ n => rw [hrep n]; exact hs

/-- If `V + V = V`, the filter `V` (symmetric, members containing `0`) is the neighbourhood filter of a group topology. -/
theorem isNbhdFilter_of_add_eq {V : Filter G} (h0 : ∀ A ∈ V, (0 : G) ∈ A)
    (hneg : Filter.map (fun x : G => -x) V = V) (hadd : Filter.map₂ (· + ·) V V = V) : IsNbhdFilter V where
  zero_mem := h0
  neg_mem := by
    intro A hA
    rw [← hneg] at hA
    exact hA
  halve := by
    intro A hA
    rw [← hadd] at hA
    obtain ⟨s, hs, t, ht, hst⟩ := Filter.mem_map₂_iff.1 hA
    exact ⟨s ∩ t, Filter.inter_mem hs ht, fun x hx y hy => hst ⟨x, hx.1, y, hy.2, rfl⟩⟩

/-- The points `g` for which the principal filter at `g` is null form a subgroup. -/
def nullSubgroup (C : Set (Filter G)) (hC : NullFamily C) : AddSubgroup G where
  carrier := {g | (pure g : Filter G) ∈ C}
  zero_mem' := hC.pure_zero
  add_mem' := by
    intro a b ha hb
    have := hC.add _ ha _ hb
    rwa [Filter.map₂_pure] at this
  neg_mem' := by
    intro a ha
    have := hC.neg _ ha
    rwa [Filter.map_pure] at this

/-- Proposition 5.26: on a finite group a proper filter is null iff it contains the subgroup `H`. -/
theorem finite_null_iff [Finite G] {C : Set (Filter G)} (hC : NullFamily C) (F : Filter G) [F.NeBot] :
    F ∈ C ↔ ((nullSubgroup C hC : AddSubgroup G) : Set G) ∈ F := by
  constructor
  · intro hF
    by_contra hH
    obtain ⟨U, hUF, hUc⟩ := exists_ultra_compl_mem F hH
    obtain ⟨a, rfl⟩ := Ultrafilter.eq_pure_of_finite U
    have h1 : ((pure a : Ultrafilter G) : Filter G) ∈ C := hC.finer F hF _ hUF inferInstance
    have h2 : a ∈ ((nullSubgroup C hC : AddSubgroup G) : Set G) := by
      have : (pure a : Filter G) ∈ C := by simpa using h1
      exact this
    exact hUc h2
  · intro hH
    refine hC.ultra F inferInstance (fun U hU => ?_)
    obtain ⟨a, rfl⟩ := Ultrafilter.eq_pure_of_finite U
    have h1 : a ∈ ((nullSubgroup C hC : AddSubgroup G) : Set G) := hU hH
    have h2 : (pure a : Filter G) ∈ C := h1
    rw [Ultrafilter.coe_pure]
    exact h2

/-- Proposition 5.26: the vicinity filter of a PG on a finite group is the principal filter of `H`. -/
theorem vic_finite [Finite G] {C : Set (Filter G)} (hC : NullFamily C) :
    vic C = 𝓟 ((nullSubgroup C hC : AddSubgroup G) : Set G) := by
  ext s
  rw [mem_vic, Filter.mem_principal]
  constructor
  · intro hs
    have hne : (𝓟 ((nullSubgroup C hC : AddSubgroup G) : Set G)).NeBot :=
      Filter.principal_neBot_iff.2 ⟨0, (nullSubgroup C hC).zero_mem⟩
    have h1 := (finite_null_iff hC _).2 (Filter.mem_principal_self _)
    exact Filter.mem_principal.1 (hs _ h1)
  · intro hs F hF
    haveI := hC.ne F hF
    exact Filter.mem_of_superset ((finite_null_iff hC F).1 hF) hs

/-- Example 5.27: the principal filter of `{0, 1, -1}` on `ℤ/5ℤ` is not the vicinity filter of any PG. -/
theorem not_vicinity_zmod5 :
    ¬ ∃ C : Set (Filter (ZMod 5)), NullFamily C ∧ vic C = 𝓟 ({0, 1, -1} : Set (ZMod 5)) := by
  rintro ⟨C, hC, heq⟩
  have h := vic_finite hC
  rw [heq] at h
  have hAH : ({0, 1, -1} : Set (ZMod 5)) = ((nullSubgroup C hC : AddSubgroup (ZMod 5)) : Set (ZMod 5)) :=
    Filter.principal_injective h
  have h1 : (1 : ZMod 5) ∈ ((nullSubgroup C hC : AddSubgroup (ZMod 5)) : Set (ZMod 5)) := by
    rw [← hAH]; simp
  have h2 := (nullSubgroup C hC).add_mem h1 h1
  have h3 : ((1 : ZMod 5) + 1) ∈ ({0, 1, -1} : Set (ZMod 5)) := by rw [hAH]; exact h2
  revert h3
  decide

/-- The points that belong to every member of the vicinity filter are exactly the points `g` with `pure g` null. -/
theorem pure_mem_iff_forall_vic {C : Set (Filter G)} (hC : NullFamily C) (g : G) :
    (pure g : Filter G) ∈ C ↔ ∀ A ∈ vic C, g ∈ A := by
  constructor
  · intro h A hA
    exact mem_vic.1 hA _ h
  · intro h
    by_contra hg
    have hmem : ({g}ᶜ : Set G) ∈ vic C := by
      rw [mem_vic]
      intro F hF
      by_contra hnot
      haveI := hC.ne F hF
      obtain ⟨U, hUF, hU⟩ := exists_ultra_compl_mem F hnot
      have hU' : ({g} : Set G) ∈ (U : Filter G) := by simpa using hU
      have hUeq : (U : Filter G) = pure g :=
        (Filter.NeBot.le_pure_iff inferInstance).1 (Filter.le_pure_iff.2 hU')
      have hUC : (U : Filter G) ∈ C := hC.finer F hF _ hUF inferInstance
      rw [hUeq] at hUC
      exact hg hUC
    have := h _ hmem
    exact this rfl

/-- The vicinity filter is invariant under translation by the null points. -/
theorem vic_translate {C : Set (Filter G)} (hC : NullFamily C) {k : G} (hk : (pure k : Filter G) ∈ C)
    {A : Set G} (hA : A ∈ vic C) : (fun x : G => x + k) ⁻¹' A ∈ vic C := by
  rw [mem_vic] at hA ⊢
  intro F hF
  have h1 : Filter.map₂ (· + ·) F (pure k) ∈ C := hC.add F hF _ hk
  rw [Filter.map₂_pure_right] at h1
  exact hA _ h1

/-- If the vicinity filter has a finite member, it is the principal filter of the subgroup of null points. -/
theorem vic_eq_principal_of_finite_member {C : Set (Filter G)} (hC : NullFamily C) {S : Set G}
    (hS : S.Finite) (hSV : S ∈ vic C) :
    vic C = 𝓟 ((nullSubgroup C hC : AddSubgroup G) : Set G) := by
  have hK : ∀ F ∈ C, ((nullSubgroup C hC : AddSubgroup G) : Set G) ∈ F := by
    intro F hF
    by_contra hnot
    haveI := hC.ne F hF
    obtain ⟨U, hUF, hU⟩ := exists_ultra_compl_mem F hnot
    have hSU : S ∈ (U : Filter G) := hUF (mem_vic.1 hSV F hF)
    obtain ⟨a, haS, hUa⟩ := Ultrafilter.eq_pure_of_finite_mem hS hSU
    have hUC : (U : Filter G) ∈ C := hC.finer F hF _ hUF inferInstance
    rw [hUa] at hUC
    have haK : a ∈ ((nullSubgroup C hC : AddSubgroup G) : Set G) := by
      have : (pure a : Filter G) ∈ C := by simpa using hUC
      exact this
    rw [hUa] at hU
    exact hU haK
  ext s
  rw [mem_vic, Filter.mem_principal]
  constructor
  · intro hs g hg
    have : (pure g : Filter G) ∈ C := hg
    exact hs _ this
  · intro hs F hF
    exact Filter.mem_of_superset (hK F hF) hs

/-- A principal vicinity filter is the principal filter of the subgroup of null points; in particular its generating set is
a subgroup. -/
theorem principal_vic_eq {C : Set (Filter G)} (hC : NullFamily C) {A : Set G} (h : vic C = 𝓟 A) :
    A = ((nullSubgroup C hC : AddSubgroup G) : Set G) := by
  ext g
  have h1 := pure_mem_iff_forall_vic hC g
  rw [h] at h1
  have h2 : (pure g : Filter G) ∈ C ↔ g ∈ A := by
    rw [h1]
    constructor
    · intro hh
      exact hh A (Filter.mem_principal_self A)
    · intro hg A' hA'
      exact (Filter.mem_principal.1 hA') hg
  exact h2.symm

end PG
