import LeanCheck.ChainComp3

/-!
# Completion of `τ_{f,S}` (TVGQ-v7 Theorem `thm:realcompletion`)

For a rational basis `B = {b_j}` of `S`, the graph embedding `G_B(x) = (x, (f(b_j x))_j)` identifies
`Comp(ℝ, τ_{f,S}) ≅ ℝ_usual × ℝ_usual^B`: it is a topological embedding with dense range into a complete
group.  (The description of the continuous real-valued maps is `tau_real_iff`.)
-/

namespace LeanCheck

open Filter Topology

variable {κ : Type}

/-- `G_B(x) = (x, (f(b_j x))_j)`. -/
noncomputable def GTau (f : ℝ →+ ℚ) (b : κ → ℝ) : ℝ →+ ℝ × (κ → ℝ) :=
  AddMonoidHom.prod (AddMonoidHom.id ℝ) (Pi.addMonoidHom (fun j => faR f (b j)))

lemma GTau_apply (f : ℝ →+ ℚ) (b : κ → ℝ) (x : ℝ) :
    GTau f b x = (x, fun j => ((f (b j * x) : ℚ) : ℝ)) := rfl

/-- Independence of a rational family gives independence of the observations `f_{b_j}`. -/
lemma Fa_indep (f : ℝ →+ ℚ) (hf : f ≠ 0) (b : κ → ℝ) (hli : LinearIndependent ℚ b) :
    LinearIndependent ℚ (fun j => Fa f (b j)) := by
  let Φ : ℝ →ₗ[ℚ] (ℝ →ₗ[ℚ] ℚ) :=
    { toFun := Fa f
      map_add' := fun a a' => by ext x; simp [Fa_apply, add_mul]
      map_smul' := fun q a => by
        ext x
        simp only [Fa_apply, LinearMap.smul_apply, RingHom.id_apply, Rat.smul_def]
        rw [mul_assoc, f_ratmul]; simp }
  have hker : LinearMap.ker Φ = ⊥ := by
    rw [LinearMap.ker_eq_bot']
    intro a ha
    apply fa_inj f hf a 0
    ext x
    have := congrArg (fun m : ℝ →ₗ[ℚ] ℚ => m x) ha
    simpa [Φ, Fa_apply, fa_apply] using this
  exact hli.map' Φ hker

lemma usualQ_eq_induced : usualQ = TopologicalSpace.induced (fun q : ℚ => (q : ℝ)) uR' :=
  Rat.isEmbedding_coe_real.eq_induced

/-- Every `f_a`, `a ∈ span b`, is continuous (into `ℝ`) for the topology generated by the `f_{b_j}`. -/
lemma faR_cont_span (f : ℝ →+ ℚ) (b : κ → ℝ) (a : ℝ) (ha : a ∈ Submodule.span ℚ (Set.range b)) :
    Continuous[⨅ j, TopologicalSpace.induced (faR f (b j)) uR', uR'] (faR f a) := by
  induction ha using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    exact (continuous_iff_le_induced (t₁ := ⨅ j, TopologicalSpace.induced (faR f (b j)) uR') (t₂ := uR')).2 (iInf_le _ j)
  | zero =>
    have : (faR f 0 : ℝ → ℝ) = fun _ => 0 := by funext x; simp [faR_apply]
    rw [this]; exact @continuous_const ℝ ℝ (⨅ j, TopologicalSpace.induced (faR f (b j)) uR') uR' 0
  | add x y _ _ hx hy =>
    have : (faR f (x + y) : ℝ → ℝ) = fun t => faR f x t + faR f y t := by
      funext t; simp [faR_apply, add_mul]
    rw [this]
    exact @Continuous.add ℝ uR' _ _ ℝ (⨅ j, TopologicalSpace.induced (faR f (b j)) uR') _ _ hx hy
  | smul q x _ hx =>
    have : (faR f (q • x) : ℝ → ℝ) = fun t => (q : ℝ) * faR f x t := by
      funext t
      simp only [faR_apply, Rat.smul_def]
      rw [mul_assoc, f_ratmul]; push_cast; rfl
    rw [this]
    exact @Continuous.comp ℝ ℝ ℝ (⨅ j, TopologicalSpace.induced (faR f (b j)) uR') uR' uR'
      (faR f x) (fun y : ℝ => (q : ℝ) * y) (continuous_const.mul continuous_id) hx

theorem GTau_inducing (f : ℝ →+ ℚ) (S : Submodule ℚ ℝ) (b : κ → ℝ)
    (hS : Submodule.span ℚ (Set.range b) = S) :
    @IsInducing ℝ (ℝ × (κ → ℝ)) (tauT f S) _ (GTau f b) := by
  have hbS : ∀ j, b j ∈ S := fun j => hS ▸ Submodule.subset_span ⟨j, rfl⟩
  refine @IsInducing.mk ℝ (ℝ × (κ → ℝ)) (tauT f S) _ _ ?_
  have hY : (⨅ a : S, TopologicalSpace.induced (fa f (a : ℝ)) usualQ) =
      ⨅ j, TopologicalSpace.induced (faR f (b j)) uR' := by
    have hterm : ∀ a : ℝ, TopologicalSpace.induced (fa f a) usualQ =
        TopologicalSpace.induced (faR f a) uR' := by
      intro a
      rw [usualQ_eq_induced, induced_compose]; rfl
    apply le_antisymm
    · refine le_iInf fun j => ?_
      refine iInf_le_of_le ⟨b j, hbS j⟩ ?_
      rw [hterm]
    · refine le_iInf fun a => ?_
      rw [hterm]
      refine continuous_iff_le_induced.1 ?_
      exact faR_cont_span f b (a : ℝ) (hS ▸ a.2)
  have h2 : TopologicalSpace.induced (Pi.addMonoidHom (fun j => faR f (b j)))
      (Pi.topologicalSpace : TopologicalSpace (κ → ℝ)) =
      ⨅ j, TopologicalSpace.induced (faR f (b j)) uR' := by
    rw [Pi.topologicalSpace, induced_iInf]
    refine iInf_congr fun j => ?_
    rw [induced_compose]; rfl
  unfold tauT TfS
  rw [hY]
  show _ = TopologicalSpace.induced (GTau f b)
    (TopologicalSpace.induced Prod.fst _ ⊓ TopologicalSpace.induced Prod.snd _)
  rw [induced_inf, induced_compose, induced_compose]
  rw [show (Prod.fst ∘ ⇑(GTau f b)) = id from rfl, induced_id]
  rw [show (Prod.snd ∘ ⇑(GTau f b)) = ⇑(Pi.addMonoidHom (fun j => faR f (b j))) from rfl, h2]

theorem GTau_denseRange (f : ℝ →+ ℚ) (hf : f ≠ 0) (b : κ → ℝ) (hli : LinearIndependent ℚ b) :
    DenseRange (GTau f b) := by
  classical
  refine dense_iff_inter_open.2 (fun U hU ⟨p, hp⟩ => ?_)
  obtain ⟨w, v, hw, hv, hpw, hpv, hsub⟩ := isOpen_prod_iff.1 hU p.1 p.2 hp
  obtain ⟨I, t, ht, hIt⟩ := isOpen_pi_iff.1 hv p.2 hpv
  -- rational targets
  have hq : ∀ j : {j // j ∈ I}, ∃ q : ℚ, (q : ℝ) ∈ t j.1 := by
    intro j
    obtain ⟨hopen, hmem⟩ := ht j.1 j.2
    obtain ⟨q, hq⟩ := Rat.denseRange_cast.exists_mem_open hopen ⟨_, hmem⟩
    exact ⟨q, hq⟩
  choose q hqt using hq
  let bI : {j // j ∈ I} → ℝ := fun j => b j.1
  have hliI : LinearIndependent ℚ (fun j : {j // j ∈ I} => Fa f (bI j)) :=
    (Fa_indep f hf b hli).comp Subtype.val Subtype.val_injective
  obtain ⟨x0, hx0⟩ := Hmap_surj f bI hliI q
  obtain ⟨n, hn, hnw⟩ := (Hker_dense f bI).exists_mem_open
    (hw.preimage (continuous_const.add continuous_id : Continuous fun y : ℝ => x0 + y))
    ⟨p.1 - x0, by show x0 + (p.1 - x0) ∈ w; rw [add_sub_cancel]; exact hpw⟩
  have hker : ∀ j : {j // j ∈ I}, f (b j.1 * n) = 0 := by
    intro j
    have := congrFun (AddMonoidHom.mem_ker.mp hn) j
    simpa [Hmap_apply, bI] using this
  have hval : ∀ j : {j // j ∈ I}, f (b j.1 * (x0 + n)) = q j := by
    intro j
    have h0 := congrFun hx0 j
    simp only [Hmap_apply, bI] at h0
    rw [mul_add, map_add, hker j, add_zero, h0]
  refine ⟨GTau f b (x0 + n), hsub ⟨hnw, hIt ?_⟩, x0 + n, rfl⟩
  intro j hj
  show ((f (b j * (x0 + n)) : ℚ) : ℝ) ∈ t j
  have := hval ⟨j, hj⟩
  simp only at this
  rw [this]
  exact hqt ⟨j, hj⟩

/-- **Completion of `τ_{f,S}`** (TVGQ-v7 Theorem `thm:realcompletion`): for a rational basis `{b_j}` of `S`,
`G_B : (ℝ, τ_{f,S}) → ℝ × ℝ^B` is a topological embedding with dense range into a complete group; so
`Comp(ℝ, τ_{f,S}) ≅ ℝ_usual × ℝ_usual^B`. -/
theorem completion_tau (f : ℝ →+ ℚ) (hf : f ≠ 0) (S : Submodule ℚ ℝ) (b : κ → ℝ)
    (hli : LinearIndependent ℚ b) (hS : Submodule.span ℚ (Set.range b) = S) :
    @IsInducing ℝ (ℝ × (κ → ℝ)) (tauT f S) _ (GTau f b) ∧ DenseRange (GTau f b) ∧
      CompleteSpace (ℝ × (κ → ℝ)) :=
  ⟨GTau_inducing f S b hS, GTau_denseRange f hf b hli, inferInstance⟩

end LeanCheck
