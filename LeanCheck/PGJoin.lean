import Mathlib
import LeanCheck.PGXi

/-!
# PG: the join of two admissible ideals (Lean check)

Scope. Section 8 (two bases) of `PG_v9`. For two ideals `I`, `J` of subsets of an abelian group `G` let
`joinI I J` be the family of sets contained in some sumset `B + C` with `B ∈ I`, `C ∈ J` (the ideal generated by `I ∪ J`).

* `joinI_admissible` : if `I`, `J` satisfy (I1)-(I5) (`AdmIdeal`) and no sumset `B + C` is all of `G`
  (`univ ∉ joinI I J`), then `joinI I J` satisfies (I1)-(I5);
* `joinI_proper_of` : `univ ∉ joinI I J` follows from "no `B + C` is `G`";
* `left_subset_joinI`, `right_subset_joinI` : `I ⊆ joinI I J` and `J ⊆ joinI I J`;
* `xi_mono_ideal` : if `I ⊆ J` then every filter converging for `ξ_{β,I}` converges for `ξ_{β,J}`.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set Topology

namespace PG

section join

variable {G : Type*} [AddCommGroup G]

/-- The ideal generated by `I ∪ J`: sets contained in some `B + C`, `B ∈ I`, `C ∈ J`. -/
def joinI (I J : Set (Set G)) : Set (Set G) :=
  {A | ∃ B ∈ I, ∃ C ∈ J, A ⊆ Set.image2 (· + ·) B C}

theorem joinI_sub {I J : Set (Set G)} {A : Set G} (hA : A ∈ joinI I J) (B : Set G) (hB : B ⊆ A) :
    B ∈ joinI I J := by
  obtain ⟨B', hB', C', hC', h⟩ := hA
  exact ⟨B', hB', C', hC', hB.trans h⟩

theorem joinI_union {I J : Set (Set G)} (hI : AdmIdeal I) (hJ : AdmIdeal J) {A A' : Set G}
    (hA : A ∈ joinI I J) (hA' : A' ∈ joinI I J) : A ∪ A' ∈ joinI I J := by
  obtain ⟨B₁, hB₁, C₁, hC₁, h₁⟩ := hA
  obtain ⟨B₂, hB₂, C₂, hC₂, h₂⟩ := hA'
  refine ⟨B₁ ∪ B₂, hI.union _ hB₁ _ hB₂, C₁ ∪ C₂, hJ.union _ hC₁ _ hC₂, ?_⟩
  intro x hx
  rcases hx with hx | hx
  · obtain ⟨b, hb, c, hc, rfl⟩ := h₁ hx
    exact ⟨b, Or.inl hb, c, Or.inl hc, rfl⟩
  · obtain ⟨b, hb, c, hc, rfl⟩ := h₂ hx
    exact ⟨b, Or.inr hb, c, Or.inr hc, rfl⟩

theorem joinI_single {I J : Set (Set G)} (hI : AdmIdeal I) (hJ : AdmIdeal J) (x : G) :
    ({x} : Set G) ∈ joinI I J := by
  refine ⟨{x}, hI.single x, {0}, hJ.single 0, ?_⟩
  intro y hy
  rw [Set.mem_singleton_iff] at hy
  subst hy
  exact ⟨y, rfl, 0, rfl, add_zero y⟩

theorem joinI_add {I J : Set (Set G)} (hI : AdmIdeal I) (hJ : AdmIdeal J) {A A' : Set G}
    (hA : A ∈ joinI I J) (hA' : A' ∈ joinI I J) :
    Set.image2 (· + ·) A A' ∈ joinI I J := by
  obtain ⟨B₁, hB₁, C₁, hC₁, h₁⟩ := hA
  obtain ⟨B₂, hB₂, C₂, hC₂, h₂⟩ := hA'
  refine ⟨Set.image2 (· + ·) B₁ B₂, hI.add _ hB₁ _ hB₂, Set.image2 (· + ·) C₁ C₂,
    hJ.add _ hC₁ _ hC₂, ?_⟩
  rintro _ ⟨a, ha, a', ha', rfl⟩
  obtain ⟨b₁, hb₁, c₁, hc₁, rfl⟩ := h₁ ha
  obtain ⟨b₂, hb₂, c₂, hc₂, rfl⟩ := h₂ ha'
  refine ⟨b₁ + b₂, ⟨b₁, hb₁, b₂, hb₂, rfl⟩, c₁ + c₂, ⟨c₁, hc₁, c₂, hc₂, rfl⟩, ?_⟩
  show b₁ + b₂ + (c₁ + c₂) = b₁ + c₁ + (b₂ + c₂)
  abel

theorem joinI_neg {I J : Set (Set G)} (hI : AdmIdeal I) (hJ : AdmIdeal J) {A : Set G}
    (hA : A ∈ joinI I J) : (fun x : G => -x) '' A ∈ joinI I J := by
  obtain ⟨B, hB, C, hC, h⟩ := hA
  refine ⟨(fun x : G => -x) '' B, hI.neg _ hB, (fun x : G => -x) '' C, hJ.neg _ hC, ?_⟩
  rintro _ ⟨a, ha, rfl⟩
  obtain ⟨b, hb, c, hc, rfl⟩ := h ha
  exact ⟨-b, ⟨b, hb, rfl⟩, -c, ⟨c, hc, rfl⟩, (neg_add b c).symm⟩

/-- Admissibility of the join, given properness. -/
theorem joinI_admissible {I J : Set (Set G)} (hI : AdmIdeal I) (hJ : AdmIdeal J)
    (hproper : (Set.univ : Set G) ∉ joinI I J) : AdmIdeal (joinI I J) where
  sub := fun _ hA B hB => joinI_sub hA B hB
  union := fun _ hA _ hB => joinI_union hI hJ hA hB
  single := joinI_single hI hJ
  proper := hproper
  add := fun _ hA _ hB => joinI_add hI hJ hA hB
  neg := fun _ hA => joinI_neg hI hJ hA

theorem joinI_proper_of {I J : Set (Set G)}
    (h : ∀ B ∈ I, ∀ C ∈ J, ∃ x : G, x ∉ Set.image2 (· + ·) B C) :
    (Set.univ : Set G) ∉ joinI I J := by
  rintro ⟨B, hB, C, hC, hsub⟩
  obtain ⟨x, hx⟩ := h B hB C hC
  exact hx (hsub (Set.mem_univ x))

theorem left_subset_joinI {I J : Set (Set G)} (hJ : AdmIdeal J) : I ⊆ joinI I J := by
  intro A hA
  refine ⟨A, hA, {0}, hJ.single 0, ?_⟩
  intro a ha
  exact ⟨a, ha, 0, rfl, add_zero a⟩

theorem right_subset_joinI {I J : Set (Set G)} (hI : AdmIdeal I) : J ⊆ joinI I J := by
  intro A hA
  refine ⟨{0}, hI.single 0, A, hA, ?_⟩
  intro a ha
  exact ⟨0, rfl, a, ha, zero_add a⟩

end join

section mono

variable {G : Type*} [TopologicalSpace G]

/-- Monotonicity of `ξ` in the ideal. -/
theorem xi_mono_ideal {I J : Set (Set G)} (h : I ⊆ J) {F : Filter G} {x : G} (hF : xi I F x) :
    xi J F x := by
  obtain ⟨hn, hle, A, hA, hAF⟩ := hF
  exact ⟨hn, hle, A, h hA, hAF⟩

end mono

end PG
