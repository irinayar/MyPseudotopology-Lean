import Mathlib
import LeanCheck.PGFourSums

/-!
# PGfour: the vicinity filter has more sets than the neighbourhood filter of the modification

`y` is a rapidly growing sequence of positive integers and `E y C m` the set of the values of
nonzero integer vectors supported above `m` with entries bounded by `C`. `U` is a nonempty
set of ultrafilters on `ℤ`, each containing `E y C m` for all `m`, for a bound `C` that may
depend on the ultrafilter.

* `sparse_strict` : there is a set that belongs to every filter converging to `0` in the PG
  generated by `U` (so to its vicinity filter) and contains no set that is open for the
  topological modification and contains `0`.

No set-theoretic axiom is used. A Lean proof verifies its formal statement under its
hypotheses; the correspondence with the article requires mathematical review.
-/

open Filter Set

namespace PG

namespace Vicinity

open Sums

variable (y : ℕ → ℤ)

/-- Values of nonzero vectors above `m` with entries bounded by `C`. -/
def E (C m : ℕ) : Set ℤ :=
  {z | ∃ c : ℕ →₀ ℤ, Sparse.val y c = z ∧ c ≠ 0 ∧ (∀ i, |c i| ≤ (C : ℤ)) ∧ ∀ i, c i ≠ 0 → m < i}

theorem sparse_strict (U : Set (Ultrafilter ℤ)) (hne : U.Nonempty)
    (hU : ∀ u ∈ U, ∃ C : ℕ, ∀ m, E y C m ∈ u) (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l) :
    ∃ A : Set ℤ, (∀ F ∈ genFam (Sel.ultraGen U), A ∈ F) ∧
      ¬ ∃ O : Set ℤ, (0 : ℤ) ∈ O ∧ O ⊆ A ∧ IsOpenMod (genFam (Sel.ultraGen U)) O := by
  classical
  obtain ⟨β, hβ, hβinf, hwt⟩ := Sparse.exists_weight y hpos hgrow
  choose Cu hCu using hU
  -- the set
  let A : Set ℤ := {z | z = 0 ∨ ∃ c : ℕ →₀ ℤ, Sparse.val y c = z ∧ c ≠ 0 ∧
    ∀ i j, c j ≠ 0 → |c i| ≤ (β j : ℤ)}
  refine ⟨A, fun F hF => ?_, ?_⟩
  · -- `A` belongs to every null filter
    rw [Filter.mem_iff_ultrafilter]
    intro V hV
    obtain ⟨σ, hσ, hVσ⟩ := hF.2 V hV
    obtain ⟨ι, _, u, ε, hu, hε, hrep⟩ := Sel.rep_of_sumClosure _ hσ
    let C : ι → ℕ := fun i => Cu (u i) (hu i)
    set T : ℕ := ∑ i, C i with hT
    obtain ⟨m, hm⟩ := hβinf T
    refine hVσ (Filter.mem_of_superset (hrep (fun i => E y (C i) m) (fun i => hCu (u i) (hu i) m)) ?_)
    rintro z ⟨a, ha, rfl⟩
    choose c hcv _ hcb hcm using ha
    set d : ℕ →₀ ℤ := ∑ i, ε i • c i with hd
    have hdval : Sparse.val y d = ∑ i, ε i • a i := by
      rw [hd, Sparse.val_finset_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [val_smul, hcv i, smul_eq_mul]
    have hdbound : ∀ l, |d l| ≤ (T : ℤ) := by
      intro l
      rw [hd, Finsupp.finsetSum_apply]
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      rw [hT]
      push_cast
      refine Finset.sum_le_sum (fun i _ => ?_)
      simp only [Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul, abs_mul]
      have h1 : |ε i| = 1 := by
        rcases hε i with h | h <;> rw [h] <;> simp
      rw [h1, one_mul]
      exact hcb i l
    have hdm : ∀ l, d l ≠ 0 → m < l := by
      intro l hl
      by_contra h
      refine hl ?_
      rw [hd, Finsupp.finsetSum_apply]
      refine Finset.sum_eq_zero (fun i _ => ?_)
      have h1 : c i l = 0 := by
        by_contra h2
        exact h (hcm i l h2)
      simp [h1]
    by_cases h0 : d = 0
    · exact Or.inl (by rw [← hdval, h0, Sparse.val_zero])
    · refine Or.inr ⟨d, hdval, h0, fun i j hj => ?_⟩
      have h1 : (T : ℤ) ≤ (β j : ℤ) := by exact_mod_cast hm.trans (hβ (le_of_lt (hdm j hj)))
      exact (hdbound i).trans h1
  · -- no open set containing `0` lies inside `A`
    rintro ⟨O, h0, hOA, hopen⟩
    obtain ⟨u, huU⟩ := hne
    set C : ℕ := Cu u huU with hC
    have hCmem : ∀ m, E y C m ∈ u := hCu u huU
    have hCnull : NullFamily (genFam (Sel.ultraGen U)) := genFam_nullFamily _
    have huC : (u : Filter ℤ) ∈ genFam (Sel.ultraGen U) :=
      ⟨u.neBot, fun V hV => ⟨_, SumClosure.gen ⟨u, huU, rfl⟩, hV⟩⟩
    have hOu : O ∈ u := hopen 0 h0 _ u.neBot ((conv_zero _ _).2 huC)
    obtain ⟨m0, hm0⟩ := hβinf (C + 1)
    obtain ⟨x, hxO, hxE⟩ := Ultrafilter.nonempty_of_mem (inter_mem (f := (u : Filter ℤ)) hOu (hCmem m0))
    obtain ⟨cx, hcx, hcx0, hcxb, hcxm⟩ := hxE
    obtain ⟨k, hk⟩ := Finsupp.support_nonempty_iff.2 hcx0
    have hk0 : cx k ≠ 0 := Finsupp.mem_support_iff.1 hk
    set K : ℕ := β k + 1 with hK
    -- `K` copies of the same element
    let Fk : ℕ → Filter ℤ := fun n => Nat.rec (pure 0) (fun _ H' => Filter.map₂ (· + ·) H' (u : Filter ℤ)) n
    have hFkC : ∀ n, Fk n ∈ genFam (Sel.ultraGen U) := by
      intro n
      induction n with
      | zero => exact hCnull.pure_zero
      | succ n ih => exact hCnull.add _ ih _ huC
    have hkey : ∀ n, ∀ s ∈ Fk n, ∃ S ∈ (u : Filter ℤ), ∀ w ∈ S, (n : ℤ) * w ∈ s := by
      intro n
      induction n with
      | zero =>
        intro s hs
        have h1 : (0 : ℤ) ∈ s := Filter.mem_pure.1 hs
        exact ⟨univ, Filter.univ_mem, fun w _ => by simpa using h1⟩
      | succ n ih =>
        intro s hs
        obtain ⟨s1, hs1, s2, hs2, hsub⟩ := Filter.mem_map₂_iff.1 hs
        obtain ⟨S, hS, h⟩ := ih s1 hs1
        refine ⟨S ∩ s2, inter_mem hS hs2, fun w hw => ?_⟩
        have h1 := hsub (mem_image2_of_mem (h w hw.1) hw.2)
        have h2 : ((n + 1 : ℕ) : ℤ) * w = (n : ℤ) * w + w := by push_cast; ring
        rw [h2]; exact h1
    have hconv : conv (genFam (Sel.ultraGen U)) (Filter.map (fun z : ℤ => x + z) (Fk K)) x := by
      unfold conv
      rw [Filter.map_map]
      have : ((fun v : ℤ => v - x) ∘ fun z : ℤ => x + z) = id := by funext z; simp
      rw [this, Filter.map_id]
      exact hFkC K
    have hmem := hopen x hxO _ (Filter.NeBot.map (hCnull.ne _ (hFkC K)) _) hconv
    obtain ⟨S, hS, h⟩ := hkey K _ (Filter.mem_map.1 hmem)
    obtain ⟨m1, hm1⟩ := hβinf (K * C + C + 1)
    set M : ℕ := max m1 (cx.support.sup id) with hM
    obtain ⟨w, hwS, hwE⟩ := Ultrafilter.nonempty_of_mem (inter_mem (f := (u : Filter ℤ)) hS (hCmem M))
    obtain ⟨cw, hcw, hcw0, hcwb, hcwm⟩ := hwE
    set d : ℕ →₀ ℤ := cx + (K : ℤ) • cw with hd
    have hdval : Sparse.val y d = x + (K : ℤ) * w := by
      rw [hd, Sparse.val_add, val_smul, hcx, hcw]
    have hsep : ∀ i, cx i ≠ 0 → cw i = 0 := by
      intro i hi
      by_contra h1
      have h2 : M < i := hcwm i h1
      have h3 : i ≤ cx.support.sup id := Finset.le_sup (f := id) (Finsupp.mem_support_iff.2 hi)
      have h4 := le_trans h3 (le_max_right m1 (cx.support.sup id))
      omega
    have hdcx : ∀ i, cx i ≠ 0 → d i = cx i := by
      intro i hi
      rw [hd, Finsupp.add_apply, Finsupp.smul_apply, hsep i hi, smul_zero, add_zero]
    have hdcw : ∀ i, cx i = 0 → d i = (K : ℤ) * cw i := by
      intro i hi
      rw [hd, Finsupp.add_apply, Finsupp.smul_apply, hi, zero_add, smul_eq_mul]
    have hdk : d k = cx k := hdcx k hk0
    have hd0 : d ≠ 0 := fun h1 => hk0 (by rw [← hdk, h1, Finsupp.zero_apply])
    have hdadm : ∀ i, |d i| ≤ (β i : ℤ) := by
      intro i
      by_cases hi : cx i = 0
      · rw [hdcw i hi]
        by_cases h1 : cw i = 0
        · rw [h1, mul_zero, abs_zero]; exact Int.natCast_nonneg _
        · have h2 : K * C + C + 1 ≤ β i := hm1.trans (hβ (le_of_lt (lt_of_le_of_lt (le_max_left _ _) (hcwm i h1))))
          have h3 : |(K : ℤ) * cw i| ≤ (K : ℤ) * (C : ℤ) := by
            rw [abs_mul, abs_of_nonneg (Int.natCast_nonneg K)]
            exact mul_le_mul_of_nonneg_left (hcwb i) (Int.natCast_nonneg K)
          have h4 : ((K * C : ℕ) : ℤ) ≤ (β i : ℤ) := by exact_mod_cast (by omega : K * C ≤ β i)
          rw [Nat.cast_mul] at h4
          exact h3.trans h4
      · rw [hdcx i hi]
        have h1 : C + 1 ≤ β i := hm0.trans (hβ (le_of_lt (hcxm i hi)))
        exact (hcxb i).trans (by exact_mod_cast (by omega : C ≤ β i))
    have hin : x + (K : ℤ) * w ∈ A := hOA (h w hwS)
    rcases hin with h1 | ⟨c', hc', hc'0, hcond⟩
    · -- the value of a nonzero admissible vector is not `0`
      have h2 : d = 0 := Sparse.val_inj hpos hβ hwt d 0 hdadm (fun i => by simp)
        (by rw [hdval, h1, Sparse.val_zero])
      exact hd0 h2
    · have hc'adm : ∀ i, |c' i| ≤ (β i : ℤ) := by
        intro i
        by_cases h2 : c' i = 0
        · rw [h2, abs_zero]; exact Int.natCast_nonneg _
        · exact hcond i i h2
      have h2 : c' = d := Sparse.val_inj hpos hβ hwt c' d hc'adm hdadm (by rw [hc', hdval])
      obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.2 hcw0
      have hi0 : cw i ≠ 0 := Finsupp.mem_support_iff.1 hi
      have hicx : cx i = 0 := by
        by_contra h3
        exact hi0 (hsep i h3)
      have h3 := hcond i k (by rw [h2, hdk]; exact hk0)
      rw [h2, hdcw i hicx, abs_mul, abs_of_nonneg (Int.natCast_nonneg K)] at h3
      have h4 : (1 : ℤ) ≤ |cw i| := Int.one_le_abs hi0
      have h5 : (K : ℤ) * 1 ≤ (K : ℤ) * |cw i| := mul_le_mul_of_nonneg_left h4 (Int.natCast_nonneg K)
      have h6 : (K : ℤ) = (β k : ℤ) + 1 := by rw [hK]; push_cast; ring
      omega

end Vicinity

end PG
