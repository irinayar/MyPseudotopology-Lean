import LeanCheck.ChainG3
import LeanCheck.ChainU2

/-!
# Finite coefficient quotients
(HamelCharactersTVG_v18 Lemma 16.3 `lem:finite-quotient`)

Let `h_1,…,h_m : ℝ → ℚ` be rationally independent rational-linear maps and `δ` a group topology on `ℚ` with all rational
multiplications continuous.  Let `ν = usual ⊓ ⋀_j h_j⁻¹ δ` (the topology generated by the usual coordinate and the maps `h_j`
into `(ℚ, δ)`).  Then `h = (h_1,…,h_m) : (ℝ, ν) → (ℚ, δ)^m` is an open continuous surjection, and, if the dual of `δ` is `Γ`,
every `ν`-continuous character is `x ↦ p(c x + ∑ r_j h_j(x))` with `c` real and `r_j` rational.
-/

namespace LeanCheck

open Filter Topology

section Algebra

variable {κ : Type} [Fintype κ]

/-- The joint map `x ↦ (h_j x)_j`. -/
noncomputable def HM (h : κ → (ℝ →ₗ[ℚ] ℚ)) : ℝ →+ (κ → ℚ) := (LinearMap.pi h).toAddMonoidHom

lemma HM_apply (h : κ → (ℝ →ₗ[ℚ] ℚ)) (x : ℝ) (j : κ) : HM h x j = h j x := rfl

/-- Independent functionals give a surjective joint map. -/
lemma HM_surj (h : κ → (ℝ →ₗ[ℚ] ℚ)) (hli : LinearIndependent ℚ h) : Function.Surjective (HM h) := by
  classical
  let T : ℝ →ₗ[ℚ] (κ → ℚ) := LinearMap.pi h
  by_contra hns
  have hlt : LinearMap.range T < ⊤ := by
    rw [lt_top_iff_ne_top]; intro htop; apply hns; intro v
    have : v ∈ LinearMap.range T := by rw [htop]; trivial
    obtain ⟨x, hx⟩ := this
    exact ⟨x, hx⟩
  obtain ⟨g, hg0, hgker⟩ := Submodule.exists_le_ker_of_lt_top _ hlt
  apply hg0
  have hz : ∑ j, (g fun i => if j = i then 1 else 0) • h j = 0 := by
    refine LinearMap.ext fun x => ?_
    have h1 := hgker (LinearMap.mem_range_self T x)
    rw [LinearMap.mem_ker, LinearMap.pi_apply_eq_sum_univ g (T x)] at h1
    rw [LinearMap.sum_apply]
    simp only [LinearMap.smul_apply, smul_eq_mul, LinearMap.zero_apply]
    have : ∀ j, (T x) j = h j x := fun j => rfl
    simp only [this, smul_eq_mul] at h1
    exact (Finset.sum_congr rfl (fun j _ => mul_comm _ _)).trans h1
  have hc := Fintype.linearIndependent_iff.mp hli _ hz
  refine LinearMap.ext fun v => ?_
  rw [LinearMap.pi_apply_eq_sum_univ g v]
  simp [hc]

/-- The kernel of a homomorphism from `ℝ` to a countable group is dense. -/
lemma ker_dense_of_countable {G : Type} [AddCommGroup G] [Countable G] (T : ℝ →+ G) :
    Dense (T.ker : Set ℝ) := by
  rcases AddSubgroup.dense_or_isCyclic T.ker with h | h
  · exact h
  · exfalso
    have hc := countable_of_cyclic _ h
    classical
    let r : G → ℝ := fun v => if hv : ∃ x, T x = v then hv.choose else 0
    have hsub : (Set.univ : Set ℝ) ⊆ ⋃ v : G, (fun e : ℝ => e + r v) '' (T.ker : Set ℝ) := by
      intro x _
      refine Set.mem_iUnion.2 ⟨T x, ⟨x - r (T x), ?_, by ring⟩⟩
      have hv : ∃ y, T y = T x := ⟨x, rfl⟩
      have : r (T x) = hv.choose := by simp only [r, dif_pos hv]
      rw [this]
      show T (x - hv.choose) = 0
      rw [map_sub, hv.choose_spec, sub_self]
    exact Cardinal.not_countable_real ((Set.countable_iUnion fun v => hc.image _).mono hsub)

lemma HM_ker_dense (h : κ → (ℝ →ₗ[ℚ] ℚ)) : Dense ((HM h).ker : Set ℝ) :=
  ker_dense_of_countable (HM h)

lemma HM_ker_qmul (h : κ → (ℝ →ₗ[ℚ] ℚ)) :
    ∀ x ∈ (HM h).ker, ∀ q : ℚ, (q : ℝ) * x ∈ (HM h).ker := by
  intro x hx q
  rw [AddMonoidHom.mem_ker] at hx ⊢
  funext j
  have h1 := congrFun hx j
  simp only [HM_apply, Pi.zero_apply] at h1 ⊢
  have : (q : ℝ) * x = q • x := by rw [Rat.smul_def]
  rw [this, map_smul, h1, smul_zero]

end Algebra

section Topo

variable {κ : Type} [Fintype κ]

/-- `ν`: the topology generated by the usual coordinate and the maps `h_j` into `(ℚ, δ)`. -/
noncomputable def nuTop (h : κ → (ℝ →ₗ[ℚ] ℚ)) (δ : TopologicalSpace ℚ) : TopologicalSpace ℝ :=
  (inferInstance : TopologicalSpace ℝ) ⊓ ⨅ j, TopologicalSpace.induced (fun x : ℝ => h j x) δ

lemma nu_group (h : κ → (ℝ →ₗ[ℚ] ℚ)) (δ : TopologicalSpace ℚ) (hg : @IsTopologicalAddGroup ℚ δ _) :
    @IsTopologicalAddGroup ℝ (nuTop h δ) _ := by
  unfold nuTop
  letI : TopologicalSpace ℚ := δ
  haveI : IsTopologicalAddGroup ℚ := hg
  exact isTopologicalAddGroup_inf inferInstance
    (isTopologicalAddGroup_iInf (fun j => isTopologicalAddGroup_induced (h j).toAddMonoidHom))

lemma nu_le_usual (h : κ → (ℝ →ₗ[ℚ] ℚ)) (δ : TopologicalSpace ℚ) :
    nuTop h δ ≤ (inferInstance : TopologicalSpace ℝ) := inf_le_left

lemma nu_cont_h (h : κ → (ℝ →ₗ[ℚ] ℚ)) (δ : TopologicalSpace ℚ) (j : κ) :
    Continuous[nuTop h δ, δ] (fun x : ℝ => h j x) := by
  refine continuous_iff_le_induced.2 ?_
  exact inf_le_right.trans (iInf_le (fun j => TopologicalSpace.induced (fun x : ℝ => h j x) δ) j)

lemma nu_nhds_data (h : κ → (ℝ →ₗ[ℚ] ℚ)) (δ : TopologicalSpace ℚ) (S : Set ℝ)
    (hS : S ∈ @nhds ℝ (nuTop h δ) 0) :
    ∃ ε : ℝ, 0 < ε ∧ ∃ V : κ → Set ℚ, (∀ j, V j ∈ @nhds ℚ δ 0) ∧
      ∀ x : ℝ, |x| < ε → (∀ j, h j x ∈ V j) → x ∈ S := by
  unfold nuTop at hS
  rw [nhds_inf] at hS
  obtain ⟨t1, ht1, t2, ht2, hsub⟩ := Filter.mem_inf_iff.mp hS
  rw [nhds_iInf] at ht2
  obtain ⟨V, hV, hVeq⟩ := (Filter.mem_iInf_of_finite t2).mp ht2
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp ht1
  have hex : ∀ j : κ, ∃ U : Set ℚ, U ∈ @nhds ℚ δ 0 ∧ (fun x : ℝ => h j x) ⁻¹' U ⊆ V j := by
    intro j
    have h1 := hV j
    rw [nhds_induced, map_zero] at h1
    exact Filter.mem_comap.mp h1
  choose U hU hUV using hex
  refine ⟨ε, hε, U, hU, fun x hx hxU => ?_⟩
  have hx1 : x ∈ t1 := hball (by simpa [Metric.mem_ball, dist_zero_right] using hx)
  have hx2 : x ∈ t2 := by
    rw [hVeq]
    exact Set.mem_iInter.mpr (fun j => hUV j (hxU j))
  rw [hsub]; exact ⟨hx1, hx2⟩

/-- The joint map sends `ν`-neighbourhoods of zero to neighbourhoods of zero of the product `(ℚ, δ)^m`. -/
lemma HM_image_nhds (h : κ → (ℝ →ₗ[ℚ] ℚ)) (hli : LinearIndependent ℚ h) (δ : TopologicalSpace ℚ)
    (S : Set ℝ) (hS : S ∈ @nhds ℝ (nuTop h δ) 0) :
    HM h '' S ∈ @nhds (κ → ℚ) (@Pi.topologicalSpace κ (fun _ => ℚ) (fun _ => δ)) 0 := by
  obtain ⟨ε, hε, V, hV, hSsub⟩ := nu_nhds_data h δ S hS
  letI : TopologicalSpace ℚ := δ
  have hpi : Set.pi Set.univ V ∈ 𝓝 (0 : κ → ℚ) :=
    set_pi_mem_nhds Set.finite_univ (fun j _ => hV j)
  refine Filter.mem_of_superset hpi ?_
  intro y hy
  obtain ⟨x0, hx0⟩ := HM_surj h hli y
  obtain ⟨n, hnN, hn⟩ := (HM_ker_dense h).exists_mem_open
    (isOpen_Ioo : IsOpen (Set.Ioo (-x0 - ε) (-x0 + ε))) ⟨-x0, by constructor <;> linarith⟩
  refine ⟨x0 + n, hSsub _ ?_ ?_, ?_⟩
  · rw [abs_lt]; constructor <;> linarith [hn.1, hn.2]
  · intro j
    have h0 : HM h n = 0 := hnN
    have : HM h (x0 + n) j = y j := by rw [map_add, h0, add_zero, hx0]
    rw [← HM_apply, this]
    exact hy j (Set.mem_univ j)
  · show HM h (x0 + n) = y
    have h0 : HM h n = 0 := hnN
    rw [map_add, h0, add_zero, hx0]

/-- `h : (ℝ, ν) → (ℚ, δ)^m` is continuous. -/
lemma HM_continuous (h : κ → (ℝ →ₗ[ℚ] ℚ)) (δ : TopologicalSpace ℚ) :
    Continuous[nuTop h δ, @Pi.topologicalSpace κ (fun _ => ℚ) (fun _ => δ)] (HM h) := by
  letI : TopologicalSpace ℚ := δ
  letI : TopologicalSpace ℝ := nuTop h δ
  refine continuous_pi (fun j => ?_)
  exact nu_cont_h h δ j

/-- **Lemma 16.3, first assertion.**  The joint map is an open continuous surjection. -/
theorem HM_openSurj (h : κ → (ℝ →ₗ[ℚ] ℚ)) (hli : LinearIndependent ℚ h) (δ : TopologicalSpace ℚ)
    (hg : @IsTopologicalAddGroup ℚ δ _) :
    Continuous[nuTop h δ, @Pi.topologicalSpace κ (fun _ => ℚ) (fun _ => δ)] (HM h) ∧
      Function.Surjective (HM h) ∧
      @IsOpenMap ℝ (κ → ℚ) (nuTop h δ) (@Pi.topologicalSpace κ (fun _ => ℚ) (fun _ => δ)) (HM h) := by
  refine ⟨HM_continuous h δ, HM_surj h hli, ?_⟩
  have hgT := nu_group h δ hg
  letI : TopologicalSpace ℝ := nuTop h δ
  haveI : IsTopologicalAddGroup ℝ := hgT
  letI : TopologicalSpace ℚ := δ
  haveI : IsTopologicalAddGroup ℚ := hg
  haveI : IsTopologicalAddGroup (κ → ℚ) := inferInstance
  intro O hO
  rw [isOpen_iff_mem_nhds]
  rintro _ ⟨x, hxO, rfl⟩
  have hnh : (fun z : ℝ => z + x) ⁻¹' O ∈ 𝓝 (0 : ℝ) :=
    (continuous_id.add continuous_const : Continuous fun z : ℝ => z + x).continuousAt.preimage_mem_nhds
      (by simpa using hO.mem_nhds hxO)
  have himg := HM_image_nhds h hli δ _ hnh
  have h2 : (fun t : κ → ℚ => t - HM h x) ⁻¹' ((HM h) '' ((fun z : ℝ => z + x) ⁻¹' O)) ∈ 𝓝 (HM h x) :=
    (continuous_id.sub continuous_const : Continuous fun t : κ → ℚ => t - HM h x).continuousAt.preimage_mem_nhds
      (by simpa using himg)
  refine Filter.mem_of_superset h2 ?_
  rintro t ⟨z, hz, hzt⟩
  refine ⟨z + x, hz, ?_⟩
  rw [map_add, hzt]; ring

lemma rat_mul_apply (l : ℝ →ₗ[ℚ] ℚ) (q : ℚ) (x : ℝ) : l ((q : ℝ) * x) = q * l x := by
  have : (q : ℝ) * x = q • x := by rw [Rat.smul_def]
  rw [this, map_smul, smul_eq_mul]

/-- Neighbourhood data for a `ν`-continuous character. -/
lemma nu_char_data (h : κ → (ℝ →ₗ[ℚ] ℚ)) (δ : TopologicalSpace ℚ) (χ : ℝ →+ Circ)
    (hχ : @Continuous ℝ Circ (nuTop h δ) circTop χ) :
    ∃ ε : ℝ, 0 < ε ∧ ∃ V : κ → Set ℚ, (∀ j, V j ∈ @nhds ℚ δ 0) ∧
      ∀ x : ℝ, |x| < ε → (∀ j, h j x ∈ V j) → ‖χ x‖ < 1 / 4 := by
  have hS : {y : Circ | ‖y‖ < 1 / 4} ∈ 𝓝 (χ 0) := by
    rw [map_zero]
    exact (isOpen_lt continuous_norm continuous_const).mem_nhds (by simp)
  have hT : χ ⁻¹' {y : Circ | ‖y‖ < 1 / 4} ∈ @nhds ℝ (nuTop h δ) 0 :=
    (@Continuous.continuousAt ℝ Circ (nuTop h δ) circTop χ 0 hχ) hS
  obtain ⟨ε, hε, V, hV, hsub⟩ := nu_nhds_data h δ _ hT
  exact ⟨ε, hε, V, hV, hsub⟩

lemma cmul_nu_continuous (h : κ → (ℝ →ₗ[ℚ] ℚ)) (δ : TopologicalSpace ℚ) (c : ℝ) :
    @Continuous ℝ Circ (nuTop h δ) circTop (cmulHom c) :=
  continuous_inf_dom_left (continuous_coe_circ.comp (continuous_const.mul continuous_id))

/-- **Lemma 16.3, second assertion.**  If `δ` is a group topology on `ℚ` with dual exactly `Γ`, every `ν`-continuous character is
`x ↦ p(c x + ∑ r_j h_j x)`. -/
theorem nu_dual_mp (h : κ → (ℝ →ₗ[ℚ] ℚ)) (hli : LinearIndependent ℚ h) (δ : TopologicalSpace ℚ)
    (hg : @IsTopologicalAddGroup ℚ δ _)
    (hdual : ∀ ψ : ℚ →+ Circ, @Continuous ℚ Circ δ _ ψ →
      ∃ r : ℚ, ∀ s : ℚ, ψ s = (((r * s : ℚ) : ℝ) : Circ))
    (χ : ℝ →+ Circ) (hχ : @Continuous ℝ Circ (nuTop h δ) circTop χ) :
    ∃ (c : ℝ) (r : κ → ℚ), ∀ x : ℝ, χ x = ((c * x + ∑ j, ((r j : ℚ) : ℝ) * (h j x : ℝ) : ℝ) : Circ) := by
  classical
  obtain ⟨ε, hε, V, hV, hsm⟩ := nu_char_data h δ χ hχ
  have hsmall : ∀ x ∈ (HM h).ker, |x| < ε → ‖χ x‖ < 1 / 4 := by
    intro x hx hxε
    apply hsm x hxε
    intro j
    have h0 : h j x = 0 := by
      have := congrFun (AddMonoidHom.mem_ker.mp hx) j
      simpa [HM_apply] using this
    rw [h0]; exact mem_of_mem_nhds (hV j)
  obtain ⟨c, hc⟩ := linearize χ (HM h).ker ε hε (HM_ker_qmul h) hsmall (HM_ker_dense h)
  let χ' : ℝ →+ Circ := χ + cmulHom (-c)
  have hχ'x : ∀ x, χ' x = χ x - ((c * x : ℝ) : Circ) := by
    intro x
    show χ x + ((-c * x : ℝ) : Circ) = _
    rw [neg_mul, AddCircle.coe_neg, sub_eq_add_neg]
  have hχ' : @Continuous ℝ Circ (nuTop h δ) circTop χ' :=
    @Continuous.add Circ _ _ _ ℝ (nuTop h δ) _ _ hχ (cmul_nu_continuous h δ (-c))
  obtain ⟨ε', hε', V', hV', hsm'⟩ := nu_char_data h δ χ' hχ'
  have hker0 : ∀ x ∈ (HM h).ker, χ' x = 0 := by
    intro x hx
    rw [hχ'x, hc x hx, sub_self]
  choose xs hxs using fun j : κ => HM_surj h hli (Pi.single j (1 : ℚ))
  have hHx : ∀ (t : ℚ) (j i : κ), h i ((t : ℝ) * xs j) = t * (Pi.single j (1 : ℚ) : κ → ℚ) i := by
    intro t j i
    rw [rat_mul_apply, ← HM_apply, hxs j]
  let θ : κ → (ℚ →+ Circ) := fun j =>
    AddMonoidHom.mk' (fun t : ℚ => χ' ((t : ℝ) * xs j)) (by intro s t; simp [add_mul])
  have hθ : ∀ j t, θ j t = χ' ((t : ℝ) * xs j) := fun j t => rfl
  have hθcont : ∀ j, @Continuous ℚ Circ δ _ (θ j) := by
    intro j
    letI : TopologicalSpace ℚ := δ
    haveI : IsTopologicalAddGroup ℚ := hg
    refine continuous_of_quarter_gen (θ j) (hV' j) ?_
    intro t ht
    obtain ⟨n, hnN, hn⟩ := (HM_ker_dense h).exists_mem_open
      (isOpen_Ioo : IsOpen (Set.Ioo (-((t : ℝ) * xs j) - ε') (-((t : ℝ) * xs j) + ε')))
      ⟨-((t : ℝ) * xs j), by constructor <;> linarith⟩
    have hy : |(t : ℝ) * xs j + n| < ε' := by
      rw [abs_lt]; constructor <;> linarith [hn.1, hn.2]
    have hHy : ∀ i, h i ((t : ℝ) * xs j + n) ∈ V' i := by
      intro i
      have hn0 : h i n = 0 := by
        have := congrFun (AddMonoidHom.mem_ker.mp hnN) i
        simpa [HM_apply] using this
      have h1 := hHx t j i
      rw [map_add, hn0, add_zero, h1]
      by_cases hij : i = j
      · subst hij; simpa using ht
      · simp [Pi.single_apply, hij]; exact mem_of_mem_nhds (hV' i)
    have := hsm' _ hy hHy
    have hχn : χ' ((t : ℝ) * xs j + n) = θ j t := by
      rw [map_add, hker0 n hnN, add_zero, hθ]
    rwa [hχn] at this
  choose r hr using fun j => hdual (θ j) (hθcont j)
  have hdecomp : ∀ x : ℝ, χ' x = ∑ j, θ j (h j x) := by
    intro x
    have hz : x - ∑ j, ((h j x : ℚ) : ℝ) * xs j ∈ (HM h).ker := by
      rw [AddMonoidHom.mem_ker]
      funext i
      rw [map_sub, map_sum]
      simp only [Pi.sub_apply, Finset.sum_apply, Pi.zero_apply]
      have : ∀ j, HM h (((h j x : ℚ) : ℝ) * xs j) i = h j x * (Pi.single j (1 : ℚ) : κ → ℚ) i := fun j => by
        rw [HM_apply]; exact hHx _ j i
      simp only [this]
      simp [Pi.single_apply, HM_apply]
    have h0 := hker0 _ hz
    rw [map_sub, map_sum] at h0
    have : χ' x = ∑ j, χ' (((h j x : ℚ) : ℝ) * xs j) := sub_eq_zero.mp h0
    rw [this]
    exact Finset.sum_congr rfl (fun j _ => (hθ j _).symm)
  refine ⟨c, r, fun x => ?_⟩
  have h1 : χ x = χ' x + ((c * x : ℝ) : Circ) := by rw [hχ'x]; abel
  rw [h1, hdecomp, AddCircle.coe_add, add_comm]
  congr 1
  have e : ∀ j, θ j (h j x) = (((r j : ℚ) : ℝ) * (h j x : ℝ) : ℝ) := by
    intro j
    rw [hr j]
    push_cast
    rfl
  rw [coe_circ_sum]
  exact Finset.sum_congr rfl (fun j _ => e j)

/-- **Lemma 16.3 for `γ₀`.**  The open-surjection assertion also holds with `γ₀` (the weak topology of `Γ`) in place of `γ`. -/
theorem HM_openSurj_gamma0 (h : κ → (ℝ →ₗ[ℚ] ℚ)) (hli : LinearIndependent ℚ h) :
    Continuous[nuTop h gamma0, @Pi.topologicalSpace κ (fun _ => ℚ) (fun _ => gamma0)] (HM h) ∧
      Function.Surjective (HM h) ∧
      @IsOpenMap ℝ (κ → ℚ) (nuTop h gamma0) (@Pi.topologicalSpace κ (fun _ => ℚ) (fun _ => gamma0)) (HM h) :=
  HM_openSurj h hli gamma0 gamma0_group

end Topo

end LeanCheck
