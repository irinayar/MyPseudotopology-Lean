import Mathlib
import LeanCheck.PGNullFilters
import LeanCheck.PGXi
import LeanCheck.PGTwoCoreflection
import LeanCheck.PGTwoTame

/-!
# PGtwo: coreflections that are neither discrete nor the given topology, and examples of tame ideals (Lean check)

Scope. The propositions of the second article (`PGtwo.tex`) on the ideal of sets inside finitely many cosets of a subgroup,
on members containing a subgroup, and on ideals with bounded arithmetic progressions, abstract form. `G` is a topological
abelian group (topology `β`), `xi I` the PG of `PGXi`, `idealNull β I` its null family, and `cosetNbhd β H` the filter
generated by the sets `W ∩ H` with `W` a neighbourhood of `0`.

* `cosetIdeal H` : the sets contained in `F + H` for a finite set `F`; `admIdeal_cosetIdeal` : it is admissible when `H`
  has infinite index;
* `kmem_cosetIdeal_iff` : if `G ⧸ H` is torsion-free, a group topology `γ` belongs to `𝒦(ξ)` iff its neighbourhood filter
  of `0` is finer than `cosetNbhd β H`;
* `exists_coarsest_cosetIdeal` : hence the topology with neighbourhood filter `cosetNbhd β H` (`H` open, with the
  topology induced by `β`) is the coarsest member; with `univ_of_coarsest` (`PGTwoCoreflection`) every continuous
  homomorphism from a topological group into the PG is continuous for it;
* `kmem_of_subgroup_member` : if a member of `I` contains a subgroup `H` with `cosetNbhd β H ≠ pure 0`, then `𝒦(ξ)` contains a
  nondiscrete topology;
* `tame_of_ap_bounded` : an ideal on `ℤ` whose members have bounded arithmetic progressions is tame (`PGTwoTame`).

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set Topology

namespace PG

section Cosets

variable {G : Type*} [AddCommGroup G]

/-- The sets contained in finitely many cosets of `H`. -/
def cosetIdeal (H : AddSubgroup G) : Set (Set G) :=
  {A | ∃ F : Set G, F.Finite ∧ A ⊆ Set.image2 (· + ·) F (H : Set G)}

theorem subgroup_mem_cosetIdeal (H : AddSubgroup G) : (H : Set G) ∈ cosetIdeal H :=
  ⟨{0}, Set.finite_singleton 0, fun x hx => ⟨0, rfl, x, hx, by simp⟩⟩

theorem admIdeal_cosetIdeal (H : AddSubgroup G) (hinf : ¬ Finite (G ⧸ H)) : AdmIdeal (cosetIdeal H) where
  sub := by
    rintro A ⟨F, hF, hA⟩ B hB
    exact ⟨F, hF, hB.trans hA⟩
  union := by
    rintro A ⟨F, hF, hA⟩ B ⟨F', hF', hB⟩
    refine ⟨F ∪ F', hF.union hF', ?_⟩
    rintro x (hx | hx)
    · obtain ⟨f, hf, h, hh, rfl⟩ := hA hx
      exact ⟨f, Or.inl hf, h, hh, rfl⟩
    · obtain ⟨f, hf, h, hh, rfl⟩ := hB hx
      exact ⟨f, Or.inr hf, h, hh, rfl⟩
  single := by
    intro x
    refine ⟨{x}, Set.finite_singleton x, ?_⟩
    intro y hy
    have : y = x := hy
    subst this
    exact ⟨y, rfl, 0, H.zero_mem, by simp⟩
  proper := by
    rintro ⟨F, hF, h⟩
    apply hinf
    have hsurj : (QuotientAddGroup.mk' H) '' F = Set.univ := by
      apply Set.eq_univ_of_forall
      intro q
      obtain ⟨g, rfl⟩ := QuotientAddGroup.mk_surjective q
      obtain ⟨f, hf, k, hk, hfk⟩ := h (Set.mem_univ g)
      refine ⟨f, hf, ?_⟩
      have hk0 : QuotientAddGroup.mk' H k = 0 := (QuotientAddGroup.eq_zero_iff k).2 hk
      have : QuotientAddGroup.mk' H g = QuotientAddGroup.mk' H f := by
        rw [← hfk, map_add, hk0, add_zero]
      exact this.symm
    have : (Set.univ : Set (G ⧸ H)).Finite := hsurj ▸ hF.image _
    exact Set.finite_univ_iff.1 this
  add := by
    rintro A ⟨F, hF, hA⟩ B ⟨F', hF', hB⟩
    refine ⟨Set.image2 (· + ·) F F', hF.image2 _ hF', ?_⟩
    rintro _ ⟨a, ha, b, hb, rfl⟩
    obtain ⟨f, hf, h, hh, rfl⟩ := hA ha
    obtain ⟨f', hf', h', hh', rfl⟩ := hB hb
    refine ⟨f + f', ⟨f, hf, f', hf', rfl⟩, h + h', H.add_mem hh hh', ?_⟩
    show f + f' + (h + h') = f + h + (f' + h')
    abel
  neg := by
    rintro A ⟨F, hF, hA⟩
    refine ⟨(fun x : G => -x) '' F, hF.image _, ?_⟩
    rintro _ ⟨a, ha, rfl⟩
    obtain ⟨f, hf, h, hh, rfl⟩ := hA ha
    refine ⟨-f, ⟨f, hf, rfl⟩, -h, H.neg_mem hh, ?_⟩
    show -f + -h = -(f + h)
    abel

/-- The null family of the PG of the topology `β` and the ideal `I`. The topology is an explicit argument because the
statements below involve a second topology on `G`. -/
def idealNull (β : TopologicalSpace G) (I : Set (Set G)) : Set (Filter G) := {F | xi I F 0}

/-- The filter generated by the sets `W ∩ H`, `W` a neighbourhood of `0` for `β`. -/
def cosetNbhd (β : TopologicalSpace G) (H : AddSubgroup G) : Filter G := @nhds G β 0 ⊓ 𝓟 (H : Set G)

variable [β : TopologicalSpace G]

theorem mem_idealNull {I : Set (Set G)} {F : Filter G} :
    F ∈ idealNull β I ↔ F.NeBot ∧ F ≤ @nhds G β 0 ∧ ∃ A ∈ I, A ∈ F := Iff.rfl

theorem le_cosetNbhd_iff {H : AddSubgroup G} {F : Filter G} :
    F ≤ cosetNbhd β H ↔ F ≤ @nhds G β 0 ∧ F ≤ 𝓟 (H : Set G) := le_inf_iff

theorem cosetNbhd_le (H : AddSubgroup G) : cosetNbhd β H ≤ @nhds G β 0 := inf_le_left

theorem mem_cosetNbhd_self (H : AddSubgroup G) : (H : Set G) ∈ cosetNbhd β H :=
  Filter.mem_inf_of_right (Filter.mem_principal_self _)

variable [IsTopologicalAddGroup G]

theorem nullFamily_idealNull {I : Set (Set G)} (hI : AdmIdeal I) : NullFamily (idealNull β I) :=
  nullFamily_of_conv (isPGConv_xi hI)

/-- `cosetNbhd β H` is a neighbourhood filter. -/
theorem isNbhdFilter_cosetNbhd (H : AddSubgroup G) : IsNbhdFilter (cosetNbhd β H) where
  zero_mem := by
    intro A hA
    unfold cosetNbhd at hA
    rw [Filter.mem_inf_principal] at hA
    exact mem_of_mem_nhds hA H.zero_mem
  neg_mem := by
    intro A hA
    unfold cosetNbhd at hA ⊢
    rw [Filter.mem_inf_principal] at hA ⊢
    have h1 := nhds_zero_isNbhdFilter.neg_mem _ hA
    refine Filter.mem_of_superset h1 ?_
    intro x hx hxH
    exact hx (H.neg_mem hxH)
  halve := by
    intro A hA
    unfold cosetNbhd at hA ⊢
    rw [Filter.mem_inf_principal] at hA
    obtain ⟨V, hV, hVA⟩ := exists_nhds_zero_half hA
    refine ⟨V ∩ (H : Set G), Filter.inter_mem_inf hV (Filter.mem_principal_self _), ?_⟩
    intro x hx y hy
    exact hVA x hx.1 y hy.1 (H.add_mem hx.2 hy.2)

/-- If `G ⧸ H` is torsion-free, the group topologies in `𝒦(ξ)` for the coset ideal are those whose neighbourhood filter of
`0` is finer than `𝓝 0 ⊓ 𝓟 H`. -/
theorem kmem_cosetIdeal_iff (H : AddSubgroup G) (hinf : ¬ Finite (G ⧸ H))
    (htf : ∀ (g : G) (n : ℕ), 0 < n → n • g ∈ H → g ∈ H)
    (γ : TopologicalSpace G) (hγ : @IsTopologicalAddGroup G γ _) :
    KMem (idealNull β (cosetIdeal H)) γ ↔ @nhds G γ 0 ≤ cosetNbhd β H := by
  rw [kmem_iff (nullFamily_idealNull (β := β) (admIdeal_cosetIdeal H hinf)) hγ, mem_idealNull (β := β),
    le_cosetNbhd_iff (β := β)]
  constructor
  · rintro ⟨_, hle, A, ⟨F, hF, hAF⟩, hAγ⟩
    refine ⟨hle, Filter.le_principal_iff.2 ?_⟩
    classical
    set Φ : Set (G ⧸ H) := (QuotientAddGroup.mk' H) '' F with hΦ
    have hΦfin : Φ.Finite := hF.image _
    set m : ℕ := hΦfin.toFinset.card + 1 with hm
    obtain ⟨W, hW, hWsum⟩ := @exists_nhds_sum G _ γ hγ m A hAγ
    refine Filter.mem_of_superset hW (fun x hx => ?_)
    by_contra hxH
    have hmem : ∀ k ∈ Finset.range m, QuotientAddGroup.mk' H ((k + 1) • x) ∈ hΦfin.toFinset := by
      intro k hk
      have hk' : k + 1 ≤ m := by
        have := Finset.mem_range.1 hk
        omega
      have h1 : (k + 1) • x ∈ A := by
        have := hWsum (k + 1) hk' (fun _ => x) (fun _ => hx)
        simpa using this
      obtain ⟨f, hf, h, hh, hfh⟩ := hAF h1
      rw [Set.Finite.mem_toFinset]
      refine ⟨f, hf, ?_⟩
      have h0 : QuotientAddGroup.mk' H h = 0 := (QuotientAddGroup.eq_zero_iff h).2 hh
      rw [← hfh, map_add, h0, add_zero]
    have hlt : hΦfin.toFinset.card < (Finset.range m).card := by
      rw [Finset.card_range]; omega
    obtain ⟨i, _, j, _, hij, hEq⟩ := Finset.exists_ne_map_eq_of_card_lt_of_maps_to hlt hmem
    have key : ∀ a b : ℕ, a < b → QuotientAddGroup.mk' H ((a + 1) • x) = QuotientAddGroup.mk' H ((b + 1) • x) →
        False := by
      intro a b hab hq
      have h2 : QuotientAddGroup.mk' H ((b - a) • x) = 0 := by
        have e : (b + 1) • x = (a + 1) • x + (b - a) • x := by
          rw [← add_nsmul]
          congr 1
          omega
        rw [e, map_add] at hq
        have h3 := hq.symm
        exact (add_eq_left.1 h3)
      have h4 : (b - a) • x ∈ H := (QuotientAddGroup.eq_zero_iff _).1 h2
      exact hxH (htf x (b - a) (by omega) h4)
    rcases Nat.lt_or_gt_of_ne hij with h | h
    · exact key i j h hEq
    · exact key j i h hEq.symm
  · intro h
    have hne : (@nhds G γ 0).NeBot := @nhds_neBot G γ 0
    refine ⟨hne, h.1, (H : Set G), subgroup_mem_cosetIdeal H, ?_⟩
    exact Filter.le_principal_iff.1 h.2

/-- The topology in which `H` is open with the topology induced by `β` is the coarsest member of `𝒦(ξ)`. -/
theorem exists_coarsest_cosetIdeal (H : AddSubgroup G) (hinf : ¬ Finite (G ⧸ H))
    (htf : ∀ (g : G) (n : ℕ), 0 < n → n • g ∈ H → g ∈ H) :
    ∃ t₀ : TopologicalSpace G, @nhds G t₀ 0 = cosetNbhd β H ∧ KMem (idealNull β (cosetIdeal H)) t₀ ∧
      ∀ t : TopologicalSpace G, KMem (idealNull β (cosetIdeal H)) t → @Continuous G G t t₀ id := by
  obtain ⟨t₀, ht₀, hnhds⟩ := exists_topology (isNbhdFilter_cosetNbhd (β := β) H)
  refine ⟨t₀, hnhds, (kmem_cosetIdeal_iff (β := β) H hinf htf t₀ ht₀).2 hnhds.le, fun t ht => ?_⟩
  have hle := (kmem_cosetIdeal_iff (β := β) H hinf htf t ht.1).1 ht
  have h : @Tendsto G G (⇑(AddMonoidHom.id G)) (@nhds G t 0) (@nhds G t₀ 0) := by
    rw [hnhds]; exact hle
  exact @hom_continuous_of_zero G _ G _ t₀ ht₀ t ht.1 (AddMonoidHom.id G) h

/-- A member of `I` containing a subgroup on which `β` is not discrete gives a nondiscrete topology in `𝒦(ξ)`. -/
theorem kmem_of_subgroup_member {I : Set (Set G)} (hI : AdmIdeal I) (H : AddSubgroup G)
    (hH : ∃ A ∈ I, (H : Set G) ⊆ A) (hnd : cosetNbhd β H ≠ pure 0) :
    ∃ t : TopologicalSpace G, KMem (idealNull β I) t ∧ @nhds G t 0 ≠ pure 0 := by
  obtain ⟨t, ht, hnhds⟩ := exists_topology (isNbhdFilter_cosetNbhd (β := β) H)
  refine ⟨t, (kmem_iff (nullFamily_idealNull (β := β) hI) ht).2 ?_, by rw [hnhds]; exact hnd⟩
  obtain ⟨A, hA, hHA⟩ := hH
  have hHI : (H : Set G) ∈ I := hI.sub A hA _ hHA
  have hne : (@nhds G t 0).NeBot := @nhds_neBot G t 0
  rw [mem_idealNull (β := β)]
  refine ⟨hne, ?_, (H : Set G), hHI, ?_⟩
  · rw [hnhds]; exact cosetNbhd_le (β := β) H
  · rw [hnhds]; exact mem_cosetNbhd_self (β := β) H

end Cosets

/-- An ideal on `ℤ` whose members contain only arithmetic progressions of bounded length is tame. -/
theorem tame_of_ap_bounded (I : Set (Set ℤ))
    (h : ∀ A ∈ I, ∃ R : ℕ, ∀ a d : ℤ, d ≠ 0 → ¬ ∀ j : ℕ, j ≤ R → a + (j : ℤ) * d ∈ A) : Tame I := by
  intro A hA
  obtain ⟨R, hR⟩ := h A hA
  refine ⟨R + 1, fun S _ hS => ?_⟩
  obtain ⟨s, hs, hs0⟩ : ∃ s ∈ S, s ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hS ((Set.finite_singleton (0 : ℤ)).subset (fun x hx => hcon x hx))
  have h1 := hR s s hs0
  push Not at h1
  obtain ⟨j, hj, hjA⟩ := h1
  refine ⟨j + 1, by omega, by omega, fun _ => s, fun _ => hs, ?_⟩
  have e : (∑ _i : Fin (j + 1), s) = s + (j : ℤ) * s := by
    simp [Finset.sum_const]
    ring
  rw [e]
  exact hjA

end PG
