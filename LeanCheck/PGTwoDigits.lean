import Mathlib
import LeanCheck.PGNullFilters
import LeanCheck.PGGenerated
import LeanCheck.PGTwoCoreflection

/-!
# PGtwo: ultrafilters containing rapidly growing finite-sum tails (Lean check)

Scope. Theorem 5.17 of the second article (`PGtwo.tex`), abstract form. Let `y : ℕ → ℤ` be a sequence of positive integers
such that for every `B` the inequality `2 B ∑_{i<l} y i < y l` holds for all large `l` (the ratio `y l / ∑_{i<l} y i` tends to
`∞`), and let `u` be an ultrafilter on `ℤ` containing, for every `m`, the set `FSset y m` of finite sums of distinct terms
`y i` with `i > m`.

* `digit_unique` : uniqueness of bounded coefficients above a threshold (the digit lemma);
* `rep_Sn` : every element of `Sn n (FSset y L)` is a sum `∑ c l * y l` with `|c l| ≤ n`, supported above `L`;
* `condM_of_growth` : such an ultrafilter `u` satisfies condition (M) of `PGTwoCoreflection`;
* `kernel_open_of_growth` : every continuous homomorphism from a topological group into the PG generated by `u` has an open
  kernel (Theorem 5.17, with Theorem 5.16).

The statement that every strongly summable ultrafilter on `ℕ` has such a sequence uses quoted results of the literature and
is not formalized.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set Pointwise Topology

namespace PG

/-- Finite sums of distinct terms `y i`, `i > m` (nonempty). -/
def FSset (y : ℕ → ℤ) (m : ℕ) : Set ℤ :=
  {z | ∃ s : Finset ℕ, s.Nonempty ∧ (∀ i ∈ s, m < i) ∧ z = ∑ i ∈ s, y i}

/-- The digit lemma: bounded coefficients are unique above the threshold. -/
theorem digit_unique (y : ℕ → ℤ) (hpos : ∀ i, 0 < y i) (B : ℕ) (L : ℕ)
    (hL : ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l) :
    ∀ (K : ℕ) (e : ℕ → ℤ), (∀ l, |e l| ≤ 2 * (B : ℤ)) → (∀ l, K ≤ l → e l = 0) →
      ∑ l ∈ Finset.range K, e l * y l = 0 → ∀ l, L < l → e l = 0 := by
  intro K
  induction K with
  | zero =>
    intro e _ hK _ l _
    exact hK l (Nat.zero_le _)
  | succ K ih =>
    intro e he hK hsum l hl
    by_cases hKL : K ≤ L
    · exact hK l (by omega)
    · push_neg at hKL
      have hEK : e K = 0 := by
        by_contra hne
        rw [Finset.sum_range_succ] at hsum
        have h1 : e K * y K = -∑ l ∈ Finset.range K, e l * y l := by linarith
        have h2 : |∑ l ∈ Finset.range K, e l * y l| ≤ 2 * (B : ℤ) * ∑ l ∈ Finset.range K, y l := by
          calc |∑ l ∈ Finset.range K, e l * y l| ≤ ∑ l ∈ Finset.range K, |e l * y l| :=
                Finset.abs_sum_le_sum_abs _ _
            _ ≤ ∑ l ∈ Finset.range K, 2 * (B : ℤ) * y l := by
                apply Finset.sum_le_sum
                intro l _
                rw [abs_mul, abs_of_pos (hpos l)]
                exact mul_le_mul_of_nonneg_right (he l) (hpos l).le
            _ = 2 * (B : ℤ) * ∑ l ∈ Finset.range K, y l := by rw [Finset.mul_sum]
        have h3 : y K ≤ |e K * y K| := by
          rw [abs_mul, abs_of_pos (hpos K)]
          have : (1 : ℤ) ≤ |e K| := Int.one_le_abs hne
          nlinarith [hpos K]
        have h4 := hL K hKL
        rw [h1, abs_neg] at h3
        linarith
      have hK' : ∀ l, K ≤ l → e l = 0 := by
        intro l hl'
        rcases Nat.eq_or_lt_of_le hl' with h | h
        · rw [← h]; exact hEK
        · exact hK l (by omega)
      have hs : ∑ l ∈ Finset.range K, e l * y l = 0 := by
        rw [Finset.sum_range_succ, hEK] at hsum
        simpa using hsum
      exact ih e he hK' hs l hl

/-- A representation with coefficients bounded by `n`, supported on the indices `> L`. -/
def Rep (y : ℕ → ℤ) (L n : ℕ) (z : ℤ) : Prop :=
  ∃ (K : ℕ) (c : ℕ → ℤ), (∀ l, |c l| ≤ (n : ℤ)) ∧ (∀ l, c l ≠ 0 → L < l ∧ l < K) ∧
    z = ∑ l ∈ Finset.range K, c l * y l

theorem sum_extend (f : ℕ → ℤ) {K K' : ℕ} (h : K ≤ K') (hz : ∀ l, K ≤ l → f l = 0) :
    ∑ l ∈ Finset.range K', f l = ∑ l ∈ Finset.range K, f l := by
  symm
  apply Finset.sum_subset (Finset.range_mono h)
  intro l hl hn
  apply hz
  simpa using hn

theorem rep_add (y : ℕ → ℤ) (L n : ℕ) {z a : ℤ} (hz : Rep y L n z) (ha : a ∈ FSset y L) (σ : ℤ)
    (hσ : |σ| = 1) : Rep y L (n + 1) (z + σ * a) := by
  obtain ⟨K, c, hc, hsupp, hzeq⟩ := hz
  obtain ⟨s, hs, hsL, rfl⟩ := ha
  set K' : ℕ := K + s.sup id + 1 with hK'
  have hsK : ∀ i ∈ s, i < K' := by
    intro i hi
    have : i ≤ s.sup id := Finset.le_sup (f := id) hi
    omega
  refine ⟨K', fun l => c l + σ * (if l ∈ s then 1 else 0), ?_, ?_, ?_⟩
  · intro l
    calc |c l + σ * (if l ∈ s then 1 else 0)| ≤ |c l| + |σ * (if l ∈ s then 1 else 0)| := abs_add_le _ _
      _ ≤ n + 1 := by
        have h1 := hc l
        have h2 : |σ * (if l ∈ s then (1 : ℤ) else 0)| ≤ 1 := by
          split_ifs
          · simp [hσ]
          · simp
        push_cast
        linarith
  · intro l hl
    by_cases hls : l ∈ s
    · exact ⟨hsL l hls, hsK l hls⟩
    · have hcl : c l ≠ 0 := by
        intro h0
        apply hl
        simp [h0, hls]
      have := hsupp l hcl
      exact ⟨this.1, by omega⟩
  · have e1 : ∑ l ∈ Finset.range K', c l * y l = ∑ l ∈ Finset.range K, c l * y l := by
      apply sum_extend (fun l => c l * y l) (by omega)
      intro l hl
      by_contra hne
      have : c l ≠ 0 := by
        intro h0; apply hne; simp [h0]
      have := (hsupp l this).2
      omega
    have e2 : ∑ l ∈ Finset.range K', (if l ∈ s then y l else 0) = ∑ l ∈ s, y l := by
      rw [Finset.sum_ite_mem]
      have : Finset.range K' ∩ s = s := by
        apply Finset.inter_eq_right.2
        intro i hi
        exact Finset.mem_range.2 (hsK i hi)
      rw [this]
    have e3 : ∀ l, (c l + σ * (if l ∈ s then (1 : ℤ) else 0)) * y l
        = c l * y l + σ * (if l ∈ s then y l else 0) := by
      intro l
      split_ifs <;> ring
    simp_rw [e3]
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, e1, e2, hzeq]

theorem rep_Sn (y : ℕ → ℤ) (L : ℕ) : ∀ n : ℕ, ∀ z : ℤ, z ∈ Sn n (FSset y L) → Rep y L n z := by
  intro n
  induction n with
  | zero =>
    intro z hz
    have : z = 0 := hz
    subst this
    exact ⟨0, fun _ => 0, by simp, by simp, by simp⟩
  | succ n ih =>
    intro z hz
    rcases hz with ⟨z', hz', a, ha, rfl⟩ | ⟨z', hz', b, hb, rfl⟩
    · have := rep_add y L n (ih z' hz') ha 1 (by simp)
      simpa using this
    · have hb' : -b ∈ FSset y L := by simpa using hb
      have := rep_add y L n (ih z' hz') hb' (-1) (by simp)
      simpa using this

/-- Theorem 5.17: an ultrafilter containing every tail of finite sums of a rapidly growing sequence satisfies (M). -/
theorem condM_of_growth (u : Ultrafilter ℤ) (y : ℕ → ℤ) (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l)
    (htail : ∀ m : ℕ, FSset y m ∈ (u : Filter ℤ)) : CondM u := by
  intro n n''
  refine ⟨FSset y 0, htail 0, n'', ?_⟩
  intro m hm
  obtain ⟨L, hL⟩ := hgrow (m * n)
  refine ⟨FSset y L, htail L, ?_⟩
  rw [Set.disjoint_left]
  rintro _ ⟨q, ⟨hq, hq0⟩, rfl⟩ hmq
  have hq0' : q ≠ 0 := fun h => hq0 h
  rcases Nat.eq_zero_or_pos n with hn | hn
  · subst hn
    exact hq0' (by simpa [Sn] using hq)
  obtain ⟨K1, c, hc, hcs, hqs⟩ := rep_Sn y L n q hq
  have hmq' : (m : ℤ) * q ∈ Sn n'' (FSset y 0) := hmq
  obtain ⟨K2, d, hd, hds, hms⟩ := rep_Sn y 0 n'' _ hmq'
  set K := K1 + K2 with hK
  set e : ℕ → ℤ := fun l => (m : ℤ) * c l - d l with he_def
  have hcK : ∀ l, K ≤ l → c l = 0 := by
    intro l hl
    by_contra hne
    have := (hcs l hne).2
    omega
  have hdK : ∀ l, K ≤ l → d l = 0 := by
    intro l hl
    by_contra hne
    have := (hds l hne).2
    omega
  have hcK1 : ∀ l, K1 ≤ l → c l = 0 := by
    intro l hl
    by_contra hne
    have := (hcs l hne).2
    omega
  have hdK2 : ∀ l, K2 ≤ l → d l = 0 := by
    intro l hl
    by_contra hne
    have := (hds l hne).2
    omega
  have hsum : ∑ l ∈ Finset.range K, e l * y l = 0 := by
    have h1 : ∑ l ∈ Finset.range K, c l * y l = q := by
      rw [hqs]
      exact sum_extend (fun l => c l * y l) (by omega) (fun l hl => by simp [hcK1 l hl])
    have h2 : ∑ l ∈ Finset.range K, d l * y l = (m : ℤ) * q := by
      rw [hms]
      exact sum_extend (fun l => d l * y l) (by omega) (fun l hl => by simp [hdK2 l hl])
    have : ∑ l ∈ Finset.range K, e l * y l
        = (m : ℤ) * ∑ l ∈ Finset.range K, c l * y l - ∑ l ∈ Finset.range K, d l * y l := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro l _
      simp only [he_def]; ring
    rw [this, h1, h2]; ring
  have hbound : ∀ l, |e l| ≤ 2 * ((m * n : ℕ) : ℤ) := by
    intro l
    have h1 : |(m : ℤ) * c l| ≤ ((m * n : ℕ) : ℤ) := by
      rw [abs_mul, Nat.abs_cast]
      push_cast
      exact mul_le_mul_of_nonneg_left (hc l) (by positivity)
    have h2 : |d l| ≤ ((m * n : ℕ) : ℤ) := by
      have : (n'' : ℤ) ≤ ((m * n : ℕ) : ℤ) := by
        have : n'' ≤ m * n := by nlinarith
        exact_mod_cast this
      exact (hd l).trans this
    calc |e l| = |(m : ℤ) * c l - d l| := rfl
      _ ≤ |(m : ℤ) * c l| + |d l| := abs_sub _ _
      _ ≤ 2 * ((m * n : ℕ) : ℤ) := by linarith
  have hkey := digit_unique y hpos (m * n) L hL K e hbound
    (fun l hl => by simp [he_def, hcK l hl, hdK l hl]) hsum
  have hc0 : ∀ l, c l = 0 := by
    intro l
    by_contra hne
    have hLl := (hcs l hne).1
    have h1 : e l = 0 := hkey l hLl
    have h2 : (m : ℤ) * c l = d l := by simp only [he_def] at h1; linarith
    have h3 : (m : ℤ) ≤ |d l| := by
      rw [← h2, abs_mul, Nat.abs_cast]
      have : (1 : ℤ) ≤ |c l| := Int.one_le_abs hne
      nlinarith [Nat.cast_nonneg (α := ℤ) m]
    have h4 := hd l
    have h5 : (n'' : ℤ) < m := by exact_mod_cast hm
    linarith
  apply hq0'
  rw [hqs]
  apply Finset.sum_eq_zero
  intro l _
  simp [hc0 l]

/-- Theorem 5.17: every continuous homomorphism from a topological group into the PG generated by such an ultrafilter has
an open kernel. -/
theorem kernel_open_of_growth (u : Ultrafilter ℤ) (y : ℕ → ℤ) (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l)
    (htail : ∀ m : ℕ, FSset y m ∈ (u : Filter ℤ))
    {T : Type*} [AddCommGroup T] [TopologicalSpace T] [IsTopologicalAddGroup T] (f : T →+ ℤ)
    (hf : XiCont (genNull u) f) : ∃ U ∈ 𝓝 (0 : T), ∀ x ∈ U, f x = 0 :=
  kernel_open_of_condM u (condM_of_growth u y hpos hgrow htail) f hf

end PG
