import Mathlib
import LeanCheck.PVGNotGroupPos
import LeanCheck.PVGNotGroupAClosure
import LeanCheck.PVGNotGroup
import LeanCheck.PVGSubMain

/-!
# PVG: the topological modification of `ξ_A` is not a group topology for every infinite `A ⊆ ℕ` (Lean check)

Scope. Addendum BV of the research note (Theorem 8.81 of PVG_v35): for an infinite set `A ⊆ ℕ` let `ξ_A = ξ_{τ_B, I_A}` (`subConv A`,
`I_A` = `IA A`, generated by the sets `[-m, m] + a₁ S_A + … + a_k S_A`, `S_A = {0} ∪ {±s_n : n ∈ A}`), and `τ_{ξ_A} = modTop (subConv A)`.

* `modTop_subConv_not_continuousAdd` : addition is not continuous at `(0, 0)` for `τ_{ξ_A}` (`A` infinite);
* `modTop_subConv_not_topAddGroup` : `τ_{ξ_A}` is not a group topology.

The proof is that of `PVGNotGroup` with the sequence `s_n` replaced by the subsequence `y_j = s_{φ j}`, `φ = Nat.nth (· ∈ A)` the increasing
enumeration of `A`: the sets `E_i` are built from `y` (`EiA`), the arithmetic is `pos_not_mem_piece` of `PVGNotGroupPos` applied to the positions
`φ(n-k), φ(m-l), φ n, φ m`, the closure lemma is `closure_EiA` (independence theorem for the sequence `y`), and the pieces `J_c = {c (y_a - y_b)}`
belong to `I_A`. Since `I_A ⊆ I_S` (`IA_sub_IS`), the finiteness part uses pieces of `I_S`.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires mathematical review.
-/

open Filter Topology Set Pointwise
open scoped Classical

namespace PVG
namespace Lac
open Q95

/-- `E = ⋃_{i ≥ 2} E_i` for the subsequence. -/
def EallA (φ : ℕ → ℕ) : Set ℝ := {y | ∃ i, 2 ≤ i ∧ y ∈ EiA φ i}

lemma zero_notMem_EallA (φ : ℕ → ℕ) (hφ : StrictMono φ) : (0 : ℝ) ∉ EallA φ := by
  rintro ⟨i, hi, k, l, n, m, hk1, hki, hl1, hli, hkl, hMn, hnm, h0⟩
  have hMMi : MM i = 3 * i + 4 := rfl
  have h1 : φ (n - k) < φ m := hφ (by omega)
  have h3 : φ n < φ m := hφ hnm
  have hp1 : 1 ≤ φ (n - k) := le_trans (by omega : 1 ≤ n - k) (hφ.id_le _)
  have hp3 : 1 ≤ φ n := le_trans (by omega : 1 ≤ n) (hφ.id_le _)
  exact pos_ne_zero (by omega : 1 ≤ i) hp1 hp3 h1 h3 h0.symm

lemma EiA_not_mem_piece (φ : ℕ → ℕ) (hφ : StrictMono φ) (m0 : ℝ) (l : List ℝ) :
    ∃ i0 : ℕ, ∀ i, i0 ≤ i → ∀ y ∈ EiA φ i, y ∉ Icc (-m0) m0 + sumSet l := by
  obtain ⟨i0, hi0⟩ := pos_not_mem_piece m0 l
  refine ⟨i0, fun i hi y hy => ?_⟩
  obtain ⟨k, l', n, m, hk1, hki, hl1, hli, hkl, hMn, hnm, rfl⟩ := hy
  have hMMi : MM i = 3 * i + 4 := rfl
  have h14 : φ (n - k) < φ m := hφ (by omega)
  have h24 : φ (m - l') < φ m := hφ (by omega)
  have h34 : φ n < φ m := hφ hnm
  have h13 : φ (n - k) ≠ φ n := fun h => by
    have := hφ.injective h
    omega
  have hMp : MM i ≤ φ n := le_trans hMn (hφ.id_le n)
  exact hi0 i hi _ _ _ _ h14 h24 h34 h13 hMp

lemma closure_J_EallA (A : Set ℕ) (φ : ℕ → ℕ) (hφ : StrictMono φ) {J : Set ℝ} (hJ : J ∈ IA A) :
    @closure ℝ bohrTop (J \ (EallA φ)ᶜ) ⊆ EallA φ := by
  letI : TopologicalSpace ℝ := bohrTop
  obtain ⟨m0, l, hJsub⟩ := IA_sub_IS A hJ
  obtain ⟨i0, hi0⟩ := EiA_not_mem_piece φ hφ m0 l
  have hsub : J \ (EallA φ)ᶜ ⊆ ⋃ j : Fin i0, EiA φ (j.1 + 2) := by
    rintro y ⟨hyJ, hyE⟩
    have hyE' : y ∈ EallA φ := by simpa using hyE
    obtain ⟨i, hi2, hyi⟩ := hyE'
    have hlt : i < i0 := by
      by_contra hge
      exact hi0 i (not_lt.1 hge) y hyi (hJsub hyJ)
    refine mem_iUnion.2 ⟨⟨i - 2, by omega⟩, ?_⟩
    have : i - 2 + 2 = i := by omega
    simpa [this] using hyi
  intro x hx
  have h1 : closure (J \ (EallA φ)ᶜ) ⊆ ⋃ j : Fin i0, EiA φ (j.1 + 2) := by
    calc closure (J \ (EallA φ)ᶜ) ⊆ closure (⋃ j : Fin i0, EiA φ (j.1 + 2)) := closure_mono hsub
      _ = ⋃ j : Fin i0, closure (EiA φ (j.1 + 2)) := closure_iUnion_of_finite _
      _ ⊆ ⋃ j : Fin i0, EiA φ (j.1 + 2) := iUnion_mono fun j y hy => closure_EiA φ hφ (by omega) hy
  obtain ⟨j, hj⟩ := mem_iUnion.1 (h1 hx)
  exact ⟨j.1 + 2, by omega, hj⟩

/-- `ℝ \ E` is `τ_{ξ_A}`-open. -/
theorem EallA_compl_open (A : Set ℕ) (φ : ℕ → ℕ) (hφ : StrictMono φ) (hφA : ∀ j, φ j ∈ A) :
    @IsOpen ℝ (modTop (subConv A)) (EallA φ)ᶜ := by
  have hmem := @mem_modTop_iff ℝ _ _ bohrTop bohr_isTopologicalAddGroup bohr_constSMul (IA A) (EallA φ)ᶜ
  refine hmem.2 ?_
  intro J hJ
  rw [Set.eq_empty_iff_forall_notMem]
  rintro x ⟨hx1, hx2⟩
  exact hx2 (closure_J_EallA A φ hφ hJ hx1)

/-- `J_c = {c (y_a - y_b) : a, b ≥ 1}` belongs to `I_A`. -/
def JcA (φ : ℕ → ℕ) (c : ℝ) : Set ℝ := {z | ∃ a b : ℕ, 1 ≤ a ∧ 1 ≤ b ∧ z = c * (yA φ a - yA φ b)}

lemma JcA_mem_IA (A : Set ℕ) (φ : ℕ → ℕ) (hφ : StrictMono φ) (hφA : ∀ j, φ j ∈ A) (c : ℝ) : JcA φ c ∈ IA A := by
  have hS : ∀ a : ℕ, 1 ≤ a → yA φ a ∈ SsetA A := fun a ha =>
    Or.inr ⟨φ a, hφA a, le_trans ha (hφ.id_le a), Or.inl rfl⟩
  refine ⟨0, [c, -c], ?_⟩
  rintro z ⟨a, b, ha, hb, rfl⟩
  refine ⟨0, ⟨by simp, by simp⟩, c * yA φ a + ((-c) * yA φ b + 0), ?_, by ring⟩
  refine ⟨c * yA φ a, ⟨yA φ a, hS a ha, rfl⟩, (-c) * yA φ b + 0, ?_, rfl⟩
  exact ⟨(-c) * yA φ b, ⟨yA φ b, hS b hb, rfl⟩, 0, rfl, rfl⟩

/-- Local Bohr neighbourhoods inside a `τ_{ξ_{τ_B,I}}`-neighbourhood of `0`, for any family `I`. -/
lemma local_bohrI (I : Set (Set ℝ)) {V : Set ℝ} (hV : @IsOpen ℝ (modTop (@xiConv ℝ bohrTop I)) V)
    (h0 : (0 : ℝ) ∈ V) {J : Set ℝ} (hJ : J ∈ I) :
    ∃ Y : Set K, IsOpen Y ∧ e 0 ∈ Y ∧ ∀ z ∈ J, e z ∈ Y → z ∈ V := by
  have hmem := @mem_modTop_iff ℝ _ _ bohrTop bohr_isTopologicalAddGroup bohr_constSMul I V
  have hcl := hmem.1 hV J hJ
  have hOopen : @IsOpen ℝ bohrTop (@closure ℝ bohrTop (J \ V))ᶜ :=
    (@isOpen_compl_iff ℝ (@closure ℝ bohrTop (J \ V)) bohrTop).2 (@isClosed_closure ℝ bohrTop _)
  obtain ⟨Y, hY, hYO⟩ := bohr_open_pre hOopen
  have h0O : (0 : ℝ) ∈ (@closure ℝ bohrTop (J \ V))ᶜ := by
    intro h
    have : (0 : ℝ) ∈ @closure ℝ bohrTop (J \ V) ∩ V := ⟨h, h0⟩
    rw [hcl] at this
    exact this
  refine ⟨Y, hY, ?_, ?_⟩
  · rw [← hYO] at h0O
    exact h0O
  · intro z hzJ hzY
    by_contra hzV
    have hzO : z ∈ (@closure ℝ bohrTop (J \ V))ᶜ := by rw [← hYO]; exact hzY
    exact hzO (@subset_closure ℝ bohrTop (J \ V) z ⟨hzJ, hzV⟩)

/-- **Theorem 8.79**: addition is not continuous for `τ_ξ`. -/
theorem modTop_not_continuousAdd_phi (A : Set ℕ) (φ : ℕ → ℕ) (hφ : StrictMono φ)
    (hφA : ∀ j, φ j ∈ A) : ¬ @ContinuousAdd ℝ (modTop (subConv A)) _ := by
  intro hca
  letI τ : TopologicalSpace ℝ := modTop (subConv A)
  have hU : IsOpen (EallA φ)ᶜ := EallA_compl_open A φ hφ hφA
  have hcont : Continuous (fun p : ℝ × ℝ => p.1 + p.2) := hca.continuous_add
  have hpre := hcont.isOpen_preimage (EallA φ)ᶜ hU
  have h00 : ((0 : ℝ), (0 : ℝ)) ∈ (fun p : ℝ × ℝ => p.1 + p.2) ⁻¹' (EallA φ)ᶜ := by
    simpa using zero_notMem_EallA φ hφ
  obtain ⟨V1, V2, hV1, hV2, h01, h02, hsub⟩ := isOpen_prod_iff.1 hpre 0 0 h00
  set V : Set ℝ := V1 ∩ V2 with hVdef
  have hVopen : IsOpen V := hV1.inter hV2
  have h0V : (0 : ℝ) ∈ V := ⟨h01, h02⟩
  have hVV : ∀ u ∈ V, ∀ w ∈ V, u + w ∈ (EallA φ)ᶜ := fun u hu w hw => hsub (Set.mk_mem_prod hu.1 hw.2)
  -- a free ultrafilter and the points `L(W₀ - k)`
  obtain ⟨W0, hW0⟩ : ∃ W0 : Ultrafilter ℕ, Free W0 := ⟨Ultrafilter.of Filter.cofinite, Ultrafilter.of_le _⟩
  set p : ℕ → K := fun k => L (yA φ) (shiftU k W0) with hp
  -- the Bohr neighbourhood for `J₀ = J_1`
  obtain ⟨Y0, hY0, h0Y0, hY0V⟩ := local_bohrI (IA A) hVopen h0V (JcA_mem_IA A φ hφ hφA 1)
  obtain ⟨κ, hκ⟩ := exists_clusterPt_of_compactSpace (Filter.map p atTop)
  have hsub0 : ∃ V1 ∈ 𝓝 κ, ∀ a ∈ V1, ∀ c ∈ V1, a - c ∈ Y0 := by
    have h1 : Tendsto (fun q : K × K => q.1 - q.2) (𝓝 (κ, κ)) (𝓝 (κ - κ)) :=
      continuous_sub.tendsto (κ, κ)
    rw [sub_self] at h1
    have h2 := h1 (hY0.mem_nhds (by simpa [e_zero] using h0Y0))
    rw [nhds_prod_eq, Filter.mem_map, mem_prod_self_iff] at h2
    obtain ⟨V1, hV1, hV1sub⟩ := h2
    exact ⟨V1, hV1, fun a ha c hc => hV1sub (Set.mk_mem_prod ha hc)⟩
  obtain ⟨Vk, hVk, hVkY⟩ := hsub0
  have hfreq : ∃ᶠ j in atTop, p j ∈ Vk := (mapClusterPt_iff_frequently.1 hκ) Vk hVk
  rw [Filter.frequently_atTop] at hfreq
  obtain ⟨k, hk1, hkV⟩ := hfreq 1
  obtain ⟨l, hl, hlV⟩ := hfreq (k + 1)
  have hl1 : 1 ≤ l := by omega
  have hkl : k ≠ l := by omega
  have hpkl : p k - p l ∈ Y0 := hVkY _ hkV _ hlV
  -- the index `i` and the Bohr neighbourhood for `J_{c_i}`
  set i : ℕ := max (max k l) 2 with hi
  have hi2 : 2 ≤ i := le_max_right _ _
  have hki : k ≤ i := le_trans (le_max_left _ _) (le_max_left _ _)
  have hli : l ≤ i := le_trans (le_max_right _ _) (le_max_left _ _)
  set c : ℝ := cc i with hc
  obtain ⟨Yi, hYi, h0Yi, hYiV⟩ := local_bohrI (IA A) hVopen h0V (JcA_mem_IA A φ hφ hφA c)
  have h0Yi' : (0 : K) ∈ Yi := by simpa [e_zero] using h0Yi
  have h0Y0' : (0 : K) ∈ Y0 := by simpa [e_zero] using h0Y0
  -- convergence along `W₀`
  have hpl : ∀ l' : ℕ, Tendsto (fun m => e (yA φ (m - l'))) (W0 : Filter ℕ) (𝓝 (p l')) :=
    fun l' => tendsto_e_comp (yA φ) W0 (fun m => m - l')
  have hL3 : Tendsto (fun m => e (yA φ m)) (W0 : Filter ℕ) (𝓝 (L (yA φ) W0)) := tendsto_L (yA φ) W0
  have hsm : ∀ κ : K, Tendsto (fun κ' : K => c • κ') (𝓝 κ) (𝓝 (c • κ)) :=
    fun κ => (continuous_smul_const c).tendsto κ
  -- first coordinate `n`
  have hB1 : ∀ᶠ n in (W0 : Filter ℕ), e (yA φ (n - k)) - p l ∈ Y0 := by
    have := (hpl k).sub_const (p l)
    exact this.eventually (hY0.mem_nhds hpkl)
  have hB2 : ∀ᶠ n in (W0 : Filter ℕ), c • e (yA φ n) - c • L (yA φ) W0 ∈ Yi := by
    have h1 := ((hsm _).comp hL3).sub_const (c • L (yA φ) W0)
    rw [sub_self] at h1
    exact h1.eventually (hYi.mem_nhds h0Yi')
  have hB3 : ∀ᶠ n in (W0 : Filter ℕ), MM i ≤ n := by
    refine hW0 (Filter.mem_cofinite.2 ((Set.finite_Iio (MM i)).subset ?_))
    intro n hn
    simpa using hn
  obtain ⟨n, hn1, hn2, hn3⟩ : ∃ n, e (yA φ (n - k)) - p l ∈ Y0 ∧ c • e (yA φ n) - c • L (yA φ) W0 ∈ Yi ∧
      MM i ≤ n := ((hB1.and hB2).and hB3).exists.imp fun n h => ⟨h.1.1, h.1.2, h.2⟩
  -- second coordinate `m`
  have hC1 : ∀ᶠ m in (W0 : Filter ℕ), e (yA φ (n - k)) - e (yA φ (m - l)) ∈ Y0 := by
    have := (tendsto_const_nhds (x := e (yA φ (n - k)))).sub (hpl l)
    exact this.eventually (hY0.mem_nhds hn1)
  have hC2 : ∀ᶠ m in (W0 : Filter ℕ), c • e (yA φ n) - c • e (yA φ m) ∈ Yi := by
    have := (tendsto_const_nhds (x := c • e (yA φ n))).sub ((hsm _).comp hL3)
    exact this.eventually (hYi.mem_nhds hn2)
  have hC3 : ∀ᶠ m in (W0 : Filter ℕ), n < m := by
    refine hW0 (Filter.mem_cofinite.2 ((Set.finite_Iic n).subset ?_))
    intro m hm
    simpa using hm
  obtain ⟨m, hm1, hm2, hm3⟩ : ∃ m, e (yA φ (n - k)) - e (yA φ (m - l)) ∈ Y0 ∧
      c • e (yA φ n) - c • e (yA φ m) ∈ Yi ∧ n < m :=
    ((hC1.and hC2).and hC3).exists.imp fun m h => ⟨h.1.1, h.1.2, h.2⟩
  have hMM : MM i = 3 * i + 4 := rfl
  have hn1' : 1 ≤ n - k := by omega
  have hm1' : 1 ≤ m - l := by omega
  have hnpos : 1 ≤ n := by omega
  have hmpos : 1 ≤ m := by omega
  -- `u` and `w` lie in `V`
  have hu : yA φ (n - k) - yA φ (m - l) ∈ V := by
    have h1 : (1 : ℝ) * (yA φ (n - k) - yA φ (m - l)) ∈ JcA φ 1 := ⟨n - k, m - l, hn1', hm1', rfl⟩
    have h2 : e ((1 : ℝ) * (yA φ (n - k) - yA φ (m - l))) ∈ Y0 := by
      rw [one_mul, e_sub]; exact hm1
    simpa using hY0V _ h1 h2
  have hw : c * (yA φ n - yA φ m) ∈ V := by
    have h1 : c * (yA φ n - yA φ m) ∈ JcA φ c := ⟨n, m, hnpos, hmpos, rfl⟩
    have h2 : e (c * (yA φ n - yA φ m)) ∈ Yi := by
      rw [e_mul_sub]; exact hm2
    exact hYiV _ h1 h2
  have hyE : yA φ (n - k) - yA φ (m - l) + c * (yA φ n - yA φ m) ∈ EallA φ :=
    ⟨i, hi2, ⟨k, l, n, m, hk1, hki, hl1, hli, hkl, hn3, hm3, rfl⟩⟩
  exact hVV _ hu _ hw hyE

/-- **Addition is not continuous at `(0,0)` for `τ_{ξ_A}`, `A` infinite.** -/
theorem modTop_subConv_not_continuousAdd (A : Set ℕ) (hA : A.Infinite) :
    ¬ @ContinuousAdd ℝ (modTop (subConv A)) _ :=
  modTop_not_continuousAdd_phi A (Nat.nth (· ∈ A)) (Nat.nth_strictMono hA)
    (fun j => Nat.nth_mem_of_infinite hA j)

/-- `τ_{ξ_A}` is not a group topology, `A` infinite. -/
theorem modTop_subConv_not_topAddGroup (A : Set ℕ) (hA : A.Infinite) :
    ¬ @IsTopologicalAddGroup ℝ (modTop (subConv A)) _ := by
  intro h
  exact modTop_subConv_not_continuousAdd A hA
    (@IsTopologicalAddGroup.toContinuousAdd ℝ (modTop (subConv A)) _ h)

end Lac
end PVG
