import Mathlib
import LeanCheck.PGFourQuotient

/-!
# PGfour: quotients by sequences, for a first countable topology and a countably generated ideal

Setting of `PGFourQuotient`. The topology of `G` is first countable and `I` is generated by the increasing sets `E n`.

* `quotient_eq_iff_seq` : the final quotient equals the PG of the quotient topology and the image ideal iff every
  sequence in the image of a member of `I` that converges to `0` has a subsequence that is the image of a sequence
  converging to `0` inside one `E n`.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set Topology

namespace PG.Quot

variable {G : Type*} [AddCommGroup G] [TopologicalSpace G] [IsTopologicalAddGroup G]
variable {N : AddSubgroup G} {I : Set (Set G)}

theorem quotient_eq_iff_seq [FirstCountableTopology G] (hI : AdmIdeal I) (E : ℕ → Set G)
    (hE : ∀ n, E n ∈ I) (hcof : ∀ B ∈ I, ∃ n, B ⊆ E n) :
    quotC N (nullXi I) = nullTarget N I ↔
      ∀ A ∈ I, ∀ h : ℕ → G ⧸ N, (∀ i, h i ∈ (QuotientAddGroup.mk : G → G ⧸ N) '' A) →
        Tendsto h atTop (𝓝 0) →
        ∃ n, ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ a : ℕ → G, (∀ k, a k ∈ E n) ∧
          (∀ k, (QuotientAddGroup.mk (a k) : G ⧸ N) = h (φ k)) ∧ Tendsto a atTop (𝓝 0) := by
  classical
  set q : G → G ⧸ N := QuotientAddGroup.mk with hq
  obtain ⟨U, hU⟩ := (𝓝 (0 : G)).exists_antitone_basis
  have hUmem : ∀ k, U k ∈ 𝓝 (0 : G) := fun k => hU.toHasBasis.mem_of_mem trivial
  constructor
  · intro heq A hA h hhA hh
    set u : Ultrafilter ℕ := Ultrafilter.of atTop with hu
    have huat : (u : Filter ℕ) ≤ atTop := Ultrafilter.of_le _
    set W : Ultrafilter (G ⧸ N) := u.map h with hW
    have hW0 : (W : Filter (G ⧸ N)) ≤ 𝓝 0 := le_trans (Filter.map_mono huat) hh
    have hWA : q '' A ∈ (W : Filter (G ⧸ N)) :=
      Ultrafilter.mem_map.2 (Filter.univ_mem' fun i => hhA i)
    have htar : (W : Filter (G ⧸ N)) ∈ nullTarget N I := ⟨inferInstance, hW0, A, hA, hWA⟩
    rw [← heq] at htar
    obtain ⟨σ, hσ, hle⟩ := htar.2 W le_rfl
    obtain ⟨F0, ⟨_, hF1, B, hB, hBF⟩, rfl⟩ := sumClosure_mem N (nullXi_nullFamily hI) hσ
    obtain ⟨n, hn⟩ := hcof B hB
    have hfreq : ∀ k, ∃ᶠ i in atTop, h i ∈ q '' (U k ∩ E n) := by
      intro k
      have h1 : q '' (U k ∩ B) ∈ (W : Filter (G ⧸ N)) :=
        hle (image_mem_map (inter_mem (hF1 (hUmem k)) hBF))
      have h2 : q '' (U k ∩ E n) ∈ (W : Filter (G ⧸ N)) :=
        mem_of_superset h1 (image_mono (inter_subset_inter_right _ hn))
      have h3 : {i | h i ∈ q '' (U k ∩ E n)} ∈ (u : Filter ℕ) := Ultrafilter.mem_map.1 h2
      intro hev
      have h4 : {i | h i ∉ q '' (U k ∩ E n)} ∈ (u : Filter ℕ) := huat hev
      obtain ⟨i, hi1, hi2⟩ := Ultrafilter.nonempty_of_mem (inter_mem h3 h4)
      exact hi2 hi1
    obtain ⟨φ, hφ, hmem⟩ := extraction_forall_of_frequently hfreq
    choose a ha hqa using hmem
    exact ⟨n, φ, hφ, a, fun k => (ha k).2, hqa, hU.tendsto fun k => (ha k).1⟩
  · intro H
    refine eq_of_lift hI fun W hW0 A hA hAW => ?_
    have : ∃ B ∈ I, ∀ V ∈ 𝓝 (0 : G), q '' (V ∩ B) ∈ W := by
      by_contra hno
      push Not at hno
      have hk : ∀ n, ∃ k, q '' (U k ∩ E n) ∉ W := by
        intro n
        obtain ⟨V, hV, hVW⟩ := hno (E n) (hE n)
        obtain ⟨k, _, hkV⟩ := hU.toHasBasis.mem_iff.1 hV
        exact ⟨k, fun h => hVW (mem_of_superset h (image_mono (inter_subset_inter_left _ hkV)))⟩
      choose κ hκ using hk
      have hpt : ∀ i, ∃ z, z ∈ q '' U i ∧ z ∈ q '' A ∧ ∀ n ≤ i, z ∉ q '' (U (κ n) ∩ E n) := by
        intro i
        have h1 : q '' U i ∈ (W : Filter (G ⧸ N)) := hW0 (mk_image_nhds (hUmem i))
        have h2 : (⋂ n ∈ Iic i, (q '' (U (κ n) ∩ E n))ᶜ) ∈ (W : Filter (G ⧸ N)) :=
          (biInter_mem (finite_Iic i)).2 fun n _ => Ultrafilter.compl_mem_iff_notMem.2 (hκ n)
        obtain ⟨z, ⟨hz1, hz2⟩, hz3⟩ := Ultrafilter.nonempty_of_mem (inter_mem (inter_mem h1 hAW) h2)
        exact ⟨z, hz1, hz2, fun n hn => mem_iInter₂.1 hz3 n hn⟩
      choose h hhU hhA hhne using hpt
      have htend : Tendsto h atTop (𝓝 0) := by
        intro S hS
        have h1 : q ⁻¹' S ∈ 𝓝 (0 : G) := tendsto_mk_zero hS
        obtain ⟨k, _, hkS⟩ := hU.toHasBasis.mem_iff.1 h1
        refine mem_atTop_sets.2 ⟨k, fun i hi => ?_⟩
        obtain ⟨x, hx, hxh⟩ := hhU i
        show h i ∈ S
        rw [← hxh]
        exact hkS (hU.antitone hi hx)
      obtain ⟨n, φ, hφ, a, haE, hqa, hat⟩ := H A hA h hhA htend
      obtain ⟨K, hK⟩ := mem_atTop_sets.1 (hat (hUmem (κ n)))
      have h1 := hK (max K n) (le_max_left _ _)
      refine hhne (φ (max K n)) n (le_trans (le_max_right K n) (hφ.id_le _)) ?_
      exact ⟨a (max K n), ⟨h1, haE _⟩, hqa _⟩
    obtain ⟨B, hB, hBW⟩ := this
    exact lift_of_mem hB hBW

end PG.Quot
