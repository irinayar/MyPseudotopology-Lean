import LeanCheck.PVGTwoFinest

/-!
# PVGthree: rigidity of a sequence, and the topology generated by the parity topologies

For a sequence `δ_k → 0`:

* `Rig δ` : the conclusion of the rigidity theorem for `δ`;
* `parOf δ h0 θ` : the topology `γ_{δ,θ}`; `gamOf δ h0` : the topology generated by all of them;
* `serves_gam` : `γ_δ` serves `A(δ)`;
* `rig_of_finest` : if `gamOf δ h0` is finer than every topology that serves `A(δ)`, then `Rig δ`.

Order of topologies as in Mathlib: `γ₁ ≤ γ₂` means that `γ₁` is finer. Sequences are indexed from `0`.
-/

open Filter Topology Set
open scoped Pointwise

namespace PVG
namespace Three
open Two Q95 Lac

/-- The conclusion of the rigidity theorem for the sequence `δ`. -/
def Rig (δ : ℕ → ℝ) : Prop :=
  ∀ γ : TopologicalSpace ℝ, @IsTopologicalAddGroup ℝ γ _ → euclidNhds 0 ≤ @nhds ℝ γ 0 →
    (∀ a : ℝ, InA δ sT a → Tb (@nhds ℝ γ 0) (dil a Sset)) →
      ∀ W ∈ @nhds ℝ γ 0, ∃ ε : ℝ, 0 < ε ∧ ∃ F : Finset ℝ, ∀ x : ℝ, (∀ k, dint (δ k * x) ≤ ε) → ∃ f ∈ F, x - f ∈ W

/-- `γ_{δ,θ}`: the group topology with the sets `Nset` as a base, joined with the Bohr topology. -/
noncomputable def parOf (δ : ℕ → ℝ) (h0 : Tendsto δ atTop (𝓝 0)) (θ : ℕ → AddCircle (1 : ℝ)) : TopologicalSpace ℝ :=
  Classical.choose (exists_par δ h0 θ) ⊓ bohrTop

lemma parOf_nhds (δ : ℕ → ℝ) (h0 : Tendsto δ atTop (𝓝 0)) (θ : ℕ → AddCircle (1 : ℝ)) :
    @nhds ℝ (parOf δ h0 θ) 0 = @nhds ℝ (Classical.choose (exists_par δ h0 θ)) 0 ⊓ @nhds ℝ bohrTop 0 :=
  @nhds_inf ℝ (Classical.choose (exists_par δ h0 θ)) bohrTop 0

lemma parOf_spec (δ : ℕ → ℝ) (h0 : Tendsto δ atTop (𝓝 0)) (h1 : ∀ k, |δ k| ≤ 1) (θ : ℕ → AddCircle (1 : ℝ)) :
    @IsTopologicalAddGroup ℝ (parOf δ h0 θ) _ ∧ parOf δ h0 θ ≤ gamTop δ ∧ euclidNhds 0 ≤ @nhds ℝ (parOf δ h0 θ) 0 ∧
      (∀ a : ℝ, InA δ sT a → Tb (@nhds ℝ (parOf δ h0 θ) 0) (dil a Sset)) ∧
      ∀ ε η : ℝ, 0 < ε → ε ≤ 1 / 5 → 0 < η → Nset δ θ ε η ∈ @nhds ℝ (parOf δ h0 θ) 0 := by
  obtain ⟨hτ, hb⟩ := Classical.choose_spec (exists_par δ h0 θ)
  have hg : @IsTopologicalAddGroup ℝ (parOf δ h0 θ) _ := isTopologicalAddGroup_inf hτ bohr_group
  have hN : ∀ ε η : ℝ, 0 < ε → ε ≤ 1 / 5 → 0 < η → Nset δ θ ε η ∈ @nhds ℝ (parOf δ h0 θ) 0 :=
    fun ε η hε hε5 hη => nhds_mono (inf_le_left : parOf δ h0 θ ≤ Classical.choose (exists_par δ h0 θ))
      (hb.mem_of_mem (i := (ε, η)) ⟨hε, hε5, hη⟩)
  obtain ⟨γ', hg', hgam', heu', htb', hN'⟩ := parity_serves δ h0 h1 θ
  have h2 : γ' ≤ Classical.choose (exists_par δ h0 θ) := by
    refine le_of_nhds_zero _ _ hg' hτ fun W hW => ?_
    obtain ⟨⟨ε, η⟩, ⟨hε, hε5, hη⟩, hsub⟩ := hb.mem_iff.1 hW
    exact Filter.mem_of_superset (hN' ε η hε hε5 hη) hsub
  have h3 : γ' ≤ parOf δ h0 θ := le_inf h2 (hgam'.trans (gam_le_bohr _))
  have h4 : @nhds ℝ γ' 0 ≤ @nhds ℝ (parOf δ h0 θ) 0 := nhds_mono h3
  refine ⟨hg, ?_, heu'.trans h4, fun a ha V hV => htb' a ha V (h4 hV), hN⟩
  refine le_of_nhds_zero _ _ hg (gam_group δ) fun W hW => ?_
  obtain ⟨B, hB, η, hη, hBW⟩ := (mem_nhds_gam δ W).1 hW
  have hε : 0 < min η (1 / 5 : ℝ) := lt_min hη (by norm_num)
  have h5 := hN _ 1 hε (min_le_right _ _) one_pos
  have h6 : B ∈ @nhds ℝ (parOf δ h0 θ) 0 := nhds_mono (inf_le_right : parOf δ h0 θ ≤ bohrTop) hB
  refine Filter.mem_of_superset (Filter.inter_mem h6 h5) fun x hx => ?_
  exact hBW x hx.1 fun k => (hx.2.1 k).trans (min_le_left _ _)

/-- The topology generated by all `γ_{δ,θ}`. -/
noncomputable def gamOf (δ : ℕ → ℝ) (h0 : Tendsto δ atTop (𝓝 0)) : TopologicalSpace ℝ :=
  ⨅ θ : ℕ → AddCircle (1 : ℝ), parOf δ h0 θ

/-- `γ_δ` serves `A(δ)`. -/
lemma serves_gam (δ : ℕ → ℝ) (h0 : Tendsto δ atTop (𝓝 0)) (h1 : ∀ k, |δ k| ≤ 1) (hne : ∀ k, δ k ≠ 0) :
    Serves (gamTop δ) {a | InA δ sT a} := by
  refine ⟨gam_group δ, gam_le_bohr δ, gam_ne_bohr δ (infinite_range_of_tendsto δ hne h0),
    gam_coarser_euclid δ 1 h1 0, fun a ha V hV => ?_⟩
  obtain ⟨γ', -, hgam', -, htb', -⟩ := parity_serves δ h0 h1 0
  exact htb' a ha V (nhds_mono hgam' hV)

lemma parOf_serves (δ : ℕ → ℝ) (h0 : Tendsto δ atTop (𝓝 0)) (h1 : ∀ k, |δ k| ≤ 1) (hne : ∀ k, δ k ≠ 0)
    (θ : ℕ → AddCircle (1 : ℝ)) : Serves (parOf δ h0 θ) {a | InA δ sT a} := by
  obtain ⟨hg, hgam, heu, htb, -⟩ := parOf_spec δ h0 h1 θ
  have hs := serves_gam δ h0 h1 hne
  refine ⟨hg, hgam.trans (gam_le_bohr _), fun h => ?_, heu, htb⟩
  have h2 : bohrTop ≤ gamTop δ := h ▸ hgam
  exact hs.2.2.1 (le_antisymm (gam_le_bohr _) h2)

/-- A basic neighbourhood inside every neighbourhood of `0` of `gamOf`. -/
lemma gamOf_base (δ : ℕ → ℝ) (h0 : Tendsto δ atTop (𝓝 0)) (W : Set ℝ) (hW : W ∈ @nhds ℝ (gamOf δ h0) 0) :
    ∃ (C : Finset ℝ) (F : Finset (ℕ → AddCircle (1 : ℝ))) (η' ε η : ℝ), 0 < η' ∧ 0 < ε ∧ 0 < η ∧
      ∀ x, x ∈ bset C η' → (∀ k, dint (δ k * x) ≤ ε) → (∀ θ ∈ F, ‖Phit δ θ x‖ ≤ η) → x ∈ W := by
  classical
  have hn : @nhds ℝ (gamOf δ h0) 0 = ⨅ θ, @nhds ℝ (parOf δ h0 θ) 0 := by
    unfold gamOf
    exact nhds_iInf
  rw [hn] at hW
  refine Filter.iInf_sets_induct
    (p := fun W => ∃ (C : Finset ℝ) (F : Finset (ℕ → AddCircle (1 : ℝ))) (η' ε η : ℝ), 0 < η' ∧ 0 < ε ∧ 0 < η ∧
      ∀ x, x ∈ bset C η' → (∀ k, dint (δ k * x) ≤ ε) → (∀ θ ∈ F, ‖Phit δ θ x‖ ≤ η) → x ∈ W) hW ?_ ?_
  · exact ⟨∅, ∅, 1, 1, 1, one_pos, one_pos, one_pos, fun x _ _ _ => mem_univ x⟩
  · rintro θ s t hs ⟨C, F, η', ε, η, hη', hε, hη, hsub⟩
    have hb := (Classical.choose_spec (exists_par δ h0 θ)).2
    rw [parOf_nhds] at hs
    obtain ⟨U, hU, B, hB, rfl⟩ := Filter.mem_inf_iff.1 hs
    obtain ⟨⟨e1, h1⟩, ⟨he1, _, hh1⟩, hsubU⟩ := hb.mem_iff.1 hU
    obtain ⟨C', η'', hη'', hC'⟩ := exists_bset_subset hB
    refine ⟨C ∪ C', insert θ F, min η' η'', min ε e1, min η h1, lt_min hη' hη'', lt_min hε he1, lt_min hη hh1,
      fun x hxC hxk hxF => ⟨⟨?_, ?_⟩, ?_⟩⟩
    · exact hsubU ⟨fun k => (hxk k).trans (min_le_right _ _),
        (hxF θ (Finset.mem_insert_self _ _)).trans (min_le_right _ _)⟩
    · exact hC' fun b hb' => lt_of_lt_of_le (hxC b (Finset.mem_union_right _ hb')) (min_le_right _ _)
    · exact hsub x (fun b hb' => lt_of_lt_of_le (hxC b (Finset.mem_union_left _ hb')) (min_le_left _ _))
        (fun k => (hxk k).trans (min_le_left _ _))
        (fun θ' hθ' => (hxF θ' (Finset.mem_insert_of_mem hθ')).trans (min_le_left _ _))

lemma round_sub_small (u v : ℝ) (hu : dint u ≤ 1 / 5) (hv : dint v ≤ 1 / 5) :
    round (u - v) = round u - round v := by
  rw [sub_eq_add_neg, round_add_small u (-v) hu (by rwa [dint_neg']), round_neg_small v hv, ← sub_eq_add_neg]

/-- Finitely many translates cover `U(ε0)` up to any basic neighbourhood. -/
lemma finite_cover (δ : ℕ → ℝ) (h0 : Tendsto δ atTop (𝓝 0)) (C : Finset ℝ) (F : Finset (ℕ → AddCircle (1 : ℝ)))
    {η' ε η : ℝ} (hη' : 0 < η') (hε : 0 < ε) (hη : 0 < η) :
    ∃ ε0 : ℝ, 0 < ε0 ∧ ∃ G : Finset ℝ, ∀ x : ℝ, (∀ k, dint (δ k * x) ≤ ε0) → ∃ f ∈ G,
      x - f ∈ bset C η' ∧ (∀ k, dint (δ k * (x - f)) ≤ ε) ∧ ∀ θ ∈ F, ‖Phit δ θ (x - f)‖ ≤ η := by
  classical
  set ε0 := min (ε / 2) (1 / 10 : ℝ) with hε0
  have hε0pos : 0 < ε0 := lt_min (half_pos hε) (by norm_num)
  haveI : Fact (0 < (1 : ℝ)) := ⟨one_pos⟩
  set v : ℝ → (C → AddCircle (1 : ℝ)) × (F → AddCircle (1 : ℝ)) := fun x =>
    (fun b => ((b.1 * x : ℝ) : AddCircle (1 : ℝ)), fun θ => Phit δ θ.1 x) with hv
  set U : Set ℝ := {x | ∀ k, dint (δ k * x) ≤ ε0} with hU
  have htot : TotallyBounded (v '' U) :=
    (isCompact_univ (X := (C → AddCircle (1 : ℝ)) × (F → AddCircle (1 : ℝ)))).totallyBounded.subset (subset_univ _)
  set d := min η' η / 2 with hd
  have hd0 : 0 < d := half_pos (lt_min hη' hη)
  obtain ⟨t, htsub, htfin, htcov⟩ := Metric.finite_approx_of_totallyBounded htot d hd0
  have hpre : ∀ y ∈ t, ∃ f ∈ U, v f = y := fun y hy => htsub hy
  choose! pre hpreU hprev using hpre
  refine ⟨ε0, hε0pos, htfin.toFinset.image pre, fun x hx => ?_⟩
  have hxU : x ∈ U := hx
  obtain ⟨y, hy, hxy⟩ := mem_iUnion₂.1 (htcov (mem_image_of_mem v hxU))
  refine ⟨pre y, Finset.mem_image.2 ⟨y, htfin.mem_toFinset.2 hy, rfl⟩, ?_⟩
  set f := pre y with hf
  have hfU : f ∈ U := hpreU y hy
  have hdist : dist (v x) (v f) < d := by
    rw [hprev y hy]
    exact Metric.mem_ball.1 hxy
  rw [Prod.dist_eq] at hdist
  have hd1 := lt_of_le_of_lt (le_max_left _ _) hdist
  have hd2 := lt_of_le_of_lt (le_max_right _ _) hdist
  have h5 : ε0 ≤ 1 / 5 := (min_le_right _ _).trans (by norm_num)
  have hsm : ∀ y : ℝ, y ∈ U → ∀ k, dint (δ k * y) ≤ 1 / 5 := fun y hy k => (hy k).trans h5
  refine ⟨fun b hb => ?_, fun k => ?_, fun θ hθ => ?_⟩
  · have h := (dist_le_pi_dist (v x).1 (v f).1 ⟨b, hb⟩).trans_lt hd1
    rw [dist_eq_norm] at h
    have e : dint (b * (x - f)) = ‖(v x).1 ⟨b, hb⟩ - (v f).1 ⟨b, hb⟩‖ := by
      unfold dint
      simp only [hv, mul_sub, AddCircle.coe_sub]
    rw [e]
    exact lt_of_lt_of_le h (le_trans (half_le_self (lt_min hη' hη).le) (min_le_left _ _))
  · rw [mul_sub]
    refine (dint_sub_le _ _).trans ?_
    have h2 := hxU k
    have h3 := hfU k
    have h4 : ε0 ≤ ε / 2 := min_le_left _ _
    linarith
  · have h := (dist_le_pi_dist (v x).2 (v f).2 ⟨θ, hθ⟩).trans_lt hd2
    rw [dist_eq_norm] at h
    have e : Phit δ θ (x - f) = (v x).2 ⟨θ, hθ⟩ - (v f).2 ⟨θ, hθ⟩ := by
      simp only [hv]
      unfold Phit
      rw [← finsum_sub_distrib (Phit_support δ h0 θ _) (Phit_support δ h0 θ _)]
      refine finsum_congr fun k => ?_
      rw [mul_sub, round_sub_small _ _ (hsm x hxU k) (hsm f hfU k), sub_smul]
    rw [e]
    exact (le_of_lt h).trans (le_trans (half_le_self (lt_min hη' hη).le) (min_le_right _ _))

/-- If the parity topologies generate a topology finer than all serving ones, then `δ` is rigid. -/
theorem rig_of_finest (δ : ℕ → ℝ) (h0 : Tendsto δ atTop (𝓝 0)) (h1 : ∀ k, |δ k| ≤ 1) (hne : ∀ k, δ k ≠ 0)
    (hfin : ∀ γ : TopologicalSpace ℝ, Serves γ {a | InA δ sT a} → gamOf δ h0 ≤ γ) : Rig δ := by
  classical
  intro γ hg heu htb W hW
  have hs := serves_gam δ h0 h1 hne
  set γ' := γ ⊓ gamTop δ with hγ'
  have e1 : @nhds ℝ γ' 0 = @nhds ℝ γ 0 ⊓ @nhds ℝ (gamTop δ) 0 := @nhds_inf ℝ γ (gamTop δ) 0
  have hs' : Serves γ' {a | InA δ sT a} := by
    refine ⟨isTopologicalAddGroup_inf hg hs.1, inf_le_right.trans hs.2.1, fun h => ?_, ?_, fun a ha => ?_⟩
    · have h2 : bohrTop ≤ gamTop δ := h ▸ inf_le_right
      exact hs.2.2.1 (le_antisymm hs.2.1 h2)
    · rw [e1]
      exact le_inf heu hs.2.2.2.1
    · exact tb_join γ (gamTop δ) hg hs.1 _ (htb a ha) (hs.2.2.2.2 a ha)
  have hW' : W ∈ @nhds ℝ (gamOf δ h0) 0 := nhds_mono ((hfin γ' hs').trans inf_le_left) hW
  obtain ⟨C, F, η', ε, η, hη', hε, hη, hsub⟩ := gamOf_base δ h0 W hW'
  obtain ⟨ε0, hε0, G, hG⟩ := finite_cover δ h0 C F hη' hε hη
  refine ⟨ε0, hε0, G, fun x hx => ?_⟩
  obtain ⟨f, hf, h1', h2', h3'⟩ := hG x hx
  exact ⟨f, hf, hsub _ h1' h2' h3'⟩

end Three
end PVG
