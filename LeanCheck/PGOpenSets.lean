import Mathlib
import LeanCheck.PGIdem

/-!
# PG: sets that belong to `V_ξ(u)(0)` contain multiples of members of `u` (Lean check)

Scope. Lemma A of `PG_v15` (Section 9). Let `u` be an ultrafilter on an abelian group `G`, `ξ(u)` the PG generated by `u`
and `Vgen u = V_ξ(u)(0)` the intersection of the ultrafilters converging to `0`.

* `mem_of_mem_Vgen_lev` : if `s ∈ Vgen u` and `F` is a level filter (`Lev u n F`), then `s ∈ F`;
* `negF`, `lev_negF`, `negF_mem` : the all-minus filter sums `(-u) + ... + (-u)` and their members;
* `exists_nsmul_mem` : if `s ∈ Vgen u` and `n : ℕ`, there is `A ∈ u` with `n • y ∈ s` and `n • (-y) ∈ s` for all `y ∈ A`.

In the article, with `s = O - z` for a point `z` of a set `O` that is open for the topological modification, this says:
`z + c y ∈ O` for all `y ∈ A` and all integers `|c| ≤ n`, for some `A ∈ u` (the case `c ≤ 0` also uses `-y`).

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set

namespace PG

variable {G : Type*} [AddCommGroup G]

theorem mem_of_mem_Vgen_lev {u : Ultrafilter G} {s : Set G} (hs : s ∈ Vgen u) {n : ℕ} {F : Filter G}
    (hF : Lev u n F) : s ∈ F := by
  rw [Filter.mem_iff_ultrafilter]
  intro W hW
  exact mem_Vgen.1 hs W (hF.genUlt W hW)

/-- The all-minus filter sums `(-u) + ... + (-u)`. -/
def negF (u : Ultrafilter G) : ℕ → Filter G
  | 0 => pure 0
  | n + 1 => Filter.map₂ (· + ·) (Filter.map (fun x : G => -x) (u : Filter G)) (negF u n)

theorem lev_negF (u : Ultrafilter G) : ∀ n, Lev u n (negF u n)
  | 0 => Lev.zero
  | n + 1 => Lev.minus (lev_negF u n)

theorem negF_mem {u : Ultrafilter G} {s : Set G} :
    ∀ n : ℕ, s ∈ negF u n → ∃ A ∈ (u : Filter G), ∀ y ∈ A, n • (-y) ∈ s
  | 0, h => ⟨Set.univ, Filter.univ_mem, fun y _ => by simpa using (Filter.mem_pure.1 h)⟩
  | n + 1, h => by
    obtain ⟨U, hU, V, hV, hUV⟩ := Filter.mem_map₂_iff.1 h
    obtain ⟨A', hA', hA'V⟩ := negF_mem n hV
    refine ⟨(fun x : G => -x) ⁻¹' U ∩ A', Filter.inter_mem (Filter.mem_map.1 hU) hA', fun y hy => ?_⟩
    have : -y + n • (-y) ∈ s := hUV ⟨-y, hy.1, n • (-y), hA'V y hy.2, rfl⟩
    rwa [succ_nsmul']

theorem exists_nsmul_mem {u : Ultrafilter G} {s : Set G} (hs : s ∈ Vgen u) (n : ℕ) :
    ∃ A ∈ (u : Filter G), ∀ y ∈ A, n • y ∈ s ∧ n • (-y) ∈ s := by
  obtain ⟨A₁, hA₁, h₁⟩ := plusF_mem n (mem_of_mem_Vgen_lev hs (lev_plusF u n))
  obtain ⟨A₂, hA₂, h₂⟩ := negF_mem n (mem_of_mem_Vgen_lev hs (lev_negF u n))
  exact ⟨A₁ ∩ A₂, Filter.inter_mem hA₁ hA₂, fun y hy => ⟨h₁ y hy.1, h₂ y hy.2⟩⟩

end PG
