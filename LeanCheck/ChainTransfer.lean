import LeanCheck.ChainLift

/-!
# The transfer `T_f` from `ℚ` to `ℝ` (Theorem `transfer-v8` of HamelCharactersTVG)

Let `f : ℝ →+ ℚ` be a coefficient function (`f u = 1`) and `f_a(x) = f(a x)`.  For a topology `δ` on `ℚ`,
`T_f(δ)` is generated by the usual topology of `ℝ` and all maps `f_a : ℝ → (ℚ, δ)`.  We show:

* `T_f(δ)` is a Hausdorff group topology finer than usual, and every dilation `x ↦ c x` is continuous
  (so it is a TVG topology); `T_f` is monotone and `T_f(δ₁) ∨ T_f(δ₂) = T_f(δ₁ ∨ δ₂)`;
* if `p : ℚ → 𝕋` is `δ`-continuous then every `χ_{c,a}(x) = p(c x + f(a x))` is `T_f(δ)`-continuous;
* **obstruction transfer**: a `δ₁ ∨ δ₂`-continuous character `ψ` of `ℚ` outside `Γ = {s ↦ r s mod 1}` gives the
  character `ψ ∘ f` of `ℝ`, continuous for `T_f(δ₁) ∨ T_f(δ₂)` and NOT of the form `χ_{c,a}` (not in `H_f`).
-/

namespace LeanCheck

open Filter Topology

/-- `ℚ`-linearity of an additive map `ℝ → ℚ`. -/
lemma f_ratmul (f : ℝ →+ ℚ) (q : ℚ) (x : ℝ) : f ((q : ℝ) * x) = q * f x := by
  have := map_ratCast_smul f ℝ ℚ q x
  simpa [smul_eq_mul] using this

/-- `f_a(x) = f(a x)`. -/
def fa (f : ℝ →+ ℚ) (a : ℝ) : ℝ →+ ℚ := f.comp (AddMonoidHom.mulLeft a)

lemma fa_apply (f : ℝ →+ ℚ) (a x : ℝ) : fa f a x = f (a * x) := rfl

/-- `T_f(δ)`: generated by the usual topology and all `f_a : ℝ → (ℚ, δ)`. -/
noncomputable def Tf (f : ℝ →+ ℚ) (δ : TopologicalSpace ℚ) : TopologicalSpace ℝ :=
  (inferInstance : TopologicalSpace ℝ) ⊓ ⨅ a : ℝ, TopologicalSpace.induced (fa f a) δ

lemma Tf_le_usual (f : ℝ →+ ℚ) (δ : TopologicalSpace ℚ) :
    Tf f δ ≤ (inferInstance : TopologicalSpace ℝ) := inf_le_left

lemma fa_cont (f : ℝ →+ ℚ) (δ : TopologicalSpace ℚ) (a : ℝ) : Continuous[Tf f δ, δ] (fa f a) :=
  continuous_iff_le_induced.mpr (inf_le_right.trans (iInf_le _ a))

lemma Tf_group (f : ℝ →+ ℚ) (δ : TopologicalSpace ℚ) (h : @IsTopologicalAddGroup ℚ δ _) :
    @IsTopologicalAddGroup ℝ (Tf f δ) _ := by
  unfold Tf
  letI : TopologicalSpace ℚ := δ
  haveI : IsTopologicalAddGroup ℚ := h
  exact isTopologicalAddGroup_inf inferInstance
    (isTopologicalAddGroup_iInf (fun a => isTopologicalAddGroup_induced (fa f a)))

/-- Fixed real dilations are `T_f(δ)`-continuous (the TVG property). -/
lemma Tf_dilation (f : ℝ →+ ℚ) (δ : TopologicalSpace ℚ) (c : ℝ) :
    Continuous[Tf f δ, Tf f δ] (fun x : ℝ => c * x) := by
  have h1 : Continuous[Tf f δ, (inferInstance : TopologicalSpace ℝ)] (fun x : ℝ => c * x) :=
    continuous_inf_dom_left (continuous_const.mul continuous_id)
  have h2 : Continuous[Tf f δ, ⨅ a : ℝ, TopologicalSpace.induced (fa f a) δ] (fun x : ℝ => c * x) := by
    refine continuous_iInf_rng.2 (fun a => continuous_induced_rng.2 ?_)
    have : (fa f a ∘ fun x : ℝ => c * x) = fa f (a * c) := by
      funext x; simp only [Function.comp, fa_apply]; rw [mul_assoc]
    rw [this]
    exact fa_cont f δ (a * c)
  exact continuous_inf_rng.2 ⟨h1, h2⟩

lemma Tf_mono (f : ℝ →+ ℚ) {δ δ' : TopologicalSpace ℚ} (h : δ ≤ δ') : Tf f δ ≤ Tf f δ' :=
  inf_le_inf_left _ (iInf_mono fun a => induced_mono h)

/-- `T_f(δ₁) ∨ T_f(δ₂) = T_f(δ₁ ∨ δ₂)`  (`⊓` is the join of topologies in Mathlib's order). -/
lemma Tf_inf (f : ℝ →+ ℚ) (δ₁ δ₂ : TopologicalSpace ℚ) :
    Tf f (δ₁ ⊓ δ₂) = Tf f δ₁ ⊓ Tf f δ₂ := by
  unfold Tf
  apply le_antisymm
  · refine le_inf ?_ ?_
    · exact inf_le_inf_left _ (iInf_mono fun a => by rw [induced_inf]; exact inf_le_left)
    · exact inf_le_inf_left _ (iInf_mono fun a => by rw [induced_inf]; exact inf_le_right)
  · refine le_inf (inf_le_left.trans inf_le_left) (le_iInf fun a => ?_)
    rw [induced_inf]
    exact le_inf ((inf_le_left.trans inf_le_right).trans (iInf_le _ a))
      ((inf_le_right.trans inf_le_right).trans (iInf_le _ a))

/-- The characters `χ_{c,a}(x) = p(c x + f(a x))` of `ℝ` (the group `H_f`). -/
noncomputable def chiH (f : ℝ →+ ℚ) (c a x : ℝ) : Circ :=
  ((c * x + ((f (a * x) : ℚ) : ℝ) : ℝ) : Circ)

lemma continuous_coe_circ : Continuous (fun y : ℝ => (y : Circ)) :=
  continuous_quotient_mk'

/-- If `p : ℚ → 𝕋` is `δ`-continuous, every `χ_{c,a}` is `T_f(δ)`-continuous. -/
theorem chiH_continuous (f : ℝ →+ ℚ) (δ : TopologicalSpace ℚ)
    (hδ : @Continuous ℚ Circ δ _ (fun s : ℚ => ((s : ℝ) : Circ))) (c a : ℝ) :
    @Continuous ℝ Circ (Tf f δ) _ (chiH f c a) := by
  have h1 : Continuous[Tf f δ, _] (fun x : ℝ => ((c * x : ℝ) : Circ)) :=
    continuous_inf_dom_left (continuous_coe_circ.comp (continuous_const.mul continuous_id))
  have h2 : Continuous[Tf f δ, _] (fun x : ℝ => (((fa f a x : ℚ) : ℝ) : Circ)) :=
    @Continuous.comp ℝ ℚ Circ (Tf f δ) δ _ _ _ hδ (fa_cont f δ a)
  have : chiH f c a = fun x : ℝ => ((c * x : ℝ) : Circ) + (((fa f a x : ℚ) : ℝ) : Circ) := by
    funext x
    simp only [chiH, fa_apply]
    rw [AddCircle.coe_add]
  rw [this]
  exact @Continuous.add Circ _ _ _ ℝ (Tf f δ) _ _ h1 h2

lemma f_fiber (f : ℝ →+ ℚ) (u : ℝ) (hu : f u = 1) (x : ℝ) : f (x - ((f x : ℚ) : ℝ) * u) = 0 := by
  rw [map_sub, f_ratmul, hu, mul_one, sub_self]

/-- The kernel `ker f` of a coefficient function is uncountable. -/
lemma ker_uncountable (f : ℝ →+ ℚ) (u : ℝ) (hu : f u = 1) : ¬ ({x : ℝ | f x = 0}).Countable := by
  intro hE
  apply Cardinal.not_countable_real
  have hsub : (Set.univ : Set ℝ) ⊆
      ⋃ q : ℚ, (fun e : ℝ => e + (q : ℝ) * u) '' {x : ℝ | f x = 0} := by
    intro x _
    refine Set.mem_iUnion.2 ⟨f x, ⟨x - ((f x : ℚ) : ℝ) * u, f_fiber f u hu x, by ring⟩⟩
  exact (Set.countable_iUnion fun q => hE.image _).mono hsub

lemma int_of_all_div (z : ℝ) (h : ∀ n : ℕ, 0 < n → ∃ k : ℤ, z / n = k) : z = 0 := by
  obtain ⟨k, hk⟩ := h (⌈|z|⌉₊ + 1) (Nat.succ_pos _)
  have hpos : (0 : ℝ) < ((⌈|z|⌉₊ + 1 : ℕ) : ℝ) := by positivity
  have hlt : |z| < ((⌈|z|⌉₊ + 1 : ℕ) : ℝ) := by
    push_cast; linarith [Nat.le_ceil |z|]
  have h1 : |(k : ℝ)| < 1 := by
    rw [← hk, abs_div, abs_of_pos hpos, div_lt_one hpos]; exact hlt
  have hk0 : k = 0 := by
    have : |k| < 1 := by exact_mod_cast h1
    exact Int.abs_lt_one_iff.mp this
  rw [hk0] at hk
  have : z = 0 := by
    have := hk
    rw [div_eq_iff hpos.ne'] at this
    simpa using this
  exact this

/-- **Obstruction transfer.**  If `ψ` is a `δ₁ ∨ δ₂`-continuous character of `ℚ` that is not `s ↦ r s mod 1`
for any rational `r`, then `ψ ∘ f` is continuous for `T_f(δ₁) ∨ T_f(δ₂)` and is not any `χ_{c,a}`. -/
theorem transfer_obstruction (f : ℝ →+ ℚ) (u : ℝ) (hu : f u = 1) (δ₁ δ₂ : TopologicalSpace ℚ)
    (ψ : ℚ →+ Circ) (hψ : @Continuous ℚ Circ (δ₁ ⊓ δ₂) _ ψ)
    (hne : ∀ r : ℚ, ∃ s : ℚ, ψ s ≠ (((r * s : ℚ) : ℝ) : Circ)) :
    ∃ φ : ℝ →+ Circ, @Continuous ℝ Circ (Tf f δ₁ ⊓ Tf f δ₂) _ φ ∧
      ¬ ∃ c a : ℝ, ∀ x : ℝ, φ x = chiH f c a x := by
  refine ⟨ψ.comp f, ?_, ?_⟩
  · rw [← Tf_inf]
    have hf : (f : ℝ → ℚ) = fa f 1 := by funext x; simp [fa_apply]
    show Continuous[Tf f (δ₁ ⊓ δ₂), _] (fun x => ψ (f x))
    have : (fun x => ψ (f x)) = ψ ∘ fa f 1 := by funext x; simp [fa_apply]
    rw [this]
    exact @Continuous.comp ℝ ℚ Circ (Tf f (δ₁ ⊓ δ₂)) (δ₁ ⊓ δ₂) _ _ _ hψ (fa_cont f _ 1)
  · rintro ⟨c, a, h⟩
    -- on `ker f`, `c x + f(a x) = 0`
    have hE : ∀ x : ℝ, f x = 0 → c * x + ((f (a * x) : ℚ) : ℝ) = 0 := by
      intro x hx
      apply int_of_all_div
      intro n hn
      have hq : (((1 / (n : ℚ) : ℚ) : ℝ)) = 1 / (n : ℝ) := by push_cast; ring
      have hy : f (((1 / (n : ℚ) : ℚ) : ℝ) * x) = 0 := by rw [f_ratmul, hx, mul_zero]
      have h0 := h (((1 / (n : ℚ) : ℚ) : ℝ) * x)
      simp only [AddMonoidHom.comp_apply, hy, map_zero] at h0
      have h0' := h0.symm
      unfold chiH at h0'
      obtain ⟨k, hk⟩ := (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).mp h0'
      refine ⟨k, ?_⟩
      rw [zsmul_eq_mul, mul_one] at hk
      have h3 : f (a * (((1 / (n : ℚ) : ℚ) : ℝ) * x)) = (1 / (n : ℚ)) * f (a * x) := by
        rw [← f_ratmul, mul_left_comm]
      rw [h3] at hk
      push_cast at hk
      have hnr : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
      rw [hk]
      field_simp
    have hc : c = 0 := by
      by_contra hc
      apply ker_uncountable f u hu
      refine (Set.countable_range (fun q : ℚ => -(q : ℝ) / c)).mono ?_
      intro x hx
      refine ⟨f (a * x), ?_⟩
      have := hE x hx
      field_simp
      linarith
    subst hc
    obtain ⟨s, hs⟩ := hne (f (a * u))
    apply hs
    have hx : f (((s : ℚ) : ℝ) * u) = s := by rw [f_ratmul, hu, mul_one]
    have h1 := h (((s : ℚ) : ℝ) * u)
    simp only [AddMonoidHom.comp_apply, hx] at h1
    rw [h1]
    unfold chiH
    have h3 : f (a * (((s : ℚ) : ℝ) * u)) = s * f (a * u) := by
      rw [← f_ratmul, mul_left_comm]
    rw [h3]
    congr 1
    push_cast; ring

lemma Tf_t2 (f : ℝ →+ ℚ) (δ : TopologicalSpace ℚ) : @T2Space ℝ (Tf f δ) := by
  have hc : Continuous[Tf f δ, (inferInstance : TopologicalSpace ℝ)] (id : ℝ → ℝ) :=
    continuous_iff_le_induced.mpr (by rw [induced_id]; exact Tf_le_usual f δ)
  exact @T2Space.of_injective_continuous ℝ ℝ (Tf f δ) _ _ id Function.injective_id hc

/-- The usual topology of `ℝ` and of the circle, named so that they are not captured by local instances. -/
noncomputable def uR : TopologicalSpace ℝ := inferInstance
noncomputable def circTop : TopologicalSpace Circ := inferInstance

/-- **Formal capstone for `ℝ`.**  For every coefficient function `f` there are two Hausdorff TVG group topologies
`T₁, T₂` on `ℝ`, finer than the usual topology, in which every `χ_{c,a}` (`H_f`) is continuous, whose join carries
a continuous character that is NOT in `H_f`. -/
theorem transfer_capstone (f : ℝ →+ ℚ) (u : ℝ) (hu : f u = 1) :
    ∃ T₁ T₂ : TopologicalSpace ℝ,
      @IsTopologicalAddGroup ℝ T₁ _ ∧ @IsTopologicalAddGroup ℝ T₂ _ ∧
      @T2Space ℝ T₁ ∧ @T2Space ℝ T₂ ∧
      T₁ ≤ uR ∧ T₂ ≤ uR ∧
      (∀ c : ℝ, Continuous[T₁, T₁] (fun x : ℝ => c * x)) ∧
      (∀ c : ℝ, Continuous[T₂, T₂] (fun x : ℝ => c * x)) ∧
      (∀ c a : ℝ, @Continuous ℝ Circ T₁ circTop (chiH f c a)) ∧
      (∀ c a : ℝ, @Continuous ℝ Circ T₂ circTop (chiH f c a)) ∧
      ∃ φ : ℝ →+ Circ, @Continuous ℝ Circ (T₁ ⊓ T₂) circTop φ ∧
        ¬ ∃ c a : ℝ, ∀ x : ℝ, φ x = chiH f c a x := by
  obtain ⟨g1, g2, hg1, hg2, -, -, hd1, hd2, ψ, hψ, hne⟩ := lift_capstone
  have pc : ∀ g : TopologicalSpace ℚ, (∀ ψ : ℚ →+ Circ, @Continuous ℚ Circ g _ ψ ↔
      ∃ r : ℚ, ∀ s : ℚ, ψ s = (((r * s : ℚ) : ℝ) : Circ)) →
      @Continuous ℚ Circ g _ (fun s : ℚ => ((s : ℝ) : Circ)) := by
    intro g hd
    have := (hd ((AddCommGroup.torsion Circ).subtype.comp piHom)).mpr ⟨1, fun s => by simp [piHom_coe]⟩
    exact this
  obtain ⟨φ, hφ, hφne⟩ := transfer_obstruction f u hu g1 g2 ψ hψ hne
  exact ⟨Tf f g1, Tf f g2, Tf_group f g1 hg1, Tf_group f g2 hg2, Tf_t2 f g1, Tf_t2 f g2,
    Tf_le_usual f g1, Tf_le_usual f g2, Tf_dilation f g1, Tf_dilation f g2,
    chiH_continuous f g1 (pc g1 hd1), chiH_continuous f g2 (pc g2 hd2), φ, hφ, hφne⟩

end LeanCheck
