import Mathlib
import LeanCheck.PGIdem
import LeanCheck.PGTop

/-!
# PG: ultrafilters whose four-fold sumsets are neighbourhoods (Lean check)

Scope. The theorem of `PG_v13` on ultrafilters of positive upper Banach density, in an abstract form without the number
theory (Bogolyubov's theorem is not formalized). Let `G` be an abelian topological group and `u` an ultrafilter on `G`
with `u ≤ 𝓝 0` (in the article: `G = ℤ` with the Bohr topology). Hypothesis `Bog`: for every `A ∈ u` the set
`A + A - A - A` contains a neighbourhood of `0`.

* `genNull_eq_topNull` : under `Bog` the null filters of the PG `ξ(u)` generated by `u` are exactly the proper filters
  converging to `0` in the topology, `genNull u = topNull G`;
* `nhds_le_of_bog` : under `Bog`, every neighbourhood of `0` for a group topology `σ` in which `u` converges to `0` is a
  neighbourhood of `0` for the given topology (so `σ` is coarser);
* `halving4` : in a topological additive group, every neighbourhood `U` of `0` contains `V + V - V - V` for some
  neighbourhood `V` of `0`.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set Topology

namespace PG

section bohrgen

variable {G : Type*} [AddCommGroup G]

/-- Hypothesis: the four-fold sumset `A + A - A - A` of every `A ∈ u` contains a neighbourhood of `0`. -/
def Bog [TopologicalSpace G] (u : Ultrafilter G) : Prop :=
  ∀ A ∈ (u : Filter G), ∃ W ∈ 𝓝 (0 : G), ∀ x ∈ W, ∃ a₁ ∈ A, ∃ a₂ ∈ A, ∃ a₃ ∈ A, ∃ a₄ ∈ A,
    x = a₁ + a₂ - a₃ - a₄

/-- The level filter `u + u - u - u`. -/
theorem lev4 (u : Ultrafilter G) :
    Lev u 4 (Filter.map₂ (· + ·) (Filter.map (fun x : G => -x) (u : Filter G))
      (Filter.map₂ (· + ·) (Filter.map (fun x : G => -x) (u : Filter G))
        (Filter.map₂ (· + ·) (u : Filter G) (Filter.map₂ (· + ·) (u : Filter G) (pure (0 : G) : Filter G))))) :=
  Lev.minus (Lev.minus (Lev.plus (Lev.plus Lev.zero)))

/-- Every set of the level filter `u + u - u - u` contains `A + A - A - A` for some `A ∈ u`. -/
theorem exists_A_of_mem_lev4 (u : Ultrafilter G) {s : Set G}
    (hs : s ∈ Filter.map₂ (· + ·) (Filter.map (fun x : G => -x) (u : Filter G))
      (Filter.map₂ (· + ·) (Filter.map (fun x : G => -x) (u : Filter G))
        (Filter.map₂ (· + ·) (u : Filter G) (Filter.map₂ (· + ·) (u : Filter G) (pure (0 : G) : Filter G))))) :
    ∃ A ∈ (u : Filter G), ∀ a₁ ∈ A, ∀ a₂ ∈ A, ∀ a₃ ∈ A, ∀ a₄ ∈ A, a₁ + a₂ - a₃ - a₄ ∈ s := by
  rw [Filter.mem_map₂_iff] at hs
  obtain ⟨N₁, hN₁, T₁, hT₁, hs1⟩ := hs
  rw [Filter.mem_map₂_iff] at hT₁
  obtain ⟨N₂, hN₂, T₂, hT₂, hs2⟩ := hT₁
  rw [Filter.mem_map₂_iff] at hT₂
  obtain ⟨P₁, hP₁, T₃, hT₃, hs3⟩ := hT₂
  rw [Filter.mem_map₂_iff] at hT₃
  obtain ⟨P₂, hP₂, T₄, hT₄, hs4⟩ := hT₃
  have h0 : (0 : G) ∈ T₄ := mem_pure.1 hT₄
  refine ⟨P₁ ∩ P₂ ∩ ((fun x : G => -x) ⁻¹' N₁) ∩ ((fun x : G => -x) ⁻¹' N₂), ?_, ?_⟩
  · refine Filter.inter_mem (Filter.inter_mem (Filter.inter_mem hP₁ hP₂) ?_) ?_
    · exact Filter.mem_map.1 hN₁
    · exact Filter.mem_map.1 hN₂
  · rintro a₁ ⟨⟨⟨h1P1, h1P2⟩, h1N1⟩, h1N2⟩ a₂ ⟨⟨⟨h2P1, h2P2⟩, h2N1⟩, h2N2⟩ a₃
      ⟨⟨⟨h3P1, h3P2⟩, h3N1⟩, h3N2⟩ a₄ ⟨⟨⟨h4P1, h4P2⟩, h4N1⟩, h4N2⟩
    have e4 : a₂ + 0 ∈ Set.image2 (· + ·) P₂ T₄ := ⟨a₂, h2P2, 0, h0, rfl⟩
    have e3 := hs4 e4
    have e3' : a₁ + (a₂ + 0) ∈ Set.image2 (· + ·) P₁ T₃ := ⟨a₁, h1P1, a₂ + 0, e3, rfl⟩
    have e2 := hs3 e3'
    have e2' : -a₄ + (a₁ + (a₂ + 0)) ∈ Set.image2 (· + ·) N₂ T₂ := ⟨-a₄, h4N2, _, e2, rfl⟩
    have e1 := hs2 e2'
    have e1' : -a₃ + (-a₄ + (a₁ + (a₂ + 0))) ∈ Set.image2 (· + ·) N₁ T₁ := ⟨-a₃, h3N1, _, e1, rfl⟩
    have e0 := hs1 e1'
    have : a₁ + a₂ - a₃ - a₄ = -a₃ + (-a₄ + (a₁ + (a₂ + 0))) := by abel
    rw [this]
    exact e0

variable [TopologicalSpace G]

/-- Under `Bog`, the neighbourhood filter of `0` is finer than the level filter `u + u - u - u`. -/
theorem nhds_le_lev4 {u : Ultrafilter G} (hBog : Bog u) :
    (Filter.map₂ (· + ·) (Filter.map (fun x : G => -x) (u : Filter G))
      (Filter.map₂ (· + ·) (Filter.map (fun x : G => -x) (u : Filter G))
        (Filter.map₂ (· + ·) (u : Filter G) (Filter.map₂ (· + ·) (u : Filter G) (pure (0 : G) : Filter G))))) ≥ 𝓝 (0 : G) := by
  intro s hs
  obtain ⟨A, hA, hAs⟩ := exists_A_of_mem_lev4 u hs
  obtain ⟨W, hW, hWA⟩ := hBog A hA
  refine Filter.mem_of_superset hW ?_
  intro x hx
  obtain ⟨a₁, h1, a₂, h2, a₃, h3, a₄, h4, rfl⟩ := hWA x hx
  exact hAs a₁ h1 a₂ h2 a₃ h3 a₄ h4

variable [IsTopologicalAddGroup G]

theorem genNull_eq_topNull {u : Ultrafilter G} (hu : (u : Filter G) ≤ 𝓝 0) (hBog : Bog u) :
    genNull u = topNull G := by
  apply Set.Subset.antisymm (genNull_subset_topNull u hu)
  rintro F ⟨hne, hF⟩
  refine ⟨hne, ?_⟩
  intro U hU
  exact (lev4 u).genUlt U (hU.trans (hF.trans (nhds_le_lev4 hBog)))

/-- Halving with four summands. -/
theorem halving4 {U : Set G} (hU : U ∈ 𝓝 (0 : G)) :
    ∃ V ∈ 𝓝 (0 : G), ∀ a ∈ V, ∀ b ∈ V, ∀ c ∈ V, ∀ d ∈ V, a + b - c - d ∈ U := by
  have hc : Continuous (fun p : G × G × G × G => p.1 + p.2.1 - p.2.2.1 - p.2.2.2) := by fun_prop
  have h0 := hc.tendsto ((0 : G), (0 : G), (0 : G), (0 : G))
  simp only [add_zero, sub_self] at h0
  have h1 := h0 hU
  rw [Filter.mem_map, nhds_prod_eq] at h1
  obtain ⟨V₁, hV₁, R₁, hR₁, hsub1⟩ := Filter.mem_prod_iff.1 h1
  rw [nhds_prod_eq] at hR₁
  obtain ⟨V₂, hV₂, R₂, hR₂, hsub2⟩ := Filter.mem_prod_iff.1 hR₁
  rw [nhds_prod_eq] at hR₂
  obtain ⟨V₃, hV₃, V₄, hV₄, hsub3⟩ := Filter.mem_prod_iff.1 hR₂
  refine ⟨V₁ ∩ V₂ ∩ V₃ ∩ V₄, ?_, ?_⟩
  · exact Filter.inter_mem (Filter.inter_mem (Filter.inter_mem hV₁ hV₂) hV₃) hV₄
  · rintro a ⟨⟨⟨ha1, ha2⟩, ha3⟩, ha4⟩ b ⟨⟨⟨hb1, hb2⟩, hb3⟩, hb4⟩ c ⟨⟨⟨hc1, hc2⟩, hc3⟩, hc4⟩
      d ⟨⟨⟨hd1, hd2⟩, hd3⟩, hd4⟩
    have hmem : (a, b, c, d) ∈ (fun p : G × G × G × G => p.1 + p.2.1 - p.2.2.1 - p.2.2.2) ⁻¹' U :=
      hsub1 ⟨ha1, hsub2 ⟨hb2, hsub3 ⟨hc3, hd4⟩⟩⟩
    exact hmem

end bohrgen

section coarser

variable {G : Type*} [AddCommGroup G] [τβ : TopologicalSpace G]

/-- Under `Bog`, every group topology `σ` in which `u` converges to `0` is coarser than the given topology. -/
theorem nhds_le_of_bog {u : Ultrafilter G} (hBog : @Bog G _ τβ u) (σ : TopologicalSpace G)
    (hσ : @IsTopologicalAddGroup G σ (inferInstance : AddGroup G))
    (hu : (u : Filter G) ≤ @nhds G σ 0) {U : Set G} (hU : U ∈ @nhds G σ 0) :
    U ∈ @nhds G τβ 0 := by
  obtain ⟨V, hV, hVU⟩ := @halving4 G _ σ hσ U hU
  have hVu : V ∈ (u : Filter G) := hu hV
  obtain ⟨W, hW, hWV⟩ := hBog V hVu
  refine Filter.mem_of_superset hW ?_
  intro x hx
  obtain ⟨a₁, h1, a₂, h2, a₃, h3, a₄, h4, rfl⟩ := hWV x hx
  exact hVU a₁ h1 a₂ h2 a₃ h3 a₄ h4

end coarser

end PG
