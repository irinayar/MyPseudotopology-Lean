import LeanCheck.PVGThreeDyadic

/-!
# Serving topologies for a rigid dyadic sequence

The topology generated by all parity topologies is the finest serving topology
under the stated Kalton--Roberts hypothesis. A group topology serves precisely
when it is strictly finer than the Bohr topology and coarser than that finest
topology.

Mathlib orders topologies by reverse inclusion: `g1 ≤ g2` means that `g1` is
finer. The Kalton--Roberts statement remains an explicit hypothesis.
-/

open Filter Topology Set

namespace PVG.Three

open Two Q95 Lac

/-- The serving topologies of a rigid dyadic sequence, with the strict Bohr
comparison expressed by inclusion and a separate disequality. -/
theorem allserving_of_rig (hKR : Stab.KaltonRobertsClassical)
    (L : ℕ → ℕ) (hL : StrictMono L) (hrig : Rig (dyseq L))
    (γ : TopologicalSpace ℝ) :
    Serves γ {a | InA (dyseq L) sT a} ↔
      @IsTopologicalAddGroup ℝ γ _ ∧ γ ≤ bohrTop ∧ γ ≠ bohrTop ∧
        gamOf (dyseq L) (dyseq_tendsto L hL) ≤ γ := by
  obtain ⟨hall, hfin⟩ := finest_of_rig hKR L hL hrig
  refine ⟨fun hs => ⟨hs.1, hs.2.1, hs.2.2.1, hfin γ hs⟩,
    fun ⟨hg, hb, hne, hle⟩ => ?_⟩
  have hn : @nhds ℝ (gamOf (dyseq L) (dyseq_tendsto L hL)) 0 ≤
      @nhds ℝ γ 0 := nhds_mono hle
  exact ⟨hg, hb, hne, hall.2.2.2.1.trans hn,
    fun a ha V hV => hall.2.2.2.2 a ha V (hn hV)⟩

/-- The same characterization in the strict topology order. -/
theorem allserving_of_rig_lt (hKR : Stab.KaltonRobertsClassical)
    (L : ℕ → ℕ) (hL : StrictMono L) (hrig : Rig (dyseq L))
    (γ : TopologicalSpace ℝ) :
    Serves γ {a | InA (dyseq L) sT a} ↔
      @IsTopologicalAddGroup ℝ γ _ ∧ γ < bohrTop ∧
        gamOf (dyseq L) (dyseq_tendsto L hL) ≤ γ := by
  rw [allserving_of_rig hKR L hL hrig γ]
  constructor
  · rintro ⟨hg, hb, hne, hle⟩
    exact ⟨hg, lt_iff_le_not_ge.mpr ⟨hb, fun hrev => hne (le_antisymm hb hrev)⟩, hle⟩
  · rintro ⟨hg, hb, hle⟩
    exact ⟨hg, hb.le, hb.ne, hle⟩

end PVG.Three
