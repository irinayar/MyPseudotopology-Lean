import LeanCheck.PVGTwoDescribe

/-! The theorem of Kalton and Roberts (Trans. AMS 278 (1983), Theorem 4.1) is stated for set functions
that vanish on the empty set. `Stab.KaltonRoberts` omits that condition. Here it is derived from the
classical form, with the same constant, so the results that assume `Stab.KaltonRoberts` hold under the
classical statement. The classical theorem itself is not formalized. -/

open Filter Topology Set

namespace PVG
namespace Stab

/-- Theorem 4.1 of Kalton and Roberts for finite algebras, with the constant rounded up to `45`. -/
def KaltonRobertsClassical : Prop :=
  ∀ (n : ℕ) (f : Finset (Fin n) → ℝ) (Δ : ℝ), f ∅ = 0 →
    (∀ A B : Finset (Fin n), Disjoint A B → |f (A ∪ B) - f A - f B| ≤ Δ) →
      ∃ μ : Fin n → ℝ, ∀ A : Finset (Fin n), |f A - ∑ k ∈ A, μ k| ≤ 45 * Δ

theorem kaltonRoberts_of_classical (h : KaltonRobertsClassical) : KaltonRoberts := by
  classical
  intro n f Δ hf
  have h0 : |f ∅| ≤ Δ := by
    have := hf ∅ ∅ (Finset.disjoint_empty_left _)
    simpa [abs_neg] using this
  have hΔ : 0 ≤ Δ := (abs_nonneg _).trans h0
  set g : Finset (Fin n) → ℝ := fun A => if A = ∅ then 0 else f A with hg
  have hadd : ∀ A B : Finset (Fin n), Disjoint A B → |g (A ∪ B) - g A - g B| ≤ Δ := by
    intro A B hAB
    by_cases hA : A = ∅
    · simp [hg, hA, hΔ]
    by_cases hB : B = ∅
    · simp [hg, hB, hΔ]
    have hU : A ∪ B ≠ ∅ := fun h => hA (Finset.union_eq_empty.1 h).1
    simp only [hg, if_neg hA, if_neg hB, if_neg hU]
    exact hf A B hAB
  obtain ⟨μ, hμ⟩ := h n g Δ (by simp [hg]) hadd
  refine ⟨μ, fun A => ?_⟩
  by_cases hA : A = ∅
  · subst hA
    simp only [Finset.sum_empty, sub_zero]
    linarith
  · simpa [hg, if_neg hA] using hμ A

end Stab

namespace Two

/-- Theorem: the finest serving topology is generated by the parity topologies, under the classical
statement of Kalton and Roberts. -/
theorem finest_described_classical (h : Stab.KaltonRobertsClassical) :
    Serves gamAll A2 ∧ ∀ γ : TopologicalSpace ℝ, Serves γ A2 → gamAll ≤ γ :=
  finest_described (Stab.kaltonRoberts_of_classical h)

end Two
end PVG
