import LeanCheck.PVGCyclicTrace
import LeanCheck.PVGNotGroupClosure
import LeanCheck.PVGSec8Rest

/-!
# PVG: the two Bohr topologies on the interval-free pieces, and compact thickening (Lean check)

Scope. `τ_D` (`discTop`) is the topology on `ℝ` generated by all algebraic characters `ℝ → ℝ/ℤ`, that is, the Bohr topology of the
discrete group `ℝ`; `τ_B` (`bohrTop`) uses only the Euclidean continuous characters. `I₀` (`I0`) is the family of subsets of the
sets `F + a₁S + … + a_kS` with `F` finite.

* `piece_limits` : along any ultrafilter, the values of a sum `Σ a_i S` and of every character of it have limits of an explicit form;
* `finitePiece_char` : on `F + a₁S + … + a_kS` every algebraic character is continuous for the trace of `τ_B`
  (uses the independence theorem `independence_finset`);
* `finitePiece_trace` : `τ_D` and `τ_B` induce the same topology on every member of `I₀`;
* `discTop_ne_bohr` : `τ_D ≠ τ_B`;
* `intervalFree_witness` : a group topology strictly finer than `τ_B` induces the Bohr topology on every member of `I₀`
  (the existence statement of the theorem on condition (N) without intervals, with the witness `τ_D`; the box construction of the
  article is not formalized);
* `thickening` : for a group topology `γ` finer than `τ_B`, equality of traces on every member of the lacunary ideal is equivalent
  to: `γ` is coarser than the Euclidean topology, and equality of traces on every member of `I₀`.

In Mathlib's order `t₁ ≤ t₂` means that `t₁` is finer. A Lean proof verifies its formal statement under its hypotheses; the
correspondence with the article requires mathematical review.
-/

open Filter Topology Set Pointwise

namespace PVG
namespace Lac

open Q95

/-! ### Limits of `2^(n²) • z` in the circle -/

/-- `lim_{n → W} 2^(n²) • z`. -/
noncomputable def Rlim (W : Ultrafilter ℕ) (z : AddCircle (1 : ℝ)) : AddCircle (1 : ℝ) :=
  (Ultrafilter.map (fun n : ℕ => (2 ^ (n ^ 2) : ℕ) • z) W).lim

lemma tendsto_Rlim (W : Ultrafilter ℕ) (z : AddCircle (1 : ℝ)) :
    Tendsto (fun n : ℕ => (2 ^ (n ^ 2) : ℕ) • z) W (𝓝 (Rlim W z)) :=
  (Ultrafilter.map (fun n : ℕ => (2 ^ (n ^ 2) : ℕ) • z) W).le_nhds_lim

lemma Rlim_add (W : Ultrafilter ℕ) (z z' : AddCircle (1 : ℝ)) : Rlim W (z + z') = Rlim W z + Rlim W z' := by
  refine tendsto_nhds_unique (tendsto_Rlim W (z + z')) ?_
  have h := (tendsto_Rlim W z).add (tendsto_Rlim W z')
  simpa only [nsmul_add] using h

lemma Rlim_zero (W : Ultrafilter ℕ) : Rlim W 0 = 0 := by
  refine tendsto_nhds_unique (tendsto_Rlim W 0) ?_
  simp only [nsmul_zero]
  exact tendsto_const_nhds

lemma char_mul_sS (χ : K) (b : ℝ) (n : ℕ) : χ (b * sS n) = (2 ^ (n ^ 2) : ℕ) • χ b := by
  rw [← map_nsmul]
  congr 1
  rw [nsmul_eq_mul, sS]
  push_cast
  ring

/-! ### Limits along an ultrafilter on a sum of dilates of `S` -/

/-- Along an ultrafilter `V`, points `σ a ∈ a₁S + … + a_kS` have limits `e t + Σ c_W L(W)` in `K`, and every algebraic character
`χ` has the corresponding limit `χ t + Σ R_W (χ c_W)`. -/
lemma piece_limits {α : Type*} (V : Ultrafilter α) :
    ∀ (l : List ℝ) (σ : α → ℝ), (∀ a, σ a ∈ sumSet l) →
      ∃ (t : ℝ) (c : Ultrafilter ℕ →₀ ℝ), (∀ W ∈ c.support, Free W) ∧
        Tendsto (fun a => e (σ a)) V (𝓝 (e t + c.sum fun W β => β • L sS W)) ∧
        ∀ χ : K, Tendsto (fun a => χ (σ a)) V (𝓝 (χ t + c.sum fun W β => Rlim W (χ β)))
  | [], σ, hσ => by
    have h0 : σ = fun _ => (0 : ℝ) := funext fun a => hσ a
    refine ⟨0, 0, by simp, ?_, fun χ => ?_⟩
    · rw [h0]; simpa using (tendsto_const_nhds (x := e 0) (f := (V : Filter α)))
    · rw [h0]; simpa using (tendsto_const_nhds (x := χ 0) (f := (V : Filter α)))
  | a0 :: l, σ, hσ => by
    classical
    have hdec : ∀ a, ∃ cc ∈ Sset, ∃ yy ∈ sumSet l, σ a = a0 * cc + yy := fun a => mem_sumSet_cons.1 (hσ a)
    choose cc hcc yy hyy heq using hdec
    obtain ⟨t', c', hfree, he, hχ⟩ := piece_limits V l yy hyy
    -- the coefficient of the first term is eventually zero, or `±s_n` with a fixed sign
    have hsplit : (∀ᶠ a in V, cc a = 0) ∨
        ∃ (ε : ℝ) (nn : α → ℕ), ∀ᶠ a in V, cc a = ε * sS (nn a) := by
      have h3 : ∀ᶠ a in V, cc a = 0 ∨ (∃ n : ℕ, cc a = 1 * sS n) ∨ ∃ n : ℕ, cc a = (-1) * sS n := by
        refine Eventually.of_forall fun a => ?_
        rcases hcc a with h | ⟨n, -, h | h⟩
        · exact Or.inl h
        · exact Or.inr (Or.inl ⟨n, by rw [h, one_mul]⟩)
        · exact Or.inr (Or.inr ⟨n, by rw [h]; ring⟩)
      rcases Ultrafilter.eventually_or.1 h3 with h | h
      · exact Or.inl h
      rcases Ultrafilter.eventually_or.1 h with h | h
      · refine Or.inr ⟨1, fun a => if h : ∃ n : ℕ, cc a = 1 * sS n then Classical.choose h else 0, h.mono fun a ha => ?_⟩
        simp only [dif_pos ha]
        exact Classical.choose_spec ha
      · refine Or.inr ⟨-1, fun a => if h : ∃ n : ℕ, cc a = (-1) * sS n then Classical.choose h else 0, h.mono fun a ha => ?_⟩
        simp only [dif_pos ha]
        exact Classical.choose_spec ha
    rcases hsplit with h0 | ⟨ε, nn, hnn⟩
    · have hev : ∀ᶠ a in V, σ a = yy a := h0.mono fun a ha => by rw [heq a, ha, mul_zero, zero_add]
      refine ⟨t', c', hfree, he.congr' (hev.mono fun a ha => by simp only [ha]), fun χ => ?_⟩
      exact (hχ χ).congr' (hev.mono fun a ha => by simp only [ha])
    have hev : ∀ᶠ a in V, σ a = (a0 * ε) * sS (nn a) + yy a :=
      hnn.mono fun a ha => by rw [heq a, ha, mul_assoc]
    obtain ⟨W, hW⟩ : ∃ W : Ultrafilter ℕ, W = Ultrafilter.map nn V := ⟨_, rfl⟩
    have htW : Tendsto nn V (W : Filter ℕ) := by rw [hW]; exact tendsto_map
    rcases Ultrafilter.le_cofinite_or_eq_pure W with hWf | ⟨m, hm⟩
    · refine ⟨t', c' + Finsupp.single W (a0 * ε), ?_, ?_, fun χ => ?_⟩
      · intro W' hW'
        rcases Finset.mem_union.1 (Finsupp.support_add hW') with h | h
        · exact hfree W' h
        · have : W' = W := Finset.mem_singleton.1 (Finsupp.support_single_subset h)
          rw [this]; exact hWf
      · have hsum : (c' + Finsupp.single W (a0 * ε)).sum (fun W β => β • L sS W)
            = c'.sum (fun W β => β • L sS W) + (a0 * ε) • L sS W := by
          rw [Finsupp.sum_add_index' (h := fun W β => β • L sS W) (fun W => Module.zero_smul (R := ℝ) (L sS W)) (fun W b b' => Module.add_smul (R := ℝ) b b' (L sS W)),
            Finsupp.sum_single_index (Module.zero_smul (R := ℝ) (L sS W))]
        have h1 : Tendsto (fun a => e ((a0 * ε) * sS (nn a))) V (𝓝 ((a0 * ε) • L sS W)) := by
          have h2 := ((continuous_smul_const (a0 * ε)).tendsto _).comp ((tendsto_L sS W).comp htW)
          refine h2.congr fun a => ?_
          simp only [Function.comp, smul_e]
        have h3 := h1.add he
        rw [hsum, show e t' + (c'.sum (fun W β => β • L sS W) + (a0 * ε) • L sS W)
            = (a0 * ε) • L sS W + (e t' + c'.sum fun W β => β • L sS W) by abel]
        exact h3.congr' (hev.mono fun a ha => by simp only [ha, e_add])
      · have hsum : (c' + Finsupp.single W (a0 * ε)).sum (fun W β => Rlim W (χ β))
            = c'.sum (fun W β => Rlim W (χ β)) + Rlim W (χ (a0 * ε)) := by
          rw [Finsupp.sum_add_index' (h := fun W β => Rlim W (χ β)) (fun _ => by rw [map_zero, Rlim_zero])
              (fun _ _ _ => by rw [map_add, Rlim_add]),
            Finsupp.sum_single_index (by rw [map_zero, Rlim_zero])]
        have h1 : Tendsto (fun a => χ ((a0 * ε) * sS (nn a))) V (𝓝 (Rlim W (χ (a0 * ε)))) := by
          refine ((tendsto_Rlim W (χ (a0 * ε))).comp htW).congr fun a => ?_
          simp only [Function.comp, char_mul_sS]
        have h3 := h1.add (hχ χ)
        rw [hsum, show χ t' + (c'.sum (fun W β => Rlim W (χ β)) + Rlim W (χ (a0 * ε)))
            = Rlim W (χ (a0 * ε)) + (χ t' + c'.sum fun W β => Rlim W (χ β)) by abel]
        exact h3.congr' (hev.mono fun a ha => by simp only [ha, map_add])
    · have hmem : ∀ᶠ a in V, nn a = m := by
        have h1 : ∀ᶠ n in (W : Filter ℕ), n = m := by
          rw [hm]; exact rfl
        exact htW.eventually h1
      have hev' : ∀ᶠ a in V, σ a = (a0 * ε) * sS m + yy a := by
        filter_upwards [hev, hmem] with a ha hb
        rw [ha, hb]
      refine ⟨(a0 * ε) * sS m + t', c', hfree, ?_, fun χ => ?_⟩
      · have h3 := (tendsto_const_nhds (x := e ((a0 * ε) * sS m)) (f := (V : Filter α))).add he
        rw [e_add, add_assoc]
        exact h3.congr' (hev'.mono fun a ha => by simp only [ha, e_add])
      · have h3 := (tendsto_const_nhds (x := χ ((a0 * ε) * sS m)) (f := (V : Filter α))).add (hχ χ)
        rw [map_add, add_assoc]
        exact h3.congr' (hev'.mono fun a ha => by simp only [ha, map_add])

/-! ### The finite-piece lemma -/

/-- On `F + a₁S + … + a_kS`, `F` finite, an ultrafilter that converges to `x` in the Bohr topology has `χ → χ x` for every
algebraic character `χ`. -/
theorem finitePiece_char (F : Set ℝ) (hF : F.Finite) (l : List ℝ) (χ : K) (U : Ultrafilter ℝ) (x : ℝ)
    (hU : F + sumSet l ∈ U) (hx : Tendsto e U (𝓝 (e x))) : Tendsto χ U (𝓝 (χ x)) := by
  classical
  have hcover : F + sumSet l = ⋃ f ∈ F, {z : ℝ | z - f ∈ sumSet l} := by
    ext z
    simp only [mem_iUnion, Set.mem_ofPred_eq, exists_prop]
    constructor
    · rintro ⟨f, hf, y, hy, rfl⟩
      exact ⟨f, hf, by simpa using hy⟩
    · rintro ⟨f, hf, hz⟩
      exact ⟨f, hf, z - f, hz, by ring⟩
  rw [hcover, Ultrafilter.finite_biUnion_mem_iff hF] at hU
  obtain ⟨f, -, hf⟩ := hU
  obtain ⟨σ, hσ⟩ : ∃ σ : ℝ → ℝ, σ = fun z => if z - f ∈ sumSet l then z - f else 0 := ⟨_, rfl⟩
  have hσmem : ∀ z, σ z ∈ sumSet l := by
    intro z
    rw [hσ]
    dsimp only
    split_ifs with h
    · exact h
    · exact zero_mem_sumSet l
  have hev : ∀ᶠ z in (U : Filter ℝ), z = σ z + f := by
    filter_upwards [hf] with z hz
    have hz' : z - f ∈ sumSet l := hz
    rw [hσ]
    simp only [if_pos hz']
    ring
  obtain ⟨t, c, hfree, he, hχ⟩ := piece_limits U l σ hσmem
  have h1 : Tendsto e U (𝓝 (e t + c.sum (fun W β => β • L sS W) + e f)) := by
    have h2 := he.add (tendsto_const_nhds (x := e f) (f := (U : Filter ℝ)))
    refine h2.congr' (hev.mono fun z hz => ?_)
    rw [← e_add, ← hz]
  have h3 : e x = e t + c.sum (fun W β => β • L sS W) + e f := tendsto_nhds_unique hx h1
  have h4 : ∑ W ∈ c.support, c W • L sS W = e (x - t - f) := by
    have h5 : c.sum (fun W β => β • L sS W) = ∑ W ∈ c.support, c W • L sS W := rfl
    rw [← h5, e_sub', e_sub', h3]
    abel
  have h6 := independence_finset sS (fun k => (sS_pos k).ne') sS_ratio c.support hfree (fun W => c W) _ h4
  have hc : c = 0 := by
    ext W
    by_cases hW : W ∈ c.support
    · simpa using h6 W hW
    · simpa using Finsupp.notMem_support_iff.1 hW
  have hxt : x = t + f := by
    apply e_injective'
    rw [h3, hc, e_add]
    simp
  have h7 := (hχ χ).add (tendsto_const_nhds (x := χ f) (f := (U : Filter ℝ)))
  have h8 : χ t + c.sum (fun W β => Rlim W (χ β)) + χ f = χ x := by
    rw [hc, hxt, map_add]
    simp
  rw [h8] at h7
  refine h7.congr' (hev.mono fun z hz => ?_)
  rw [← map_add, ← hz]

/-! ### The Bohr topology of the discrete group `ℝ` -/

/-- `τ_D`: the topology generated by all algebraic characters. -/
def discTop : TopologicalSpace ℝ :=
  TopologicalSpace.induced (fun x : ℝ => fun χ : K => χ x) Pi.topologicalSpace

/-- The family of all characters, as a homomorphism. -/
def allChars : ℝ →+ (K → AddCircle (1 : ℝ)) where
  toFun x χ := χ x
  map_zero' := funext fun χ => map_zero χ
  map_add' x y := funext fun χ => map_add χ x y

lemma discTop_group : @IsTopologicalAddGroup ℝ discTop _ :=
  topologicalAddGroup_induced allChars

lemma nhds_disc_le (x : ℝ) (χ : K) : Tendsto χ (@nhds ℝ discTop x) (𝓝 (χ x)) := by
  have h : Tendsto (fun x : ℝ => fun χ : K => χ x) (@nhds ℝ discTop x) (𝓝 fun χ : K => χ x) := by
    unfold discTop
    rw [nhds_induced]
    exact tendsto_comap
  exact (tendsto_pi_nhds.1 h) χ

/-- `τ_D` is finer than `τ_B`. -/
lemma discTop_le_bohr : discTop ≤ bohrTop := by
  refine le_of_nhds_le_nhds fun x => ?_
  rw [nhds_bohr]
  refine Filter.tendsto_iff_comap.1 ?_
  show Tendsto e (@nhds ℝ discTop x) (𝓝 (e x))
  rw [Topology.IsInducing.tendsto_nhds_iff (g := fun κ : K => (κ : ℝ → AddCircle (1 : ℝ))) ⟨rfl⟩]
  refine tendsto_pi_nhds.2 fun b => ?_
  have h := nhds_disc_le x (e b)
  have hsym : ∀ y : ℝ, e b y = e y b := fun y => by
    rw [e_apply, e_apply, mul_comm]
  simp only [Function.comp, ← hsym]
  exact h

/-- Equality of traces, in neighbourhood form. -/
def TraceEq (γ : TopologicalSpace ℝ) (J : Set ℝ) : Prop :=
  ∀ x ∈ J, ∀ W ∈ @nhds ℝ γ x, W ∈ @nhds ℝ bohrTop x ⊓ 𝓟 J

lemma trace_iff (γ : TopologicalSpace ℝ) (hfine : γ ≤ bohrTop) (J : Set ℝ) :
    TopologicalSpace.induced (Subtype.val : J → ℝ) γ = TopologicalSpace.induced (Subtype.val : J → ℝ) bohrTop ↔
      TraceEq γ J := by
  have key : ∀ x : J, ∀ W : Set ℝ,
      (Subtype.val : J → ℝ) ⁻¹' W ∈ Filter.comap (Subtype.val : J → ℝ) (@nhds ℝ bohrTop x) ↔
        W ∈ @nhds ℝ bohrTop x ⊓ 𝓟 J := by
    intro x W
    rw [Filter.mem_comap, Filter.mem_inf_principal]
    constructor
    · rintro ⟨B, hB, hBW⟩
      refine Filter.mem_of_superset hB fun y hy hyJ => ?_
      exact hBW (show (⟨y, hyJ⟩ : J) ∈ Subtype.val ⁻¹' B from hy)
    · intro h
      exact ⟨_, h, fun y hy => hy y.2⟩
  constructor
  · intro h x hx W hW
    refine (key ⟨x, hx⟩ W).1 ?_
    have h1 : (Subtype.val : J → ℝ) ⁻¹' W ∈ @nhds J (TopologicalSpace.induced Subtype.val γ) ⟨x, hx⟩ := by
      rw [@nhds_induced ℝ J γ Subtype.val ⟨x, hx⟩]
      exact Filter.preimage_mem_comap hW
    rw [h, @nhds_induced ℝ J bohrTop Subtype.val ⟨x, hx⟩] at h1
    exact h1
  · intro h
    refine le_antisymm (induced_mono hfine) (le_of_nhds_le_nhds fun x => ?_)
    rw [@nhds_induced ℝ J γ Subtype.val x, @nhds_induced ℝ J bohrTop Subtype.val x]
    intro s hs
    obtain ⟨W, hW, hWs⟩ := Filter.mem_comap.1 hs
    exact Filter.mem_of_superset ((key x W).2 (h x x.2 W hW)) hWs

/-- `I₀`: subsets of the sets `F + a₁S + … + a_kS` with `F` finite. -/
def I0 : Set (Set ℝ) := {A | ∃ F : Set ℝ, F.Finite ∧ ∃ l : List ℝ, A ⊆ F + sumSet l}

/-- `τ_D` and `τ_B` induce the same topology on every member of `I₀`. -/
theorem finitePiece_trace {J : Set ℝ} (hJ : J ∈ I0) :
    TopologicalSpace.induced (Subtype.val : J → ℝ) discTop =
      TopologicalSpace.induced (Subtype.val : J → ℝ) bohrTop := by
  obtain ⟨F, hF, l, hl⟩ := hJ
  rw [trace_iff discTop discTop_le_bohr J]
  intro x _ W hW
  refine Filter.mem_iff_ultrafilter.2 fun U hU => ?_
  have hUb : Tendsto e U (𝓝 (e x)) := by
    have h1 : (U : Filter ℝ) ≤ @nhds ℝ bohrTop x := hU.trans inf_le_left
    rw [nhds_bohr] at h1
    exact Filter.tendsto_iff_comap.2 h1
  have hUJ : J ∈ U := (hU.trans inf_le_right) (Filter.mem_principal_self J)
  have hUp : F + sumSet l ∈ U := Filter.mem_of_superset hUJ hl
  have hconv : (U : Filter ℝ) ≤ @nhds ℝ discTop x := by
    unfold discTop
    rw [nhds_induced]
    refine Filter.tendsto_iff_comap.1 (tendsto_pi_nhds.2 fun χ => ?_)
    exact finitePiece_char F hF l χ U x hUp hUb
  exact hconv hW

/-- `τ_D` is not the Bohr topology `τ_B`. -/
theorem discTop_ne_bohr : discTop ≠ bohrTop := by
  intro hEq
  obtain ⟨f, hf1⟩ : ∃ f : ℝ →ₗ[ℚ] ℚ, f 1 = 1 := by
    have h1 : LinearIndependent ℚ (fun _ : Unit => (1 : ℝ)) :=
      LinearIndependent.of_subsingleton () one_ne_zero
    obtain ⟨g, hg⟩ := (Finsupp.linearCombination ℚ (fun _ : Unit => (1 : ℝ))).exists_leftInverse_of_injective
      (LinearMap.ker_eq_bot.2 h1)
    refine ⟨(Finsupp.lapply ()).comp g, ?_⟩
    have h2 : g 1 = Finsupp.single () 1 := by
      have h3 := LinearMap.congr_fun hg (Finsupp.single () 1)
      simpa using h3
    simp [h2]
  -- a nonzero element of the kernel
  obtain ⟨b, hb0, hfb⟩ : ∃ b : ℝ, b ≠ 0 ∧ f b = 0 := by
    by_contra hno
    push Not at hno
    have hinj : Function.Injective f := by
      intro u v huv
      by_contra hne
      exact hno (u - v) (sub_ne_zero.2 hne) (by rw [map_sub, huv, sub_self])
    exact Cardinal.not_countable_real (Set.countable_univ_iff.2 hinj.countable)
  -- the character `x ↦ f x mod 1`
  let χ : K := (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℝ))).comp
    ((Rat.castHom ℝ).toAddMonoidHom.comp f.toAddMonoidHom)
  have hχ : ∀ x, χ x = (((f x : ℚ) : ℝ) : AddCircle (1 : ℝ)) := fun x => rfl
  -- rationals `q_n` with `1/2 + q_n b → 0`
  have hq : ∀ n : ℕ, ∃ q : ℚ, |(1 / 2 : ℝ) + q * b| < 1 / (n + 1) := by
    intro n
    have hb' : 0 < |b| := abs_pos.2 hb0
    have hr : (0 : ℝ) < 1 / (n + 1) / |b| := div_pos (by positivity) hb'
    obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn (show -(1 / 2) / b - 1 / (n + 1) / |b| < -(1 / 2) / b + 1 / (n + 1) / |b| by linarith)
    refine ⟨q, ?_⟩
    have h1 : |(q : ℝ) - -(1 / 2) / b| < 1 / (n + 1) / |b| := by
      rw [abs_lt]; constructor <;> linarith
    have h2 : (1 / 2 : ℝ) + q * b = ((q : ℝ) - -(1 / 2) / b) * b := by
      field_simp
      ring
    rw [h2, abs_mul]
    have h3 := mul_lt_mul_of_pos_right h1 hb'
    rwa [div_mul_cancel₀ _ hb'.ne'] at h3
  choose q hq using hq
  have hlim : Tendsto (fun n : ℕ => (1 / 2 : ℝ) + q n * b) atTop (𝓝 0) := by
    rw [tendsto_zero_iff_abs_tendsto_zero]
    exact squeeze_zero (fun n => abs_nonneg _) (fun n => (hq n).le) tendsto_one_div_add_atTop_nhds_zero_nat
  have h1 : Tendsto (fun n : ℕ => (1 / 2 : ℝ) + q n * b) atTop (@nhds ℝ bohrTop 0) :=
    hlim.mono_right (bohr_coarser_euclid 0)
  rw [← hEq] at h1
  have h2 := (nhds_disc_le 0 χ).comp h1
  have h3 : ∀ n : ℕ, χ ((1 / 2 : ℝ) + q n * b) = (((1 / 2 : ℝ)) : AddCircle (1 : ℝ)) := by
    intro n
    rw [hχ]
    have h4 : f ((1 / 2 : ℝ) + q n * b) = 1 / 2 := by
      have h5 : (1 / 2 : ℝ) + q n * b = (1 / 2 : ℚ) • (1 : ℝ) + (q n) • b := by
        rw [Rat.smul_def, Rat.smul_def]
        push_cast
        ring
      rw [h5, map_add, map_smul, map_smul, hf1, hfb]
      simp
    rw [h4]
    push_cast
    ring_nf
  have h6 : Tendsto (fun _ : ℕ => (((1 / 2 : ℝ)) : AddCircle (1 : ℝ))) atTop (𝓝 (χ 0)) :=
    h2.congr h3
  have h7 := tendsto_nhds_unique h6 tendsto_const_nhds
  rw [map_zero] at h7
  have h8 : dint (1 / 2) = 1 / 2 := by
    have := dint_half_int 0
    simpa using this
  have h9 : dint (1 / 2) = 0 := by
    unfold dint
    rw [← h7, norm_zero]
  rw [h8] at h9
  norm_num at h9

/-- Condition (N) without intervals: a group topology strictly finer than `τ_B` induces the Bohr topology on every member of
`I₀`. -/
theorem intervalFree_witness :
    ∃ γ : TopologicalSpace ℝ, @IsTopologicalAddGroup ℝ γ _ ∧ γ ≤ bohrTop ∧ γ ≠ bohrTop ∧
      ∀ J ∈ I0, TopologicalSpace.induced (Subtype.val : J → ℝ) γ =
        TopologicalSpace.induced (Subtype.val : J → ℝ) bohrTop :=
  ⟨discTop, discTop_group, discTop_le_bohr, discTop_ne_bohr, fun _ hJ => finitePiece_trace hJ⟩

/-! ### Compact thickening -/

lemma I0_subset_IS : I0 ⊆ IS := by
  rintro A ⟨F, hF, l, hl⟩
  obtain ⟨M, hM⟩ := (hF.image fun f : ℝ => |f|).bddAbove
  refine ⟨M, l, hl.trans (Set.add_subset_add_right fun f hf => ?_)⟩
  exact abs_le.1 (hM ⟨f, hf, rfl⟩)

/-- A bounded function along an ultrafilter has a limit, in the Euclidean and hence in the Bohr topology. -/
lemma exists_lim_Icc (U : Ultrafilter ℝ) (u : ℝ → ℝ) (m : ℝ) (h : ∀ᶠ z in (U : Filter ℝ), u z ∈ Set.Icc (-m) m) :
    ∃ c : ℝ, (∀ δ : ℝ, 0 < δ → ∀ᶠ z in (U : Filter ℝ), |u z - c| < δ) ∧ Tendsto u U (@nhds ℝ bohrTop c) := by
  have hIcc : Set.Icc (-m) m ∈ Ultrafilter.map u U := h
  obtain ⟨c, -, hc⟩ := isCompact_Icc.ultrafilter_le_nhds (Ultrafilter.map u U) (Filter.le_principal_iff.2 hIcc)
  have hcE : Tendsto u U (𝓝 c) := hc
  refine ⟨c, fun δ hδ => ?_, hcE.mono_right (bohr_coarser_euclid c)⟩
  have h3 := hcE (Metric.ball_mem_nhds c hδ)
  filter_upwards [h3] with z hz
  simpa [Metric.mem_ball, Real.dist_eq] using hz

/-- Compact thickening: for a group topology `γ` finer than `τ_B`, the Bohr trace on every member of the lacunary ideal is
equivalent to the Euclidean upper bound together with the Bohr trace on every member of `I₀`. -/
theorem thickening (γ : TopologicalSpace ℝ) (hγ : @IsTopologicalAddGroup ℝ γ _) (hfine : γ ≤ bohrTop) :
    (∀ J ∈ IS, TopologicalSpace.induced (Subtype.val : J → ℝ) γ =
        TopologicalSpace.induced (Subtype.val : J → ℝ) bohrTop) ↔
      (∀ W ∈ @nhds ℝ γ 0, ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, |t| < δ → t ∈ W) ∧
        ∀ J ∈ I0, TopologicalSpace.induced (Subtype.val : J → ℝ) γ =
          TopologicalSpace.induced (Subtype.val : J → ℝ) bohrTop := by
  constructor
  · intro h
    refine ⟨fun W hW => ?_, fun J hJ => h J (I0_subset_IS hJ)⟩
    have hI : Set.Icc (-1 : ℝ) 1 ∈ IS := bounded_mem_IS (M := 1) (fun a ha => abs_le.2 ha)
    have h1 := (trace_iff γ hfine _).1 (h _ hI) 0 (by constructor <;> norm_num) W hW
    rw [Filter.mem_inf_principal] at h1
    have h2 := bohr_coarser_euclid 0 h1
    obtain ⟨δ, hδ, hball⟩ := Metric.mem_nhds_iff.1 h2
    refine ⟨min δ 1, lt_min hδ one_pos, fun t ht => ?_⟩
    have ht1 : |t| < δ := lt_of_lt_of_le ht (min_le_left _ _)
    have ht2 : |t| ≤ 1 := (lt_of_lt_of_le ht (min_le_right _ _)).le
    exact hball (by simpa [Metric.mem_ball, Real.dist_eq] using ht1) (abs_le.1 ht2)
  · rintro ⟨heuc, h0⟩ J hJ
    classical
    obtain ⟨m, l, hl⟩ := hJ
    rw [trace_iff γ hfine J]
    intro x _ W hW
    refine Filter.mem_iff_ultrafilter.2 fun U hU => ?_
    have hUb : (U : Filter ℝ) ≤ @nhds ℝ bohrTop x := hU.trans inf_le_left
    have hUJ : J ∈ U := (hU.trans inf_le_right) (Filter.mem_principal_self J)
    -- decompose the points of `J`
    have hdec : ∀ z : ℝ, ∃ u v : ℝ, u ∈ Set.Icc (-m) m ∨ z ∉ J ∧ True := fun z => by
      by_cases hz : z ∈ J
      · obtain ⟨u, hu, v, -, -⟩ := hl hz
        exact ⟨u, v, Or.inl hu⟩
      · exact ⟨0, 0, Or.inr ⟨hz, trivial⟩⟩
    have hdec' : ∀ z ∈ J, ∃ u ∈ Set.Icc (-m) m, ∃ v ∈ sumSet l, u + v = z := fun z hz => by
      obtain ⟨u, hu, v, hv, h⟩ := hl hz
      exact ⟨u, hu, v, hv, h⟩
    obtain ⟨u, hu⟩ : ∃ u : ℝ → ℝ, ∀ z ∈ J, u z ∈ Set.Icc (-m) m ∧ z - u z ∈ sumSet l := by
      refine ⟨fun z => if h : z ∈ J then Classical.choose (hdec' z h) else 0, fun z hz => ?_⟩
      simp only [dif_pos hz]
      obtain ⟨h1, v, hv, h2⟩ := Classical.choose_spec (hdec' z hz)
      refine ⟨h1, ?_⟩
      have h3 : z - Classical.choose (hdec' z hz) = v := by linarith
      rw [h3]; exact hv
    obtain ⟨c, hcE, hcb⟩ := exists_lim_Icc U u m (by
      filter_upwards [hUJ] with z hz using (hu z hz).1)
    -- the Euclidean upper bound at `c`
    have hcγ : Tendsto u U (@nhds ℝ γ c) := by
      intro N hN
      have h1 : (fun t => c + t) ⁻¹' N ∈ @nhds ℝ γ 0 := by
        have h2 : @nhds ℝ γ c = Filter.map (fun t => c + t) (@nhds ℝ γ 0) := by
          letI : TopologicalSpace ℝ := γ
          haveI : IsTopologicalAddGroup ℝ := hγ
          exact (map_add_left_nhds_zero c).symm
        rw [h2] at hN
        exact hN
      obtain ⟨δ, hδ, hball⟩ := heuc _ h1
      refine Filter.mem_map.2 ?_
      filter_upwards [hcE δ hδ] with z hz
      have h5 := hball _ hz
      simpa using h5
    -- the other component
    have hvb : Tendsto (fun z => z - u z) U (@nhds ℝ bohrTop (x - c)) := by
      letI : TopologicalSpace ℝ := bohrTop
      haveI : IsTopologicalAddGroup ℝ := bohr_isTopologicalAddGroup
      exact Tendsto.sub (f := fun z : ℝ => z) hUb hcb
    have hJ1 : sumSet l ∪ {x - c} ∈ I0 := by
      refine ⟨{0, x - c}, by simp, l, ?_⟩
      rintro y (hy | hy)
      · exact ⟨0, by simp, y, hy, by simp⟩
      · rw [Set.mem_singleton_iff] at hy
        exact ⟨x - c, by simp, 0, zero_mem_sumSet l, by simp [hy]⟩
    have hvγ : Tendsto (fun z => z - u z) U (@nhds ℝ γ (x - c)) := by
      intro N hN
      have h1 := (trace_iff γ hfine _).1 (h0 _ hJ1) (x - c) (Or.inr rfl) N hN
      rw [Filter.mem_inf_principal] at h1
      have h2 := hvb h1
      refine Filter.mem_map.2 ?_
      filter_upwards [h2, hUJ] with z hz hzJ
      exact hz (Or.inl (hu z hzJ).2)
    have hfin : Tendsto (fun z => u z + (z - u z)) U (@nhds ℝ γ (c + (x - c))) := by
      letI : TopologicalSpace ℝ := γ
      haveI : IsTopologicalAddGroup ℝ := hγ
      exact Tendsto.add hcγ hvγ
    have hxc : c + (x - c) = x := by ring
    rw [hxc] at hfin
    have hid : (fun z => u z + (z - u z)) = fun z : ℝ => z := funext fun z => by ring
    rw [hid] at hfin
    exact hfin hW

end Lac
