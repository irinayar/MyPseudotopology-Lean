import Mathlib
import LeanCheck.PGThreeSelective
import LeanCheck.PGTwoQuotient
import LeanCheck.PGTwoCoreflection
import LeanCheck.PGThreeSparse

/-!
# PGthree: for countably many selective ultrafilters the topological modification is a group topology (Lean check)

Scope. Section 7 of the third article (`PGthree.tex`). `G` is a countably infinite abelian group, `u j`, `j ∈ J`
(`J` countable), are pairwise non-isomorphic selective ultrafilters, and `C = genFam (ultraGen (range u))` is the null
family of the PG they generate.

* `exists_basic_subset` : a set `O` containing `0` that is stable (for `x` in `O`, every `c : ℤ` and every `j`,
  `{y | x + c • e y ∈ O}` belongs to `w j`) contains a basic set `Wset e S`;
* `modification_isGroupTopology` : there is a group topology `t` whose open sets are the sets open for the topological
  modification of the PG; its neighbourhoods of `0` are the sets containing a basic set; it is the finest group topology
  of the PG; and, when only finitely many `x` satisfy `m • x = 0` for every `m ≥ 1`, it separates `0` from every `g ≠ 0`;
* `exists_sparse_of_selective` : a selective ultrafilter on `ℤ` containing the positive integers contains every tail of
  finite sums of a rapidly growing sequence;
* `selective_int_strict` : for a selective ultrafilter `u` on `ℤ` the modification of the PG generated by `u` is the
  finest group topology, and it has strictly fewer neighbourhoods of `0` than there are vicinity sets.

No set-theoretic hypothesis is used. A Lean proof verifies its formal statement under its hypotheses; the
correspondence with the article requires mathematical review.
-/

open Filter Set Topology

namespace PG

namespace Sel

section Modification

variable {G : Type*} [AddCommGroup G]

/-- The number of elements of `S` that are at most `y`. -/
noncomputable def pos (S : Set ℕ) (y : ℕ) : ℕ := by
  classical
  exact ((Finset.range (y + 1)).filter (fun z => z ∈ S)).card

theorem pos_le (S : Set ℕ) (y : ℕ) : pos S y ≤ y + 1 := by
  classical
  unfold pos
  exact (Finset.card_filter_le _ _).trans (by simp)

theorem pos_mono {S T : Set ℕ} (h : S ⊆ T) (y : ℕ) : pos S y ≤ pos T y := by
  classical
  unfold pos
  refine Finset.card_le_card (fun z hz => ?_)
  rw [Finset.mem_filter] at hz ⊢
  exact ⟨hz.1, h hz.2⟩

theorem one_le_pos {S : Set ℕ} {y : ℕ} (hy : y ∈ S) : 1 ≤ pos S y := by
  classical
  unfold pos
  exact Finset.card_pos.2 ⟨y, Finset.mem_filter.2 ⟨Finset.mem_range.2 (Nat.lt_succ_self _), hy⟩⟩

/-- The basic set of all sums `∑ c y • e y` with `|c y|` at most the position of `y` in one of the sets `S j`. -/
def Wset {J : Type*} (e : ℕ → G) (S : J → Set ℕ) : Set G :=
  {z | ∃ (s : Finset ℕ) (c : ℕ → ℤ), (∀ y ∈ s, ∃ j, y ∈ S j ∧ |c y| ≤ (pos (S j) y : ℤ)) ∧
    z = ∑ y ∈ s, c y • e y}

theorem zero_mem_Wset {J : Type*} (e : ℕ → G) (S : J → Set ℕ) : (0 : G) ∈ Wset e S :=
  ⟨∅, fun _ => 0, by simp, by simp⟩

theorem neg_mem_Wset {J : Type*} (e : ℕ → G) (S : J → Set ℕ) {z : G} (hz : z ∈ Wset e S) : -z ∈ Wset e S := by
  obtain ⟨s, c, h, rfl⟩ := hz
  refine ⟨s, fun y => -c y, fun y hy => ?_, by simp [Finset.sum_neg_distrib]⟩
  obtain ⟨j, hj, hc⟩ := h y hy
  exact ⟨j, hj, by rwa [abs_neg]⟩

theorem Wset_mono {J : Type*} (e : ℕ → G) {S T : J → Set ℕ} (h : ∀ j, S j ⊆ T j) : Wset e S ⊆ Wset e T := by
  rintro z ⟨s, c, hc, rfl⟩
  refine ⟨s, c, fun y hy => ?_, rfl⟩
  obtain ⟨j, hj, hle⟩ := hc y hy
  exact ⟨j, h j hj, hle.trans (by exact_mod_cast pos_mono (h j) y)⟩

/-- A member of a nonprincipal ultrafilter can be thinned so that positions are at least halved. -/
theorem exists_thinned {w : Ultrafilter ℕ} (hw : ∀ a, w ≠ pure a) {B : Set ℕ} (hB : B ∈ w) :
    ∃ B' : Set ℕ, B' ∈ w ∧ B' ⊆ B ∧ ∀ y ∈ B', 2 * pos B' y ≤ pos B y := by
  classical
  have hstep : ∀ y z, y < z → z ∈ B → pos B y < pos B z := by
    intro y z hyz hz
    unfold pos
    refine Finset.card_lt_card ⟨fun x hx => ?_, fun h => ?_⟩
    · rw [Finset.mem_filter, Finset.mem_range] at hx ⊢
      exact ⟨by omega, hx.2⟩
    · have : z ∈ (Finset.range (y + 1)).filter (fun x => x ∈ B) :=
        h (Finset.mem_filter.2 ⟨Finset.mem_range.2 (Nat.lt_succ_self _), hz⟩)
      rw [Finset.mem_filter, Finset.mem_range] at this
      omega
  have hinj : ∀ y ∈ B, ∀ z ∈ B, pos B y = pos B z → y = z := by
    intro y hy z hz h
    rcases lt_trichotomy y z with hlt | heq | hlt
    · exact absurd h (hstep y z hlt hz).ne
    · exact heq
    · exact absurd h (hstep z y hlt hy).ne'
  have hmono : ∀ y z, y ≤ z → pos B y ≤ pos B z := by
    intro y z h
    unfold pos
    refine Finset.card_le_card (fun x hx => ?_)
    rw [Finset.mem_filter, Finset.mem_range] at hx ⊢
    exact ⟨by omega, hx.2⟩
  have key : ∀ (r : ℕ) (B' : Set ℕ), (∀ z ∈ B', z ∈ B ∧ pos B z % 2 = r ∧ 2 ≤ pos B z) →
      ∀ y ∈ B', 2 * pos B' y ≤ pos B y := by
    intro r B' hB' y _
    have hcard : ((Finset.range (y + 1)).filter (fun z => z ∈ B')).card
        ≤ (Finset.Icc 1 (pos B y / 2)).card := by
      refine Finset.card_le_card_of_injOn (fun z => pos B z / 2) (fun z hz => ?_) (fun a ha b hb hab => ?_)
      · rw [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hz
        have h1 := hmono z y (by omega)
        have h2 := (hB' z hz.2).2.2
        rw [Finset.mem_coe, Finset.mem_Icc]
        show 1 ≤ pos B z / 2 ∧ pos B z / 2 ≤ pos B y / 2
        omega
      · rw [Finset.mem_coe, Finset.mem_filter] at ha hb
        have h1 := hB' a ha.2
        have h2 := hB' b hb.2
        have h3 : pos B a / 2 = pos B b / 2 := hab
        have h4 := h1.2.1
        have h5 := h2.2.1
        exact hinj a h1.1 b h2.1 (by omega)
    have h1 : pos B' y = ((Finset.range (y + 1)).filter (fun z => z ∈ B')).card := rfl
    rw [Nat.card_Icc] at hcard
    omega
  set P0 : Set ℕ := {y | y ∈ B ∧ pos B y % 2 = 0} with hP0
  set P1 : Set ℕ := {y | y ∈ B ∧ pos B y % 2 = 1 ∧ 2 ≤ pos B y} with hP1
  set P2 : Set ℕ := {y | y ∈ B ∧ pos B y = 1} with hP2
  have hcover : B ⊆ (P0 ∪ P1) ∪ P2 := by
    intro y hy
    have := one_le_pos hy
    rcases Nat.mod_two_eq_zero_or_one (pos B y) with h | h
    · exact Or.inl (Or.inl ⟨hy, h⟩)
    · by_cases h1 : pos B y = 1
      · exact Or.inr ⟨hy, h1⟩
      · exact Or.inl (Or.inr ⟨hy, h, by omega⟩)
  have h2 : P2 ∉ w := by
    refine notMem_of_finite hw (Set.Subsingleton.finite (fun a ha b hb => ?_))
    exact hinj a ha.1 b hb.1 (ha.2.trans hb.2.symm)
  have h3 : P0 ∈ w ∨ P1 ∈ w := by
    rcases Ultrafilter.union_mem_iff.1 (Filter.mem_of_superset hB hcover) with h | h
    · exact Ultrafilter.union_mem_iff.1 h
    · exact absurd h h2
  rcases h3 with h | h
  · refine ⟨P0, h, fun z hz => hz.1, key 0 P0 (fun z hz => ⟨hz.1, hz.2, ?_⟩)⟩
    have := one_le_pos hz.1
    have := hz.2
    omega
  · exact ⟨P1, h, fun z hz => hz.1, key 1 P1 (fun z hz => ⟨hz.1, hz.2.1, hz.2.2⟩)⟩

/-- A stable set containing `0` contains a basic set. -/
theorem exists_basic_subset {J : Type*} [Countable J] (e : ℕ → G) (w : J → Ultrafilter ℕ) (hw : ∀ j, IsSel (w j))
    (hiso : ∀ i j, i ≠ j → ¬ Iso (w i) (w j)) (O : Set G) (h0 : (0 : G) ∈ O)
    (hst : ∀ x ∈ O, ∀ c : ℤ, ∀ j, {y | x + c • e y ∈ O} ∈ w j) :
    ∃ S : J → Set ℕ, (∀ j, S j ∈ w j) ∧ Wset e S ⊆ O := by
  classical
  -- the finitely many sums with bounded support and coefficients
  let X : ℕ → Finset G := fun n =>
    (Fintype.piFinset (fun _ : Fin (n + 1) => Finset.Icc (-((n : ℤ) + 2)) ((n : ℤ) + 2))).image
      (fun c => ∑ i : Fin (n + 1), c i • e i)
  have hX : ∀ (n : ℕ) (s : Finset ℕ) (c : ℕ → ℤ), (∀ y ∈ s, y ≤ n) → (∀ y ∈ s, |c y| ≤ (n : ℤ) + 2) →
      ∑ y ∈ s, c y • e y ∈ X n := by
    intro n s c hs hc
    refine Finset.mem_image.2 ⟨fun i : Fin (n + 1) => if (i : ℕ) ∈ s then c i else 0, ?_, ?_⟩
    · rw [Fintype.mem_piFinset]
      intro i
      rw [Finset.mem_Icc]
      split_ifs with h
      · exact abs_le.1 (hc _ h)
      · omega
    · have h1 : ∑ i : Fin (n + 1), (if (i : ℕ) ∈ s then c i else 0) • e i
          = ∑ y ∈ Finset.range (n + 1), (if y ∈ s then c y else 0) • e y :=
        Fin.sum_univ_eq_sum_range (fun y => (if y ∈ s then c y else 0) • e y) (n + 1)
      have h2 : ∀ y, (if y ∈ s then c y else 0) • e y = if y ∈ s then c y • e y else 0 := by
        intro y
        split_ifs
        · rfl
        · exact zero_smul _ _
      have h3 : Finset.range (n + 1) ∩ s = s :=
        Finset.inter_eq_right.2 (fun y hy => Finset.mem_range.2 (Nat.lt_succ_of_le (hs y hy)))
      rw [h1]
      simp only [h2]
      rw [Finset.sum_ite_mem, h3]
  let Sg : J → ℕ → Set ℕ := fun j n =>
    {y | ∀ x ∈ X n, x ∈ O → ∀ c ∈ Finset.Icc (-((n : ℤ) + 2)) ((n : ℤ) + 2), x + c • e y ∈ O}
  have hSg : ∀ j n, Sg j n ∈ w j := by
    intro j n
    have h1 : (⋂ x ∈ X n, {y | x ∈ O → ∀ c ∈ Finset.Icc (-((n : ℤ) + 2)) ((n : ℤ) + 2), x + c • e y ∈ O})
        ∈ (w j : Filter ℕ) := by
      refine (Filter.biInter_finset_mem (X n)).2 (fun x _ => ?_)
      by_cases hx : x ∈ O
      · have h2 : (⋂ c ∈ Finset.Icc (-((n : ℤ) + 2)) ((n : ℤ) + 2), {y | x + c • e y ∈ O}) ∈ (w j : Filter ℕ) :=
          (Filter.biInter_finset_mem _).2 (fun c _ => hst x hx c j)
        refine Filter.mem_of_superset h2 (fun y hy _ c hc => ?_)
        exact mem_iInter₂.1 hy c hc
      · exact Filter.mem_of_superset Filter.univ_mem (fun y _ h => absurd h hx)
    exact Filter.mem_of_superset h1 (fun y hy x hx => mem_iInter₂.1 hy x hx)
  have hD : ∀ j, {y | e y ∈ O ∧ -e y ∈ O} ∈ w j := by
    intro j
    have h1 := hst 0 h0 1 j
    have h2 := hst 0 h0 (-1) j
    simp only [zero_add, one_smul] at h1
    simp only [zero_add, neg_smul, one_smul] at h2
    exact Filter.inter_mem h1 h2
  have hC0 : ∀ j, ∃ C ∈ w j, ∀ n, (C \ Sg j n).Finite := fun j => (hw j).pseudoInter (Sg j) (hSg j)
  choose C0 hC0mem hC0fin using hC0
  -- monotone bounds for the exceptions
  let f : J → ℕ → ℕ := fun j n =>
    (Finset.range (n + 1)).sup (fun m => (hC0fin j m).toFinset.sup id) + n
  have hfmono : ∀ j, Monotone (f j) := by
    intro j a b hab
    exact Nat.add_le_add (Finset.sup_mono (Finset.range_mono (Nat.succ_le_succ hab))) hab
  have hfbound : ∀ j n y, y ∈ C0 j → y ∉ Sg j n → y ≤ f j n := by
    intro j n y hy hn
    have h1 : y ∈ (hC0fin j n).toFinset := (hC0fin j n).mem_toFinset.2 ⟨hy, hn⟩
    have h2 : y ≤ (hC0fin j n).toFinset.sup id := Finset.le_sup (f := id) h1
    have h3 : (hC0fin j n).toFinset.sup id
        ≤ (Finset.range (n + 1)).sup (fun m => (hC0fin j m).toFinset.sup id) :=
      Finset.le_sup (f := fun m => (hC0fin j m).toFinset.sup id) (Finset.mem_range.2 (Nat.lt_succ_self n))
    exact (h2.trans h3).trans (Nat.le_add_right _ _)
  -- finite stages of the index set
  obtain ⟨enc, henc⟩ := Countable.exists_injective_nat J
  have hJfin : ∀ m, {j | enc j ≤ m}.Finite := fun m => (finite_Iic m).preimage henc.injOn
  let T : ℕ → Finset J := fun m => (hJfin m).toFinset
  have hT : ∀ m j, j ∈ T m ↔ enc j ≤ m := fun m j => (hJfin m).mem_toFinset
  have hsepm : ∀ m, ∃ E : J → Set ℕ, (∀ j, E j ∈ w j) ∧
      ∀ i ∈ T m, ∀ j ∈ T m, ∀ x ∈ E i, ∀ y ∈ E j, x < y → f j x < y := by
    intro m
    let F : ℕ → ℕ := fun x => x + (T m).sup (fun j => f j x)
    have hFmono : Monotone F := fun a b hab =>
      Nat.add_le_add hab (Finset.sup_mono_fun (fun j _ => hfmono j hab))
    have hFx : ∀ x, x ≤ F x := fun x => Nat.le_add_right _ _
    let idx : Fin (T m).card → J := fun k => ((T m).equivFin.symm k).1
    have hidx : ∀ a b, a ≠ b → idx a ≠ idx b := by
      intro a b hab h
      exact hab ((T m).equivFin.symm.injective (Subtype.ext h))
    obtain ⟨B, hBmem, hBsep⟩ := separation (fun k => w (idx k)) (fun k => hw _)
      (fun a b hab => hiso _ _ (hidx a b hab)) F hFmono hFx
    let E : J → Set ℕ := fun j => if h : j ∈ T m then B ((T m).equivFin ⟨j, h⟩) else univ
    have hidxE : ∀ j (h : j ∈ T m), idx ((T m).equivFin ⟨j, h⟩) = j := by
      intro j h
      show (((T m).equivFin.symm ((T m).equivFin ⟨j, h⟩))).1 = j
      rw [Equiv.symm_apply_apply]
    refine ⟨E, fun j => ?_, fun i hi j hj x hx y hy hxy => ?_⟩
    · by_cases h : j ∈ T m
      · have h1 : E j = B ((T m).equivFin ⟨j, h⟩) := dif_pos h
        have h2 := hBmem ((T m).equivFin ⟨j, h⟩)
        rw [hidxE j h] at h2
        rw [h1]; exact h2
      · have h1 : E j = univ := dif_neg h
        rw [h1]; exact Filter.univ_mem
    · have h1 : E i = B ((T m).equivFin ⟨i, hi⟩) := dif_pos hi
      have h2 : E j = B ((T m).equivFin ⟨j, hj⟩) := dif_pos hj
      rw [h1] at hx
      rw [h2] at hy
      have h3 := hBsep _ _ x hx y hy hxy
      have h4 : f j x ≤ F x :=
        (Finset.le_sup (f := fun k => f k x) hj).trans (Nat.le_add_left _ _)
      exact lt_of_le_of_lt h4 h3
  choose E hEmem hEsep using hsepm
  have hC1 : ∀ j, ∃ C ∈ w j, ∀ m, (C \ E m j).Finite := fun j => (hw j).pseudoInter (fun m => E m j) (fun m => hEmem m j)
  choose C1 hC1mem hC1fin using hC1
  let g : ℕ → ℕ := fun m => (T m).sup (fun i => (hC1fin i m).toFinset.sup id)
  have hg : ∀ m i y, i ∈ T m → y ∈ C1 i → y ∉ E m i → y ≤ g m := by
    intro m i y hi hy hn
    have h1 : y ∈ (hC1fin i m).toFinset := (hC1fin i m).mem_toFinset.2 ⟨hy, hn⟩
    have h2 : y ≤ (hC1fin i m).toFinset.sup id := Finset.le_sup (f := id) h1
    exact h2.trans (Finset.le_sup (f := fun i => (hC1fin i m).toFinset.sup id) hi)
  let H : ℕ → ℕ := fun m => max (g m) ((T m).sup (fun j => f j (g m)))
  let S : J → Set ℕ := fun j =>
    C0 j ∩ C1 j ∩ E (enc j) j ∩ {y | e y ∈ O ∧ -e y ∈ O} ∩ {y | H (enc j) < y}
  have hSmem : ∀ j, S j ∈ w j := by
    intro j
    have hco : {y | H (enc j) < y} ∈ w j := by
      rcases (w j).mem_or_compl_mem {y | H (enc j) < y} with h | h
      · exact h
      · refine absurd h (notMem_of_finite (hw j).1 ((finite_Iic (H (enc j))).subset (fun y hy => ?_)))
        have : ¬ H (enc j) < y := hy
        exact mem_Iic.2 (by omega)
    exact Filter.inter_mem (Filter.inter_mem (Filter.inter_mem (Filter.inter_mem (hC0mem j) (hC1mem j))
      (hEmem (enc j) j)) (hD j)) hco
  have hsep : ∀ i j, ∀ x ∈ S i, ∀ y ∈ S j, x < y → f j x < y := by
    intro i j x hx y hy hxy
    obtain ⟨⟨⟨⟨_, hxC1⟩, hxE⟩, _⟩, hxH⟩ := hx
    obtain ⟨⟨⟨⟨_, hyC1⟩, hyE⟩, _⟩, hyH⟩ := hy
    have hxH' : H (enc i) < x := hxH
    have hyH' : H (enc j) < y := hyH
    set m := max (enc i) (enc j) with hm
    have hiT : i ∈ T m := (hT m i).2 (le_max_left _ _)
    have hjT : j ∈ T m := (hT m j).2 (le_max_right _ _)
    by_cases hx' : x ∈ E m i
    · by_cases hy' : y ∈ E m j
      · exact hEsep m i hiT j hjT x hx' y hy' hxy
      · exfalso
        have hmi : m = enc i := by
          rcases max_choice (enc i) (enc j) with h | h
          · exact hm.trans h
          · have : m = enc j := hm.trans h
            rw [this] at hy'
            exact absurd hyE hy'
        have h1 := hg m j y hjT hyC1 hy'
        have h2 : g m ≤ H m := le_max_left _ _
        rw [← hmi] at hxH'
        omega
    · have hmj : m = enc j := by
        rcases max_choice (enc i) (enc j) with h | h
        · have : m = enc i := hm.trans h
          rw [this] at hx'
          exact absurd hxE hx'
        · exact hm.trans h
      have h1 := hg m i x hiT hxC1 hx'
      have h2 : f j x ≤ f j (g m) := hfmono j h1
      have h3 : f j (g m) ≤ H m :=
        (Finset.le_sup (f := fun k => f k (g m)) hjT).trans (le_max_right _ _)
      rw [← hmj] at hyH'
      omega
  refine ⟨S, hSmem, ?_⟩
  have main : ∀ (c : ℕ → ℤ) (s : Finset ℕ), (∀ y ∈ s, ∃ j, y ∈ S j ∧ |c y| ≤ (pos (S j) y : ℤ)) →
      ∑ y ∈ s, c y • e y ∈ O := by
    intro c s
    induction s using Finset.induction_on_max with
    | empty => intro _; simpa using h0
    | insert a s hlt ih =>
      intro hs
      have has : a ∉ s := fun h => lt_irrefl a (hlt a h)
      have hs' : ∀ y ∈ s, ∃ j, y ∈ S j ∧ |c y| ≤ (pos (S j) y : ℤ) :=
        fun y hy => hs y (Finset.mem_insert_of_mem hy)
      have hx := ih hs'
      obtain ⟨j, haS, hca⟩ := hs a (Finset.mem_insert_self a s)
      rw [Finset.sum_insert has, add_comm]
      by_cases hbase : s = ∅ ∧ pos (S j) a = 1
      · obtain ⟨hse, hpos⟩ := hbase
        rw [hse, Finset.sum_empty, zero_add]
        rw [hpos] at hca
        have h1 := abs_le.1 hca
        have h2 : c a = -1 ∨ c a = 0 ∨ c a = 1 := by omega
        have hDa : e a ∈ O ∧ -e a ∈ O := haS.1.2
        rcases h2 with h | h | h
        · rw [h, neg_smul, one_smul]; exact hDa.2
        · rw [h, zero_smul]; exact h0
        · rw [h, one_smul]; exact hDa.1
      · set Q : Finset ℕ := (Finset.range a).filter (fun z => z ∈ S j) with hQ
        have hposQ : pos (S j) a = Q.card + 1 := by
          have h1 : (Finset.range (a + 1)).filter (fun z => z ∈ S j) = insert a Q := by
            rw [Finset.range_add_one, Finset.filter_insert, if_pos haS]
          have h2 : a ∉ Q := fun h => by
            have := (Finset.mem_filter.1 h).1
            exact lt_irrefl a (Finset.mem_range.1 this)
          have h3 : pos (S j) a = ((Finset.range (a + 1)).filter (fun z => z ∈ S j)).card := by
            unfold pos; congr
          rw [h3, h1, Finset.card_insert_of_notMem h2]
        have hne : (s ∪ Q).Nonempty := by
          by_contra h
          rw [Finset.not_nonempty_iff_eq_empty, Finset.union_eq_empty] at h
          exact hbase ⟨h.1, by rw [hposQ, h.2]; rfl⟩
        set p := (s ∪ Q).max' hne with hp
        have hpmem : p ∈ s ∪ Q := (s ∪ Q).max'_mem hne
        have hpprop : p < a ∧ ∃ i, p ∈ S i := by
          rcases Finset.mem_union.1 hpmem with h | h
          · obtain ⟨i, hi, _⟩ := hs' p h
            exact ⟨hlt p h, i, hi⟩
          · have := Finset.mem_filter.1 h
            exact ⟨Finset.mem_range.1 this.1, j, this.2⟩
        obtain ⟨hpa, i, hpi⟩ := hpprop
        have hsle : ∀ y ∈ s, y ≤ p := fun y hy => (s ∪ Q).le_max' y (Finset.mem_union_left _ hy)
        have hQcard : Q.card ≤ p + 1 := by
          have h1 : Q ⊆ Finset.range (p + 1) := fun z hz =>
            Finset.mem_range.2 (Nat.lt_succ_of_le ((s ∪ Q).le_max' z (Finset.mem_union_right _ hz)))
          simpa using Finset.card_le_card h1
        have hxX : ∑ y ∈ s, c y • e y ∈ X p := by
          refine hX p s c hsle (fun y hy => ?_)
          obtain ⟨k, _, hk⟩ := hs' y hy
          have h1 := pos_le (S k) y
          have h2 := hsle y hy
          have h3 : (pos (S k) y : ℤ) ≤ (p : ℤ) + 2 := by exact_mod_cast (show pos (S k) y ≤ p + 2 by omega)
          exact hk.trans h3
        have hcap : c a ∈ Finset.Icc (-((p : ℤ) + 2)) ((p : ℤ) + 2) := by
          have h3 : (pos (S j) a : ℤ) ≤ (p : ℤ) + 2 := by
            exact_mod_cast (show pos (S j) a ≤ p + 2 by omega)
          exact Finset.mem_Icc.2 (abs_le.1 (hca.trans h3))
        have hfpa : f j p < a := hsep i j p hpi a haS hpa
        have haC0 : a ∈ C0 j := haS.1.1.1.1
        have haSg : a ∈ Sg j p := by
          by_contra h
          exact absurd (hfbound j p a haC0 h) (not_le.2 hfpa)
        exact haSg _ hxX hx _ hcap
  rintro z ⟨s, c, hs, rfl⟩
  exact main c s hs

/-- Doubling: the sum of two small basic sets lies in a given basic set. -/
theorem exists_halved {J : Type*} (e : ℕ → G) (w : J → Ultrafilter ℕ) (hw : ∀ j a, w j ≠ pure a)
    (S : J → Set ℕ) (hS : ∀ j, S j ∈ w j) :
    ∃ S' : J → Set ℕ, (∀ j, S' j ∈ w j) ∧ ∀ x ∈ Wset e S', ∀ y ∈ Wset e S', x + y ∈ Wset e S := by
  classical
  have h : ∀ j, ∃ B' : Set ℕ, B' ∈ w j ∧ B' ⊆ S j ∧ ∀ y ∈ B', 2 * pos B' y ≤ pos (S j) y :=
    fun j => exists_thinned (hw j) (hS j)
  choose S' hmem hsub hpos using h
  refine ⟨S', hmem, ?_⟩
  rintro _ ⟨s1, c1, h1, rfl⟩ _ ⟨s2, c2, h2, rfl⟩
  refine ⟨s1 ∪ s2, fun y => (if y ∈ s1 then c1 y else 0) + (if y ∈ s2 then c2 y else 0),
    fun y hy => ?_, ?_⟩
  · have one : ∀ j (b : ℤ), y ∈ S' j → |b| ≤ 2 * (pos (S' j) y : ℤ) →
        ∃ k, y ∈ S k ∧ |b| ≤ (pos (S k) y : ℤ) := by
      intro j b hj hb
      refine ⟨j, hsub j hj, hb.trans ?_⟩
      exact_mod_cast hpos j y hj
    by_cases ha : y ∈ s1
    · obtain ⟨j1, hj1, hc1⟩ := h1 y ha
      by_cases hb : y ∈ s2
      · obtain ⟨j2, hj2, hc2⟩ := h2 y hb
        simp only [if_pos ha, if_pos hb]
        have h3 := abs_add_le (c1 y) (c2 y)
        rcases le_total (pos (S' j1) y) (pos (S' j2) y) with h | h
        · have h' : (pos (S' j1) y : ℤ) ≤ (pos (S' j2) y : ℤ) := by exact_mod_cast h
          exact one j2 _ hj2 (by omega)
        · have h' : (pos (S' j2) y : ℤ) ≤ (pos (S' j1) y : ℤ) := by exact_mod_cast h
          exact one j1 _ hj1 (by omega)
      · simp only [if_pos ha, if_neg hb, add_zero]
        exact one j1 _ hj1 (by omega)
    · have hb : y ∈ s2 := (Finset.mem_union.1 hy).resolve_left ha
      obtain ⟨j2, hj2, hc2⟩ := h2 y hb
      simp only [if_neg ha, if_pos hb, zero_add]
      exact one j2 _ hj2 (by omega)
  · have key : ∀ (t : Finset ℕ) (c : ℕ → ℤ), t ⊆ s1 ∪ s2 →
        ∑ y ∈ t, c y • e y = ∑ y ∈ s1 ∪ s2, (if y ∈ t then c y else 0) • e y := by
      intro t c ht
      have h3 : ∀ y, (if y ∈ t then c y else 0) • e y = if y ∈ t then c y • e y else 0 := by
        intro y
        split_ifs
        · rfl
        · exact zero_smul _ _
      simp only [h3]
      rw [Finset.sum_ite_mem, Finset.inter_eq_right.2 ht]
    rw [key s1 c1 Finset.subset_union_left, key s2 c2 Finset.subset_union_right, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun y _ => (add_smul _ _ _).symm)

/-- For countably many pairwise non-isomorphic selective ultrafilters, openness for the topological modification of
the PG they generate is openness for a group topology, which is therefore the finest group topology of the PG; its
neighbourhoods of `0` are the sets containing a basic set; and it separates points when every `{x | m • x = 0}`,
`m ≥ 1`, is finite. -/
theorem modification_isGroupTopology {J : Type*} [Countable J] (e : ℕ ≃ G) (u : J → Ultrafilter G)
    (hu : ∀ j, IsSel (u j)) (hiso : ∀ i j, i ≠ j → ¬ Iso (u i) (u j)) :
    ∃ t : TopologicalSpace G, @IsTopologicalAddGroup G t _ ∧
      (∀ O : Set G, IsOpen[t] O ↔ IsOpenMod (genFam (ultraGen (range u))) O) ∧
      (∀ A : Set G, A ∈ @nhds G t 0 ↔
        ∃ S : J → Set ℕ, (∀ j, S j ∈ (u j).map e.symm) ∧ Wset e S ⊆ A) ∧
      IsFinest (genFam (ultraGen (range u))) t ∧
      ((∀ m : ℕ, 0 < m → {x : G | m • x = 0}.Finite) → ∀ g : G, g ≠ 0 → ∃ A ∈ @nhds G t 0, g ∉ A) := by
  classical
  set C : Set (Filter G) := genFam (ultraGen (range u)) with hC
  have hCnull : NullFamily C := genFam_nullFamily _
  set w : J → Ultrafilter ℕ := fun j => (u j).map e.symm with hwdef
  have hmemw : ∀ j (B : Set ℕ), B ∈ w j ↔ e.symm ⁻¹' B ∈ u j := fun j B => Iff.rfl
  have hwsel : ∀ j, IsSel (w j) := by
    intro j
    refine ⟨fun a h => ?_, fun f => ?_⟩
    · have h1 : ({a} : Set ℕ) ∈ w j := by rw [h]; exact rfl
      have h2 : e.symm ⁻¹' {a} ⊆ {e a} := by
        intro x hx
        have : e.symm x = a := hx
        rw [mem_singleton_iff, ← this, Equiv.apply_symm_apply]
      exact notMem_of_finite (hu j).1 (finite_singleton (e a))
        (Filter.mem_of_superset ((hmemw j _).1 h1) h2)
    · rcases (hu j).2 (fun x => f (e.symm x)) with ⟨c, hc⟩ | ⟨D, hD, hinj⟩
      · exact Or.inl ⟨c, hc⟩
      · refine Or.inr ⟨e ⁻¹' D, ?_, fun a ha b hb hab => ?_⟩
        · refine (hmemw j _).2 (Filter.mem_of_superset hD (fun x hx => ?_))
          show e (e.symm x) ∈ D
          rwa [Equiv.apply_symm_apply]
        · have h1 : f (e.symm (e a)) = f (e.symm (e b)) := by simpa using hab
          exact e.injective (hinj ha hb h1)
  have hwiso : ∀ i j, i ≠ j → ¬ Iso (w i) (w j) := by
    rintro i j hij ⟨π, hπ⟩
    refine hiso i j hij ⟨(e.symm.trans π).trans e, ?_⟩
    have h1 := congrArg (Ultrafilter.map e) hπ
    simp only [hwdef, Ultrafilter.map_map] at h1
    have h2 : (e : ℕ → G) ∘ (e.symm : G → ℕ) = id := by funext x; simp
    rw [h2, Ultrafilter.map_id] at h1
    exact h1
  have hfree : ∀ j a, w j ≠ pure a := fun j => (hwsel j).1
  -- the neighbourhood filter
  set N : Filter G :=
    { sets := {A | ∃ S : J → Set ℕ, (∀ j, S j ∈ w j) ∧ Wset e S ⊆ A}
      univ_sets := ⟨fun _ => univ, fun _ => Filter.univ_mem, subset_univ _⟩
      sets_of_superset := by
        rintro A B ⟨S, hS, h⟩ hAB
        exact ⟨S, hS, h.trans hAB⟩
      inter_sets := by
        rintro A B ⟨S, hS, h⟩ ⟨T, hT, h'⟩
        exact ⟨fun j => S j ∩ T j, fun j => Filter.inter_mem (hS j) (hT j),
          subset_inter ((Wset_mono e (fun _ => inter_subset_left)).trans h)
            ((Wset_mono e (fun _ => inter_subset_right)).trans h')⟩ } with hNdef
  have hmemN : ∀ A, A ∈ N ↔ ∃ S : J → Set ℕ, (∀ j, S j ∈ w j) ∧ Wset e S ⊆ A := fun A => Iff.rfl
  have hN : IsNbhdFilter N := by
    refine ⟨fun A hA => ?_, fun A hA => ?_, fun A hA => ?_⟩
    · obtain ⟨S, _, h⟩ := (hmemN A).1 hA
      exact h (zero_mem_Wset _ _)
    · obtain ⟨S, hS, h⟩ := (hmemN A).1 hA
      exact (hmemN _).2 ⟨S, hS, fun x hx => h (neg_mem_Wset _ _ hx)⟩
    · obtain ⟨S, hS, h⟩ := (hmemN A).1 hA
      obtain ⟨S', hS', hadd⟩ := exists_halved e w hfree S hS
      exact ⟨Wset e S', (hmemN _).2 ⟨S', hS', subset_rfl⟩, fun x hx y hy => h (hadd x hx y hy)⟩
  obtain ⟨t, ht, hnhds⟩ := exists_topology hN
  have huN : ∀ j, (u j : Filter G) ≤ N := by
    intro j A hA
    obtain ⟨S, hS, h⟩ := (hmemN A).1 hA
    refine Filter.mem_of_superset ((hmemw j _).1 (hS j)) (fun x hx => h ?_)
    have hx' : e.symm x ∈ S j := hx
    refine ⟨{e.symm x}, fun _ => 1, fun y hy => ?_, by simp⟩
    rw [Finset.mem_singleton] at hy
    subst hy
    refine ⟨j, hx', ?_⟩
    rw [abs_one]
    exact_mod_cast one_le_pos hx'
  have hgenne : ∀ F ∈ ultraGen (range u), F.NeBot := by
    rintro F ⟨v, _, rfl⟩
    exact v.neBot
  have hgen : ∀ j, (u j : Filter G) ∈ C := fun j =>
    subset_genFam hgenne ⟨u j, mem_range_self j, rfl⟩
  -- every group topology in which the null filters converge to `0` is coarser than openness for the modification
  have hcoarse : ∀ t' : TopologicalSpace G, @IsTopologicalAddGroup G t' _ → (∀ F ∈ C, F ≤ @nhds G t' 0) →
      ∀ O : Set G, IsOpen[t'] O → IsOpenMod C O := by
    intro t' ht' hF' O hO x hx F hne hconv
    letI := t'
    haveI := ht'
    have h1 : F ≤ 𝓝 x := (le_nhds_iff_map_sub F x).2 (hF' _ hconv)
    exact h1 (hO.mem_nhds hx)
  have htC : ∀ F ∈ C, F ≤ @nhds G t 0 := by
    have h1 : ultraGen (range u) ⊆ @nullTop G t _ := by
      rintro F ⟨v, ⟨j, rfl⟩, rfl⟩
      refine ⟨(u j).neBot, ?_⟩
      rw [hnhds]; exact huN j
    have h2 : C ⊆ @nullTop G t _ := by
      letI := t
      haveI := ht
      exact genFam_le nullTop_nullFamily h1
    exact fun F hF => (h2 hF).2
  have hstable : ∀ O : Set G, (∀ x ∈ O, ∀ c : ℤ, ∀ j, {y | x + c • e y ∈ O} ∈ w j) → (0 : G) ∈ O → O ∈ N := by
    intro O hst h0
    obtain ⟨S, hS, h⟩ := exists_basic_subset e w hwsel hwiso O h0 hst
    exact (hmemN O).2 ⟨S, hS, h⟩
  have hopen_stable : ∀ O : Set G, IsOpenMod C O → ∀ x ∈ O, ∀ c : ℤ, ∀ j, {y | x + c • e y ∈ O} ∈ w j := by
    intro O hO x hx c j
    have h1 : Filter.map (fun a : G => c • a) (u j : Filter G) ∈ C := by
      refine genFam_le hCnull ?_ (map_zsmul_mem (u j : Filter G) c)
      rintro F hF
      rw [mem_singleton_iff.1 hF]
      exact hgen j
    have h2 : conv C (Filter.map (fun a : G => x + c • a) (u j : Filter G)) x := by
      unfold conv
      rw [Filter.map_map]
      have : ((fun y : G => y - x) ∘ fun a : G => x + c • a) = fun a : G => c • a := by
        funext a; simp
      rw [this]; exact h1
    have h3 := hO x hx _ (Filter.NeBot.map inferInstance _) h2
    have h4 : {a : G | x + c • a ∈ O} ∈ u j := h3
    refine (hmemw j _).2 (Filter.mem_of_superset h4 (fun a ha => ?_))
    show x + c • e (e.symm a) ∈ O
    rw [Equiv.apply_symm_apply]; exact ha
  have hopen : ∀ O : Set G, IsOpen[t] O ↔ IsOpenMod C O := by
    intro O
    refine ⟨hcoarse t ht htC O, fun hO => ?_⟩
    letI := t
    haveI := ht
    rw [isOpen_iff_mem_nhds]
    intro x hx
    set O' : Set G := (fun a => x + a) ⁻¹' O with hO'
    have h0 : (0 : G) ∈ O' := by
      show x + 0 ∈ O
      rwa [add_zero]
    have hst : ∀ z ∈ O', ∀ c : ℤ, ∀ j, {y | z + c • e y ∈ O'} ∈ w j := by
      intro z hz c j
      have h1 := hopen_stable O hO (x + z) hz c j
      refine Filter.mem_of_superset h1 (fun y hy => ?_)
      show x + (z + c • e y) ∈ O
      rw [← add_assoc]; exact hy
    have h1 : O' ∈ 𝓝 (0 : G) := by
      rw [hnhds]; exact hstable O' hst h0
    have h2 := (Homeomorph.addLeft x).map_nhds_eq (0 : G)
    have h3 : Filter.map (fun a => x + a) (𝓝 (0 : G)) = 𝓝 x := by simpa using h2
    rw [← h3]
    exact h1
  refine ⟨t, ht, hopen, fun A => ?_, ⟨⟨ht, htC⟩, fun t' ht' => ?_⟩, fun htor g hg => ?_⟩
  · rw [hnhds]; exact hmemN A
  · obtain ⟨ht'g, ht'F⟩ := ht'
    refine @Continuous.mk G G t t' id (fun O hO => ?_)
    exact (hopen O).2 (hcoarse t' ht'g ht'F O hO)
  · have hst : ∀ x ∈ ({g}ᶜ : Set G), ∀ c : ℤ, ∀ j, {y | x + c • e y ∈ ({g}ᶜ : Set G)} ∈ w j := by
      intro x hx c j
      have hxg : x ≠ g := hx
      have hfin : {a : G | x + c • a = g}.Finite := by
        by_cases hc : c = 0
        · refine (finite_empty).subset (fun a ha => ?_)
          have h1 : x + c • a = g := ha
          rw [hc, zero_smul, add_zero] at h1
          exact (hxg h1).elim
        · by_cases hne : {a : G | x + c • a = g}.Nonempty
          · obtain ⟨a0, ha0⟩ := hne
            have hker := htor c.natAbs (Int.natAbs_pos.2 hc)
            refine (hker.image (fun k => a0 + k)).subset (fun a ha => ?_)
            refine ⟨a - a0, ?_, by abel⟩
            have h1 : c • (a - a0) = 0 := by
              have h2 : x + c • a = x + c • a0 := ha.trans ha0.symm
              rw [smul_sub, add_left_cancel h2, sub_self]
            show c.natAbs • (a - a0) = 0
            rcases Int.natAbs_eq c with h | h
            · rw [h, natCast_zsmul] at h1; exact h1
            · rw [h, neg_smul, neg_eq_zero, natCast_zsmul] at h1; exact h1
          · rw [not_nonempty_iff_eq_empty] at hne
            rw [hne]; exact finite_empty
      have h1 : {a : G | x + c • a = g}ᶜ ∈ u j := by
        rcases (u j).mem_or_compl_mem {a : G | x + c • a = g} with h | h
        · exact absurd h (notMem_of_finite (hu j).1 hfin)
        · exact h
      refine (hmemw j _).2 (Filter.mem_of_superset h1 (fun a ha => ?_))
      show x + c • e (e.symm a) ∈ ({g}ᶜ : Set G)
      rw [Equiv.apply_symm_apply]; exact ha
    have h0 : (0 : G) ∈ ({g}ᶜ : Set G) := fun h => hg (mem_singleton_iff.1 h).symm
    refine ⟨{g}ᶜ, ?_, fun h => h rfl⟩
    rw [hnhds]; exact hstable _ hst h0

end Modification

section Integers

/-- A selective ultrafilter on `ℤ` containing the positive integers contains every tail of the finite sums of a rapidly
growing sequence. -/
theorem exists_sparse_of_selective (u : Ultrafilter ℤ) (hu : IsSel u) (hP : {x : ℤ | 0 < x} ∈ u) :
    ∃ y : ℕ → ℤ, (∀ i, 0 < y i) ∧
      (∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l) ∧
      ∀ m : ℕ, FSset y m ∈ (u : Filter ℤ) := by
  classical
  -- blocks `[t k, t (k + 1))`
  let t : ℕ → ℕ := fun n => Nat.rec 1 (fun m s => (2 * (m * m) + 2) * s) n
  have ht0 : t 0 = 1 := rfl
  have htsucc : ∀ m, t (m + 1) = (2 * (m * m) + 2) * t m := fun m => rfl
  have htpos : ∀ m, 0 < t m := by
    intro m
    induction m with
    | zero => rw [ht0]; exact Nat.one_pos
    | succ m ih => rw [htsucc]; exact Nat.mul_pos (Nat.succ_pos _) ih
  have htmono : StrictMono t := strictMono_nat_of_lt_succ (fun m => by
    rw [htsucc]
    have h1 := htpos m
    have h2 : 2 * t m ≤ (2 * (m * m) + 2) * t m := Nat.mul_le_mul_right _ (by omega)
    omega)
  have hex : ∀ n : ℕ, ∃ k : ℕ, n < t (k + 1) := fun n =>
    ⟨n, Nat.lt_of_lt_of_le (Nat.lt_succ_self n) (htmono.id_le (n + 1))⟩
  let k : ℕ → ℕ := fun n => sInf {m : ℕ | n < t (m + 1)}
  have hku : ∀ n, n < t (k n + 1) := fun n => Nat.sInf_mem (s := {m : ℕ | n < t (m + 1)}) (hex n)
  have hkl : ∀ n, 0 < n → t (k n) ≤ n := by
    intro n hn
    rcases Nat.eq_zero_or_pos (k n) with h | h
    · rw [h, ht0]; exact hn
    · have h1 : k n - 1 ∉ {m : ℕ | n < t (m + 1)} := Nat.notMem_of_lt_sInf (show k n - 1 < k n by omega)
      have h2 : k n - 1 + 1 = k n := by omega
      have h3 : ¬ n < t (k n - 1 + 1) := h1
      rw [h2] at h3
      omega
  have hkmono : Monotone k := fun a b hab => Nat.sInf_le (show a < t (k b + 1) from lt_of_le_of_lt hab (hku b))
  -- one element per block on a member of `u`
  let h : ℤ → ℕ := fun x => k x.toNat
  have hfree : ∀ s : Set ℤ, s.Finite → s ∉ u := fun s hs => notMem_of_finite hu.1 hs
  have hinj : ∃ D ∈ u, InjOn h D := by
    rcases hu.2 h with ⟨c, hc⟩ | hD
    · exfalso
      refine hfree _ ((finite_Ioo (0 : ℤ) (t (c + 1) : ℤ)).subset ?_) (Filter.inter_mem hc hP)
      rintro x ⟨hx, hx0⟩
      have h1 : k x.toNat = c := hx
      have h2 := hku x.toNat
      rw [h1] at h2
      have h3 : (0 : ℤ) < x := hx0
      exact ⟨h3, by omega⟩
    · exact hD
  obtain ⟨D, hD, hDinj⟩ := hinj
  have hpar : ∃ r : ℕ, {x : ℤ | h x % 2 = r} ∈ u := by
    rcases u.mem_or_compl_mem {x : ℤ | h x % 2 = 0} with h1 | h1
    · exact ⟨0, h1⟩
    · refine ⟨1, Filter.mem_of_superset h1 (fun x hx => ?_)⟩
      have : ¬ h x % 2 = 0 := hx
      show h x % 2 = 1
      omega
  obtain ⟨r, hr⟩ := hpar
  set Y : Set ℤ := D ∩ {x : ℤ | h x % 2 = r} ∩ {x : ℤ | 0 < x} with hY
  have hYmem : Y ∈ u := Filter.inter_mem (Filter.inter_mem hD hr) hP
  set Z : Set ℕ := {n : ℕ | (n : ℤ) ∈ Y} with hZ
  have hZinf : Z.Infinite := by
    intro hfin
    refine hfree Y ((hfin.image (fun n : ℕ => (n : ℤ))).subset (fun x hx => ?_)) hYmem
    have h1 : (0 : ℤ) < x := hx.2
    have h2 : (x.toNat : ℤ) = x := Int.toNat_of_nonneg h1.le
    refine ⟨x.toNat, ?_, h2⟩
    show (x.toNat : ℤ) ∈ Y
    rw [h2]; exact hx
  set z : ℕ → ℕ := Nat.nth (· ∈ Z) with hz
  have hzmem : ∀ i, (z i : ℤ) ∈ Y := fun i => Nat.nth_mem_of_infinite hZinf i
  have hzmono : StrictMono z := Nat.nth_strictMono hZinf
  have hzpos : ∀ i, 0 < z i := by
    intro i
    have h1 : (0 : ℤ) < (z i : ℤ) := (hzmem i).2
    exact_mod_cast h1
  have hkstep : ∀ i, k (z i) + 2 ≤ k (z (i + 1)) := by
    intro i
    have hlt : z i < z (i + 1) := hzmono (Nat.lt_succ_self i)
    have h1 : k (z i) ≤ k (z (i + 1)) := hkmono hlt.le
    have h2 : k (z i) ≠ k (z (i + 1)) := by
      intro heq
      have h3 : h (z i : ℤ) = h (z (i + 1) : ℤ) := by
        show k (z i : ℤ).toNat = k (z (i + 1) : ℤ).toNat
        rw [Int.toNat_natCast, Int.toNat_natCast]; exact heq
      have h4 := hDinj (hzmem i).1.1 (hzmem (i + 1)).1.1 h3
      have h5 : z i = z (i + 1) := by exact_mod_cast h4
      omega
    have h6 : h (z i : ℤ) % 2 = r := (hzmem i).1.2
    have h7 : h (z (i + 1) : ℤ) % 2 = r := (hzmem (i + 1)).1.2
    have h8 : k (z i) % 2 = r := by simpa [h] using h6
    have h9 : k (z (i + 1)) % 2 = r := by simpa [h] using h7
    omega
  have hkge : ∀ i, i ≤ k (z i) := by
    intro i
    induction i with
    | zero => exact Nat.zero_le _
    | succ i ih => have := hkstep i; omega
  refine ⟨fun i => (z i : ℤ), fun i => (hzmem i).2, fun B => ⟨B, fun l hl => ?_⟩, fun m => ?_⟩
  · obtain ⟨p, rfl⟩ : ∃ p, l = p + 1 := ⟨l - 1, by omega⟩
    set K := k (z p) + 1 with hK
    have hpK : p + 1 ≤ K := by have := hkge p; omega
    have hsum : ∑ i ∈ Finset.range (p + 1), z i ≤ K * t K := by
      have h1 : ∀ i ∈ Finset.range (p + 1), z i ≤ t K := by
        intro i hi
        have h2 : z i ≤ z p := hzmono.monotone (Nat.le_of_lt_succ (Finset.mem_range.1 hi))
        have h3 : z p < t K := hku (z p)
        omega
      have h4 := Finset.sum_le_card_nsmul (Finset.range (p + 1)) z (t K) h1
      rw [Finset.card_range, smul_eq_mul] at h4
      exact h4.trans (Nat.mul_le_mul_right _ hpK)
    have hnext : t (K + 1) ≤ z (p + 1) := by
      have h1 := hkstep p
      have h2 : K + 1 ≤ k (z (p + 1)) := by omega
      exact (htmono.monotone h2).trans (hkl _ (hzpos _))
    have hfinal : 2 * B * ∑ i ∈ Finset.range (p + 1), z i < z (p + 1) := by
      have h1 : 2 * B * ∑ i ∈ Finset.range (p + 1), z i ≤ 2 * B * (K * t K) := Nat.mul_le_mul_left _ hsum
      have h2 : 2 * B * (K * t K) = (2 * (B * K)) * t K := by ring
      have h3 : B * K ≤ K * K := Nat.mul_le_mul_right _ (by omega)
      have h4 : (2 * (B * K)) * t K < (2 * (K * K) + 2) * t K :=
        Nat.mul_lt_mul_of_pos_right (by omega) (htpos K)
      rw [htsucc] at hnext
      omega
    show 2 * (B : ℤ) * ∑ i ∈ Finset.range (p + 1), (z i : ℤ) < (z (p + 1) : ℤ)
    exact_mod_cast hfinal
  · have h1 : Y \ ((fun i => (z i : ℤ)) '' Iic m) ∈ u :=
      Filter.inter_mem hYmem (by
        rcases u.mem_or_compl_mem ((fun i => (z i : ℤ)) '' Iic m) with h | h
        · exact absurd h (hfree _ ((finite_Iic m).image _))
        · exact h)
    refine Filter.mem_of_superset h1 (fun x hx => ?_)
    obtain ⟨hxY, hxm⟩ := hx
    have h2 : (0 : ℤ) < x := hxY.2
    have h3 : (x.toNat : ℤ) = x := Int.toNat_of_nonneg h2.le
    have h4 : x.toNat ∈ Z := by
      show (x.toNat : ℤ) ∈ Y
      rw [h3]; exact hxY
    obtain ⟨i, _, hi⟩ := Nat.exists_lt_card_nth_eq h4
    have h5 : (z i : ℤ) = x := by
      have h6 : z i = x.toNat := hi
      rw [h6]; exact h3
    have hmi : m < i := by
      by_contra hle
      exact hxm ⟨i, mem_Iic.2 (not_lt.1 hle), h5⟩
    refine ⟨{i}, Finset.singleton_nonempty i, fun j hj => ?_, by simp [h5]⟩
    rw [Finset.mem_singleton] at hj
    rw [hj]; exact hmi

/-- For a selective ultrafilter `u` on `ℤ` the topological modification of the PG generated by `u` is the finest group
topology and is Hausdorff, while the vicinity filter is strictly smaller than the filter of its neighbourhoods of `0`:
some vicinity set is no neighbourhood of `0`. -/
theorem selective_int_strict (u : Ultrafilter ℤ) (hu : IsSel u) :
    ∃ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ ∧
      (∀ O : Set ℤ, IsOpen[t] O ↔ IsOpenMod (genFam (ultraGen {u})) O) ∧
      IsFinest (genFam (ultraGen ({u} : Set (Ultrafilter ℤ)))) t ∧
      (∀ g : ℤ, g ≠ 0 → ∃ A ∈ @nhds ℤ t 0, g ∉ A) ∧
      vic (genFam (ultraGen ({u} : Set (Ultrafilter ℤ)))) ≤ @nhds ℤ t 0 ∧
      ¬ @nhds ℤ t 0 ≤ vic (genFam (ultraGen ({u} : Set (Ultrafilter ℤ)))) ∧
      ∃ A ∈ vic (genFam (ultraGen ({u} : Set (Ultrafilter ℤ)))), A ∉ @nhds ℤ t 0 ∧
        ∀ B ∈ vic (genFam (ultraGen ({u} : Set (Ultrafilter ℤ)))), ¬ ∀ a ∈ B, ∀ b ∈ B, a + b ∈ A := by
  classical
  set C := genFam (ultraGen ({u} : Set (Ultrafilter ℤ))) with hCdef
  have hCnull : NullFamily C := genFam_nullFamily _
  have hrange : range (fun _ : Unit => u) = {u} := range_const
  obtain ⟨t, ht, hopen, _, hfin, hsepar⟩ :=
    modification_isGroupTopology (G := ℤ) (J := Unit) Equiv.intEquivNat.symm (fun _ => u) (fun _ => hu)
      (fun i j hij => absurd (Subsingleton.elim i j) hij)
  rw [hrange] at hopen hfin
  have htor : ∀ m : ℕ, 0 < m → {x : ℤ | m • x = 0}.Finite := by
    intro m hm
    refine (finite_singleton (0 : ℤ)).subset (fun x hx => ?_)
    have h1 : (m : ℤ) * x = 0 := by
      have h2 : m • x = 0 := hx
      rwa [nsmul_eq_mul] at h2
    rcases mul_eq_zero.1 h1 with h | h
    · omega
    · exact h
  -- a copy `v` of `u` or of `-u` containing the positive integers, generating the same PG
  have hv : ∃ v : Ultrafilter ℤ, IsSel v ∧ {x : ℤ | 0 < x} ∈ v ∧ genFam (ultraGen ({v} : Set (Ultrafilter ℤ))) = C := by
    rcases u.mem_or_compl_mem {x : ℤ | 0 < x} with h | h
    · exact ⟨u, hu, h, rfl⟩
    · set v := u.map (fun x : ℤ => -x) with hvdef
      have hneg : {x : ℤ | x < 0} ∈ u := by
        have h0 : ({0} : Set ℤ)ᶜ ∈ u := by
          rcases u.mem_or_compl_mem ({0} : Set ℤ) with h1 | h1
          · exact absurd h1 (notMem_of_finite hu.1 (finite_singleton 0))
          · exact h1
        refine Filter.mem_of_superset (Filter.inter_mem h h0) (fun x hx => ?_)
        have h1 : ¬ 0 < x := hx.1
        have h2 : x ≠ 0 := hx.2
        show x < 0
        omega
      have hvv : v.map (fun x : ℤ => -x) = u := by
        rw [hvdef, Ultrafilter.map_map, neg_neg_fun, Ultrafilter.map_id]
      have hvsel : IsSel v := by
        refine ⟨fun a ha => ?_, fun f => ?_⟩
        · have h1 : u = pure (-a) := by
            rw [← hvv, ha, Ultrafilter.map_pure]
          exact hu.1 _ h1
        · rcases hu.2 (fun x => f (-x)) with ⟨c, hc⟩ | ⟨D, hD, hinj⟩
          · exact Or.inl ⟨c, hc⟩
          · refine Or.inr ⟨(fun x : ℤ => -x) ⁻¹' D, ?_, fun a ha b hb hab => ?_⟩
            · show (fun x : ℤ => -x) ⁻¹' ((fun x : ℤ => -x) ⁻¹' D) ∈ u
              simpa [Set.preimage_preimage] using hD
            · exact neg_injective (hinj (x₁ := -a) (x₂ := -b) ha hb (show f (- -a) = f (- -b) by rw [neg_neg, neg_neg]; exact hab))
      have hvpos : {x : ℤ | 0 < x} ∈ v := by
        show (fun x : ℤ => -x) ⁻¹' {x : ℤ | 0 < x} ∈ u
        refine Filter.mem_of_superset hneg (fun x hx => ?_)
        have : x < 0 := hx
        show 0 < -x
        omega
      refine ⟨v, hvsel, hvpos, Set.Subset.antisymm ?_ ?_⟩
      · refine genFam_le hCnull ?_
        rintro F ⟨w, hw, rfl⟩
        rw [mem_singleton_iff.1 hw, hvdef, Ultrafilter.coe_map]
        refine hCnull.neg _ (subset_genFam ?_ ⟨u, rfl, rfl⟩)
        rintro F ⟨w', _, rfl⟩
        exact w'.neBot
      · refine genFam_le (genFam_nullFamily _) ?_
        rintro F ⟨w, hw, rfl⟩
        rw [mem_singleton_iff.1 hw, ← hvv, Ultrafilter.coe_map]
        refine (genFam_nullFamily _).neg _ (subset_genFam ?_ ⟨v, rfl, rfl⟩)
        rintro F ⟨w', _, rfl⟩
        exact w'.neBot
  obtain ⟨v, hvsel, hvpos, hvC⟩ := hv
  obtain ⟨y, hypos, hygrow, hytail⟩ := exists_sparse_of_selective v hvsel hvpos
  obtain ⟨_, A, hA, hAopen, hAhalf, _⟩ := PG.Sparse.sparse_strict y v hypos hygrow hytail
  rw [hvC] at hA hAopen hAhalf
  have hAn : A ∉ @nhds ℤ t 0 := by
    intro h
    letI := t
    obtain ⟨O, hOA, hO, h0⟩ := mem_nhds_iff.1 h
    exact hAopen O hOA h0 ((hopen O).1 hO)
  refine ⟨t, ht, hopen, hfin, hsepar htor, vic_le_nhds hfin.1.2, fun h => hAn (h hA), A, hA, hAn, hAhalf⟩

