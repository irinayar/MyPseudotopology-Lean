import LeanCheck.ChainComp5

/-!
# Completion of the Bohr-type topologies `θ_S` and of `θ_ℚ`
(TVGQ-v7, Section on precompact TVGQ topologies: `Comp(ℝ, θ_ℚ) ≅ K_ℚ`)

For a rational subspace `S ⊆ ℝ`, the topology `θ_S` generated by the characters `p(a x)`, `a ∈ S`, has
completion `K_S` via `x ↦ (a ↦ p(a x))`.  For `S = ℚ` this is `θ_ℚ` (`thetaQ`).  Density is again Kronecker's
theorem.
-/

namespace LeanCheck

open Filter Topology

lemma circ_char_zero (c : ℝ) (h : ∀ x : ℝ, ((c * x : ℝ) : Circ) = 0) : c = 0 := by
  by_contra hc
  have := h (1 / (2 * c))
  rw [show c * (1 / (2 * c)) = 1 / 2 by field_simp] at this
  rw [AddCircle.coe_eq_zero_iff] at this
  obtain ⟨n, hn⟩ := this
  simp only [zsmul_eq_mul, mul_one] at hn
  have h1 : (2 : ℝ) * n = 1 := by linarith
  have h2 : (2 : ℤ) * n = 1 := by exact_mod_cast h1
  omega

/-- `e_S(x)(a) = p(a x)` for `a ∈ S`. -/
noncomputable def eS (S : Submodule ℚ ℝ) : ℝ →+ PD S where
  toFun x := AddMonoidHom.mk' (fun a : S => (((a : ℝ) * x : ℝ) : Circ)) (fun a b => by
    simp only [Submodule.coe_add, add_mul]
    exact AddCircle.coe_add (𝕜 := ℝ) (p := (1 : ℝ)) _ _)
  map_zero' := by ext a; simp
  map_add' x y := by
    ext a
    simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply, mul_add]
    exact AddCircle.coe_add (𝕜 := ℝ) (p := (1 : ℝ)) _ _

lemma eS_apply (S : Submodule ℚ ℝ) (x : ℝ) (a : S) : eS S x a = (((a : ℝ) * x : ℝ) : Circ) := rfl

/-- The topology `θ_S` generated by the characters `p(a ·)`, `a ∈ S`. -/
noncomputable def thetaS (S : Submodule ℚ ℝ) : TopologicalSpace ℝ :=
  ⨅ a : S, TopologicalSpace.induced (fun x : ℝ => (((a : ℝ) * x : ℝ) : Circ)) circTop

theorem eS_inducing (S : Submodule ℚ ℝ) : @IsInducing ℝ (PD S) (thetaS S) _ (eS S) := by
  refine @IsInducing.mk ℝ (PD S) (thetaS S) _ _ ?_
  show thetaS S = TopologicalSpace.induced (eS S) (TopologicalSpace.induced pdFun inferInstance)
  rw [induced_compose]
  show thetaS S = TopologicalSpace.induced (fun x a => eS S x a) (Pi.topologicalSpace)
  rw [Pi.topologicalSpace, induced_iInf]
  refine iInf_congr fun a => ?_
  rw [induced_compose]
  rfl

theorem eS_denseRange (S : Submodule ℚ ℝ) : DenseRange (eS S) := by
  classical
  refine dense_iff_inter_open.2 (fun U hU ⟨φ, hφ⟩ => ?_)
  obtain ⟨F, t, ht, hsub⟩ := pd_basic_open φ U hU hφ
  let Ψ : ℝ →+ ({a // a ∈ F} → Circ) :=
    { toFun := fun x a => eS S x a.1
      map_zero' := by funext a; simp
      map_add' := by intro x y; funext a; simp }
  let s0 : {a // a ∈ F} → Circ := fun a => φ a.1
  have hs0 : ∀ k : {a // a ∈ F} → ℤ, (∀ x, skT k (Ψ x) = 0) → skT k s0 = 0 := by
    intro k hk
    let c : S := ∑ a : {a // a ∈ F}, k a • a.1
    have hΨ : ∀ x, skT k (Ψ x) = eS S x c := by
      intro x
      simp only [skT, Ψ, AddMonoidHom.coe_mk, ZeroHom.coe_mk, c, map_sum, map_zsmul]
    have hc : ((c : S) : ℝ) = 0 := by
      apply circ_char_zero
      intro x
      have := hk x
      rw [hΨ] at this
      rw [← eS_apply]; exact this
    have hc0 : c = 0 := Subtype.ext hc
    have : skT k s0 = φ c := by simp only [skT, s0, c, map_sum, map_zsmul]
    rw [this, hc0, map_zero]
  have hcl : s0 ∈ closure (Set.range Ψ) := kronecker_range Ψ s0 hs0
  let O : Set ({a // a ∈ F} → Circ) := Set.pi Set.univ (fun a => t a.1)
  have hO : IsOpen O := isOpen_set_pi Set.finite_univ (fun a _ => (ht a.1 a.2).1)
  have hs0O : s0 ∈ O := fun a _ => (ht a.1 a.2).2
  obtain ⟨y, hyO, x, rfl⟩ := mem_closure_iff.1 hcl O hO hs0O
  exact ⟨eS S x, hsub _ (fun a ha => hyO ⟨a, ha⟩ (Set.mem_univ _)), x, rfl⟩

/-- **Completion of `θ_S`**: `Comp(ℝ, θ_S) ≅ K_S`. -/
theorem completion_thetaS (S : Submodule ℚ ℝ) :
    @IsInducing ℝ (PD S) (thetaS S) _ (eS S) ∧ DenseRange (eS S) ∧ CompactSpace (PD S) ∧
      CompleteSpace (PD S) :=
  ⟨eS_inducing S, eS_denseRange S, inferInstance, inferInstance⟩

/-- `θ_ℚ` is `θ_S` for `S = ℚ`. -/
theorem thetaQ_eq_thetaS : thetaQ = thetaS ratSub := by
  unfold thetaQ theta thetaS
  apply le_antisymm
  · refine le_iInf fun a => ?_
    obtain ⟨q, hq⟩ := (mem_ratSub (a : ℝ)).1 a.2
    refine iInf_le_of_le ⟨cmulHom (q : ℝ), ⟨q, fun x => by simp [cmulHom_apply]⟩⟩ ?_
    have : (fun x : ℝ => (((a : ℝ) * x : ℝ) : Circ)) = ⇑(cmulHom (q : ℝ)) := by
      funext x; rw [hq]; simp [cmulHom_apply]
    rw [this]
    exact le_rfl
  · refine le_iInf fun χ => ?_
    obtain ⟨q, hq⟩ := χ.2
    refine iInf_le_of_le ⟨(q : ℝ), (mem_ratSub _).2 ⟨q, rfl⟩⟩ ?_
    have : (fun x : ℝ => (((q : ℝ) * x : ℝ) : Circ)) = ⇑(χ : Chars) := by
      funext x; rw [hq x]
    simp only [this]
    exact le_rfl

/-- **`Comp(ℝ, θ_ℚ) ≅ K_ℚ`**. -/
theorem completion_thetaQ :
    @IsInducing ℝ (PD ratSub) thetaQ _ (eS ratSub) ∧ DenseRange (eS ratSub) ∧
      CompactSpace (PD ratSub) ∧ CompleteSpace (PD ratSub) := by
  rw [thetaQ_eq_thetaS]; exact completion_thetaS ratSub

end LeanCheck
