import Mathlib
import LeanCheck.PGThreeFamilies

/-!
# PGfour: sums of copies of an ultrafilter

`y` is a rapidly growing sequence of positive integers, `v` a nonprincipal ultrafilter on
`ℕ`, and `sumU y v k` is the sum, in the sense of ultrafilters, of `k` copies of the image
of `v` under `y`.

* `terms_mem` : the sums of `k` terms `y i` with `i > M` form a member;
* `exists_terms` : every member contains a sum of `k` terms with indices in a given member of
  `v`;
* `exists_open_not_nhds` : for `k ≥ 2` there is a set containing `0`, open for the
  topological modification of the PG generated by `sumU y v k`, that is a neighbourhood of
  `0` in no group topology in which this ultrafilter converges to `0`;
* `not_isGroupTopology` : hence openness for the modification is not openness for a group
  topology.

No set-theoretic axiom is used, and `v` is arbitrary. A Lean proof verifies its formal
statement under its hypotheses; the correspondence with the article requires mathematical
review.
-/

open Filter Set Topology

namespace PG

namespace Sums

variable (y : ℕ → ℤ) (v : Ultrafilter ℕ)

/-- The sum of `k` copies of the image of `v` under `y`. -/
noncomputable def sumU : ℕ → Ultrafilter ℤ
  | 0 => pure 0
  | k + 1 => (sumU k).bind (fun z => v.map (fun n => z + y n))

theorem mem_sumU_succ (k : ℕ) (A : Set ℤ) :
    A ∈ sumU y v (k + 1) ↔ {z : ℤ | {n | z + y n ∈ A} ∈ v} ∈ sumU y v k := Iff.rfl

/-- The sums of `k` different terms with indices above `M`. -/
def H (k M : ℕ) : Set ℤ :=
  {z | ∃ s : Finset ℕ, s.card = k ∧ (∀ i ∈ s, M < i) ∧ z = ∑ i ∈ s, y i}

theorem above_mem (hv : ∀ a, v ≠ pure a) (M : ℕ) : {n : ℕ | M < n} ∈ v := by
  rcases v.mem_or_compl_mem {n : ℕ | M < n} with h | h
  · exact h
  · refine absurd h (Sel.notMem_of_finite hv ((finite_Iic M).subset (fun n hn => ?_)))
    exact mem_Iic.2 (not_lt.1 (fun c => hn c))

theorem terms_mem (hv : ∀ a, v ≠ pure a) (k M : ℕ) : H y k M ∈ sumU y v k := by
  classical
  induction k with
  | zero =>
    show H y 0 M ∈ (pure 0 : Ultrafilter ℤ)
    exact Ultrafilter.mem_pure.2 ⟨∅, rfl, by simp, by simp⟩
  | succ k ih =>
    rw [mem_sumU_succ]
    refine Filter.mem_of_superset (show _ ∈ (sumU y v k : Filter ℤ) from ih) (fun z hz => ?_)
    obtain ⟨s, hs, hsM, rfl⟩ := hz
    refine Filter.mem_of_superset (above_mem v hv (max M (s.sup id))) (fun n hn => ?_)
    have h1 : max M (s.sup id) < n := hn
    have hns : n ∉ s := fun h => by
      have : n ≤ s.sup id := Finset.le_sup (f := id) h
      omega
    refine ⟨insert n s, by rw [Finset.card_insert_of_notMem hns, hs], fun i hi => ?_, ?_⟩
    · rcases Finset.mem_insert.1 hi with h | h
      · omega
      · exact hsM i h
    · rw [Finset.sum_insert hns, add_comm]

theorem exists_terms (hv : ∀ a, v ≠ pure a) (F : Set ℕ) (hF : F ∈ v) (k : ℕ) :
    ∀ A ∈ sumU y v k, ∃ s : Finset ℕ, s.card = k ∧ (∀ i ∈ s, i ∈ F) ∧ (∑ i ∈ s, y i) ∈ A := by
  classical
  induction k with
  | zero =>
    intro A hA
    have h0 : (0 : ℤ) ∈ A := Ultrafilter.mem_pure.1 hA
    exact ⟨∅, rfl, by simp, by simpa using h0⟩
  | succ k ih =>
    intro A hA
    rw [mem_sumU_succ] at hA
    obtain ⟨s, hs, hsF, hsA⟩ := ih _ hA
    have h1 : {n | (∑ i ∈ s, y i) + y n ∈ A} ∈ v := hsA
    obtain ⟨n, ⟨hn1, hn2⟩, hn3⟩ := Ultrafilter.nonempty_of_mem
      (Filter.inter_mem (Filter.inter_mem (f := (v : Filter ℕ)) h1 hF) (above_mem v hv (s.sup id)))
    have hns : n ∉ s := fun h => by
      have h2 : n ≤ s.sup id := Finset.le_sup (f := id) h
      have h3 : s.sup id < n := hn3
      omega
    refine ⟨insert n s, by rw [Finset.card_insert_of_notMem hns, hs], fun i hi => ?_, ?_⟩
    · rcases Finset.mem_insert.1 hi with h | h
      · rw [h]; exact hn2
      · exact hsF i h
    · rw [Finset.sum_insert hns, add_comm]
      exact hn1

/-- The sum of the coefficients. -/
noncomputable def aug (c : ℕ →₀ ℤ) : ℤ := c.sum (fun _ a => a)

theorem aug_add (c d : ℕ →₀ ℤ) : aug (c + d) = aug c + aug d := by
  unfold aug
  exact Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl)

theorem aug_single (i : ℕ) (a : ℤ) : aug (Finsupp.single i a) = a := by
  unfold aug
  rw [Finsupp.sum_single_index rfl]

theorem aug_zero : aug 0 = 0 := by simp [aug]

theorem aug_sum {ι : Type*} (s : Finset ι) (c : ι → ℕ →₀ ℤ) : aug (∑ i ∈ s, c i) = ∑ i ∈ s, aug (c i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [aug_zero]
  | insert i s hi ih => rw [Finset.sum_insert hi, Finset.sum_insert hi, aug_add, ih]

theorem aug_smul (a : ℤ) (c : ℕ →₀ ℤ) : aug (a • c) = a * aug c := by
  classical
  induction c using Finsupp.induction_linear with
  | zero => simp [aug_zero]
  | add f g hf hg => rw [smul_add, aug_add, aug_add, hf, hg, mul_add]
  | single i b => rw [Finsupp.smul_single, aug_single, aug_single, smul_eq_mul]

theorem aug_ind (s : Finset ℕ) : aug (Sparse.ind s) = s.card := by
  unfold Sparse.ind
  rw [aug_sum]
  simp [aug_single]

theorem val_smul (a : ℤ) (c : ℕ →₀ ℤ) : Sparse.val y (a • c) = a * Sparse.val y c := by
  classical
  induction c using Finsupp.induction_linear with
  | zero => simp [Sparse.val_zero]
  | add f g hf hg => rw [smul_add, Sparse.val_add, Sparse.val_add, hf, hg, mul_add]
  | single i b =>
    rw [Finsupp.smul_single]
    unfold Sparse.val
    rw [Finsupp.sum_single_index (zero_mul _), Finsupp.sum_single_index (zero_mul _), smul_eq_mul, mul_assoc]

theorem val_single (i : ℕ) (a : ℤ) : Sparse.val y (Finsupp.single i a) = a * y i := by
  unfold Sparse.val
  rw [Finsupp.sum_single_index (zero_mul _)]

/-- A signed sum of `r` sums of `k` terms above `M`, as a coefficient vector. -/
theorem vector_of_sum {ι : Type*} [Fintype ι] (k M : ℕ) (ε : ι → ℤ) (hε : ∀ i, ε i = 1 ∨ ε i = -1)
    (a : ι → ℤ) (ha : ∀ i, a i ∈ H y k M) :
    ∃ σ : ℕ →₀ ℤ, Sparse.val y σ = ∑ i, ε i • a i ∧ (∀ l, |σ l| ≤ (Fintype.card ι : ℤ)) ∧
      (∀ l, σ l ≠ 0 → M < l) ∧ (k : ℤ) ∣ aug σ := by
  classical
  choose s hs hsM hsa using ha
  refine ⟨∑ i, ε i • Sparse.ind (s i), ?_, fun l => ?_, fun l hl => ?_, ?_⟩
  · rw [Sparse.val_finset_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [val_smul, Sparse.val_ind, ← hsa i, smul_eq_mul]
  · rw [Finsupp.finsetSum_apply]
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    have h1 : ∀ i ∈ Finset.univ, |(ε i • Sparse.ind (s i)) l| ≤ 1 := by
      intro i _
      rw [Finsupp.smul_apply, Sparse.ind_apply, smul_eq_mul]
      rcases hε i with h | h <;> rw [h] <;> split_ifs <;> simp
    refine (Finset.sum_le_sum h1).trans ?_
    simp
  · by_contra hc
    refine hl ?_
    rw [Finsupp.finsetSum_apply]
    refine Finset.sum_eq_zero (fun i _ => ?_)
    rw [Finsupp.smul_apply, Sparse.ind_apply, if_neg (fun h => hc (hsM i l h)), smul_zero]
  · rw [aug_sum]
    refine Finset.dvd_sum (fun i _ => ?_)
    rw [aug_smul, aug_ind, hs i]
    exact dvd_mul_left _ _

/-- Sums of at most `L` small elements stay in a given neighbourhood. -/
theorem few_small (t : TopologicalSpace ℤ) (ht : @IsTopologicalAddGroup ℤ t _) (L : ℕ) :
    ∀ N : Set ℤ, N ∈ @nhds ℤ t 0 → ∃ V ∈ @nhds ℤ t 0, (∀ x ∈ V, -x ∈ V) ∧
      ∀ s : Finset ℕ, s.card ≤ L → ∀ z : ℕ → ℤ, (∀ i ∈ s, z i ∈ V) → ∑ i ∈ s, z i ∈ N := by
  classical
  letI := t
  haveI := ht
  have sym : ∀ V : Set ℤ, V ∈ 𝓝 (0 : ℤ) → V ∩ (fun x => -x) ⁻¹' V ∈ 𝓝 (0 : ℤ) := by
    intro V hV
    refine inter_mem hV ?_
    exact (continuous_neg.tendsto' (0 : ℤ) 0 neg_zero) hV
  induction L with
  | zero =>
    intro N hN
    refine ⟨univ, univ_mem, fun _ _ => mem_univ _, fun s hs z _ => ?_⟩
    rw [Finset.card_eq_zero.1 (Nat.le_zero.1 hs), Finset.sum_empty]
    exact mem_of_mem_nhds hN
  | succ L ih =>
    intro N hN
    obtain ⟨W, hWo, hW0, hWW⟩ := exists_open_nhds_zero_half hN
    have hW : W ∈ 𝓝 (0 : ℤ) := hWo.mem_nhds hW0
    obtain ⟨V, hV, _, hsum⟩ := ih W hW
    refine ⟨(V ∩ W) ∩ (fun x => -x) ⁻¹' (V ∩ W), sym _ (inter_mem hV hW), ?_, ?_⟩
    · intro x hx
      refine ⟨hx.2, ?_⟩
      show - -x ∈ V ∩ W
      rw [neg_neg]; exact hx.1
    · intro s hs z hz
      rcases s.eq_empty_or_nonempty with he | ⟨i0, hi0⟩
      · rw [he, Finset.sum_empty]; exact mem_of_mem_nhds hN
      · rw [← Finset.sum_erase_add s z hi0]
        refine hWW _ (hsum _ ?_ z (fun i hi => (hz i (Finset.mem_of_mem_erase hi)).1.1)) _
          (hz i0 hi0).1.2
        rw [Finset.card_erase_of_mem hi0]
        omega

/-- **The theorem.** -/
theorem exists_open_not_nhds (hv : ∀ a, v ≠ pure a) (k : ℕ) (hk : 2 ≤ k)
    (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l) :
    ∃ O : Set ℤ, (0 : ℤ) ∈ O ∧ IsOpenMod (genFam (Sel.ultraGen {sumU y v k})) O ∧
      ∀ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ →
        (sumU y v k : Filter ℤ) ≤ @nhds ℤ t 0 → O ∉ @nhds ℤ t 0 := by
  classical
  obtain ⟨β, hβ, hβinf, hwt⟩ := Sparse.exists_weight y hpos hgrow
  obtain ⟨n0, hn0⟩ := hβinf 1
  have hgex : ∀ n : ℕ, ∃ g : ℕ, n < g ∧ 2 * (k * n + k) ≤ β g := by
    intro n
    obtain ⟨m, hm⟩ := hβinf (2 * (k * n + k))
    exact ⟨max m (n + 1), lt_of_lt_of_le (Nat.lt_succ_self n) (le_max_right _ _),
      hm.trans (hβ (le_max_left _ _))⟩
  choose g hgn hgβ using hgex
  let x : ℕ → ℕ → ℤ := fun n m => y n + ((k * n + k - 1 : ℕ) : ℤ) * y m
  let A : Set ℤ := {w | ∃ n m, n0 ≤ n ∧ g n ≤ m ∧ w = x n m}
  have hA0 : (0 : ℤ) ∉ A := by
    rintro ⟨n, m, _, _, h⟩
    have h1 : 0 < y n := hpos n
    have h2 : 0 ≤ ((k * n + k - 1 : ℕ) : ℤ) * y m :=
      mul_nonneg (Int.natCast_nonneg _) (le_of_lt (hpos m))
    have h3 : (0 : ℤ) = y n + ((k * n + k - 1 : ℕ) : ℤ) * y m := h
    omega
  -- the coefficient vector of a point of `A`
  let ρ : ℕ → ℕ → (ℕ →₀ ℤ) := fun n m =>
    Finsupp.single n 1 + Finsupp.single m ((k * n + k - 1 : ℕ) : ℤ)
  have hρval : ∀ n m, Sparse.val y (ρ n m) = x n m := by
    intro n m
    show Sparse.val y (Finsupp.single n 1 + Finsupp.single m _) = _
    rw [Sparse.val_add, val_single, val_single, one_mul]
  -- the points of `A` have no limits
  have hopen : IsOpenMod (genFam (Sel.ultraGen {sumU y v k})) Aᶜ := by
    intro z hz F hF hconv
    by_contra hno
    have hne : (F ⊓ 𝓟 A).NeBot := by
      rw [neBot_iff]
      intro h
      exact hno (inf_principal_eq_bot.1 h)
    obtain ⟨p, hp⟩ := Ultrafilter.exists_le (F ⊓ 𝓟 A)
    have hpF : (p : Filter ℤ) ≤ F := hp.trans inf_le_left
    have hpA : A ∈ p := le_principal_iff.1 (hp.trans inf_le_right)
    have hq : (p.map (fun w => w - z) : Filter ℤ) ≤ Filter.map (fun w => w - z) F := by
      rw [Ultrafilter.coe_map]
      exact Filter.map_mono hpF
    obtain ⟨σ0, hσ0, hle⟩ := hconv.2 (p.map (fun w => w - z)) hq
    obtain ⟨ι, _, u, ε, hu, hε, hrep⟩ := Sel.rep_of_sumClosure _ hσ0
    set r := Fintype.card ι with hr
    -- every `M` gives a member of `p`
    have hS : ∀ M : ℕ, {w : ℤ | ∃ a : ι → ℤ, (∀ i, a i ∈ H y k M) ∧ w - z = ∑ i, ε i • a i} ∈ p := by
      intro M
      have h1 : ∀ i, H y k M ∈ u i := by
        intro i
        have h2 : u i = sumU y v k := hu i
        rw [h2]
        exact terms_mem y v hv k M
      have h3 : {d : ℤ | ∃ a : ι → ℤ, (∀ i, a i ∈ H y k M) ∧ d = ∑ i, ε i • a i} ∈ σ0 := by
        refine Filter.mem_of_superset (hrep (fun _ => H y k M) h1) ?_
        rintro d ⟨a, ha, rfl⟩
        exact ⟨a, ha, rfl⟩
      exact hle h3
    -- a bound making all vectors below admissible
    obtain ⟨M1, hM1β, hM1r⟩ : ∃ M1 : ℕ, 2 * r + 2 ≤ β M1 ∧ r < M1 := by
      obtain ⟨m, hm⟩ := hβinf (2 * r + 2)
      exact ⟨max m (r + 1), hm.trans (hβ (le_max_left _ _)),
        lt_of_lt_of_le (Nat.lt_succ_self r) (le_max_right _ _)⟩
    have hadm : ∀ M, M1 ≤ M → ∀ n m, n0 ≤ n → g n ≤ m → ∀ τ : ℕ →₀ ℤ, (∀ l, |τ l| ≤ (r : ℤ)) →
        (∀ l, τ l ≠ 0 → M < l) → ∀ l, |(ρ n m - τ) l| ≤ (β l : ℤ) := by
      intro M hM n m hn hm τ hτ hτM l
      have hnm : n < m := lt_of_lt_of_le (hgn n) hm
      have hmβ : 2 * (k * n + k) ≤ β m := (hgβ n).trans (hβ hm)
      have hnβ : 1 ≤ β n := hn0.trans (hβ hn)
      have hρl : (ρ n m) l = (if n = l then 1 else 0) + (if m = l then ((k * n + k - 1 : ℕ) : ℤ) else 0) := by
        show (Finsupp.single n (1 : ℤ) + Finsupp.single m ((k * n + k - 1 : ℕ) : ℤ)) l = _
        rw [Finsupp.add_apply, Finsupp.single_apply, Finsupp.single_apply]
      have hcast : ((k * n + k - 1 : ℕ) : ℤ) ≤ ((k * n + k : ℕ) : ℤ) := by
        exact_mod_cast Nat.sub_le _ _
      have hτl : |τ l| ≤ (r : ℤ) := hτ l
      have hτbig : τ l ≠ 0 → 2 * r + 2 ≤ β l := fun h =>
        hM1β.trans (hβ (hM.trans (le_of_lt (hτM l h))))
      rw [Finsupp.sub_apply, hρl]
      have h0 : (0 : ℤ) ≤ ((k * n + k - 1 : ℕ) : ℤ) := Int.natCast_nonneg _
      by_cases h1 : m = l
      · have h2 : ¬ n = l := by omega
        rw [if_neg h2, if_pos h1, zero_add]
        have hmβ' : 2 * (k * n + k) ≤ β l := h1 ▸ hmβ
        by_cases h3 : τ l = 0
        · rw [h3, sub_zero, abs_of_nonneg h0]
          have : k * n + k - 1 ≤ β l := by omega
          exact_mod_cast this
        · have h4 := hτbig h3
          have h5 : k * n + k + r ≤ β l := by omega
          have h6 : |((k * n + k - 1 : ℕ) : ℤ) - τ l| ≤ ((k * n + k - 1 : ℕ) : ℤ) + |τ l| := by
            refine (abs_sub _ _).trans ?_
            rw [abs_of_nonneg h0]
          have h7 : ((k * n + k : ℕ) : ℤ) + (r : ℤ) ≤ (β l : ℤ) := by exact_mod_cast h5
          omega
      · rw [if_neg h1, add_zero]
        by_cases h2 : n = l
        · rw [if_pos h2]
          have hnβ' : 1 ≤ β l := h2 ▸ hnβ
          by_cases h3 : τ l = 0
          · rw [h3, sub_zero, abs_one]; exact_mod_cast hnβ'
          · have h4 := hτbig h3
            have h5 : 1 + r ≤ β l := by omega
            have h6 : |(1 : ℤ) - τ l| ≤ 1 + |τ l| := by
              refine (abs_sub _ _).trans ?_
              rw [abs_one]
            have h7 : (1 : ℤ) + (r : ℤ) ≤ (β l : ℤ) := by exact_mod_cast h5
            omega
        · rw [if_neg h2, zero_sub, abs_neg]
          by_cases h3 : τ l = 0
          · rw [h3, abs_zero]; exact Int.natCast_nonneg _
          · have h4 := hτbig h3
            have h5 : r ≤ β l := by omega
            exact hτl.trans (by exact_mod_cast h5)
    -- a point of `A` near `z`
    have hpoint : ∀ M : ℕ, ∀ Q : Set ℤ, Q ∈ p → ∃ n m, n0 ≤ n ∧ g n ≤ m ∧ x n m ∈ Q ∧
        ∃ τ : ℕ →₀ ℤ, (∀ l, |τ l| ≤ (r : ℤ)) ∧ (∀ l, τ l ≠ 0 → M < l) ∧ (k : ℤ) ∣ aug τ ∧
          z = Sparse.val y (ρ n m - τ) := by
      intro M Q hQ
      obtain ⟨w, ⟨hwA, hwS⟩, hwQ⟩ := Ultrafilter.nonempty_of_mem
        (inter_mem (inter_mem (f := (p : Filter ℤ)) hpA (hS M)) hQ)
      obtain ⟨n, m, hn, hm, rfl⟩ := hwA
      obtain ⟨a, ha, haz⟩ := hwS
      obtain ⟨τ, hτval, hτ, hτM, hτk⟩ := vector_of_sum y k M ε hε a ha
      refine ⟨n, m, hn, hm, hwQ, τ, hτ, hτM, hτk, ?_⟩
      have h1 : Sparse.val y (ρ n m - τ) = Sparse.val y (ρ n m) - Sparse.val y τ := by
        have h2 := Sparse.val_add y (ρ n m - τ) τ
        rw [sub_add_cancel] at h2
        omega
      rw [h1, hρval, hτval, ← haz]
      omega
    -- the representation of `z`
    obtain ⟨n1, m1, hn1, hm1, _, τ1, hτ1, hτ1M, _, hz1⟩ := hpoint M1 univ univ_mem
    set c := ρ n1 m1 - τ1 with hc
    have hcadm : ∀ l, |c l| ≤ (β l : ℤ) := hadm M1 le_rfl n1 m1 hn1 hm1 τ1 hτ1 hτ1M
    set M := max M1 (c.support.sup id) with hM
    have hMM1 : M1 ≤ M := le_max_left _ _
    have hcM : ∀ l, c l ≠ 0 → l ≤ M := fun l hl =>
      le_trans (Finset.le_sup (f := id) (Finsupp.mem_support_iff.2 hl)) (le_max_right _ _)
    -- the points of `A` with small indices form a finite set
    have hfin : {w : ℤ | ∃ n m, n < m ∧ m ≤ M ∧ w = x n m}.Finite := by
      refine (((finite_Iic M).prod (finite_Iic M)).image (fun q : ℕ × ℕ => x q.1 q.2)).subset ?_
      rintro w ⟨n, m, h1, h2, rfl⟩
      exact ⟨(n, m), ⟨mem_Iic.2 (le_trans (le_of_lt h1) h2), mem_Iic.2 h2⟩, rfl⟩
    rcases p.mem_or_compl_mem {w : ℤ | ∃ n m, n < m ∧ m ≤ M ∧ w = x n m} with hsmall | hbig
    · -- then `p` is principal
      obtain ⟨w0, _, hw0⟩ := Ultrafilter.eq_pure_of_finite_mem hfin hsmall
      have hw0A : w0 ∈ A := by
        have := hpA
        rw [hw0] at this
        exact Ultrafilter.mem_pure.1 this
      have key : ∀ K : ℕ, ∃ τ : ℕ →₀ ℤ, (∀ l, |τ l| ≤ (r : ℤ)) ∧ (∀ l, τ l ≠ 0 → K < l) ∧
          w0 - z = Sparse.val y τ := by
        intro K
        have h1 := hS K
        rw [hw0] at h1
        obtain ⟨a, ha, haz⟩ := Ultrafilter.mem_pure.1 h1
        obtain ⟨τ, hτval, hτ, hτM, _⟩ := vector_of_sum y k K ε hε a ha
        exact ⟨τ, hτ, hτM, by rw [hτval]; exact haz⟩
      obtain ⟨τa, hτa, hτaM, ha⟩ := key M1
      obtain ⟨τb, hτb, hτbM, hb⟩ := key (max M1 (τa.support.sup id))
      have hadm' : ∀ τ : ℕ →₀ ℤ, (∀ l, |τ l| ≤ (r : ℤ)) → (∀ l, τ l ≠ 0 → M1 < l) →
          ∀ l, |τ l| ≤ (β l : ℤ) := by
        intro τ hτ hτM l
        by_cases h : τ l = 0
        · rw [h, abs_zero]; exact Int.natCast_nonneg _
        · have h1 : 2 * r + 2 ≤ β l := hM1β.trans (hβ (le_of_lt (hτM l h)))
          have h2 : r ≤ β l := by omega
          exact (hτ l).trans (by exact_mod_cast h2)
      have heq : τb = τa := Sparse.val_inj hpos hβ hwt τb τa
        (hadm' τb hτb (fun l hl => lt_of_le_of_lt (le_max_left _ _) (hτbM l hl)))
        (hadm' τa hτa hτaM) (by rw [← hb, ← ha])
      have hτa0 : τa = 0 := by
        ext l
        by_contra hl
        have hl' : τa l ≠ 0 := hl
        have h1 : max M1 (τa.support.sup id) < l := hτbM l (heq ▸ hl')
        have h2 : l ≤ τa.support.sup id := Finset.le_sup (f := id) (Finsupp.mem_support_iff.2 hl')
        have h3 := lt_of_le_of_lt (le_max_right _ _) h1
        omega
      have hwz : w0 = z := by
        rw [hτa0, Sparse.val_zero] at ha
        omega
      exact hz (hwz ▸ hw0A)
    · -- otherwise there is a point with a large second index
      obtain ⟨n, m, hn, hm, hxQ, τ, hτ, hτM, hτk, hzτ⟩ := hpoint M _ hbig
      have hnm : n < m := lt_of_lt_of_le (hgn n) hm
      have hMm : M < m := by
        by_contra h
        exact hxQ ⟨n, m, hnm, not_lt.1 h, rfl⟩
      have heq : ρ n m - τ = c := Sparse.val_inj hpos hβ hwt _ _
        (hadm M hMM1 n m hn hm τ hτ hτM) hcadm (by rw [← hzτ, ← hz1])
      have hρτ : ρ n m = c + τ := by rw [← heq, sub_add_cancel]
      have hcm : c m = 0 := by
        by_contra h
        have := hcM m h
        omega
      have hτm : τ m = ((k * n + k - 1 : ℕ) : ℤ) := by
        have h1 := congrArg (fun f : ℕ →₀ ℤ => f m) hρτ
        simp only [Finsupp.add_apply] at h1
        have h2 : (ρ n m) m = ((k * n + k - 1 : ℕ) : ℤ) := by
          show (Finsupp.single n (1 : ℤ) + Finsupp.single m ((k * n + k - 1 : ℕ) : ℤ)) m = _
          rw [Finsupp.add_apply, Finsupp.single_eq_of_ne (by omega), Finsupp.single_eq_same, zero_add]
        rw [h2, hcm, zero_add] at h1
        exact h1.symm
      have hknr : k * n + k - 1 ≤ r := by
        have h1 := hτ m
        rw [hτm, abs_of_nonneg (Int.natCast_nonneg _)] at h1
        exact_mod_cast h1
      have hnM : n ≤ M := by
        have h1 : n ≤ k * n := Nat.le_mul_of_pos_left n (by omega)
        omega
      -- the vector `τ` is concentrated at `m`
      have hτsingle : τ = Finsupp.single m ((k * n + k - 1 : ℕ) : ℤ) := by
        ext l
        rw [Finsupp.single_apply]
        by_cases hlm : m = l
        · rw [if_pos hlm, ← hlm, hτm]
        · rw [if_neg hlm]
          by_contra h
          have h1 : M < l := hτM l h
          have h2 : c l = 0 := by
            by_contra h3
            have := hcM l h3
            omega
          have h3 := congrArg (fun f : ℕ →₀ ℤ => f l) hρτ
          simp only [Finsupp.add_apply] at h3
          have h4 : (ρ n m) l = 0 := by
            show (Finsupp.single n (1 : ℤ) + Finsupp.single m ((k * n + k - 1 : ℕ) : ℤ)) l = _
            rw [Finsupp.add_apply, Finsupp.single_eq_of_ne (by omega),
              Finsupp.single_eq_of_ne (by omega), add_zero]
          rw [h4, h2, zero_add] at h3
          exact h h3.symm
      rw [hτsingle, aug_single] at hτk
      have h1 : k ∣ k * n + k - 1 := by exact_mod_cast hτk
      have h2 : k ∣ k * n + k := Nat.dvd_add (dvd_mul_right k n) dvd_rfl
      have h3 : k ∣ 1 := by
        have h4 := Nat.dvd_sub h2 h1
        have h5 : k * n + k - (k * n + k - 1) = 1 := by omega
        rwa [h5] at h4
      have := Nat.le_of_dvd one_pos h3
      omega
  refine ⟨Aᶜ, hA0, hopen, fun t ht hut hOn => ?_⟩
  letI := t
  haveI := ht
  -- from convergence of the sum, differences and `k`-th multiples are small
  have small : ∀ N : Set ℤ, N ∈ 𝓝 (0 : ℤ) → ∃ F ∈ v, (∀ m ∈ F, ∀ s ∈ F, y m - y s ∈ N) ∧
      (∀ m ∈ F, (k : ℤ) * y m ∈ N) := by
    intro N hN
    obtain ⟨V, hV, hVsym, hVsum⟩ := few_small t ht (2 * k + 1) N hN
    have hVu : V ∈ sumU y v k := hut hV
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    rw [mem_sumU_succ] at hVu
    obtain ⟨q, hq⟩ := Ultrafilter.nonempty_of_mem hVu
    set F : Set ℕ := {n | q + y n ∈ V} with hF
    have hFv : F ∈ v := hq
    have hdiff : ∀ m ∈ F, ∀ s ∈ F, ∀ T : Finset ℕ, T.card ≤ 2 → ∀ z : ℕ → ℤ,
        (∀ i ∈ T, z i = q + y m ∨ z i = -(q + y s)) → ∀ i ∈ T, z i ∈ V := by
      intro m hm s hs T _ z hz i hi
      rcases hz i hi with h | h
      · rw [h]; exact hm
      · rw [h]; exact hVsym _ hs
    have htwo : ∀ m ∈ F, ∀ s ∈ F, ∀ N' : Set ℤ, (∀ a ∈ V, ∀ b ∈ V, a + b ∈ N') → y m - y s ∈ N' := by
      intro m hm s hs N' hN'
      have h1 := hN' _ hm _ (hVsym _ hs)
      have h2 : q + y m + -(q + y s) = y m - y s := by omega
      rwa [h2] at h1
    refine ⟨F, hFv, fun m hm s hs => ?_, fun m hm => ?_⟩
    · have h1 := hVsum (Finset.range 2) (by simp; omega)
        (fun i => if i = 0 then q + y m else -(q + y s)) (fun i _ => by
          split_ifs
          · exact hm
          · exact hVsym _ hs)
      have h2 : ∑ i ∈ Finset.range 2, (if i = 0 then q + y m else -(q + y s)) = y m - y s := by
        rw [Finset.sum_range_succ, Finset.sum_range_one]
        simp only [if_true, if_neg (one_ne_zero : (1 : ℕ) ≠ 0)]
        omega
      rwa [h2] at h1
    · -- a sum of `k` terms from `F` lying in `V`
      have hVu' : V ∈ sumU y v (k' + 1) := hut hV
      obtain ⟨S, hScard, hSF, hSV⟩ := exists_terms y v hv F hFv (k' + 1) V hVu'
      -- list `2k + 1` elements of `V`: the sum, and the differences split in two
      let e := S.orderEmbOfFin hScard
      let w : ℕ → ℤ := fun i =>
        if h : i < k' + 1 then q + y m
        else if h' : i - (k' + 1) < k' + 1 then -(q + y (e ⟨i - (k' + 1), h'⟩))
        else ∑ j ∈ S, y j
      have hw : ∀ i ∈ Finset.range (2 * (k' + 1) + 1), w i ∈ V := by
        intro i _
        show (if h : i < k' + 1 then q + y m
          else if h' : i - (k' + 1) < k' + 1 then -(q + y (e ⟨i - (k' + 1), h'⟩))
          else ∑ j ∈ S, y j) ∈ V
        split_ifs with h h'
        · exact hm
        · exact hVsym _ (hSF _ (S.orderEmbOfFin_mem hScard _))
        · exact hSV
      have h1 := hVsum (Finset.range (2 * (k' + 1) + 1)) (by simp) w hw
      have h2 : ∑ i ∈ Finset.range (2 * (k' + 1) + 1), w i = ((k' + 1 : ℕ) : ℤ) * y m := by
        rw [Finset.sum_range_succ]
        have hlast : w (2 * (k' + 1)) = ∑ j ∈ S, y j := by
          show (if h : 2 * (k' + 1) < k' + 1 then _ else _) = _
          rw [dif_neg (by omega), dif_neg (by omega)]
        have hsplit : ∑ i ∈ Finset.range (2 * (k' + 1)), w i
            = ∑ i ∈ Finset.range (k' + 1), w i + ∑ i ∈ Finset.range (k' + 1), w (k' + 1 + i) := by
          rw [two_mul, Finset.sum_range_add]
        have hfirst : ∑ i ∈ Finset.range (k' + 1), w i = ((k' + 1 : ℕ) : ℤ) * (q + y m) := by
          rw [Finset.sum_congr rfl (fun i hi => show w i = q + y m from dif_pos (Finset.mem_range.1 hi))]
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
        have hsecond : ∑ i ∈ Finset.range (k' + 1), w (k' + 1 + i)
            = -(((k' + 1 : ℕ) : ℤ) * q + ∑ j ∈ S, y j) := by
          rw [Finset.sum_range]
          have h3 : ∀ i : Fin (k' + 1), w (k' + 1 + (i : ℕ)) = -(q + y (e i)) := by
            intro i
            have hi := i.2
            show (if h : k' + 1 + (i : ℕ) < k' + 1 then _ else _) = _
            rw [dif_neg (by omega), dif_pos (show k' + 1 + (i : ℕ) - (k' + 1) < k' + 1 by omega)]
            have h4 : (⟨k' + 1 + (i : ℕ) - (k' + 1), by omega⟩ : Fin (k' + 1)) = i := by
              apply Fin.ext
              show k' + 1 + (i : ℕ) - (k' + 1) = (i : ℕ)
              omega
            rw [h4]
          rw [Finset.sum_congr rfl (fun i _ => h3 i), Finset.sum_neg_distrib, Finset.sum_add_distrib,
            Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
          have h5 : ∑ i : Fin (k' + 1), y (e i) = ∑ j ∈ S, y j := by
            have h6 : Finset.image e Finset.univ = S := S.image_orderEmbOfFin_univ hScard
            have h7 : ∑ j ∈ Finset.image e Finset.univ, y j = ∑ i : Fin (k' + 1), y (e i) :=
              Finset.sum_image (fun a _ b _ hab => e.injective hab)
            rw [← h7, h6]
          rw [h5]
        rw [hsplit, hfirst, hsecond, hlast]
        ring
      rwa [h2] at h1
  -- a halving sequence
  have halve : ∀ N : Set ℤ, N ∈ 𝓝 (0 : ℤ) → ∃ H ∈ 𝓝 (0 : ℤ), ∀ a ∈ H, ∀ b ∈ H, a + b ∈ N := by
    intro N hN
    obtain ⟨H', hH, h⟩ := (nhds_zero_isNbhdFilter (G := ℤ)).halve N hN
    exact ⟨H', hH, h⟩
  choose half hhalf hadd using halve
  let W : ℕ → {N : Set ℤ // N ∈ 𝓝 (0 : ℤ)} := fun n =>
    Nat.rec ⟨Aᶜ, hOn⟩ (fun _ N => ⟨half N.1 N.2, hhalf N.1 N.2⟩) n
  have hWadd : ∀ n, ∀ a ∈ (W (n + 1)).1, ∀ b ∈ (W (n + 1)).1, a + b ∈ (W n).1 :=
    fun n => hadd (W n).1 (W n).2
  have h0W : ∀ n, (0 : ℤ) ∈ (W n).1 := fun n => mem_of_mem_nhds (W n).2
  have hWsum : ∀ (n j : ℕ) (z : ℕ → ℤ), (∀ i < n, z i ∈ (W (j + i + 1)).1) →
      ∑ i ∈ Finset.range n, z i ∈ (W j).1 := by
    intro n
    induction n with
    | zero => intro j z _; simpa using h0W j
    | succ n ih =>
      intro j z hz
      rw [Finset.sum_range_succ', add_comm]
      refine hWadd j _ (hz 0 (Nat.succ_pos _)) _ (ih (j + 1) (fun i => z (i + 1)) (fun i hi => ?_))
      have := hz (i + 1) (Nat.succ_lt_succ hi)
      rwa [show j + 1 + i + 1 = j + (i + 1) + 1 by omega]
  have hsm : ∀ i, ∃ F ∈ v, (∀ m ∈ F, ∀ s ∈ F, y m - y s ∈ (W (i + 1)).1) ∧
      (∀ m ∈ F, (k : ℤ) * y m ∈ (W (i + 1)).1) := fun i => small _ (W (i + 1)).2
  choose F hFv hFd hFk using hsm
  obtain ⟨n, hnF, hn⟩ := Ultrafilter.nonempty_of_mem
    (inter_mem (f := (v : Filter ℕ)) (hFv 0) (above_mem v hv n0))
  have hn0n : n0 ≤ n := le_of_lt hn
  have hI : (⋂ i ∈ Finset.range (n + 3), F i) ∈ (v : Filter ℕ) :=
    (Filter.biInter_finset_mem _).2 (fun i _ => hFv i)
  obtain ⟨m, hmI, hm⟩ := Ultrafilter.nonempty_of_mem
    (inter_mem hI (above_mem v hv (g n)))
  have hmF : ∀ i < n + 3, m ∈ F i := fun i hi => mem_iInter₂.1 hmI i (Finset.mem_range.2 hi)
  have hmem : x n m ∈ A := ⟨n, m, hn0n, le_of_lt hm, rfl⟩
  let z : ℕ → ℤ := fun i => if i = 0 then y n - y m else (k : ℤ) * y m
  have hz : ∀ i < n + 2, z i ∈ (W (0 + i + 1)).1 := by
    intro i hi
    rw [Nat.zero_add]
    show (if i = 0 then y n - y m else (k : ℤ) * y m) ∈ (W (i + 1)).1
    split_ifs with h
    · rw [h]
      exact hFd 0 n hnF m (hmF 0 (by omega))
    · exact hFk i m (hmF i (by omega))
  have hsum := hWsum (n + 2) 0 z hz
  have hval : ∑ i ∈ Finset.range (n + 2), z i = x n m := by
    rw [Finset.sum_range_succ']
    have h1 : ∀ i ∈ Finset.range (n + 1), z (i + 1) = (k : ℤ) * y m := fun i _ => if_neg (by omega)
    have h2 : z 0 = y n - y m := if_pos rfl
    rw [Finset.sum_congr rfl h1, h2, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    show _ = y n + ((k * n + k - 1 : ℕ) : ℤ) * y m
    have h3 : ((k * n + k - 1 : ℕ) : ℤ) = (k : ℤ) * n + k - 1 := by
      have h4 : 1 ≤ k * n + k := by omega
      push_cast [Nat.cast_sub h4]
      ring
    rw [h3]
    push_cast
    ring
  rw [hval] at hsum
  exact hsum hmem

/-- Hence the topological modification is not a group topology. -/
theorem not_isGroupTopology (hv : ∀ a, v ≠ pure a) (k : ℕ) (hk : 2 ≤ k)
    (hpos : ∀ i, 0 < y i)
    (hgrow : ∀ B : ℕ, ∃ L : ℕ, ∀ l, L < l → 2 * (B : ℤ) * ∑ i ∈ Finset.range l, y i < y l) :
    ¬ ∃ t : TopologicalSpace ℤ, @IsTopologicalAddGroup ℤ t _ ∧
      ∀ O : Set ℤ, IsOpen[t] O ↔ IsOpenMod (genFam (Sel.ultraGen {sumU y v k})) O := by
  rintro ⟨t, ht, hopen⟩
  obtain ⟨O, h0, hO, hno⟩ := exists_open_not_nhds y v hv k hk hpos hgrow
  have hCnull : NullFamily (genFam (Sel.ultraGen {sumU y v k})) := genFam_nullFamily _
  have huC : (sumU y v k : Filter ℤ) ∈ genFam (Sel.ultraGen {sumU y v k}) :=
    ⟨(sumU y v k).neBot, fun U hU => ⟨_, SumClosure.gen ⟨sumU y v k, rfl, rfl⟩, hU⟩⟩
  have hOt : IsOpen[t] O := (hopen O).2 hO
  refine hno t ht ?_ (@IsOpen.mem_nhds ℤ t 0 O hOt h0)
  intro B hB
  obtain ⟨B', hBA, hBo, hB0⟩ := (@mem_nhds_iff ℤ t 0 B).1 hB
  refine mem_of_superset ?_ hBA
  exact (hopen B').1 hBo 0 hB0 _ (sumU y v k).neBot ((conv_zero _ _).2 huC)

