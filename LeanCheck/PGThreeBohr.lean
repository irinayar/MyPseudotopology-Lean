import Mathlib
import LeanCheck.PGThreeWords

/-!
# PGthree: limits in the Bohr compactification (Lean check)

Scope. Section 9 of the third article (`PGthree.tex`), the part on the Bohr compactification. The Bohr
compactification of the discrete abelian group `G` is modelled inside the product of circles indexed by all
characters of `G`: `iota g` is the family of the values of the characters at `g`.

* `lim_mem_K` : every ultrafilter converging to `0` in the PG generated by a set `S` of filters has its limit in the
  subgroup `K S` generated by the limits of the ultrafilters finer than members of `S`;
* `limits_finite_group` : if `K S` is countable, the limits of the ultrafilters finer than a symmetric halvable null
  filter lie in a finite subgroup of `K S`, and the filter converges to that subgroup;
* `tendsto_zero_of_torsionfree` : if moreover `K S` has no element of finite order except `0`, every such filter is
  finer than the filter of neighbourhoods of `0` of the Bohr topology;
* `finite_gen_nullPts_fg`, `finite_gen_torsion`, `finite_gen_coarsest` : for finitely many ultrafilters the group of
  principal null points is finitely generated, its torsion subgroup is finite, and if no nonprincipal ultrafilter
  converging to `0` is idempotent there is a coarsest symmetric halvable null filter;
* `translated_idempotents` : for idempotents `q i` and elements `a i`, the principal null points of the PG generated by
  the ultrafilters `a i + q i` are the elements of the subgroup generated by the `a i`.

No set-theoretic hypothesis is used. A Lean proof verifies its formal statement under its hypotheses; the
correspondence with the article requires mathematical review.
-/

open Filter Set Topology

namespace PG

namespace Bohr

open Sel PG.Idem PG.Words

attribute [local instance] Ultrafilter.add Ultrafilter.addSemigroup

variable {G : Type} [AddCommGroup G]

/-- The product of circles over all characters of `G`. -/
abbrev Circles (G : Type) [AddCommGroup G] : Type := (G →+ UnitAddCircle) → UnitAddCircle

/-- The canonical homomorphism of `G` into its Bohr compactification. -/
def iota : G →+ Circles G where
  toFun g := fun χ => χ g
  map_zero' := by funext χ; simp
  map_add' x y := by funext χ; simp

/-- The inclusion of `ℚ/ℤ` in `ℝ/ℤ`. -/
noncomputable def ratCircle : AddCircle (1 : ℚ) →+ UnitAddCircle :=
  QuotientAddGroup.map _ _ (Rat.castHom ℝ).toAddMonoidHom (by
    intro x hx
    obtain ⟨n, hn⟩ := AddSubgroup.mem_zmultiples_iff.1 hx
    refine AddSubgroup.mem_comap.2 (AddSubgroup.mem_zmultiples_iff.2 ⟨n, ?_⟩)
    show n • (1 : ℝ) = ((x : ℚ) : ℝ)
    rw [← hn]
    simp)

theorem ratCircle_injective : Function.Injective ratCircle := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  induction x using QuotientAddGroup.induction_on with
  | H q =>
    have h1 : (((q : ℝ)) : UnitAddCircle) = 0 := hx
    obtain ⟨n, hn⟩ := (AddCircle.coe_eq_zero_iff (1 : ℝ)).1 h1
    refine (AddCircle.coe_eq_zero_iff (1 : ℚ)).2 ⟨n, ?_⟩
    have h2 : (n : ℝ) = (q : ℝ) := by simpa using hn
    have h3 : (n : ℚ) = q := by exact_mod_cast h2
    simpa using h3

/-- The characters separate the points. -/
theorem iota_injective : Function.Injective (iota (G := G)) := by
  rw [injective_iff_map_eq_zero]
  intro g hg
  by_contra h
  obtain ⟨c, hc⟩ := CharacterModule.exists_character_apply_ne_zero_of_ne_zero h
  have h1 : ratCircle (c g) = 0 := congrFun hg (ratCircle.comp (c : G →+ AddCircle (1 : ℚ)))
  exact hc (ratCircle_injective (by rw [h1, map_zero]))

/-! ### Limits -/

/-- The filter `F` converges to `a` in the Bohr compactification. -/
def Lim (F : Filter G) (a : Circles G) : Prop := Tendsto iota F (𝓝 a)

/-- The limit of an ultrafilter. -/
noncomputable def lam (U : Ultrafilter G) : Circles G := Ultrafilter.extend (iota (G := G)) U

theorem lim_lam (U : Ultrafilter G) : Lim (U : Filter G) (lam U) :=
  ultrafilter_extend_eq_iff.1 rfl

theorem lam_eq {U : Ultrafilter G} {a : Circles G} (h : Lim (U : Filter G) a) : lam U = a :=
  tendsto_nhds_unique (lim_lam U) h

theorem lam_pure (g : G) : lam (pure g) = iota g :=
  lam_eq (by
    unfold Lim
    rw [Ultrafilter.coe_pure]
    exact tendsto_pure_nhds _ _)

theorem Lim.add {F H : Filter G} {a b : Circles G} (hF : Lim F a) (hH : Lim H b) :
    Lim (Filter.map₂ (· + ·) F H) (a + b) := by
  unfold Lim at *
  rw [← Filter.map_prod_eq_map₂, tendsto_map'_iff]
  have h := (hF.comp (tendsto_fst (g := H))).add (hH.comp (tendsto_snd (f := F)))
  refine h.congr (fun p => ?_)
  simp [map_add]

theorem Lim.neg {F : Filter G} {a : Circles G} (hF : Lim F a) : Lim (Filter.map (fun x : G => -x) F) (-a) := by
  unfold Lim at *
  rw [tendsto_map'_iff]
  refine hF.neg.congr (fun p => ?_)
  simp [map_neg]

theorem lam_map_neg (U : Ultrafilter G) : lam (U.map (fun x : G => -x)) = -lam U :=
  lam_eq (by rw [Ultrafilter.coe_map]; exact (lim_lam U).neg)

theorem add_le_map₂ (p q : Ultrafilter G) :
    ((p + q : Ultrafilter G) : Filter G) ≤ Filter.map₂ (· + ·) (p : Filter G) (q : Filter G) := by
  intro s hs
  obtain ⟨A, hA, B, hB, h⟩ := Filter.mem_map₂_iff.1 hs
  show s ∈ p + q
  rw [PG.Idem.mem_add]
  refine Filter.mem_of_superset (show A ∈ p from hA) (fun m hm => ?_)
  exact Filter.mem_of_superset (show B ∈ q from hB) (fun z hz => h (mem_image2_of_mem hm hz))

theorem lam_add (p q : Ultrafilter G) : lam (p + q) = lam p + lam q :=
  lam_eq (((lim_lam p).add (lim_lam q)).mono_left (add_le_map₂ p q))

theorem lam_idempotent {q : Ultrafilter G} (h : q + q = q) : lam q = 0 := by
  have h1 := lam_add q q
  rw [h] at h1
  exact left_eq_add.1 h1

/-! ### The subgroup of limits -/

/-- The limits of the ultrafilters finer than members of `S`. -/
def L (S : Set (Filter G)) : Set (Circles G) :=
  {a | ∃ F ∈ S, ∃ U : Ultrafilter G, (U : Filter G) ≤ F ∧ lam U = a}

/-- The subgroup generated by these limits. -/
def K (S : Set (Filter G)) : AddSubgroup (Circles G) := AddSubgroup.closure (L S)

theorem lim_of_sumClosure (S : Set (Filter G)) {σ : Filter G} (h : SumClosure S σ) :
    ∀ U : Ultrafilter G, (U : Filter G) ≤ σ → lam U ∈ K S := by
  induction h with
  | zero =>
    intro U hU
    have : U = pure 0 := Ultrafilter.coe_le_coe.1 (by rw [Ultrafilter.coe_pure]; exact hU)
    rw [this, lam_pure, map_zero]
    exact (K S).zero_mem
  | gen hF =>
    intro U hU
    exact AddSubgroup.subset_closure ⟨_, hF, U, hU, rfl⟩
  | neg hF =>
    rename_i F
    intro U hU
    have h1 : ((U.map (fun x : G => -x) : Ultrafilter G) : Filter G) ≤ F := by
      rw [Ultrafilter.coe_map]
      calc Filter.map (fun x : G => -x) (U : Filter G)
          ≤ Filter.map (fun x : G => -x) (Filter.map (fun x : G => -x) F) := Filter.map_mono hU
        _ = F := by rw [Filter.map_map, neg_neg_fun, Filter.map_id]
    have h2 : lam (U.map (fun x : G => -x)) ∈ K S := AddSubgroup.subset_closure ⟨_, hF, _, h1, rfl⟩
    rw [lam_map_neg] at h2
    simpa using (K S).neg_mem h2
  | add h1 h2 ih1 ih2 =>
    intro U hU
    obtain ⟨U₁, U₂, hU₁, hU₂, hUU⟩ := exists_ultra_le_map₂ _ _ U hU
    rw [lam_eq (((lim_lam U₁).add (lim_lam U₂)).mono_left hUU)]
    exact (K S).add_mem (ih1 U₁ hU₁) (ih2 U₂ hU₂)

/-- Every ultrafilter converging to `0` has its limit in `K S`. -/
theorem lim_mem_K (S : Set (Filter G)) (p : Ultrafilter G) (hp : (p : Filter G) ∈ genFam S) : lam p ∈ K S := by
  obtain ⟨σ, hσ, h⟩ := hp.2 p le_rfl
  exact lim_of_sumClosure S hσ p h

/-- A principal null point lies in `K S`. -/
theorem iota_mem_K (S : Set (Filter G)) (g : G) (hg : (pure g : Filter G) ∈ genFam S) : iota g ∈ K S := by
  rw [← lam_pure]
  exact lim_mem_K S (pure g) (by rwa [Ultrafilter.coe_pure])

/-! ### Symmetric halvable null filters -/

/-- A countable compact subgroup of a compact group is finite. -/
theorem finite_of_compact_countable {P : Type*} [AddCommGroup P] [TopologicalSpace P] [IsTopologicalAddGroup P]
    [T2Space P] (F : AddSubgroup P) (hc : IsCompact (F : Set P)) (hn : (F : Set P).Countable) :
    (F : Set P).Finite := by
  have : CompactSpace F := isCompact_iff_compactSpace.1 hc
  have : Countable F := hn.to_subtype
  obtain ⟨i, x, hx⟩ := nonempty_interior_of_iUnion_of_closed (f := fun y : F => ({y} : Set F))
    (fun y => isClosed_singleton) (iUnion_of_singleton F)
  have hxi : x = i := mem_singleton_iff.1 (interior_subset hx)
  have hopen : IsOpen ({i} : Set F) := by
    have h1 : interior ({i} : Set F) = {i} :=
      Subset.antisymm interior_subset (singleton_subset_iff.2 (hxi ▸ hx))
    exact h1 ▸ isOpen_interior
  have h0 : IsOpen ({0} : Set F) := by
    have h1 : (fun y : F => y + i) ⁻¹' {i} = {0} := by
      ext y
      simp
    rw [← h1]
    exact hopen.preimage (continuous_add_const i)
  have : DiscreteTopology F := discreteTopology_of_isOpen_singleton_zero h0
  have : Finite F := finite_of_compact_of_discrete
  exact Set.finite_coe_iff.1 this

theorem limits_finite_group (S : Set (Filter G)) (hK : (K S : Set (Circles G)).Countable)
    (N : Filter G) (hN : IsNbhdFilter N) (hNC : N ∈ genFam S) :
    ∃ F : AddSubgroup (Circles G), (F : Set (Circles G)).Finite ∧ F ≤ K S ∧
      (∀ p : Ultrafilter G, (p : Filter G) ≤ N → lam p ∈ F) ∧
      ∀ W : Set (Circles G), IsOpen W → (F : Set (Circles G)) ⊆ W → iota ⁻¹' W ∈ N := by
  have hC : NullFamily (genFam S) := genFam_nullFamily _
  set X : Set (Ultrafilter G) := {U | (U : Filter G) ≤ N} with hX
  have hXclosed : IsClosed X := by
    have h1 : X = ⋂ s ∈ N, {U : Ultrafilter G | s ∈ U} := by
      ext U
      rw [mem_iInter₂]
      rfl
    rw [h1]
    exact isClosed_biInter (fun s _ => ultrafilter_isClosed_basic s)
  have h0 : (pure 0 : Ultrafilter G) ∈ X := fun s hs => hN.zero_mem s hs
  have hadd : ∀ p ∈ X, ∀ q ∈ X, p + q ∈ X := by
    intro p hp q hq s hs
    obtain ⟨B, hB, hBs⟩ := hN.halve s hs
    show s ∈ p + q
    rw [PG.Idem.mem_add]
    refine Filter.mem_of_superset (hp hB) (fun m hm => ?_)
    exact Filter.mem_of_superset (hq hB) (fun z hz => hBs m hm z hz)
  have hneg : ∀ p ∈ X, p.map (fun x : G => -x) ∈ X := by
    intro p hp s hs
    exact hp (hN.neg_mem s hs)
  let F : AddSubgroup (Circles G) :=
    { carrier := lam '' X
      zero_mem' := ⟨pure 0, h0, by rw [lam_pure, map_zero]⟩
      add_mem' := by
        rintro a b ⟨p, hp, rfl⟩ ⟨q, hq, rfl⟩
        exact ⟨p + q, hadd p hp q hq, lam_add p q⟩
      neg_mem' := by
        rintro a ⟨p, hp, rfl⟩
        exact ⟨_, hneg p hp, lam_map_neg p⟩ }
  have hFK : F ≤ K S := by
    rintro a ⟨p, hp, rfl⟩
    exact lim_mem_K S p (hC.finer _ hNC _ hp p.neBot)
  have hcompact : IsCompact (F : Set (Circles G)) :=
    hXclosed.isCompact.image (continuous_ultrafilter_extend _)
  have hfin : (F : Set (Circles G)).Finite := finite_of_compact_countable F hcompact (hK.mono hFK)
  refine ⟨F, hfin, hFK, fun p hp => ⟨p, hp, rfl⟩, fun W hW hFW => ?_⟩
  by_contra hnot
  have hne : (N ⊓ 𝓟 (iota ⁻¹' W)ᶜ).NeBot := by
    refine ⟨fun h => hnot ?_⟩
    have h1 := Filter.inf_principal_eq_bot.1 h
    rwa [compl_compl] at h1
  have hp := Ultrafilter.of_le (N ⊓ 𝓟 (iota ⁻¹' W)ᶜ)
  set p : Ultrafilter G := Ultrafilter.of (N ⊓ 𝓟 (iota ⁻¹' W)ᶜ) with hpdef
  have hpW : lam p ∈ W := hFW ⟨p, hp.trans inf_le_left, rfl⟩
  have h1 : iota ⁻¹' W ∈ p := (lim_lam p) (hW.mem_nhds hpW)
  have h2 : (iota ⁻¹' W)ᶜ ∈ p := hp.trans inf_le_right (mem_principal_self _)
  exact Ultrafilter.compl_mem_iff_notMem.1 h2 h1

/-- Without elements of finite order in `K S`, every symmetric halvable null filter converges to `0` in the Bohr
compactification. -/
theorem tendsto_zero_of_torsionfree (S : Set (Filter G)) (hK : (K S : Set (Circles G)).Countable)
    (htf : ∀ a ∈ K S, IsOfFinAddOrder a → a = 0)
    (N : Filter G) (hN : IsNbhdFilter N) (hNC : N ∈ genFam S) : Lim N 0 := by
  obtain ⟨F, hFfin, hFK, _, hW⟩ := limits_finite_group S hK N hN hNC
  have hF : (F : Set (Circles G)) ⊆ {0} := by
    intro a ha
    have h1 : (AddSubgroup.zmultiples a : Set (Circles G)).Finite :=
      hFfin.subset (AddSubgroup.zmultiples_le_of_mem ha)
    exact htf a (hFK ha) (finite_zmultiples.1 h1)
  refine tendsto_nhds.2 (fun W hWo h0 => ?_)
  exact hW W hWo (hF.trans (singleton_subset_iff.2 h0))

/-! ### Finitely many ultrafilters -/

theorem L_ultraGen (S : Set (Ultrafilter G)) : L (ultraGen S) ⊆ lam '' S := by
  rintro a ⟨F, ⟨u, hu, rfl⟩, U, hU, rfl⟩
  have : U = u := Ultrafilter.coe_le_coe.1 hU
  exact ⟨u, hu, by rw [this]⟩

theorem countable_closure {P : Type*} [AddCommGroup P] (T : Set P) (hT : T.Countable) :
    (AddSubgroup.closure T : Set P).Countable := by
  have : Countable T := hT.to_subtype
  have h1 : (AddSubgroup.closure T : Set P) ⊆ Set.range (Finsupp.linearCombination ℤ (Subtype.val : T → P)) := by
    intro x hx
    have h2 : x ∈ Submodule.span ℤ T := by
      rwa [← Submodule.mem_toAddSubgroup, Submodule.span_int_eq_addSubgroupClosure]
    have h3 : x ∈ LinearMap.range (Finsupp.linearCombination ℤ (Subtype.val : T → P)) := by
      rw [Finsupp.range_linearCombination, Subtype.range_coe]
      exact h2
    exact h3
  exact (countable_range _).mono h1

/-- For countably many ultrafilters the subgroup of limits is countable. -/
theorem countable_K (S : Set (Ultrafilter G)) (hS : S.Countable) :
    (K (ultraGen S) : Set (Circles G)).Countable :=
  countable_closure _ ((hS.image lam).mono (L_ultraGen S))

theorem finite_gen_nullPts_fg (S : Set (Ultrafilter G)) (hS : S.Finite) :
    (nullPts (genFam (ultraGen S)) (genFam_nullFamily _)).FG := by
  set H := nullPts (genFam (ultraGen S)) (genFam_nullFamily _) with hH
  have hL : (L (ultraGen S)).Finite := (hS.image lam).subset (L_ultraGen S)
  have hnoeth : IsNoetherian ℤ (Submodule.span ℤ (L (ultraGen S))) :=
    isNoetherian_of_fg_of_noetherian _ (Submodule.fg_span hL)
  let f : G →ₗ[ℤ] Circles G := (iota (G := G)).toIntLinearMap
  have hle : Submodule.map f (AddSubgroup.toIntSubmodule H) ≤ Submodule.span ℤ (L (ultraGen S)) := by
    rintro x ⟨g, hg, rfl⟩
    have h1 : iota g ∈ K (ultraGen S) := iota_mem_K _ g hg
    show iota g ∈ Submodule.span ℤ (L (ultraGen S))
    rwa [← Submodule.mem_toAddSubgroup, Submodule.span_int_eq_addSubgroupClosure]
  have h2 := (isNoetherian_submodule.1 hnoeth) _ hle
  have h3 : (AddSubgroup.toIntSubmodule H).FG :=
    Submodule.fg_of_fg_map_injective f iota_injective h2
  exact (Submodule.fg_iff_addSubgroup_fg _).1 h3

theorem finite_gen_torsion (S : Set (Ultrafilter G)) (hS : S.Finite) :
    {g : G | (pure g : Filter G) ∈ genFam (ultraGen S) ∧ IsOfFinAddOrder g}.Finite := by
  have hL : (L (ultraGen S)).Finite := (hS.image lam).subset (L_ultraGen S)
  have h1 := finite_torsion_closure (G := Circles G) (L (ultraGen S)) hL
  refine (h1.preimage (iota_injective (G := G)).injOn).subset (fun g hg => ?_)
  exact ⟨iota_mem_K _ g hg.1, iota.isOfFinAddOrder hg.2⟩

/-- Finitely many ultrafilters without a nonprincipal null idempotent: there is a coarsest group topology. -/
theorem finite_gen_coarsest (S : Set (Ultrafilter G)) (hS : S.Finite)
    (hidem : ∀ p : Ultrafilter G, (p : Filter G) ∈ genFam (ultraGen S) → (∀ a, p ≠ pure a) → p + p ≠ p) :
    ∃ N0 : Filter G, (IsNbhdFilter N0 ∧ N0 ∈ genFam (ultraGen S)) ∧
      ∀ N : Filter G, IsNbhdFilter N → N ∈ genFam (ultraGen S) → N ≤ N0 :=
  (coarsest_iff (genFam_nullFamily _)
    (nbhd_iff_of_no_idempotent (genFam_nullFamily _) hidem)).2 (finite_gen_torsion S hS)

/-! ### Translated idempotents -/

/-- If `a + q` belongs to `S` and `q` is idempotent, the principal filter at `a` is null. -/
theorem pure_mem_of_translated_idempotent (S : Set (Ultrafilter G)) (a : G) (q : Ultrafilter G) (hq : q + q = q)
    (hu : q.map (fun x => a + x) ∈ S) : (pure a : Filter G) ∈ genFam (ultraGen S) := by
  set u : Ultrafilter G := q.map (fun x => a + x) with hudef
  have hC : NullFamily (genFam (ultraGen S)) := genFam_nullFamily _
  have hgen : (u : Filter G) ∈ ultraGen S := ⟨u, hu, rfl⟩
  have hσ : SumClosure (ultraGen S) (Filter.map₂ (· + ·) (Filter.map₂ (· + ·) (u : Filter G) (u : Filter G))
      (Filter.map (fun x : G => -x) (u : Filter G))) :=
    SumClosure.add (SumClosure.add (SumClosure.gen hgen) (SumClosure.gen hgen)) (SumClosure.neg hgen)
  have hle : (pure a : Filter G) ≤ Filter.map₂ (· + ·) (Filter.map₂ (· + ·) (u : Filter G) (u : Filter G))
      (Filter.map (fun x : G => -x) (u : Filter G)) := by
    intro s hs
    obtain ⟨t1, ht1, t2, ht2, h⟩ := Filter.mem_map₂_iff.1 hs
    obtain ⟨A, hA, B, hB, hAB⟩ := Filter.mem_map₂_iff.1 ht1
    have hC1 : (A ∩ B) ∩ (fun x : G => -x) ⁻¹' t2 ∈ u := by
      refine Filter.inter_mem (Filter.inter_mem hA hB) ?_
      exact ht2
    set C' : Set G := (fun x => a + x) ⁻¹' ((A ∩ B) ∩ (fun x : G => -x) ⁻¹' t2) with hC'
    have hC'q : C' ∈ q := hC1
    have h2 : C' ∈ q + q := by rw [hq]; exact hC'q
    rw [PG.Idem.mem_add] at h2
    obtain ⟨x, hx1, hx2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem hC'q h2)
    have hx3 : {z : G | x + z ∈ C'} ∈ q := hx2
    obtain ⟨z, hz1, hz2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem hC'q hx3)
    have hz3 : x + z ∈ C' := hz2
    have e : (a + x) + (a + z) + -(a + (x + z)) = a := by abel
    refine Filter.mem_pure.2 ?_
    rw [← e]
    exact h (mem_image2_of_mem (hAB (mem_image2_of_mem hx1.1.1 hz1.1.2)) hz3.2)
  exact hC.finer _ ⟨inferInstance, fun U hU => ⟨_, hσ, hU⟩⟩ _ hle inferInstance

theorem lam_translated_idempotent (a : G) (q : Ultrafilter G) (hq : q + q = q) :
    lam (q.map (fun x => a + x)) = iota a := by
  have h : q.map (fun x => a + x) = (pure a : Ultrafilter G) + q := by
    refine Ultrafilter.ext (fun s => ?_)
    rw [PG.Idem.mem_add]
    rfl
  rw [h, lam_add, lam_pure, lam_idempotent hq, add_zero]

/-- The principal null points of the PG generated by translated idempotents `a i + q i` are the elements of the
subgroup generated by the `a i`. -/
theorem translated_idempotents {I : Type} (a : I → G) (q : I → Ultrafilter G) (hq : ∀ i, q i + q i = q i) (g : G) :
    (pure g : Filter G) ∈ genFam (ultraGen (range fun i => (q i).map (fun x => a i + x))) ↔
      g ∈ AddSubgroup.closure (range a) := by
  set S : Set (Ultrafilter G) := range fun i => (q i).map (fun x => a i + x) with hS
  have hC : NullFamily (genFam (ultraGen S)) := genFam_nullFamily _
  constructor
  · intro hg
    have h1 : iota g ∈ K (ultraGen S) := iota_mem_K _ g hg
    have h2 : K (ultraGen S) ≤ (AddSubgroup.closure (range a)).map (iota (G := G)) := by
      refine (AddSubgroup.closure_le _).2 (fun b hb => ?_)
      obtain ⟨v, ⟨i, rfl⟩, rfl⟩ := L_ultraGen _ hb
      exact ⟨a i, AddSubgroup.subset_closure (mem_range_self i), (lam_translated_idempotent _ _ (hq i)).symm⟩
    obtain ⟨g', hg', h3⟩ := h2 h1
    exact iota_injective h3 ▸ hg'
  · intro hg
    have h1 : AddSubgroup.closure (range a) ≤ nullPts (genFam (ultraGen S)) hC := by
      refine (AddSubgroup.closure_le _).2 ?_
      rintro _ ⟨i, rfl⟩
      exact pure_mem_of_translated_idempotent S (a i) (q i) (hq i) ⟨i, rfl⟩
    exact h1 hg

end Bohr

end PG
