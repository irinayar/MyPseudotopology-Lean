import Mathlib
import LeanCheck.PGNullFilters
import LeanCheck.PGGenerated

/-!
# PGtwo: the PG generated by a family of filters (Lean check)

Scope. Section 3 of the second article (`PGtwo.tex`), abstract form. Let `G` be an abelian group and `C0` a family of
filters on `G`.

* `SumClosure C0` : the family `S(C0)` of all finite filter sums `F₁ + ⋯ + Fₙ` (`n ≥ 0`) with every `Fⱼ` in `C0` or the
  negative of a member of `C0` (the empty sum is the principal filter at `0`);
* `genFam C0` : the family `D(C0)` of proper filters all of whose finer ultrafilters are finer than a member of `S(C0)`;
* `genFam_nullFamily` : `D(C0)` satisfies properties (i)-(iv) (a `NullFamily`) (Theorem 3.3);
* `subset_genFam` and `genFam_le` : it contains `C0` (when the members of `C0` are proper) and it is contained in every
  null family containing `C0`, so it is the smallest one;
* `map_zsmul_mem` : for a proper filter `F`, the image `k F` under `x ↦ k • x` belongs to `D({F})` (Corollary 3.4(b));
* `genNull_eq_genFam` : for an ultrafilter `u` the family `D({u})` is `genNull u` of `PGGenerated` (Corollary 3.4(c)).

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set

namespace PG

variable {G : Type*} [AddCommGroup G]

/-- The family `S(C0)` of finite signed sums of members of `C0`. -/
inductive SumClosure (C0 : Set (Filter G)) : Filter G → Prop
  | zero : SumClosure C0 (pure 0)
  | gen {F : Filter G} : F ∈ C0 → SumClosure C0 F
  | neg {F : Filter G} : F ∈ C0 → SumClosure C0 (Filter.map (fun x : G => -x) F)
  | add {F H : Filter G} : SumClosure C0 F → SumClosure C0 H →
      SumClosure C0 (Filter.map₂ (· + ·) F H)

/-- The family `D(C0)`: proper filters whose finer ultrafilters are finer than a member of `S(C0)`. -/
def genFam (C0 : Set (Filter G)) : Set (Filter G) :=
  {F | F.NeBot ∧ ∀ U : Ultrafilter G, (U : Filter G) ≤ F → ∃ σ, SumClosure C0 σ ∧ (U : Filter G) ≤ σ}

theorem neg_neg_fun : ((fun x : G => -x) ∘ fun x : G => -x) = id := by
  funext x; simp

theorem sumClosure_neg {C0 : Set (Filter G)} {σ : Filter G} (h : SumClosure C0 σ) :
    SumClosure C0 (Filter.map (fun x : G => -x) σ) := by
  induction h with
  | zero =>
    have : Filter.map (fun x : G => -x) (pure (0 : G)) = pure 0 := by
      rw [Filter.map_pure, neg_zero]
    rw [this]; exact SumClosure.zero
  | gen hF => exact SumClosure.neg hF
  | neg hF =>
    rw [Filter.map_map, neg_neg_fun, Filter.map_id]
    exact SumClosure.gen hF
  | @add F H h1 h2 ih1 ih2 =>
    have e : Filter.map (fun x : G => -x) (Filter.map₂ (· + ·) F H)
        = Filter.map₂ (· + ·) (Filter.map (fun x : G => -x) F) (Filter.map (fun x : G => -x) H) := by
      apply Filter.map_map₂_distrib
      intro a b
      show -(a + b) = -a + -b
      abel
    rw [e]
    exact SumClosure.add ih1 ih2

/-- Theorem 3.3: `D(C0)` is a null family. -/
theorem genFam_nullFamily (C0 : Set (Filter G)) : NullFamily (genFam C0) where
  ne := fun F hF => hF.1
  pure_zero := ⟨inferInstance, fun U hU => ⟨pure 0, SumClosure.zero, hU⟩⟩
  finer := by
    rintro F ⟨hne, hF⟩ H hle hHne
    exact ⟨hHne, fun U hU => hF U (hU.trans hle)⟩
  add := by
    rintro F ⟨hFn, hF⟩ H ⟨hHn, hH⟩
    refine ⟨hFn.map₂ hHn, fun W hW => ?_⟩
    obtain ⟨U, V, hU, hV, hWUV⟩ := exists_ultra_le_map₂ F H W hW
    obtain ⟨σ₁, hσ₁, hUσ⟩ := hF U hU
    obtain ⟨σ₂, hσ₂, hVσ⟩ := hH V hV
    exact ⟨Filter.map₂ (· + ·) σ₁ σ₂, SumClosure.add hσ₁ hσ₂,
      hWUV.trans (Filter.map₂_mono hUσ hVσ)⟩
  neg := by
    rintro F ⟨hne, hF⟩
    refine ⟨by have := hne; infer_instance, fun W hW => ?_⟩
    have hU : ((W.map (fun x : G => -x) : Ultrafilter G) : Filter G) ≤ F := by
      rw [Ultrafilter.coe_map]
      calc Filter.map (fun x : G => -x) (W : Filter G)
          ≤ Filter.map (fun x : G => -x) (Filter.map (fun x : G => -x) F) := Filter.map_mono hW
        _ = F := by rw [Filter.map_map, neg_neg_fun, Filter.map_id]
    obtain ⟨σ, hσ, hUσ⟩ := hF _ hU
    refine ⟨Filter.map (fun x : G => -x) σ, sumClosure_neg hσ, ?_⟩
    calc (W : Filter G)
        = Filter.map (fun x : G => -x) ((W.map (fun x : G => -x) : Ultrafilter G) : Filter G) := by
          rw [Ultrafilter.coe_map, Filter.map_map, neg_neg_fun, Filter.map_id]
      _ ≤ Filter.map (fun x : G => -x) σ := Filter.map_mono hUσ
  ultra := by
    rintro F hne hU
    exact ⟨hne, fun U hUF => (hU U hUF).2 U le_rfl⟩

/-- `D(C0)` contains `C0` when the members of `C0` are proper filters. -/
theorem subset_genFam {C0 : Set (Filter G)} (h : ∀ F ∈ C0, F.NeBot) : C0 ⊆ genFam C0 :=
  fun F hF => ⟨h F hF, fun U hU => ⟨F, SumClosure.gen hF, hU⟩⟩

/-- `D(C0)` is contained in every null family containing `C0`. -/
theorem genFam_le {C0 C : Set (Filter G)} (hC : NullFamily C) (h : C0 ⊆ C) : genFam C0 ⊆ C := by
  have key : ∀ σ : Filter G, SumClosure C0 σ → σ ∈ C := by
    intro σ hσ
    induction hσ with
    | zero => exact hC.pure_zero
    | gen hF => exact h hF
    | neg hF => exact hC.neg _ (h hF)
    | add h1 h2 ih1 ih2 => exact hC.add _ ih1 _ ih2
  rintro F ⟨hne, hF⟩
  refine hC.ultra F hne (fun U hU => ?_)
  obtain ⟨σ, hσ, hUσ⟩ := hF U hU
  exact hC.finer σ (key σ hσ) _ hUσ inferInstance

/-- The principal filter at `0` lies in `S(C0)`; iterated sums of one filter. -/
def repSum (F : Filter G) : ℕ → Filter G
  | 0 => pure 0
  | n + 1 => Filter.map₂ (· + ·) (repSum F n) F

theorem sumClosure_repSum {F : Filter G} (n : ℕ) : SumClosure {F} (repSum F n) := by
  induction n with
  | zero => exact SumClosure.zero
  | succ n ih => exact SumClosure.add ih (SumClosure.gen rfl)

theorem map_nsmul_le_repSum (F : Filter G) (n : ℕ) :
    Filter.map (fun x : G => n • x) F ≤ repSum F n := by
  induction n with
  | zero =>
    intro S hS
    have h0 : (0 : G) ∈ S := hS
    show (fun x : G => 0 • x) ⁻¹' S ∈ F
    have : (fun x : G => 0 • x) ⁻¹' S = univ := by
      ext x; simp [h0]
    rw [this]; exact Filter.univ_mem
  | succ n ih =>
    intro S hS
    obtain ⟨s, hs, t, ht, hst⟩ := Filter.mem_map₂_iff.1 hS
    have hs' : (fun x : G => n • x) ⁻¹' s ∈ F := ih hs
    show (fun x : G => (n + 1) • x) ⁻¹' S ∈ F
    refine Filter.mem_of_superset (Filter.inter_mem hs' ht) ?_
    intro x hx
    show (n + 1) • x ∈ S
    rw [succ_nsmul]
    exact hst ⟨n • x, hx.1, x, hx.2, rfl⟩

/-- Corollary 3.4(b), for natural numbers. -/
theorem map_nsmul_mem (F : Filter G) [F.NeBot] (n : ℕ) :
    Filter.map (fun x : G => n • x) F ∈ genFam {F} := by
  refine ⟨inferInstance, fun U hU => ⟨repSum F n, sumClosure_repSum n, hU.trans (map_nsmul_le_repSum F n)⟩⟩

/-- Corollary 3.4(b): the image `k F` of a proper filter `F` under `x ↦ k • x` converges to `0` in the PG generated
by `F`, for every integer `k`. -/
theorem map_zsmul_mem (F : Filter G) [F.NeBot] (k : ℤ) :
    Filter.map (fun x : G => k • x) F ∈ genFam {F} := by
  obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg k
  · simpa using map_nsmul_mem F n
  · have h := (genFam_nullFamily ({F} : Set (Filter G))).neg _ (map_nsmul_mem F n)
    have e : Filter.map (fun x : G => (-(n : ℤ)) • x) F
        = Filter.map (fun x : G => -x) (Filter.map (fun x : G => n • x) F) := by
      rw [Filter.map_map]
      congr 1
      funext x
      simp
    rw [e]; exact h

/-- Every ultrafilter finer than a member of `S({u})` converges to `0` in the PG generated by the ultrafilter `u`. -/
theorem genUlt_of_le (u : Ultrafilter G) {σ : Filter G} (h : SumClosure {(u : Filter G)} σ) :
    ∀ U : Ultrafilter G, (U : Filter G) ≤ σ → GenUlt u U := by
  induction h with
  | zero =>
    intro U hU
    have : U = pure 0 := Ultrafilter.coe_le_coe.1 (by rw [Ultrafilter.coe_pure]; exact hU)
    rw [this]; exact GenUlt.zero
  | gen hF =>
    intro U hU
    have hF' : _ = (u : Filter G) := hF
    rw [hF'] at hU
    rw [Ultrafilter.coe_le_coe.1 hU]; exact GenUlt.gen
  | neg hF =>
    intro U hU
    have hF' : _ = (u : Filter G) := hF
    rw [hF'] at hU
    have h1 : ((U.map (fun x : G => -x) : Ultrafilter G) : Filter G) ≤ (u : Filter G) := by
      rw [Ultrafilter.coe_map]
      calc Filter.map (fun x : G => -x) (U : Filter G)
          ≤ Filter.map (fun x : G => -x) (Filter.map (fun x : G => -x) (u : Filter G)) :=
            Filter.map_mono hU
        _ = u := by rw [Filter.map_map, neg_neg_fun, Filter.map_id]
    have h2 : U.map (fun x : G => -x) = u := Ultrafilter.coe_le_coe.1 h1
    have h3 : U = u.map (fun x : G => -x) := by
      rw [← h2, Ultrafilter.map_map, neg_neg_fun, Ultrafilter.map_id]
    rw [h3]
    exact GenUlt.neg GenUlt.gen
  | add h1 h2 ih1 ih2 =>
    intro U hU
    obtain ⟨U₁, U₂, hU₁, hU₂, hUU⟩ := exists_ultra_le_map₂ _ _ U hU
    exact GenUlt.add (ih1 U₁ hU₁) (ih2 U₂ hU₂) hUU

/-- Conversely, every ultrafilter converging to `0` in the PG generated by `u` is finer than a member of `S({u})`. -/
theorem exists_sumClosure_of_genUlt (u : Ultrafilter G) {U : Ultrafilter G} (h : GenUlt u U) :
    ∃ σ, SumClosure {(u : Filter G)} σ ∧ (U : Filter G) ≤ σ := by
  induction h with
  | zero => exact ⟨pure 0, SumClosure.zero, le_rfl⟩
  | gen => exact ⟨u, SumClosure.gen rfl, le_rfl⟩
  | neg h ih =>
    obtain ⟨σ, hσ, hle⟩ := ih
    refine ⟨Filter.map (fun x : G => -x) σ, sumClosure_neg hσ, ?_⟩
    rw [Ultrafilter.coe_map]
    exact Filter.map_mono hle
  | add h1 h2 hW ih1 ih2 =>
    obtain ⟨σ₁, hσ₁, hle₁⟩ := ih1
    obtain ⟨σ₂, hσ₂, hle₂⟩ := ih2
    exact ⟨Filter.map₂ (· + ·) σ₁ σ₂, SumClosure.add hσ₁ hσ₂, hW.trans (Filter.map₂_mono hle₁ hle₂)⟩

/-- Corollary 3.4(c): the PG generated by an ultrafilter is the PG of `PGGenerated`. -/
theorem genNull_eq_genFam (u : Ultrafilter G) : genNull u = genFam {(u : Filter G)} := by
  ext F
  constructor
  · rintro ⟨hne, hF⟩
    exact ⟨hne, fun U hU => exists_sumClosure_of_genUlt u (hF U hU)⟩
  · rintro ⟨hne, hF⟩
    refine ⟨hne, fun U hU => ?_⟩
    obtain ⟨σ, hσ, hUσ⟩ := hF U hU
    exact genUlt_of_le u hσ U hUσ

end PG
