import Mathlib
import LeanCheck.PGNullFilters
import LeanCheck.PGTwoGeneration

/-!
# PGtwo: the lattice of PG convergences (Lean check)

Scope. Theorem 4.1 of the second article (`PGtwo.tex`), abstract form. PG pseudotopologies on `G` correspond to null
families `NullFamily C` (`PGNullFilters`), ordered by inclusion.

* `nullFamily_top` and `nullFamily_bot` : the family of all proper filters (the indiscrete PG) and `{pure 0}` (the
  discrete PG) are null families, and every null family lies between them;
* `nullFamily_sInter` : the intersection of a nonempty family of null families is a null family (the meet);
* `nullFamily_sup` : `D(⋃ 𝒩)` of `PGTwoGeneration` is the least null family containing all members of `𝒩` (the join);
* `hausdorff_mono`, `hausdorff_bot` : Hausdorff null families form a down-set containing the discrete one.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set

namespace PG

variable {G : Type*} [AddCommGroup G]

/-- A proper filter `F` and a set `s ∉ F`: some ultrafilter finer than `F` contains the complement of `s`. -/
theorem exists_ultra_compl_mem (F : Filter G) [F.NeBot] {s : Set G} (hs : s ∉ F) :
    ∃ U : Ultrafilter G, (U : Filter G) ≤ F ∧ sᶜ ∈ (U : Filter G) := by
  have hne : (F ⊓ 𝓟 sᶜ).NeBot := by
    rw [Filter.inf_principal_neBot_iff]
    intro t ht
    by_contra hempty
    rw [Set.not_nonempty_iff_eq_empty] at hempty
    apply hs
    refine Filter.mem_of_superset ht ?_
    intro x hx
    by_contra hxs
    have : x ∈ t ∩ sᶜ := ⟨hx, hxs⟩
    rw [hempty] at this
    exact this
  refine ⟨Ultrafilter.of (F ⊓ 𝓟 sᶜ), (Ultrafilter.of_le _).trans inf_le_left, ?_⟩
  have : ((Ultrafilter.of (F ⊓ 𝓟 sᶜ) : Ultrafilter G) : Filter G) ≤ 𝓟 sᶜ :=
    (Ultrafilter.of_le _).trans inf_le_right
  exact Filter.le_principal_iff.1 this

/-- The indiscrete PG: all proper filters converge to `0`. -/
theorem nullFamily_top : NullFamily {F : Filter G | F.NeBot} where
  ne := fun F hF => hF
  pure_zero := by
    show (pure (0 : G) : Filter G).NeBot
    infer_instance
  finer := fun F _ H _ hH => hH
  add := fun F hF H hH => by
    have h1 : F.NeBot := hF
    have h2 : H.NeBot := hH
    exact h1.map₂ h2
  neg := fun F hF => by
    have h1 : F.NeBot := hF
    exact h1.map _
  ultra := fun F hF _ => hF

/-- The discrete PG: only the principal filter at `0` converges to `0`. -/
theorem nullFamily_bot : NullFamily {(pure 0 : Filter G)} where
  ne := fun F hF => by rw [Set.mem_singleton_iff.1 hF]; infer_instance
  pure_zero := rfl
  finer := by
    intro F hF H hle hH
    have hF' : F = pure 0 := hF
    rw [hF'] at hle
    have h0 : ({0} : Set G) ∈ H := Filter.le_pure_iff.1 hle
    apply le_antisymm hle
    intro S hS
    have hmem : ({0} : Set G) ∩ S ∈ H := Filter.inter_mem h0 hS
    obtain ⟨x, hx0, hxS⟩ := Filter.nonempty_of_mem hmem
    have : x = 0 := hx0
    rw [this] at hxS
    exact hxS
  add := by
    intro F hF H hH
    have hF' : F = pure 0 := hF
    have hH' : H = pure 0 := hH
    rw [hF', hH', Filter.map₂_pure]
    show pure (0 + 0) = (pure 0 : Filter G)
    rw [add_zero]
  neg := by
    intro F hF
    have hF' : F = pure 0 := hF
    rw [hF', Filter.map_pure, neg_zero]
    rfl
  ultra := by
    intro F hne hU
    show F = pure 0
    have h0 : ({0} : Set G) ∈ F := by
      by_contra h
      obtain ⟨U, hUF, hU0⟩ := exists_ultra_compl_mem F h
      have : (U : Filter G) = pure 0 := hU U hUF
      rw [this] at hU0
      exact hU0 rfl
    apply le_antisymm
    · exact Filter.le_pure_iff.2 h0
    · intro S hS
      have hmem : ({0} : Set G) ∩ S ∈ F := Filter.inter_mem h0 hS
      obtain ⟨x, hx0, hxS⟩ := Filter.nonempty_of_mem hmem
      have : x = 0 := hx0
      rw [this] at hxS
      exact hxS

/-- Every null family lies between the discrete and the indiscrete one. -/
theorem nullFamily_bot_le {C : Set (Filter G)} (hC : NullFamily C) : {(pure 0 : Filter G)} ⊆ C := by
  intro F hF
  have : F = pure 0 := hF
  rw [this]; exact hC.pure_zero

theorem nullFamily_le_top {C : Set (Filter G)} (hC : NullFamily C) : C ⊆ {F : Filter G | F.NeBot} :=
  fun F hF => hC.ne F hF

/-- The meet: an intersection of a nonempty set of null families is a null family. -/
theorem nullFamily_sInter {𝒩 : Set (Set (Filter G))} (hne : 𝒩.Nonempty)
    (h : ∀ C ∈ 𝒩, NullFamily C) : NullFamily (⋂₀ 𝒩) where
  ne := by
    intro F hF
    obtain ⟨C, hC⟩ := hne
    exact (h C hC).ne F (hF C hC)
  pure_zero := fun C hC => (h C hC).pure_zero
  finer := fun F hF H hle hH C hC => (h C hC).finer F (hF C hC) H hle hH
  add := fun F hF H hH C hC => (h C hC).add F (hF C hC) H (hH C hC)
  neg := fun F hF C hC => (h C hC).neg F (hF C hC)
  ultra := by
    intro F hFne hU C hC
    exact (h C hC).ultra F hFne (fun U hUF => hU U hUF C hC)

/-- The join: the PG generated by the union of the null families is the least upper bound. -/
theorem nullFamily_sup {𝒩 : Set (Set (Filter G))} (h : ∀ C ∈ 𝒩, NullFamily C) :
    NullFamily (genFam (⋃₀ 𝒩)) ∧ (∀ C ∈ 𝒩, C ⊆ genFam (⋃₀ 𝒩)) ∧
      ∀ C' : Set (Filter G), NullFamily C' → (∀ C ∈ 𝒩, C ⊆ C') → genFam (⋃₀ 𝒩) ⊆ C' := by
  refine ⟨genFam_nullFamily _, ?_, ?_⟩
  · intro C hC
    have hne : ∀ F ∈ ⋃₀ 𝒩, F.NeBot := by
      rintro F ⟨C', hC', hF⟩
      exact (h C' hC').ne F hF
    exact fun F hF => subset_genFam hne ⟨C, hC, hF⟩
  · intro C' hC' hle
    refine genFam_le hC' ?_
    rintro F ⟨C, hC, hF⟩
    exact hle C hC hF

/-- Hausdorff null families form a down-set. -/
theorem hausdorff_mono {C C' : Set (Filter G)} (hCC' : C ⊆ C')
    (h : ∀ (F : Filter G) (z : G), F ∈ C' → Filter.map (fun y => y - z) F ∈ C' → z = 0) :
    ∀ (F : Filter G) (z : G), F ∈ C → Filter.map (fun y => y - z) F ∈ C → z = 0 :=
  fun F z hF hFz => h F z (hCC' hF) (hCC' hFz)

/-- The discrete PG is Hausdorff. -/
theorem hausdorff_bot :
    ∀ (F : Filter G) (z : G), F ∈ ({(pure 0 : Filter G)} : Set (Filter G)) →
      Filter.map (fun y => y - z) F ∈ ({(pure 0 : Filter G)} : Set (Filter G)) → z = 0 := by
  intro F z hF hFz
  have hF' : F = pure 0 := hF
  have hFz' : Filter.map (fun y => y - z) F = pure 0 := hFz
  rw [hF', Filter.map_pure] at hFz'
  have : (0 : G) - z = 0 := Filter.pure_injective hFz'
  simpa using this

end PG
