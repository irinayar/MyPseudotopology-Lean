import Mathlib
import LeanCheck.PGThreeNull
import LeanCheck.PGThreeExact
import LeanCheck.PGThreeGeneral

/-!
# PGthree: the coreflection of a selective family without Hausdorffness (Lean check)

Scope. Section 6 of the third article (`PGthree.tex`). `G` is any countably infinite abelian group, `S` any set of
pairwise non-isomorphic selective ultrafilters, `C = genFam (ultraGen S)`. No Hausdorff hypothesis.

* `Hgen S` : the subgroup generated by the points `x` with `c • u = pure x` for some `u ∈ S`, `c : ℤ`;
* `exists_decomp` : every ultrafilter of `C` is `pure h + pw w` with `h ∈ Hgen S` and a word `w` all of whose images
  are nonprincipal;
* `pure_mem_iff` : `pure g ∈ C` exactly when `g ∈ Hgen S`;
* `length_eq` : `pure h + pw w` determines the length of such a word;
* `nbhd_iff` : the neighbourhood filters of group topologies lying in `C` are exactly the principal filters of the
  finite subgroups all of whose points are null;
* `exists_coarsest_iff` : there is a coarsest one exactly when only finitely many null points have finite order;
* `exists_no_coarsest` : under (S), a countable selective family on `ℕ →₀ ZMod 4` with no coarsest one.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set Topology Cardinal

namespace PG

namespace Null

open Sel

attribute [local instance] Ultrafilter.add Ultrafilter.addSemigroup

variable {G : Type} [AddCommGroup G] [Countable G] [Infinite G]

/-- Every ultrafilter of the PG is the ultrafilter of a word, possibly the empty one. -/
theorem exists_word_any {S : Set (Ultrafilter G)} (hsel : ∀ u ∈ S, IsSel u) (hiso : ∀ u ∈ S, ∀ v ∈ S, u ≠ v → ¬ Iso u v)
    (W : Ultrafilter G) (hW : (W : Filter G) ∈ genFam (ultraGen S)) :
    ∃ w, Good S w ∧ pw w = W := by
  classical
  obtain ⟨e⟩ : Nonempty (ℕ ≃ G) := by
    have := Encodable.ofCountable G
    have := Denumerable.ofEncodableOfInfinite G
    exact ⟨(Denumerable.eqv G).symm⟩
  obtain ⟨σ, hσ, hWσ⟩ := hW.2 W le_rfl
  obtain ⟨ι, _, u, ε, hu, hε, hrep⟩ := rep_of_sumClosure S hσ
  -- an ultrafilter on tuples with the given marginals and sum
  let sm : (ι → G) → G := fun a => ∑ i, ε i • a i
  set F : Filter (ι → G) := Filter.pi (fun i => (u i : Filter G)) ⊓ Filter.comap sm (W : Filter G) with hF
  have hFne : F.NeBot := by
    rw [hF, Filter.inf_neBot_iff]
    intro s hs t ht
    obtain ⟨I, _, A, hA, hAs⟩ := Filter.mem_pi.1 hs
    obtain ⟨B, hB, hBt⟩ := Filter.mem_comap.1 ht
    let A' : ι → Set G := fun i => if i ∈ I then A i else univ
    have hA' : ∀ i, A' i ∈ u i := by
      intro i
      show (if i ∈ I then A i else univ) ∈ u i
      split_ifs
      · exact hA i
      · exact Filter.univ_mem
    have hT := hWσ (hrep A' hA')
    obtain ⟨z, hz1, hz2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem (f := (W : Filter G)) hT hB)
    obtain ⟨a, ha, hsum⟩ := hz1
    refine ⟨a, hAs (fun i hi => ?_), hBt ?_⟩
    · have := ha i
      simpa [A', hi] using this
    · show ∑ i, ε i • a i ∈ B
      rw [hsum]; exact hz2
  have := hFne
  set Z : Ultrafilter (ι → G) := Ultrafilter.of F with hZ
  have hZF : (Z : Filter (ι → G)) ≤ F := Ultrafilter.of_le F
  have hmarg : ∀ i, Z.map (fun a => a i) = u i := by
    intro i
    refine Ultrafilter.coe_le_coe.1 ?_
    rw [Ultrafilter.coe_map]
    exact (Filter.map_mono (hZF.trans (inf_le_left))).trans (Filter.tendsto_eval_pi _ i)
  have hsumZ : Z.map sm = W := by
    refine Ultrafilter.coe_le_coe.1 ?_
    rw [Ultrafilter.coe_map]
    exact (Filter.map_mono (hZF.trans inf_le_right)).trans Filter.map_comap_le
  rcases isEmpty_or_nonempty ι with h | hι
  · have h1 : Z.map sm = pure 0 := by
      have : sm = fun _ => (0 : G) := by
        funext a
        show ∑ i, ε i • a i = 0
        rw [Finset.univ_eq_empty, Finset.sum_empty]
      rw [this]
      refine Ultrafilter.coe_injective ?_
      rw [Ultrafilter.coe_map, Ultrafilter.coe_pure]
      exact Filter.map_const
    exact ⟨[], fun x hx => absurd hx List.not_mem_nil, by rw [← hsumZ, h1]; rfl⟩
  -- the pattern of equalities and order
  let rk : (ι → G) → ι → Fin (Fintype.card ι) := fun a i =>
    ⟨((Finset.univ.image (fun j => e.symm (a j))).filter (fun z => z < e.symm (a i))).card, by
      have h1 : ((Finset.univ.image (fun j => e.symm (a j))).filter (fun z => z < e.symm (a i)))
          ⊂ Finset.univ.image (fun j => e.symm (a j)) :=
        Finset.filter_ssubset.2 ⟨e.symm (a i), Finset.mem_image_of_mem _ (Finset.mem_univ i), lt_irrefl _⟩
      exact lt_of_lt_of_le (Finset.card_lt_card h1) (Finset.card_image_le.trans Finset.card_univ.le)⟩
  have hrk_mono : ∀ a i j, e.symm (a i) < e.symm (a j) → rk a i < rk a j := by
    intro a i j h
    show (Finset.filter _ _).card < (Finset.filter _ _).card
    refine Finset.card_lt_card ⟨fun z hz => ?_, fun hsub => ?_⟩
    · rw [Finset.mem_filter] at hz ⊢
      exact ⟨hz.1, hz.2.trans h⟩
    · have h1 : e.symm (a i) ∈ (Finset.univ.image (fun j => e.symm (a j))).filter (fun z => z < e.symm (a j)) :=
        Finset.mem_filter.2 ⟨Finset.mem_image_of_mem _ (Finset.mem_univ i), h⟩
      exact lt_irrefl _ (Finset.mem_filter.1 (hsub h1)).2
  have hrk_eq : ∀ a i j, rk a i = rk a j ↔ e.symm (a i) = e.symm (a j) := by
    intro a i j
    constructor
    · intro h
      rcases lt_trichotomy (e.symm (a i)) (e.symm (a j)) with h' | h' | h'
      · exact absurd h (hrk_mono a i j h').ne
      · exact h'
      · exact absurd h (hrk_mono a j i h').ne'
    · intro h
      apply Fin.ext
      show (Finset.filter _ _).card = (Finset.filter _ _).card
      rw [h]
  have hrk_lt : ∀ a i j, rk a i < rk a j ↔ e.symm (a i) < e.symm (a j) := by
    intro a i j
    refine ⟨fun h => ?_, hrk_mono a i j⟩
    rcases lt_trichotomy (e.symm (a i)) (e.symm (a j)) with h' | h' | h'
    · exact h'
    · exact absurd ((hrk_eq a i j).2 h') h.ne
    · exact absurd (hrk_mono a j i h') h.asymm
  obtain ⟨ρ, hρ⟩ : ∃ ρ : ι → Fin (Fintype.card ι), {a | rk a = ρ} ∈ Z := by
    by_contra h
    have h1 : (⋂ ρ ∈ (Finset.univ : Finset (ι → Fin (Fintype.card ι))), {a : ι → G | rk a = ρ}ᶜ) ∈ (Z : Filter _) := by
      refine (Filter.biInter_finset_mem _).2 (fun ρ _ => ?_)
      rcases Z.mem_or_compl_mem {a | rk a = ρ} with h' | h'
      · exact absurd ⟨ρ, h'⟩ h
      · exact h'
    obtain ⟨a, ha⟩ := Ultrafilter.nonempty_of_mem h1
    exact mem_iInter₂.1 ha (rk a) (Finset.mem_univ _) rfl
  obtain ⟨a0, ha0⟩ := Ultrafilter.nonempty_of_mem hρ
  have ha0' : rk a0 = ρ := ha0
  -- the ranks that occur are the first `r` numbers
  set J : Finset (Fin (Fintype.card ι)) := Finset.univ.image ρ with hJ
  set r : ℕ := J.card with hr
  let ord : Fin r ≃o J := J.orderIsoOfFin rfl
  have hsec : ∀ l : Fin r, ∃ i, ρ i = (ord l).1 := by
    intro l
    obtain ⟨i, _, hi⟩ := Finset.mem_image.1 (ord l).2
    exact ⟨i, hi⟩
  choose s hs using hsec
  have hpos : ∀ i, ρ i ∈ J := fun i => Finset.mem_image_of_mem ρ (Finset.mem_univ i)
  let pos : ι → Fin r := fun i => ord.symm ⟨ρ i, hpos i⟩
  have hordpos : ∀ i, (ord (pos i)).1 = ρ i := by
    intro i
    show (ord (ord.symm ⟨ρ i, hpos i⟩)).1 = ρ i
    rw [OrderIso.apply_symm_apply]
  let z : (ι → G) → Fin r → ℕ := fun a l => e.symm (a (s l))
  have hz : ∀ a, rk a = ρ → ∀ i, e.symm (a i) = z a (pos i) := by
    intro a ha i
    refine (hrk_eq a i (s (pos i))).1 ?_
    rw [ha, hs, hordpos]
  have hzmono : ∀ a, rk a = ρ → StrictMono (z a) := by
    intro a ha l m hlm
    refine (hrk_lt a (s l) (s m)).1 ?_
    rw [ha, hs, hs]
    exact ord.strictMono hlm
  have hselmap : ∀ i, IsSel ((u i).map e.symm) := fun i =>
    isSel_map_of_injective (hsel _ (hu i)) e.symm e.symm.injective
  let v : Fin r → Ultrafilter ℕ := fun l => (u (s l)).map e.symm
  -- the image on increasing tuples is the ultrafilter of the large sets
  have hfub : ∀ R : Set (Fin r → ℕ), Large r v R → {a | z a ∈ R} ∈ Z := by
    intro R hR
    rcases Z.mem_or_compl_mem {a | z a ∈ R} with h | h
    · exact h
    exfalso
    set U : Finset (Ultrafilter ℕ) := Finset.univ.image v with hU
    let w : Fin U.card → Ultrafilter ℕ := fun k => (U.equivFin.symm k).1
    have hvU : ∀ l, v l ∈ U := fun l => Finset.mem_image_of_mem v (Finset.mem_univ l)
    let τ : Fin r → Fin U.card := fun l => U.equivFin ⟨v l, hvU l⟩
    have hwτ : ∀ l, w (τ l) = v l := by
      intro l
      show (U.equivFin.symm (U.equivFin ⟨v l, hvU l⟩)).1 = v l
      rw [Equiv.symm_apply_apply]
    have hwv : ∀ k, ∃ l, w k = v l := by
      intro k
      obtain ⟨l, _, hl⟩ := Finset.mem_image.1 (U.equivFin.symm k).2
      exact ⟨l, hl.symm⟩
    have hwsel : ∀ k, IsSel (w k) := by
      intro k
      obtain ⟨l, hl⟩ := hwv k
      rw [hl]; exact hselmap _
    have hwiso : ∀ k k', k ≠ k' → ¬ Iso (w k) (w k') := by
      rintro k k' hkk' ⟨π, hπ⟩
      obtain ⟨l, hl⟩ := hwv k
      obtain ⟨l', hl'⟩ := hwv k'
      have hne : w k ≠ w k' := fun h => hkk' (U.equivFin.symm.injective (Subtype.ext h))
      have huu : u (s l) ≠ u (s l') := by
        intro h
        refine hne ?_
        rw [hl, hl']
        show (u (s l)).map e.symm = (u (s l')).map e.symm
        rw [h]
      refine hiso _ (hu (s l)) _ (hu (s l')) huu ⟨(e.symm.trans π).trans e, ?_⟩
      have h1 : (v l).map π = v l' := by rw [← hl, ← hl']; exact hπ
      have h2 := congrArg (Ultrafilter.map e) h1
      simp only [v, Ultrafilter.map_map] at h2
      have h3 : (e : ℕ → G) ∘ (e.symm : G → ℕ) = id := by funext x; simp
      rw [h3, Ultrafilter.map_id] at h2
      exact h2
    have hnl : ¬ Large r (fun l => w (τ l)) Rᶜ := by
      have : (fun l => w (τ l)) = v := funext hwτ
      rw [this, large_compl]
      exact not_not.2 hR
    obtain ⟨B, hB, hav⟩ := tuples w hwsel hwiso r τ Rᶜ hnl
    have hmargB : ∀ l, {a : ι → G | z a l ∈ B (τ l)} ∈ Z := by
      intro l
      have h1 : B (τ l) ∈ v l := by rw [← hwτ l]; exact hB (τ l)
      have h2 : e.symm ⁻¹' B (τ l) ∈ u (s l) := h1
      rw [← hmarg (s l)] at h2
      exact h2
    have hall : (⋂ l ∈ (Finset.univ : Finset (Fin r)), {a : ι → G | z a l ∈ B (τ l)}) ∈ (Z : Filter _) :=
      (Filter.biInter_finset_mem _).2 (fun l _ => hmargB l)
    have h12 : {a | rk a = ρ} ∩ {a | z a ∈ R}ᶜ ∈ (Z : Filter _) := Filter.inter_mem hρ h
    obtain ⟨a, ⟨ha1, ha2⟩, ha3⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem h12 hall)
    exact hav (z a) (hzmono a ha1) (fun l => mem_iInter₂.1 ha3 l (Finset.mem_univ l)) ha2
  -- the sum collected over equal coordinates
  let c : Fin r → ℤ := fun l => ∑ i ∈ Finset.univ.filter (fun i => pos i = l), ε i
  have hcollect : ∀ a, rk a = ρ → sm a = ∑ l, c l • e (z a l) := by
    intro a ha
    show ∑ i, ε i • a i = ∑ l, (∑ i ∈ Finset.univ.filter (fun i => pos i = l), ε i) • e (z a l)
    rw [← Finset.sum_fiberwise Finset.univ pos (fun i => ε i • a i)]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [Finset.sum_smul]
    refine Finset.sum_congr rfl (fun i hi => ?_)
    have h1 : pos i = l := (Finset.mem_filter.1 hi).2
    have h2 := hz a ha i
    rw [h1] at h2
    rw [← h2, Equiv.apply_symm_apply]
  set word : List (Ultrafilter G × ℤ) := List.ofFn (fun l => (u (s l), c l)) with hword
  have hpw : pw word = W := by
    refine (Ultrafilter.coe_le_coe.1 (fun A hA => ?_)).symm
    have h1 := (mem_pw_ofFn e r (fun l => u (s l)) c A).1 hA
    have h2 := hfub _ h1
    have h3 : sm ⁻¹' A ∈ Z := by
      refine Filter.mem_of_superset (Filter.inter_mem hρ h2) (fun a ha => ?_)
      show sm a ∈ A
      rw [hcollect a ha.1]
      exact ha.2
    show A ∈ W
    rw [← hsumZ]
    exact h3
  refine ⟨word.filter (fun x => decide (x.2 ≠ 0)), fun x hx => ?_, ?_⟩
  · obtain ⟨hx1, hx2⟩ := List.mem_filter.1 hx
    refine ⟨?_, by simpa using hx2⟩
    rw [hword, List.mem_ofFn] at hx1
    obtain ⟨l, hl⟩ := hx1
    rw [← hl]
    exact hu _
  · rw [pw_filter, hpw]

/-! ### Principal parts -/

/-- The subgroup generated by the principal images of the ultrafilters of `S`. -/
def Hgen (S : Set (Ultrafilter G)) : AddSubgroup G :=
  AddSubgroup.closure {x | ∃ u ∈ S, ∃ c : ℤ, Img (u, c) = pure x}

/-- A word with letters in `S` all of whose images are nonprincipal. -/
def Free1 (S : Set (Ultrafilter G)) (w : List (Ultrafilter G × ℤ)) : Prop :=
  ∀ x ∈ w, x.1 ∈ S ∧ ∀ a, Img x ≠ pure a

theorem pure_add_comm (h : G) (p : Ultrafilter G) : (pure h : Ultrafilter G) + p = p + pure h := by
  refine Ultrafilter.coe_injective (Filter.ext (fun A => ?_))
  show A ∈ (pure h : Ultrafilter G) + p ↔ A ∈ p + pure h
  rw [mem_add, mem_add]
  have e1 : {m : G | {z : G | m + z ∈ A} ∈ (pure h : Ultrafilter G)} = {z : G | h + z ∈ A} := by
    ext m
    show m + h ∈ A ↔ h + m ∈ A
    rw [add_comm]
  rw [e1]
  exact Iff.rfl

theorem pure_add_pure (a b : G) : (pure a : Ultrafilter G) + pure b = pure (a + b) := by
  refine Ultrafilter.coe_injective (Filter.ext (fun A => ?_))
  show A ∈ (pure a : Ultrafilter G) + pure b ↔ A ∈ (pure (a + b) : Ultrafilter G)
  rw [mem_add]
  exact Iff.rfl

theorem mem_pure_add (h : G) (p : Ultrafilter G) (A : Set G) :
    A ∈ (pure h : Ultrafilter G) + p ↔ {z : G | h + z ∈ A} ∈ p := by
  rw [mem_add]
  exact Iff.rfl

theorem decomp_word (S : Set (Ultrafilter G)) (w : List (Ultrafilter G × ℤ)) (hw : ∀ x ∈ w, x.1 ∈ S) :
    ∃ h ∈ Hgen S, ∃ w', Free1 S w' ∧ pw w = pure h + pw w' := by
  induction w with
  | nil =>
    exact ⟨0, zero_mem _, [], fun x hx => absurd hx List.not_mem_nil, (pure_zero_add _).symm⟩
  | cons x w ih =>
    obtain ⟨h, hh, w', hw', hpw⟩ := ih (fun y hy => hw y (List.mem_cons_of_mem _ hy))
    have hx := hw x (List.mem_cons_self ..)
    by_cases hp : ∃ a, Img x = pure a
    · obtain ⟨a, ha⟩ := hp
      have haH : a ∈ Hgen S := AddSubgroup.subset_closure ⟨x.1, hx, x.2, ha⟩
      refine ⟨a + h, add_mem haH hh, w', hw', ?_⟩
      rw [pw_cons, ha, hpw, ← add_assoc, pure_add_pure]
    · refine ⟨h, hh, x :: w', fun y hy => ?_, ?_⟩
      · rcases List.mem_cons.1 hy with h' | h'
        · rw [h']; exact ⟨hx, fun a ha => hp ⟨a, ha⟩⟩
        · exact hw' y h'
      · rw [pw_cons, pw_cons, hpw, ← add_assoc, ← pure_add_comm, add_assoc]

theorem exists_decomp (S : Set (Ultrafilter G)) (hsel : ∀ u ∈ S, IsSel u)
    (hiso : ∀ u ∈ S, ∀ v ∈ S, u ≠ v → ¬ Iso u v) (W : Ultrafilter G) (hW : (W : Filter G) ∈ genFam (ultraGen S)) :
    ∃ h ∈ Hgen S, ∃ w, Free1 S w ∧ W = pure h + pw w := by
  obtain ⟨w, hw, hpw⟩ := exists_word_any hsel hiso W hW
  obtain ⟨h, hh, w', hw', h1⟩ := decomp_word S w (fun x hx => (hw x hx).1)
  exact ⟨h, hh, w', hw', by rw [← hpw, h1]⟩

theorem pure_mem_of_mem_Hgen (S : Set (Ultrafilter G)) {g : G} (hg : g ∈ Hgen S) :
    (pure g : Filter G) ∈ genFam (ultraGen S) := by
  have hC : NullFamily (genFam (ultraGen S)) := genFam_nullFamily _
  let H0 : AddSubgroup G :=
    { carrier := {x | (pure x : Filter G) ∈ genFam (ultraGen S)}
      zero_mem' := hC.pure_zero
      add_mem' := fun {a b} ha hb => by
        have h1 := hC.add _ ha _ hb
        rwa [Filter.map₂_pure] at h1
      neg_mem' := fun {a} ha => by
        have h1 := hC.neg _ ha
        rwa [Filter.map_pure] at h1 }
  have hle : Hgen S ≤ H0 := by
    refine (AddSubgroup.closure_le _).2 ?_
    rintro x ⟨u, hu, c, hux⟩
    have h1 := pw_mem S [(u, c)] (fun y hy => by rw [List.mem_singleton.1 hy]; exact hu)
    have h2 : pw [(u, c)] = pure x := by
      rw [pw_cons, hux]
      show (pure x : Ultrafilter G) + pure 0 = pure x
      rw [pure_add_pure, add_zero]
    rw [h2, Ultrafilter.coe_pure] at h1
    exact h1
  exact hle hg

theorem decomp_mem (S : Set (Ultrafilter G)) (h : G) (hh : h ∈ Hgen S) (w : List (Ultrafilter G × ℤ))
    (hw : Free1 S w) : ((pure h + pw w : Ultrafilter G) : Filter G) ∈ genFam (ultraGen S) := by
  have hC : NullFamily (genFam (ultraGen S)) := genFam_nullFamily _
  have h1 : ((pure h : Ultrafilter G) : Filter G) ∈ genFam (ultraGen S) := by
    rw [Ultrafilter.coe_pure]; exact pure_mem_of_mem_Hgen S hh
  have h2 := hC.add _ h1 _ (pw_mem S w (fun x hx => (hw x hx).1))
  exact hC.finer _ h2 _ (coe_add_le _ _) (Ultrafilter.neBot _)

theorem pw_free1 (S : Set (Ultrafilter G)) (w : List (Ultrafilter G × ℤ)) (hw : Free1 S w) (hne : w ≠ []) :
    ∀ a, pw w ≠ pure a := by
  induction w with
  | nil => exact absurd rfl hne
  | cons x w ih =>
    intro a ha
    have hx := hw x (List.mem_cons_self ..)
    have hmem : ({a} : Set G) ∈ pw (x :: w) := by rw [ha]; exact rfl
    rw [mem_pw_cons] at hmem
    rcases eq_or_ne w [] with hw0 | hw0
    · subst hw0
      have h1 : ({a} : Set G) ∈ Img x := by
        show {b : G | x.2 • b ∈ ({a} : Set G)} ∈ x.1
        refine Filter.mem_of_superset hmem (fun b hb => ?_)
        have h2 : (0 : G) ∈ {z : G | x.2 • b + z ∈ ({a} : Set G)} := hb
        simpa using h2
      obtain ⟨y, _, h2⟩ := Ultrafilter.eq_pure_of_finite_mem (finite_singleton _) h1
      exact hx.2 y h2
    · obtain ⟨b, hb⟩ := Ultrafilter.nonempty_of_mem hmem
      have h1 : {z : G | x.2 • b + z ∈ ({a} : Set G)} ∈ pw w := hb
      refine ih (fun y hy => hw y (List.mem_cons_of_mem _ hy)) hw0 (a - x.2 • b) ?_
      have h2 : ({a - x.2 • b} : Set G) ∈ pw w := by
        refine Filter.mem_of_superset h1 (fun z hz => ?_)
        have h3 : x.2 • b + z = a := hz
        rw [mem_singleton_iff, ← h3]; abel
      obtain ⟨y, hy, h4⟩ := Ultrafilter.eq_pure_of_finite_mem (finite_singleton _) h2
      rw [h4, mem_singleton_iff.1 hy]

theorem free_pure_add (h : G) (p : Ultrafilter G) (hp : ∀ a, p ≠ pure a) : ∀ a, (pure h : Ultrafilter G) + p ≠ pure a := by
  intro a ha
  have hmem : ({a} : Set G) ∈ (pure h : Ultrafilter G) + p := by rw [ha]; exact rfl
  rw [mem_pure_add] at hmem
  have h1 : ({a - h} : Set G) ∈ p := by
    refine Filter.mem_of_superset hmem (fun z hz => ?_)
    have h3 : h + z = a := hz
    rw [mem_singleton_iff, ← h3]; abel
  obtain ⟨y, _, h2⟩ := Ultrafilter.eq_pure_of_finite_mem (finite_singleton _) h1
  exact hp y h2

/-- The null points are the points of the subgroup generated by the principal images. -/
theorem pure_mem_iff (S : Set (Ultrafilter G)) (hsel : ∀ u ∈ S, IsSel u)
    (hiso : ∀ u ∈ S, ∀ v ∈ S, u ≠ v → ¬ Iso u v) (g : G) :
    (pure g : Filter G) ∈ genFam (ultraGen S) ↔ g ∈ Hgen S := by
  refine ⟨fun hg => ?_, pure_mem_of_mem_Hgen S⟩
  obtain ⟨h, hh, w, hw, hW⟩ := exists_decomp S hsel hiso (pure g) (by rwa [Ultrafilter.coe_pure])
  have hw0 : w = [] := by
    by_contra hne
    exact free_pure_add h _ (pw_free1 S w hw hne) g hW.symm
  subst hw0
  have h1 : (pure g : Ultrafilter G) = pure h := by
    rw [hW]
    show (pure h : Ultrafilter G) + pure 0 = pure h
    rw [pure_add_pure, add_zero]
  rw [Ultrafilter.pure_injective h1]
  exact hh

/-! ### The length of a word is determined -/

theorem length_le (S : Set (Ultrafilter G)) (hsel : ∀ u ∈ S, IsSel u) (hiso : ∀ u ∈ S, ∀ v ∈ S, u ≠ v → ¬ Iso u v)
    (w w' : List (Ultrafilter G × ℤ)) (hw : Free1 S w) (hw' : Free1 S w') (h1 h2 : G)
    (h : (pure h1 : Ultrafilter G) + pw w = pure h2 + pw w') : w'.length ≤ w.length := by
  classical
  by_contra hlt
  obtain ⟨e⟩ : Nonempty (ℕ ≃ G) := by
    have := Encodable.ofCountable G
    have := Denumerable.ofEncodableOfInfinite G
    exact ⟨(Denumerable.eqv G).symm⟩
  set U : Finset (Ultrafilter G) := ((w ++ w').map Prod.fst).toFinset with hU
  have hUS : ∀ u ∈ U, u ∈ S := by
    intro u hu
    rw [hU, List.mem_toFinset, List.mem_map] at hu
    obtain ⟨x, hx, rfl⟩ := hu
    rcases List.mem_append.1 hx with h' | h'
    · exact (hw x h').1
    · exact (hw' x h').1
  have hwU : ∀ x ∈ w, x.1 ∈ U := fun x hx => by
    rw [hU, List.mem_toFinset]
    exact List.mem_map.2 ⟨x, List.mem_append_left _ hx, rfl⟩
  have hw'U : ∀ x ∈ w', x.1 ∈ U := fun x hx => by
    rw [hU, List.mem_toFinset]
    exact List.mem_map.2 ⟨x, List.mem_append_right _ hx, rfl⟩
  let uu : Fin U.card → Ultrafilter G := fun k => (U.equivFin.symm k).1
  have huuS : ∀ k, uu k ∈ S := fun k => hUS _ (U.equivFin.symm k).2
  have huuinj : Function.Injective uu := fun a b hab => U.equivFin.symm.injective (Subtype.ext hab)
  let om : Fin U.card → Ultrafilter ℕ := fun k => (uu k).map e.symm
  have homsel : ∀ k, IsSel (om k) := fun k =>
    isSel_map_of_injective (hsel _ (huuS k)) e.symm e.symm.injective
  have homiso : ∀ k k', k ≠ k' → ¬ Iso (om k) (om k') := by
    rintro k k' hkk' ⟨π, hπ⟩
    refine hiso _ (huuS k) _ (huuS k') (fun h => hkk' (huuinj h)) ⟨(e.symm.trans π).trans e, ?_⟩
    have h2 := congrArg (Ultrafilter.map e) hπ
    simp only [om, Ultrafilter.map_map] at h2
    have h3 : (e : ℕ → G) ∘ (e.symm : G → ℕ) = id := by funext x; simp
    rw [h3, Ultrafilter.map_id] at h2
    exact h2
  set n : ℕ := ((w ++ w').map (fun x => x.2.natAbs)).sum with hn
  have hbound : ∀ x ∈ w ++ w', x.2.natAbs ≤ n := fun x hx =>
    List.le_sum_of_mem (List.mem_map.2 ⟨x, hx, rfl⟩)
  set L : ℕ := w.length + w'.length with hL
  set D : Finset ℤ := Finset.Icc (-(2 * (n : ℤ))) (2 * (n : ℤ)) with hD
  -- the principal values
  let val : Fin U.card × ℤ → G := fun p =>
    if hp : ∃ a, Img (uu p.1, p.2) = pure a then Classical.choose hp else 0
  set V : Finset G := insert 0 ((Finset.univ ×ˢ D).image val) with hV
  set K : Finset G := (Fintype.piFinset (fun _ : Fin L => V)).image (fun v => h2 - h1 - ∑ i, v i) with hK
  have hrel : ∀ m : ℕ, ∀ σ : Fin (m + 1) → Fin U.card, ∀ d : Fin (m + 1) → ℤ, ∀ κ0 : G,
      (∀ l a, Img (uu (σ l), d l) ≠ pure a) → ∃ B : Fin U.card → Set ℕ, (∀ k, B k ∈ om k) ∧
        ∀ y : Fin (m + 1) → ℕ, StrictMono y → (∀ i, y i ∈ B (σ i)) → ∑ l, d l • e (y l) ≠ κ0 := by
    intro m σ d κ0 hd
    have hnl : ¬ Large (m + 1) (fun i => om (σ i)) {y : Fin (m + 1) → ℕ | ∑ l, d l • e (y l) = κ0} := by
      rw [large_snoc]
      have hempty : {p : Fin m → ℕ | {z : ℕ | (Fin.snoc p z : Fin (m + 1) → ℕ) ∈
          {y : Fin (m + 1) → ℕ | ∑ l, d l • e (y l) = κ0}} ∈ om (σ (Fin.last m))} = ∅ := by
        refine eq_empty_of_forall_notMem (fun p hp => ?_)
        have h3 : {z : ℕ | (Fin.snoc p z : Fin (m + 1) → ℕ) ∈
            {y : Fin (m + 1) → ℕ | ∑ l, d l • e (y l) = κ0}} ∈ om (σ (Fin.last m)) := hp
        have h4 : ({κ0 - ∑ l : Fin m, d l.castSucc • e (p l)} : Set G)
            ∈ Img (uu (σ (Fin.last m)), d (Fin.last m)) := by
          show {x : G | d (Fin.last m) • x ∈ ({κ0 - ∑ l : Fin m, d l.castSucc • e (p l)} : Set G)}
            ∈ uu (σ (Fin.last m))
          have h5 : e.symm ⁻¹' {z : ℕ | (Fin.snoc p z : Fin (m + 1) → ℕ) ∈
              {y : Fin (m + 1) → ℕ | ∑ l, d l • e (y l) = κ0}} ∈ uu (σ (Fin.last m)) := h3
          refine Filter.mem_of_superset h5 (fun x hx => ?_)
          have h6 : ∑ l, d l • e ((Fin.snoc p (e.symm x) : Fin (m + 1) → ℕ) l) = κ0 := hx
          rw [Fin.sum_univ_castSucc] at h6
          simp only [Fin.snoc_castSucc, Fin.snoc_last, Equiv.apply_symm_apply] at h6
          show d (Fin.last m) • x = κ0 - ∑ l : Fin m, d l.castSucc • e (p l)
          rw [← h6, add_sub_cancel_left]
        obtain ⟨a, _, h7⟩ := Ultrafilter.eq_pure_of_finite_mem (finite_singleton _) h4
        exact hd (Fin.last m) a h7
      rw [hempty]
      exact not_large_empty m _
    exact tuples om homsel homiso (m + 1) σ _ hnl
  have hrel' : ∀ k : Fin U.card, ∃ C ∈ om k, ∀ m < L, ∀ σ : Fin (m + 1) → Fin U.card, ∀ d : Fin (m + 1) → ℤ,
      (∀ l, d l ∈ D) → ∀ κ0 ∈ K, ∀ hd : (∀ l a, Img (uu (σ l), d l) ≠ pure a),
        C ⊆ Classical.choose (hrel m σ d κ0 hd) k := by
    intro k
    have h3 : ∀ m : ℕ, (⋂ σ ∈ (Finset.univ : Finset (Fin (m + 1) → Fin U.card)),
        ⋂ d ∈ Fintype.piFinset (fun _ : Fin (m + 1) => D), ⋂ κ0 ∈ K,
          (if hd : (∀ l a, Img (uu (σ l), d l) ≠ pure a) then Classical.choose (hrel m σ d κ0 hd) k else univ))
        ∈ (om k : Filter ℕ) := by
      intro m
      refine (Filter.biInter_finset_mem _).2 (fun σ _ => (Filter.biInter_finset_mem _).2 (fun d _ =>
        (Filter.biInter_finset_mem _).2 (fun κ0 _ => ?_)))
      split_ifs with hd
      · exact (Classical.choose_spec (hrel m σ d κ0 hd)).1 k
      · exact Filter.univ_mem
    refine ⟨_, (Filter.biInter_finset_mem (Finset.range L)).2 (fun m _ => h3 m), ?_⟩
    intro m hm σ d hdD κ0 hκ hd x hx
    have h4 := mem_iInter₂.1 hx m (Finset.mem_range.2 hm)
    have h5 := mem_iInter₂.1 (mem_iInter₂.1 (mem_iInter₂.1 h4 σ (Finset.mem_univ σ)) d
      (Fintype.mem_piFinset.2 hdD)) κ0 hκ
    rw [dif_pos hd] at h5
    exact h5
  choose C1 hC1mem hC1 using hrel'
  have hdisj : ∃ C2 : Fin U.card → Set ℕ, (∀ k, C2 k ∈ om k) ∧ ∀ k k', ∀ x ∈ C2 k, x ∈ C2 k' → k = k' := by
    have h3 : ∀ k k' : Fin U.card, ∃ A : Set ℕ, A ∈ om k ∧ (k ≠ k' → Aᶜ ∈ om k') := by
      intro k k'
      by_cases hkk : k = k'
      · exact ⟨univ, Filter.univ_mem, fun h => absurd hkk h⟩
      have hne : om k ≠ om k' := fun h => homiso k k' hkk (h ▸ ⟨Equiv.refl ℕ, by
        rw [show ((Equiv.refl ℕ : Equiv.Perm ℕ) : ℕ → ℕ) = id from rfl, Ultrafilter.map_id]⟩)
      have : ∃ A, A ∈ om k ∧ A ∉ om k' := by
        by_contra h
        refine hne (Ultrafilter.coe_le_coe.1 (fun A hA => ?_)).symm
        by_contra hn'
        exact h ⟨A, hA, hn'⟩
      obtain ⟨A, hA, hA'⟩ := this
      exact ⟨A, hA, fun _ => Ultrafilter.compl_mem_iff_notMem.2 hA'⟩
    choose A hA hAc using h3
    refine ⟨fun k => ⋂ k' ∈ (Finset.univ : Finset (Fin U.card)), (A k k' ∩ if k = k' then univ else (A k' k)ᶜ),
      fun k => ?_, fun k k' x hx hx' => ?_⟩
    · refine (Filter.biInter_finset_mem _).2 (fun k' _ => Filter.inter_mem (hA k k') ?_)
      split_ifs with h
      · exact Filter.univ_mem
      · exact hAc k' k (Ne.symm h)
    · by_contra hne
      have h4 := (mem_iInter₂.1 hx k' (Finset.mem_univ _)).2
      rw [if_neg hne] at h4
      exact h4 (mem_iInter₂.1 hx' k (Finset.mem_univ _)).1
  obtain ⟨C2, hC2mem, hC2⟩ := hdisj
  let Z : Fin U.card → Set ℕ := fun k => {y | ∀ d ∈ D, (∃ a, Img (uu k, d) = pure a) → d • e y = val (k, d)}
  have hZmem : ∀ k, Z k ∈ om k := by
    intro k
    have h3 : (⋂ d ∈ D, {y : ℕ | (∃ a, Img (uu k, d) = pure a) → d • e y = val (k, d)}) ∈ (om k : Filter ℕ) := by
      refine (Filter.biInter_finset_mem D).2 (fun d _ => ?_)
      by_cases hd : ∃ a, Img (uu k, d) = pure a
      · have hval : val (k, d) = Classical.choose hd := dif_pos hd
        have h4 : ({val (k, d)} : Set G) ∈ Img (uu k, d) := by
          have h5 := Classical.choose_spec hd
          rw [hval]
          have h6 : ∀ p : Ultrafilter G, p = pure (Classical.choose hd) → ({Classical.choose hd} : Set G) ∈ p :=
            fun p hp => by rw [hp]; exact Set.mem_singleton (Classical.choose hd)
          exact h6 _ h5
        have h6 : {x : G | d • x ∈ ({val (k, d)} : Set G)} ∈ uu k := h4
        show e.symm ⁻¹' {y : ℕ | (∃ a, Img (uu k, d) = pure a) → d • e y = val (k, d)} ∈ uu k
        refine Filter.mem_of_superset h6 (fun x hx => ?_)
        intro _
        show d • e (e.symm x) = val (k, d)
        rw [Equiv.apply_symm_apply]; exact hx
      · exact Filter.mem_of_superset Filter.univ_mem (fun y _ h => absurd h hd)
    exact Filter.mem_of_superset h3 (fun y hy d hd => mem_iInter₂.1 hy d hd)
  let C : Fin U.card → Set ℕ := fun k => C1 k ∩ C2 k ∩ Z k
  have hCmem : ∀ k, C k ∈ om k := fun k => Filter.inter_mem (Filter.inter_mem (hC1mem k) (hC2mem k)) (hZmem k)
  let ix : (x : Ultrafilter G) → x ∈ U → Fin U.card := fun x hx => U.equivFin ⟨x, hx⟩
  have huix : ∀ x (hx : x ∈ U), uu (ix x hx) = x := by
    intro x hx
    show (U.equivFin.symm (U.equivFin ⟨x, hx⟩)).1 = x
    rw [Equiv.symm_apply_apply]
  let κ : Fin w.length → Fin U.card := fun i => ix (w.get i).1 (hwU _ (List.get_mem _ _))
  let κ' : Fin w'.length → Fin U.card := fun i => ix (w'.get i).1 (hw'U _ (List.get_mem _ _))
  have huκ' : ∀ i, uu (κ' i) = (w'.get i).1 := fun i => huix _ _
  let cf : Fin w.length → ℤ := fun i => (w.get i).2
  let cf' : Fin w'.length → ℤ := fun i => (w'.get i).2
  have hmemE : ∀ (v : List (Ultrafilter G × ℤ)) (kk : Fin v.length → Fin U.card),
      (∀ i, uu (kk i) = (v.get i).1) →
      {x : G | ∃ z : Fin v.length → ℕ, StrictMono z ∧ (∀ i, z i ∈ C (kk i)) ∧ ∑ i, (v.get i).2 • e (z i) = x}
        ∈ pw v := by
    intro v kk hkk
    have h3 : List.ofFn (fun i => ((v.get i).1, (v.get i).2)) = v := by
      exact List.ofFn_get v
    have h4 := mem_pw_ofFn e v.length (fun i => (v.get i).1) (fun i => (v.get i).2)
      {x : G | ∃ z : Fin v.length → ℕ, StrictMono z ∧ (∀ i, z i ∈ C (kk i)) ∧ ∑ i, (v.get i).2 • e (z i) = x}
    rw [h3] at h4
    rw [h4]
    have h5 : (fun i => ((v.get i).1).map e.symm) = fun i => om (kk i) := by
      funext i
      show ((v.get i).1).map e.symm = (uu (kk i)).map e.symm
      rw [hkk i]
    rw [h5]
    refine large_mono _ _ (fun y hy => ?_)
      (large_inc v.length (fun i => om (kk i)) (fun i => (homsel (kk i)).1) (fun i => C (kk i))
        (fun i => hCmem (kk i)) 0)
    exact ⟨y, hy.1, hy.2.1, rfl⟩
  have hE := hmemE w κ (fun i => huix _ _)
  have hE' := hmemE w' κ' huκ'
  have hT : {a : G | -h1 + a ∈ {x : G | ∃ z : Fin w.length → ℕ, StrictMono z ∧ (∀ i, z i ∈ C (κ i))
      ∧ ∑ i, cf i • e (z i) = x}} ∈ (pure h1 + pw w : Ultrafilter G) := by
    rw [mem_pure_add]
    refine Filter.mem_of_superset hE (fun x hx => ?_)
    simp only [mem_setOf_eq, neg_add_cancel_left]
    exact hx
  have hT' : {a : G | -h2 + a ∈ {x : G | ∃ z : Fin w'.length → ℕ, StrictMono z ∧ (∀ i, z i ∈ C (κ' i))
      ∧ ∑ i, cf' i • e (z i) = x}} ∈ (pure h2 + pw w' : Ultrafilter G) := by
    rw [mem_pure_add]
    refine Filter.mem_of_superset hE' (fun x hx => ?_)
    simp only [mem_setOf_eq, neg_add_cancel_left]
    exact hx
  rw [← h] at hT'
  obtain ⟨a, haT, haT'⟩ := Ultrafilter.nonempty_of_mem
    (Filter.inter_mem (f := ((pure h1 + pw w : Ultrafilter G) : Filter G)) hT hT')
  obtain ⟨z, hzm, hzC, hzx⟩ := haT
  obtain ⟨z', hzm', hzC', hzx'⟩ := haT'
  set Y : Finset ℕ := Finset.univ.image z ∪ Finset.univ.image z' with hY
  let d : ℕ → ℤ := fun y => (∑ i ∈ Finset.univ.filter (fun i => z i = y), cf i)
    - ∑ i ∈ Finset.univ.filter (fun i => z' i = y), cf' i
  have hsum : ∑ y ∈ Y, d y • e y = h2 - h1 := by
    have key : ∀ (m : ℕ) (zz : Fin m → ℕ) (cc : Fin m → ℤ), (∀ i, zz i ∈ Y) →
        ∑ y ∈ Y, (∑ i ∈ Finset.univ.filter (fun i => zz i = y), cc i) • e y = ∑ i, cc i • e (zz i) := by
      intro m zz cc hmem
      rw [← Finset.sum_fiberwise_of_maps_to (fun i (_ : i ∈ Finset.univ) => hmem i) (fun i => cc i • e (zz i))]
      refine Finset.sum_congr rfl (fun y _ => ?_)
      rw [Finset.sum_smul]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      rw [(Finset.mem_filter.1 hi).2]
    have h3 := key _ z cf (fun i => Finset.mem_union_left _ (Finset.mem_image_of_mem z (Finset.mem_univ i)))
    have h4 := key _ z' cf' (fun i => Finset.mem_union_right _ (Finset.mem_image_of_mem z' (Finset.mem_univ i)))
    simp only [d, sub_smul]
    rw [Finset.sum_sub_distrib, h3, h4, hzx, hzx']
    abel
  have hdsmall : ∀ y, d y ∈ D := by
    intro y
    have one : ∀ (v : List (Ultrafilter G × ℤ)), (∀ x ∈ v, x ∈ w ++ w') → ∀ (zz : Fin v.length → ℕ),
        Function.Injective zz → |∑ i ∈ Finset.univ.filter (fun i => zz i = y), (v.get i).2| ≤ (n : ℤ) := by
      intro v hv zz hzz
      by_cases hne : (Finset.univ.filter (fun i => zz i = y)).Nonempty
      · obtain ⟨i, hi⟩ := hne
        have h3 : Finset.univ.filter (fun i => zz i = y) = {i} := by
          ext j
          rw [Finset.mem_filter, Finset.mem_singleton]
          refine ⟨fun h => hzz (h.2.trans (Finset.mem_filter.1 hi).2.symm), fun h => ?_⟩
          rw [h]; exact Finset.mem_filter.1 hi
        rw [h3, Finset.sum_singleton]
        have h4 := hbound _ (hv _ (List.get_mem v i))
        rw [Int.abs_eq_natAbs]
        exact_mod_cast h4
      · rw [Finset.not_nonempty_iff_eq_empty.1 hne]
        simp
    have h4 : |∑ i ∈ Finset.univ.filter (fun i => z i = y), cf i| ≤ (n : ℤ) :=
      one w (fun x hx => List.mem_append_left _ hx) z hzm.injective
    have h5 : |∑ i ∈ Finset.univ.filter (fun i => z' i = y), cf' i| ≤ (n : ℤ) :=
      one w' (fun x hx => List.mem_append_right _ hx) z' hzm'.injective
    have h6 := abs_le.1 h4
    have h7 := abs_le.1 h5
    refine Finset.mem_Icc.2 ?_
    show -(2 * (n : ℤ)) ≤ (∑ i ∈ Finset.univ.filter (fun i => z i = y), cf i)
        - (∑ i ∈ Finset.univ.filter (fun i => z' i = y), cf' i) ∧
      (∑ i ∈ Finset.univ.filter (fun i => z i = y), cf i)
        - (∑ i ∈ Finset.univ.filter (fun i => z' i = y), cf' i) ≤ 2 * (n : ℤ)
    omega
  have hty : ∀ y ∈ Y, ∃ k, y ∈ C k := by
    intro y hy
    rcases Finset.mem_union.1 hy with h3 | h3
    · obtain ⟨i, _, hi⟩ := Finset.mem_image.1 h3
      exact ⟨κ i, hi ▸ hzC i⟩
    · obtain ⟨i, _, hi⟩ := Finset.mem_image.1 h3
      exact ⟨κ' i, hi ▸ hzC' i⟩
  have hty' : ∀ y, ∃ k : Option (Fin U.card), y ∈ Y → ∃ k0, k = some k0 ∧ y ∈ C k0 := by
    intro y
    by_cases hy : y ∈ Y
    · obtain ⟨k, hk⟩ := hty y hy
      exact ⟨some k, fun _ => ⟨k, rfl, hk⟩⟩
    · exact ⟨none, fun h => absurd h hy⟩
  have huniq : ∀ y k k', y ∈ C k → y ∈ C k' → k = k' := fun y k k' h3 h4 => hC2 k k' y h3.1.2 h4.1.2
  -- the points whose collected coefficient has a nonprincipal image
  set T : Finset ℕ := Y.filter (fun y => ∃ k, y ∈ C k ∧ ∀ a, Img (uu k, d y) ≠ pure a) with hTdef
  -- a point of the longer word that does not occur in the shorter one
  have hnew : ∃ j, z' j ∉ Finset.univ.image z := by
    by_contra hall
    have h3 : Finset.univ.image z' ⊆ Finset.univ.image z := fun y hy => by
      obtain ⟨j, _, rfl⟩ := Finset.mem_image.1 hy
      by_contra h4
      exact hall ⟨j, h4⟩
    have h5 := Finset.card_le_card h3
    rw [Finset.card_image_of_injective _ hzm'.injective, Finset.card_image_of_injective _ hzm.injective] at h5
    simp at h5
    exact hlt h5
  have hTne : T.Nonempty := by
    obtain ⟨j, hj⟩ := hnew
    have hyY : z' j ∈ Y := Finset.mem_union_right _ (Finset.mem_image_of_mem z' (Finset.mem_univ j))
    refine ⟨z' j, Finset.mem_filter.2 ⟨hyY, κ' j, hzC' j, ?_⟩⟩
    have h3 : Finset.univ.filter (fun i => z i = z' j) = ∅ :=
      Finset.filter_eq_empty_iff.2 (fun i _ h => hj (Finset.mem_image.2 ⟨i, Finset.mem_univ _, h⟩))
    have h4 : Finset.univ.filter (fun i => z' i = z' j) = {j} := by
      ext i
      rw [Finset.mem_filter, Finset.mem_singleton]
      exact ⟨fun h => hzm'.injective h.2, fun h => ⟨Finset.mem_univ _, by rw [h]⟩⟩
    have h5 : d (z' j) = -cf' j := by
      show (∑ i ∈ Finset.univ.filter (fun i => z i = z' j), cf i)
        - (∑ i ∈ Finset.univ.filter (fun i => z' i = z' j), cf' i) = _
      rw [h3, h4, Finset.sum_empty, Finset.sum_singleton, zero_sub]
    rw [h5]
    intro a ha
    have h6 : ({-a} : Set G) ∈ Img (uu (κ' j), cf' j) := by
      have h7 : ({a} : Set G) ∈ Img (uu (κ' j), -cf' j) := by rw [ha]; exact rfl
      have h8 : {x : G | (-cf' j) • x ∈ ({a} : Set G)} ∈ uu (κ' j) := h7
      show {x : G | cf' j • x ∈ ({-a} : Set G)} ∈ uu (κ' j)
      refine Filter.mem_of_superset h8 (fun x hx => ?_)
      have h9 : (-cf' j) • x = a := hx
      show cf' j • x = -a
      rw [← h9, neg_smul, neg_neg]
    obtain ⟨b, _, h10⟩ := Ultrafilter.eq_pure_of_finite_mem (finite_singleton _) h6
    have h11 := (hw' _ (List.get_mem w' j)).2 b
    apply h11
    show Img ((w'.get j).1, cf' j) = pure b
    rw [← huκ' j]; exact h10
  obtain ⟨m, hm⟩ : ∃ m, T.card = m + 1 := ⟨T.card - 1, by have := hTne.card_pos; omega⟩
  have hYL : Y.card ≤ L := by
    refine (Finset.card_union_le _ _).trans (Nat.add_le_add ?_ ?_)
    · exact Finset.card_image_le.trans (by simp)
    · exact Finset.card_image_le.trans (by simp)
  have hmL : m < L := by
    have h3 : T.card ≤ Y.card := Finset.card_filter_le _ _
    omega
  let t : Fin (m + 1) → ℕ := fun l => T.orderEmbOfFin hm l
  have htmem : ∀ l, t l ∈ T := fun l => Finset.orderEmbOfFin_mem _ _ _
  have htm : StrictMono t := (T.orderEmbOfFin hm).strictMono
  have hσ : ∀ l, ∃ k, t l ∈ C k ∧ ∀ a, Img (uu k, d (t l)) ≠ pure a := fun l => (Finset.mem_filter.1 (htmem l)).2
  choose σ hσC hσne using hσ
  -- the other points contribute a constant from `K`
  set R : Finset ℕ := Y \ T with hR
  have hRval : ∀ y ∈ R, d y • e y ∈ V := by
    intro y hy
    obtain ⟨hyY, hyT⟩ := Finset.mem_sdiff.1 hy
    obtain ⟨k, hk⟩ := hty y hyY
    have h3 : ∃ a, Img (uu k, d y) = pure a := by
      by_contra h4
      exact hyT (Finset.mem_filter.2 ⟨hyY, k, hk, fun a ha => h4 ⟨a, ha⟩⟩)
    rw [hk.2 (d y) (hdsmall y) h3]
    exact Finset.mem_insert_of_mem (Finset.mem_image.2 ⟨(k, d y),
      Finset.mem_product.2 ⟨Finset.mem_univ _, hdsmall y⟩, rfl⟩)
  have hκK : h2 - h1 - ∑ y ∈ R, d y • e y ∈ K := by
    have hRL : R.card ≤ L := (Finset.card_le_card Finset.sdiff_subset).trans hYL
    have hpad : ∃ v : Fin L → G, (∀ i, v i ∈ V) ∧ ∑ i, v i = ∑ y ∈ R, d y • e y := by
      let f : ℕ → G := fun i => if hi : i < R.card then
        d (R.equivFin.symm ⟨i, hi⟩).1 • e (R.equivFin.symm ⟨i, hi⟩).1 else 0
      refine ⟨fun i => f i, fun i => ?_, ?_⟩
      · show f i ∈ V
        by_cases hi : (i : ℕ) < R.card
        · simp only [f, dif_pos hi]
          exact hRval _ (R.equivFin.symm ⟨i, hi⟩).2
        · simp only [f, dif_neg hi]
          exact Finset.mem_insert_self _ _
      · rw [Fin.sum_univ_eq_sum_range f L]
        have h3 : ∑ i ∈ Finset.range L, f i = ∑ i ∈ Finset.range R.card, f i := by
          refine (Finset.sum_subset (Finset.range_mono hRL) (fun i _ hi => ?_)).symm
          rw [Finset.mem_range] at hi
          simp only [f, dif_neg hi]
        rw [h3, ← Fin.sum_univ_eq_sum_range f R.card]
        have h4 : ∀ i : Fin R.card, f i = d (R.equivFin.symm i).1 • e (R.equivFin.symm i).1 := by
          intro i
          simp only [f, dif_pos i.2, Fin.eta]
        simp only [h4]
        rw [Equiv.sum_comp R.equivFin.symm (fun y : R => d y.1 • e y.1)]
        exact Finset.sum_coe_sort R (fun y => d y • e y)
    obtain ⟨v, hv, hvs⟩ := hpad
    exact Finset.mem_image.2 ⟨v, Fintype.mem_piFinset.2 hv, by rw [hvs]⟩
  let dd : Fin (m + 1) → ℤ := fun l => d (t l)
  have hddD : ∀ l, dd l ∈ D := fun l => hdsmall _
  have hsub : ∀ l, t l ∈ Classical.choose (hrel m σ dd _ hσne) (σ l) := fun l =>
    hC1 (σ l) m hmL σ dd hddD _ hκK hσne (hσC l).1.1
  refine (Classical.choose_spec (hrel m σ dd _ hσne)).2 t htm hsub ?_
  have himg : Finset.univ.image t = T := T.image_orderEmbOfFin_univ hm
  have h3 : ∑ l, dd l • e (t l) = ∑ y ∈ T, d y • e y := by
    rw [← himg, Finset.sum_image (fun a _ b _ hab => htm.injective hab)]
  have h4 : ∑ y ∈ R, d y • e y + ∑ y ∈ T, d y • e y = ∑ y ∈ Y, d y • e y :=
    Finset.sum_sdiff (Finset.filter_subset _ _)
  rw [h3, ← hsum, ← h4, add_sub_cancel_left]

/-! ### The neighbourhood filters of group topologies -/

/-- The neighbourhood filters of group topologies among the null filters are the principal filters of the finite
subgroups of null points. -/
theorem nbhd_iff (S : Set (Ultrafilter G)) (hsel : ∀ u ∈ S, IsSel u) (hiso : ∀ u ∈ S, ∀ v ∈ S, u ≠ v → ¬ Iso u v)
    (N : Filter G) : (IsNbhdFilter N ∧ N ∈ genFam (ultraGen S)) ↔
      ∃ F : AddSubgroup G, (F : Set G).Finite ∧ F ≤ Hgen S ∧ N = 𝓟 (F : Set G) := by
  classical
  set C := genFam (ultraGen S) with hCdef
  have hC : NullFamily C := genFam_nullFamily _
  constructor
  · rintro ⟨hN, hNC⟩
    set X : Set (Ultrafilter G) := {U | (U : Filter G) ≤ N ∧ ∀ a, U ≠ pure a} with hX
    have hXe : X = ∅ := by
      by_contra hne
      have hXne : X.Nonempty := Set.nonempty_iff_ne_empty.2 hne
      have hXclosed : IsClosed X := by
        have h1 : X = (⋂ s ∈ N, {U : Ultrafilter G | s ∈ U}) ∩ ⋂ a : G, {U : Ultrafilter G | ({a}ᶜ : Set G) ∈ U} := by
          ext U
          rw [mem_inter_iff, mem_iInter₂, mem_iInter]
          refine and_congr Iff.rfl (forall_congr' (fun a => ?_))
          show U ≠ pure a ↔ ({a}ᶜ : Set G) ∈ U
          rw [Ultrafilter.compl_mem_iff_notMem]
          refine not_congr ⟨fun h => by rw [h]; exact rfl, fun h => ?_⟩
          obtain ⟨b, hb, hU⟩ := Ultrafilter.eq_pure_of_finite_mem (finite_singleton a) h
          rw [hU, mem_singleton_iff.1 hb]
        rw [h1]
        exact (isClosed_biInter (fun s _ => ultrafilter_isClosed_basic s)).inter
          (isClosed_iInter (fun a => ultrafilter_isClosed_basic _))
      have hword : ∀ U ∈ X, ∃ h ∈ Hgen S, ∃ w, Free1 S w ∧ w ≠ [] ∧ U = pure h + pw w := by
        intro U hU
        obtain ⟨h, hh, w, hw, hUw⟩ := exists_decomp S hsel hiso U (hC.finer _ hNC _ hU.1 U.neBot)
        refine ⟨h, hh, w, hw, fun h0 => ?_, hUw⟩
        refine hU.2 h ?_
        rw [hUw, h0]
        show (pure h : Ultrafilter G) + pure 0 = pure h
        rw [pure_add_pure, add_zero]
      have hsum : ∀ (a b : G) (w w' : List (Ultrafilter G × ℤ)),
          ((pure a : Ultrafilter G) + pw w) + (pure b + pw w') = pure (a + b) + pw (w ++ w') := by
        intro a b w w'
        rw [pw_append, ← pure_add_pure, add_assoc, add_assoc, ← add_assoc (pw w), ← pure_add_comm b (pw w), add_assoc]
      have hfree : ∀ w w' : List (Ultrafilter G × ℤ), Free1 S w → Free1 S w' → Free1 S (w ++ w') := by
        intro w w' h h' x hx
        rcases List.mem_append.1 hx with h1 | h1
        · exact h x h1
        · exact h' x h1
      have hXadd : ∀ V ∈ X, ∀ V' ∈ X, V + V' ∈ X := by
        intro V hV V' hV'
        refine ⟨fun s hs => ?_, ?_⟩
        · obtain ⟨B, hB, hBs⟩ := hN.halve s hs
          show s ∈ V + V'
          rw [mem_add]
          refine Filter.mem_of_superset (hV.1 hB) (fun m hm => ?_)
          exact Filter.mem_of_superset (hV'.1 hB) (fun z hz => hBs m hm z hz)
        · obtain ⟨a, _, w, hw, hwne, hVw⟩ := hword V hV
          obtain ⟨b, _, w', hw', _, hV'w⟩ := hword V' hV'
          rw [hVw, hV'w, hsum]
          exact free_pure_add _ _ (pw_free1 S _ (hfree w w' hw hw') (fun h => hwne (List.append_eq_nil_iff.1 h).1))
      obtain ⟨p, hpX, hpp⟩ := exists_idempotent_in_compact_add_subsemigroup
        (M := Ultrafilter G) Ultrafilter.continuous_add_left X hXne hXclosed.isCompact hXadd
      obtain ⟨a, _, w, hw, hwne, hpw⟩ := hword p hpX
      have h1 : (pure (a + a) : Ultrafilter G) + pw (w ++ w) = pure a + pw w := by
        rw [← hsum, ← hpw, hpp]
      have h2 := length_le S hsel hiso w (w ++ w) hw (hfree w w hw hw) a (a + a) h1.symm
      rw [List.length_append] at h2
      have h3 := List.length_pos_iff.2 hwne
      omega
    have hprin : ∀ U : Ultrafilter G, (U : Filter G) ≤ N → ∃ a, U = pure a := by
      intro U hU
      by_contra h
      have h1 : U ∈ X := ⟨hU, fun a ha => h ⟨a, ha⟩⟩
      rw [hXe] at h1
      exact h1
    have hpure : ∀ g : G, (pure g : Filter G) ≤ N ↔ ∀ s ∈ N, g ∈ s :=
      fun g => ⟨fun h s hs => h hs, fun h s hs => h s hs⟩
    set F0 : Set G := {g | ∀ s ∈ N, g ∈ s} with hF0
    have hfin : F0.Finite := by
      by_contra hinf
      have hne : (𝓟 F0 ⊓ Filter.cofinite).NeBot := by
        have : Set.Infinite F0 := hinf
        rw [inf_comm]
        exact this.cofinite_inf_principal_neBot
      set V : Ultrafilter G := Ultrafilter.of (𝓟 F0 ⊓ Filter.cofinite) with hVdef
      have hV := Ultrafilter.of_le (𝓟 F0 ⊓ Filter.cofinite)
      have hVN : (V : Filter G) ≤ N := by
        intro s hs
        have h1 : F0 ∈ V := hV.trans inf_le_left (mem_principal_self _)
        exact Filter.mem_of_superset h1 (fun g hg => hg s hs)
      obtain ⟨a, ha⟩ := hprin V hVN
      have h2 : ({a}ᶜ : Set G) ∈ V := hV.trans inf_le_right (finite_singleton a).compl_mem_cofinite
      rw [ha] at h2
      exact h2 rfl
    let F : AddSubgroup G :=
      { carrier := F0
        zero_mem' := fun s hs => hN.zero_mem s hs
        add_mem' := fun {a b} ha hb s hs => by
          obtain ⟨B, hB, hBs⟩ := hN.halve s hs
          exact hBs a (ha B hB) b (hb B hB)
        neg_mem' := fun {a} ha s hs => by
          have h1 := ha _ (hN.neg_mem s hs)
          exact h1 }
    refine ⟨F, hfin, fun g hg => ?_, ?_⟩
    · refine (pure_mem_iff S hsel hiso g).1 ?_
      exact hC.finer _ hNC _ ((hpure g).2 hg) inferInstance
    · refine le_antisymm (Filter.le_iff_ultrafilter.2 (fun U hU => ?_)) (fun s hs => ?_)
      · obtain ⟨a, ha⟩ := hprin U hU
        rw [ha, Ultrafilter.coe_pure, Filter.pure_le_principal]
        refine (hpure a).1 ?_
        rwa [ha, Ultrafilter.coe_pure] at hU
      · exact Filter.mem_principal.2 (fun g hg => hg s hs)
  · rintro ⟨F, hFfin, hFH, rfl⟩
    refine ⟨⟨fun A hA => hA F.zero_mem, fun A hA => ?_, fun A hA => ?_⟩, ?_⟩
    · exact Filter.mem_principal.2 (fun x hx => hA (F.neg_mem hx))
    · exact ⟨F, mem_principal_self _, fun x hx y hy => hA (F.add_mem hx hy)⟩
    · have hne : (𝓟 (F : Set G)).NeBot := principal_neBot_iff.2 ⟨0, F.zero_mem⟩
      refine hC.ultra _ hne (fun U hU => ?_)
      have h1 : (F : Set G) ∈ U := hU (mem_principal_self _)
      obtain ⟨a, ha, hUa⟩ := Ultrafilter.eq_pure_of_finite_mem hFfin h1
      rw [hUa, Ultrafilter.coe_pure]
      exact pure_mem_of_mem_Hgen S (hFH ha)

/-- There is a coarsest group topology among those of `nbhd_iff` exactly when only finitely many null points have
finite order. -/
theorem exists_coarsest_iff (S : Set (Ultrafilter G)) (hsel : ∀ u ∈ S, IsSel u)
    (hiso : ∀ u ∈ S, ∀ v ∈ S, u ≠ v → ¬ Iso u v) :
    (∃ N0 : Filter G, (IsNbhdFilter N0 ∧ N0 ∈ genFam (ultraGen S)) ∧
        ∀ N : Filter G, IsNbhdFilter N → N ∈ genFam (ultraGen S) → N ≤ N0) ↔
      {g : G | g ∈ Hgen S ∧ IsOfFinAddOrder g}.Finite := by
  constructor
  · rintro ⟨N0, hN0, hmax⟩
    obtain ⟨F0, hF0, _, rfl⟩ := (nbhd_iff S hsel hiso N0).1 hN0
    refine hF0.subset (fun g hg => ?_)
    have h1 : IsNbhdFilter (𝓟 (AddSubgroup.zmultiples g : Set G)) ∧
        𝓟 (AddSubgroup.zmultiples g : Set G) ∈ genFam (ultraGen S) :=
      (nbhd_iff S hsel hiso _).2 ⟨_, finite_zmultiples.2 hg.2, AddSubgroup.zmultiples_le_of_mem hg.1, rfl⟩
    have h2 := hmax _ h1.1 h1.2
    exact Filter.principal_mono.1 h2 (AddSubgroup.mem_zmultiples g)
  · intro hfin
    let T : AddSubgroup G :=
      { carrier := {g : G | g ∈ Hgen S ∧ IsOfFinAddOrder g}
        zero_mem' := ⟨zero_mem _, IsOfFinAddOrder.zero⟩
        add_mem' := fun {a b} ha hb => ⟨add_mem ha.1 hb.1, (AddCommute.all a b).isOfFinAddOrder_add ha.2 hb.2⟩
        neg_mem' := fun {a} ha => ⟨neg_mem ha.1, ha.2.neg⟩ }
    refine ⟨𝓟 (T : Set G), (nbhd_iff S hsel hiso _).2 ⟨T, hfin, fun g hg => hg.1, rfl⟩, fun N hN hNC => ?_⟩
    obtain ⟨F, hF, hFH, rfl⟩ := (nbhd_iff S hsel hiso N).1 ⟨hN, hNC⟩
    refine Filter.principal_mono.2 (fun g hg => ⟨hFH hg, ?_⟩)
    have h1 : (AddSubgroup.zmultiples g : Set G).Finite := hF.subset (AddSubgroup.zmultiples_le_of_mem hg)
    exact finite_zmultiples.1 h1

/-- Under (S) there is a countable selective family on the group of finitely supported sequences of integers modulo
`4` for which there is no coarsest group topology of this kind. -/
theorem exists_no_coarsest (hS : Supply) :
    ∃ S : Set (Ultrafilter (ℕ →₀ ZMod 4)), S.Countable ∧ (∀ u ∈ S, IsSel u) ∧
      (∀ u ∈ S, ∀ v ∈ S, u ≠ v → ¬ Iso u v) ∧
      ¬ ∃ N0 : Filter (ℕ →₀ ZMod 4), (IsNbhdFilter N0 ∧ N0 ∈ genFam (ultraGen S)) ∧
        ∀ N : Filter (ℕ →₀ ZMod 4), IsNbhdFilter N → N ∈ genFam (ultraGen S) → N ≤ N0 := by
  classical
  obtain ⟨T, hsel, hiso, hcard⟩ := hS
  have hTinf : T.Infinite := by
    intro hfin
    have h1 : #T < ℵ₀ := Set.Finite.lt_aleph0 hfin
    exact absurd (lt_of_lt_of_le (lt_of_le_of_lt hcard h1) aleph0_le_continuum) (lt_irrefl _)
  let w : ℕ → Ultrafilter ℕ := fun k => (hTinf.natEmbedding T k).1
  have hwT : ∀ k, w k ∈ T := fun k => (hTinf.natEmbedding T k).2
  have hwinj : Function.Injective w := fun a b h =>
    (hTinf.natEmbedding T).injective (Subtype.ext h)
  let f : ℕ → ℕ → (ℕ →₀ ZMod 4) := fun k n => Finsupp.single k 1 + (2 : ℕ) • Finsupp.single n 1
  have hfinj : ∀ k, Function.Injective (f k) := by
    intro k n m h
    by_contra hnm
    have h1 := congrArg (fun x : ℕ →₀ ZMod 4 => x n) h
    simp only [f, Finsupp.add_apply, Finsupp.smul_apply, Finsupp.single_apply, if_true,
      if_neg (Ne.symm hnm), smul_zero, add_zero] at h1
    have h2 : (2 : ℕ) • (1 : ZMod 4) = 0 := by
      have h3 := add_left_cancel (a := if k = n then (1 : ZMod 4) else 0) (h1.trans (add_zero _).symm)
      exact h3
    exact absurd h2 (by decide)
  let u : ℕ → Ultrafilter (ℕ →₀ ZMod 4) := fun k => (w k).map (f k)
  have husel : ∀ k, IsSel (u k) := fun k => isSel_map_of_injective (hsel _ (hwT k)) (f k) (hfinj k)
  haveI : Infinite (ℕ →₀ ZMod 4) :=
    Infinite.of_injective (fun n => Finsupp.single n (1 : ZMod 4))
      (Finsupp.single_left_injective (by decide : (1 : ZMod 4) ≠ 0))
  obtain ⟨e⟩ : Nonempty (ℕ ≃ (ℕ →₀ ZMod 4)) := by
    have := Encodable.ofCountable (ℕ →₀ ZMod 4)
    have := Denumerable.ofEncodableOfInfinite (ℕ →₀ ZMod 4)
    exact ⟨(Denumerable.eqv _).symm⟩
  have hwu : ∀ k, Iso (w k) ((u k).map e.symm) := by
    intro k
    have h1 : (u k).map e.symm = (w k).map (e.symm ∘ f k) := Ultrafilter.map_map _ _ _
    rw [h1]
    exact iso_of_injOn (hsel _ (hwT k)).1 (e.symm ∘ f k) Filter.univ_mem
      ((e.symm.injective.comp (hfinj k)).injOn)
  have huiso : ∀ j k, j ≠ k → ¬ Iso (u j) (u k) := by
    rintro j k hjk ⟨π, hπ⟩
    have h1 : Iso ((u j).map e.symm) ((u k).map e.symm) := by
      refine ⟨(e.trans π).trans e.symm, ?_⟩
      have h2 : ((u j).map π).map e.symm = (u k).map e.symm := by rw [hπ]
      rw [Ultrafilter.map_map] at h2 ⊢
      rw [← h2]
      congr 1
      funext x
      simp
    have h3 := ((hwu j).trans h1).trans (hwu k).symm
    exact hiso _ (hwT j) _ (hwT k) (fun h => hjk (hwinj h)) h3
  have hSsel : ∀ v ∈ range u, IsSel v := by
    rintro _ ⟨k, rfl⟩; exact husel k
  have hSiso : ∀ v ∈ range u, ∀ v' ∈ range u, v ≠ v' → ¬ Iso v v' := by
    rintro _ ⟨j, rfl⟩ _ ⟨k, rfl⟩ hne
    exact huiso j k (fun h => hne (by rw [h]))
  refine ⟨range u, countable_range u, hSsel, hSiso, fun h => ?_⟩
  have hfin := (exists_coarsest_iff (range u) hSsel hSiso).1 h
  have h2four : ∀ k : ℕ, (2 : ℕ) • f k 0 = Finsupp.single k (2 : ZMod 4) ∧
      ∀ n, (2 : ℕ) • f k n = Finsupp.single k (2 : ZMod 4) := by
    intro k
    have h : ∀ n, (2 : ℕ) • f k n = Finsupp.single k (2 : ZMod 4) := by
      intro n
      have h4 : (4 : ℕ) • (Finsupp.single n (1 : ZMod 4)) = 0 := by
        rw [Finsupp.smul_single]
        have : (4 : ℕ) • (1 : ZMod 4) = 0 := by decide
        rw [this, Finsupp.single_zero]
      show (2 : ℕ) • (Finsupp.single k (1 : ZMod 4) + (2 : ℕ) • Finsupp.single n 1) = _
      rw [smul_add, smul_smul, show 2 * 2 = 4 from rfl, h4, add_zero, Finsupp.smul_single]
      congr 1
    exact ⟨h 0, h⟩
  have hmem : ∀ k : ℕ, Finsupp.single k (2 : ZMod 4) ∈ Hgen (range u) := by
    intro k
    refine AddSubgroup.subset_closure ⟨u k, mem_range_self k, 2, ?_⟩
    show (u k).map (fun z => (2 : ℤ) • z) = pure (Finsupp.single k (2 : ZMod 4))
    have h5 : (u k).map (fun z => (2 : ℤ) • z) = (w k).map (fun _ => Finsupp.single k (2 : ZMod 4)) := by
      show ((w k).map (f k)).map _ = _
      rw [Ultrafilter.map_map]
      congr 1
      funext n
      show (2 : ℤ) • f k n = _
      rw [show (2 : ℤ) = ((2 : ℕ) : ℤ) from rfl, natCast_zsmul]
      exact (h2four k).2 n
    rw [h5]
    refine Ultrafilter.coe_injective ?_
    rw [Ultrafilter.coe_map, Ultrafilter.coe_pure]
    exact Filter.map_const
  have htor : ∀ k : ℕ, IsOfFinAddOrder (Finsupp.single k (2 : ZMod 4)) := by
    intro k
    refine isOfFinAddOrder_iff_nsmul_eq_zero.2 ⟨2, by norm_num, ?_⟩
    rw [Finsupp.smul_single]
    have : (2 : ℕ) • (2 : ZMod 4) = 0 := by decide
    rw [this, Finsupp.single_zero]
  have hinj2 : Function.Injective (fun k : ℕ => Finsupp.single k (2 : ZMod 4)) :=
    Finsupp.single_left_injective (by decide : (2 : ZMod 4) ≠ 0)
  exact (infinite_range_of_injective hinj2) (hfin.subset (by
    rintro _ ⟨k, rfl⟩
    exact ⟨hmem k, htor k⟩))

end Null

end PG
