import LeanCheck.ChainK1

/-!
# No greatest nondiscrete TVG topology; nonuniqueness of maximal extensions
(HamelCharactersTVG_v18 Theorem 17.5 `thm:no-greatest`, Corollary 17.6 `cor:nonunique-maximal`)

For a rational subspace `E ⊂ ℝ` let `ρ_E` be the topology generated by the usual topology and the sets `a⁻¹ E` (`a ≠ 0`), i.e. with
the zero-neighbourhood base `(-δ,δ) ∩ ⋂_{a ∈ A} a⁻¹E`.  For the subspaces `E, F` of Lemma 17.4 the topologies `ρ_E, ρ_F` are
Hausdorff nondiscrete TVG topologies, strictly finer than the usual topology, and their join is discrete.
-/

namespace LeanCheck

open Filter Topology

section Rho

/-- The topology in which the subgroup `E` is open (cosets of `E` are open and discrete). -/
noncomputable def tauE (E : Submodule ℚ ℝ) : TopologicalSpace ℝ :=
  TopologicalSpace.induced (fun x : ℝ => (QuotientAddGroup.mk x : ℝ ⧸ E.toAddSubgroup)) ⊥

lemma tauE_group (E : Submodule ℚ ℝ) : @IsTopologicalAddGroup ℝ (tauE E) _ := by
  unfold tauE
  letI : TopologicalSpace (ℝ ⧸ E.toAddSubgroup) := ⊥
  haveI : DiscreteTopology (ℝ ⧸ E.toAddSubgroup) := ⟨rfl⟩
  exact isTopologicalAddGroup_induced (QuotientAddGroup.mk' E.toAddSubgroup)

lemma tauE_nhds_zero (E : Submodule ℚ ℝ) (U : Set ℝ) :
    U ∈ @nhds ℝ (tauE E) 0 ↔ (E : Set ℝ) ⊆ U := by
  unfold tauE
  letI : TopologicalSpace (ℝ ⧸ E.toAddSubgroup) := ⊥
  haveI : DiscreteTopology (ℝ ⧸ E.toAddSubgroup) := ⟨rfl⟩
  rw [nhds_induced, Filter.mem_comap]
  constructor
  · rintro ⟨W, hW, hWU⟩ x hx
    apply hWU
    have : (QuotientAddGroup.mk x : ℝ ⧸ E.toAddSubgroup) = QuotientAddGroup.mk 0 := by
      rw [QuotientAddGroup.eq_iff_sub_mem]; simpa using hx
    show (QuotientAddGroup.mk x : ℝ ⧸ E.toAddSubgroup) ∈ W
    rw [this]; exact mem_of_mem_nhds hW
  · intro h
    refine ⟨{(QuotientAddGroup.mk 0 : ℝ ⧸ E.toAddSubgroup)}, ?_, ?_⟩
    · exact (isOpen_discrete _).mem_nhds rfl
    · intro x hx
      have : (QuotientAddGroup.mk x : ℝ ⧸ E.toAddSubgroup) = QuotientAddGroup.mk 0 := hx
      rw [QuotientAddGroup.eq_iff_sub_mem] at this
      exact h (by simpa using this)

/-- Multiplication by `a` as an additive homomorphism. -/
noncomputable def mhR (a : ℝ) : ℝ →+ ℝ := AddMonoidHom.mulLeft a

lemma mhR_apply (a x : ℝ) : mhR a x = a * x := rfl

/-- `ρ_E`. -/
noncomputable def rhoTop (E : Submodule ℚ ℝ) : TopologicalSpace ℝ :=
  uR ⊓ ⨅ a : {a : ℝ // a ≠ 0}, TopologicalSpace.induced (mhR a.1) (tauE E)

lemma rho_group (E : Submodule ℚ ℝ) : @IsTopologicalAddGroup ℝ (rhoTop E) _ := by
  unfold rhoTop
  letI : TopologicalSpace ℝ := tauE E
  haveI : IsTopologicalAddGroup ℝ := tauE_group E
  exact isTopologicalAddGroup_inf uR_group
    (isTopologicalAddGroup_iInf (ts' := fun a : {a : ℝ // a ≠ 0} => TopologicalSpace.induced (mhR a.1) (tauE E))
      (fun a => isTopologicalAddGroup_induced (mhR a.1)))

lemma rho_le_uR (E : Submodule ℚ ℝ) : rhoTop E ≤ uR := inf_le_left

lemma rho_t2 (E : Submodule ℚ ℝ) : @T2Space ℝ (rhoTop E) :=
  t2_of_le' (rho_le_uR E) (by unfold uR; infer_instance)

lemma rho_dil (E : Submodule ℚ ℝ) (c : ℝ) : Continuous[rhoTop E, rhoTop E] (fun x : ℝ => c * x) := by
  by_cases hc : c = 0
  · subst hc
    simp only [zero_mul]
    exact @continuous_const ℝ ℝ (rhoTop E) (rhoTop E) 0
  · have hU : Continuous[rhoTop E, uR] (fun x : ℝ => c * x) :=
      @Continuous.comp ℝ ℝ ℝ (rhoTop E) uR uR _ _ (uR_dil c) (continuous_id_of_le (rho_le_uR E))
    have hI : ∀ a : {a : ℝ // a ≠ 0}, Continuous[rhoTop E, TopologicalSpace.induced (mhR a.1) (tauE E)]
        (fun x : ℝ => c * x) := by
      intro a
      refine continuous_induced_rng.2 ?_
      have h1 : Continuous[rhoTop E, TopologicalSpace.induced (mhR (a.1 * c)) (tauE E)] (id : ℝ → ℝ) :=
        continuous_id_of_le (inf_le_right.trans (iInf_le (fun a : {a : ℝ // a ≠ 0} =>
          TopologicalSpace.induced (mhR a.1) (tauE E)) ⟨a.1 * c, mul_ne_zero a.2 hc⟩))
      have h2 : Continuous[TopologicalSpace.induced (mhR (a.1 * c)) (tauE E), tauE E]
          (mhR (a.1 * c)) := continuous_induced_dom
      have h3 := @Continuous.comp ℝ ℝ ℝ (rhoTop E) (TopologicalSpace.induced (mhR (a.1 * c)) (tauE E))
        (tauE E) _ _ h2 h1
      convert h3 using 1
      funext x
      simp [mhR_apply, mul_assoc]
    exact continuous_inf_rng.2 ⟨hU, continuous_iInf_rng.2 hI⟩

lemma rho_nhds_data (E : Submodule ℚ ℝ) (S : Set ℝ) (hS : S ∈ @nhds ℝ (rhoTop E) 0) :
    ∃ ε : ℝ, 0 < ε ∧ ∃ I : Finset {a : ℝ // a ≠ 0}, ∀ x : ℝ, |x| < ε → (∀ a ∈ I, a.1 * x ∈ E) → x ∈ S := by
  have hS' : S ∈ @nhds ℝ (uR ⊓ ⨅ a : {a : ℝ // a ≠ 0}, TopologicalSpace.induced (mhR a.1) (tauE E)) 0 := hS
  rw [@nhds_inf ℝ uR (⨅ a : {a : ℝ // a ≠ 0}, TopologicalSpace.induced (mhR a.1) (tauE E)) 0] at hS'
  obtain ⟨t1, ht1, t2, ht2, hsub⟩ := Filter.mem_inf_iff.mp hS'
  rw [nhds_iInf] at ht2
  obtain ⟨I, hI, V, hV, hVuniv, hs⟩ := Filter.mem_iInf'.mp ht2
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp ht1
  have hex : ∀ a : {a : ℝ // a ≠ 0}, ∃ W : Set ℝ, W ∈ @nhds ℝ (tauE E) 0 ∧ (mhR a.1) ⁻¹' W ⊆ V a := by
    intro a
    have h := hV a
    rw [@nhds_induced ℝ ℝ (tauE E) (mhR a.1) 0, map_zero] at h
    exact Filter.mem_comap.mp h
  choose W hW hWV using hex
  refine ⟨ε, hε, hI.toFinset, fun x hx hxE => ?_⟩
  have hx1 : x ∈ t1 := hball (by simpa [Metric.mem_ball, dist_zero_right] using hx)
  have hx2 : x ∈ t2 := by
    rw [hs.1]
    refine Set.mem_iInter₂.mpr (fun a ha => ?_)
    apply hWV a
    exact (tauE_nhds_zero E (W a)).1 (hW a) (hxE a (hI.mem_toFinset.mpr ha))
  rw [hsub]
  exact ⟨hx1, hx2⟩

lemma E_isOpen_tauE (E : Submodule ℚ ℝ) : IsOpen[tauE E] (E : Set ℝ) := by
  unfold tauE
  letI : TopologicalSpace (ℝ ⧸ E.toAddSubgroup) := ⊥
  haveI : DiscreteTopology (ℝ ⧸ E.toAddSubgroup) := ⟨rfl⟩
  refine ⟨{(QuotientAddGroup.mk 0 : ℝ ⧸ E.toAddSubgroup)}, isOpen_discrete _, ?_⟩
  ext x
  simp only [Set.mem_preimage, Set.mem_singleton_iff, SetLike.mem_coe]
  rw [QuotientAddGroup.eq_iff_sub_mem]
  simp

/-- `E` is open in `ρ_E`. -/
lemma E_isOpen_rho (E : Submodule ℚ ℝ) : IsOpen[rhoTop E] (E : Set ℝ) := by
  have h : IsOpen[TopologicalSpace.induced (mhR 1) (tauE E)] ((mhR 1) ⁻¹' (E : Set ℝ)) := ⟨E, E_isOpen_tauE E, rfl⟩
  have hle : rhoTop E ≤ TopologicalSpace.induced (mhR 1) (tauE E) :=
    inf_le_right.trans (iInf_le (fun a : {a : ℝ // a ≠ 0} => TopologicalSpace.induced (mhR a.1) (tauE E))
      ⟨1, one_ne_zero⟩)
  have hset : (mhR 1) ⁻¹' (E : Set ℝ) = (E : Set ℝ) := by ext x; simp [mhR_apply]
  rw [hset] at h
  exact h.mono hle

/-- If every finite pattern is realized inside `E`, then `ρ_E` is nondiscrete. -/
lemma rho_nondiscrete (E : Submodule ℚ ℝ) (hpat : ∀ A : Finset ℝ, ∃ u : ℝ, u ≠ 0 ∧ ∀ a ∈ A, a * u ∈ E) :
    ({0} : Set ℝ) ∉ @nhds ℝ (rhoTop E) 0 := by
  intro h
  classical
  obtain ⟨ε, hε, I, hI⟩ := rho_nhds_data E _ h
  obtain ⟨u, hu0, hu⟩ := hpat (I.image Subtype.val)
  obtain ⟨q, hq0, hq⟩ := exists_rat_btwn (show (0 : ℝ) < ε / |u| from div_pos hε (abs_pos.2 hu0))
  have hx : (q : ℝ) * u ∈ ({0} : Set ℝ) := by
    apply hI
    · rw [abs_mul, abs_of_pos hq0]
      calc (q : ℝ) * |u| < ε / |u| * |u| := by
            exact mul_lt_mul_of_pos_right hq (abs_pos.2 hu0)
        _ = ε := by field_simp
    · intro a ha
      have h1 : a.1 * u ∈ E := hu a.1 (Finset.mem_image_of_mem _ ha)
      have : a.1 * ((q : ℝ) * u) = q • (a.1 * u) := by rw [Rat.smul_def]; ring
      rw [this]
      exact E.smul_mem q h1
  rw [Set.mem_singleton_iff] at hx
  rcases mul_eq_zero.1 hx with h0 | h0
  · exact absurd (by exact_mod_cast h0 : q = 0) (by exact_mod_cast hq0.ne')
  · exact hu0 h0

/-- A subspace that is open in the usual topology is everything. -/
lemma submodule_open_top (E : Submodule ℚ ℝ) (h : IsOpen[uR] (E : Set ℝ)) : E = ⊤ := by
  have h' : IsOpen (E : Set ℝ) := by unfold uR at h; exact h
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 h' 0 E.zero_mem
  rw [eq_top_iff]
  intro x _
  obtain ⟨n, hn⟩ := exists_nat_gt (|x| / ε)
  have hnpos : (0 : ℝ) < n := lt_of_le_of_lt (div_nonneg (abs_nonneg _) hε.le) hn
  have hin : x / n ∈ E := by
    apply hball
    rw [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs, abs_div, Nat.abs_cast, div_lt_iff₀ hnpos]
    rw [div_lt_iff₀ hε] at hn
    linarith
  have : x = (n : ℚ) • (x / n) := by
    rw [Rat.smul_def]; push_cast; field_simp
  rw [this]
  exact E.smul_mem _ hin

end Rho

section Final

variable {E F : Submodule ℚ ℝ}

lemma rho_mem_ND (E : Submodule ℚ ℝ) (hpat : ∀ A : Finset ℝ, ∃ u : ℝ, u ≠ 0 ∧ ∀ a ∈ A, a * u ∈ E) :
    rhoTop E ∈ NDcls :=
  ⟨⟨rho_group E, rho_t2 E, rho_dil E⟩, rho_nondiscrete E hpat⟩

lemma join_discrete (hEF : E ⊓ F = ⊥) : ({0} : Set ℝ) ∈ @nhds ℝ (rhoTop E ⊓ rhoTop F) 0 := by
  have hE : IsOpen[rhoTop E ⊓ rhoTop F] (E : Set ℝ) := (E_isOpen_rho E).mono inf_le_left
  have hF : IsOpen[rhoTop E ⊓ rhoTop F] (F : Set ℝ) := (E_isOpen_rho F).mono inf_le_right
  have hinter : IsOpen[rhoTop E ⊓ rhoTop F] ((E : Set ℝ) ∩ (F : Set ℝ)) := @IsOpen.inter ℝ (rhoTop E ⊓ rhoTop F) _ _ hE hF
  have hset : (E : Set ℝ) ∩ (F : Set ℝ) = {0} := by
    ext x
    constructor
    · rintro ⟨hxE, hxF⟩
      have : x ∈ E ⊓ F := ⟨hxE, hxF⟩
      rw [hEF] at this
      simpa using this
    · intro hx
      rw [Set.mem_singleton_iff] at hx
      rw [hx]
      exact ⟨E.zero_mem, F.zero_mem⟩
  rw [hset] at hinter
  exact @IsOpen.mem_nhds ℝ (rhoTop E ⊓ rhoTop F) 0 {0} hinter rfl

/-- **Theorem 17.5.**  There are Hausdorff nondiscrete TVG topologies, each strictly finer than the usual topology, whose join is
discrete; consequently there is no greatest nondiscrete Hausdorff TVG topology, even among those finer than the usual one. -/
theorem no_greatest_nondiscrete :
    (∃ ρ₁ ρ₂ : TopologicalSpace ℝ, ρ₁ ∈ NDcls ∧ ρ₂ ∈ NDcls ∧ ρ₁ < uR ∧ ρ₂ < uR ∧
      ({0} : Set ℝ) ∈ @nhds ℝ (ρ₁ ⊓ ρ₂) 0) ∧
    ¬ ∃ μ ∈ NDcls, ∀ η ∈ NDcls, μ ≤ η := by
  obtain ⟨E, F, hEF, hpat⟩ := exists_patterns
  have hpE : ∀ A : Finset ℝ, ∃ u : ℝ, u ≠ 0 ∧ ∀ a ∈ A, a * u ∈ E := fun A => (hpat A).1
  have hpF : ∀ A : Finset ℝ, ∃ u : ℝ, u ≠ 0 ∧ ∀ a ∈ A, a * u ∈ F := fun A => (hpat A).2
  have hEtop : E ≠ ⊤ := by
    intro h
    obtain ⟨v, hv0, hv⟩ := hpF {1}
    have : (v : ℝ) ∈ E ⊓ F := ⟨by rw [h]; trivial, by simpa using hv 1 (by simp)⟩
    rw [hEF] at this
    exact hv0 (by simpa using this)
  have hFtop : F ≠ ⊤ := by
    intro h
    obtain ⟨v, hv0, hv⟩ := hpE {1}
    have : (v : ℝ) ∈ E ⊓ F := ⟨by simpa using hv 1 (by simp), by rw [h]; trivial⟩
    rw [hEF] at this
    exact hv0 (by simpa using this)
  have hstrict : ∀ G : Submodule ℚ ℝ, G ≠ ⊤ → rhoTop G < uR := fun G hG =>
    lt_of_le_of_ne (rho_le_uR G) (fun heq => hG (submodule_open_top G (heq ▸ E_isOpen_rho G)))
  refine ⟨⟨rhoTop E, rhoTop F, rho_mem_ND E hpE, rho_mem_ND F hpF, hstrict E hEtop, hstrict F hFtop,
    join_discrete hEF⟩, ?_⟩
  rintro ⟨μ, hμ, hgr⟩
  have hle : μ ≤ rhoTop E ⊓ rhoTop F := le_inf (hgr _ (rho_mem_ND E hpE)) (hgr _ (rho_mem_ND F hpF))
  have hdisc := join_discrete hEF
  exact hμ.2 (nhds_mono hle hdisc)

lemma uR_mem_ND : uR ∈ NDcls := by
  refine ⟨⟨uR_group, by unfold uR; infer_instance, uR_dil⟩, ?_⟩
  intro h
  have h' : ({0} : Set ℝ) ∈ nhds (0 : ℝ) := by unfold uR at h; exact h
  obtain ⟨ε, hε, hb⟩ := Metric.mem_nhds_iff.1 h'
  have : ε / 2 ∈ Metric.ball (0 : ℝ) ε := by
    rw [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs, abs_of_pos (by positivity)]; linarith
  have := hb this
  rw [Set.mem_singleton_iff] at this
  linarith

lemma uR_inf_B_mem_ND : uR ⊓ theta (Set.univ : Set Chars) ∈ NDcls := by
  obtain ⟨hg, ht2, hprec, hdil⟩ := theta_ptvg (Set.univ : Set Chars) Bohr_separates (fun _ _ _ => Set.mem_univ _)
  refine ⟨⟨isTopologicalAddGroup_inf uR_group hg, t2_of_le' inf_le_left (by unfold uR; infer_instance), ?_⟩,
    join_precompact_nondiscrete uR _ uR_mem_ND hg hprec⟩
  intro c
  refine continuous_inf_rng.2 ⟨?_, ?_⟩
  · exact @Continuous.comp ℝ ℝ ℝ (uR ⊓ theta (Set.univ : Set Chars)) uR uR _ _ (uR_dil c) (continuous_id_of_le inf_le_left)
  · exact @Continuous.comp ℝ ℝ ℝ (uR ⊓ theta (Set.univ : Set Chars)) (theta (Set.univ : Set Chars)) (theta (Set.univ : Set Chars))
      _ _ (hdil c) (continuous_id_of_le inf_le_right)

/-- **Corollary 17.6.**  There are two distinct maximal Hausdorff nondiscrete TVG topologies, both finer than the nondiscrete
topology `tu ∨ B` (`B` the Bohr topology of the discrete line). -/
theorem nonunique_maximal :
    ∃ μ₁ μ₂ : TopologicalSpace ℝ, μ₁ ≠ μ₂ ∧ Minimal (· ∈ NDcls) μ₁ ∧ Minimal (· ∈ NDcls) μ₂ ∧
      μ₁ ≤ uR ⊓ theta (Set.univ : Set Chars) ∧ μ₂ ≤ uR ⊓ theta (Set.univ : Set Chars) ∧
      uR ⊓ theta (Set.univ : Set Chars) ∈ NDcls := by
  obtain ⟨⟨ρ₁, ρ₂, h1, h2, -, -, hdisc⟩, -⟩ := no_greatest_nondiscrete
  obtain ⟨μ₁, hμ₁ρ, hμ₁, hμ₁u, hμ₁B, -⟩ := exists_maximal_nondiscrete ρ₁ h1
  obtain ⟨μ₂, hμ₂ρ, hμ₂, hμ₂u, hμ₂B, -⟩ := exists_maximal_nondiscrete ρ₂ h2
  refine ⟨μ₁, μ₂, ?_, hμ₁, hμ₂, le_inf hμ₁u hμ₁B, le_inf hμ₂u hμ₂B, uR_inf_B_mem_ND⟩
  intro heq
  subst heq
  have hle : μ₁ ≤ ρ₁ ⊓ ρ₂ := le_inf hμ₁ρ hμ₂ρ
  exact hμ₁.1.2 (nhds_mono hle hdisc)

end Final

end LeanCheck
