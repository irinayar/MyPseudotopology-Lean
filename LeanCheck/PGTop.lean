import Mathlib
import LeanCheck.PGGenerated

/-!
# PG: topological groups as pseudotopological groups; group topologies containing a PG (Lean check)

Scope. Proposition 9.7 and the remarks of Section 7 of `PG_v7`. For an abelian group `G` with a group topology:

* `topNull G` : the proper filters finer than the neighbourhood filter of `0`; `topNull_nullFamily` : it satisfies
  properties (i)-(iv) of Proposition 2.6 (`NullFamily`), i.e. a topological group is a PG (its null family);
* `genNull_subset_topNull_iff` : the PG generated by an ultrafilter `u` (`genNull u`) is contained in the group topology
  iff `u` converges to `0` in it; so the group topologies containing the PG generated by `u` are exactly the group topologies in
  which `u` converges to `0` (hence the finest one is the finest group topology in which `u` converges);
* `null_le_nhds_iff` : for any family `C` of filters, all members converge to `0` iff their intersection
  `⨆ F ∈ C, F` does;
* `conv_le_nhds` : if all members of a null family `C` converge to `0` in the topology, then `F → x` for the PG of `C` implies
  `F ≤ 𝓝 x`.

Not formalized: the description of the finest group topology in which a filter converges (Protasov-Zelenyuk, Bergman).

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires
mathematical review.
-/

open Filter Set Topology

namespace PG

variable (G : Type*) [AddCommGroup G] [TopologicalSpace G] [IsTopologicalAddGroup G]

/-- Null family of a topological group. -/
def topNull : Set (Filter G) := {F | F.NeBot ∧ F ≤ 𝓝 0}

theorem topNull_nullFamily : NullFamily (topNull G) where
  ne := fun F hF => hF.1
  pure_zero := ⟨inferInstance, pure_le_nhds 0⟩
  finer := fun F hF H hle hne => ⟨hne, hle.trans hF.2⟩
  add := by
    rintro F ⟨hFn, hF⟩ H ⟨hHn, hH⟩
    refine ⟨hFn.map₂ hHn, ?_⟩
    have ht : Tendsto (fun p : G × G => p.1 + p.2) (F ×ˢ H) (𝓝 (0 + 0)) :=
      (tendsto_fst.mono_right hF).add (tendsto_snd.mono_right hH)
    rw [add_zero] at ht
    rw [← Filter.map_prod_eq_map₂]
    exact ht
  neg := by
    rintro F ⟨hFn, hF⟩
    refine ⟨by have := hFn; infer_instance, ?_⟩
    have ht : Tendsto (fun z : G => -z) F (𝓝 (-0)) := (continuous_neg.tendsto 0).mono_left hF
    rwa [neg_zero] at ht
  ultra := by
    rintro F hne hU
    refine ⟨hne, ?_⟩
    rw [Filter.le_iff_ultrafilter]
    intro U hUF
    exact (hU U hUF).2

variable {G}

theorem genNull_subset_topNull (u : Ultrafilter G) (hu : (u : Filter G) ≤ 𝓝 0) :
    genNull u ⊆ topNull G :=
  genNull_le u (topNull_nullFamily G) ⟨inferInstance, hu⟩

theorem genNull_subset_topNull_iff (u : Ultrafilter G) :
    genNull u ⊆ topNull G ↔ (u : Filter G) ≤ 𝓝 0 :=
  ⟨fun h => (h (u_mem_genNull u)).2, genNull_subset_topNull u⟩

theorem null_le_nhds_iff (C : Set (Filter G)) :
    (∀ F ∈ C, F ≤ 𝓝 0) ↔ (⨆ F ∈ C, F) ≤ 𝓝 0 := by
  simp [iSup₂_le_iff]

theorem conv_le_nhds {C : Set (Filter G)} (hC : ∀ F ∈ C, F ≤ 𝓝 0) {F : Filter G} {x : G}
    (h : conv C F x) : F ≤ 𝓝 x := by
  have h1 : Filter.map (fun y => y - x) F ≤ 𝓝 0 := hC _ h
  have h2 : Tendsto (fun y : G => y - x) F (𝓝 0) := h1
  have hc : Continuous fun y : G => y + x := continuous_id.add continuous_const
  have h3 := (hc.tendsto 0).comp h2
  simpa [Function.comp_def, Filter.Tendsto] using h3

end PG
