import LeanCheck.PVGNull

/-!
# PVG: pseudotopologies from a topology and an ideal (Lean check)

Scope. Formal counterpart of Section 6 of `PVG_v19` ("Pseudotopologies from a topology and an ideal"), for an arbitrary real
vector space `X` with a group topology with continuous dilations (the article takes `X = ℝ`; the proofs do not use more).

* `IsIdeal I`: the conditions (I1) to (I5) of Definition 6.1 on a family `I` of subsets;
* `xiConv I F x`: `F` is finer than the neighbourhood filter of `x` (`F ≤ 𝓝 x`) and has a member in `I`;
* `xi_isPVG` (Proposition 6.2, first part): `xiConv I` is a PVG pseudotopology, Hausdorff if the topology is Hausdorff;
* `Vfil conv x`, `IsPretop`, `IsTopological`: the filter `V(x)`, pretopological and topological pseudotopologies;
  `topological_isPretop`;
* `isPretop_iff_zero` (Lemma 6.3): for a PVG, pretopological iff `V(0) → 0`;
* `xi_pretop_iff` (Theorem 6.4, pretopology criterion): `xiConv I` is pretopological iff there is `A ∈ I` with
  `0 ∉ closure (J \ A)` for all `J ∈ I`; `xi_not_pretop` (Corollary 6.5, recipe) and `xi_not_topological`;
* `modTop`, `mem_modTop_iff` (Proposition 6.6): the topological modification of a convergence and its description by closures.

A Lean proof verifies its formal statement under its hypotheses; the correspondence with the article requires mathematical
review.
-/

open Filter Topology Pointwise

namespace PVG
namespace Q95

section Ideal

variable {X : Type*} [AddCommGroup X] [Module ℝ X]

/-- (I1) to (I5) of Definition 6.1: subsets, finite unions, singletons, `X ∉ I`, sums and dilates. -/
structure IsIdeal (I : Set (Set X)) : Prop where
  mono : ∀ {A B : Set X}, A ∈ I → B ⊆ A → B ∈ I
  union : ∀ {A B : Set X}, A ∈ I → B ∈ I → A ∪ B ∈ I
  single : ∀ x : X, ({x} : Set X) ∈ I
  ne_univ : (Set.univ : Set X) ∉ I
  add : ∀ {A B : Set X}, A ∈ I → B ∈ I → A + B ∈ I
  smul : ∀ (a : ℝ) {A : Set X}, A ∈ I → a • A ∈ I

lemma IsIdeal.empty_mem {I : Set (Set X)} (h : IsIdeal I) : (∅ : Set X) ∈ I :=
  h.mono (h.single 0) (Set.empty_subset _)

/-- `F → x` iff `F` contains the neighbourhood filter of `x` and has a member in `I`. -/
def xiConv [TopologicalSpace X] (I : Set (Set X)) (F : Filter X) (x : X) : Prop :=
  F ≤ 𝓝 x ∧ ∃ A ∈ F, A ∈ I

/-- The filter generated by the complements of the members of `I`. -/
def dualFilter {I : Set (Set X)} (h : IsIdeal I) : Filter X where
  sets := {t | ∃ J ∈ I, Jᶜ ⊆ t}
  univ_sets := ⟨∅, h.empty_mem, by simp⟩
  sets_of_superset := fun ⟨J, hJ, hs⟩ hst => ⟨J, hJ, hs.trans hst⟩
  inter_sets := fun ⟨J, hJ, hs⟩ ⟨K, hK, ht⟩ =>
    ⟨J ∪ K, h.union hJ hK, by rw [Set.compl_union]; exact Set.inter_subset_inter hs ht⟩

variable [TopologicalSpace X] [IsTopologicalAddGroup X] [ContinuousConstSMul ℝ X] {I : Set (Set X)}

/-- **Proposition 6.2** (first part): `xiConv I` is a PVG pseudotopology. -/
theorem xi_isPVG (h : IsIdeal I) : IsPVG (xiConv I) where
  p1 x := ⟨pure_le_nhds x, {x}, Set.mem_singleton x, h.single x⟩
  p2 := fun hF hGF => ⟨hGF.trans hF.1, by
    obtain ⟨A, hA, hAI⟩ := hF.2
    exact ⟨A, hGF hA, hAI⟩⟩
  p3 := by
    intro F _ x hU
    have hle : F ≤ 𝓝 x := Filter.le_iff_ultrafilter.2 (fun U hUF => (hU U hUF).1)
    refine ⟨hle, ?_⟩
    by_contra hno
    push Not at hno
    have hne : (F ⊓ dualFilter h).NeBot := by
      rw [Filter.inf_neBot_iff]
      intro s hs t ht
      obtain ⟨J, hJ, hJt⟩ := ht
      by_contra hemp
      rw [Set.not_nonempty_iff_eq_empty] at hemp
      have hsJ : s ⊆ J := by
        intro y hy
        by_contra hyJ
        have : y ∈ s ∩ t := ⟨hy, hJt hyJ⟩
        rw [hemp] at this
        exact this
      exact hno s hs (h.mono hJ hsJ)
    set U : Ultrafilter X := Ultrafilter.of (F ⊓ dualFilter h) with hUdef
    have hUF : (U : Filter X) ≤ F := (Ultrafilter.of_le _).trans inf_le_left
    have hUd : (U : Filter X) ≤ dualFilter h := (Ultrafilter.of_le _).trans inf_le_right
    obtain ⟨A, hA, hAI⟩ := (hU U hUF).2
    have hAc : Aᶜ ∈ (U : Filter X) := hUd ⟨A, hAI, subset_rfl⟩
    have := Filter.inter_mem hA hAc
    rw [Set.inter_compl_self] at this
    exact Ultrafilter.empty_notMem this
  add := by
    intro F G x y hF hG
    refine ⟨?_, ?_⟩
    · have h1 : Tendsto (fun p : X × X => p.1 + p.2) (𝓝 x ×ˢ 𝓝 y) (𝓝 (x + y)) := by
        rw [← nhds_prod_eq]; exact (continuous_add (M := X)).tendsto (x, y)
      have h2 : Filter.map₂ (· + ·) F G ≤ Filter.map₂ (· + ·) (𝓝 x) (𝓝 y) :=
        Filter.map₂_mono hF.1 hG.1
      refine h2.trans ?_
      rw [← Filter.map_prod_eq_map₂ (fun a b : X => a + b)]
      exact h1
    · obtain ⟨A, hA, hAI⟩ := hF.2
      obtain ⟨B, hB, hBI⟩ := hG.2
      refine ⟨A + B, ?_, h.add hAI hBI⟩
      have : Set.image2 (fun a b : X => a + b) A B ∈ Filter.map₂ (fun a b : X => a + b) F G := Filter.image2_mem_map₂ hA hB
      rwa [Set.image2_add] at this
  smul := by
    intro a F x hF
    refine ⟨?_, ?_⟩
    · have h1 : Tendsto (fun z : X => a • z) (𝓝 x) (𝓝 (a • x)) := (continuous_const_smul a).tendsto x
      exact (Filter.map_mono hF.1).trans h1
    · obtain ⟨A, hA, hAI⟩ := hF.2
      refine ⟨a • A, ?_, h.smul a hAI⟩
      have : (fun z : X => a • z) '' A ∈ F.map (fun z : X => a • z) := Filter.image_mem_map hA
      rwa [Set.image_smul] at this

/-- The convergence `xiConv I` is Hausdorff when the topology is. -/
theorem xi_hausdorff [T2Space X] : PHausdorff (xiConv I) := by
  intro F _ x y hx hy
  have : (𝓝 x ⊓ 𝓝 y).NeBot := Filter.neBot_of_le (le_inf hx.1 hy.1)
  exact t2_iff_nhds.1 inferInstance this

end Ideal

section Vfil

variable {X : Type*}

/-- `V(x)`: the intersection of the filters converging to `x`. -/
def Vfil (conv : Filter X → X → Prop) (x : X) : Filter X := sSup {F | conv F x}

/-- Pretopological: `V(x) → x` for every `x`. -/
def IsPretop (conv : Filter X → X → Prop) : Prop := ∀ x, conv (Vfil conv x) x

/-- Topological: the convergence of a topology. -/
def IsTopological (conv : Filter X → X → Prop) : Prop :=
  ∃ τ : TopologicalSpace X, ∀ F x, conv F x ↔ F ≤ @nhds X τ x

lemma mem_Vfil {conv : Filter X → X → Prop} {x : X} {s : Set X} :
    s ∈ Vfil conv x ↔ ∀ F, conv F x → s ∈ F := by
  unfold Vfil; rw [Filter.mem_sSup]; rfl

/-- Every topological pseudotopology is pretopological. -/
theorem topological_isPretop {conv : Filter X → X → Prop} (h : IsTopological conv) : IsPretop conv := by
  obtain ⟨τ, hτ⟩ := h
  intro x
  rw [hτ]
  intro W hW
  exact mem_Vfil.2 (fun F hF => ((hτ F x).1 hF) hW)

end Vfil

section Null

variable {X : Type*} [AddCommGroup X] [Module ℝ X] {conv : Filter X → X → Prop}

lemma Vfil_eq_map (h : IsPVG conv) (x : X) : Vfil conv x = (Vfil conv 0).map (fun z => z + x) := by
  ext s
  rw [Filter.mem_map, mem_Vfil, mem_Vfil]
  constructor
  · intro hs G hG
    -- `G → 0`, so `G + x → x`
    have hGx : conv (G.map (fun z => z + x)) x := by
      have := h.add hG (h.p1 x)
      rw [Filter.map₂_pure_right, zero_add] at this
      exact this
    have := hs _ hGx
    rwa [Filter.mem_map] at this
  · intro hs F hF
    have hF0 : conv (transl x F) 0 := (conv_iff_translate h F x).1 hF
    have := hs _ hF0
    unfold transl at this
    rw [Filter.mem_map] at this
    have e : (fun z => z - x) ⁻¹' ((fun z => z + x) ⁻¹' s) = s := by ext z; simp
    rwa [e] at this

/-- **Lemma 6.3**: a PVG is pretopological iff `V(0) → 0`. -/
theorem isPretop_iff_zero (h : IsPVG conv) : IsPretop conv ↔ conv (Vfil conv 0) 0 := by
  constructor
  · exact fun hp => hp 0
  · intro h0 x
    rw [Vfil_eq_map h x]
    have := h.add h0 (h.p1 x)
    rw [Filter.map₂_pure_right, zero_add] at this
    exact this

end Null

section Criterion

variable {X : Type*} [AddCommGroup X] [Module ℝ X] [TopologicalSpace X] [IsTopologicalAddGroup X]
  [ContinuousConstSMul ℝ X] {I : Set (Set X)}

/-- If `F → x`, `J ∈ F` and `x ∉ closure (J \ U)` then `U ∈ F`. -/
lemma mem_of_not_closure {F : Filter X} {x : X} (hF : F ≤ 𝓝 x) {J U : Set X} (hJ : J ∈ F)
    (hx : x ∉ closure (J \ U)) : U ∈ F := by
  rw [mem_closure_iff_nhds] at hx
  push Not at hx
  obtain ⟨W, hW, hWe⟩ := hx
  have hWF : W ∈ F := hF hW
  refine Filter.mem_of_superset (Filter.inter_mem hWF hJ) ?_
  intro y hy
  by_contra hyU
  have : y ∈ W ∩ (J \ U) := ⟨hy.1, hy.2, hyU⟩
  rw [hWe] at this
  exact this

/-- The filter generated by the neighbourhoods of `x` and a set `J` with `x ∈ closure J`. -/
lemma xi_nebot {x : X} {J : Set X} (hJ : x ∈ closure J) : (𝓝 x ⊓ 𝓟 J).NeBot := by
  exact mem_closure_iff_nhdsWithin_neBot.1 hJ

/-- **Theorem 6.4** (pretopology criterion). -/
theorem xi_pretop_iff (h : IsIdeal I) :
    IsPretop (xiConv I) ↔ ∃ A ∈ I, ∀ J ∈ I, (0 : X) ∉ closure (J \ A) := by
  have hpvg := xi_isPVG h
  rw [isPretop_iff_zero hpvg]
  constructor
  · rintro ⟨hle, A, hA, hAI⟩
    refine ⟨A, hAI, fun J hJ => ?_⟩
    intro hcl
    have hclJ : (0 : X) ∈ closure J := closure_mono Set.diff_subset hcl
    have := xi_nebot hclJ
    have hconv : xiConv I (𝓝 0 ⊓ 𝓟 J) 0 :=
      ⟨inf_le_left, J, Filter.mem_inf_of_right (Filter.mem_principal_self J), hJ⟩
    have hAF : A ∈ 𝓝 (0 : X) ⊓ 𝓟 J := mem_Vfil.1 hA _ hconv
    rw [Filter.mem_inf_principal] at hAF
    rw [mem_closure_iff_nhds] at hcl
    obtain ⟨y, hy1, hy2⟩ := hcl _ hAF
    exact hy2.2 (hy1 hy2.1)
  · rintro ⟨A, hAI, hA⟩
    refine ⟨?_, A, ?_, hAI⟩
    · intro W hW
      exact mem_Vfil.2 (fun F hF => hF.1 hW)
    · refine mem_Vfil.2 (fun F hF => ?_)
      obtain ⟨J, hJF, hJI⟩ := hF.2
      exact mem_of_not_closure hF.1 hJF (hA J hJI)

/-- **Corollary 6.5** (recipe). -/
theorem xi_not_pretop (h : IsIdeal I)
    (hD : ∀ A ∈ I, ∃ D ∈ I, Disjoint D A ∧ (0 : X) ∈ closure D) : ¬ IsPretop (xiConv I) := by
  rw [xi_pretop_iff h]
  rintro ⟨A, hA, hcl⟩
  obtain ⟨D, hDI, hDA, hD0⟩ := hD A hA
  apply hcl D hDI
  rwa [hDA.sdiff_eq_left]

/-- The convergence of the recipe is not topological. -/
theorem xi_not_topological (h : IsIdeal I)
    (hD : ∀ A ∈ I, ∃ D ∈ I, Disjoint D A ∧ (0 : X) ∈ closure D) : ¬ IsTopological (xiConv I) :=
  fun ht => xi_not_pretop h hD (topological_isPretop ht)

end Criterion

section Modification

variable {X : Type*}

/-- **Proposition 6.6**: the topological modification of a convergence: the sets `U` that belong to every filter converging to
a point of `U`. -/
def modTop (conv : Filter X → X → Prop) : TopologicalSpace X where
  IsOpen U := ∀ x ∈ U, ∀ F, conv F x → U ∈ F
  isOpen_univ := fun _ _ F _ => Filter.univ_mem
  isOpen_inter := fun U V hU hV x hx F hF => Filter.inter_mem (hU x hx.1 F hF) (hV x hx.2 F hF)
  isOpen_sUnion := fun S hS x ⟨U, hUS, hxU⟩ F hF =>
    Filter.mem_of_superset (hS U hUS x hxU F hF) (Set.subset_sUnion_of_mem hUS)

end Modification

section ModDescr

variable {X : Type*} [AddCommGroup X] [Module ℝ X] [TopologicalSpace X] [IsTopologicalAddGroup X]
  [ContinuousConstSMul ℝ X] {I : Set (Set X)}

/-- The description of the open sets of the modification: `U` is open iff `closure (J \ U) ∩ U = ∅` for all `J ∈ I`. -/
theorem mem_modTop_iff (U : Set X) :
    @IsOpen X (modTop (xiConv I)) U ↔ ∀ J ∈ I, closure (J \ U) ∩ U = ∅ := by
  show (∀ x ∈ U, ∀ F, xiConv I F x → U ∈ F) ↔ _
  constructor
  · intro hU J hJ
    rw [Set.eq_empty_iff_forall_notMem]
    rintro x ⟨hxc, hxU⟩
    have hclJ : x ∈ closure J := closure_mono Set.diff_subset hxc
    have := xi_nebot hclJ
    have hconv : xiConv I (𝓝 x ⊓ 𝓟 J) x :=
      ⟨inf_le_left, J, Filter.mem_inf_of_right (Filter.mem_principal_self J), hJ⟩
    have hUF : U ∈ 𝓝 x ⊓ 𝓟 J := hU x hxU _ hconv
    rw [Filter.mem_inf_principal] at hUF
    rw [mem_closure_iff_nhds] at hxc
    obtain ⟨y, hy1, hy2⟩ := hxc _ hUF
    exact hy2.2 (hy1 hy2.1)
  · intro hU x hx F hF
    obtain ⟨J, hJF, hJI⟩ := hF.2
    refine mem_of_not_closure hF.1 hJF (fun hxc => ?_)
    have := hU J hJI
    rw [Set.eq_empty_iff_forall_notMem] at this
    exact this x ⟨hxc, hx⟩

end ModDescr

#print axioms xi_isPVG
#print axioms xi_hausdorff
#print axioms isPretop_iff_zero
#print axioms xi_pretop_iff
#print axioms xi_not_pretop
#print axioms xi_not_topological
#print axioms mem_modTop_iff

