import Mathlib
import LeanCheck.PGThreeBohr

/-!
# PGthree: one ultrafilter whose PG has no coreflection (Lean check)

Scope. Section 9 of the third article (`PGthree.tex`).

* `gen_sum_schur` : if every member of the ultrafilter `q` contains `x`, `y`, `x + y`, then the ultrafilters `v + q`
  and `q + v` generate the same PG as the pair `v`, `q`;
* `countably_many` : countably many such ultrafilters converge to `0` in the PG generated by one ultrafilter;
* `finite_bogolyubov`, `bogolyubov` : a set of positive upper density in the countable Boolean group has a fourfold
  sumset containing a subgroup of finite index;
* `exists_essential_idempotent` : an idempotent ultrafilter all of whose members have positive upper density;
* `one_ultrafilter_no_coreflection` : there is a nonprincipal ultrafilter on the countable Boolean group whose PG has
  unique limits and in which there is no coarsest symmetric halvable null filter containing `0` in its members.

No set-theoretic hypothesis is used. A Lean proof verifies its formal statement under its hypotheses; the
correspondence with the article requires mathematical review.
-/

open Filter Set Topology

namespace PG

namespace One

open Sel PG.Idem PG.Words PG.Bohr

attribute [local instance] Ultrafilter.add Ultrafilter.addSemigroup

section Schur

variable {G : Type} [AddCommGroup G]

/-- Every member of `q` contains `x`, `y` and `x + y`. -/
def Schur (q : Ultrafilter G) : Prop := ∀ s ∈ q, ∃ x y, x ∈ s ∧ y ∈ s ∧ x + y ∈ s

theorem schur_of_idempotent {q : Ultrafilter G} (h : q + q = q) : Schur q := by
  intro s hs
  have h2 : s ∈ q + q := by rw [h]; exact hs
  rw [PG.Idem.mem_add] at h2
  obtain ⟨x, hx1, hx2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem hs h2)
  have hx3 : {z : G | x + z ∈ s} ∈ q := hx2
  obtain ⟨y, hy1, hy2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem hs hx3)
  exact ⟨x, y, hx1, hy1, hy2⟩

/-- The negative of a filter. -/
abbrev negF (F : Filter G) : Filter G := Filter.map (fun x : G => -x) F

/-- With `w = v + q` or `w = q + v`, the ultrafilter `v` is finer than `w + w - w`. -/
theorem le_three {v q w : Ultrafilter G} (hq : Schur q) (hw : w = v + q ∨ w = q + v) :
    (v : Filter G) ≤ Filter.map₂ (· + ·) (Filter.map₂ (· + ·) (w : Filter G) w) (negF (w : Filter G)) := by
  intro s hs
  obtain ⟨t1, ht1, t2, ht2, h⟩ := Filter.mem_map₂_iff.1 hs
  obtain ⟨A, hA, B, hB, hAB⟩ := Filter.mem_map₂_iff.1 ht1
  have ht2' : (fun x : G => -x) ⁻¹' t2 ∈ w := ht2
  have hC : A ∩ B ∩ (fun x : G => -x) ⁻¹' t2 ∈ w :=
    Filter.inter_mem (Filter.inter_mem hA hB) ht2'
  set C := A ∩ B ∩ (fun x : G => -x) ⁻¹' t2 with hCdef
  have key : ∀ a b c : G, a ∈ C → b ∈ C → c ∈ C → a + b + -c ∈ s := fun a b c ha hb hc =>
    h (mem_image2_of_mem (hAB (mem_image2_of_mem ha.1.1 hb.1.2)) hc.2)
  show s ∈ v
  rcases hw with hw | hw
  · rw [hw, PG.Idem.mem_add] at hC
    refine Filter.mem_of_superset hC (fun a ha => ?_)
    have ha' : {z : G | a + z ∈ C} ∈ q := ha
    obtain ⟨x, y, hx, hy, hxy⟩ := hq _ ha'
    have e : (a + x) + (a + y) + -(a + (x + y)) = a := by abel
    rw [← e]
    exact key _ _ _ hx hy hxy
  · rw [hw, PG.Idem.mem_add] at hC
    obtain ⟨x, y, hx, hy, hxy⟩ := hq _ hC
    have hx' : {z : G | x + z ∈ C} ∈ v := hx
    have hy' : {z : G | y + z ∈ C} ∈ v := hy
    have hxy' : {z : G | x + y + z ∈ C} ∈ v := hxy
    refine Filter.mem_of_superset (Filter.inter_mem (Filter.inter_mem hx' hy') hxy') (fun c hc => ?_)
    have e : (x + c) + (y + c) + -(x + y + c) = c := by abel
    rw [← e]
    exact key _ _ _ hc.1.1 hc.1.2 hc.2

/-- With `w = v + q` or `w = q + v`, the ultrafilter `q` is finer than `w - v`. -/
theorem le_diff {v q w : Ultrafilter G} (hw : w = v + q ∨ w = q + v) :
    (q : Filter G) ≤ Filter.map₂ (· + ·) (w : Filter G) (negF (v : Filter G)) := by
  intro s hs
  obtain ⟨t1, ht1, t2, ht2, h⟩ := Filter.mem_map₂_iff.1 hs
  have ht1' : t1 ∈ w := ht1
  have ht2' : (fun x : G => -x) ⁻¹' t2 ∈ v := ht2
  show s ∈ q
  rcases hw with hw | hw
  · rw [hw, PG.Idem.mem_add] at ht1'
    obtain ⟨a, ha1, ha2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem ht1' ht2')
    have ha' : {z : G | a + z ∈ t1} ∈ q := ha1
    refine Filter.mem_of_superset ha' (fun z hz => ?_)
    have e : (a + z) + -a = z := by abel
    rw [← e]
    exact h (mem_image2_of_mem hz ha2)
  · rw [hw, PG.Idem.mem_add] at ht1'
    refine Filter.mem_of_superset ht1' (fun x hx => ?_)
    have hx' : {z : G | x + z ∈ t1} ∈ v := hx
    obtain ⟨c, hc1, hc2⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem hx' ht2')
    have e : (x + c) + -c = x := by abel
    rw [← e]
    exact h (mem_image2_of_mem hc1 hc2)

/-- A sum with a Schur ultrafilter generates the same PG as the two summands. -/
theorem gen_sum_schur {v q w : Ultrafilter G} (hq : Schur q) (hw : w = v + q ∨ w = q + v) :
    genFam (ultraGen {w}) = genFam (ultraGen {v, q}) := by
  have hC : NullFamily (genFam (ultraGen {v, q})) := genFam_nullFamily _
  have hD : NullFamily (genFam (ultraGen {w})) := genFam_nullFamily _
  refine Set.Subset.antisymm (genFam_le hC ?_) (genFam_le hD ?_)
  · rintro F ⟨u, hu, rfl⟩
    rw [mem_singleton_iff.1 hu]
    have h1 := hC.add _ (ultra_mem_genFam {v, q} v (mem_insert _ _)) _
      (ultra_mem_genFam {v, q} q (mem_insert_of_mem _ rfl))
    refine hC.finer _ h1 _ ?_ inferInstance
    rcases hw with hw | hw
    · rw [hw]
      exact add_le_map₂ v q
    · rw [hw, Filter.map₂_comm (fun a b : G => add_comm a b)]
      exact add_le_map₂ q v
  · have hwm : (w : Filter G) ∈ genFam (ultraGen {w}) := ultra_mem_genFam _ _ rfl
    have hv : (v : Filter G) ∈ genFam (ultraGen {w}) :=
      hD.finer _ (hD.add _ (hD.add _ hwm _ hwm) _ (hD.neg _ hwm)) _ (le_three hq hw) inferInstance
    have hqm : (q : Filter G) ∈ genFam (ultraGen {w}) :=
      hD.finer _ (hD.add _ hwm _ (hD.neg _ hv)) _ (le_diff hw) inferInstance
    rintro F ⟨u, hu, rfl⟩
    rcases mem_insert_iff.1 hu with rfl | hu
    · exact hv
    · rw [mem_singleton_iff.1 hu]
      exact hqm

/-! ### Countably many in one -/

theorem mem_genFam_of_le {C0 : Set (Filter G)} {N σ : Filter G} [N.NeBot] (hσ : SumClosure C0 σ) (h : N ≤ σ) :
    N ∈ genFam C0 :=
  ⟨inferInstance, fun _ hU => ⟨σ, hσ, hU.trans h⟩⟩

/-- Iterated threefold signed sums of a filter. -/
def tri (F : Filter G) : ℕ → Filter G
  | 0 => F
  | j + 1 => Filter.map₂ (· + ·) (Filter.map₂ (· + ·) (tri F j) (tri F j)) (negF (tri F j))

/-- The corresponding operation on sets. -/
def Tri (D : Set G) : ℕ → Set G
  | 0 => D
  | j + 1 => image2 (· + ·) (image2 (· + ·) (Tri D j) (Tri D j)) ((fun x : G => -x) ⁻¹' Tri D j)

theorem Tri_mono {D E : Set G} (h : D ⊆ E) : ∀ j, Tri D j ⊆ Tri E j
  | 0 => h
  | j + 1 => image2_subset (image2_subset (Tri_mono h j) (Tri_mono h j)) (preimage_mono (Tri_mono h j))

theorem tri_mono {F F' : Filter G} (h : F ≤ F') : ∀ j, tri F j ≤ tri F' j
  | 0 => h
  | j + 1 => Filter.map₂_mono (Filter.map₂_mono (tri_mono h j) (tri_mono h j)) (Filter.map_mono (tri_mono h j))

theorem Tri_mem {F : Filter G} {D : Set G} (hD : D ∈ F) : ∀ j, Tri D j ∈ tri F j
  | 0 => hD
  | j + 1 => by
    refine Filter.image2_mem_map₂ (Filter.image2_mem_map₂ (Tri_mem hD j) (Tri_mem hD j)) ?_
    refine Filter.mem_map.2 (Filter.mem_of_superset (Tri_mem hD j) (fun x hx => ?_))
    show - -x ∈ Tri D j
    rwa [neg_neg]

theorem exists_Tri {F : Filter G} : ∀ (j : ℕ) (s : Set G), s ∈ tri F j → ∃ D ∈ F, Tri D j ⊆ s
  | 0, s, hs => ⟨s, hs, Subset.rfl⟩
  | j + 1, s, hs => by
    obtain ⟨t1, ht1, t2, ht2, h⟩ := Filter.mem_map₂_iff.1 hs
    obtain ⟨a, ha, b, hb, hab⟩ := Filter.mem_map₂_iff.1 ht1
    obtain ⟨D1, hD1, h1⟩ := exists_Tri j a ha
    obtain ⟨D2, hD2, h2⟩ := exists_Tri j b hb
    obtain ⟨D3, hD3, h3⟩ := exists_Tri j _ (Filter.mem_map.1 ht2)
    refine ⟨D1 ∩ D2 ∩ D3, Filter.inter_mem (Filter.inter_mem hD1 hD2) hD3, ?_⟩
    refine Subset.trans (image2_subset (Subset.trans (image2_subset ?_ ?_) hab) ?_) h
    · exact (Tri_mono (fun x hx => hx.1.1) j).trans h1
    · exact (Tri_mono (fun x hx => hx.1.2) j).trans h2
    · intro x hx
      have h4 : -x ∈ (fun x : G => -x) ⁻¹' t2 := h3 (Tri_mono (fun y hy => hy.2) j hx)
      have h5 : - -x ∈ t2 := h4
      rwa [neg_neg] at h5

theorem tri_sumClosure {S : Set (Filter G)} {F : Filter G} (h : SumClosure S F) : ∀ j, SumClosure S (tri F j)
  | 0 => h
  | j + 1 => SumClosure.add (SumClosure.add (tri_sumClosure h j) (tri_sumClosure h j))
      (sumClosure_neg (tri_sumClosure h j))

/-- `Q (j + n) + ... + Q j`. -/
def chain (Q : ℕ → Ultrafilter G) : ℕ → ℕ → Ultrafilter G
  | j, 0 => Q j
  | j, n + 1 => chain Q (j + 1) n + Q j

theorem chain_step (Q : ℕ → Ultrafilter G) (i n : ℕ) (h : i < n) :
    chain Q i (n - i) = chain Q (i + 1) (n - (i + 1)) + Q i := by
  have e : n - i = (n - (i + 1)) + 1 := by omega
  rw [e]
  rfl

theorem chain_le_tri (Q : ℕ → Ultrafilter G) (hQ : ∀ i, Schur (Q i)) (n : ℕ) :
    ∀ i, i ≤ n → (chain Q i (n - i) : Filter G) ≤ tri (chain Q 0 n : Filter G) i := by
  intro i
  induction i with
  | zero => intro _; exact le_rfl
  | succ i ih =>
    intro hi
    have h1 := ih (by omega)
    have h2 := le_three (hQ i) (Or.inl (chain_step Q i n (by omega)))
    exact h2.trans (Filter.map₂_mono (Filter.map₂_mono h1 h1) (Filter.map_mono h1))

theorem Q_le_chain (Q : ℕ → Ultrafilter G) (hQ : ∀ i, Schur (Q i)) (n i : ℕ) (h : i < n) :
    (Q i : Filter G) ≤ Filter.map₂ (· + ·) (tri (chain Q 0 n : Filter G) i)
      (negF (tri (chain Q 0 n : Filter G) (i + 1))) := by
  have h1 := le_diff (v := chain Q (i + 1) (n - (i + 1))) (q := Q i) (Or.inl (chain_step Q i n h))
  exact h1.trans (Filter.map₂_mono (chain_le_tri Q hQ n i h.le)
    (Filter.map_mono (chain_le_tri Q hQ n (i + 1) h)))

/-- The limit of the sums `Q n + ... + Q 0`. -/
noncomputable def chainLim (Q : ℕ → Ultrafilter G) : Ultrafilter G :=
  (hyperfilter ℕ).bind (fun n => chain Q 0 n)

theorem mem_chainLim (Q : ℕ → Ultrafilter G) (s : Set G) :
    s ∈ chainLim Q ↔ {n | s ∈ chain Q 0 n} ∈ hyperfilter ℕ :=
  Filter.mem_bind'

theorem Q_le_chainLim (Q : ℕ → Ultrafilter G) (hQ : ∀ i, Schur (Q i)) (i : ℕ) :
    (Q i : Filter G) ≤ Filter.map₂ (· + ·) (tri (chainLim Q : Filter G) i)
      (negF (tri (chainLim Q : Filter G) (i + 1))) := by
  intro s hs
  obtain ⟨t1, ht1, t2, ht2, h⟩ := Filter.mem_map₂_iff.1 hs
  obtain ⟨D1, hD1, h1⟩ := exists_Tri i t1 ht1
  obtain ⟨D2, hD2, h2⟩ := exists_Tri (i + 1) _ (Filter.mem_map.1 ht2)
  have hD : D1 ∩ D2 ∈ chainLim Q := Filter.inter_mem hD1 hD2
  rw [mem_chainLim] at hD
  have hbig : {n | i < n} ∈ hyperfilter ℕ :=
    Nat.hyperfilter_le_atTop (Filter.eventually_gt_atTop i)
  obtain ⟨n, hn, hin⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem hD hbig)
  have hn' : D1 ∩ D2 ∈ (chain Q 0 n : Filter G) := hn
  refine Q_le_chain Q hQ n i hin ?_
  refine Filter.mem_of_superset (Filter.image2_mem_map₂ (Tri_mem hn' i)
    (Filter.mem_map.2 (Filter.mem_of_superset (Tri_mem hn' (i + 1))
      (fun x hx => (show x ∈ (fun y : G => -y) ⁻¹' ((fun y : G => -y) ⁻¹' Tri (D1 ∩ D2) (i + 1)) by
        show - -x ∈ Tri (D1 ∩ D2) (i + 1)
        rwa [neg_neg]))))) ?_
  rintro _ ⟨a, ha, b, hb, rfl⟩
  have ha' : a ∈ t1 := h1 (Tri_mono inter_subset_left i ha)
  have hb' : -b ∈ (fun y : G => -y) ⁻¹' t2 := h2 (Tri_mono inter_subset_right (i + 1) hb)
  have hb'' : - -b ∈ t2 := hb'
  rw [neg_neg] at hb''
  exact h (mem_image2_of_mem ha' hb'')

/-- Countably many Schur ultrafilters converge to `0` in the PG generated by one ultrafilter. -/
theorem countably_many (Q : ℕ → Ultrafilter G) (hQ : ∀ i, Schur (Q i)) :
    ∃ u : Ultrafilter G, ∀ i, (Q i : Filter G) ∈ genFam (ultraGen {u}) := by
  refine ⟨chainLim Q, fun i => ?_⟩
  have hgen : SumClosure (ultraGen {chainLim Q}) (chainLim Q : Filter G) :=
    SumClosure.gen ⟨_, rfl, rfl⟩
  have hσ := SumClosure.add (tri_sumClosure hgen i) (sumClosure_neg (tri_sumClosure hgen (i + 1)))
  have hle := Q_le_chainLim Q hQ i
  exact mem_genFam_of_le hσ hle

end Schur

/-! ### Fourier analysis on finite Boolean groups -/

abbrev V (n : ℕ) : Type := Fin n → ZMod 2

def sgn (t : ZMod 2) : ℝ := if t = 0 then 1 else -1

theorem zmod_two (t : ZMod 2) : t = 0 ∨ t = 1 := by
  revert t
  decide

theorem sgn_zero : sgn 0 = 1 := if_pos rfl

theorem sgn_one : sgn 1 = -1 := if_neg (by decide)

theorem sgn_add (a b : ZMod 2) : sgn (a + b) = sgn a * sgn b := by
  have h2 : (1 + 1 : ZMod 2) = 0 := by decide
  rcases zmod_two a with rfl | rfl <;> rcases zmod_two b with rfl | rfl <;>
    simp [sgn_zero, sgn_one, h2]

theorem sgn_sq_le (a : ZMod 2) : -1 ≤ sgn a := by
  rcases zmod_two a with rfl | rfl <;> simp [sgn_zero, sgn_one]

theorem add_eq_zero_iff_two {n : ℕ} (x y : V n) : x + y = 0 ↔ y = x := by
  have h : ∀ a b : ZMod 2, a + b = 0 ↔ b = a := by decide
  constructor
  · intro hxy
    funext i
    exact (h _ _).1 (congrFun hxy i)
  · rintro rfl
    funext i
    exact (h _ _).2 rfl

theorem orth {n : ℕ} (x : V n) : (∑ a : V n, sgn (a ⬝ᵥ x)) = if x = 0 then (2 : ℝ) ^ n else 0 := by
  by_cases hx : x = 0
  · rw [if_pos hx, hx]
    simp [sgn_zero, ZMod.card]
  · rw [if_neg hx]
    obtain ⟨j, hj⟩ := Function.ne_iff.1 hx
    have hj1 : x j = 1 := (zmod_two (x j)).resolve_left hj
    set a0 : V n := Pi.single j 1 with ha0
    have h0 : a0 ⬝ᵥ x = 1 := by rw [ha0, single_dotProduct, one_mul, hj1]
    have h1 : (∑ a : V n, sgn ((a + a0) ⬝ᵥ x)) = ∑ a : V n, sgn (a ⬝ᵥ x) :=
      Fintype.sum_equiv (Equiv.addRight a0) (fun a => sgn ((a + a0) ⬝ᵥ x)) (fun a => sgn (a ⬝ᵥ x))
        (fun _ => rfl)
    have h2 : (∑ a : V n, sgn ((a + a0) ⬝ᵥ x)) = -∑ a : V n, sgn (a ⬝ᵥ x) := by
      rw [← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      rw [add_dotProduct, h0, sgn_add, sgn_one, mul_neg_one]
    linarith

def fhat {n : ℕ} (D : Finset (V n)) (a : V n) : ℝ := ∑ x ∈ D, sgn (a ⬝ᵥ x)

theorem fhat_sq {n : ℕ} (D : Finset (V n)) (a : V n) :
    fhat D a ^ 2 = ∑ p ∈ D ×ˢ D, sgn (a ⬝ᵥ (p.1 + p.2)) := by
  unfold fhat
  rw [sq, Finset.sum_mul_sum, Finset.sum_product]
  refine Finset.sum_congr rfl (fun x _ => Finset.sum_congr rfl (fun y _ => ?_))
  rw [dotProduct_add, sgn_add]

theorem parseval {n : ℕ} (D : Finset (V n)) : (∑ a : V n, fhat D a ^ 2) = (2 : ℝ) ^ n * D.card := by
  simp only [fhat_sq]
  rw [Finset.sum_comm]
  simp only [orth]
  rw [Finset.sum_product]
  have h : ∀ x ∈ D, (∑ y ∈ D, (if x + y = 0 then (2 : ℝ) ^ n else 0)) = (2 : ℝ) ^ n := by
    intro x hx
    simp only [add_eq_zero_iff_two]
    rw [Finset.sum_ite_eq' D x (fun _ => (2 : ℝ) ^ n), if_pos hx]
  rw [Finset.sum_congr rfl h, Finset.sum_const, nsmul_eq_mul, mul_comm]

theorem rep_of_fourth_ne_zero {n : ℕ} (D : Finset (V n)) (z : V n)
    (h : (∑ a : V n, fhat D a ^ 4 * sgn (a ⬝ᵥ z)) ≠ 0) :
    ∃ x1 ∈ D, ∃ x2 ∈ D, ∃ x3 ∈ D, ∃ x4 ∈ D, z = x1 + x2 + x3 + x4 := by
  by_contra hno
  apply h
  have e : ∀ a : V n, fhat D a ^ 4 * sgn (a ⬝ᵥ z)
      = ∑ p ∈ D ×ˢ D, ∑ r ∈ D ×ˢ D, sgn (a ⬝ᵥ (p.1 + p.2 + (r.1 + r.2) + z)) := by
    intro a
    have e4 : fhat D a ^ 4 = fhat D a ^ 2 * fhat D a ^ 2 := by ring
    rw [e4, fhat_sq, Finset.sum_mul_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl (fun r _ => ?_)
    simp only [dotProduct_add, sgn_add]
  simp only [e]
  rw [Finset.sum_comm]
  refine Finset.sum_eq_zero (fun p hp => ?_)
  rw [Finset.sum_comm]
  refine Finset.sum_eq_zero (fun r hr => ?_)
  rw [orth, if_neg]
  intro h0
  have h1 := (add_eq_zero_iff_two _ _).1 h0
  rw [Finset.mem_product] at hp hr
  exact hno ⟨p.1, hp.1, p.2, hp.2, r.1, hr.1, r.2, hr.2, by rw [h1]; abel⟩

/-- Bogolyubov's lemma in `(ZMod 2)^n`. -/
theorem finite_bogolyubov {n : ℕ} (D : Finset (V n)) (α : ℝ) (hα : 0 < α) (hD : α * 2 ^ n ≤ D.card) :
    ∃ R : Finset (V n), (R.card : ℝ) ≤ 2 / α ^ 2 ∧
      ∀ z : V n, (∀ a ∈ R, a ⬝ᵥ z = 0) → ∃ x1 ∈ D, ∃ x2 ∈ D, ∃ x3 ∈ D, ∃ x4 ∈ D, z = x1 + x2 + x3 + x4 := by
  classical
  set N : ℝ := (2 : ℝ) ^ n with hN
  set m : ℝ := (D.card : ℝ) with hm
  have hNpos : 0 < N := by positivity
  have hmpos : 0 < m := lt_of_lt_of_le (mul_pos hα hNpos) hD
  set τ : ℝ := m ^ 3 / (2 * N) with hτ
  have hτpos : 0 < τ := by positivity
  set R : Finset (V n) := Finset.univ.filter (fun a => a ≠ 0 ∧ τ ≤ fhat D a ^ 2) with hR
  have hpar : (∑ a : V n, fhat D a ^ 2) = N * m := parseval D
  refine ⟨R, ?_, fun z hz => ?_⟩
  · have h1 : (R.card : ℝ) * τ ≤ N * m := by
      rw [← hpar]
      calc (R.card : ℝ) * τ = ∑ _a ∈ R, τ := by rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ ∑ a ∈ R, fhat D a ^ 2 := Finset.sum_le_sum (fun a ha => (Finset.mem_filter.1 ha).2.2)
        _ ≤ ∑ a : V n, fhat D a ^ 2 :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) (fun a _ _ => sq_nonneg _)
    have h2 : (R.card : ℝ) * m ^ 2 ≤ 2 * N ^ 2 := by
      have h3 : (R.card : ℝ) * m ^ 3 ≤ (N * m) * (2 * N) := by
        have h4 := mul_le_mul_of_nonneg_right h1 (by positivity : (0 : ℝ) ≤ 2 * N)
        have e : (R.card : ℝ) * τ * (2 * N) = (R.card : ℝ) * m ^ 3 := by
          rw [hτ]
          field_simp
        rwa [e] at h4
      have h5 : ((R.card : ℝ) * m ^ 2) * m ≤ (2 * N ^ 2) * m := by
        calc ((R.card : ℝ) * m ^ 2) * m = (R.card : ℝ) * m ^ 3 := by ring
          _ ≤ (N * m) * (2 * N) := h3
          _ = (2 * N ^ 2) * m := by ring
      exact le_of_mul_le_mul_right h5 hmpos
    rw [le_div_iff₀ (by positivity)]
    have h6 : (R.card : ℝ) * (α * N) ^ 2 ≤ 2 * N ^ 2 :=
      le_trans (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (mul_pos hα hNpos).le hD 2)
        (Nat.cast_nonneg _)) h2
    have h7 : ((R.card : ℝ) * α ^ 2) * N ^ 2 ≤ 2 * N ^ 2 := by
      calc ((R.card : ℝ) * α ^ 2) * N ^ 2 = (R.card : ℝ) * (α * N) ^ 2 := by ring
        _ ≤ 2 * N ^ 2 := h6
    exact le_of_mul_le_mul_right h7 (by positivity)
  · refine rep_of_fourth_ne_zero D z (ne_of_gt ?_)
    have hzero : fhat D 0 = m := by
      unfold fhat
      simp [sgn_zero, hm]
    have key : ∀ a : V n, (if a = 0 then m ^ 4 else 0) - τ * fhat D a ^ 2
        ≤ fhat D a ^ 4 * sgn (a ⬝ᵥ z) := by
      intro a
      have hnn : 0 ≤ τ * fhat D a ^ 2 := mul_nonneg hτpos.le (sq_nonneg _)
      have h4nn : 0 ≤ fhat D a ^ 4 := by
        have e : fhat D a ^ 4 = (fhat D a ^ 2) ^ 2 := by ring
        rw [e]
        exact sq_nonneg _
      by_cases ha : a = 0
      · rw [if_pos ha, ha, hzero, zero_dotProduct, sgn_zero, mul_one]
        rw [ha, hzero] at hnn
        linarith
      · rw [if_neg ha, zero_sub]
        by_cases haR : a ∈ R
        · rw [hz a haR, sgn_zero, mul_one]
          linarith
        · have hlt : fhat D a ^ 2 < τ := by
            by_contra hge
            exact haR (Finset.mem_filter.2 ⟨Finset.mem_univ _, ha, not_lt.1 hge⟩)
          have h1 : -(fhat D a ^ 4) ≤ fhat D a ^ 4 * sgn (a ⬝ᵥ z) := by
            have h2 := mul_le_mul_of_nonneg_left (sgn_sq_le (a ⬝ᵥ z)) h4nn
            rwa [mul_neg_one] at h2
          have h3 : fhat D a ^ 4 ≤ τ * fhat D a ^ 2 := by
            have e : fhat D a ^ 4 = fhat D a ^ 2 * fhat D a ^ 2 := by ring
            rw [e]
            exact mul_le_mul_of_nonneg_right hlt.le (sq_nonneg _)
          linarith
    have hsum := Finset.sum_le_sum (s := Finset.univ) (fun a (_ : a ∈ Finset.univ) => key a)
    rw [Finset.sum_sub_distrib, Finset.sum_ite_eq' Finset.univ (0 : V n) (fun _ => m ^ 4),
      if_pos (Finset.mem_univ _), ← Finset.mul_sum, hpar] at hsum
    have e : m ^ 4 - τ * (N * m) = m ^ 4 / 2 := by
      rw [hτ]
      field_simp
      ring
    rw [e] at hsum
    exact lt_of_lt_of_le (by positivity) hsum

/-! ### Upper density in the countable Boolean group -/

/-- The countable Boolean group. -/
abbrev A2 : Type := ℕ →₀ ZMod 2

/-- The copy of `(ZMod 2)^n` supported below `n`. -/
noncomputable def emb (n : ℕ) : V n →+ A2 where
  toFun x := Finsupp.onFinset (Finset.range n) (fun s => if h : s < n then x ⟨s, h⟩ else 0) (by
    intro s hs
    by_contra h
    exact hs (dif_neg (fun h' => h (Finset.mem_range.2 h'))))
  map_zero' := by
    ext s
    simp
  map_add' x y := by
    ext s
    by_cases h : s < n <;> simp [h]

theorem emb_apply (n : ℕ) (x : V n) (s : ℕ) : emb n x s = if h : s < n then x ⟨s, h⟩ else 0 := rfl

def res (n : ℕ) : A2 →+ V n where
  toFun z i := z i
  map_zero' := by funext i; simp
  map_add' x y := by funext i; simp

theorem emb_injective (n : ℕ) : Function.Injective (emb n) := by
  intro x y h
  funext i
  have h1 := DFunLike.congr_fun h (i : ℕ)
  rwa [emb_apply, emb_apply, dif_pos i.2, dif_pos i.2] at h1

theorem emb_res (n : ℕ) (z : A2) (hz : ∀ s ∈ z.support, s < n) : emb n (res n z) = z := by
  ext s
  rw [emb_apply]
  by_cases h : s < n
  · rw [dif_pos h]
    rfl
  · rw [dif_neg h]
    by_contra h'
    exact h (hz s (Finsupp.mem_support_iff.2 (Ne.symm h')))

open Classical in
noncomputable def cnt (s : Set A2) (n : ℕ) : ℕ := (Finset.univ.filter (fun x : V n => emb n x ∈ s)).card

/-- Positive upper density. -/
def Dense' (s : Set A2) : Prop := ∃ α : ℝ, 0 < α ∧ ∀ N : ℕ, ∃ n, N ≤ n ∧ α * 2 ^ n ≤ (cnt s n : ℝ)

theorem cnt_mono {s t : Set A2} (h : s ⊆ t) (n : ℕ) : cnt s n ≤ cnt t n := by
  classical
  refine Finset.card_le_card (fun x hx => ?_)
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx ⊢
  exact h hx

theorem dense_mono {s t : Set A2} (h : s ⊆ t) (hs : Dense' s) : Dense' t := by
  obtain ⟨α, hα, H⟩ := hs
  refine ⟨α, hα, fun N => ?_⟩
  obtain ⟨n, hn, h1⟩ := H N
  exact ⟨n, hn, h1.trans (by exact_mod_cast cnt_mono h n)⟩

theorem dense_union {s t : Set A2} (h : Dense' (s ∪ t)) : Dense' s ∨ Dense' t := by
  classical
  by_contra hno
  rw [not_or] at hno
  obtain ⟨α, hα, H⟩ := h
  have aux : ∀ u : Set A2, ¬ Dense' u → ∃ N : ℕ, ∀ n, N ≤ n → (cnt u n : ℝ) < α / 2 * 2 ^ n := by
    intro u hu
    by_contra hc
    refine hu ⟨α / 2, half_pos hα, fun N => ?_⟩
    by_contra h2
    exact hc ⟨N, fun n hn => not_le.1 (fun h3 => h2 ⟨n, hn, h3⟩)⟩
  obtain ⟨N1, h1⟩ := aux s hno.1
  obtain ⟨N2, h2⟩ := aux t hno.2
  obtain ⟨n, hn, h3⟩ := H (max N1 N2)
  have h4 : cnt (s ∪ t) n ≤ cnt s n + cnt t n := by
    refine le_trans (Finset.card_le_card (fun x hx => ?_)) (Finset.card_union_le _ _)
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_union, mem_union] at hx ⊢
    exact hx
  have h5 : (cnt (s ∪ t) n : ℝ) ≤ (cnt s n : ℝ) + cnt t n := by exact_mod_cast h4
  have h6 := h1 n (le_trans (le_max_left _ _) hn)
  have h7 := h2 n (le_trans (le_max_right _ _) hn)
  nlinarith

theorem dense_univ : Dense' (univ : Set A2) := by
  classical
  refine ⟨1, one_pos, fun N => ⟨N, le_rfl, ?_⟩⟩
  have h : cnt (univ : Set A2) N = 2 ^ N := by
    unfold cnt
    simp [ZMod.card]
  rw [h, one_mul]
  push_cast
  exact le_rfl

theorem not_dense_zero : ¬ Dense' ({0} : Set A2) := by
  classical
  rintro ⟨α, hα, H⟩
  obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt (1 / α) (one_lt_two : (1 : ℝ) < 2)
  obtain ⟨n, hn, h1⟩ := H N
  have h2 : cnt ({0} : Set A2) n ≤ 1 := by
    refine Finset.card_le_one.2 (fun x hx y hy => ?_)
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, mem_singleton_iff] at hx hy
    exact emb_injective n (hx.trans hy.symm)
  have h3 : 1 / α < (2 : ℝ) ^ n := lt_of_lt_of_le hN (pow_le_pow_right₀ one_le_two hn)
  have h4 : 1 < (2 : ℝ) ^ n * α := (div_lt_iff₀ hα).1 h3
  have h5 : (cnt ({0} : Set A2) n : ℝ) ≤ 1 := by exact_mod_cast h2
  nlinarith

theorem cnt_translate (a : A2) (s : Set A2) (n : ℕ) (ha : ∀ k ∈ a.support, k < n) :
    cnt ((fun z => a + z) ⁻¹' s) n = cnt s n := by
  classical
  have e : ∀ x : V n, emb n (res n a + x) = a + emb n x := by
    intro x
    rw [map_add, emb_res n a ha]
  have h2 : ∀ x : V n, res n a + (res n a + x) = x := by
    intro x
    rw [← add_assoc, (add_eq_zero_iff_two (res n a) (res n a)).2 rfl, zero_add]
  refine Finset.card_bij' (fun x _ => res n a + x) (fun x _ => res n a + x) ?_ ?_ (fun x _ => h2 x)
    (fun x _ => h2 x)
  · intro x hx
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, mem_preimage] at hx ⊢
    rwa [e]
  · intro x hx
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, mem_preimage] at hx ⊢
    rw [← e, h2]
    exact hx

theorem dense_translate (a : A2) (s : Set A2) (h : Dense' ((fun z => a + z) ⁻¹' s)) : Dense' s := by
  obtain ⟨α, hα, H⟩ := h
  refine ⟨α, hα, fun N => ?_⟩
  obtain ⟨n, hn, h1⟩ := H (max N (a.support.sup id + 1))
  refine ⟨n, le_trans (le_max_left _ _) hn, ?_⟩
  rwa [cnt_translate a s n (fun k hk => ?_)] at h1
  have h2 : k ≤ a.support.sup id := Finset.le_sup (f := id) hk
  have h3 := le_trans (le_max_right _ _) hn
  omega

theorem exists_essential_idempotent : ∃ q : Ultrafilter A2, q + q = q ∧ ∀ s ∈ q, Dense' s := by
  let F : Filter A2 :=
    { sets := {s | ¬ Dense' sᶜ}
      univ_sets := by
        show ¬ Dense' (univ : Set A2)ᶜ
        rw [compl_univ]
        intro h
        exact not_dense_zero (dense_mono (empty_subset _) h)
      sets_of_superset := fun hx hxy h => hx (dense_mono (compl_subset_compl.2 hxy) h)
      inter_sets := fun {x y} hx hy h => by
        rw [compl_inter] at h
        rcases dense_union h with h | h
        · exact hx h
        · exact hy h }
  have hF : F.NeBot := by
    refine ⟨fun h => ?_⟩
    have h1 : (∅ : Set A2) ∈ F := by rw [h]; exact mem_bot
    have h2 : ¬ Dense' (∅ : Set A2)ᶜ := h1
    rw [compl_empty] at h2
    exact h2 dense_univ
  set X : Set (Ultrafilter A2) := {p | ∀ s ∈ p, Dense' s} with hX
  have hne : X.Nonempty := by
    refine ⟨Ultrafilter.of F, fun s hs => ?_⟩
    by_contra h
    have h1 : sᶜ ∈ F := by
      show ¬ Dense' sᶜᶜ
      rwa [compl_compl]
    exact Ultrafilter.compl_mem_iff_notMem.1 (Ultrafilter.of_le F h1) hs
  have hclosed : IsClosed X := by
    have h1 : X = ⋂ s ∈ {s : Set A2 | ¬ Dense' s}, {p : Ultrafilter A2 | sᶜ ∈ p} := by
      ext p
      rw [mem_iInter₂]
      constructor
      · intro hp s hs
        exact Ultrafilter.compl_mem_iff_notMem.2 (fun h => hs (hp s h))
      · intro hp s hs
        by_contra h
        exact Ultrafilter.compl_mem_iff_notMem.1 (hp s h) hs
    rw [h1]
    exact isClosed_biInter (fun s _ => ultrafilter_isClosed_basic _)
  have hadd : ∀ p ∈ X, ∀ r ∈ X, p + r ∈ X := by
    intro p _ r hr s hs
    rw [PG.Idem.mem_add] at hs
    obtain ⟨x, hx⟩ := Ultrafilter.nonempty_of_mem hs
    have hx' : {z : A2 | x + z ∈ s} ∈ r := hx
    exact dense_translate x s (hr _ hx')
  obtain ⟨q, hqX, hqq⟩ := exists_idempotent_in_compact_add_subsemigroup
    (M := Ultrafilter A2) Ultrafilter.continuous_add_left X hne hclosed.isCompact hadd
  exact ⟨q, hqq, hqX⟩

/-- Bogolyubov's lemma in the countable Boolean group. -/
theorem bogolyubov (s : Set A2) (hs : Dense' s) :
    ∃ W : AddSubgroup A2, W.FiniteIndex ∧ ∀ z ∈ W, ∃ x1 ∈ s, ∃ x2 ∈ s, ∃ x3 ∈ s, ∃ x4 ∈ s,
      z = x1 + x2 + x3 + x4 := by
  classical
  obtain ⟨α, hα, H⟩ := hs
  set good : Set ℕ := {n | α * 2 ^ n ≤ (cnt s n : ℝ)} with hgood
  set d : ℕ := ⌊2 / α ^ 2⌋₊ with hd
  have hR : ∀ n, ∃ R : Finset (V n), n ∈ good → R.card ≤ d ∧
      ∀ z : V n, (∀ a ∈ R, a ⬝ᵥ z = 0) → ∃ x1 x2 x3 x4 : V n, emb n x1 ∈ s ∧ emb n x2 ∈ s ∧
        emb n x3 ∈ s ∧ emb n x4 ∈ s ∧ z = x1 + x2 + x3 + x4 := by
    intro n
    by_cases hn : n ∈ good
    · obtain ⟨R, h1, h2⟩ := finite_bogolyubov (Finset.univ.filter (fun x : V n => emb n x ∈ s)) α hα hn
      refine ⟨R, fun _ => ⟨Nat.le_floor h1, fun z hz => ?_⟩⟩
      obtain ⟨x1, h1, x2, h2', x3, h3, x4, h4, h5⟩ := h2 z hz
      exact ⟨x1, x2, x3, x4, (Finset.mem_filter.1 h1).2, (Finset.mem_filter.1 h2').2,
        (Finset.mem_filter.1 h3).2, (Finset.mem_filter.1 h4).2, h5⟩
    · exact ⟨∅, fun h => absurd h hn⟩
  choose R hR using hR
  let a : (n : ℕ) → Fin d → V n := fun n j =>
    if h : (j : ℕ) < (R n).card then ((R n).equivFin.symm ⟨j, h⟩ : V n) else 0
  let ψ : ℕ → A2 → (Fin d → ZMod 2) := fun n z j => a n j ⬝ᵥ res n z
  have hinf : good.Infinite := by
    refine Set.infinite_of_forall_exists_gt (fun N => ?_)
    obtain ⟨n, hn, h1⟩ := H (N + 1)
    exact ⟨n, h1, hn⟩
  have hne : (atTop ⊓ 𝓟 good : Filter ℕ).NeBot := by
    rw [inf_principal_neBot_iff]
    intro U hU
    obtain ⟨N, hN⟩ := mem_atTop_sets.1 hU
    obtain ⟨n, hn, h1⟩ := hinf.exists_gt N
    exact ⟨n, hN n h1.le, hn⟩
  set w : Ultrafilter ℕ := Ultrafilter.of (atTop ⊓ 𝓟 good) with hw
  have hwle : (w : Filter ℕ) ≤ atTop ⊓ 𝓟 good := Ultrafilter.of_le _
  have hφ : ∀ z : A2, ∃ c : Fin d → ZMod 2, ∀ᶠ n in (w : Filter ℕ), ψ n z = c := by
    intro z
    obtain ⟨c, _, hc⟩ := Ultrafilter.eq_pure_of_finite_mem (f := w.map (fun n => ψ n z))
      finite_univ Filter.univ_mem
    refine ⟨c, ?_⟩
    have h1 : ({c} : Set (Fin d → ZMod 2)) ∈ w.map (fun n => ψ n z) := by
      rw [hc]
      exact rfl
    exact h1
  choose φ hφ using hφ
  have hadd : ∀ x y : A2, φ (x + y) = φ x + φ y := by
    intro x y
    obtain ⟨n, h1, h2, h3⟩ := ((hφ (x + y)).and ((hφ x).and (hφ y))).exists
    rw [← h1, ← h2, ← h3]
    funext j
    show a n j ⬝ᵥ res n (x + y) = a n j ⬝ᵥ res n x + a n j ⬝ᵥ res n y
    rw [map_add, dotProduct_add]
  let Φ : A2 →+ (Fin d → ZMod 2) := AddMonoidHom.mk' φ hadd
  refine ⟨Φ.ker, inferInstance, fun z hz => ?_⟩
  have hz0 : φ z = 0 := hz
  have hsupp : ∀ᶠ n in (w : Filter ℕ), ∀ k ∈ z.support, k < n := by
    refine (hwle.trans inf_le_left) ?_
    filter_upwards [eventually_gt_atTop (z.support.sup id)] with n hn k hk
    exact lt_of_le_of_lt (Finset.le_sup (f := id) hk) hn
  have hg : ∀ᶠ n in (w : Filter ℕ), n ∈ good := (hwle.trans inf_le_right) (mem_principal_self _)
  obtain ⟨n, h1, h2, h3⟩ := ((hφ z).and (hg.and hsupp)).exists
  obtain ⟨hcard, hrep⟩ := hR n h2
  have horth : ∀ b ∈ R n, b ⬝ᵥ res n z = 0 := by
    intro b hb
    set k := (R n).equivFin ⟨b, hb⟩ with hk
    have hkd : (k : ℕ) < d := lt_of_lt_of_le k.2 hcard
    have h4 := congrFun (h1.trans hz0) ⟨k, hkd⟩
    have h5 : a n ⟨k, hkd⟩ = b := by
      show (if h : (k : ℕ) < (R n).card then ((R n).equivFin.symm ⟨k, h⟩ : V n) else 0) = b
      rw [dif_pos k.2]
      have h6 : (⟨(k : ℕ), k.2⟩ : Fin (R n).card) = k := Fin.eta _ _
      rw [h6, hk, Equiv.symm_apply_apply]
    rw [← h5]
    exact h4
  obtain ⟨x1, x2, x3, x4, m1, m2, m3, m4, hsum⟩ := hrep (res n z) horth
  refine ⟨_, m1, _, m2, _, m3, _, m4, ?_⟩
  rw [← map_add, ← map_add, ← map_add, ← hsum, emb_res n z h3]

/-! ### The example -/

theorem map_add_hom {G H : Type} [AddZeroClass G] [AddZeroClass H] (f : G →+ H) (p r : Ultrafilter G) :
    (p + r).map f = p.map f + r.map f := by
  refine Ultrafilter.ext (fun s => ?_)
  rw [Ultrafilter.mem_map]
  have h1 := Ultrafilter.eventually_add p r (fun x => f x ∈ s)
  have h2 := Ultrafilter.eventually_add (p.map f) (r.map f) (fun x => x ∈ s)
  refine h1.trans (Iff.trans ?_ h2.symm)
  simp only [Ultrafilter.coe_map, Filter.eventually_map, map_add]

/- `H` is a Boolean group with copies `inc i` of `A2` and coordinates `comp i`, only finitely many of which are
nonzero at any point. -/
section Ex

variable {H : Type} [AddCommGroup H] (inc : ℕ → A2 →+ H) (comp : ℕ → H →+ A2)
  (hci : ∀ (i j : ℕ) (z : A2), comp i (inc j z) = if j = i then z else 0)
  (hfin : ∀ y : H, ∃ N : ℕ, ∀ i, N ≤ i → comp i y = 0)
  (h2 : ∀ y : H, -y = y)
  (q : Ultrafilter A2) (hq : q + q = q) (hd : ∀ s ∈ q, Dense' s)

noncomputable def Qc (i : ℕ) : Ultrafilter H := q.map (inc i)

include hq in
theorem Qc_idempotent (i : ℕ) : Qc inc q i + Qc inc q i = Qc inc q i := by
  have h := map_add_hom (inc i) q q
  rw [hq] at h
  exact h.symm

include hq in
theorem mem_of_finiteIndex (W : AddSubgroup A2) [W.FiniteIndex] : (W : Set A2) ∈ q := by
  have hmap := map_add_hom (QuotientAddGroup.mk' W) q q
  rw [hq] at hmap
  obtain ⟨c, _, hc⟩ := Ultrafilter.eq_pure_of_finite_mem (f := q.map (QuotientAddGroup.mk' W))
    finite_univ Filter.univ_mem
  rw [hc] at hmap
  have hsum : ((pure c : Ultrafilter (A2 ⧸ W)) + pure c) = pure (c + c) := by
    refine Ultrafilter.ext (fun s => ?_)
    rw [PG.Idem.mem_add]
    rfl
  rw [hsum] at hmap
  have hc0 : c = 0 := add_eq_left.1 (Ultrafilter.pure_injective hmap).symm
  have h1 : ({c} : Set (A2 ⧸ W)) ∈ q.map (QuotientAddGroup.mk' W) := by
    rw [hc]
    exact rfl
  refine Filter.mem_of_superset (Ultrafilter.mem_map.1 h1) (fun z hz => ?_)
  have h3 : (z : A2 ⧸ W) = 0 := Eq.trans hz hc0
  exact (QuotientAddGroup.eq_zero_iff z).1 h3

/-- Nonzero elements supported above `M`. -/
def above (M : ℕ) : Set A2 := {t | t ≠ 0 ∧ ∀ s ∈ t.support, M < s}

include hq hd in
theorem above_mem (M : ℕ) : above M ∈ q := by
  have h0 : ({0} : Set A2)ᶜ ∈ q :=
    Ultrafilter.compl_mem_iff_notMem.2 (fun h => not_dense_zero (hd _ h))
  have h1 := mem_of_finiteIndex q hq (res (M + 1)).ker
  refine Filter.mem_of_superset (Filter.inter_mem h0 h1) (fun t ht => ⟨ht.1, fun s hs => ?_⟩)
  by_contra h
  have h2' : res (M + 1) t = 0 := ht.2
  have h3 := congrFun h2' ⟨s, by omega⟩
  exact Finsupp.mem_support_iff.1 hs h3

/-- Elements with the components `j, ..., j + n`, each supported above the next. -/
def Sset (j n : ℕ) : Set H :=
  {x | (∀ i, comp i x ≠ 0 ↔ j ≤ i ∧ i ≤ j + n) ∧
    ∀ i, j ≤ i → i < j + n → ∀ s ∈ (comp i x).support, ∀ t ∈ (comp (i + 1) x).support, t < s}

include hci hfin hq hd in
theorem Sset_mem : ∀ n j : ℕ, Sset comp j n ∈ chain (Qc inc q) j n
  | 0, j => by
    rw [chain, Qc, Ultrafilter.mem_map]
    refine Filter.mem_of_superset (above_mem q hq hd 0) (fun t ht => ?_)
    rw [mem_preimage]
    refine ⟨fun i => ?_, fun i h1 h2 => by omega⟩
    rw [hci]
    by_cases h : j = i
    · rw [if_pos h]
      exact ⟨fun _ => by omega, fun _ => ht.1⟩
    · rw [if_neg h]
      exact ⟨fun h' => absurd rfl h', fun h' => absurd (by omega : j = i) h⟩
  | n + 1, j => by
    rw [chain, PG.Idem.mem_add]
    refine Filter.mem_of_superset (Sset_mem n (j + 1)) (fun y hy => ?_)
    rw [mem_setOf_eq, Qc, Ultrafilter.mem_map]
    obtain ⟨N, hN⟩ := hfin y
    set M : ℕ := (Finset.range N).sup (fun i => (comp i y).support.sup id) with hM
    have hbound : ∀ i, ∀ s ∈ (comp i y).support, s ≤ M := by
      intro i s hs
      have hi : i ∈ Finset.range N := by
        refine Finset.mem_range.2 (not_le.1 (fun h => ?_))
        rw [hN i h] at hs
        simp at hs
      exact le_trans (Finset.le_sup (f := id) hs)
        (Finset.le_sup (f := fun i => (comp i y).support.sup id) hi)
    have hyj : comp j y = 0 := by
      by_contra h
      have := (hy.1 j).1 h
      omega
    refine Filter.mem_of_superset (above_mem q hq hd M) (fun t ht => ?_)
    rw [mem_preimage, mem_setOf_eq]
    have hx : ∀ i, comp i (y + inc j t) = if j = i then t else comp i y := by
      intro i
      rw [map_add, hci]
      by_cases h : j = i
      · rw [if_pos h, if_pos h, ← h, hyj, zero_add]
      · rw [if_neg h, if_neg h, add_zero]
    refine ⟨fun i => ?_, fun i h1 h2 s hs t' ht' => ?_⟩
    · rw [hx]
      by_cases h : j = i
      · rw [if_pos h]
        exact ⟨fun _ => by omega, fun _ => ht.1⟩
      · rw [if_neg h, hy.1 i]
        omega
    · rw [hx] at hs ht'
      have hne : j ≠ i + 1 := by omega
      rw [if_neg hne] at ht'
      by_cases h : j = i
      · rw [if_pos h] at hs
        exact lt_of_le_of_lt (hbound _ _ ht') (ht.2 s hs)
      · rw [if_neg h] at hs
        exact hy.2 i (by omega) (by omega) s hs t' ht'

noncomputable def u0 : Ultrafilter H := chainLim (Qc inc q)

def A0 : Set H := ⋃ n, Sset comp 0 n

include hci hfin hq hd in
theorem A0_mem : A0 comp ∈ u0 inc q := by
  unfold u0
  rw [mem_chainLim]
  refine Filter.mem_of_superset Filter.univ_mem (fun n _ => ?_)
  exact Filter.mem_of_superset (Sset_mem inc comp hci hfin q hq hd n 0)
    (subset_iUnion (fun n => Sset comp 0 n) n)

include hci hfin hq hd in
theorem u0_free (a : H) : u0 inc q ≠ pure a := by
  intro h
  have h1 : ∀ m, {x : H | comp m x ≠ 0} ∈ u0 inc q := by
    intro m
    unfold u0
    rw [mem_chainLim]
    refine Filter.mem_of_superset (Nat.hyperfilter_le_atTop (Filter.eventually_ge_atTop m)) (fun n hn => ?_)
    have hn' : m ≤ n := hn
    refine Filter.mem_of_superset (Sset_mem inc comp hci hfin q hq hd n 0) (fun x hx => ?_)
    exact (hx.1 m).2 ⟨Nat.zero_le _, by omega⟩
  obtain ⟨N, hN⟩ := hfin a
  have h3 := h1 N
  rw [h] at h3
  have h4 : comp N a ≠ 0 := h3
  exact h4 (hN N le_rfl)

/-- Sums of `L` elements of `A0`. -/
def nsum (L : ℕ) : Set H := {y | ∃ a : Fin L → H, (∀ l, a l ∈ A0 comp) ∧ ∑ l, a l = y}

include hci hfin h2 hq hd in
theorem nsum_of_sumClosure {σ : Filter H} (h : SumClosure (ultraGen {u0 inc q}) σ) : ∃ L, nsum comp L ∈ σ := by
  have hA : A0 comp ∈ u0 inc q := A0_mem inc comp hci hfin q hq hd
  have h1 : A0 comp ⊆ nsum comp 1 := fun x hx => ⟨fun _ => x, fun _ => hx, by simp⟩
  have hgen : ∀ F : Filter H, F ∈ ultraGen {u0 inc q} → nsum comp 1 ∈ F := by
    rintro F ⟨v, hv, rfl⟩
    rw [mem_singleton_iff.1 hv]
    exact Filter.mem_of_superset hA h1
  induction h with
  | zero => exact ⟨0, Filter.mem_pure.2 ⟨fun l => l.elim0, fun l => l.elim0, by simp⟩⟩
  | gen hF => exact ⟨1, hgen _ hF⟩
  | neg hF =>
    refine ⟨1, Filter.mem_map.2 ?_⟩
    have e : (fun x : H => -x) ⁻¹' nsum comp 1 = nsum comp 1 := by
      ext x
      rw [mem_preimage, h2]
    rw [e]
    exact hgen _ hF
  | add _ _ ih1 ih2 =>
    obtain ⟨L1, h1'⟩ := ih1
    obtain ⟨L2, h2'⟩ := ih2
    refine ⟨L1 + L2, Filter.mem_of_superset (Filter.image2_mem_map₂ h1' h2') ?_⟩
    rintro _ ⟨y1, ⟨a, ha, rfl⟩, y2, ⟨b, hb, rfl⟩, rfl⟩
    refine ⟨Fin.append a b, fun l => ?_, ?_⟩
    · refine Fin.addCases (fun i => ?_) (fun i => ?_) l
      · rw [Fin.append_left]
        exact ha i
      · rw [Fin.append_right]
        exact hb i
    · rw [Fin.sum_univ_add]
      simp only [Fin.append_left, Fin.append_right]

/-- The components `0, ..., m - 1`, each supported below the next. -/
def Iset (m : ℕ) : Set H :=
  {y | (∀ i, comp i y ≠ 0 ↔ i < m) ∧
    ∀ i j, i < j → j < m → ∀ s ∈ (comp i y).support, ∀ t ∈ (comp j y).support, s < t}

theorem Sset_order {x : H} {n : ℕ} (hx : x ∈ Sset comp 0 n) :
    ∀ k i, i + (k + 1) ≤ n → ∀ s ∈ (comp i x).support, ∀ t ∈ (comp (i + (k + 1)) x).support, t < s := by
  intro k
  induction k with
  | zero =>
    intro i hi s hs t ht
    exact hx.2 i (Nat.zero_le _) (by omega) s hs t ht
  | succ k ih =>
    intro i hi s hs t ht
    have hne : comp (i + (k + 1)) x ≠ 0 := (hx.1 _).2 ⟨Nat.zero_le _, by omega⟩
    obtain ⟨r, hr⟩ := Finsupp.support_nonempty_iff.2 hne
    have h1 := ih i (by omega) s hs r hr
    have e : i + (k + 1 + 1) = i + (k + 1) + 1 := by omega
    rw [e] at ht
    have h2 := hx.2 (i + (k + 1)) (Nat.zero_le _) (by omega) r hr t ht
    exact h2.trans h1

theorem nsum_disjoint_Iset {L m : ℕ} (h : L < m) (y : H) (hy : y ∈ nsum comp L) (hI : y ∈ Iset comp m) :
    False := by
  classical
  obtain ⟨a, ha, hsum⟩ := hy
  have hpick : ∀ i : Fin m, ∃ t, t ∈ (comp i y).support ∧ ∃ l : Fin L, t ∈ (comp i (a l)).support := by
    intro i
    obtain ⟨t, ht⟩ := Finsupp.support_nonempty_iff.2 ((hI.1 i).2 i.2)
    refine ⟨t, ht, ?_⟩
    have e : comp i y = ∑ l, comp i (a l) := by
      rw [← hsum, map_sum]
    rw [e] at ht
    have h1 := Finsupp.support_finsetSum ht
    obtain ⟨l, _, hl⟩ := Finset.mem_biUnion.1 h1
    exact ⟨l, hl⟩
  choose t ht l hl using hpick
  obtain ⟨i, j, hij, hl'⟩ : ∃ i j : Fin m, i < j ∧ l i = l j := by
    have hni : ¬ Function.Injective l := by
      intro hinj
      have h1 := Fintype.card_le_of_injective l hinj
      simp at h1
      omega
    obtain ⟨i, j, h1, h2⟩ := Function.not_injective_iff.1 hni
    rcases lt_or_gt_of_ne h2 with h3 | h3
    · exact ⟨i, j, h3, h1⟩
    · exact ⟨j, i, h3, h1.symm⟩
  obtain ⟨n, hn⟩ := mem_iUnion.1 (ha (l i))
  have hnej : comp (j : ℕ) (a (l i)) ≠ 0 := by
    intro h0
    have h1 := hl j
    rw [← hl', h0] at h1
    simp at h1
  have hjn : (j : ℕ) ≤ n := by
    have := ((hn.1 j).1 hnej).2
    omega
  have hij' : (i : ℕ) < (j : ℕ) := hij
  have e : (i : ℕ) + (((j : ℕ) - i - 1) + 1) = j := by omega
  have h1 : t j < t i := by
    refine Sset_order comp hn ((j : ℕ) - i - 1) i (by omega) (t i) (hl i) (t j) ?_
    rw [e]
    have h2 := hl j
    rwa [← hl'] at h2
  have h2 : t i < t j := hI.2 i j hij' j.2 (t i) (ht i) (t j) (ht j)
  omega

/-- The filter of the subgroups of finite index in the `i`-th copy. -/
def Nfil (i : ℕ) : Filter H where
  sets := {s | ∃ W : AddSubgroup A2, W.FiniteIndex ∧ ∀ z ∈ W, inc i z ∈ s}
  univ_sets := ⟨⊤, inferInstance, fun _ _ => mem_univ _⟩
  sets_of_superset := by
    rintro s t ⟨W, hW, h⟩ hst
    exact ⟨W, hW, fun z hz => hst (h z hz)⟩
  inter_sets := by
    rintro s t ⟨W, hW, h⟩ ⟨W', hW', h'⟩
    exact ⟨W ⊓ W', inferInstance, fun z hz => ⟨h z hz.1, h' z hz.2⟩⟩

theorem Nfil_nbhd (i : ℕ) : IsNbhdFilter (Nfil inc i) := by
  refine ⟨?_, ?_, ?_⟩
  · rintro s ⟨W, _, h⟩
    have := h 0 W.zero_mem
    rwa [map_zero] at this
  · rintro s ⟨W, hW, h⟩
    refine ⟨W, hW, fun z hz => ?_⟩
    have h1 := h (-z) (W.neg_mem hz)
    rw [map_neg] at h1
    exact h1
  · rintro s ⟨W, hW, h⟩
    refine ⟨(fun z => inc i z) '' (W : Set A2), ⟨W, hW, fun z hz => ⟨z, hz, rfl⟩⟩, ?_⟩
    rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
    show inc i x + inc i y ∈ s
    rw [← map_add]
    exact h _ (W.add_mem hx hy)

include hq hd in
theorem Nfil_null (i : ℕ) : Nfil inc i ∈ genFam (ultraGen {u0 inc q}) := by
  have hgen : SumClosure (ultraGen {u0 inc q}) (u0 inc q : Filter H) := SumClosure.gen ⟨_, rfl, rfl⟩
  obtain ⟨τ, hτs, hQ⟩ : ∃ τ : Filter H, SumClosure (ultraGen {u0 inc q}) τ ∧ (Qc inc q i : Filter H) ≤ τ :=
    ⟨_, SumClosure.add (tri_sumClosure hgen i) (sumClosure_neg (tri_sumClosure hgen (i + 1))),
      Q_le_chainLim (Qc inc q) (fun k => schur_of_idempotent (Qc_idempotent inc q hq k)) i⟩
  have hne : (Nfil inc i).NeBot := by
    refine ⟨fun h => ?_⟩
    have h1 : (∅ : Set H) ∈ Nfil inc i := by rw [h]; exact mem_bot
    exact (Nfil_nbhd inc i).zero_mem _ h1
  refine mem_genFam_of_le (SumClosure.add (SumClosure.add (SumClosure.add hτs hτs) hτs) hτs) ?_
  intro s hs
  obtain ⟨a, ha, t4, ht4, h1⟩ := Filter.mem_map₂_iff.1 hs
  obtain ⟨b, hb, t3, ht3, h2⟩ := Filter.mem_map₂_iff.1 ha
  obtain ⟨t1, ht1, t2, ht2, h3⟩ := Filter.mem_map₂_iff.1 hb
  have ht : t1 ∩ t2 ∩ t3 ∩ t4 ∈ τ :=
    Filter.inter_mem (Filter.inter_mem (Filter.inter_mem ht1 ht2) ht3) ht4
  have hE0 : t1 ∩ t2 ∩ t3 ∩ t4 ∈ Qc inc q i := hQ ht
  have hE : inc i ⁻¹' (t1 ∩ t2 ∩ t3 ∩ t4) ∈ q := Ultrafilter.mem_map.1 hE0
  obtain ⟨W, hW, hrep⟩ := bogolyubov _ (hd _ hE)
  refine ⟨W, hW, fun z hz => ?_⟩
  obtain ⟨x1, m1, x2, m2, x3, m3, x4, m4, e⟩ := hrep z hz
  rw [e, map_add, map_add, map_add]
  exact h1 (mem_image2_of_mem (h2 (mem_image2_of_mem
    (h3 (mem_image2_of_mem m1.1.1.1 m2.1.1.2)) m3.1.2)) m4.2)

theorem sum_halve {G : Type} [AddCommGroup G] {N : Filter G} (hN : IsNbhdFilter N) :
    ∀ (m : ℕ) (s : Set G), s ∈ N → ∃ t ∈ N, ∀ f : Fin m → G, (∀ l, f l ∈ t) → ∑ l, f l ∈ s
  | 0, s, hs => ⟨univ, Filter.univ_mem, fun f _ => by simpa using hN.zero_mem s hs⟩
  | m + 1, s, hs => by
    obtain ⟨B, hB, hBs⟩ := hN.halve s hs
    obtain ⟨t, ht, h⟩ := sum_halve hN m B hB
    refine ⟨t ∩ B, Filter.inter_mem ht hB, fun f hf => ?_⟩
    rw [Fin.sum_univ_castSucc]
    exact hBs _ (h (fun l => f l.castSucc) (fun l => (hf _).1)) _ (hf _).2

include hci hq hd in
theorem meets_Iset (N0 : Filter H) (hN0 : IsNbhdFilter N0) (hmax : ∀ i, Nfil inc i ≤ N0)
    (s : Set H) (hs : s ∈ N0) (m : ℕ) : (s ∩ Iset comp m).Nonempty := by
  classical
  obtain ⟨t, ht, hsum⟩ := sum_halve hN0 m s hs
  have hW : ∀ i, ∃ W : AddSubgroup A2, W.FiniteIndex ∧ ∀ z ∈ W, inc i z ∈ t :=
    fun i => hmax i ht
  choose W hWfin hWt using hW
  have hpick : ∀ i M : ℕ, ∃ z, z ∈ W i ∧ z ∈ above M := by
    intro i M
    have := hWfin i
    obtain ⟨z, hz1, hz2⟩ := Ultrafilter.nonempty_of_mem
      (Filter.inter_mem (mem_of_finiteIndex q hq (W i)) (above_mem q hq hd M))
    exact ⟨z, hz1, hz2⟩
  choose pick hpickW hpickA using hpick
  let M : ℕ → ℕ := fun i => Nat.rec 0 (fun k Mk => max Mk ((pick k Mk).support.sup id)) i
  let z : ℕ → A2 := fun i => pick i (M i)
  have hMsucc : ∀ i, M (i + 1) = max (M i) ((z i).support.sup id) := fun i => rfl
  have hMmono : Monotone M := monotone_nat_of_le_succ (fun i => by rw [hMsucc]; exact le_max_left _ _)
  have horder : ∀ i j, i < j → ∀ a ∈ (z i).support, ∀ b ∈ (z j).support, a < b := by
    intro i j hij a ha b hb
    have h1 : a ≤ M (i + 1) := by
      rw [hMsucc]
      exact le_trans (Finset.le_sup (f := id) ha) (le_max_right _ _)
    have h2 : M (i + 1) ≤ M j := hMmono hij
    have h3 : M j < b := (hpickA j (M j)).2 b hb
    omega
  set y : H := ∑ i : Fin m, inc (i : ℕ) (z i) with hy
  have hyapp : ∀ k, comp k y = if k < m then z k else 0 := by
    intro k
    rw [hy, map_sum]
    simp only [hci]
    by_cases hk : k < m
    · rw [if_pos hk, Finset.sum_eq_single (⟨k, hk⟩ : Fin m)]
      · exact if_pos rfl
      · intro b _ hb
        exact if_neg (fun h => hb (Fin.ext h))
      · intro h
        exact absurd (Finset.mem_univ _) h
    · rw [if_neg hk]
      refine Finset.sum_eq_zero (fun b _ => ?_)
      exact if_neg (fun h : (b : ℕ) = k => hk (by rw [← h]; exact b.2))
  refine ⟨y, hsum _ (fun i => hWt i _ (hpickW i (M i))), fun k => ?_, fun i j hij hj a ha b hb => ?_⟩
  · rw [hyapp]
    by_cases hk : k < m
    · rw [if_pos hk]
      exact ⟨fun _ => hk, fun _ => (hpickA k (M k)).1⟩
    · rw [if_neg hk]
      exact ⟨fun h => absurd rfl h, fun h => absurd h hk⟩
  · rw [hyapp, if_pos (hij.trans hj)] at ha
    rw [hyapp, if_pos hj] at hb
    exact horder i j hij a ha b hb

include hci hfin h2 hq hd in
theorem no_coarsest :
    ¬ ∃ N0 : Filter H, (IsNbhdFilter N0 ∧ N0 ∈ genFam (ultraGen {u0 inc q})) ∧
        ∀ N : Filter H, IsNbhdFilter N → N ∈ genFam (ultraGen {u0 inc q}) → N ≤ N0 := by
  rintro ⟨N0, ⟨hN0, hN0C⟩, hmax⟩
  have hC : NullFamily (genFam (ultraGen {u0 inc q})) := genFam_nullFamily _
  set J : ℕ → Set H := fun k => ⋃ m, ⋃ (_ : k ≤ m), Iset comp m with hJ
  have hJanti : Antitone J := by
    intro k k' h x hx
    simp only [hJ, mem_iUnion] at hx ⊢
    obtain ⟨m, hm, hx⟩ := hx
    exact ⟨m, h.trans hm, hx⟩
  have hne : ∀ k, (N0 ⊓ 𝓟 (J k)).NeBot := by
    intro k
    rw [inf_principal_neBot_iff]
    intro s hs
    obtain ⟨y, hy1, hy2⟩ := meets_Iset inc comp hci q hq hd N0 hN0
      (fun i => hmax _ (Nfil_nbhd inc i) (Nfil_null inc q hq hd i)) s hs k
    exact ⟨y, hy1, mem_iUnion₂.2 ⟨k, le_rfl, hy2⟩⟩
  have hdir : Directed (· ≥ ·) (fun k => N0 ⊓ 𝓟 (J k)) :=
    Antitone.directed_ge (fun k k' h => inf_le_inf_left _ (principal_mono.2 (hJanti h)))
  have hinf : (⨅ k, N0 ⊓ 𝓟 (J k)).NeBot := iInf_neBot_of_directed' hdir hne
  set r : Ultrafilter H := Ultrafilter.of (⨅ k, N0 ⊓ 𝓟 (J k)) with hr
  have hrle : ∀ k, (r : Filter H) ≤ N0 ⊓ 𝓟 (J k) := fun k => (Ultrafilter.of_le _).trans (iInf_le _ k)
  have hrC : (r : Filter H) ∈ genFam (ultraGen {u0 inc q}) :=
    hC.finer _ hN0C _ ((hrle 0).trans inf_le_left) r.neBot
  obtain ⟨σ, hσ, hrσ⟩ := hrC.2 r le_rfl
  obtain ⟨L, hL⟩ := nsum_of_sumClosure inc comp hci hfin h2 q hq hd hσ
  have h1 : nsum comp L ∈ (r : Filter H) := hrσ hL
  have h3 : J (L + 1) ∈ (r : Filter H) := (hrle (L + 1)).trans inf_le_right (mem_principal_self _)
  obtain ⟨y, hy1, hy2⟩ := Ultrafilter.nonempty_of_mem (f := r) (Filter.inter_mem h1 h3)
  simp only [hJ, mem_iUnion] at hy2
  obtain ⟨m, hm, hI⟩ := hy2
  exact nsum_disjoint_Iset comp (by omega) y hy1 hI

include hq in
theorem lam_chain : ∀ n j : ℕ, lam (chain (Qc inc q) j n) = 0
  | 0, j => lam_idempotent (Qc_idempotent inc q hq j)
  | n + 1, j => by
    rw [chain, lam_add, lam_chain n (j + 1), lam_idempotent (Qc_idempotent inc q hq j), add_zero]

include hq in
theorem u0_hausdorff (g : H) (hg : (pure g : Filter H) ∈ genFam (ultraGen {u0 inc q})) : g = 0 := by
  have hlam : lam (u0 inc q) = 0 := by
    refine lam_eq ?_
    refine tendsto_nhds.2 (fun W hW h0 => ?_)
    show iota ⁻¹' W ∈ u0 inc q
    unfold u0
    rw [mem_chainLim]
    refine Filter.mem_of_superset Filter.univ_mem (fun n _ => ?_)
    have h1 := lim_lam (chain (Qc inc q) 0 n)
    rw [lam_chain inc q hq n 0] at h1
    exact h1 (hW.mem_nhds h0)
  have h1 : iota g ∈ K (ultraGen {u0 inc q}) := iota_mem_K _ g hg
  have h2 : K (ultraGen {u0 inc q}) ≤ ⊥ := by
    refine (AddSubgroup.closure_le _).2 (fun b hb => ?_)
    obtain ⟨v, hv, rfl⟩ := L_ultraGen _ hb
    rw [mem_singleton_iff.1 hv, hlam]
    exact (⊥ : AddSubgroup (Circles H)).zero_mem
  have h3 : iota g = 0 := AddSubgroup.mem_bot.1 (h2 h1)
  exact iota_injective (h3.trans (map_zero iota).symm)

end Ex

/-! ### The group -/

/-- The sequences in `A2` with finitely many nonzero terms: a countably infinite Boolean group. -/
def FS : AddSubgroup (ℕ → A2) where
  carrier := {f | ∃ N : ℕ, ∀ i, N ≤ i → f i = 0}
  zero_mem' := ⟨0, fun _ _ => rfl⟩
  add_mem' := by
    rintro f g ⟨N, hf⟩ ⟨M, hg⟩
    refine ⟨max N M, fun i hi => ?_⟩
    rw [Pi.add_apply, hf i (le_trans (le_max_left _ _) hi), hg i (le_trans (le_max_right _ _) hi), add_zero]
  neg_mem' := by
    rintro f ⟨N, hf⟩
    refine ⟨N, fun i hi => ?_⟩
    rw [Pi.neg_apply, hf i hi, neg_zero]

theorem neg_A2 (z : A2) : -z = z := by
  have h : ∀ a : ZMod 2, -a = a := by decide
  ext s
  rw [Finsupp.neg_apply, h]

theorem neg_FS (y : FS) : -y = y := by
  refine Subtype.ext (funext (fun i => ?_))
  exact neg_A2 _

instance : Countable FS := by
  have h : ∀ y : FS, (Function.support y.1).Finite := by
    rintro ⟨f, N, hf⟩
    refine (Set.finite_Iio N).subset (fun i hi => ?_)
    exact not_le.1 (fun h => hi (hf i h))
  refine Function.Injective.countable (f := fun y : FS => Finsupp.ofSupportFinite y.1 (h y)) (fun x y hxy => ?_)
  refine Subtype.ext (funext (fun i => ?_))
  exact DFunLike.congr_fun hxy i

noncomputable def incFS (i : ℕ) : A2 →+ FS :=
  AddMonoidHom.codRestrict (AddMonoidHom.single (fun _ : ℕ => A2) i) FS (fun z => ⟨i + 1, fun k hk => by
    rw [AddMonoidHom.single_apply]
    exact Pi.single_eq_of_ne (M := fun _ : ℕ => A2) (by omega : k ≠ i) z⟩)

def compFS (i : ℕ) : FS →+ A2 where
  toFun y := y.1 i
  map_zero' := rfl
  map_add' _ _ := rfl

theorem comp_inc (i j : ℕ) (z : A2) : compFS i (incFS j z) = if j = i then z else 0 := by
  have e : compFS i (incFS j z) = (Pi.single (M := fun _ : ℕ => A2) j z) i := rfl
  rw [e, Pi.single_apply]
  by_cases h : j = i
  · rw [if_pos h, if_pos h.symm]
  · rw [if_neg h, if_neg (Ne.symm h)]

/-- There is a nonprincipal ultrafilter on a countable Boolean group whose PG has unique limits and no coarsest
group topology all of whose neighbourhood filters are null. -/
theorem one_ultrafilter_no_coreflection :
    ∃ u : Ultrafilter FS, (∀ a, u ≠ pure a) ∧
      (∀ g : FS, (pure g : Filter FS) ∈ genFam (ultraGen {u}) → g = 0) ∧
      ¬ ∃ N0 : Filter FS, (IsNbhdFilter N0 ∧ N0 ∈ genFam (ultraGen {u})) ∧
        ∀ N : Filter FS, IsNbhdFilter N → N ∈ genFam (ultraGen {u}) → N ≤ N0 := by
  obtain ⟨q, hq, hd⟩ := exists_essential_idempotent
  have hfin : ∀ y : FS, ∃ N : ℕ, ∀ i, N ≤ i → compFS i y = 0 := fun y => y.2
  exact ⟨u0 incFS q, u0_free incFS compFS comp_inc hfin q hq hd, u0_hausdorff incFS q hq,
    no_coarsest incFS compFS comp_inc hfin neg_FS q hq hd⟩

end One

end PG
